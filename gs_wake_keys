#!/usr/bin/env python3
"""gs_wake_keys - the VAULT's half of pairing. Run it on the ThinkPad, once.

    ThinkPad:  python3 gs_wake_keys pair
    Pi:        python3 gs_doorbell pair <the address the ThinkPad printed>

Two commands, one code to compare, one y on each screen. That is the whole
ceremony, and it is short on purpose: every step an operator can get wrong is a
step this design has to defend, and the cheapest defence is not to have it.

--------------------------------------------------------------------------
WHAT THIS REPLACES, AND WHY
--------------------------------------------------------------------------
The first version minted BOTH keypairs here and told the operator to carry the
Pi's SECRET across on a USB stick, then shred it. Three copies of one secret
existed at once -- this disk, the stick, the Pi -- and destroying two of them
was homework. The instruction was correct. Nobody follows instructions at 2am,
and a stick with a wake secret on it is indistinguishable from any other stick
in the drawer six months later.

Now each box generates its own keypair, in place, and only PUBLIC keys cross
the LAN. There is no moment at which a secret exists anywhere but on the
machine that will use it, so there is nothing for the operator to clean up.

--------------------------------------------------------------------------
KERCKHOFFS, AND WHY THIS BOX'S KEYFILE IS NOT ENCRYPTED
--------------------------------------------------------------------------
This repository is public. The adversary has read it: they know the file names,
the ports, the record size, the job vocabulary and this docstring. Only key
material may be secret.

The Pi's keyfile IS sealed with a passphrase (Argon2id + XSalsa20-Poly1305),
because an SD card leaves the building in a pocket and the Pi is poked by a
person who can type. This box's keyfile is NOT, and the reason is not
laziness:

    gs_wake_agent runs at boot, unattended, on a machine whose disk unlocks
    itself so that it CAN boot unattended. Any key that process can read, a
    thief holding the powered-on laptop can read. A passphrase the machine
    stores in order to type it to itself is not a passphrase.

So this file says `"kdf": "none"` and stores its payload as plain JSON, rather
than dressing plaintext up as a ciphertext. What that costs is bounded and is
stated here rather than discovered: someone who takes this laptop can

  * impersonate this vault to the doorbell -- and collect a queued job, which
    tells them a job was queued and nothing else;
  * decrypt recorded M1 and M3 records -- an ephemeral public key, a random
    challenge, a job id and a four-character label. No address, no amount, no
    memo: those are in M2, which is sealed to a per-boot ephemeral key that
    only ever existed in the RAM of a machine that has since powered off.

They also have the wallet, which is a far larger problem and is what
OPSEC_SETUP.md section 6 already scores. Rotating this pairing afterwards is
one command on each box.

--------------------------------------------------------------------------
WHAT THIS TOOL REFUSES
--------------------------------------------------------------------------
  * to overwrite an existing keyfile, because silently replacing a keypair
    breaks the other box in a way that presents as "the doorbell stopped
    working" -- byte-identical to a dead switch, a reset BIOS and a hostile WOL
  * to write anywhere group- or world-readable
  * to guess this machine's MAC. It detects it from the interface that carries
    the route to the Pi, and refuses with instructions if it cannot
  * to run at all without PyNaCl
"""
from __future__ import annotations

import argparse
import fcntl
import os
import re
import socket
import struct
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from gs_common import (                                      # noqa: E402
    atomic_write_json, integrity_log, install_signal_handlers, secure_mkdir,
    wipe_covers,
)
import gs_wake_proto as proto                                # noqa: E402

# \Z, NOT $. In Python `$` also matches just before a trailing newline, so
# `^...$` accepted "192.168.1.255\n" -- and int("255\n") is 255, so the range
# check below waved it through too. That value is pasted into
# f"http://{host}:{port}", which urllib then rejects with "URL can't contain
# control characters" at wake time, months after the ceremony that stored it.
MAC_RE = re.compile(r"^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\Z")
IPV4_RE = re.compile(r"^(\d{1,3}\.){3}\d{1,3}\Z")


def is_ipv4(v: str) -> bool:
    """Shape AND range. The regex alone accepts 999.1.1.1.

    Found by driving --broadcast 999.1.1.1 through the real CLI: it passed
    validation, the ceremony ran to completion, the value went into the Pi's
    keyfile, and the failure surfaced months later as sendto() refusing an
    address at the one moment the operator needed a machine to wake. A regex
    that checks digit COUNT is not a check that the number is a byte.

    Leading zeros are refused as well: inet_aton reads "010" as OCTAL 8, so
    "10.0.0.010" is a different host to sendto() than it reads as on screen.
    str(int(p)) == p rejects that, the empty octet, and any "+1"/" 1" form.
    """
    if not isinstance(v, str) or not IPV4_RE.match(v):
        return False
    return all(str(int(p)) == p and 0 <= int(p) <= 255 for p in v.split("."))

THINKPAD_FILE = "gs_wake_thinkpad.key"
#: The ceremony's own port. Open for one connection, once, ever. It is not the
#: doorbell port and it is not in either keyfile.
PAIR_PORT = 8769

_SIOCGIFADDR = 0x8915
_SIOCGIFHWADDR = 0x8927
_SIOCGIFBRDADDR = 0x8919


# ---------------------------------------------------------------------------
#  Which NIC is going to be woken
# ---------------------------------------------------------------------------
def _ioctl(sock, req, name):
    return fcntl.ioctl(sock.fileno(), req,
                       struct.pack("256s", name.encode()[:15]))


def local_link(src_ip: str) -> tuple:
    """(iface, mac, broadcast) for the interface holding src_ip.

    NO SUBPROCESS. `ip route get` would be the obvious way and is not used:
    Raspberry Pi OS Lite has iproute2 but a Debian netinstall need not, the
    output format is not a stable interface, and parsing a human-facing tool to
    decide which NIC gets woken is how you end up waking nothing. ioctl against
    /sys is the kernel's own answer.

    THE MAC IS DETECTED, NEVER TYPED. --thinkpad-mac used to be a required flag,
    and a typo in it produced a setup that paired perfectly, reported success on
    both boxes, and then never woke anything -- with the magic packet going out
    correctly addressed to a machine that does not exist. Nothing in the system
    could have told the operator, because a magic packet is not acknowledged.
    """
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        for _idx, name in socket.if_nameindex():
            if name == "lo":
                continue
            try:
                if socket.inet_ntoa(_ioctl(s, _SIOCGIFADDR, name)[20:24]) != src_ip:
                    continue
            except OSError:
                continue
            try:
                mac = ":".join(f"{b:02x}"
                               for b in _ioctl(s, _SIOCGIFHWADDR, name)[18:24])
                brd = socket.inet_ntoa(_ioctl(s, _SIOCGIFBRDADDR, name)[20:24])
            except OSError:
                continue
            if not MAC_RE.match(mac) or mac == "00:00:00:00:00:00":
                continue
            return name, mac, brd
    finally:
        s.close()
    return None, None, None


# ---------------------------------------------------------------------------
#  Refusals
# ---------------------------------------------------------------------------
def _refuse_existing(path: Path) -> None:
    if path.exists():
        sys.exit(
            f"[!] {path} already exists.\n"
            f"    Refusing to overwrite it: the Pi holds the matching half, and\n"
            f"    replacing this one silently breaks the pair in a way that looks\n"
            f"    exactly like a dead switch or a hostile WOL.\n"
            f"    If you really are re-keying, move it aside and re-pair BOTH\n"
            f"    boxes in the same sitting -- the Pi's file is no use without\n"
            f"    this one.")


def _write_key(path: Path, obj: dict) -> None:
    # 0400. The agent runs unattended and only ever reads this; a writable
    # keyfile is a keyfile something can rewrite between boots.
    atomic_write_json(obj, path, perms=0o400)
    st = os.stat(path)
    if st.st_mode & 0o077:                                   # pragma: no cover
        sys.exit(f"[!] {path} ended up group/world accessible; refusing to "
                 f"leave a wake keyfile readable. Check your umask and the "
                 f"filesystem.")


def ask_match(sas: str) -> bool:
    """Show the code and get a real answer. The security of the whole exchange.

    Deliberately NOT defaulting to yes on a bare Enter. This is the one place
    a human decision is load-bearing, and a prompt that treats "operator hit
    return without reading" as consent has thrown the decision away.
    """
    bar = "=" * 46
    print()
    print(f"  {bar}")
    print(f"     PAIRING CODE      {sas}")
    print(f"  {bar}")
    print()
    print("  The Pi is showing a code too. They must match EXACTLY.")
    print("  If they do not, something on your network answered instead of")
    print("  the Pi. Answer n, and take everything you do not own off the")
    print("  switch before trying again.")
    print()
    while True:
        try:
            a = input("  Do the two codes match? (yes/no) ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return False
        if a in ("yes", "y"):
            return True
        if a in ("no", "n"):
            return False
        print("  Type yes or no.")


# ---------------------------------------------------------------------------
def build_cli() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description="Pair this ThinkPad with a Pi doorbell (run on the "
                    "ThinkPad).")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("pair", help="generate this box's key and wait for the Pi")
    p.add_argument("--out", default="/etc",
                   help="directory for this box's keyfile (default: /etc)")
    p.add_argument("--pair-port", type=int, default=PAIR_PORT,
                   help=f"port to wait on during the ceremony "
                        f"(default: {PAIR_PORT}). Open for one connection, "
                        f"once; it is not the doorbell port.")
    p.add_argument("--bind", default="",
                   help="address to wait on. Default: every interface, because "
                        "you have not been told the Pi's address yet and the "
                        "socket is open for one connection during a ceremony "
                        "you are standing at.")
    p.add_argument("--mac", default="",
                   help="override the detected MAC. Only if detection failed; "
                        "a typo here wakes nothing and nothing can tell you.")
    p.add_argument("--broadcast", default="",
                   help="override the detected broadcast address")
    p.add_argument("--tor-proxy", default="socks5h://127.0.0.1:9050",
                   help="this machine's OWN Tor. OPSEC_SETUP.md section 4: do "
                        "not point this at the Pi - a pwned Pi would sit on "
                        "the path.")
    p.add_argument("--rpc", default="http://127.0.0.1:18083",
                   help="this machine's wallet-rpc")
    p.add_argument("--artifact-dir", default="/var/lib/ghostspiral",
                   help="ABSOLUTE path where woken jobs write bundles and "
                        "slips. Must match ReadWritePaths= and "
                        "WorkingDirectory= in systemd/gs-wake-agent.service.")
    # --amount-ladder IS GONE. It held the BTC amounts a wake could select by
    # index, so the Pi sent a slot and never a number. The chat now asks for
    # the amount being sent and the wire carries it in satoshis; see
    # gs_wake_proto above _int_range for why a pre-declared rung was the wrong
    # answer to "how much are you depositing". Removed rather than accepted
    # and ignored: a flag that still parses but changes nothing is worse than
    # one that errors.
    # OFF BY DEFAULT, AND OFF IN EVERY KEYFILE WRITTEN BEFORE IT EXISTED.
    # gs_wake_agent reads it with .get(), so an old keyfile means no -- an
    # upgraded pair does not silently gain the ability to spend. Turning it on
    # requires re-pairing, which requires physical access to both boxes, which
    # is the same bar every other keyfile setting sits behind.
    p.add_argument("--allow-withdraw", action="store_true",
                   help="let a wake run the mix and send funds OUT. Off by "
                        "default. It means the spend wallet is reachable by a "
                        "machine a pager can wake, so whoever holds the bot "
                        "token can trigger a withdrawal - to an address they "
                        "type. Read OPSEC_SETUP.md before using it.")
    # WHICH WALLET THE MIX SIGNS WITH. Not a job parameter and it must never
    # become one: a wake note that could name a wallet file could name any file
    # on this machine. Only meaningful with --allow-withdraw, and the pairing
    # refuses the pair without it (see below) rather than writing a keyfile
    # whose withdraw job would fail hours in, after the money had moved.
    p.add_argument("--wallet-file", default="",
                   help="ABSOLUTE path to the wallet the mix signs with. "
                        "Required with --allow-withdraw. The password goes in "
                        "GS_WALLET_PASSWORD in the agent unit's "
                        "EnvironmentFile, never here and never on an argv.")
    p.add_argument("--account-ceiling", type=int, default=45,
                   help="refuse minting jobs once the wallet holds this many "
                        "accounts (OPSEC_SETUP.md section 4)")
    p.add_argument("--daily-wake-budget", type=int, default=12,
                   help="refuse after this many wakes in 24 h")
    return ap


def _validate(args) -> None:
    # REFUSED AT PAIRING, not discovered mid-withdrawal. --allow-withdraw
    # without a wallet file writes a keyfile whose withdraw job relays a
    # fan-out and THEN fails at the signing step, with the money already moved.
    # The two flags are one setting and this is the only moment both are here.
    if args.allow_withdraw and not args.wallet_file:
        sys.exit("[!] --allow-withdraw needs --wallet-file: the mix has to "
                 "know which wallet to sign with.\n"
                 "    Without it a withdrawal would relay its fan-out and "
                 "fail hours later at the\n"
                 "    signing step, with the money already moved on-chain.")
    if args.wallet_file and not os.path.isabs(args.wallet_file):
        sys.exit(f"[!] --wallet-file {args.wallet_file!r} is relative. The "
                 f"agent runs from a unit with its own WorkingDirectory, so a "
                 f"relative path resolves somewhere you did not mean.")
    if args.account_ceiling < 1:
        sys.exit("[!] --account-ceiling must be at least 1.")
    if not 1 <= args.daily_wake_budget <= 1000:
        sys.exit("[!] --daily-wake-budget must be between 1 and 1000.")
    if not 1 <= args.pair_port <= 65535:
        sys.exit("[!] --pair-port is not a port.")
    if not os.path.isabs(args.artifact_dir):
        # The agent runs under systemd, whose working directory is "/", so a
        # relative path resolves somewhere the operator did not choose - and
        # ProtectSystem=strict mounts that read-only.
        sys.exit(f"[!] --artifact-dir {args.artifact_dir!r} is relative. The "
                 f"agent runs under systemd, where the working directory is "
                 f"'/', so a relative path resolves somewhere you did not "
                 f"choose. Give an absolute path, and make it the one "
                 f"WorkingDirectory= and ReadWritePaths= name in "
                 f"systemd/gs-wake-agent.service (/var/lib/ghostspiral).")
    if args.mac and not MAC_RE.match(args.mac):
        sys.exit(f"[!] --mac {args.mac!r} is not a MAC address.")
    if args.broadcast and not is_ipv4(args.broadcast):
        sys.exit(f"[!] --broadcast {args.broadcast!r} is not an IPv4 address.")
    if args.bind and not is_ipv4(args.bind):
        sys.exit(f"[!] --bind {args.bind!r} is not an IPv4 address.")


#: How many connections that never speak the protocol we sit through before
#: concluding that something on this LAN is going to keep doing it. Bounded so
#: the ceremony cannot be held open forever, and reported so the operator knows
#: it happened rather than just seeing a slow pairing.
PAIR_MAX_STRAY = 10
# There is deliberately no greeting timeout here. There WAS one, set on the
# accepted socket -- and gs_wake_proto.pair_responder called settimeout() again
# as its first act, so the number here never applied. Two places setting the
# same bound is one place quietly losing. The protocol owns it now
# (PAIR_MSG_S, enforced as a whole-message deadline rather than a per-read one).


def _listen(args):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind((args.bind, args.pair_port))
    except OSError as e:
        srv.close()
        sys.exit(f"[!] cannot wait on {args.bind or '0.0.0.0'}:{args.pair_port} "
                 f"({e.strerror}). Something else is on that port, or you are "
                 f"not root. --pair-port picks another.")
    srv.listen(4)
    return srv


def _announce(args) -> None:
    """Print the exact command to type on the Pi."""
    guess = ""
    try:
        u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        u.settimeout(1)
        u.connect(("192.0.2.1", 9))          # TEST-NET-1: routed, never used
        guess = u.getsockname()[0]
        u.close()
    except OSError:
        guess = ""
    print("  [*] This ThinkPad's wake keypair is generated. It stays on this")
    print("      disk; only the public half will cross the LAN.")
    print()
    print("  Now, on the Pi, run:")
    if guess:
        print(f"      python3 gs_doorbell pair {guess} --pair-port "
              f"{args.pair_port}")
    else:
        print(f"      python3 gs_doorbell pair <this machine's LAN address> "
              f"--pair-port {args.pair_port}")
        print("      (this machine has no route out, so its address could not")
        print("       be read; use the one the Pi can reach it on)")
    print()
    print(f"  [*] Waiting up to {proto.PAIR_TIMEOUT_S // 60} min...")


def _one_attempt(conn, peer, sk, my_pub, args) -> dict:
    """Run the responder against one connection. Raises on any failure."""
    src_ip = conn.getsockname()[0]
    iface, mac, brd = local_link(src_ip)
    if args.mac:
        mac, iface = args.mac.lower().replace("-", ":"), iface or "(given)"
    if args.broadcast:
        brd = args.broadcast
    if not mac or not brd:
        # REFUSE RATHER THAN GUESS. A wrong MAC pairs fine and then wakes
        # nothing, forever, silently -- a magic packet is not acknowledged, so
        # there is no layer in this system that could ever tell the operator.
        proto._pair_abort(conn, "info")
        sys.exit(
            f"[!] could not read the MAC and broadcast address of the "
            f"interface holding {src_ip}.\n"
            f"    Nothing was written. Find them with `ip -o -4 addr` and "
            f"`cat /sys/class/net/<iface>/address`, then re-run with\n"
            f"        --mac aa:bb:cc:dd:ee:ff --broadcast 192.168.1.255")
    print(f"  [+] Something connected from {peer[0]}.")
    # Never print an interface name that was not detected. "woken on None"
    # is the shape of a message that has stopped describing reality.
    where = f"on {iface} " if iface and iface != "(given)" else ""
    print(f"  [*] This machine will be woken {where}({mac}), broadcast {brd}.")
    return proto.pair_responder(conn, sk, my_pub,
                                {"mac": mac, "broadcast": brd},
                                ask_match, print)


def do_pair(args) -> int:
    import nacl.public
    import time as _time

    outdir = Path(args.out)
    tp_path = outdir / THINKPAD_FILE
    _refuse_existing(tp_path)

    sk = nacl.public.PrivateKey.generate()
    my_pub = sk.public_key.encode()

    srv = _listen(args)
    _announce(args)
    deadline = _time.monotonic() + proto.PAIR_TIMEOUT_S
    stray = 0
    agreed = None
    try:
        while agreed is None:
            left = deadline - _time.monotonic()
            if left <= 0:
                sys.exit("[!] the Pi never connected. Nothing was written. "
                         "Check the cable, the address, and that both boxes "
                         "are on the same switch.")
            srv.settimeout(left)
            try:
                conn, peer = srv.accept()
            except socket.timeout:
                sys.exit("[!] the Pi never connected. Nothing was written. "
                         "Check the cable, the address, and that both boxes "
                         "are on the same switch.")
            try:
                agreed = _one_attempt(conn, peer, sk, my_pub, args)
            except proto.PairAborted as e:
                # A PERSON decided. Not a fault, and not something to sit
                # through: retrying would ask them again until they got it
                # wrong.
                sys.exit(f"[!] {e}")
            except (proto.WakeError, OSError) as e:
                # KEEP LISTENING. A port scanner, a monitoring probe or a
                # half-open connection must not consume the ceremony and leave
                # the real Pi with 'connection refused' from a vault that has
                # already given up.
                stray += 1
                print(f"  [!] That was not the Pi ({e}). Still waiting.")
                if stray >= PAIR_MAX_STRAY:
                    sys.exit(
                        f"[!] {stray} connections to the pairing port were not "
                        f"the Pi. Something on this LAN keeps answering. "
                        f"Nothing was written: take everything you do not own "
                        f"off the switch and pair again.")
            finally:
                try:
                    conn.close()
                except OSError:
                    pass
    finally:
        try:
            srv.close()
        except OSError:
            pass

    info = agreed["peer_info"]
    if "host" not in info or "port" not in info:
        sys.exit("[!] the Pi did not send an address to fetch jobs from. "
                 "Nothing was written.")

    # FROM HERE ON A FAILURE LEAVES HALF A PAIRING: the Pi has agreed and is
    # writing its own file. Nothing below can plausibly fail, but if it does the
    # operator must be told which file to remove, because the next attempt will
    # refuse both boxes for reasons that look nothing like "the last one died
    # halfway".
    secure_mkdir(outdir, narrow_existing=False)
    payload = {
        "role": "thinkpad",
        "secret": sk.encode().hex(),
        "peer_public": agreed["peer_public"],
        "pair_fingerprint": agreed["sas"],
        "doorbell_url": f"http://{info['host']}:{info['port']}",
        "tor_proxy": args.tor_proxy,
        "rpc_primary": args.rpc,
        "artifact_dir": args.artifact_dir,
        "account_ceiling": int(args.account_ceiling),
        "daily_wake_budget": int(args.daily_wake_budget),
        "allow_withdraw": bool(args.allow_withdraw),
        "wallet_file": str(args.wallet_file or ""),
    }
    # kdf="none", deliberately and visibly. See the module docstring: a machine
    # that boots unattended cannot keep a passphrase from someone holding it.
    try:
        _write_key(tp_path, proto.lock_keyfile(payload, b"", role="thinkpad"))
    except BaseException:
        print()
        print("  [!] The pairing succeeded and this box then FAILED TO WRITE")
        print(f"      {tp_path}. The Pi has already written its own file.")
        print("      Delete the Pi's keyfile before pairing again, or the two")
        print("      boxes will hold halves of different pairs and every wake")
        print("      will fail in a way that looks like a network fault:")
        print("          shred -u /etc/gs_wake_pi.key      # on the Pi")
        raise

    # The fingerprint is public and the paths are local. No key material and no
    # MAC reaches the persistent chain: chain_safe collapses digits to '#' but
    # has no MAC rule, so 'a4:c3:f0:1b' would survive as 'a#:c#:f#:#b' -- with
    # the digit positions known, that is a handful of candidates. spoof_mac
    # already settled this: record THAT it happened, never the address.
    integrity_log("wake", f"paired:{agreed['sas']}")

    print()
    print(f"  [+] Paired. Code {agreed['sas']}.")
    print(f"      This box : {tp_path}  (0400)")
    print(f"      Doorbell : {payload['doorbell_url']}")
    print()
    print("  [!] This file is NOT encrypted, and that is on purpose.")
    print("      gs_wake_agent runs at boot with nobody here, on a disk that")
    print("      unlocks itself so that it can. A passphrase this machine")
    print("      stores in order to type to itself is not a passphrase.")
    print("      What it costs is bounded: someone holding this laptop can")
    print("      impersonate it to the doorbell and collect a queued job.")
    print("      They cannot read a past job - those were sealed to a key")
    print("      that only existed in the RAM of a machine now powered off.")
    print("      They also have your wallet, which is the larger problem.")
    print()
    print("      The Pi's keyfile IS sealed with your passphrase. Its SD card")
    print("      is the one that leaves the building in a pocket.")
    print()
    print("  Next: confirm the pairing works before you rely on it --")
    # THE CONFIRMATION HAS TO ACTUALLY RUN, and the bare command did not.
    #
    # wipe_covers() resolves against cwd and $HOME. The systemd unit sets BOTH
    # to the artifact directory on purpose (gs-wake-agent.service:41-42, whose
    # own comment says "wipe_covers(/var/lib/ghostspiral) = True"), so a real
    # wake is fine. An operator running this line from their own shell has
    # neither, so the agent refuses outside_wipe_roots -- on the SHIPPED
    # DEFAULT, at the exact moment they were told to check that pairing
    # worked. Measured: covered=False by hand, covered=True under the unit.
    #
    # So print the command that reproduces what systemd does. A verification
    # step that fails on a correct install teaches the operator to distrust a
    # system that is working, which is worse than not offering one.
    _ad = args.artifact_dir
    if not wipe_covers(_ad):
        print(f"      cd {_ad} && HOME={_ad} \\")
        print(f"          python3 {os.path.abspath(__file__).rsplit('/', 1)[0]}"
              f"/gs_wake_agent --key {tp_path} --dry-run")
        print()
        print(f"      (cd + HOME are what the systemd unit sets -- see")
        print(f"      WorkingDirectory= and Environment=HOME= in")
        print(f"      systemd/gs-wake-agent.service. Without them the agent")
