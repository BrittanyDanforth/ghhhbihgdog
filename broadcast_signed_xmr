#!/usr/bin/env python3
"""
broadcast_signed_xmr v10.0 - Resilient Monero relay & confirmation
===================================================================
Fee-aware, Tor-hardened, integrity-logged broadcast of pre-signed XMR blobs.

OPSEC hardening:
  - Tor verified before first broadcast. The DAEMON's relay egress is
    re-verified immediately before EVERY submit (a local RPC on the usual
    loopback daemon), so a monerod that picks up clearnet peers mid-batch is
    caught before the next transaction rather than up to a timer-interval
    later -- WHEN --rpc-daemon IS SET, AND ONLY THEN. EgressGate.check returns
    immediately if it has no daemon URL, and --rpc-daemon has no default. So
    without it this paragraph described a check that never ran, and the run
    said nothing about the difference. It does now: the gate says so once, at
    startup, rather than leaving the header to be believed. The Tor exit check is an external request, so it stays on a
    ~5-minute timer and is forced before any transaction that had a planned
    delay -- the delay is what makes the previous sample stale
  - NEWNYM circuit rotation between every TX broadcast
  - Planned per-TX delay honoured in full; a shutdown during a delay ABORTS
    that TX instead of relaying it early
  - Blob hash re-verified against the manifest at submit time, not only at
    startup (a startup-only check is stale by the length of the delays)
  - Atomic progress writes survive crash; progress is keyed on blob NAME so a
    momentarily-unreadable blob cannot shift or invalidate it
  - Signal handlers for graceful shutdown mid-broadcast
  - All progress files written 0600

NO FEE BUMP EXISTS, and this header used to claim one ("Fee-bump with proper
subprocess error handling"). Monero has no RBF: a transaction's fee is fixed at
signing time and cannot be raised afterwards by this or any other tool. A
low-fee rejection is therefore terminal here -- the TX is marked permanently
failed and must be re-created and re-signed with a higher --fee-priority.
"""
from __future__ import annotations
import argparse, json, time, sys, os, hashlib
from pathlib import Path
from typing import List
from urllib.parse import urlparse

import requests

from gs_common import (
    integrity_log, verify_tor, tor_recheck, validate_proxy,
    newnym, secure_delay, atomic_write_json, check_daemon_relay_egress,
    integrity_log_once,
    MAX_PLANNED_DELAY, delay_is_sane,
    install_signal_handlers, shutdown_requested, redact_addresses,
)

_LOCALHOST_HOSTS = {"127.0.0.1", "localhost", "::1", "[::1]", "0.0.0.0"}


def _is_localhost(url: str) -> bool:
    return (urlparse(url).hostname or "").lower() in _LOCALHOST_HOSTS


def _single_post(url: str, payload: dict, proxies=None) -> dict:
    """Single-attempt POST without tenacity retry. Used for broadcast
    submissions where the outer loop handles retries with NEWNYM rotation.

    A localhost RPC (wallet-rpc / daemon on 127.0.0.1) is contacted DIRECTLY:
    Tor's SOCKS port refuses to route to loopback, so proxying a localhost POST
    would fail on every attempt. Only a NON-localhost target needs the Tor proxy
    -- and a non-localhost POST with no proxies is a clearnet leak, so it aborts.
    This mirrors gs_common.MoneroRPC, which likewise skips the proxy for
    localhost hosts.
    """
    if _is_localhost(url):
        proxies = None  # never route loopback through Tor
    elif not proxies:
        # `not proxies`, NOT `is None`: requests treats proxies={} as no proxy
        # and connects DIRECTLY, so an empty dict used to pass this guard and
        # relay a transaction over clearnet -- revealing to the receiving node
        # that this IP submitted it. Any falsy value aborts.
        sys.exit("[!] _single_post to non-localhost without proxies — clearnet leak. Aborting.")
    r = requests.post(url, json=payload, timeout=30, proxies=proxies, allow_redirects=False)
    r.raise_for_status()
    return r.json()

TOR_RECHECK_INTERVAL = 300  # re-verify Tor every 5 min during broadcast

PROGRESS_SCHEMA = "broadcast_progress_v2"

def _blob_sort_key(p: Path) -> int:
    """Extract the TX's real manifest index from tx_N.signed's filename.

    Used to sort a directory of blobs numerically, and -- when no manifest is
    available to state the index outright -- to key each TX's planned delay on
    its real index rather than on its position in the (possibly gapped) list.
    """
    stem = p.stem  # e.g. "tx_15"
    parts = stem.split("_")
    try:
        return int(parts[-1])
    except (ValueError, IndexError):
        return 999999


class TxItem:
    """One transaction to relay.

    `key` -- the blob's filename -- is what broadcast progress is recorded
    under. The old code recorded the loop POSITION instead, which is only
    stable while the blob list has exactly the same shape on every run; a
    single momentarily-unreadable blob renumbered every TX after it.
    """
    __slots__ = ("idx", "path", "sha", "delay")

    def __init__(self, idx: int, path, sha=None, delay=0):
        self.idx = int(idx)
        self.path = Path(path)
        self.sha = sha or None
        self.delay = int(delay or 0)

    @property
    def key(self) -> str:
        return self.path.name


def _load_manifest(path: Path) -> list:
    """Read a signed manifest and return its entry list.

    Accepts the bare list the signer writes, and the {"manifest": [...]} /
    {"entries": [...]} wrappers. Directory mode used to assume a bare list and
    would crash with `TypeError: string indices must be integers` on a wrapped
    one, because iterating a dict yields its keys.
    """
    if not path.exists():
        sys.exit(f"[!] Manifest not found: {path}")
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        sys.exit(f"[!] Cannot read manifest {path}: {e}")
    if isinstance(data, dict):
        for k in ("manifest", "entries"):
            if isinstance(data.get(k), list):
                data = data[k]
                break
    if not isinstance(data, list):
        sys.exit(f"[!] {path} is not a signed manifest (expected a list of entries).")
    _refuse_short_manifest(data, path)
    return data


def _refuse_short_manifest(entries: list, path: Path) -> None:
    """Refuse a manifest that does not cover the whole plan it came from.

    THE SIGNER ALREADY REFUSES A PARTIAL BATCH -- and that refusal protected
    only the operator watching the signing terminal. phase_sign writes
    signed_manifest_v1.json BEFORE it exits, so a batch where 4 of 5
    transactions signed left a manifest listing 4 next to the 4 blobs, and
    nothing here looked at completeness at all: this file read the entries it
    was given and relayed them. Carry that directory to the online box on a
    USB stick -- which is the entire point of an air-gapped signer -- and the
    partial chain relays and is reported as a clean run.

    That is not a neutral outcome. A plan is a CHAIN: a peel spends the
    previous peel's change, a DAG hop spends a fan-out output. Relaying the
    early links strands the funds on whichever intermediate subaddress the
    missing link was supposed to move them off, in a distinctive half-executed
    on-chain shape, with the operator told it succeeded.

    TWO SHAPES OF SHORT, and one of them needs the count:

      * A HOLE.  TX 2 of 5 failed: idx 0,1,3,4. Visible without any extra
        field, because the indices are no longer contiguous.
      * A TRUNCATION.  TX 4 of 5 failed: idx 0,1,2,3 -- byte-identical to a
        four-transaction plan that signed perfectly. Nothing in the entries
        can distinguish those two, which is why phase_sign now writes "of".

    Manifests written before "of" existed have no count, and those are NOT
    refused: an old manifest is not evidence of a partial batch, and refusing
    one would strand a correctly signed directory on the wrong side of an
    air gap. The contiguity check still covers a hole in those.
    """
    dicts = [e for e in entries if isinstance(e, dict)]
    if not dicts:
        return
    ofs = set()
    for e in dicts:
        v = e.get("of")
        if isinstance(v, bool) or not isinstance(v, int) or v <= 0:
            continue
        ofs.add(v)
    if len(ofs) > 1:
        sys.exit(
            f"[!] {path} disagrees with itself about how many transactions "
            f"the plan had ({sorted(ofs)}).\n"
            f"    Refusing to relay a manifest that was assembled from more "
            f"than one signing run.")
    if ofs:
        want = ofs.pop()
        if len(entries) < want:
            integrity_log("broadcast",
                          f"short_manifest:{len(entries)}_of_{want}")
            sys.exit(
                f"[!] {path} holds {len(entries)} transaction(s) but the plan "
                f"had {want}.\n"
                f"    The signing run did not finish. Relaying what did sign "
                f"would push the early\n"
                f"    hops onto the chain and strand the funds on an "
                f"intermediate subaddress, in a\n"
                f"    half-executed shape that is distinctive on-chain.\n"
                f"    Re-run the offline signing phase until it reports "
                f"{want}/{want}, then relay.")
        if len(entries) > want:
            integrity_log("broadcast",
                          f"overlong_manifest:{len(entries)}_of_{want}")
            sys.exit(
                f"[!] {path} holds {len(entries)} transaction(s) but says the "
                f"plan had {want}.\n"
                f"    Refusing to relay entries the plan does not account "
                f"for.")

    # A HOLE, which needs no count: the signer numbers a plan's transactions
    # 0..n-1 and writes one entry per signed transaction, so a gap in the
    # indices is a transaction that did not sign. Only checked when every
    # entry carries an idx -- a manifest of bare filenames has none.
    idxs = [e["idx"] for e in dicts
            if isinstance(e.get("idx"), int) and not isinstance(e["idx"], bool)]
    if len(idxs) == len(entries) and idxs and min(idxs) == 0:
        missing = sorted(set(range(max(idxs) + 1)) - set(idxs))
        if missing:
            integrity_log("broadcast", f"gapped_manifest:{len(missing)}_missing")
            sys.exit(
                f"[!] {path} is missing transaction(s) "
                f"{', '.join(str(m) for m in missing[:8])}"
                f"{'...' if len(missing) > 8 else ''} from a chain of "
                f"{max(idxs) + 1}.\n"
                f"    The signing run did not finish. Relaying the "
                f"transactions around a gap strands\n"
                f"    the funds on the subaddress the missing one was "
                f"supposed to move them off.\n"
                f"    Re-run the offline signing phase, then relay.")


def _items_from_manifest(entries: list, mdir: Path) -> List[TxItem]:
    """Build the relay list from manifest entries.

    An entry stays in the list even when its file is currently absent. The old
    code dropped absent entries, which changed the progress fingerprint, which
    made the next --resume abort with "delete the progress file" -- and
    deleting it re-broadcasts every TX already relayed. Holding the slot lets
    the per-TX transient path handle the absence and lets a later --resume
    pick the blob up once it is readable again.
    """
    items: List[TxItem] = []
    seen: dict = {}
    for pos, e in enumerate(entries):
        if isinstance(e, dict):
            if "file" not in e:
                sys.exit(f"[!] Manifest entry {pos} has no 'file' field.")
            raw = Path(str(e["file"]))
            # Strict types, matching the signer's own manifest validation. The
            # manifest is the sign->relay trust boundary; a float, a bool or a
            # negative index means it was tampered with or corrupted, and
            # coercing it would silently mis-key a transaction's delay.
            if "idx" in e:
                if isinstance(e["idx"], bool) or not isinstance(e["idx"], int) or e["idx"] < 0:
                    sys.exit(f"[!] Manifest entry {pos}: 'idx' must be a non-negative int, "
                             f"got {e['idx']!r}.")
                idx = e["idx"]
            else:
                idx = _blob_sort_key(raw)
            sha = e.get("hash")
            if sha is not None and (not isinstance(sha, str) or len(sha) != 64):
                sys.exit(f"[!] Manifest entry {pos}: 'hash' must be a 64-char sha256 hex "
                         f"digest. Refusing to relay against an unusable hash.")
            delay = e.get("delay", 0)
            if not delay_is_sane(delay, cap=False):
                sys.exit(f"[!] Manifest entry {pos}: 'delay' must be a non-negative int, "
                         f"got {delay!r}.")
            if delay > MAX_PLANNED_DELAY:
                sys.exit(f"[!] Manifest entry {pos}: planned delay of {delay}s exceeds the "
                         f"{MAX_PLANNED_DELAY}s sanity cap. A manifest that stalls the relay "
                         f"indefinitely leaves signed transactions sitting unbroadcast; "
                         f"regenerate the plan.")
        else:
            raw = Path(str(e))
            idx = _blob_sort_key(raw)
            sha, delay = None, 0

        # Prefer the recorded path when it exists, else the same filename beside
        # the manifest (the normal case when the staging dir was moved between
        # the signing machine and this one). When neither exists yet, the
        # manifest-local path is the EXPECTED location, so a blob that appears
        # there later is found on resume.
        local = mdir / raw.name
        path = raw if raw.exists() else local

        if path.name in seen:
            sys.exit(
                f"[!] Manifest entries {seen[path.name]} and {pos} both resolve to "
                f"{path.name}. Refusing to relay an ambiguous manifest."
            )
        seen[path.name] = pos
        items.append(TxItem(idx, path, sha, delay))
    return items


class ProgressFile:
    """The crash-resume record: which blobs relayed, which failed for good.

    Was a closure over main()'s locals, so the only way to test "does a crash
    mid-batch resume correctly?" was to run a batch and crash it. As an object
    the same state can be constructed, mutated and asserted on directly.

    relayed/failed_perm are the caller's own sets, held by reference on
    purpose: the relay loop adds to them as it goes and persist() snapshots
    whatever they hold at that moment.
    """

    def __init__(self, path, prog: dict, relayed: set, failed_perm: set):
        self.path = path
        self.prog = prog
        self.relayed = relayed
        self.failed_perm = failed_perm

    def persist(self) -> None:
        self.prog["relayed"] = sorted(self.relayed)
        self.prog["failed_perm"] = sorted(self.failed_perm)
        atomic_write_json(self.prog, self.path)


class EgressGate:
    """Re-verify Tor AND the daemon's relay egress before a transaction goes out.

    The startup check is a single point-in-time sample. A broadcast batch runs
    for hours -- a daemon that was Tor-only at startup can pick up clearnet
    peers mid-run (peers churn, Tor circuits drop), and every TX relayed after
    that point leaves from the operator's IP.

    This was a closure whose rate-limit lived in a `nonlocal last_tor_check`.
    As an object that timestamp is ordinary instance state, so the gate can be
    driven straight from a test -- including the case that matters most, where
    egress degrades between two submits in the same batch.

    force=True is passed immediately before each submit, and in particular
    AFTER a planned delay has elapsed. An earlier build ran this at the TOP of
    the loop body, before a delay that can be hours long, so the egress state
    it acted on was up to a full delay stale by the time the transaction went
    out -- the exact "verified, then assumed" pattern the check exists to close.
    """

    #: Once per process. This warning is about a MISSING flag, so it is the
    #: same on every submit; printing it per transaction would train the
    #: operator to scroll past it.
    _warned_no_daemon = False

    def __init__(self, args, proxy, progF, relayed: set):
        self.args = args
        self.proxy = proxy
        self.progF = progF
        self.relayed = relayed
        self.last_tor_check = time.time()

    def check(self, tag: str, force: bool) -> None:
        """Re-verify egress. The DAEMON check runs before every submit.

        THESE TWO CHECKS WERE GATED TOGETHER, AND ONLY ONE CAN AFFORD TO BE.
        The whole method returned early unless `force` or the 300s timer had
        elapsed, and the only caller passes `force=item.delay > 0`. So for any
        transaction with NO planned delay, neither check ran before its submit
        -- it relied on a sample taken up to five minutes earlier. "No delays
        found" is an explicitly supported, warned-about configuration in which
        EVERY transaction has delay 0, so a whole batch could relay off one
        stale sample while this file's header promised the egress was
        "re-verified immediately before each submit (not merely on a timer)".

        Split by what each costs:

        * tor_recheck is an external request to check.torproject.org. Doing it
          per transaction would put N extra requests on the wire for a batch of
          N, which is its own pattern. It stays timer-gated, and forced before
          a delayed transaction because the delay itself is what makes the
          previous sample stale.
        * check_daemon_relay_egress asks the operator's OWN daemon who its
          peers are. For the normal loopback daemon that is a local RPC costing
          nothing, and it is the leak-critical fact for THIS transaction --
          would this tx go to raw-IP peers? It now runs before every submit,
          which is what the header claimed all along.
        """
        if not self.proxy:
            return
        if force or (time.time() - self.last_tor_check) > TOR_RECHECK_INTERVAL:
            tor_recheck(self.proxy, tag)
            self.last_tor_check = time.time()
        if not self.args.rpc_daemon:
            # SAY IT ONCE, RATHER THAN LEAVE THE HEADER TO BE BELIEVED. This
            # module's own header promises the daemon's relay egress is
            # "re-verified immediately before EVERY submit". Without
            # --rpc-daemon -- which has no default -- this returns here and
            # that check never runs at all, on any submit, and nothing said so.
            # An operator who read the header has a guarantee they do not have.
            if not EgressGate._warned_no_daemon:
                EgressGate._warned_no_daemon = True
                print("  [!] No --rpc-daemon, so the daemon's RELAY EGRESS is "
                      "NOT checked before submits.")
                print("      The Tor exit check above still runs. What is not "
                      "running is the one that asks")
                print("      whether your monerod would hand this transaction "
                      "to raw-IP peers. Pass")
                print("      --rpc-daemon http://127.0.0.1:18081 to get it.")
                integrity_log("broadcast", "egress_gate_no_daemon")
            return
        _eg = check_daemon_relay_egress(self.args.rpc_daemon, self.proxy)
        if _eg["verdict"] != "clearnet":
            return
        integrity_log("broadcast", f"relay_egress_DEGRADED:{tag}")
        print(f"  [!] Relay egress became CLEARNET mid-broadcast: {_eg['detail']}")
        if not self.args.allow_clearnet_relay:
            sys.exit(
                f"[!] Stopping after {len(self.relayed)} relayed TX(s). monerod is now\n"
                f"    relaying to raw-IP peers, so every REMAINING transaction would\n"
                f"    be broadcast from your IP. Fix monerod (--tx-proxy tor,...)\n"
                f"    and resume with --resume {self.progF} to finish the batch."
            )


def _sleep_interruptible(secs: int) -> bool:
    """Sleep in chunks; return False if a shutdown was requested part-way.

    Chunked so a planned delay of hours still notices Ctrl-C within 30s. A
    shutdown during a delay ABORTS the transaction rather than relaying it on
    the way out -- the operator asked to stop.
    """
    waited = 0
    while waited < secs:
        if shutdown_requested():
            return False
        chunk = min(30, secs - waited)
        time.sleep(chunk)
        waited += chunk
    return True


def build_cli() -> argparse.ArgumentParser:
    """Every option the relayer accepts, in one inspectable place.

    Returns the parser rather than parsed args so defaults can be asserted
    without driving a broadcast -- notably that --allow-clearnet-relay
    defaults OFF, since it is the one flag that lets transactions leave
    from the operator's own IP.
    """
    cli = argparse.ArgumentParser(
        "broadcast_signed_xmr v10.0",
        description="Broadcast pre-signed Monero TX blobs with Tor + retry",
    )
    cli.add_argument("path",
                     help="dir with *.signed files, a single .signed file, or "
                          "signed_manifest_v1.json")
    cli.add_argument("--tor-proxy",
                     help="SOCKS5 proxy for all network access")
    cli.add_argument("--rpc", default="http://127.0.0.1:18083",
                     help="monero-wallet-rpc endpoint (NOT the daemon). Relay "
                          "uses submit_transfer, a wallet-rpc json_rpc method, "
                          "which imports+broadcasts each signed tx set.")
    cli.add_argument("--rpc-alt", help="fallback RPC")
    cli.add_argument("--rpc-list",
                     help="file with RPC endpoints, one per line")
    cli.add_argument("--rebroadcast", type=int, default=5,
                     help="max rebroadcast attempts per TX")
    cli.add_argument("--timeout-min", type=int, default=30,
                     help="per-TX broadcast timeout in minutes")
    cli.add_argument("--rpc-daemon",
                     help="monerod RPC (NOT wallet-rpc, e.g. http://127.0.0.1:18081). "
                          "When given, the relay egress is VERIFIED by inspecting the "
                          "daemon's peer connections instead of merely warned about.")
    cli.add_argument("--allow-clearnet-relay", action="store_true",
                     help="Proceed even when the daemon is verified to relay to raw-IP "
                          "peers. This reveals to those peers that the transaction "
                          "originated from your IP.")
    cli.add_argument("--resume", help="progress file for crash-resume")
    return cli


def build_rpc_pool(args) -> List[str]:
    """Assemble the wallet-rpc endpoints this run may relay through.

    More than one endpoint means a failed submit can be retried elsewhere
    rather than stalling the batch. Order is preserved -- --rpc first --
    so the operator's primary is always tried before any fallback.
    """
    rpc_pool: List[str] = [args.rpc]
    if args.rpc_alt:
        rpc_pool.append(args.rpc_alt)
    if args.rpc_list and Path(args.rpc_list).exists():
        rpc_pool += [
            line.strip()
            for line in Path(args.rpc_list).read_text().splitlines()
            if line.strip()
        ]
    if len(rpc_pool) > 1:
        print(f"  [!] {len(rpc_pool)} RPC endpoints given; submit_transfer only works "
              f"against the wallet-rpc that created the set. Others will reject it.")
    integrity_log_once("broadcast", f"rpc_pool:{len(rpc_pool)}_nodes")
    return rpc_pool


def load_progress(args, blob_fp: str, items: list) -> tuple:
    """Recover which blobs already relayed, so a resumed run never double-sends.

    `items` is needed by the v1 migration: the old format recorded relayed
    transactions by LIST POSITION, so translating it forward requires the
    current blob list to map those positions onto names.

    A Monero transaction relayed twice is not harmless: the second submit
    is a duplicate the network drops, but the operator cannot tell that
    from a genuine failure, and a batch that loses track of its own state
    can just as easily SKIP one that never went out. So the record is
    keyed by blob NAME (not list position, which shifts the moment a blob
    is added or removed) and fenced by a fingerprint of the blob set: a
    progress file written for a different batch must not be applied to
    this one.

    Returns (progF, prog, relayed, failed_perm). Extracted from main() so
    the resume rules can be tested directly rather than by crashing a
    live broadcast half-way through.
    """
    progF = Path(args.resume) if args.resume else Path("broadcast_progress.json")
    relayed: set = set()
    failed_perm: set = set()
    if progF.exists():
        with open(progF) as f:
            prog = json.load(f)
        prog.setdefault("log", [])
        saved_fp = prog.get("blob_fingerprint", "")

        if prog.get("schema") == PROGRESS_SCHEMA:
            if saved_fp and saved_fp != blob_fp:
                integrity_log("broadcast", "STALE_PROGRESS:blob_set_changed")
                sys.exit(
                    "[!] Broadcast progress is from a DIFFERENT set of blobs!\n"
                    "    Use the matching blob set, or point --resume at that set's\n"
                    "    progress file. Do NOT delete this one to get past the check:\n"
                    "    it records which TXs are already on-chain, and re-broadcasting\n"
                    "    them is what the check exists to prevent."
                )
            # IDENTITY THAT CANNOT BE PROVEN IS SAID OUT LOUD. The
            # fingerprint covers each blob's name AND its manifest hash, so
            # two different batches are distinguishable -- unless the manifest
            # is the legacy plain-filename form, which records no hashes. Then
            # the fingerprint degrades to names, every batch is
            # tx_0.signed/tx_1.signed/..., and a progress file from a
            # DIFFERENT batch of the same size would pass this check and make
            # us skip transactions that were never sent.
            #
            # Not fatal -- refusing would strand an operator mid-batch on a
            # legacy manifest -- but never silent, because the failure mode is
            # "reports success, broadcast nothing".
            if not any(i.sha for i in items):
                integrity_log("broadcast", "resume_identity_unprovable")
                print("  [!] This manifest records no blob hashes, so the "
                      "progress file can only be matched by FILENAME.")
                print("      Every batch is named tx_0.signed, tx_1.signed, "
                      "... — so if this progress file came from a DIFFERENT "
                      "batch of the same size, the transactions it lists as "
                      "relayed will be SKIPPED here and never sent, and the "
                      "run will report success.")
                print("      Check that "
                      f"{progF} belongs to THIS batch before continuing.")
            relayed = {str(k) for k in prog.get("relayed", [])}
            failed_perm = {str(k) for k in prog.get("failed_perm", [])}
        else:
            # v1 migration. v1's fingerprint was taken over the PRESENT blobs in
            # list order, and v1 refused to run unless it matched -- so when it
            # matches here, mapping v1's positions onto that same ordered list
            # is exactly what v1 itself meant by them. When it does not match,
            # the positions are uninterpretable and guessing could skip a TX
            # that was never sent, so refuse instead.
            present = [i for i in items if i.path.exists()]
            legacy_fp = hashlib.sha256(
                "|".join(i.key for i in present).encode()
            ).hexdigest()[:32]
            if saved_fp and saved_fp != legacy_fp:
                integrity_log("broadcast", "STALE_PROGRESS:v1_unmappable")
                sys.exit(
                    "[!] This progress file is in the old position-keyed format and its\n"
                    "    recorded blob set does not match the blobs present now, so its\n"
                    "    entries cannot be mapped to transactions safely.\n"
                    "    Re-run against the exact blob set it was created from."
                )

            def _map(seq):
                out = set()
                for n in seq:
                    if isinstance(n, bool) or not isinstance(n, int):
                        continue
                    if 0 <= n < len(present):
                        out.add(present[n].key)
                return out

            relayed = _map(prog.get("relayed", []))
            failed_perm = _map(prog.get("failed_perm", []))
            integrity_log("broadcast", f"progress_migrated_v1:{len(relayed)}_relayed")
            print(f"  [+] Migrated v1 progress file: {len(relayed)} relayed, "
                  f"{len(failed_perm)} permanently failed.")
    else:
        prog = {"log": []}

    prog["schema"] = PROGRESS_SCHEMA
    prog["blob_fingerprint"] = blob_fp
    return progF, prog, relayed, failed_perm


def main():
    install_signal_handlers()

    cli = build_cli()
    args = cli.parse_args()

    if not args.tor_proxy:
        sys.exit(
            "[!] --tor-proxy is REQUIRED. Broadcasting over clearnet leaks your IP\n"
            "    to every Monero node you submit transactions to. Aborting."
        )
    proxy = validate_proxy(args.tor_proxy)
    verify_tor(proxy)

    # OPSEC boundary warning. Relay goes through wallet-rpc submit_transfer,
    # which imports the signed set and broadcasts it over the WALLET-RPC's OWN
    # daemon connection -- NOT over this script's Tor proxy. Our verify_tor /
    # newnym / tor_recheck only cover the (localhost, direct) submit call and
    # the delay pacing; they do NOT anonymize where the tx actually leaves the
    # machine. The operator MUST run monero-wallet-rpc/monerod behind Tor
    # (e.g. monerod --tx-proxy tor,127.0.0.1:9050 and wallet-rpc --proxy) or the
    # broadcast egress is clearnet regardless of what this script reports.
    print("  [!] OPSEC: relay egress is controlled by the wallet-rpc/monerod")
    print("  [!] Tor config (--tx-proxy/--proxy), NOT by this script.")
    integrity_log_once("broadcast", "egress_via_walletrpc_daemon_conn")

    # Actually CHECK that egress instead of only telling the operator to. The
    # transaction leaves the machine via monerod's peer connections, so a
    # perfectly Tor-proxied pipeline still deanonymises the tx if the daemon
    # talks to clearnet peers. Requires --rpc-daemon (the daemon, not the
    # wallet-rpc); without it we can only repeat the warning.
    if args.rpc_daemon:
        eg = check_daemon_relay_egress(args.rpc_daemon, proxy)
        integrity_log_once("broadcast", f"relay_egress:{eg['verdict']}")
        if eg["verdict"] == "clearnet":
            print(f"  [!] RELAY EGRESS IS CLEARNET: {eg['detail']}")
            if not args.allow_clearnet_relay:
                sys.exit(
                    "[!] Refusing to broadcast. monerod is relaying to raw-IP peers,\n"
                    "    so submitting this transaction would reveal to those peers\n"
                    "    that it originated from your IP -- defeating the entire\n"
                    "    mixing pipeline.\n"
                    "    Fix: restart monerod with --tx-proxy tor,127.0.0.1:9050\n"
                    "         (and typically --anonymous-inbound / no clearnet peers).\n"
                    "    WHAT THIS DID AND DID NOT OBSERVE: monerod exposes no RPC that\n"
                    "    reports its --tx-proxy setting (checked on 0.18.3.1), so this\n"
                    "    reads the P2P PEER LIST instead. If you HAVE set --tx-proxy, your\n"
                    "    tx relay may already be anonymous while block sync legitimately\n"
                    "    keeps clearnet peers — and this check cannot tell those apart. In\n"
                    "    that case the override below is the right answer; otherwise it is\n"
                    "    not.\n"
                    "    Override only if you understand the exposure: "
                    "--allow-clearnet-relay"
                )
            print("  [!] --allow-clearnet-relay given; continuing DESPITE clearnet egress.")
        elif eg["verdict"] == "tor":
            print(f"  [+] Relay egress verified anonymous: {eg['detail']}")
        elif eg["verdict"] == "offline":
            sys.exit(f"[!] {eg['detail']} — the broadcast would silently go nowhere.")
        else:
            print(f"  [!] Could NOT verify relay egress ({eg['detail']}).")
            print("  [!] Treat the broadcast as clearnet unless you configured Tor.")
    else:
        print("  [!] Pass --rpc-daemon to have this script VERIFY the relay egress")
        print("  [!] instead of trusting it.")

    # Build RPC pool. NOTE: a signed tx-set can only be submitted by the
    # wallet-rpc that CREATED it (it holds the matching key images), so
    # --rpc-alt / --rpc-list of *other* wallet-rpcs will reject the set. They
    # are only useful as replicas of the same wallet; otherwise leave them out.
    rpc_pool = build_rpc_pool(args)

    if args.rebroadcast < 1:
        sys.exit("[!] --rebroadcast must be >= 1 (0 would attempt nothing and still report failure).")
    if args.timeout_min < 1:
        sys.exit("[!] --timeout-min must be >= 1 (0 expires the window before the first attempt).")

    # ------------------------------------------------------------ relay list
    # Derived from the MANIFEST wherever one exists: the manifest carries each
    # TX's real index, its expected hash and its planned delay, and -- unlike a
    # directory glob -- it does not change shape when a blob is momentarily
    # unreadable.
    items: List[TxItem] = []
    input_path = Path(args.path)
    delay_source = "none"

    if args.path.endswith(".json"):
        items = _items_from_manifest(_load_manifest(input_path), input_path.parent)
        delay_source = "manifest_direct"
    elif input_path.is_dir():
        manifest_path = input_path / "signed_manifest_v1.json"
        if manifest_path.exists():
            items = _items_from_manifest(_load_manifest(manifest_path), input_path)
            delay_source = "manifest"
            # Only relay blobs that are IN the manifest. Stale blobs from a
            # prior run (different destinations/amounts) must never be picked
            # up by the glob; report them so the operator knows they are there.
            known = {i.key for i in items}
            stray = [p.name for p in input_path.glob("*.signed") if p.name not in known]
            if stray:
                integrity_log("broadcast", f"rejected_unmanifested_blobs:{len(stray)}")
                print(f"  [!] Ignoring {len(stray)} blob(s) not in the manifest "
                      f"(stale from a prior run?): {', '.join(sorted(stray)[:5])}")
        else:
            # No manifest: fall back to a glob. There is nothing to verify
            # hashes or delays against, which is strictly weaker -- say so.
            raw_blobs = list(input_path.glob("*.signed")) or list(input_path.glob("*.blob"))
            items = [TxItem(_blob_sort_key(p), p) for p in sorted(raw_blobs, key=_blob_sort_key)]
            print("  [!] No signed_manifest_v1.json in that directory: blob hashes "
                  "CANNOT be verified and planned delays are unknown.")
    elif input_path.exists():
        items = [TxItem(_blob_sort_key(input_path), input_path)]
    else:
        sys.exit(f"[!] No such path: {input_path}")

    if not items:
        sys.exit("[!] No blobs found to broadcast")

    # Relay in index order regardless of the order the manifest happens to list
    # entries in. The planned delays are served sequentially, so list order is
    # part of the timing plan -- a reordered manifest must not silently change
    # the sequence the plan was built around.
    items.sort(key=lambda i: i.idx)
    integrity_log_once("broadcast", f"blobs_found:{len(items)}")

    manifest_hashes = {i.key: i.sha for i in items if i.sha}

    # Delay fallback: the unsigned plan, when the manifest carried none. Plan
    # entries are written in idx order by phase_create, so position == idx.
    #
    # IT MUST BE THE RIGHT PLAN, and the first version of this could not tell.
    # It took
    #
    #     sorted(Path(".").glob("unsigned/unsigned_*.json"), reverse=True)[0]
    #
    # -- the lexicographically greatest filename in one hardcoded directory --
    # and applied whatever delays it found, keyed by index, to whatever blobs
    # were being relayed. A run leaves several plans side by side (veil,
    # fanout, dag), the tag in each name is random hex, and the exit writes
    # unsigned_exit_*.json somewhere else entirely, so "greatest filename" is
    # not a match, it is a coin flip. Worse, it then printed
    #
    #     [+] TX delays loaded from unsigned_plan (1 entries)
    #
    # which reads as confirmation. A wrong delay is not a neutral outcome here:
    # the delays are the mechanism that keeps a batch from relaying as one
    # timing cluster, and silently serving another plan's schedule is exactly
    # the correlation they exist to destroy -- announced as success.
    #
    # So the fallback now has to EARN it: a candidate is only usable if its tx
    # count matches the number of blobs in hand, and if exactly one candidate
    # does. Anything else falls through to the honest "no delays found"
    # warning below, which is a true statement about a run that is about to
    # relay without them. This is a legacy path either way -- phase_create
    # writes the delay into unsigned_manifest.json and phase_sign carries it to
    # signed_manifest_v1.json, both covered end to end by
    # tests/real_delay_pipeline_testnet.py -- so refusing to guess costs
    # nothing a correctly signed batch needs.
    # Bound OUTSIDE the branch that fills it. The reader below sits in the
    # `else` of a condition equivalent to this `if`, so it is reachable only
    # when this block ran -- true today, and a coupling between two separate
    # conditions that a later edit would not see.
    rejected = []
    if not any(i.delay for i in items):
        candidates = []
        for pf_path in sorted(Path(".").glob("unsigned/unsigned_*.json")):
            try:
                with open(pf_path) as pf:
                    plan_data = json.load(pf)
            except Exception:                                # noqa: BLE001
                continue
            if not (isinstance(plan_data, dict)
                    and isinstance(plan_data.get("txs"), list)):
                continue
            txs = plan_data["txs"]
            if len(txs) != len(items):
                continue
            by_idx = {}
            _bad_delay = None
            for pos, tx in enumerate(txs):
                if isinstance(tx, dict) and "delay" in tx:
                    # THE SAME RULE THE MANIFEST GETS. This was
                    # `int(tx["delay"])` in a try/except (TypeError,
                    # ValueError) -- but int() coerces, so a bool, a float, a
                    # numeric string and a negative all sailed through the
                    # except and became a delay. See delay_is_sane.
                    #
                    # DISCARD THE CANDIDATE rather than exit: this is a
                    # best-effort recovery from whatever plans happen to be in
                    # ./unsigned, and a stray malformed one must not stop a
                    # relay whose own manifest is fine. Same shape the old
                    # except had.
                    if not delay_is_sane(tx["delay"]):
                        _bad_delay = (pos, tx["delay"])
                        by_idx = {}
                        break
                    by_idx[pos] = tx["delay"]
            if by_idx:
                candidates.append((pf_path, by_idx))
            elif _bad_delay is not None:
                # SAY THAT A MATCHING PLAN WAS THROWN AWAY. Discarding it
                # silently leaves exactly one line of output -- "WARNING: No TX
                # delays found - all TXs will broadcast with minimal gap!" --
                # which reads as "there is no plan for these blobs" and sends
                # the operator to re-sign. The truth is that a plan matching
                # this batch IS there and one field in it is not a delay,
                # which is a five-second fix on a file they already have.
                #
                # It matters because of what happens next: relaying with no
                # schedule is the timing correlation the delays exist to
                # prevent, and an operator who believes no schedule exists will
                # proceed.
                rejected.append((pf_path.name, _bad_delay))
        if len(candidates) == 1:
            for it in items:
                it.delay = candidates[0][1].get(it.idx, 0)
            delay_source = f"unsigned_plan {candidates[0][0].name}"
        elif len(candidates) > 1:
            # Naming them, because the operator is the only one who can say
            # which plan these blobs came from.
            print(f"  [!] {len(candidates)} unsigned plans in ./unsigned match "
                  f"this batch's {len(items)} blob(s), so which one holds "
                  f"their delays cannot be determined: "
                  + ", ".join(c[0].name for c in candidates) + ".")
            print("  [!] Refusing to guess — serving another plan's schedule "
                  "is the timing correlation the delays exist to prevent. "
                  "Re-sign so the manifest carries them, or move the other "
                  "plans aside.")

    if any(i.delay for i in items):
        n_delays = sum(1 for i in items if i.delay)
        integrity_log_once("broadcast", f"delays_loaded:{delay_source}")
        print(f"  [+] TX delays loaded from {delay_source} ({n_delays} entries)")
    else:
        integrity_log("broadcast", "WARNING:no_delays_found")
        print("  [!] WARNING: No TX delays found - all TXs will broadcast with minimal gap!")
        # ...AND IF A MATCHING PLAN WAS THROWN AWAY, SAY SO. Without this the
        # line above is the operator's whole picture, and it means "no plan
        # exists" -- so they re-sign, or they shrug and relay with no schedule.
        # A plan that matched this batch and was discarded for one unusable
        # delay field is a different situation with a much cheaper fix, and it
        # was invisible.
        for _name, (_pos, _val) in rejected:
            print(f"  [!] {_name} MATCHES this batch but was discarded: its "
                  f"tx[{_pos}] 'delay' is {_val!r}, which is not a "
                  f"non-negative int at most {MAX_PLANNED_DELAY}s.")
            print(f"  [!] That is a corrupt or tampered plan file, not a "
                  f"missing one — fix that field (or re-sign so the manifest "
                  f"carries the delays) rather than relaying with no "
                  f"schedule.")
            integrity_log("broadcast", "plan_rejected:bad_delay")
        print("  [!] This creates a timing cluster visible to chain analysts.")

    # Fail fast on tampering in blobs that are readable NOW. This is only an
    # early warning: the authoritative check is re-run immediately before each
    # submit, because this pass can be hours stale by the time a TX with a long
    # planned delay actually goes out.
    if manifest_hashes:
        tampered = [i.key for i in items if i.sha and i.path.exists()
                    and hashlib.sha256(i.path.read_bytes()).hexdigest() != i.sha]
        if tampered:
            integrity_log("broadcast", f"TAMPER_DETECTED:{len(tampered)}_blobs")
            for t in tampered:
                print(f"  [!] TAMPERED: {t}")
            sys.exit(f"[!] {len(tampered)} blob(s) failed hash verification! Aborting.")
        # COUNT WHAT WAS CHECKED, NOT WHAT WAS THERE.
        #
        # `tampered` above only examines entries where i.sha is truthy -- an
        # entry with no 'hash' key is never hashed, here or at the
        # authoritative pre-submit re-check (`if item.sha:` further down). This
        # line counted every PRESENT blob and called them all OK. Driven: a
        # two-entry manifest, one entry with its hash stripped, that blob then
        # overwritten with different bytes -- and the operator is told
        #
        #     [+] Manifest verification: 2/2 present blobs OK
        #
        # about a batch in which one blob was never hashed by anything. The
        # single line whose job is to report the sign->relay integrity check
        # said it passed for a blob it had not looked at.
        _present = [i for i in items if i.path.exists()]
        _checked = [i for i in _present if i.sha]
        _unchecked = [i.key for i in _present if not i.sha]
        # A MIXED MANIFEST IS NOT A LEGACY MANIFEST, and the difference decides
        # whether this refuses. Both manifest writers in airgap_tx_signer emit
        # "hash" unconditionally for every entry, so no version of this
        # toolchain produces a file where some entries have one and others do
        # not. The all-hashless case IS a real older format and is handled
        # further up by a warning rather than a refusal, on the stated grounds
        # that refusing would strand an operator mid-batch -- that reasoning
        # does not reach a shape the signer cannot write.
        if _unchecked:
            integrity_log("broadcast", f"manifest_partial_hashes:{len(_unchecked)}")
            sys.exit(
                f"[!] This manifest hashes some blobs and not others: "
                f"{len(_checked)} of {len(_present)} present blob(s) carry a "
                f"'hash'.\n"
                f"    Missing on: {', '.join(sorted(_unchecked)[:5])}\n"
                f"    Every manifest this toolchain writes hashes EVERY entry, "
                f"so this file was not\n"
                f"    written by it. An unhashed entry is never verified here "
                f"nor at the per-TX check\n"
                f"    before submit, so relaying it would broadcast a blob "
                f"nothing has checked, under a\n"
                f"    verification line that counts it as OK.\n"
                f"    Regenerate the manifest from airgap_tx_signer. If you "
                f"genuinely mean to relay an\n"
                f"    unverifiable batch, remove the 'hash' field from EVERY "
                f"entry: that is the legacy\n"
                f"    format, it is accepted, and it says so instead of "
                f"claiming a check it did not do.")
        # _checked == _present here, necessarily: the refusal above exits on
        # any present-but-unhashed entry, so nothing present is unchecked by
        # the time control reaches this line. The count is written as
        # len(_checked) because that is what the sentence CLAIMS -- blobs that
        # were verified -- and a reader should not have to prove the
        # equivalence to know the number is honest. It also means no mutation
        # of this expression alone can change the output, which is why the
        # sweep carries no anchor for it: the guarantee lives in the refusal.
        integrity_log_once("broadcast",
                           f"manifest_verified:{len(_checked)}_blobs_ok")
        print(f"  [+] Manifest verification: {len(_checked)}/{len(_present)} "
              f"present blobs OK")

    absent = [i.key for i in items if not i.path.exists()]
    if absent:
        print(f"  [!] {len(absent)} manifested blob(s) not readable yet: "
              f"{', '.join(sorted(absent)[:5])}")
        print(f"  [!] They keep their slot and will be retried with --resume.")

    # Fingerprint over the SET of blob names AND THEIR RECORDED HASHES, so a
    # momentarily-absent blob does not change it. The old fingerprint was over
    # the presence-filtered list, so one unreadable blob made --resume abort
    # with "delete the progress file" -- and deleting it re-broadcasts
    # everything already relayed. That fix is kept: the hashes come from the
    # MANIFEST, not from reading the blobs, so an absent blob still fingerprints.
    #
    # NAMES ALONE COULD NOT TELL TWO BATCHES APART, which is the one job this
    # fingerprint has. load_progress calls it "fenced by a fingerprint of the
    # blob set: a progress file written for a different batch must not be
    # applied to this one" -- and every batch this toolchain produces is named
    # tx_0.signed, tx_1.signed, ... So two DIFFERENT batches with the same
    # number of transactions fingerprinted IDENTICALLY, and the second one
    # loaded the first one's `relayed` set, skipped its own transactions as
    # already-sent, and exited 0 reporting success. Nothing was broadcast.
    #
    # Reproduced directly against load_progress: two single-transaction batches
    # with different contents, same names -> same fingerprint -> the second
    # skips its only transaction.
    #
    # GhostSpiral does not hit this: it passes
    # --resume <staging>/bcast_progress.json, a fresh path per round. The
    # exposure is the documented STANDALONE use -- two batches broadcast by
    # hand from one directory, where progF defaults to ./broadcast_progress.json
    # and is never deleted after a successful run.
    #
    # A missing hash (the legacy plain-filename manifest form) contributes an
    # empty string, so such a manifest is no worse off than before -- and
    # load_progress warns when it cannot prove identity that way.
    blob_fp = hashlib.sha256(
        "|".join(sorted(f"{i.key}:{i.sha or ''}" for i in items)).encode()
    ).hexdigest()[:32]

    # Progress state, split by outcome so resume and success-reporting are both
    # correct:
    #   'relayed'     -- successfully broadcast; skipped on resume.
    #   'failed_perm' -- permanently rejected (double-spend / low-fee / corrupt
    #                    blob); skipped on resume because retrying cannot help,
    #                    but deliberately NOT counted as relayed, so the batch
    #                    reads incomplete.
    # A transient failure (node down, timeout) and a missing/empty blob (drive
    # not mounted yet, momentary zero-length) go into NEITHER set -- only the
    # log -- so a --resume re-run actually retries them. Success is defined as
    # "every blob relayed" and checked at exit, so a resume that only re-skips
    # permanent failures can never be mistaken for success.
    #
    # Both sets are keyed on the blob FILENAME. v1 keyed them on the loop
    # position, which silently referred to a different TX whenever the list
    # shape changed.
    progF, prog, relayed, failed_perm = load_progress(args, blob_fp, items)

    progress = ProgressFile(progF, prog, relayed, failed_perm)
    _persist = progress.persist

    import secrets as _secrets
    gate = EgressGate(args, proxy, progF, relayed)
    _egress_gate = gate.check
    success_count = 0
    fail_count = 0
    skip_count = 0

    aborted = False
    for item in items:
        real_idx = item.idx
        blob = item.path

        if shutdown_requested():
            integrity_log("broadcast", f"shutdown_at_tx_{real_idx}")
            print(f"  [!] Shutdown at TX {real_idx}. Resume with --resume {progF}")
            aborted = True
            break

        if item.key in relayed or item.key in failed_perm:
            skip_count += 1
            continue

        def _transient(reason: str) -> None:
            integrity_log("broadcast", f"{reason}:idx={real_idx}")
            prog["log"].append({"idx": real_idx, "file": str(blob), "name": item.key,
                                "sent": False, "error": reason})
            _persist()

        # Cheap pre-checks before committing to a possibly hours-long delay.
        if not blob.exists():
            # TRANSIENT (drive not mounted, staging not synced yet): recorded
            # but not marked permanent, so --resume retries it.
            print(f"  [!] Missing: {item.key} - will retry on --resume {progF}")
            _transient("file_missing")
            fail_count += 1
            continue
        if blob.stat().st_size == 0:
            print(f"  [!] Empty blob {item.key} - will retry on --resume {progF}")
            _transient("empty_blob")
            fail_count += 1
            continue

        # Planned delay for timing decorrelation, keyed on the TX's REAL index
        # (from the manifest), never on its position in the list.
        #
        # A shutdown DURING the delay aborts this TX. The old code merely broke
        # out of the sleep and then relayed immediately -- so Ctrl-C during a
        # one-hour planned delay both ignored the operator AND collapsed the
        # delay to zero, publishing the transaction in the timing cluster the
        # delay existed to avoid.
        if item.delay > 0:
            print(f"  [*] Waiting {item.delay}s (planned delay for TX {real_idx})...")
            # The delay LENGTH is not written to the chain. The per-TX delays
            # are the mechanism that stops this batch relaying as one timing
            # cluster; recording them in a persistent file hands a reader the
            # exact relay schedule -- the very correlation the delays exist to
            # destroy -- and pairs it with the tx index. That the delay
            # HAPPENED is worth chaining; how long it was is not.
            integrity_log_once("broadcast", "delay")
            if not _sleep_interruptible(item.delay):
                integrity_log("broadcast", f"shutdown_during_delay:idx={real_idx}")
                print(f"  [!] Shutdown during the planned delay for TX {real_idx}: NOT "
                      f"relaying it early.")
                print(f"  [!] Resume with --resume {progF} to serve the full delay.")
                _transient("shutdown_during_delay")
                fail_count += 1
                aborted = True
                break

        # Fresh egress verification immediately before the submit, not before
        # the delay. Forced whenever we just slept.
        _egress_gate(f"broadcast_tx_{real_idx}", force=item.delay > 0)

        # Re-read and re-verify NOW. The startup hash pass is stale by the whole
        # planned delay, so it cannot vouch for the bytes about to be relayed;
        # a blob swapped during the wait would previously have been broadcast.
        try:
            raw_data = blob.read_bytes()
        except OSError as e:
            print(f"  [!] Unreadable at submit time: {item.key} ({e}) - will retry.")
            _transient("unreadable_at_submit")
            fail_count += 1
            continue
        if not raw_data:
            print(f"  [!] Empty blob {item.key} - will retry on --resume {progF}")
            _transient("empty_blob")
            fail_count += 1
            continue
        if item.sha:
            actual = hashlib.sha256(raw_data).hexdigest()
            if actual != item.sha:
                integrity_log("broadcast", f"TAMPER_DETECTED_AT_SUBMIT:idx={real_idx}")
                print(f"  [!] TAMPERED: {item.key} no longer matches its manifest hash.")
                sys.exit(
                    f"[!] {item.key} changed on disk after the manifest was verified.\n"
                    f"    Aborting the whole batch: the staging directory is not trustworthy.\n"
                    f"    {len(relayed)} TX(s) were already relayed; progress is in {progF}."
                )

        # The signed blob is a wallet SIGNED-TX-SET (what `sign_transfer`
        # emits), NOT a raw consensus transaction. It must be RELAYED via
        # monero-wallet-rpc's submit_transfer, which imports the signed set and
        # broadcasts it through the wallet's own daemon connection. The old code
        # hex-posted it to monerod's /sendrawtransaction, which cannot
        # deserialize a tx-set as a transaction and rejected every TX. So `--rpc`
        # is the WALLET-rpc endpoint here, and the payload is the tx-set hex.
        tx_data_hex = raw_data.hex()

        # NEWNYM before EVERY TX (including the first) for circuit isolation.
        #
        # WITH THE PROXY NAMED. Without it, newnym() falls back to its default
        # ctrl of /var/run/tor/control and rotates WHATEVER tor owns that path
        # -- which is not necessarily the tor carrying this relay. An operator
        # on Tor Browser (--tor-proxy socks5h://127.0.0.1:9150, a setup
        # gs_console's own detection offers and test_console pins) had every
        # transaction in the batch relayed through Tor Browser's tor while this
        # rotated the SYSTEM tor. _control_owns_socks, which exists to catch
        # exactly that, is skipped too: with no proxy_url it returns True
        # immediately. So "NEWNYM before EVERY TX" was true of the call and
        # false of the circuits, and the whole batch went out on one.
        #
        # tor_control_targets was added for this and applied to all 21 call
        # sites in the toolchain. These two -- in the process that actually
        # publishes the money -- were the ones it missed. Found by RUNNING the
        # pipeline end to end, not by a test: nothing had ever executed
        # GhostSpiral.main() far enough to spawn a real broadcast.
        newnym(required=True, proxy_url=getattr(args, "tor_proxy", ""))
        secure_delay(5.0, 15.0)

        attempts = args.rebroadcast
        outcome = "transient"   # relayed | double_spend | low_fee | transient
        txid = ""
        start_time = time.time()

        while attempts > 0 and (time.time() - start_time) < args.timeout_min * 60:
            rpc_url = rpc_pool[_secrets.randbelow(len(rpc_pool))]
            try:
                # submit_transfer is a WALLET-rpc json_rpc method: it imports the
                # signed tx set and relays every tx in it via the wallet's daemon.
                submit_url = rpc_url.rstrip("/") + "/json_rpc"
                res = _single_post(
                    submit_url,
                    {"jsonrpc": "2.0", "id": "0", "method": "submit_transfer",
                     "params": {"tx_data_hex": tx_data_hex}},
                    proxy,
                )
                result = res.get("result") or {}
                err = res.get("error") or {}
                tx_hashes = result.get("tx_hash_list") or []
                if tx_hashes:
                    # A signed set can carry more than one transaction; record
                    # every hash, not just the first, or the progress log
                    # under-reports what actually went on-chain.
                    txid = ",".join(str(h) for h in tx_hashes)
                    outcome = "relayed"
                    extra = f" (+{len(tx_hashes) - 1} more)" if len(tx_hashes) > 1 else ""
                    print(f"  [+] TX {real_idx} -> relayed | {str(tx_hashes[0])[:16]}...{extra}")
                    integrity_log_once("broadcast", "relayed")
                    break

                ecode = err.get("code") if isinstance(err, dict) else None
                # redact_addresses first: this is the NODE's text, not ours,
                # and the `or res` fallback stringifies the WHOLE RPC response
                # when there is no message field -- whatever that happens to
                # contain. wallet-rpc errors quote addresses back at the caller
                # for several conditions, and this line is printed on every
                # retry. Redacting is unconditional so it does not depend on
                # knowing which messages do.
                emsg = redact_addresses(str(err.get("message", "") or res))[:160]
                emsg_l = emsg.lower()
                print(f"  Node: {emsg[:80]}")
                # Classification uses the wallet-rpc error CODE where it's a
                # stable signal, and falls back to message pattern-matching.
                # ONLY clearly-permanent conditions are marked permanent; every
                # other error defaults to transient (retried on --resume). That
                # default is fail-safe -- a misread permanent error just wastes
                # retries and keeps the exit nonzero, never a false success or a
                # stranded-but-marked-done TX.
                #
                # Code -40 verified against real monero-wallet-rpc 0.18.3.1:
                # submit_transfer returns {"code":-40,"message":"Failed to parse
                # signed tx data."} for a corrupt/wrong-format blob. Retrying
                # can't fix a bad blob -- it needs re-signing -- so mark permanent.
                if ecode == -40 or "failed to parse" in emsg_l:
                    outcome = "bad_data"
                    integrity_log("broadcast", f"bad_signed_tx_data:idx={real_idx}")
                    print(f"  [!] TX {real_idx}: signed blob could not be parsed "
                          f"(corrupt/wrong format) -- needs re-signing. Skipping.")
                    break
                is_double = (("double" in emsg_l and "spend" in emsg_l)
                             or "key image" in emsg_l or "already spent" in emsg_l)
                if is_double:
                    outcome = "double_spend"
                    integrity_log("broadcast", f"DOUBLE_SPEND:idx={real_idx}")
                    print(f"  [!] TX {real_idx} flagged as double-spend! Skipping.")
                    break
                if "fee" in emsg_l and ("low" in emsg_l or "too small" in emsg_l
                                        or "not enough" in emsg_l):
                    outcome = "low_fee"
                    integrity_log("broadcast", f"low_fee_rejected:idx={real_idx}")
                    print("  [!] TX rejected: fee too low. Re-sign with higher --fee-priority.")
                    print("  [!] Monero does NOT support RBF - cannot bump fee on a signed TX.")
                    break
                # anything else: treat as transient and retry on a new circuit
            except Exception as e:
                # Same reasoning: an exception raised while talking to the
                # node can carry the URL or the response body in its message,
                # and this goes to BOTH the terminal and the integrity chain
                # (which is a file on disk).
                _emsg = redact_addresses(str(e))
                integrity_log("broadcast", f"error:idx={real_idx}:{type(e).__name__}")
                print(f"  [!] Error: {_emsg[:80]}")

            attempts -= 1
            if attempts > 0:
                # Same reasoning as the per-TX rotation above, and this one is
                # best-effort, so a wrong-daemon rotation here would have been
                # silent rather than merely useless.
                newnym(proxy_url=getattr(args, "tor_proxy", ""))
                secure_delay(5.0, 15.0)
                # AND RE-VERIFY BEFORE THE NEXT SUBMIT.
                #
                # The gate ran ONCE per transaction, above this loop. A
                # transaction gets --rebroadcast attempts (default 5) across
                # --timeout-min minutes (default 30), and every attempt after
                # the first re-submitted on a sample taken before the first --
                # across a newnym and a 5-15 s delay, which is exactly when
                # egress state changes. That is the "verified, then assumed"
                # pattern this gate's own docstring says it exists to close,
                # reintroduced one loop lower down.
                #
                # force=False, deliberately, and it is the same split the
                # docstring already argues: the DAEMON check is a local RPC
                # costing nothing and is the leak-critical fact for THIS
                # submit, so it runs every time; tor_recheck is an external
                # request whose per-transaction traffic would be its own
                # pattern, so it stays timer-gated -- and a retry window of up
                # to 30 minutes crosses TOR_RECHECK_INTERVAL on its own.
                _egress_gate(f"broadcast_tx_{real_idx}_retry", force=False)

        if outcome == "relayed":
            success_count += 1
            prog["log"].append({"idx": real_idx, "file": str(blob), "name": item.key,
                                "sent": True, "txid": txid})
            relayed.add(item.key); _persist()
        elif outcome in ("double_spend", "low_fee", "bad_data"):
            fail_count += 1
            prog["log"].append({"idx": real_idx, "file": str(blob), "name": item.key,
                                "sent": False, "error": outcome})
            failed_perm.add(item.key); _persist()   # permanent: skipped, never relayed
        else:
            # Transient: record but add to NEITHER set, so --resume retries it.
            fail_count += 1
            print(f"  [!] TX {real_idx} FAILED (transient) after {args.rebroadcast} attempts "
                  f"- will retry on --resume {progF}")
            _transient("transient")

    integrity_log_once("broadcast", "done")
    print(f"\n  [+] Broadcast complete: {success_count} relayed this run, "
          f"{fail_count} failed, {skip_count} skipped "
          f"({len(relayed)}/{len(items)} relayed total, {len(failed_perm)} permanently failed).")
    print(f"  [+] Progress: {progF}")

    # Success is defined as EVERY blob relayed (across this run + prior resumes).
    # Checking len(relayed) rather than this run's fail_count means a --resume
    # that only re-skips permanent failures cannot be mistaken for success by a
    # check=True caller, and permanent failures (double-spend/low-fee) keep the
    # exit nonzero until the operator re-signs and clears them. An operator
    # shutdown is likewise never a zero exit -- the batch is unfinished.
    if len(relayed) < len(items):
        unrelayed = len(items) - len(relayed)
        integrity_log("broadcast", f"exit_fail:{unrelayed}_unrelayed:{len(failed_perm)}_permfail")
        sys.exit(f"[!] Broadcast incomplete: {unrelayed}/{len(items)} TX(s) not relayed "
                 f"({len(failed_perm)} permanent"
                 f"{', stopped by operator' if aborted else ''}, rest transient — "
                 f"retry with --resume {progF}).")


if __name__ == "__main__":
    main()
