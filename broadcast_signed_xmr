#!/usr/bin/env python3
"""
broadcast_signed_xmr v10.0 - Resilient Monero relay & confirmation
===================================================================
Fee-aware, Tor-hardened, integrity-logged broadcast of pre-signed XMR blobs.

OPSEC hardening:
  - Tor verified before first broadcast and re-checked periodically
  - NEWNYM circuit rotation between every TX broadcast
  - Timing jitter between broadcasts to frustrate traffic analysis
  - Mine-wait has configurable timeout (default 2h)
  - Atomic progress writes survive crash
  - Fee-bump with proper subprocess error handling
  - Signal handlers for graceful shutdown mid-broadcast
  - All progress files written 0600
"""
from __future__ import annotations
import argparse, json, time, sys, os, hashlib
from pathlib import Path
from typing import List
from urllib.parse import urlparse

import requests

from gs_common import (
    integrity_log, verify_tor, tor_recheck, validate_proxy,
    newnym, secure_delay, atomic_write_json,
    install_signal_handlers, shutdown_requested,
)

_LOCALHOST_HOSTS = {"127.0.0.1", "localhost", "::1", "[::1]", "0.0.0.0"}


def _is_localhost(url: str) -> bool:
    return (urlparse(url).hostname or "").lower() in _LOCALHOST_HOSTS


def _single_post(url: str, payload: dict, proxies=None) -> dict:
    """Single-attempt POST without tenacity retry. Used for broadcast
    submissions where the outer loop handles retries with NEWNYM rotation.

    A localhost RPC (wallet-rpc / daemon on 127.0.0.1) is contacted DIRECTLY:
    Tor's SOCKS port refuses to route to loopback, so proxying a localhost POST
    would fail on every attempt. Only a NON-localhost target needs the Tor proxy
    -- and a non-localhost POST with no proxies is a clearnet leak, so it aborts.
    This mirrors gs_common.MoneroRPC, which likewise skips the proxy for
    localhost hosts.
    """
    if _is_localhost(url):
        proxies = None  # never route loopback through Tor
    elif proxies is None:
        sys.exit("[!] _single_post to non-localhost without proxies — clearnet leak. Aborting.")
    r = requests.post(url, json=payload, timeout=30, proxies=proxies)
    r.raise_for_status()
    return r.json()

TOR_RECHECK_INTERVAL = 300  # re-verify Tor every 5 min during broadcast


def _blob_sort_key(p: Path) -> int:
    """Extract the TX's real manifest index from tx_N.signed's filename.

    Used both to sort a directory of blobs numerically AND to look up each
    TX's planned per-TX delay -- the delay must be keyed on this real index,
    not on a blob's position in the (possibly gapped) broadcast list.
    """
    stem = p.stem  # e.g. "tx_15"
    parts = stem.split("_")
    try:
        return int(parts[-1])
    except (ValueError, IndexError):
        return 999999


def main():
    install_signal_handlers()

    cli = argparse.ArgumentParser(
        "broadcast_signed_xmr v10.0",
        description="Broadcast pre-signed Monero TX blobs with Tor + retry",
    )
    cli.add_argument("path",
                     help="dir with *.signed files, a single .signed file, or "
                          "signed_manifest_v1.json")
    cli.add_argument("--tor-proxy",
                     help="SOCKS5 proxy for all network access")
    cli.add_argument("--rpc", default="http://127.0.0.1:18083",
                     help="monero-wallet-rpc endpoint (NOT the daemon). Relay "
                          "uses submit_transfer, a wallet-rpc json_rpc method, "
                          "which imports+broadcasts each signed tx set.")
    cli.add_argument("--rpc-alt", help="fallback RPC")
    cli.add_argument("--rpc-list",
                     help="file with RPC endpoints, one per line")
    cli.add_argument("--rebroadcast", type=int, default=5,
                     help="max rebroadcast attempts per TX")
    cli.add_argument("--timeout-min", type=int, default=30,
                     help="per-TX broadcast timeout in minutes")
    cli.add_argument("--resume", help="progress file for crash-resume")
    args = cli.parse_args()

    if not args.tor_proxy:
        sys.exit(
            "[!] --tor-proxy is REQUIRED. Broadcasting over clearnet leaks your IP\n"
            "    to every Monero node you submit transactions to. Aborting."
        )
    proxy = validate_proxy(args.tor_proxy)
    verify_tor(proxy)

    # OPSEC boundary warning. Relay goes through wallet-rpc submit_transfer,
    # which imports the signed set and broadcasts it over the WALLET-RPC's OWN
    # daemon connection -- NOT over this script's Tor proxy. Our verify_tor /
    # newnym / tor_recheck only cover the (localhost, direct) submit call and
    # the delay pacing; they do NOT anonymize where the tx actually leaves the
    # machine. The operator MUST run monero-wallet-rpc/monerod behind Tor
    # (e.g. monerod --tx-proxy tor,127.0.0.1:9050 and wallet-rpc --proxy) or the
    # broadcast egress is clearnet regardless of what this script reports.
    print("  [!] OPSEC: relay egress is controlled by the wallet-rpc/monerod")
    print("  [!] Tor config (--tx-proxy/--proxy), NOT by this script. Verify it.")
    integrity_log("broadcast", "egress_via_walletrpc_daemon_conn")

    # Build RPC pool. NOTE: a signed tx-set can only be submitted by the
    # wallet-rpc that CREATED it (it holds the matching key images), so
    # --rpc-alt / --rpc-list of *other* wallet-rpcs will reject the set. They
    # are only useful as replicas of the same wallet; otherwise leave them out.
    rpc_pool: List[str] = [args.rpc]
    if args.rpc_alt:
        rpc_pool.append(args.rpc_alt)
    if args.rpc_list and Path(args.rpc_list).exists():
        rpc_pool += [
            line.strip()
            for line in Path(args.rpc_list).read_text().splitlines()
            if line.strip()
        ]
    if len(rpc_pool) > 1:
        print(f"  [!] {len(rpc_pool)} RPC endpoints given; submit_transfer only works "
              f"against the wallet-rpc that created the set. Others will reject it.")
    integrity_log("broadcast", f"rpc_pool:{len(rpc_pool)}_nodes")

    # Gather blobs FIRST (input_path must be defined before delay loading uses it)
    blobs: List[Path] = []
    tx_delays: dict = {}
    delay_source = "none"
    input_path = Path(args.path)
    if args.path.endswith(".json"):
        manifest_dir = input_path.parent
        with open(input_path) as f:
            entries = json.load(f)
        if isinstance(entries, dict) and "manifest" in entries:
            entries = entries["manifest"]
        tampered = []
        for e in entries:
            raw_path = Path(e["file"]) if isinstance(e, dict) else Path(e)
            if raw_path.exists():
                resolved = raw_path
            else:
                # Try resolving by filename in the manifest's directory
                local = manifest_dir / raw_path.name
                resolved = local if local.exists() else None
            if resolved is None:
                print(f"  [!] Blob not found: {raw_path} (also tried {manifest_dir / raw_path.name})")
                integrity_log("broadcast", f"missing_manifest_blob:{raw_path.name}")
                continue
            if isinstance(e, dict) and "hash" in e:
                # The path form (a single .signed file or a bare directory
                # glob) has no manifest to check against, but this .json
                # form IS the manifest -- always verify the hash it carries,
                # the same as directory mode does below.
                actual = hashlib.sha256(resolved.read_bytes()).hexdigest()
                if actual != e["hash"]:
                    tampered.append(resolved.name)
                    continue
            if isinstance(e, dict) and "delay" in e and "idx" in e:
                tx_delays[int(e["idx"])] = int(e["delay"])
            blobs.append(resolved)
        if tampered:
            integrity_log("broadcast", f"TAMPER_DETECTED:{len(tampered)}_blobs")
            for t in tampered:
                print(f"  [!] TAMPERED: {t}")
            sys.exit(f"[!] {len(tampered)} blob(s) failed hash verification! Aborting.")
        if tx_delays:
            delay_source = "manifest_direct"
    elif input_path.is_dir():
        # Look for both .signed (new format) and .blob (legacy) files
        raw_blobs = list(input_path.glob("*.signed")) or list(input_path.glob("*.blob"))
        blobs = sorted(raw_blobs, key=_blob_sort_key)
    elif input_path.exists():
        blobs = [input_path]

    if not blobs:
        sys.exit("[!] No blobs found to broadcast")
    integrity_log("broadcast", f"blobs_found:{len(blobs)}")

    # Load per-TX delays. Primary source: signed manifest. Fallback: unsigned plan in ./unsigned/.
    # (In .json mode, delays were already loaded above from 'entries' directly.)

    # Try manifest first (embedded by signer)
    _manifest_for_delays = input_path / "signed_manifest_v1.json" if input_path.is_dir() else None
    if not tx_delays and _manifest_for_delays and _manifest_for_delays.exists():
        try:
            with open(_manifest_for_delays) as mf:
                _mdata = json.load(mf)
            for entry in _mdata:
                if "delay" in entry and "idx" in entry:
                    tx_delays[int(entry["idx"])] = int(entry["delay"])
            if tx_delays:
                delay_source = "manifest"
        except Exception:
            pass

    # Fallback: unsigned plan (only works if same machine/directory)
    if not tx_delays:
        plan_files = sorted(Path(".").glob("unsigned/unsigned_*.json"), reverse=True)
        if plan_files:
            try:
                with open(plan_files[0]) as pf:
                    plan_data = json.load(pf)
                if isinstance(plan_data, dict) and "txs" in plan_data:
                    for i, tx in enumerate(plan_data["txs"]):
                        if "delay" in tx:
                            tx_delays[i] = int(tx["delay"])
                    if tx_delays:
                        delay_source = "unsigned_plan"
            except Exception:
                pass

    if tx_delays:
        integrity_log("broadcast", f"delays_loaded:{delay_source}")
        print(f"  [+] TX delays loaded from {delay_source} ({len(tx_delays)} entries)")
    else:
        integrity_log("broadcast", "WARNING:no_delays_found")
        print("  [!] WARNING: No TX delays found - all TXs will broadcast with minimal gap!")
        print("  [!] This creates a timing cluster visible to chain analysts.")

    # Verify blob integrity against signer manifest if available
    manifest_path = input_path / "signed_manifest_v1.json" if input_path.is_dir() else None
    if manifest_path and manifest_path.exists():
        with open(manifest_path) as mf:
            manifest = json.load(mf)
        manifest_hashes = {Path(e["file"]).name: e["hash"] for e in manifest}
        tampered = []
        for blob in blobs:
            if blob.name in manifest_hashes and blob.exists():
                with open(blob, "rb") as bf:
                    actual = hashlib.sha256(bf.read()).hexdigest()
                if actual != manifest_hashes[blob.name]:
                    tampered.append(blob.name)
        if tampered:
            integrity_log("broadcast", f"TAMPER_DETECTED:{len(tampered)}_blobs")
            for t in tampered:
                print(f"  [!] TAMPERED: {t}")
            sys.exit(f"[!] {len(tampered)} blob(s) failed hash verification! Aborting.")
        integrity_log("broadcast", f"manifest_verified:{len(manifest_hashes)}_blobs_ok")
        print(f"  [+] Manifest verification: {len(manifest_hashes)} blobs OK")

        # CRITICAL: Only broadcast blobs that are IN the manifest.
        # Stale blobs from prior runs (with different destinations/amounts)
        # would be silently broadcast to wrong addresses without this filter.
        pre_filter = len(blobs)
        blobs = [b for b in blobs if b.name in manifest_hashes]
        rejected = pre_filter - len(blobs)
        if rejected > 0:
            integrity_log("broadcast", f"rejected_unmanifested_blobs:{rejected}")
            print(f"  [!] Rejected {rejected} blob(s) not in manifest (stale from prior run?)")
        if not blobs:
            sys.exit("[!] No blobs remaining after manifest filter")

    # Compute blob fingerprint to bind progress to this specific set of blobs
    blob_fp = hashlib.sha256(
        "|".join(b.name for b in blobs).encode()
    ).hexdigest()[:32]

    # Progress state, split by outcome so resume and success-reporting are both
    # correct:
    #   'relayed'     -- successfully broadcast; skipped on resume.
    #   'failed_perm' -- permanently rejected (double-spend / low-fee); skipped
    #                    on resume because retrying can't help, but deliberately
    #                    NOT counted as relayed, so the batch reads incomplete.
    # A transient failure (node down, timeout) and a missing/empty blob (drive
    # not mounted yet, momentary zero-length) go into NEITHER set -- only the
    # log -- so a --resume re-run actually retries them. Success is defined as
    # "every blob relayed" and checked at exit, so a resume that only re-skips
    # permanent failures can never be mistaken for success.
    progF = Path(args.resume) if args.resume else Path("broadcast_progress.json")
    if progF.exists():
        with open(progF) as f:
            prog = json.load(f)
        saved_fp = prog.get("blob_fingerprint", "")
        if saved_fp and saved_fp != blob_fp:
            integrity_log("broadcast", "STALE_PROGRESS:blob_set_changed")
            sys.exit(
                "[!] Broadcast progress is from a DIFFERENT set of blobs!\n"
                "    Delete the progress file or use the matching blob set.\n"
                "    Stale progress would silently skip TXs."
            )
        relayed = set(prog.get("relayed", []))
        failed_perm = set(prog.get("failed_perm", []))
        prog.setdefault("log", [])
        prog["blob_fingerprint"] = blob_fp
    else:
        prog = {"relayed": [], "failed_perm": [], "log": [], "blob_fingerprint": blob_fp}
        relayed = set()
        failed_perm = set()

    def _persist():
        prog["relayed"] = sorted(relayed)
        prog["failed_perm"] = sorted(failed_perm)
        atomic_write_json(prog, progF)

    import secrets as _secrets
    last_tor_check = time.time()
    success_count = 0
    fail_count = 0
    skip_count = 0

    for idx, blob in enumerate(blobs):
        if shutdown_requested():
            integrity_log("broadcast", f"shutdown_at_blob_{idx}")
            print(f"  [!] Shutdown at TX {idx}. Resume with --resume {progF}")
            break

        if idx in relayed or idx in failed_perm:
            skip_count += 1
            continue

        # Periodic Tor re-check
        if proxy and (time.time() - last_tor_check) > TOR_RECHECK_INTERVAL:
            tor_recheck(proxy, f"broadcast_tx_{idx}")
            last_tor_check = time.time()

        if not blob.exists():
            # Treat as TRANSIENT (drive not mounted, staging not synced yet):
            # record but do not mark permanent, so --resume retries it.
            integrity_log("broadcast", f"missing_blob:{blob.name}")
            print(f"  [!] Missing: {blob.name} - will retry on --resume {progF}")
            prog["log"].append({"idx": idx, "file": str(blob), "sent": False,
                                "error": "file_missing"})
            _persist()
            fail_count += 1
            continue

        raw_data = blob.read_bytes()
        if not raw_data:
            integrity_log("broadcast", f"empty_blob:{blob.name}")
            print(f"  [!] Empty blob {blob.name} - will retry on --resume {progF}")
            prog["log"].append({"idx": idx, "file": str(blob), "sent": False,
                                "error": "empty_blob"})
            _persist()
            fail_count += 1
            continue

        # The signed blob is a wallet SIGNED-TX-SET (what `sign_transfer`
        # emits), NOT a raw consensus transaction. It must be RELAYED via
        # monero-wallet-rpc's submit_transfer, which imports the signed set and
        # broadcasts it through the wallet's own daemon connection. The old code
        # hex-posted it to monerod's /sendrawtransaction, which cannot
        # deserialize a tx-set as a transaction and rejected every TX. So `--rpc`
        # is the WALLET-rpc endpoint here, and the payload is the tx-set hex.
        tx_data_hex = raw_data.hex()

        # NEWNYM + planned delay before EVERY TX (including the first) for
        # circuit isolation and timing decorrelation. The delay is keyed on the
        # blob's REAL manifest index (from its tx_N filename), NOT the loop's
        # positional idx, so an upstream gap can't shift a delay onto the wrong
        # TX. (The old code skipped the delay+newnym entirely for the first TX.)
        real_idx = _blob_sort_key(blob)
        planned_delay = tx_delays.get(real_idx, 0)
        if planned_delay > 0:
            print(f"  [*] Waiting {planned_delay}s (planned delay for TX {real_idx})...")
            integrity_log("broadcast", f"delay:idx={real_idx}:secs={planned_delay}")
            # Sleep in chunks so shutdown_requested() can be checked
            waited = 0
            while waited < planned_delay:
                if shutdown_requested():
                    break
                chunk = min(30, planned_delay - waited)
                time.sleep(chunk)
                waited += chunk
        newnym(required=True)
        secure_delay(5.0, 15.0)

        attempts = args.rebroadcast
        outcome = "transient"   # relayed | double_spend | low_fee | transient
        txid = ""
        start_time = time.time()

        while attempts > 0 and (time.time() - start_time) < args.timeout_min * 60:
            rpc_url = rpc_pool[_secrets.randbelow(len(rpc_pool))]
            try:
                # submit_transfer is a WALLET-rpc json_rpc method: it imports the
                # signed tx set and relays every tx in it via the wallet's daemon.
                submit_url = rpc_url.rstrip("/") + "/json_rpc"
                res = _single_post(
                    submit_url,
                    {"jsonrpc": "2.0", "id": "0", "method": "submit_transfer",
                     "params": {"tx_data_hex": tx_data_hex}},
                    proxy,
                )
                result = res.get("result") or {}
                err = res.get("error") or {}
                tx_hashes = result.get("tx_hash_list") or []
                if tx_hashes:
                    txid = tx_hashes[0]
                    outcome = "relayed"
                    print(f"  [+] TX {real_idx} -> relayed | {txid[:16]}...")
                    integrity_log("broadcast", f"relayed:idx={real_idx}")
                    break

                ecode = err.get("code") if isinstance(err, dict) else None
                emsg = str(err.get("message", "") or res)[:160]
                emsg_l = emsg.lower()
                print(f"  Node: {emsg[:80]}")
                # Classification uses the wallet-rpc error CODE where it's a
                # stable signal, and falls back to message pattern-matching.
                # ONLY clearly-permanent conditions are marked permanent; every
                # other error defaults to transient (retried on --resume). That
                # default is fail-safe -- a misread permanent error just wastes
                # retries and keeps the exit nonzero, never a false success or a
                # stranded-but-marked-done TX.
                #
                # Code -40 verified against real monero-wallet-rpc 0.18.3.1:
                # submit_transfer returns {"code":-40,"message":"Failed to parse
                # signed tx data."} for a corrupt/wrong-format blob. Retrying
                # can't fix a bad blob -- it needs re-signing -- so mark permanent.
                if ecode == -40 or "failed to parse" in emsg_l:
                    outcome = "bad_data"
                    integrity_log("broadcast", f"bad_signed_tx_data:idx={real_idx}")
                    print(f"  [!] TX {real_idx}: signed blob could not be parsed "
                          f"(corrupt/wrong format) -- needs re-signing. Skipping.")
                    break
                is_double = (("double" in emsg_l and "spend" in emsg_l)
                             or "key image" in emsg_l or "already spent" in emsg_l)
                if is_double:
                    outcome = "double_spend"
                    integrity_log("broadcast", f"DOUBLE_SPEND:idx={real_idx}")
                    print(f"  [!] TX {real_idx} flagged as double-spend! Skipping.")
                    break
                if "fee" in emsg_l and ("low" in emsg_l or "too small" in emsg_l
                                        or "not enough" in emsg_l):
                    outcome = "low_fee"
                    integrity_log("broadcast", f"low_fee_rejected:idx={real_idx}")
                    print("  [!] TX rejected: fee too low. Re-sign with higher --fee-priority.")
                    print("  [!] Monero does NOT support RBF - cannot bump fee on a signed TX.")
                    break
                # anything else: treat as transient and retry on a new circuit
            except Exception as e:
                integrity_log("broadcast", f"error:idx={real_idx}:{str(e)[:40]}")
                print(f"  [!] Error: {str(e)[:80]}")

            attempts -= 1
            if attempts > 0:
                newnym()
                secure_delay(5.0, 15.0)

        if outcome == "relayed":
            success_count += 1
            prog["log"].append({"idx": idx, "file": str(blob), "sent": True, "txid": txid})
            relayed.add(idx); _persist()
        elif outcome in ("double_spend", "low_fee", "bad_data"):
            fail_count += 1
            prog["log"].append({"idx": idx, "file": str(blob), "sent": False, "error": outcome})
            failed_perm.add(idx); _persist()   # permanent: skipped, never relayed
        else:
            # Transient: record but add to NEITHER set, so --resume retries it.
            fail_count += 1
            print(f"  [!] TX {real_idx} FAILED (transient) after {args.rebroadcast} attempts "
                  f"- will retry on --resume {progF}")
            prog["log"].append({"idx": idx, "file": str(blob), "sent": False, "error": "transient"})
            _persist()

    integrity_log("broadcast", "done")
    print(f"\n  [+] Broadcast complete: {success_count} relayed this run, "
          f"{fail_count} failed, {skip_count} skipped "
          f"({len(relayed)}/{len(blobs)} relayed total, {len(failed_perm)} permanently failed).")
    print(f"  [+] Progress: {progF}")

    # Success is defined as EVERY blob relayed (across this run + prior resumes).
    # Checking len(relayed) rather than this run's fail_count means a --resume
    # that only re-skips permanent failures cannot be mistaken for success by a
    # check=True caller, and permanent failures (double-spend/low-fee) keep the
    # exit nonzero until the operator re-signs and clears them.
    if len(relayed) < len(blobs):
        unrelayed = len(blobs) - len(relayed)
        integrity_log("broadcast", f"exit_fail:{unrelayed}_unrelayed:{len(failed_perm)}_permfail")
        sys.exit(f"[!] Broadcast incomplete: {unrelayed}/{len(blobs)} TX(s) not relayed "
                 f"({len(failed_perm)} permanent, rest transient — retry with --resume {progF}).")


if __name__ == "__main__":
    main()
