# The vault agent: one job per boot, then off.
#
# OnFailure is not optional. If the agent crashes, is OOM-killed, or exits
# non-zero for any reason systemd would otherwise just record a failed unit and
# LEAVE THE MACHINE ON -- disk auto-unlocked, on the LAN, until someone walks
# over. That is strictly worse than the row OPSEC_SETUP.md §6 scores for
# "they take the ThinkPad", which assumes the box is normally off.
[Unit]
Description=GhostSpiral wake agent (collect one job, run it, power off)
After=network-online.target systemd-random-seed.service
Wants=network-online.target
OnFailure=gs-wake-poweroff.service

[Service]
Type=oneshot
# NO CORE DUMPS, FROM execve ONWARD.
#
# The tools suppress this themselves at module import (gs_common's first
# executable statement; gs_console and gs_doorbell carry their own, because
# neither may import gs_common). That covers every third-party and crypto
# import -- nacl/libsodium, requests, tenacity -- but it CANNOT cover the
# window before the interpreter runs any of our code: exec, dynamic linking,
# site.py, and the entry script's own `import hashlib, decimal`. No Python
# statement is early enough for that; the launcher is.
#
# It matters here because the secret arrives in the ENVIRONMENT
# (GS_WALLET_PASSWORD for the tools it runs), so it is in the process image from execve --
# a dump taken at ANY point after that contains it. Driven: with
# `ulimit -c unlimited` and the variable set, a SIGABRT wrote a 5 MB core and
# the secret was in it.
LimitCORE=0
# The agent creates its artifact directory with an explicit 0700 and writes
# every file inside at 0600, so this changes nothing for the paths this repo
# controls. It is here for the ones it does not: anything a woken job's CHILD
# process creates without naming a mode inherits the umask, and systemd's
# default is 0022 -- world-readable. Cheap, and it fails safe rather than
# relying on every future call site remembering.
UMask=0077
# THE ARTIFACT DIRECTORY, THE WIPE ROOTS AND THIS UNIT MUST AGREE, and for a
# whole draft they did not. paranoia_mode sweeps four fixed roots -- cwd,
# $HOME, $HOME/ghostspiral, $HOME/GhostSpiral -- at depth 0 and 1, and
# gs_common.wipe_covers answers against those. systemd starts a unit with
# cwd=/ and HOME=/root, so measured on this box:
#
#   cwd=/                        wipe_covers(/var/lib/ghostspiral) = False
#   WorkingDirectory=<the dir>   wipe_covers(/var/lib/ghostspiral) = True
#   Environment=HOME=<the dir>   wipe_covers(/var/lib/ghostspiral) = True
#
# Without these two lines the agent refuses EVERY boot with
# "outside_wipe_roots" -- correctly, because nothing would ever erase the
# bundles and slips a woken job writes. Both are set: WorkingDirectory covers
# the agent's own wipe_covers check, HOME covers anything run WITH this unit's
# environment.
#
# NEITHER COVERS A paranoia_mode RUN YOU START LATER, and an earlier version of
# this comment said HOME did. Your shell has your HOME, not this one. Wipe from
# the artifact directory itself:
#     cd /var/lib/ghostspiral && python3 /opt/ghostspiral/paranoia_mode
#
# The earlier default of --artifact-dir "." was worse than useless here: it
# resolved against cwd=/ to the ROOT filesystem, which wipe_covers reports as
# covered and ProtectSystem=strict mounts read-only, so the vault would have
# claimed wipe coverage and then failed to write its ledger.
WorkingDirectory=/var/lib/ghostspiral
Environment=HOME=/var/lib/ghostspiral
# THE OUTER BOUND, AND IT WAS KILLING EVERY WITHDRAWAL AT 2.5 HOURS.
#
# This is Type=oneshot, so TimeoutStartSec applies to the WHOLE ExecStart --
# the entire job, not just process launch. It was 9000s, and the comment here
# said why: "long enough for the largest job (watch, 7200s) plus jitter and
# Tor, and SHORTER than the deadman".
#
# `watch` stopped being the largest job when `withdraw` arrived. A withdrawal
# runs up to result_budget_s = 59400s, and the agent extends the deadman to
# 60000s to cover it. systemd was killing the unit at 9000s -- 6.7x earlier
# than the backstop it was supposed to precede -- and OnFailure above then
# powers the machine off. Mid-mix, with the money already moving. Every
# withdrawal, at every depth: the shallowest needs 6.1h.
#
# That defeated the job budget, the deadman extension and everything else
# sized for a spend, because all of those bound run_child and the poweroff
# timer, and none of them can survive systemd killing the whole unit.
#
# THE RELATIONSHIP IS NOW THE OTHER WAY ROUND, deliberately. This number is
# static and the deadman is job-aware, so this has to fit the LONGEST job the
# agent can legitimately run and let the deadman be the tight bound:
#
#   non-spending job   deadman 9300s fires first; this never comes near
#   withdrawal         deadman extended to 60000s fires first
#   wedged agent       whichever deadman is armed fires first
#
# So systemd is the outer backstop for a deadman that failed to arm at all,
# which is the only case left. 61200 = 60000 + 20 min of margin.
#
# tests/test_wake_agent.py derives the floor from result_budget_s, so a job
# whose budget grows past it goes red instead of arriving as a vault killed
# part way through spending.
TimeoutStartSec=61200
# NOTHING TO THE JOURNAL. This is not tidiness. Without these two lines systemd
# journals everything this unit and its children print, and the children are
# create_receive_wallet and thor_swap_preparer -- which print the BTC deposit
# address and the THORCHAIN MEMO. The memo names the destination XMR address
# in plain text. So the one string this whole toolchain exists to keep off
# durable storage was being written into /var/log/journal: persistent,
# root-owned, rotated rather than erased, and outside every path paranoia_mode
# sweeps. The slip on disk is 0600 and gets wiped; the journal copy was not
# thought of as a copy.
#
# The children now write to <artifact-dir>/gs_wake_job.log at 0600, which IS
# inside the sweep. Run the agent by hand with --dry-run and you still see
# everything on your terminal, because systemd is not involved in that.
#
# WHAT THIS DOES NOT HIDE, said rather than implied: systemd still records that
# gs-wake-agent.service started and stopped, and when. That dates a wake. It
# does not name the job, the amount or any address.
StandardOutput=null
StandardError=null

# DEPENDENCIES MUST BE SYSTEM-WIDE OR IN A VENV. NEVER `pip install --user`.
#
# ProtectHome=yes below makes /home, /root and /run/user inaccessible to this
# unit. Python derives its per-user site directory from $HOME, so a
# `pip install --user` dependency set is INVISIBLE here -- and on Debian 12 /
# Raspberry Pi OS a plain `pip install` is refused (PEP 668,
# "externally-managed-environment"), which pushes people to exactly the
# --user install that cannot work. Measured on a live box, a mixed install is
# the normal outcome:
#
#   requests -> /root/.local/lib/python3.11/site-packages   (INVISIBLE here)
#   monero   -> /usr/local/lib/python3.11/dist-packages     (fine)
#
# Install one of these ways instead:
#   sudo apt install python3-requests python3-nacl python3-psutil ...
#   sudo pip install --break-system-packages -r requirements.txt
#   python3 -m venv /opt/ghostspiral/venv && /opt/ghostspiral/venv/bin/pip \
#       install -r requirements.txt      # then point ExecStart at that python
#
# EXACTLY THE HARD SET, so this cannot refuse a boot the agent would have
# handled. Checked against the code rather than against requirements.txt:
#   requests, tenacity  gs_common imports both at MODULE scope (line 28-29)
#   nacl                gs_wake_proto boxes every record; no unauthenticated mode
#   socks               socks5h:// Tor proxying, and the agent verifies Tor
#   psutil              absent -> resource_check raises and the agent refuses
#                       "no_sentinel" (gs_wake_agent:374)
#   monero              create_receive_wallet, which every job runs
#   stem                newnym(required=True) SYS.EXITS without it, and
#                       create_receive_wallet calls exactly that at line 258
#
# stem WAS LISTED AS SOFT HERE, under "guarded or unused on the wake path",
# and it is neither. gs_common.newnym imports stem inside its retry loop, so a
# missing package is caught as just another rotation failure -- and with
# required=True the handler is sys.exit. Driven with stem made unimportable:
#
#     [!] Tor circuit rotation FAILED after 1 attempts: No module named 'stem'
#
# create_receive_wallet runs for BOTH receive_new and receive_and_quote, i.e.
# every /deposit and every /receive. So on a box without stem this pre-check
# passed, the agent started, and every deposit died pointing the operator at
# Tor -- which was working fine.
#
# gnupg IS still soft and stays off this list: thor_swap_preparer imports it
# lazily inside the --gpg-recipient branch, with its own message, and the wake
# path never passes that flag. yaml is gone from requirements.txt entirely --
# nothing in the repository imports it.
#
# WHY THIS IS WORTH A PRE-CHECK RATHER THAN A COMMENT. Without it the failure
# is invisible AND destructive: gs_common imports requests at module scope, so
# a missing dependency raises ModuleNotFoundError before any of this
# toolchain's own code runs; StandardError=null above discards the traceback;
# and OnFailure=gs-wake-poweroff.service then powers the machine down. The
# operator pokes the doorbell, the vault boots, powers off, and NOTHING
# anywhere says why. This writes the reason into the same 0600 job log the
# agent already uses, which paranoia_mode wipes with the rest of the run.
ExecStartPre=/bin/sh -c '/usr/bin/python3 -c "import requests, tenacity, nacl, socks, psutil, monero, stem" 2>>/var/lib/ghostspiral/gs_wake_job.log || { echo "gs-wake-agent: a Python dependency is missing or not visible under ProtectHome=yes -- see requirements.txt and the install note in this unit" >>/var/lib/ghostspiral/gs_wake_job.log; exit 1; }'
# THE SPEND PASSWORD, ONLY IF YOU PAIRED WITH --allow-withdraw.
#
# Leave this commented out and nothing changes: the withdraw job does not
# exist for a keyfile that does not allow it, and every other job runs exactly
# as before. Uncomment it and you have decided that this machine can spend
# while nobody is sitting at it. OPSEC_SETUP.md section 4b is what that costs.
#
# ROOT-OWNED 0400, holding one line:
#     GS_WALLET_PASSWORD=...
#
# /proc/<pid>/cmdline is 0444 and /proc/<pid>/environ is 0400, which is why
# there is no flag for this and never will be.
#
# WHAT STOPS IT REACHING EVERYTHING ELSE: run_child strips every GS_ variable
# out of the environment it inherits and puts back only what the dispatcher
# hands that step. So this reaches the mix and reaches nothing else -- not
# thor_swap_preparer, not create_receive_wallet. Without that scrub, putting a
# password here would hand it to every child of every job.
#EnvironmentFile=/etc/gs-wake-spend.env
ExecStart=/usr/bin/python3 /opt/ghostspiral/gs_wake_agent --key /etc/gs_wake_thinkpad.key

# §4: "the auto-job user must NOT be allowed to mount removable disks." These
# make that a kernel property a test can read off this file, rather than a
# policy claim the agent would have to assert without being able to verify it.
PrivateDevices=yes
DeviceAllow=
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ghostspiral
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
