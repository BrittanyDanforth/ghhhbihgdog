# The vault agent: one job per boot, then off.
#
# OnFailure is not optional. If the agent crashes, is OOM-killed, or exits
# non-zero for any reason systemd would otherwise just record a failed unit and
# LEAVE THE MACHINE ON -- disk auto-unlocked, on the LAN, until someone walks
# over. That is strictly worse than the row OPSEC_SETUP.md §6 scores for
# "they take the ThinkPad", which assumes the box is normally off.
[Unit]
Description=GhostSpiral wake agent (collect one job, run it, power off)
After=network-online.target systemd-random-seed.service
Wants=network-online.target
OnFailure=gs-wake-poweroff.service

[Service]
Type=oneshot
# THE ARTIFACT DIRECTORY, THE WIPE ROOTS AND THIS UNIT MUST AGREE, and for a
# whole draft they did not. paranoia_mode sweeps four fixed roots -- cwd,
# $HOME, $HOME/ghostspiral, $HOME/GhostSpiral -- at depth 0 and 1, and
# gs_common.wipe_covers answers against those. systemd starts a unit with
# cwd=/ and HOME=/root, so measured on this box:
#
#   cwd=/                        wipe_covers(/var/lib/ghostspiral) = False
#   WorkingDirectory=<the dir>   wipe_covers(/var/lib/ghostspiral) = True
#   Environment=HOME=<the dir>   wipe_covers(/var/lib/ghostspiral) = True
#
# Without these two lines the agent refuses EVERY boot with
# "outside_wipe_roots" -- correctly, because nothing would ever erase the
# bundles and slips a woken job writes. Both are set: WorkingDirectory covers
# the agent's own wipe_covers check, HOME covers anything run WITH this unit's
# environment.
#
# NEITHER COVERS A paranoia_mode RUN YOU START LATER, and an earlier version of
# this comment said HOME did. Your shell has your HOME, not this one. Wipe from
# the artifact directory itself:
#     cd /var/lib/ghostspiral && python3 /opt/ghostspiral/paranoia_mode
#
# The earlier default of --artifact-dir "." was worse than useless here: it
# resolved against cwd=/ to the ROOT filesystem, which wipe_covers reports as
# covered and ProtectSystem=strict mounts read-only, so the vault would have
# claimed wipe coverage and then failed to write its ledger.
WorkingDirectory=/var/lib/ghostspiral
Environment=HOME=/var/lib/ghostspiral
# Long enough for the largest job (watch, 7200s) plus jitter and Tor, and
# SHORTER than the deadman, so the ordinary path is bounded by this and the
# deadman is only the backstop for a wedged or SIGKILLed agent.
TimeoutStartSec=9000
# NOTHING TO THE JOURNAL. This is not tidiness. Without these two lines systemd
# journals everything this unit and its children print, and the children are
# create_receive_wallet and thor_swap_preparer -- which print the BTC deposit
# address and the THORCHAIN MEMO. The memo names the destination XMR address
# in plain text. So the one string this whole toolchain exists to keep off
# durable storage was being written into /var/log/journal: persistent,
# root-owned, rotated rather than erased, and outside every path paranoia_mode
# sweeps. The slip on disk is 0600 and gets wiped; the journal copy was not
# thought of as a copy.
#
# The children now write to <artifact-dir>/gs_wake_job.log at 0600, which IS
# inside the sweep. Run the agent by hand with --dry-run and you still see
# everything on your terminal, because systemd is not involved in that.
#
# WHAT THIS DOES NOT HIDE, said rather than implied: systemd still records that
# gs-wake-agent.service started and stopped, and when. That dates a wake. It
# does not name the job, the amount or any address.
StandardOutput=null
StandardError=null

# DEPENDENCIES MUST BE SYSTEM-WIDE OR IN A VENV. NEVER `pip install --user`.
#
# ProtectHome=yes below makes /home, /root and /run/user inaccessible to this
# unit. Python derives its per-user site directory from $HOME, so a
# `pip install --user` dependency set is INVISIBLE here -- and on Debian 12 /
# Raspberry Pi OS a plain `pip install` is refused (PEP 668,
# "externally-managed-environment"), which pushes people to exactly the
# --user install that cannot work. Measured on a live box, a mixed install is
# the normal outcome:
#
#   requests -> /root/.local/lib/python3.11/site-packages   (INVISIBLE here)
#   monero   -> /usr/local/lib/python3.11/dist-packages     (fine)
#
# Install one of these ways instead:
#   sudo apt install python3-requests python3-nacl python3-psutil ...
#   sudo pip install --break-system-packages -r requirements.txt
#   python3 -m venv /opt/ghostspiral/venv && /opt/ghostspiral/venv/bin/pip \
#       install -r requirements.txt      # then point ExecStart at that python
#
# EXACTLY THE HARD SET, so this cannot refuse a boot the agent would have
# handled. Checked against the code rather than against requirements.txt:
#   requests, tenacity  gs_common imports both at MODULE scope (line 28-29)
#   nacl                gs_wake_proto boxes every record; no unauthenticated mode
#   socks               socks5h:// Tor proxying, and the agent verifies Tor
#   psutil              absent -> resource_check raises and the agent refuses
#                       "no_sentinel" (gs_wake_agent:374)
#   monero              create_receive_wallet, which every job runs
# stem, gnupg and yaml are deliberately NOT here: they are guarded or unused on
# the wake path, and a pre-check stricter than the code would itself be the
# thing that stops the vault working.
#
# WHY THIS IS WORTH A PRE-CHECK RATHER THAN A COMMENT. Without it the failure
# is invisible AND destructive: gs_common imports requests at module scope, so
# a missing dependency raises ModuleNotFoundError before any of this
# toolchain's own code runs; StandardError=null above discards the traceback;
# and OnFailure=gs-wake-poweroff.service then powers the machine down. The
# operator pokes the doorbell, the vault boots, powers off, and NOTHING
# anywhere says why. This writes the reason into the same 0600 job log the
# agent already uses, which paranoia_mode wipes with the rest of the run.
ExecStartPre=/bin/sh -c '/usr/bin/python3 -c "import requests, tenacity, nacl, socks, psutil, monero" 2>>/var/lib/ghostspiral/gs_wake_job.log || { echo "gs-wake-agent: a Python dependency is missing or not visible under ProtectHome=yes -- see requirements.txt and the install note in this unit" >>/var/lib/ghostspiral/gs_wake_job.log; exit 1; }'
ExecStart=/usr/bin/python3 /opt/ghostspiral/gs_wake_agent --key /etc/gs_wake_thinkpad.key

# §4: "the auto-job user must NOT be allowed to mount removable disks." These
# make that a kernel property a test can read off this file, rather than a
# policy claim the agent would have to assert without being able to verify it.
PrivateDevices=yes
DeviceAllow=
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ghostspiral
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
