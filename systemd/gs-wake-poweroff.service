# The vault's power-off, as a ROOT-OWNED unit that does not depend on the agent
# being alive. This is path 2 and 3 of the three independent power-off paths;
# gs_wake_agent's own `finally` is path 1.
#
# SIGTERM THE JOB'S GROUP FIRST. Every tool in this toolchain installs a
# SIGTERM handler and its `finally` blocks are what erase the plan files and
# the wallet-password scratch file. gs_console's job watchdog records what a
# straight kill cost: "a timed-out run left all of it on disk."
[Unit]
Description=GhostSpiral wake: stop the job cleanly, then power off
DefaultDependencies=no
Before=shutdown.target

[Service]
Type=oneshot
# NO CORE DUMPS, FROM execve ONWARD.
#
# The tools suppress this themselves at module import (gs_common's first
# executable statement; gs_console and gs_doorbell carry their own, because
# neither may import gs_common). That covers every third-party and crypto
# import -- nacl/libsodium, requests, tenacity -- but it CANNOT cover the
# window before the interpreter runs any of our code: exec, dynamic linking,
# site.py, and the entry script's own `import hashlib, decimal`. No Python
# statement is early enough for that; the launcher is.
#
# It matters here because the secret arrives in the ENVIRONMENT
# (nothing itself, but it shares the agent's cgroup), so it is in the process image from execve --
# a dump taken at ANY point after that contains it. Driven: with
# `ulimit -c unlimited` and the variable set, a SIGABRT wrote a 5 MB core and
# the secret was in it.
LimitCORE=0
# Give the agent's process group a chance to run its cleanup, then insist.
ExecStart=/bin/sh -c 'systemctl kill --signal=SIGTERM gs-wake-agent.service 2>/dev/null || true; sleep 20; systemctl kill --signal=SIGKILL gs-wake-agent.service 2>/dev/null || true'
ExecStart=/usr/bin/systemctl --no-block poweroff
