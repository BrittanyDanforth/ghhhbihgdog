# EXAMPLE, not an install. Read every line, then write your own.
#
# WHY THIS FILE IS SHORT.
#
# It used to carry ninety lines of design notes: what this is for, what it may
# and may not say, what an attacker gets, and where each limit really lives.
# All true, all useful once -- and all of it sat permanently on the card of the
# box that is supposed to hold nothing, readable by anyone who images it,
# without running a thing.
#
# The reasoning now lives in OPSEC_SETUP.md and in gs_telegram_pager's own
# docstring, on the machine that has the source. Read it THERE before
# installing this.
#
# NAMES ARE YOURS TO CHANGE. Every path and the unit name below are examples.
# Nothing in the tools depends on them: the pager takes --key, --chat-id and
# --state as arguments, and reads its token from the environment. If this box
# must not be identifiable by what is on it, rename the unit, the directory
# and the log, and pass the new paths. Doing that breaks nothing.
#
# FIND YOUR CHAT ID FIRST. --chat-id wants a number an unallowlisted chat
# cannot get out of the bot, because the bot answers unknown chats with
# silence. Run this once, by hand. It arms nothing and wakes nothing:
#
#     python3 /opt/gs/gs_telegram_pager --whoami

[Unit]
# NEUTRAL ON PURPOSE. `systemctl status` and `systemctl list-units` print this
# to anyone who can read the unit, and a Description naming the toolchain
# tells them what the box is for before they have looked at anything else.
Description=Relay
After=wg-quick@wg0.service tor.service
Requires=wg-quick@wg0.service tor.service

[Service]
Type=simple
# No core dump: the token is in the environment, so it is in the process image
# from execve. Driven -- with `ulimit -c unlimited` a SIGABRT wrote a 5 MB core
# with the secret in it. The tools suppress this themselves at import, which
# cannot cover the window before any of our code runs.
LimitCORE=0
# Nothing to the journal. The journal is persistent storage on this card, and
# the process's own stdout names the job and the handle. Run it by hand and you
# still see everything.
StandardOutput=null
StandardError=null
# EVERY FILE THIS WRITES IS OWNER-ONLY. Without it the log below is created
# world-readable: the vault's unit sets a UMask and this one did not, so the
# one box that is meant to hold nothing was the one leaving a readable file.
# The state file asks for 0600 explicitly; the log is created by the shell
# redirect on the next line and gets whatever the umask says.
UMask=0077

# Dependencies must be system-wide or in a venv, NEVER `pip install --user`:
# ProtectHome=yes makes $HOME inaccessible, so a --user install is invisible
# here and the import fails into StandardError=null, i.e. nowhere.
ExecStartPre=/bin/sh -c '/usr/bin/python3 -c "import requests, tenacity, nacl, socks" 2>>/var/lib/gs/pager.log || { echo "missing dependency - see requirements.txt" >>/var/lib/gs/pager.log; exit 1; }'

# THE TOKEN AND THE PASSPHRASE GO IN THE ENVIRONMENT, NEVER ON ARGV.
# /proc/<pid>/cmdline is 0444 and every local account can read it;
# /proc/<pid>/environ is 0400. Point this at a root-owned 0400 file holding
# GS_TG_BOT_TOKEN and GS_WAKE_PASSPHRASE -- and understand the trade, which
# OPSEC_SETUP.md states: an unattended trigger turns a sealed keyfile into an
# effectively plaintext one, because the passphrase now sits on this same
# unencrypted card. A pager you start by hand, typing it, does not.
#EnvironmentFile=/etc/gs-pager.env

# --chat-id is an allowlist, not a secret, so argv is fine for it. The token is
# not, and there is deliberately no --token flag to put it there.
#
# --burn-after N deletes every message in the chat N seconds after it was sent,
# this bot's replies and your commands alike. The default is 900 (fifteen
# minutes); 0 keeps them. The questions and replies of a /deposit or
# /withdraw are deleted the moment that exchange ends whatever N is. Telegram
# only permits a bot to delete for 48h. There is no chat command for it: the
# word would sit in the transcript it was meant to empty. `systemctl kill -s
# USR1` empties it now.
#ExecStart=/usr/bin/python3 /opt/gs/gs_telegram_pager \
#    --key /etc/gs_wake_pi.key \
#    --chat-id 123456789 \
#    --burn-after 3600 \
#    --state /var/lib/gs/pager_state.json

Restart=on-failure
RestartSec=30
# A crash loop must not become a rate-limit bypass: the counters are persisted
# to --state, so a restart reloads them rather than starting from zero.

# systemd's cwd is / and the integrity chain is a relative path. Without this
# the chain lands on a read-only filesystem. OPSEC_SETUP.md §5 says what that
# cost before it was fixed.
WorkingDirectory=/var/lib/gs

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/gs
# Outbound to Telegram over Tor on loopback, and the LAN for the magic packet.
# Nothing else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
