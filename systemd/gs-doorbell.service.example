# EXAMPLE, not an install. Read every line, then write your own.
#
# WHY THIS FILE IS SHORT. It used to explain what the doorbell is, what a
# trigger may and may not report, and which section of the design says so. All
# true, and all of it sat permanently on the SD card of the box that is meant
# to hold nothing -- readable by anyone who images that card, without running
# anything. The reasoning is in OPSEC_SETUP.md and in gs_doorbell's own
# docstring, on the machine that has the source.
#
# NOT A DAEMON. One process per poke: it binds, wakes, hands over one job,
# hears back and exits. There is deliberately no always-listening service.
#
# NAMES ARE YOURS TO CHANGE. Every path and the unit name are examples; nothing
# in the tools depends on them. If this box must not be identifiable by what is
# on it, rename them and pass the new paths.
[Unit]
# Neutral on purpose: systemctl prints this to anyone who can read the unit.
Description=Relay trigger
After=wg-quick@wg0.service tor.service
Requires=wg-quick@wg0.service

[Service]
Type=oneshot
LimitCORE=0
# Nothing to the journal: it is persistent storage on this card, and this
# process's stdout names the job and the handle. Run it by hand and you see
# everything.
StandardOutput=null
StandardError=null
# Every file this writes is owner-only.
UMask=0077
# The passphrase for the sealed keyfile. In the ENVIRONMENT, never on argv:
# /proc/<pid>/cmdline is 0444 and every local account can read it, while
# /proc/<pid>/environ is 0400. Point this at a root-owned 0400 file -- and
# understand the trade, which OPSEC_SETUP.md states: unless the card itself is
# encrypted, an unattended trigger converts the sealed keyfile back into a
# plaintext one. A doorbell poked by a person who types the passphrase does not.
#EnvironmentFile=/etc/gs-wake.env
# THE JOB GOES IN ON STDIN, NEVER ON ARGV -- and the line that used to be here
# said exactly that while doing the opposite:
#
#   ExecStart=/bin/sh -c 'echo "{...}" | python3 gs_doorbell wake --key ...'
#
# That shell's argv held the whole job for as long as the poke lasted, two
# lines under a comment promising it did not. gs_doorbell has no --job flag
# precisely so this cannot happen, and the example smuggled one back in through
# a shell. systemd can open the file itself: no shell, no pipeline, nothing on
# an argv.
#   /etc/gs-wake-job.json   root:root 0600
StandardInput=file:/etc/gs-wake-job.json
ExecStart=/usr/bin/python3 /opt/gs/gs_doorbell wake --key /etc/gs_wake_pi.key
