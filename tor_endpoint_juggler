@dataclass
class EndpointHealth:
    """Real endpoint health tracking"""
    url: str
    last_success: Optional[datetime] = None
    last_failure: Optional[datetime] = None
    success_count: int = 0
    failure_count: int = 0
    avg_response_time: float = 0.0
    consecutive_failures: int = 0
    circuit_id: Optional[str] = None
    is_validated: bool = False
    response_times: deque = field(default_factory=lambda: deque(maxlen=50))
    
    @property
    def reliability_score(self) -> float:
        total = self.success_count + self.failure_count
        if total == 0:
            return 0.0
        base_score = self.success_count / total
        
        # Penalize consecutive failures
        penalty = min(0.1 * self.consecutive_failures, 0.5)
        
        # Bonus for recent success
        if self.last_success and datetime.now() - self.last_success < timedelta(hours=1):
            bonus = 0.1
        else:
            bonus = 0.0
            
        return max(0.0, base_score - penalty + bonus)
    
    @property
    def is_operational(self) -> bool:
        return (self.consecutive_failures < 5 and 
                self.reliability_score > 0.3 and
                self.is_validated)

class CryptographicRandom:
    """Military-grade cryptographic randomness"""
    
    def __init__(self):
        self._entropy_pool = self._generate_entropy_pool()
        self._counter = 0
    
    def _generate_entropy_pool(self) -> bytes:
        """Generate high-entropy seed from multiple sources"""
        entropy_sources = [
            secrets.token_bytes(32),  # OS entropy
            hashlib.sha256(str(time.time()).encode()).digest(),
            hashlib.sha256(str(os.getpid()).encode()).digest(),
            os.urandom(64) if hasattr(os, 'urandom') else b'',
        ]
        
        # Additional entropy from system state
        try:
            import psutil
            entropy_sources.append(
                hashlib.sha256(str(psutil.cpu_percent()).encode()).digest()
            )
        except ImportError:
            pass
        
        combined = b''.join(entropy_sources)
        kdf = PBKDF2HMAC(
            algorithm=hashes.SHA256(),
            length=64,
            salt=b'tor_endpoint_juggler_v2',
            iterations=100000,
        )
        return kdf.derive(combined)
    
    def get_bytes(self, length: int) -> bytes:
        """Get cryptographically secure random bytes"""
        self._counter += 1
        seed = self._entropy_pool + self._counter.to_bytes(8, 'big')
        return hashlib.sha256(seed).digest()[:length]
    
    def shuffle(self, items: List) -> None:
        """Cryptographically secure Fisher-Yates shuffle"""
        for i in range(len(items) - 1, 0, -1):
            random_bytes = self.get_bytes(4)
            j = int.from_bytes(random_bytes, 'big') % (i + 1)
            items[i], items[j] = items[j], items[i]
    
    def choice(self, items: List):
        """Cryptographically secure choice"""
        if not items:
            raise ValueError("Cannot choose from empty list")
        random_bytes = self.get_bytes(4)
        index = int.from_bytes(random_bytes, 'big') % len(items)
        return items[index]

class TorCircuitManager:
    """Real Tor circuit management and control"""
    
    def __init__(self, control_path: str = None, control_port: int = None):
        self.control_path = control_path or TOR_CONTROL_SOCKET
        self.control_port = control_port or TOR_CONTROL_PORT
        self.last_newnym = datetime.min
        self.circuit_cache = {}
        self.isolation_credentials = {}
        
    def _get_controller(self) -> Controller:
        """Get authenticated Tor controller"""
        try:
            # Try socket first
            if Path(self.control_path).exists():
                controller = Controller.from_socket_file(self.control_path)
            else:
                # Fall back to port
                controller = Controller.from_port(port=self.control_port)
            
            controller.authenticate()
            return controller
            
        except Exception as e:
            logger.error(f"Failed to connect to Tor control: {e}")
            raise
    
    def force_new_circuit(self) -> bool:
        """Force new Tor circuit creation"""
        try:
            with self._get_controller() as controller:
                controller.signal(Signal.NEWNYM)
                self.last_newnym = datetime.now()
                logger.info("Forced new Tor circuit")
                return True
        except Exception as e:
            logger.error(f"Failed to create new circuit: {e}")
            return False
    
    def get_circuit_info(self) -> Dict:
        """Get real Tor circuit information"""
        try:
            with self._get_controller() as controller:
                circuits = controller.get_circuits()
                streams = controller.get_streams()
                
                built_circuits = [c for c in circuits if c.status == 'BUILT']
                
                return {
                    'total_circuits': len(circuits),
                    'built_circuits': len(built_circuits),
                    'active_streams': len(streams),
                    'circuit_details': [
                        {
                            'id': c.id,
                            'status': c.status,
                            'path': [relay.fingerprint[:8] for relay in c.path],
                            'purpose': c.purpose
                        } for c in built_circuits[:5]  # Limit for OPSEC
                    ],
                    'timestamp': datetime.now(timezone.utc).isoformat()
                }
        except Exception as e:
            logger.warning(f"Could not get circuit info: {e}")
            return {'error': str(e)}
    
    def create_isolation_session(self, session_id: str) -> Dict[str, str]:
        """Create isolated SOCKS session with unique credentials"""
        crypto_rand = CryptographicRandom()
        
        username = f"session_{session_id}_{crypto_rand.get_bytes(4).hex()}"
        password = crypto_rand.get_bytes(16).hex()
        
        self.isolation_credentials[session_id] = {
            'username': username,
            'password': password,
            'created': datetime.now()
        }
        
        return {
            'http': f'socks5://{username}:{password}@{TOR_SOCKS_HOST}:{TOR_SOCKS_PORT}',
            'https': f'socks5://{username}:{password}@{TOR_SOCKS_HOST}:{TOR_SOCKS_PORT}'
        }

class RealEndpointProber:
    """Production endpoint validation - no simulation"""
    
    def __init__(self, circuit_manager: TorCircuitManager):
        self.circuit_manager = circuit_manager
        self.session_cache = {}
        
    def _create_tor_session(self, session_id: str) -> requests.Session:
        """Create real Tor-routed HTTP session"""
        if session_id in self.session_cache:
            return self.session_cache[session_id]
        
        session = requests.Session()
        proxy_config = self.circuit_manager.create_isolation_session(session_id)
        session.proxies.update(proxy_config)
        
        # Production headers
        session.headers.update({
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; rv:91.0) Gecko/20100101 Firefox/91.0',
            'Accept': 'application/json, text/plain, */*',
            'Accept-Language': 'en-US,en;q=0.9',
            'Accept-Encoding': 'gzip, deflate',
            'DNT': '1',
            'Connection': 'keep-alive',
            'Upgrade-Insecure-Requests': '1'
        })
        
        self.session_cache[session_id] = session
        return session
    
    def validate_onion_endpoint(self, url: str, timeout: int = 20) -> Tuple[bool, float, Dict]:
        """Real .onion endpoint validation"""
        session_id = hashlib.sha256(url.encode()).hexdigest()[:8]
        session = self._create_tor_session(session_id)
        
        start_time = time.time()
        result = {
            'url': url,
            'timestamp': datetime.now(timezone.utc).isoformat(),
            'success': False,
            'response_time': 0.0,
            'error': None,
            'circuit_info': None
        }
        
        try:
            # Real JSON-RPC probe
            payload = {
                "jsonrpc": "2.0",
                "id": int(time.time()),
                "method": "get_height"
            }
            
            response = session.post(
                url,
                json=payload,
                timeout=timeout,
                verify=False,  # .onion doesn't use traditional SSL
                allow_redirects=False
            )
            
            response_time = time.time() - start_time
            result['response_time'] = response_time
            result['status_code'] = response.status_code
            
            if response.status_code == 200:
                try:
                    json_response = response.json()
                    if 'result' in json_response or 'error' in json_response:
                        result['success'] = True
                        result['response_data'] = json_response
                        logger.debug(f"Endpoint {url} validated successfully in {response_time:.2f}s")
                except json.JSONDecodeError:
                    result['error'] = 'Invalid JSON response'
            else:
                result['error'] = f'HTTP {response.status_code}'
                
        except requests.exceptions.Timeout:
            result['error'] = 'Connection timeout'
            result['response_time'] = timeout
        except requests.exceptions.ConnectionError as e:
            result['error'] = f'Connection failed: {str(e)}'
            result['response_time'] = time.time() - start_time
        except Exception as e:
            result['error'] = f'Unexpected error: {str(e)}'
            result['response_time'] = time.time() - start_time
        
        return result['success'], result['response_time'], result

class ProductionEndpointJuggler:
    """Production-grade endpoint management system"""
    
    def __init__(self):
        self.crypto_rand = CryptographicRandom()
        self.circuit_manager = TorCircuitManager()
        self.prober = RealEndpointProber(self.circuit_manager)
        self.endpoint_health: Dict[str, EndpointHealth] = {}
        self.active_endpoints: List[str] = []
        self.executor = ThreadPoolExecutor(max_workers=20)
        
    def load_endpoint_sources(self, yaml_files: List[Path]) -> Set[str]:
        """Load real endpoint configurations"""
        endpoints = set()
        
        for yaml_file in yaml_files:
            if not yaml_file.exists():
                logger.warning(f"Endpoint file not found: {yaml_file}")
                continue
                
            try:
                with open(yaml_file, 'r') as f:
                    data = yaml.safe_load(f)
                    
                if isinstance(data, dict):
                    # Handle various YAML structures
                    if 'endpoints' in data:
                        endpoints.update(data['endpoints'])
                    elif 'onion_endpoints' in data:
                        endpoints.update(data['onion_endpoints'])
                    else:
                        endpoints.update(data.values())
                elif isinstance(data, list):
                    endpoints.update(data)
                    
                logger.info(f"Loaded {len(endpoints)} endpoints from {yaml_file}")
                
            except Exception as e:
                logger.error(f"Failed to load {yaml_file}: {e}")
        
        # Validate .onion format
        valid_endpoints = set()
        for endpoint in endpoints:
            if self._is_valid_onion_url(endpoint):
                valid_endpoints.add(endpoint)
            else:
                logger.warning(f"Invalid .onion URL: {endpoint}")
        
        return valid_endpoints
    
    def _is_valid_onion_url(self, url: str) -> bool:
        """Validate .onion URL format"""
        try:
            parsed = urlparse(url)
            if not parsed.scheme in ['http', 'https']:
                return False
            if not parsed.hostname.endswith('.onion'):
                return False
            if len(parsed.hostname.replace('.onion', '')) not in [16, 56]:  # v2 or v3 onion
                return False
            return True
        except:
            return False
    
    def validate_endpoint_pool(self, endpoints: Set[str], max_workers: int = 10) -> List[str]:
        """Validate endpoints in parallel using real Tor connections"""
        if not endpoints:
            logger.error("No endpoints to validate")
            return []
        
        logger.info(f"Validating {len(endpoints)} endpoints via Tor...")
        
        # Create validation tasks
        futures = []
        with ThreadPoolExecutor(max_workers=max_workers) as executor:
            for endpoint in endpoints:
                future = executor.submit(self._validate_single_endpoint, endpoint)
                futures.append((endpoint, future))
        
        # Collect results
        validated_endpoints = []
        for endpoint, future in futures:
            try:
                is_valid, response_time, details = future.result(timeout=30)
                
                # Update health tracking
                if endpoint not in self.endpoint_health:
                    self.endpoint_health[endpoint] = EndpointHealth(endpoint)
                
                health = self.endpoint_health[endpoint]
                if is_valid:
                    health.success_count += 1
                    health.last_success = datetime.now()
                    health.consecutive_failures = 0
                    health.is_validated = True
                    health.response_times.append(response_time)
                    health.avg_response_time = sum(health.response_times) / len(health.response_times)
                    validated_endpoints.append(endpoint)
                    logger.info(f"✓ {endpoint} - {response_time:.2f}s")
                else:
                    health.failure_count += 1
                    health.last_failure = datetime.now()
                    health.consecutive_failures += 1
                    logger.warning(f"✗ {endpoint} - {details.get('error', 'Unknown error')}")
                    
            except Exception as e:
                logger.error(f"Validation failed for {endpoint}: {e}")
        
        logger.info(f"Validated {len(validated_endpoints)}/{len(endpoints)} endpoints")
        return validated_endpoints
    
    def _validate_single_endpoint(self, endpoint: str) -> Tuple[bool, float, Dict]:
        """Validate single endpoint with real connection"""
        return self.prober.validate_onion_endpoint(endpoint)
    
    def rotate_endpoints(self, endpoints: List[str], force_new_circuit: bool = False) -> List[str]:
        """Rotate endpoint order with optional circuit refresh"""
        if force_new_circuit:
            self.circuit_manager.force_new_circuit()
            time.sleep(2)  # Allow circuit to establish
        
        # Cryptographically secure shuffle
        rotated = endpoints.copy()
        self.crypto_rand.shuffle(rotated)
        
        self.active_endpoints = rotated
        logger.info(f"Rotated {len(rotated)} endpoints")
        
        return rotated
    
    def export_operational_data(self, endpoints: List[str], output_path: Path):
        """Export operational endpoint data"""
        operational_data = {
            'metadata': {
                'timestamp': datetime.now(timezone.utc).isoformat(),
                'total_endpoints': len(endpoints),
                'validated_endpoints': len([e for e in endpoints if self.endpoint_health.get(e, EndpointHealth(e)).is_validated]),
                'operational_endpoints': len([e for e in endpoints if self.endpoint_health.get(e, EndpointHealth(e)).is_operational]),
                'tor_info': self.circuit_manager.get_circuit_info()
            },
            'endpoints': endpoints,
            'health_status': {
                url: {
                    'reliability_score': health.reliability_score,
                    'avg_response_time': health.avg_response_time,
                    'is_operational': health.is_operational,
                    'success_count': health.success_count,
                    'failure_count': health.failure_count,
                    'last_success': health.last_success.isoformat() if health.last_success else None
                }
                for url, health in self.endpoint_health.items()
            }
        }
        
        # Atomic write operation
        temp_path = output_path.with_suffix('.tmp')
        with open(temp_path, 'w') as f:
            json.dump(operational_data, f, indent=2)
        temp_path.replace(output_path)
        
        logger.info(f"Exported operational data to {output_path}")
    
    async def run_continuous_operations(self, yaml_files: List[Path], output_path: Path,
                                      interval: int, validate_endpoints: bool = True,
                                      aggressive_rotation: bool = False):
        """Run continuous endpoint operations"""
        logger.info("Starting continuous endpoint operations...")
        
        try:
            while True:
                cycle_start = time.time()
                
                # Load endpoints
                endpoints = self.load_endpoint_sources(yaml_files)
                if not endpoints:
                    logger.error("No endpoints loaded, waiting...")
                    await asyncio.sleep(60)
                    continue
                
                # Validate if requested
                if validate_endpoints:
                    validated = self.validate_endpoint_pool(endpoints)
                else:
                    validated = list(endpoints)
                
                # Rotate endpoints
                rotated = self.rotate_endpoints(
                    validated, 
                    force_new_circuit=aggressive_rotation
                )
                
                # Export results
                self.export_operational_data(rotated, output_path)
                
                # Calculate sleep time
                cycle_duration = time.time() - cycle_start
                sleep_time = max(0, interval - cycle_duration)
                
                logger.info(f"Cycle completed in {cycle_duration:.2f}s, sleeping {sleep_time:.2f}s")
                
                if sleep_time > 0:
                    await asyncio.sleep(sleep_time)
                    
        except KeyboardInterrupt:
            logger.info("Operations stopped by user")
        except Exception as e:
            logger.error(f"Operations error: {e}")
            raise

def setup_args() -> argparse.ArgumentParser:
    """Setup production argument parser"""
    parser = argparse.ArgumentParser(
        description="Production Tor Endpoint Juggler - Real OPSEC Tool"
    )
    
    parser.add_argument('--endpoints', type=Path, action='append', required=True,
                       help='YAML files containing real .onion endpoints')
    parser.add_argument('--output', type=Path, default=Path('operational_endpoints.json'),
                       help='Output file for rotated endpoints')
    parser.add_argument('--probe', action='store_true',
                       help='Validate endpoints via real Tor connections')
    parser.add_argument('--newnym', action='store_true',
                       help='Force new Tor circuits during rotation')
    parser.add_argument('--loop', type=int,
                       help='Continuous mode with interval in seconds')
    parser.add_argument('--aggressive', action='store_true',
                       help='Aggressive rotation with frequent circuit changes')
    parser.add_argument('--isolation-level', choices=['low', 'medium', 'high'], 
                       default='medium', help='Circuit isolation level')
    parser.add_argument('--max-workers', type=int, default=10,
                       help='Maximum concurrent validation workers')
    parser.add_argument('--log-level', choices=['DEBUG', 'INFO', 'WARNING', 'ERROR'],
                       default='INFO', help='Logging verbosity')
    
    return parser

async def main():
    """Production main function"""
    parser = setup_args()
    args = parser.parse_args()
    
    # Configure logging
    logging.getLogger().setLevel(getattr(logging, args.log_level))
    
    # Verify Tor is running
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(5)
        result = sock.connect_ex((TOR_SOCKS_HOST, TOR_SOCKS_PORT))
        sock.close()
        if result != 0:
            logger.error(f"Tor SOCKS proxy not accessible at {TOR_SOCKS_HOST}:{TOR_SOCKS_PORT}")
            logger.error("Ensure Tor is running with SOCKS proxy enabled")
            sys.exit(1)
    except Exception as e:
        logger.error(f"Cannot verify Tor connection: {e}")
        sys.exit(1)
    
    try:
        juggler = ProductionEndpointJuggler()
        
        if args.loop:
            # Continuous operations
            await juggler.run_continuous_operations(
                yaml_files=args.endpoints,
                output_path=args.output,
                interval=args.loop,
                validate_endpoints=args.probe,
                aggressive_rotation=args.aggressive
            )
        else:
            # Single operation
            endpoints = juggler.load_endpoint_sources(args.endpoints)
            
            if args.probe:
                validated = juggler.validate_endpoint_pool(endpoints, args.max_workers)
            else:
                validated = list(endpoints)
            
            rotated = juggler.rotate_endpoints(validated, args.newnym)
            juggler.export_operational_data(rotated, args.output)
            
            logger.info(f"Operation complete: {len(rotated)} endpoints ready")
            
    except KeyboardInterrupt:
        logger.info("Operation cancelled")
        sys.exit(0)
    except Exception as e:
        logger.error(f"Fatal error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    asyncio.run(main())
