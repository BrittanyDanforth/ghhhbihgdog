#!/usr/bin/env python3
"""
airgap_tx_signer v10.0 - Offline signer for GhostSpiral unsigned_v1 bundles
============================================================================
Completely offline; never touches the network.

OPSEC hardening:
  - Validates unsigned_v1 schema (handles both dict-wrapped and flat list)
  - Validates all amounts are positive decimals
  - Resume-safe with integrity verification on resume
  - Temp batch files securely wiped after use
  - Blob hashes recorded in manifest for downstream verification
  - All output files written 0600
  - Signal handlers for graceful interruption
  - Progress atomically written with fsync
"""
from __future__ import annotations
import argparse, json, subprocess, hashlib, os, sys, tempfile, time
from pathlib import Path
from decimal import Decimal
from typing import List

from gs_common import (
    integrity_log, atomic_write_json, atomic_write_text,
    secure_file_perms, install_signal_handlers, shutdown_requested,
    scrub_address,
)

REQUIRED_TX_FIELDS = {"src": str, "dst": str, "amt": str, "extra": str}


def _validate_plan(plan: List[dict]) -> None:
    """Validate every TX in the plan has required fields with correct types."""
    if not plan:
        sys.exit("[!] Plan is empty - nothing to sign")
    for i, tx in enumerate(plan):
        for k, typ in REQUIRED_TX_FIELDS.items():
            if k not in tx or not isinstance(tx[k], typ):
                sys.exit(
                    f"[!] Schema error at TX {i}: field '{k}' missing or wrong type"
                )
        try:
            val = Decimal(tx["amt"])
            if val <= 0:
                sys.exit(f"[!] Amount must be positive at TX {i}: {tx['amt']}")
        except Exception:
            sys.exit(f"[!] Amount not parsable at TX {i}: {tx['amt']}")


def _load_unsigned(path: Path) -> List[dict]:
    """Load unsigned_v1 bundle from GhostSpiral.

    Handles: {"meta": {...}, "txs": [...]}  (v10.5 format)
             [tx, tx, ...]                  (flat list)
    """
    with open(path) as f:
        raw = json.load(f)

    if isinstance(raw, dict):
        if "txs" in raw and isinstance(raw["txs"], list):
            meta = raw.get("meta", {})
            schema = meta.get("schema", "unknown")
            integrity_log("signer", f"loaded_schema={schema}:version={meta.get('version', '?')}")
            return raw["txs"]
        sys.exit("[!] unsigned_v1 dict format missing 'txs' list")

    if isinstance(raw, list):
        integrity_log("signer", "loaded_flat_list")
        return raw

    sys.exit("[!] unsigned_v1 has unexpected format (not dict or list)")


def _compute_plan_fingerprint(plan: List[dict]) -> str:
    """Compute a stable fingerprint of the plan content for binding progress to a plan."""
    h = hashlib.sha256()
    for tx in plan:
        h.update(f"{tx.get('dst','')}:{tx.get('amt','')}".encode())
    return h.hexdigest()[:32]


def _verify_resume_integrity(progress: dict, plan: List[dict]) -> None:
    """On resume, verify that:
    1. The progress file was created for THIS plan (fingerprint match)
    2. All previously-signed blob hashes still match (tamper detection)
    """
    # Verify plan binding
    current_fp = _compute_plan_fingerprint(plan)
    saved_fp = progress.get("plan_fingerprint", "")
    if saved_fp and saved_fp != current_fp:
        integrity_log("signer", "PLAN_MISMATCH:progress_from_different_plan")
        sys.exit(
            "[!] Progress file is from a DIFFERENT plan!\n"
            "    Delete the progress file or use the correct unsigned plan.\n"
            "    Mixing progress files between plans can broadcast wrong TXs."
        )

    # Verify blob hashes
    manifest = progress.get("manifest", [])
    for entry in manifest:
        blob_path = Path(entry["file"])
        if blob_path.exists():
            with open(blob_path, "rb") as f:
                actual_hash = hashlib.sha256(f.read()).hexdigest()
            if actual_hash != entry.get("hash"):
                integrity_log("signer", f"TAMPER_DETECTED:idx={entry['idx']}")
                sys.exit(f"[!] Blob tampered: {blob_path} hash mismatch on resume!")
        else:
            integrity_log("signer", f"missing_blob_on_resume:idx={entry['idx']}")
            sys.exit(f"[!] Previously signed blob missing: {blob_path}")
    integrity_log("signer", f"resume_ok:last={progress.get('last', -1)}")


def main():
    install_signal_handlers()

    cli = argparse.ArgumentParser(
        "airgap_tx_signer v10.0",
        description="Offline signer for GhostSpiral unsigned_v1 plans",
    )
    cli.add_argument("unsigned_json",
                     help="unsigned_v1 JSON from GhostSpiral")
    cli.add_argument("--wallet-cli", default="monero-wallet-cli")
    cli.add_argument("--wallet-file", required=True)
    cli.add_argument("--outdir", default="signed_blobs")
    cli.add_argument("--resume",
                     help="progress file for crash-resume")
    cli.add_argument("--fee-priority", type=int, choices=[1, 2, 3, 4], default=1,
                     help="Monero fee priority level: 1=default, 2=x4, 3=x20, 4=x166")
    args = cli.parse_args()

    unsigned_path = Path(args.unsigned_json)
    if not unsigned_path.exists():
        sys.exit(f"[!] File not found: {unsigned_path}")

    wallet_path = Path(args.wallet_file)
    if not wallet_path.exists():
        sys.exit(f"[!] Wallet file not found: {wallet_path}")

    plan = _load_unsigned(unsigned_path)
    _validate_plan(plan)
    integrity_log("signer", f"plan_loaded:entries={len(plan)}")

    outdir = Path(args.outdir)
    outdir.mkdir(parents=True, exist_ok=True)

    progress_file = Path(args.resume) if args.resume else Path("signer_progress.json")
    plan_fp = _compute_plan_fingerprint(plan)

    if progress_file.exists():
        with open(progress_file) as pf:
            progress = json.load(pf)
        _verify_resume_integrity(progress, plan)
    else:
        progress = {"last": -1, "manifest": [], "plan_fingerprint": plan_fp}

    signed_count = 0
    skipped_count = 0

    try:
        for idx, tx in enumerate(plan):
            if shutdown_requested():
                integrity_log("signer", f"shutdown_at_idx={idx}")
                print(f"  [!] Shutdown at TX {idx}. Resume with --resume {progress_file}")
                break

            if idx <= progress["last"]:
                skipped_count += 1
                continue

            amt = Decimal(tx["amt"])

            blob_path = outdir / f"tx_{idx}.blob"

            batch_path = None
            try:
                fd, batch_path = tempfile.mkstemp(suffix=".batch", prefix="gs_sign_")
                priority = args.fee_priority
                with os.fdopen(fd, "w") as batch:
                    batch.write(
                        f"transfer {tx['dst']} {amt}\n"
                    )

                cmd = [
                    args.wallet_cli,
                    "--wallet-file", args.wallet_file,
                    "--offline",
                    "--trusted-daemon",
                    f"--priority={priority}",
                ]
                subprocess.run(
                    cmd + ["--batch-file", batch_path],
                    check=True, timeout=120,
                )
            except subprocess.TimeoutExpired:
                integrity_log("signer", f"timeout_idx={idx}")
                sys.exit(f"[!] wallet-cli timed out on TX {idx}")
            finally:
                if batch_path and os.path.exists(batch_path):
                    with open(batch_path, "w") as f:
                        f.write("\x00" * 256)
                    os.unlink(batch_path)

            if not blob_path.exists():
                integrity_log("signer", f"no_blob_idx={idx}")
                sys.exit(f"[!] Blob not created for TX {idx}")

            secure_file_perms(blob_path)

            with open(blob_path, "rb") as bf:
                sha = hashlib.sha256(bf.read()).hexdigest()

            progress["manifest"].append({
                "idx": idx,
                "file": str(blob_path),
                "hash": sha,
                "dst": scrub_address(tx["dst"]),
                "amt": str(amt),
            })
            progress["last"] = idx
            atomic_write_json(progress, progress_file)
            integrity_log("signer", f"signed:idx={idx}:sha={sha[:16]}")
            signed_count += 1
            print(f"  [+] TX {idx}/{len(plan) - 1} -> {blob_path.name}")

        # Final manifest
        final_manifest = outdir / "signed_manifest_v1.json"
        atomic_write_json(progress["manifest"], final_manifest)
        integrity_log("signer", f"done:signed={signed_count}:skipped={skipped_count}")
        print(f"\n  [+] Signing complete: {signed_count} signed, {skipped_count} resumed.")

    except subprocess.CalledProcessError as e:
        integrity_log("signer", f"wallet_cli_error:{e.returncode}")
        print(f"  [!] wallet-cli error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
