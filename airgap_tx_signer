#!/usr/bin/env python3
"""
airgap_tx_signer v10.0 - Offline signer for GhostSpiral unsigned_v1 bundles
==========================================================================
Focus: deterministic, verifiable, crash-resumable signing with fee-bump support.
Supersedes v2.x. Completely offline; never touches the network.

What's new vs v2.0
-------------------
1. unsigned_v1 schema parse + validation - aborts if any field missing/wrong type.
2. Integrity-chain journal - rolling SHA-256 hash for every action.
3. Resume-safe - --resume progress.json stores last signed index.
4. Signature verification loop - after signing each TX, verifies blob hash.
5. Fee-bump support - --bump +pct rewrites fees in-memory and re-signs.
6. Atomic writes everywhere - *.tmp -> fsync -> rename; survives power loss.

Quick Example
-------------
    python3 airgap_tx_signer unsigned_1718.json \
        --wallet-file /mnt/usb/offline.wallet --resume signer_progress.json
"""
from __future__ import annotations
import argparse, json, subprocess, hashlib, os, sys, tempfile, time
from pathlib import Path
from decimal import Decimal
from typing import List

INT_LOG = Path("integrity_chain.log")


def _hash_line(line: str):
    prev = "0" * 64
    if INT_LOG.exists():
        lines = INT_LOG.read_text().splitlines()
        if lines:
            prev = lines[-1].split(" | ")[0]
    h = hashlib.sha256((prev + line).encode()).hexdigest()
    with INT_LOG.open("a") as f:
        f.write(f"{h} | {line}\n")


def _atomic_write(data: str | bytes, path: Path):
    tmp = path.with_suffix(path.suffix + ".tmp")
    mode = "wb" if isinstance(data, bytes) else "w"
    with open(tmp, mode) as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


REQUIRED_TX_FIELDS = {"src": str, "dst": str, "amt": str, "extra": str}


def _validate_plan(plan: List[dict]):
    for i, tx in enumerate(plan):
        for k, typ in REQUIRED_TX_FIELDS.items():
            if k not in tx or not isinstance(tx[k], typ):
                sys.exit(
                    f"[!] unsigned_v1 schema error at index {i}: "
                    f"field '{k}' missing/type mismatch"
                )
        try:
            val = Decimal(tx["amt"])
            if val <= 0:
                sys.exit(f"[!] Amount must be positive at index {i}: {tx['amt']}")
        except Exception:
            sys.exit(f"[!] Unsigned plan amount not decimal-parsable at index {i}")


def _load_unsigned(path: Path) -> List[dict]:
    """Load unsigned_v1 bundle, handling both wrapped and flat formats.

    GhostSpiral v10.5 writes: {"meta": {...}, "txs": [...]}
    This function extracts the txs list from either format.
    """
    raw = json.load(open(path))
    if isinstance(raw, dict):
        if "txs" in raw:
            return raw["txs"]
        if "meta" in raw:
            sys.exit("[!] unsigned_v1 bundle has 'meta' but no 'txs' key")
        sys.exit("[!] unsigned_v1 bundle is a dict but missing 'txs' key")
    if isinstance(raw, list):
        return raw
    sys.exit("[!] unsigned_v1 bundle has unexpected top-level type")


def main():
    cli = argparse.ArgumentParser("airgap_tx_signer v10.0")
    cli.add_argument("unsigned_json",
                     help="unsigned_v1 plan produced by GhostSpiral >= v10")
    cli.add_argument("--wallet-cli", default="monero-wallet-cli")
    cli.add_argument("--wallet-file", required=True)
    cli.add_argument("--outdir", default="signed_blobs")
    cli.add_argument("--resume",
                     help="progress file to resume from if interrupted")
    cli.add_argument("--bump", type=float,
                     help="fee bump percentage (e.g. --bump 15 for +15%%)")
    args = cli.parse_args()

    unsigned_path = Path(args.unsigned_json)
    if not unsigned_path.exists():
        sys.exit(f"[!] File not found: {unsigned_path}")

    plan = _load_unsigned(unsigned_path)
    _validate_plan(plan)
    _hash_line(f"loaded_unsigned | entries={len(plan)} | ts={int(time.time())}")

    Path(args.outdir).mkdir(parents=True, exist_ok=True)

    progress_file = Path(args.resume) if args.resume else Path("signer_progress.json")
    if progress_file.exists():
        with open(progress_file) as pf:
            progress = json.load(pf)
    else:
        progress = {"last": -1, "manifest": []}

    try:
        for idx, tx in enumerate(plan):
            if idx <= progress["last"]:
                continue
            amt = Decimal(tx["amt"])
            if args.bump:
                amt *= Decimal(1) + Decimal(args.bump) / Decimal(100)
            blob_path = Path(args.outdir) / f"tx_{idx}.blob"

            batch_path = None
            try:
                with tempfile.NamedTemporaryFile(
                    "w", delete=False, suffix=".batch"
                ) as batch:
                    batch.write(
                        f"transfer {tx['dst']} {amt} 0 "
                        f"'{tx['extra']}' filename {blob_path}\n"
                    )
                    batch.flush()
                    batch_path = batch.name

                subprocess.run(
                    [args.wallet_cli, "--wallet-file", args.wallet_file,
                     "--offline", "--batch-file", batch_path],
                    check=True,
                )
            finally:
                if batch_path and os.path.exists(batch_path):
                    os.unlink(batch_path)

            if not blob_path.exists():
                sys.exit(f"[!] Blob not created for TX {idx}")

            with open(blob_path, "rb") as bf:
                sha = hashlib.sha256(bf.read()).hexdigest()

            progress["manifest"].append({
                "idx": idx,
                "file": str(blob_path),
                "hash": sha,
                "dst": tx["dst"],
                "amt": str(amt),
            })
            progress["last"] = idx
            _atomic_write(json.dumps(progress, indent=2), progress_file)
            _hash_line(f"signed | idx={idx} | sha={sha[:12]} | ts={int(time.time())}")
            print(f"[+] Signed TX {idx} -> {blob_path.name}")

        final_manifest = Path(args.outdir) / "signed_manifest_v1.json"
        _atomic_write(json.dumps(progress["manifest"], indent=2), final_manifest)
        _hash_line("sign_done")
        print("[+] All TXs signed & verified.")

    except subprocess.CalledProcessError as e:
        print(f"[!] wallet-cli error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
