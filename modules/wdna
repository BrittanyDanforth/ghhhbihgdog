#!/usr/bin/env python3
"""
wallet_dna_mutator — Deterministic wallet structure mutation engine
===================================================================
Rewrites the **account / sub‑address layout** (the "DNA") inside a Monero CLI
`wallet.json` export to ensure every run has a *unique* structural footprint
while preserving all keys and balances.

Unlike label mutation in `label_masker`, this tool **changes the index order
and internal gaps** so chain‑analysis heuristics that rely on wallet‑structure
consistency fail.

Core Capabilities
─────────────────
1. **Deterministic chaos** — seeded from `entropy_seed.json` + original wallet
   SHA‑256, so repeated runs in the same session reproduce identical output.
2. **Account re‑shuffling** — reorders account objects and randomly inserts
   *gap* accounts (empty label + zero balance) to shift indices.
3. **Sub‑address re‑shuffling** — shuffles sub‑addresses within each account,
   optionally inserts *gap* sub‑addresses.
4. **Label randomisation** — re‑labels accounts/sub‑addresses via
   `label_masker_v3`‑style junk words → breaks label clustering.
5. **Safe output** — writes **new wallet JSON** (original untouched) plus a
   manifest mapping old→new indices for downstream lookup.
6. **Supports dry‑run** — print mapping only, no disk writes.

Requirements
────────────
Input must be a **JSON export** created via:
```bash
monero-wallet-cli --wallet-file my.wallet --export-wallet my_wallet.json
```

Usage Example
─────────────
    python3 wallet_dna_mutator.py my_wallet.json --out mutated_wallet.json

Manifest Schema (wallet_mutation_manifest_v1.json)
───────────────────────────────────────────────────
```json
{
  "schema": "dna_mutate_v1",
  "seed_sha": "…",
  "original_wallet": "my_wallet.json",
  "output_wallet": "mutated_wallet.json",
  "account_map": {
      "0": "2",   # old idx 0 → new idx 2
      "1": "0"    # old idx 1 → new idx 0
  },
  "subaddress_map": {
      "0:0": "2:1",  # (acc 0, sub 0) → (acc 2, sub 1)
      "0:1": "2:0"
  }
}
```
"""
# NETWORK: This module operates locally only. No network access.
from __future__ import annotations
import argparse
import hashlib
import json
import os
import random
import secrets
import sys
import tempfile
from pathlib import Path
from datetime import datetime, timezone
from typing import Dict, List, Tuple, Any, Optional

_TOOLKIT_ROOT = Path(__file__).resolve().parent.parent

sys.path.insert(0, str(_TOOLKIT_ROOT / "core"))
from gs_common import atomic_write_json

SEED_FILE = _TOOLKIT_ROOT / "entropy_seed.json"
MANIFEST_NAME = "wallet_mutation_manifest_v1.json"
BASE58 = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"

# Enhanced junk banks for better OpSec
JUNK_PREFIXES = [
    "backup", "fwd", "zk", "sync", "tmp", "log", "snap", "dump", "cold", "hot",
    "cache", "buffer", "queue", "stack", "heap", "pool", "store", "vault",
    "node", "peer", "relay", "proxy", "bridge", "tunnel", "gate", "hub"
]

JUNK_SUFFIXES = [
    "main", "alt", "test", "dev", "prod", "stage", "temp", "work", "live",
    "core", "base", "root", "leaf", "branch", "fork", "merge", "split"
]


# ---------------------------------------------------------------------------
# Security helpers
# ---------------------------------------------------------------------------

def secure_delete_file(path: Path) -> None:
    """Securely overwrite file before deletion."""
    try:
        if path.exists() and path.is_file():
            size = path.stat().st_size
            with path.open('r+b') as f:
                # Overwrite with random data multiple times
                for _ in range(3):
                    f.seek(0)
                    f.write(os.urandom(size))
                    f.flush()
                    os.fsync(f.fileno())
            path.unlink()
    except Exception as e:
        print(f"[!] Warning: Could not securely delete {path}: {e}", file=sys.stderr)


def validate_wallet_json(data: dict) -> bool:
    """Validate wallet JSON structure."""
    required_fields = ["accounts"]
    for field in required_fields:
        if field not in data:
            return False
    
    if not isinstance(data["accounts"], list):
        return False
    
    # Validate account structure
    for i, account in enumerate(data["accounts"]):
        if not isinstance(account, dict):
            return False
        # Check for required account fields
        if "subaddresses" in account and not isinstance(account["subaddresses"], list):
            return False
    
    return True


def sha256_hex(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def generate_secure_label(rng: random.Random) -> str:
    """Generate a more realistic-looking label."""
    prefix = rng.choice(JUNK_PREFIXES)
    suffix = rng.choice(JUNK_SUFFIXES)
    entropy = "".join(rng.choice(BASE58) for _ in range(rng.randint(3, 6)))
    
    # Vary the format for better camouflage
    formats = [
        f"{prefix}_{entropy}",
        f"{prefix}_{suffix}",
        f"{entropy}_{suffix}",
        f"{prefix}{entropy}",
        f"{entropy}{suffix}"
    ]
    return rng.choice(formats)


def deterministic_rng(wallet_path: Path) -> random.Random:
    """Create deterministic RNG from seed file and wallet hash."""
    if not SEED_FILE.exists():
        print(f"[!] {SEED_FILE} missing", file=sys.stderr)
        sys.exit(1)
    
    try:
        seed_data = SEED_FILE.read_bytes()
        wallet_data = wallet_path.read_bytes()
        
        seed_sha = sha256_hex(seed_data)
        wallet_sha = sha256_hex(wallet_data)
        
        # Use first 32 hex chars (128 bits) for seed
        combined_hash = seed_sha + wallet_sha
        seed_int = int(combined_hash[:32], 16)
        
        return random.Random(seed_int)
    except Exception as e:
        print(f"[!] Failed to initialize RNG: {e}", file=sys.stderr)
        sys.exit(1)


# ---------------------------------------------------------------------------
# Core mutation logic
# ---------------------------------------------------------------------------

def create_gap_account(rng: random.Random) -> dict:
    """Create a gap account with realistic structure."""
    return {
        "label": generate_secure_label(rng),
        "balance": 0,
        "unlocked_balance": 0,
        "subaddresses": [],
        "tag": f"gap_{rng.randint(1000, 9999)}"
    }


def create_gap_subaddress(rng: random.Random) -> dict:
    """Create a gap subaddress that looks like an unused wallet entry.
    Address is empty — downstream tools must skip entries with zero balance.
    Using a syntactically-invalid address prevents accidental transactions.
    """
    return {
        "label": generate_secure_label(rng),
        "address": "",
        "balance": 0,
        "unlocked_balance": 0,
        "used": False,
        "index": 0,
        "_gap": True,
    }


def mutate_wallet(
    data: dict, 
    rng: random.Random, 
    acc_gap_prob: float = 0.25, 
    sub_gap_prob: float = 0.15
) -> Tuple[dict, Dict[str, str], Dict[str, str]]:
    """
    Return mutated wallet JSON + mapping dicts.
    
    Args:
        data: Original wallet JSON data
        rng: Random number generator
        acc_gap_prob: Probability of inserting gap accounts
        sub_gap_prob: Probability of inserting gap subaddresses
    
    Returns:
        Tuple of (mutated_data, account_map, subaddress_map)
    """
    accounts = data.get("accounts", [])
    if not accounts:
        print("[!] Warning: No accounts found in wallet", file=sys.stderr)
    
    # Create shuffled indices for accounts
    original_account_indices = list(range(len(accounts)))
    rng.shuffle(original_account_indices)
    
    new_accounts: List[dict] = []
    account_map: Dict[str, str] = {}
    subaddress_map: Dict[str, str] = {}
    
    new_account_index = 0
    
    for old_account_index in original_account_indices:
        original_account = accounts[old_account_index]
        
        # Maybe insert gap accounts before this one
        gap_count = 0
        while rng.random() < acc_gap_prob and gap_count < 3:  # Limit gaps
            gap_account = create_gap_account(rng)
            new_accounts.append(gap_account)
            new_account_index += 1
            gap_count += 1
        
        # Clone and mutate the original account
        mutated_account = original_account.copy()
        mutated_account["label"] = generate_secure_label(rng)
        
        # Handle subaddresses
        original_subaddresses = mutated_account.get("subaddresses", [])
        if original_subaddresses:
            # Shuffle subaddress indices
            original_sub_indices = list(range(len(original_subaddresses)))
            rng.shuffle(original_sub_indices)
            
            new_subaddresses: List[dict] = []
            new_sub_index = 0
            
            for old_sub_index in original_sub_indices:
                original_sub = original_subaddresses[old_sub_index]
                
                # Maybe insert gap subaddresses
                sub_gap_count = 0
                while rng.random() < sub_gap_prob and sub_gap_count < 2:  # Limit sub gaps
                    gap_sub = create_gap_subaddress(rng)
                    gap_sub["index"] = new_sub_index
                    new_subaddresses.append(gap_sub)
                    new_sub_index += 1
                    sub_gap_count += 1
                
                # Clone and mutate original subaddress
                mutated_sub = original_sub.copy()
                mutated_sub["label"] = generate_secure_label(rng)
                mutated_sub["index"] = new_sub_index
                new_subaddresses.append(mutated_sub)
                
                # Record mapping
                old_key = f"{old_account_index}:{old_sub_index}"
                new_key = f"{new_account_index}:{new_sub_index}"
                subaddress_map[old_key] = new_key
                
                new_sub_index += 1
            
            mutated_account["subaddresses"] = new_subaddresses
        
        new_accounts.append(mutated_account)
        account_map[str(old_account_index)] = str(new_account_index)
        new_account_index += 1
    
    # Create mutated wallet data
    mutated_data = data.copy()
    mutated_data["accounts"] = new_accounts
    
    # Update any global indices or counters if present
    if "next_account_index" in mutated_data:
        mutated_data["next_account_index"] = new_account_index
    
    return mutated_data, account_map, subaddress_map


def write_file_atomically(path: Path, data: object) -> None:
    """Write JSON data atomically with secure permissions via gs_common."""
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write_json(data, path, perms=0o600)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        description="wallet_dna_mutator v1.0 - Deterministic wallet structure mutation",
        epilog="WARNING: Always backup original wallet files before mutation!"
    )
    ap.add_argument("wallet_json", help="Path to monero-wallet-cli JSON export")
    ap.add_argument(
        "--out", 
        type=Path, 
        default=_TOOLKIT_ROOT / "mutated_wallet.json", 
        help="Output mutated wallet JSON (default: mutated_wallet.json)"
    )
    ap.add_argument("--dry-run", action="store_true", help="Preview mapping only, no file writes")
    ap.add_argument(
        "--account-gap-prob", 
        type=float, 
        default=0.25, 
        help="Probability of inserting gap accounts (0.0-1.0, default: 0.25)"
    )
    ap.add_argument(
        "--subaddr-gap-prob", 
        type=float, 
        default=0.15, 
        help="Probability of inserting gap subaddresses (0.0-1.0, default: 0.15)"
    )
    ap.add_argument("--verbose", action="store_true", help="Enable verbose output")
    
    args = ap.parse_args()

    # Validate arguments
    if not 0.0 <= args.account_gap_prob <= 1.0:
        sys.exit("[!] account-gap-prob must be between 0.0 and 1.0")
    if not 0.0 <= args.subaddr_gap_prob <= 1.0:
        sys.exit("[!] subaddr-gap-prob must be between 0.0 and 1.0")

    wallet_path = Path(args.wallet_json)
    if not wallet_path.exists():
        sys.exit(f"[!] Wallet JSON not found: {wallet_path}")
    
    if not wallet_path.is_file():
        sys.exit(f"[!] Path is not a file: {wallet_path}")

    # Load and validate wallet data
    try:
        with wallet_path.open('r', encoding='utf-8') as f:
            wallet_data = json.load(f)
    except json.JSONDecodeError as e:
        sys.exit(f"[!] Invalid JSON in wallet file: {e}")
    except Exception as e:
        sys.exit(f"[!] Failed to read wallet file: {e}")

    if not validate_wallet_json(wallet_data):
        sys.exit("[!] Invalid wallet JSON structure")

    if args.verbose:
        account_count = len(wallet_data.get("accounts", []))
        print(f"[*] Loaded wallet with {account_count} accounts")

    # Initialize RNG and perform mutation
    try:
        rng = deterministic_rng(wallet_path)
        mutated_data, account_map, subaddress_map = mutate_wallet(
            wallet_data, 
            rng, 
            args.account_gap_prob, 
            args.subaddr_gap_prob
        )
    except Exception as e:
        sys.exit(f"[!] Mutation failed: {e}")

    # Create manifest
    try:
        seed_sha = sha256_hex(SEED_FILE.read_bytes())[:16]  # Truncate for OpSec
    except Exception as e:
        sys.exit(f"[!] Failed to read seed file: {e}")

    manifest = {
        "schema": "dna_mutate_v1",
        "version": "1.0",
        "created_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "seed_sha_prefix": seed_sha,  # Only store prefix for verification
        "original_wallet": wallet_path.name,  # Only store filename for OpSec
        "output_wallet": args.out.name,
        "mutation_stats": {
            "original_accounts": len(wallet_data.get("accounts", [])),
            "mutated_accounts": len(mutated_data.get("accounts", [])),
            "account_mappings": len(account_map),
            "subaddress_mappings": len(subaddress_map)
        },
        "account_map": account_map,
        "subaddress_map": subaddress_map,
    }

    if args.verbose:
        print(f"[*] Mutation stats:")
        print(f"    Original accounts: {manifest['mutation_stats']['original_accounts']}")
        print(f"    Mutated accounts: {manifest['mutation_stats']['mutated_accounts']}")
        print(f"    Account mappings: {manifest['mutation_stats']['account_mappings']}")
        print(f"    Subaddress mappings: {manifest['mutation_stats']['subaddress_mappings']}")

    if args.dry_run:
        print("\n[DRY-RUN] Mutation manifest:")
        print(json.dumps(manifest, indent=2, ensure_ascii=False))
        return

    # Write output files atomically
    try:
        # Ensure output directory exists
        args.out.parent.mkdir(parents=True, exist_ok=True)
        
        # Write mutated wallet
        write_file_atomically(args.out, mutated_data)
        
        # Write manifest
        manifest_path = args.out.parent / MANIFEST_NAME
        write_file_atomically(manifest_path, manifest)
        
        print(f"[+] Wallet DNA mutated successfully")
        print(f"    Output wallet: {args.out}")
        print(f"    Manifest: {manifest_path}")
        
        if args.verbose:
            print(f"[*] Output file sizes:")
            print(f"    Wallet: {args.out.stat().st_size:,} bytes")
            print(f"    Manifest: {manifest_path.stat().st_size:,} bytes")
            
    except Exception as e:
        sys.exit(f"[!] Failed to write output files: {e}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n[!] Interrupted by user", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"[!] Unexpected error: {e}", file=sys.stderr)
        sys.exit(1)
