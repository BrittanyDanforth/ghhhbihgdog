#!/usr/bin/env python3
"""
label_poisoner.py — GhostSpiral v16.9 Chaos Toolkit
==================================================
Takes the **initial `label_map.json`** produced by `label_masker_v3.py` and
performs a second‑stage mutation so that each label/note pair is *further*
obfuscated to resemble data emitted by **multiple wallet brands at once**.

Think of it as a *forensic fingerprint blender*:
•  Adds **extra fields** (e.g. `tx_description`, `payment_id`, `note2`) that
   mirror structures in Wasabi, Samurai, Electrum, Edge, Exodus, and random
   junk wallets.
•  Injects **UTF‑8 oddities** (zero‑width space, hair‑space) to break naïve
   string matching.
•  Randomly toggles **case, delimiters** so no regex fully fits.
•  Deterministic per‑session — seeded from `entropy_seed.json` + DAG hash +
   original label file hash, so cooperating modules can load identical output.

Output
──────
`label_map_poisoned.json` — identical top‑level structure to `label_map.json`
but with additional forensic‑poisoning sub‑fields for every node.

Usage
─────
    python3 label_poisoner.py --labels label_map.json  \
                              --dag dag_structure.json  \
                              --out label_map_poisoned.json
"""
from __future__ import annotations
import argparse
import json
import os
import random
import sys
import hashlib
from pathlib import Path
from datetime import datetime, timezone
from typing import Dict, Any, Tuple

VERSION = "1.0"
ZERO_WIDTH = "\u200b"  # zero‑width space — confuses grep/ML
HAIR_SPACE = "\u200a"  # hair space - another invisible character
EXTRA_FIELDS = [
    "tx_description", "memo2", "note2", "label_alt", "payment_id",
    "wallet_tag", "edge_label", "exodusNote", "exodusMemo", "tx_comment",
]
DELIMS = ["-", "_", ":", ";", "|", "/", ".", "~"]

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def sha256_hex(data: bytes) -> str:
    """Calculate SHA256 hash of data and return as hex string."""
    return hashlib.sha256(data).hexdigest()


def load_json(path: Path) -> Tuple[Dict[str, Any], str]:
    """Load JSON file and return (data, sha256_hash)."""
    try:
        if not path.exists():
            raise FileNotFoundError(f"File does not exist: {path}")
        
        data = path.read_bytes()
        if len(data) == 0:
            raise ValueError(f"File is empty: {path}")
            
        parsed_data = json.loads(data)
        return parsed_data, sha256_hex(data)
        
    except FileNotFoundError as e:
        print(f"[!] File not found: {e}")
        sys.exit(1)
    except json.JSONDecodeError as e:
        print(f"[!] Invalid JSON in {path}: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"[!] Error loading {path}: {e}")
        sys.exit(1)


def fuzz_string(s: str, rng: random.Random) -> str:
    """Insert zero‑width chars & randomly change case/delims."""
    if not s or not isinstance(s, str):
        return str(s) if s is not None else ""
    
    # Make a copy to avoid modifying original
    result = str(s)
    
    # Randomly insert invisible characters (only if string length > 1)
    if len(result) > 1 and rng.random() < 0.6:
        invisible_char = rng.choice([ZERO_WIDTH, HAIR_SPACE])
        idx = rng.randint(1, len(result) - 1)
        result = result[:idx] + invisible_char + result[idx:]
    
    # Random delimiter mutation
    original_delims = ["-", "_", ":", ".", "/"]
    for d in original_delims:
        if d in result and rng.random() < 0.4:
            new_delim = rng.choice(DELIMS)
            result = result.replace(d, new_delim)
    
    # Random case toggle (only for strings with letters)
    if any(c.isalpha() for c in result) and rng.random() < 0.3:
        if rng.random() < 0.5:
            result = result.swapcase()
        else:
            # Alternative: random case per character
            result = ''.join(
                c.upper() if rng.random() < 0.5 else c.lower() 
                if c.isalpha() else c 
                for c in result
            )
    
    return result


def validate_label_data(data: Dict[str, Any]) -> None:
    """Validate that the label data has required structure."""
    if not isinstance(data, dict):
        print("[!] Label data must be a dictionary")
        sys.exit(1)
        
    if "labels" not in data:
        print("[!] Missing 'labels' key in label_map.json")
        sys.exit(1)
    
    if not isinstance(data["labels"], dict):
        print("[!] 'labels' must be a dictionary")
        sys.exit(1)
    
    if len(data["labels"]) == 0:
        print("[!] Labels dictionary is empty")
        sys.exit(1)
    
    # Check that each label entry has required fields
    for nid, meta in data["labels"].items():
        if not isinstance(meta, dict):
            print(f"[!] Label entry '{nid}' must be a dictionary")
            sys.exit(1)
        if "label" not in meta:
            print(f"[!] Missing 'label' field in entry '{nid}'")
            sys.exit(1)
        if "note" not in meta:
            print(f"[!] Missing 'note' field in entry '{nid}'")
            sys.exit(1)


def generate_seed_from_hashes(seed_sha: str, dag_sha: str, lbl_sha: str) -> int:
    """Generate a deterministic seed from multiple hash strings."""
    try:
        # Combine hashes and take first 32 hex chars
        combined = seed_sha + dag_sha + lbl_sha
        if len(combined) < 32:
            # If somehow we don't have enough data, pad with zeros
            combined = combined.ljust(32, '0')
        
        # Convert to integer, handling potential errors
        seed_hex = combined[:32]
        return int(seed_hex, 16)
        
    except ValueError as e:
        print(f"[!] Error generating seed from hashes: {e}")
        # Fallback to a hash of the combined string
        fallback_hash = hashlib.sha256(combined.encode()).hexdigest()
        return int(fallback_hash[:32], 16)


def create_extra_field_value(meta: Dict[str, Any], rng: random.Random) -> str:
    """Create a value for an extra field based on existing metadata."""
    # Get base values, ensuring they're strings
    label_val = str(meta.get("label", ""))
    note_val = str(meta.get("note", ""))
    
    # Choose base value source
    sources = [val for val in [label_val, note_val] if val]
    
    if not sources:
        # If no valid sources, create random hash
        random_val = sha256_hex(str(rng.random()).encode())[:12]
    else:
        base_val = rng.choice(sources)
        # Sometimes use original, sometimes use hash
        if rng.random() < 0.7:
            random_val = base_val
        else:
            random_val = sha256_hex(base_val.encode())[:12]
    
    return fuzz_string(random_val, rng)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Poison existing label_map.json with multi‑wallet fingerprints and UTF‑8 oddities.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python3 label_poisoner.py
  python3 label_poisoner.py --labels my_labels.json --out poisoned_output.json
  python3 label_poisoner.py --labels labels.json --dag dag.json --seed entropy.json
        """
    )
    
    parser.add_argument(
        "--labels", 
        type=Path, 
        default=Path("label_map.json"), 
        help="Input label_map.json from label_masker_v3.py (default: label_map.json)"
    )
    parser.add_argument(
        "--dag", 
        type=Path, 
        default=Path("dag_structure.json"), 
        help="DAG JSON for hash seed (default: dag_structure.json)"
    )
    parser.add_argument(
        "--seed", 
        type=Path, 
        default=Path("entropy_seed.json"), 
        help="entropy_seed.json for deterministic RNG (default: entropy_seed.json)"
    )
    parser.add_argument(
        "--out", "-o", 
        type=Path, 
        default=Path("label_map_poisoned.json"), 
        help="Output path (default: label_map_poisoned.json)"
    )
    parser.add_argument(
        "--version", 
        action="version", 
        version=f"label_poisoner.py v{VERSION}"
    )
    
    args = parser.parse_args()

    print(f"[*] Label Poisoner v{VERSION}")
    print(f"[*] Loading files...")

    # Load input files
    labels_data, lbl_sha = load_json(args.labels)
    dag_data, dag_sha = load_json(args.dag)
    seed_data, seed_sha = load_json(args.seed)

    print(f"[*] Validating label data...")
    # Validate label data structure
    validate_label_data(labels_data)

    print(f"[*] Initializing deterministic RNG...")
    # Initialize deterministic RNG
    rng_seed = generate_seed_from_hashes(seed_sha, dag_sha, lbl_sha)
    rng = random.Random(rng_seed)

    print(f"[*] Processing {len(labels_data['labels'])} label entries...")
    # Create poisoned data structure
    poisoned = {
        "version": VERSION,
        "created_utc": datetime.now(tz=timezone.utc).isoformat(timespec="milliseconds"),
        "source_ref": {"file": str(args.labels), "sha256": lbl_sha},
        "seed_ref": {"file": str(args.seed), "sha256": seed_sha},
        "dag_ref": {"file": str(args.dag), "sha256": dag_sha},
        "rng_seed_hash": hashlib.sha256(str(rng_seed).encode()).hexdigest()[:16],
        "labels": {},
    }

    # Process each label entry
    processed_count = 0
    for nid, meta in labels_data["labels"].items():
        try:
            # Create a deep copy to avoid modifying original
            new_meta = dict(meta)
            
            # Fuzz existing fields - ensure they're strings
            new_meta["label"] = fuzz_string(str(meta.get("label", "")), rng)
            new_meta["note"] = fuzz_string(str(meta.get("note", "")), rng)
            
            # Preserve other existing fields
            for key, value in meta.items():
                if key not in ["label", "note"]:
                    new_meta[key] = value
            
            # Add 1‑3 extra fields
            num_extra_fields = rng.randint(1, 3)
            available_fields = [f for f in EXTRA_FIELDS if f not in new_meta]
            
            if available_fields:
                selected_fields = rng.sample(
                    available_fields, 
                    min(num_extra_fields, len(available_fields))
                )
                
                for field_name in selected_fields:
                    field_value = create_extra_field_value(meta, rng)
                    new_meta[field_name] = field_value
            
            poisoned["labels"][nid] = new_meta
            processed_count += 1
            
        except Exception as e:
            print(f"[!] Error processing label entry '{nid}': {e}")
            # Continue with other entries rather than failing completely
            continue

    if processed_count == 0:
        print("[!] No label entries were successfully processed")
        sys.exit(1)

    print(f"[*] Writing output to {args.out}...")
    # Write output with proper error handling
    try:
        # Ensure output directory exists
        args.out.parent.mkdir(parents=True, exist_ok=True)
        
        # Write to temporary file first, then rename (atomic operation)
        tmp_path = args.out.with_suffix(args.out.suffix + ".tmp")
        
        with tmp_path.open("w", encoding="utf-8") as fh:
            json.dump(poisoned, fh, indent=2, sort_keys=True, ensure_ascii=False)
        
        # Atomic rename
        tmp_path.replace(args.out)
        os.chmod(args.out, 0o600)
        
        print(f"[+] Successfully created poisoned label map → {args.out}")
        print(f"[+] Processed nodes: {processed_count}/{len(labels_data['labels'])}")
        print(f"[+] File size: {args.out.stat().st_size} bytes")
        
    except PermissionError:
        print(f"[!] Permission denied writing to {args.out}")
        sys.exit(1)
    except OSError as e:
        print(f"[!] OS error writing output file: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"[!] Unexpected error writing output file: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
