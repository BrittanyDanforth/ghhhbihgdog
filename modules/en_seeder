#!/usr/bin/env python3
# entropy_seeder.py
"""
entropy_seeder — High-grade entropy collection and seed generation
===================================================================
Collects **high‑grade runtime entropy** from multiple independent sources and
persists it as a self‑describing JSON bundle.  The bundle becomes the single
source of randomness for the entire session (DAG generation, label masking,
mutation engines, etc.).

⚠️  OPSEC Practice
──────────────────
• Writes to *exactly one* JSON file. Default path is
  `<toolkit-root>/entropy_seed.json`, NOT the caller's CWD — every
  downstream module reads from the toolkit root, so putting the seed
  anywhere else breaks the pipeline. Override with `--out`.
• Immediately overwrites any previous seed file with new entropy, so leaked
  bundles can't be replayed.
• Prints the SHA‑256 hash of the bundle to stdout — keep or scan via QR for
  Dead‑Man unlock systems.
• Never exposes raw `os.urandom()` bytes on stdout or logs; only hashes
  of CSPRNG output make it into the JSON (see `urandom_hash` below).

Usage:
    python3 modules/en_seeder
    python3 modules/en_seeder --out /tmp/my_seed.json --bytes 128

The resulting JSON schema (real field names):
{
    "version"       : "1.0",
    "created_utc"   : "2025-06-20T12:34:56.789Z",
    "bytes_len"     : 96,
    "seed_hex"      : "…",     # primary seed, sha256 of the sources dict
    "sha256"        : "…",     # hash of the bundle itself (integrity)
    "sources"       : {
        "urandom_hash"   : "<sha256(os.urandom(bytes_len))>",
        "time_ns"        : 17984761234876,
        "pids"           : [1234, 1],
        "cpu_hash"       : "<sha256(psutil.cpu_times)>",
        "mem_hash"       : "<sha256(psutil.virtual_memory)>",
        "net_hash"       : "<sha256(psutil.net_io_counters)>",
        "hostname"       : "<sha256(gethostname())>",
        "random_state"   : "<sha256(random.getstate())>",
        "extra_entropy"  : "<sha256(pid:time_ns:token_hex)>",
        "extra"          : "<sha256(--extra-file)>"  # only if supplied
    }
}
"""
# NETWORK: This module operates locally only. No network access.
from __future__ import annotations
import argparse
import hashlib
import json
import os
import secrets
import socket
import time
import random
import sys
from pathlib import Path
from datetime import datetime, timezone

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "core"))
from gs_common import atomic_write_json

try:
    import psutil  # Optional but recommended
except ImportError:
    psutil = None  # Fallback if not installed

_TOOLKIT_ROOT = Path(__file__).resolve().parent.parent

VERSION = "1.0"
DEFAULT_BYTES = 96  # 768 bits of raw urandom


def collect_system_entropy(num_bytes: int, extra_path: Path | None) -> dict:
    """Gather entropy from multiple OS / hardware sources."""
    entropy: dict[str, object] = {}

    # 1. OS randomness pool (store hash only — raw CSPRNG output must not leak into JSON)
    entropy["urandom_hash"] = hashlib.sha256(secrets.token_bytes(num_bytes)).hexdigest()

    # 2. High‑precision time snapshot
    entropy["time_ns"] = time.time_ns()

    # 3. Process and parent IDs
    entropy["pids"] = [os.getpid(), os.getppid()]

    # 4. CPU, memory, network stats (if psutil available)
    if psutil:
        try:
            # Hash system metrics instead of storing raw values (OPSEC:
            # raw cpu_times, mem_info, net_io are strong host fingerprints)
            cpu_raw = json.dumps(psutil.cpu_times()._asdict(), sort_keys=True)
            mem_raw = json.dumps(psutil.virtual_memory()._asdict(), sort_keys=True)
            entropy["cpu_hash"] = hashlib.sha256(cpu_raw.encode()).hexdigest()
            entropy["mem_hash"] = hashlib.sha256(mem_raw.encode()).hexdigest()

            try:
                net_io = psutil.net_io_counters()
                if net_io:
                    net_raw = json.dumps(net_io._asdict(), sort_keys=True)
                    entropy["net_hash"] = hashlib.sha256(net_raw.encode()).hexdigest()
            except (AttributeError, OSError):
                pass
        except Exception as e:
            entropy["psutil_error"] = str(e)

    # 5. Hostname hashed (avoid leaking raw name)
    try:
        hostname = socket.gethostname().encode()
        entropy["hostname"] = hashlib.sha256(hostname).hexdigest()
    except Exception as e:
        entropy["hostname"] = f"error: {str(e)}"

    # 6. Optional extra entropy file (any binary file)
    if extra_path and extra_path.exists():
        try:
            with extra_path.open("rb") as fh:
                raw = fh.read()
            # Only store a hash, not raw content
            entropy["extra"] = hashlib.sha256(raw).hexdigest()
        except Exception as e:
            entropy["extra"] = f"read_error: {str(e)}"

    # 7. Inject random module state snapshot as a stable hash (portable across Python versions)
    try:
        state = random.getstate()
        entropy["random_state"] = hashlib.sha256(str(state).encode()).hexdigest()
    except Exception as e:
        entropy["random_state"] = f"error: {str(e)}"

    # 8. Additional non-identifying entropy (PID, time, urandom only — no env
    #    vars or CWD which leak workspace/user fingerprints)
    extra_entropy = f"{os.getpid()}:{time.time_ns()}:{secrets.token_hex(32)}"
    entropy["extra_entropy"] = hashlib.sha256(extra_entropy.encode()).hexdigest()
    
    return entropy


def build_seed_bundle(entropy: dict, num_bytes: int) -> dict:
    """Wrap collected entropy into final bundle with metadata.
    Includes top-level ``seed_hex`` so that SML and other modules can
    load the primary seed directly without digging into ``sources``.
    """
    # Derive a primary seed from all collected entropy
    combined = json.dumps(entropy, sort_keys=True).encode()
    primary_seed = hashlib.sha256(combined).hexdigest()

    bundle = {
        "version": VERSION,
        "created_utc": datetime.now(tz=timezone.utc).isoformat(timespec="milliseconds"),
        "bytes_len": num_bytes,
        "seed_hex": primary_seed,
        "sources": entropy,
    }

    bundle_for_hash = {k: v for k, v in bundle.items() if k != "sha256"}
    bundle_bytes = json.dumps(bundle_for_hash, sort_keys=True).encode()
    bundle["sha256"] = hashlib.sha256(bundle_bytes).hexdigest()

    return bundle


def write_bundle(bundle: dict, out_path: Path):
    """Write bundle to file atomically with secure permissions."""
    out_path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write_json(bundle, out_path, perms=0o600)


def main():
    parser = argparse.ArgumentParser(
        description="Generate high‑grade entropy seed bundle from multiple system sources."
    )
    parser.add_argument(
        "--out", "-o",
        type=Path,
        default=_TOOLKIT_ROOT / "entropy_seed.json",
        help="Output JSON path (default: <toolkit-root>/entropy_seed.json)"
    )
    parser.add_argument(
        "--bytes", "-b", 
        type=int, 
        default=DEFAULT_BYTES, 
        help="Bytes of os.urandom to capture (default: 96)"
    )
    parser.add_argument(
        "--extra-file", "-e", 
        type=Path, 
        help="Path to extra entropy source file (optional)"
    )
    
    args = parser.parse_args()

    # Validate arguments
    if args.bytes <= 0:
        print("[-] Error: --bytes must be positive")
        return 1
    
    if args.extra_file and not args.extra_file.exists():
        print(f"[-] Warning: Extra file {args.extra_file} does not exist, skipping")
        args.extra_file = None

    try:
        print("[*] Collecting system entropy...")
        entropy = collect_system_entropy(args.bytes, args.extra_file)
        
        print("[*] Building seed bundle...")
        bundle = build_seed_bundle(entropy, args.bytes)
        
        print(f"[*] Writing to {args.out}...")
        write_bundle(bundle, args.out)

        print(f"[+] Saved entropy bundle → {args.out}")
        print(f"[+] SHA‑256: {bundle['sha256']}")
        print(f"[+] Total entropy sources: {len(entropy)}")
        
        return 0
        
    except Exception as e:
        print(f"[-] Fatal error: {e}")
        return 1


if __name__ == "__main__":
    exit(main())
