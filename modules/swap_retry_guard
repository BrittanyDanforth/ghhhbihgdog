class SecureMemory:
    """Military-grade memory management with secure deletion."""
    
    def __init__(self, size: int):
        self.size = size
        self._buffer = ctypes.create_string_buffer(size)
        self._ptr = ctypes.cast(self._buffer, ctypes.POINTER(ctypes.c_char))
        
    def write(self, data: bytes, offset: int = 0):
        if offset + len(data) > self.size:
            raise ValueError("Data exceeds buffer size")
        ctypes.memmove(self._ptr + offset, data, len(data))
        
    def read(self, length: int, offset: int = 0) -> bytes:
        if offset + length > self.size:
            raise ValueError("Read exceeds buffer size")
        return ctypes.string_at(self._ptr + offset, length)
        
    def secure_wipe(self):
        """Overwrite buffer with zeros, then ones, then random bytes."""
        ctypes.memset(self._ptr, 0x00, self.size)
        ctypes.memset(self._ptr, 0xFF, self.size)
        rand_bytes = os.urandom(self.size)
        self.write(rand_bytes)
        ctypes.memset(self._ptr, 0x00, self.size)
        
    def __del__(self):
        self.secure_wipe()


class QuantumEntropyFusion:
    """Advanced entropy fusion from multiple sources."""
    
    def __init__(self, seed_file: Path):
        self.seed_file = seed_file
        self.entropy_pool = SecureMemory(1024)
        self._last_harvest = 0
        self._harvest_lock = threading.Lock()
        
    def harvest_entropy(self) -> bytes:
        """Collect entropy from multiple sources."""
        with self._harvest_lock:
            sources = []
            
            # System entropy
            sources.append(secrets.token_bytes(32))
            
            # Timing entropy  
            sources.append(struct.pack('d', time.time()))
            sources.append(struct.pack('Q', time.perf_counter_ns()))
            
            # Process entropy
            try:
                proc = psutil.Process()
                sources.append(struct.pack('f', proc.cpu_percent()))
                sources.append(struct.pack('Q', proc.memory_info().rss))
            except (OSError, psutil.Error):
                pass
                
            # Network entropy — use local interface info only (no clearnet traffic)
            try:
                sources.append(os.urandom(8))
                sources.append(struct.pack('d', time.monotonic()))
            except (OSError, NotImplementedError, struct.error) as e:
                integrity_log("swap_retry", f"net_entropy_skip:{type(e).__name__}")
                
            # Filesystem entropy
            if self.seed_file.exists():
                sources.append(self.seed_file.read_bytes())
                
            # Fuse all sources
            combined = b''.join(sources)
            kdf = PBKDF2HMAC(
                algorithm=hashes.SHA256(),
                length=32,
                salt=b'entropy_fusion_kdf_v1',
                iterations=100000,
            )
            return kdf.derive(combined)
    
    def get_secure_random(self) -> random.Random:
        """Get seeded PRNG for reproducible jitter/ordering.

        WARNING: Despite the name, this is NOT cryptographically secure.
        random.Random is a Mersenne Twister PRNG. Anyone with the seed file
        (entropy_seed.json) can reproduce the exact sequence of timing
        delays, endpoint selection, and header choices. Do NOT use this
        for key generation or nonces — use secrets/os.urandom for those.
        The seed file sits on disk by default; delete it after use or
        store it only in RAM (/dev/shm) via the SML module.
        """
        entropy = self.harvest_entropy()
        seed = int.from_bytes(entropy, 'big')
        return random.Random(seed)


class CircuitBurnProtocol:
    """Advanced circuit burning and identity rotation."""
    
    def __init__(self, control_socket: str):
        self.control_socket = control_socket
        self.burn_count = 0
        self.last_burn = 0
        self.burn_history = deque(maxlen=100)
        
    def should_burn_circuit(self, error_count: int, response_time: float) -> bool:
        """Intelligent circuit burn decision."""
        now = time.time()
        
        # Burn on error threshold
        if error_count >= CIRCUIT_BURN_THRESHOLD:
            return True
            
        # Burn on suspicious timing
        if response_time > 30.0:
            return True
            
        # Burn periodically for OpSec
        if now - self.last_burn > 300:  # 5 minutes
            return True
            
        # Random burns for unpredictability
        if secrets.randbelow(100) < 5:  # 5% chance
            return True
            
        return False
        
    def burn_circuit(self) -> bool:
        """Execute circuit burn with full identity rotation.
        Tries Unix socket first, then TCP 9051 (system tor), then 9151 (Tor Browser).
        """
        try:
            controller = None
            if os.path.exists(self.control_socket):
                controller = Controller.from_socket_file(self.control_socket)
            else:
                for port in (9051, 9151):
                    try:
                        controller = Controller.from_port(port=port)
                        break
                    except Exception:
                        continue
            if controller is None:
                return False

            with controller:
                tor_pw = os.environ.get("TOR_CONTROL_PASSWORD", "")
                if tor_pw:
                    controller.authenticate(password=tor_pw)
                else:
                    controller.authenticate()

                controller.signal(Signal.NEWNYM)
                
                # Wait for circuit establishment
                time.sleep(2 + secrets.randbelow(3000) / 1000.0)
                
                # Log burn event
                self.burn_count += 1
                self.last_burn = time.time()
                self.burn_history.append({
                    'timestamp': self.last_burn,
                    'count': self.burn_count,
                    'reason': 'scheduled_burn'
                })
                
                # Write burn log (coarsened timestamp, restricted perms)
                if CIRCUIT_LOG.parent.exists():
                    coarsened_ts = int(self.last_burn) // 600 * 600
                    fd = os.open(str(CIRCUIT_LOG), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
                    try:
                        os.write(fd, f"{coarsened_ts}|BURN|{self.burn_count}\n".encode())
                    finally:
                        os.close(fd)
                
                return True
                
        except Exception as e:
            return False


class IntegrityChainV2:
    """Advanced cryptographic integrity verification."""
    
    def __init__(self, seed_hash: str):
        self.seed_hash = seed_hash
        self.chain_state = "0" * 64
        self.chain_lock = threading.Lock()
        
    def _compute_hash(self, data: str) -> str:
        """Compute SHA-256 with salt."""
        salted = self.seed_hash + self.chain_state + data
        return hashlib.sha256(salted.encode()).hexdigest()
        
    def add_entry(self, tag: str, detail: str, metadata: Dict[str, Any] = None):
        """Add integrity chain entry."""
        with self.chain_lock:
            coarsened_ts = int(time.time()) // 600 * 600
            
            entry_data = f"{coarsened_ts}|{tag}|{detail}"
            if metadata:
                safe_meta = {k: v for k, v in metadata.items()
                             if k not in ("endpoint", "url")}
                if safe_meta:
                    entry_data += f"|{json.dumps(safe_meta, sort_keys=True)}"
                
            new_hash = self._compute_hash(entry_data)
            
            log_entry = f"{new_hash}|{entry_data}\n"
            
            try:
                fd = os.open(str(INTEGRITY_LOG), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
                try:
                    os.write(fd, log_entry.encode())
                finally:
                    os.close(fd)
                self.chain_state = new_hash
            except OSError:
                # Advance chain_state even on write failure to keep hash chain
                # consistent for future entries that may succeed.
                self.chain_state = new_hash


class TrafficObfuscator:
    """Advanced traffic analysis resistance."""
    
    def __init__(self, rng: random.Random):
        self.rng = rng
        self.request_history = deque(maxlen=1000)
        self.timing_baseline = None
        
    def get_stealth_headers(self) -> Dict[str, str]:
        """Generate randomized HTTP headers."""
        headers = {
            'User-Agent': self.rng.choice(STEALTH_USER_AGENTS),
            'Accept': 'application/json,text/plain,*/*',
            'Accept-Language': self.rng.choice([
                'en-US,en;q=0.9',
                'en-GB,en;q=0.9',
                'en-CA,en;q=0.9'
            ]),
            'Accept-Encoding': 'gzip, deflate, br',
            'Connection': 'keep-alive',
            'Upgrade-Insecure-Requests': '1',
            'DNT': '1',
            'Sec-Fetch-Dest': 'empty',
            'Sec-Fetch-Mode': 'cors',
            'Sec-Fetch-Site': 'cross-site'
        }
        
        # Add random headers for fingerprint resistance
        if self.rng.random() < 0.3:
            headers['X-Requested-With'] = 'XMLHttpRequest'
        if self.rng.random() < 0.2:
            headers['Cache-Control'] = 'no-cache'
            
        return headers
        
    def calculate_timing_delay(self) -> float:
        """Calculate anti-correlation timing delay."""
        if len(self.request_history) < 2:
            return self.rng.uniform(*TIMING_JITTER_RANGE)
            
        # Analyze recent timing patterns
        recent_gaps = []
        for i in range(1, min(10, len(self.request_history))):
            gap = self.request_history[-i]['timestamp'] - self.request_history[-(i+1)]['timestamp']
            recent_gaps.append(gap)
            
        if recent_gaps:
            avg_gap = sum(recent_gaps) / len(recent_gaps)
            # Vary from average to break patterns
            variation = self.rng.uniform(0.5, 2.0)
            return max(TIMING_JITTER_RANGE[0], avg_gap * variation)
        
        return self.rng.uniform(*TIMING_JITTER_RANGE)
        
    def record_request(self, url: str, response_time: float, success: bool):
        """Record request for pattern analysis."""
        entry = {
            'timestamp': time.time(),
            'url_hash': hashlib.sha256(url.encode()).hexdigest()[:16],
            'response_time': response_time,
            'success': success
        }
        self.request_history.append(entry)


