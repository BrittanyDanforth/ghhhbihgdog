        # Execute swap with retry logic
        success = False
        last_error = None
        error_count = 0
        
        for attempt in range(1, 6):  # Max 5 attempts
            # Select endpoint and proxy
            endpoint = self.rng.choice(self.aggregator_pool)
            proxy = self.rng.choice(self.proxy_chain)
            
            try:
                # Anti-correlation timing delay (always in stealth mode, only after first attempt otherwise)
                if attempt > 1 or getattr(self.args, 'stealth_mode', False):
                    delay = self.traffic_obfuscator.calculate_timing_delay()
                    time.sleep(delay)
                    
                # Execute request
                result = self._execute_swap_request(endpoint, payload, proxy)
                
                # Validate successful response
                if result.get("expected_amount_out") or result.get("transaction_id"):
                    self.integrity_chain.add_entry(
                        "SWAP_SUCCESS", 
                        f"idx={idx}|attempt={attempt}",
                        {"result_hash": hashlib.sha256(json.dumps(result, sort_keys=True).encode()).hexdigest()[:16]}
                    )
                    success = True
                    self.success_count += 1
                    break
                else:
                    raise ValueError("Invalid swap response")
                    
            except Exception as e:
                error_count += 1
                last_error = str(e)
                
                self.integrity_chain.add_entry(
                    "SWAP_ATTEMPT_FAIL",
                    f"idx={idx}|attempt={attempt}",
                    {"error": str(e)[:100]}
                )
                
                # Circuit burn decision
                if self.circuit_burn.should_burn_circuit(error_count, 0):
                    if self.circuit_burn.burn_circuit():
                        self.integrity_chain.add_entry("CIRCUIT_BURN", f"idx={idx}|attempt={attempt}")
                        
        # Final result handling
        if not success:
            self.failure_count += 1
            self.integrity_chain.add_entry(
                "SWAP_FINAL_FAIL",
                f"idx={idx}|attempts=5",
                {"last_error": str(last_error)[:100] if last_error else "unknown"}
            )
            
        # Only advance progress["last"] on success — failed swaps must be
        # retried on the next run, not silently skipped.
        if success:
            self.progress["last"] = idx
        self.progress["log"].append({
            "idx": idx,
            "success": success,
            "attempts": attempt,
            "timestamp": time.time(),
            "error_count": error_count
        })
        self._save_progress(self.progress)

        return success
        
    def execute_swap_plan(self, plan_file: Path) -> bool:
        """Execute complete swap plan."""
        try:
            # Load swap plan
            plan = json.loads(plan_file.read_text())
            if not isinstance(plan, list):
                raise ValueError("Swap plan must be a list")
                
            self.integrity_chain.add_entry("PLAN_START", f"swaps={len(plan)}")
            
            total_swaps = len(plan)
            successful_swaps = 0
            
            print(f"[*] Starting swap execution: {total_swaps} swaps")
            print(f"[*] Using {len(self.aggregator_pool)} aggregators")
            print(f"[*] Proxy chain: {len(self.proxy_chain)} hops")
            
            # Execute swaps
            for i, swap_entry in enumerate(plan):
                print(f"\n[*] Processing swap {i+1}/{total_swaps} (idx={swap_entry.get('idx', i)})")
                
                try:
                    result = self._execute_single_swap(swap_entry)
                    if result:
                        # Don't count phantom decoys or dry-run as real successes
                        last_log = self.progress["log"][-1] if self.progress["log"] else {}
                        if not last_log.get("phantom") and not last_log.get("dry_run"):
                            successful_swaps += 1
                            print(f"[+] Swap {swap_entry.get('idx', i)} quote fetched")
                        else:
                            print(f"[*] Swap {swap_entry.get('idx', i)} — {'phantom decoy' if last_log.get('phantom') else 'dry run'}")
                    else:
                        print(f"[!] Swap {swap_entry.get('idx', i)} failed")
                        
                except Exception as e:
                    print(f"[!] Swap {swap_entry.get('idx', i)} error: {e}")
                    self.integrity_chain.add_entry("SWAP_EXCEPTION", f"idx={swap_entry.get('idx', i)}", {"error": str(e)})
                    
            # Final statistics
            print(f"\n[*] Swap quote fetching finished")
            print(f"    Total quotes requested: {total_swaps}")
            print(f"    Quotes received: {successful_swaps}")
            print(f"    Failed: {total_swaps - successful_swaps}")
            print(f"    [!] These are QUOTES, not executed swaps. Operator must still send BTC.")
            print(f"    Circuit burns: {self.circuit_burn.burn_count}")
            
            self.integrity_chain.add_entry(
                "PLAN_COMPLETE",
                f"total={total_swaps}|success={successful_swaps}|burns={self.circuit_burn.burn_count}"
            )
            
            return successful_swaps == total_swaps
            
        except Exception as e:
            self.integrity_chain.add_entry("PLAN_ERROR", str(e))
            print(f"[!] Plan execution failed: {e}")
            return False


def main():
    """Main entry point with enhanced argument parsing."""
    parser = argparse.ArgumentParser(
        description="Advanced Swap Orchestrator",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s swap_plan.json --proxy-chain socks5h://127.0.0.1:9050
  %(prog)s swap_plan.json --proxy-chain socks5h://127.0.0.1:9050,socks5h://127.0.0.1:1080 --stealth-mode
    (second SOCKS hop only if you fully control that server — never chain untrusted proxies)
  %(prog)s swap_plan.json --proxy-chain socks5h://127.0.0.1:9050 --aggregator-pool custom_endpoints.yaml --quantum-entropy
        """
    )
    
    # Required arguments
    parser.add_argument("plan", help="Path to swap plan JSON file")
    
    # Network configuration
    parser.add_argument("--proxy-chain", required=True, 
                       help="Comma-separated socks5h:// proxy chain (e.g. socks5h://127.0.0.1:9050). "
                            "Tor control is 9051 (system) or 9151 (Tor Browser) — never use those as SOCKS hops.")
    parser.add_argument("--aggregator-pool", 
                       help="YAML file with additional aggregator endpoints")
    
    # Tor control
    parser.add_argument("--ctrl", default="/var/run/tor/control",
                       help="Tor control socket path")
    
    # Security options
    stealth_group = parser.add_mutually_exclusive_group()
    stealth_group.add_argument("--stealth-mode", action="store_true", dest="stealth_mode", default=True,
                               help="Add timing jitter before first request per swap (default: on). "
                                    "NOTE: this only affects request timing, not traffic "
                                    "content, headers, endpoints, or Tor circuit behaviour.")
    stealth_group.add_argument("--no-stealth-mode", action="store_false", dest="stealth_mode",
                               help="Disable stealth mode timing jitter")
    
    parser.add_argument("--phantom-prob", type=float, default=0.0,
                       help="Probability of phantom failure injection (0.0-1.0, default disabled)")
    
    # Operational modes
    parser.add_argument("--dry-run", action="store_true",
                       help="Simulate swaps without actual execution")
    burn_group = parser.add_mutually_exclusive_group()
    burn_group.add_argument("--force-circuit-burn", action="store_true", dest="force_circuit_burn", default=True,
                            help="Force Tor circuit rotation before each swap for per-swap isolation (default: on)")
    burn_group.add_argument("--no-force-circuit-burn", action="store_false", dest="force_circuit_burn",
                            help="Disable forced circuit rotation before each swap")
    # Advanced options
    parser.add_argument("--memory-lock", action="store_true",
                       help="Lock sensitive data in memory (requires privileges)")
    
    
    args = parser.parse_args()
    
    # Validation
    if not Path(args.plan).exists():
        print(f"[!] Swap plan file not found: {args.plan}", file=sys.stderr)
        sys.exit(1)
        
    if not SEED_FILE.exists():
        print(f"[!] Entropy seed file not found: {SEED_FILE}", file=sys.stderr)
        print("    Run entropy_seeder.py first to generate entropy seed", file=sys.stderr)
        sys.exit(1)

    if not str(SEED_FILE.resolve()).startswith("/dev/shm"):
        print("[!] WARNING: entropy_seed.json is on persistent storage.", file=sys.stderr)
        print("    Anyone who seizes this file can reproduce all PRNG-derived", file=sys.stderr)
        print("    timing jitter, endpoint ordering, and header selection.", file=sys.stderr)
        print("    Use 'python3 SML load entropy_seed.json' to keep it RAM-only,", file=sys.stderr)
        print("    or delete it immediately after operations complete.", file=sys.stderr)
        
    import math as _math
    if _math.isnan(args.phantom_prob) or _math.isinf(args.phantom_prob):
        print(f"[!] phantom-prob must be a finite number, got {args.phantom_prob}", file=sys.stderr)
        sys.exit(1)
    if args.phantom_prob < 0.0 or args.phantom_prob > 1.0:
        print(f"[!] phantom-prob must be between 0.0 and 1.0, got {args.phantom_prob}", file=sys.stderr)
        sys.exit(1)
        
        
    # Validate proxy chain using canonical gs_common validation
    for proxy_url in args.proxy_chain.split(','):
        proxy_url = proxy_url.strip()
        _gs_validate_proxy(proxy_url)

    # Verify Tor on the first proxy in the chain
    _first_proxy_url = args.proxy_chain.split(',')[0].strip()
    _first_proxy_dict = {"http": _first_proxy_url, "https": _first_proxy_url}
    _gs_verify_tor(_first_proxy_dict)
    
    # Security warnings
    if not args.stealth_mode:
        print("[!] WARNING: Stealth mode disabled (--no-stealth-mode). Traffic timing patterns may be detectable.")

    if len(args.proxy_chain.split(',')) == 1 and not args.force_circuit_burn:
        print("[!] WARNING: Single-proxy chain with --no-force-circuit-burn means all")
        print("    swap requests in a batch share the same Tor circuit (until periodic")
        print("    burn triggers). Consider re-enabling --force-circuit-burn.")
        
    if args.phantom_prob > 0:
        print(f"[*] Phantom traffic enabled at {args.phantom_prob:.0%} probability.")
    
    # Memory locking (requires root on most systems)
    if args.memory_lock:
        try:
            import ctypes as _ctypes
            _libc = _ctypes.CDLL("libc.so.6", use_errno=True)
            if _libc.mlockall(1 | 2) == 0:
                print("[+] Memory locking enabled")
            else:
                print("[!] Memory locking failed (need root or CAP_IPC_LOCK)")
        except Exception as e:
            print(f"[!] Memory locking failed: {e}")
    
    print("[*] Swap orchestrator starting")
    print(f"    Plan file: {args.plan}")
    print(f"    Proxy chain: {len(args.proxy_chain.split(','))} hops")
    print(f"    Stealth mode: {'enabled' if args.stealth_mode else 'disabled'}")
    
    print(f"    Phantom failure rate: {args.phantom_prob:.2%}")
    print(f"    Dry run: {'yes' if args.dry_run else 'no'}")
    print()
    
    try:
        # Initialize orchestrator
        orchestrator = AdvancedSwapOrchestrator(args)
        
        # Execute swap plan
        success = orchestrator.execute_swap_plan(Path(args.plan))
        
        if success:
            print("\n[+] All swap quotes fetched. Operator must send BTC to complete swaps.")
            sys.exit(0)
        else:
            print("\n[!] Some swap quotes failed - check logs for details")
            sys.exit(1)
            
    except KeyboardInterrupt:
        print("\n[!] Operation interrupted by user")
        sys.exit(130)
    except Exception as e:
        print(f"\n[!] Fatal error: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        # Secure cleanup
        try:
            for var in ['TOR_PASSWORD', 'TOR_CONTROL_PASSWORD',
                        'SWAP_API_KEY', 'PRIVATE_KEY',
                        'GS_WALLET_PASSWORD', 'GS_WALLET_FILE',
                        'COINGECKO_API_KEY']:
                if var in os.environ:
                    del os.environ[var]
                    
            gc.collect()
                
        except Exception as _cleanup_err:
            print(f"[!] Cleanup error (non-fatal): {_cleanup_err}", file=sys.stderr)


if __name__ == "__main__":
    main()
