        try:
            session = requests.Session()
            session.proxies.update(proxy)
            
            query_params = {
                "from_asset": payload.get("from", ""),
                "to_asset": payload.get("to", ""),
                "amount": payload.get("amount", ""),
                "destination": payload.get("destination", ""),
            }
            if payload.get("affiliate"):
                query_params["affiliate"] = payload["affiliate"]
            if payload.get("memo"):
                query_params["memo"] = payload["memo"]
            
            url = f"{endpoint}/thorchain/quote/swap?{urlencode(query_params)}"
            
            response = session.get(
                url,
                headers=headers,
                timeout=30,
                verify=True
            )
            
            response_time = time.time() - start_time
            
            self.traffic_obfuscator.record_request(endpoint, response_time, response.status_code < 400)
            
            response.raise_for_status()
            result = response.json()
            
            if not isinstance(result, dict):
                raise ValueError("Invalid response format")
                
            return result
            
        except Exception as e:
            response_time = time.time() - start_time
            self.traffic_obfuscator.record_request(endpoint, response_time, False)
            raise
            
    def _should_inject_phantom_failure(self, idx: int) -> bool:
