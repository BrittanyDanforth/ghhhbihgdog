            for proxy_url in proxy_string.split(','):
                url = proxy_url.strip()
                if url:
                    proxies.append({'http': url, 'https': url})
        if not proxies:
            print("[!] CRITICAL: No valid proxies in chain — would leak to clearnet.", file=sys.stderr)
            sys.exit(1)
        return proxies
        
    def _build_aggregator_pool(self) -> List[str]:
        """Build aggregator endpoint pool."""
        pool = THOR_APIS.copy()
        
        if hasattr(self.args, 'aggregator_pool') and self.args.aggregator_pool:
            pool_file = Path(self.args.aggregator_pool)
            if pool_file.exists():
                try:
                    additional = yaml.safe_load(pool_file.read_text())
                    if isinstance(additional, list):
                        pool.extend(additional)
                except Exception:
                    pass
                    
        # Shuffle for unpredictability
        self.rng.shuffle(pool)
        return pool
        
    def _load_progress(self) -> Dict[str, Any]:
        """Load progress with integrity verification."""
        default_progress = {
            "schema": "swap_v2_secure",
            "last": -1,
            "log": [],
            "integrity_hash": "",
            "creation_time": time.time()
        }
        
        if not RAM_PROGRESS.exists():
            return default_progress
            
        try:
            progress = json.loads(RAM_PROGRESS.read_text())
            
            # Verify integrity
            if self._verify_progress_integrity(progress):
                return progress
            else:
                self.integrity_chain.add_entry("PROGRESS_CORRUPT", "integrity_check_failed")
                return default_progress
                
        except json.JSONDecodeError:
            print(f"[!] WARNING: Corrupt progress file {RAM_PROGRESS} — starting fresh", file=sys.stderr)
            return default_progress
        except Exception as e:
            print(f"[!] WARNING: Cannot read progress file: {e} — starting fresh", file=sys.stderr)
            return default_progress
            
    def _verify_progress_integrity(self, progress: Dict[str, Any]) -> bool:
        """Verify progress file integrity."""
        if "integrity_hash" not in progress:
            return False
            
        expected_data = json.dumps({
            k: v for k, v in progress.items() 
            if k != "integrity_hash"
        }, sort_keys=True)
        
        expected_hash = hmac.new(
            self.seed_hash.encode(),
            expected_data.encode(),
            hashlib.sha256
        ).hexdigest()
        
        return hmac.compare_digest(expected_hash, progress["integrity_hash"])
        
    def _save_progress(self, progress: Dict[str, Any]):
        """Save progress with integrity protection."""
        # Calculate integrity hash
        progress_data = json.dumps({
            k: v for k, v in progress.items() 
            if k != "integrity_hash"
        }, sort_keys=True)
        
        progress["integrity_hash"] = hmac.new(
            self.seed_hash.encode(),
            progress_data.encode(),
            hashlib.sha256
        ).hexdigest()
        
        # Atomic write with fsync
        temp_file = RAM_PROGRESS.with_suffix('.tmp')
        try:
            with temp_file.open('w') as f:
                json.dump(progress, f, indent=2)
                f.flush()
                os.fsync(f.fileno())
            temp_file.replace(RAM_PROGRESS)
        except Exception:
            if temp_file.exists():
                temp_file.unlink()
                
    def _cleanup_handler(self, signum, frame):
        """Secure cleanup on exit."""
        self.integrity_chain.add_entry("SHUTDOWN", f"signal_{signum}")
        
        # Secure memory cleanup
        if hasattr(self, 'entropy_fusion'):
            self.entropy_fusion.entropy_pool.secure_wipe()
            
        # Clear sensitive variables
        if hasattr(self, 'seed_hash'):
            self.seed_hash = "0" * 64
            
        sys.exit(0)
        
    @retry(
        stop=stop_after_attempt(5),
        wait=wait_exponential_jitter(initial=MIN_BACKOFF, max=MAX_BACKOFF),
        retry=retry_if_exception_type((requests.RequestException, ConnectionError, TimeoutError))
    )
    def _execute_swap_request(self, endpoint: str, payload: Dict[str, Any], proxy: Dict[str, str]) -> Dict[str, Any]:
        """Execute swap quote request via THORNode GET /thorchain/quote/swap."""
        headers = self.traffic_obfuscator.get_stealth_headers()
        
        start_time = time.time()
        
        try:
            session = requests.Session()
            session.proxies.update(proxy)
            
            query_params = {
                "from_asset": payload.get("from", ""),
                "to_asset": payload.get("to", ""),
                "amount": payload.get("amount", ""),
                "destination": payload.get("destination", ""),
            }
            if payload.get("affiliate"):
                query_params["affiliate"] = payload["affiliate"]
            if payload.get("memo"):
                query_params["memo"] = payload["memo"]
            
            url = f"{endpoint}/thorchain/quote/swap?{urlencode(query_params)}"
            
            response = session.get(
                url,
                headers=headers,
                timeout=30,
                verify=True
            )
            
            response_time = time.time() - start_time
            
            self.traffic_obfuscator.record_request(endpoint, response_time, response.status_code < 400)
            
            response.raise_for_status()
            result = response.json()
            
            if not isinstance(result, dict):
                raise ValueError("Invalid response format")
                
            return result
            
        except Exception as e:
            response_time = time.time() - start_time
            self.traffic_obfuscator.record_request(endpoint, response_time, False)
            raise
            
    def _should_inject_phantom_failure(self, idx: int) -> bool:
        """Determine if phantom failure should be injected."""
        if hasattr(self.args, 'phantom_prob') and self.args.phantom_prob > 0:
            return self.rng.random() < self.args.phantom_prob
        return self.rng.random() < PHANTOM_TRAFFIC_PROB
        
    def _execute_single_swap(self, swap_entry: Dict[str, Any]) -> bool:
        """Execute a single swap with full security measures."""
        idx = swap_entry["idx"]
        
        # Check if already processed
        if idx <= self.progress["last"]:
            return True
            
        # Phantom failure injection for traffic analysis resistance.
        # IMPORTANT: Do NOT advance progress["last"] — phantom failures
        # are decoy log entries, not real swap results. Advancing progress
        # would cause this swap index to be silently skipped on resume.
        if self._should_inject_phantom_failure(idx):
            self.integrity_chain.add_entry("PHANTOM_FAIL", f"idx={idx}", {"type": "decoy"})
            self.progress["log"].append({
                "idx": idx,
                "phantom": True,
                "timestamp": time.time()
            })
            self._save_progress(self.progress)
            return True
            
        # Dry run mode
        if hasattr(self.args, 'dry_run') and self.args.dry_run:
            self.integrity_chain.add_entry("DRY_RUN_SUCCESS", f"idx={idx}")
            self.progress["last"] = idx
            self.progress["log"].append({
                "idx": idx,
                "dry_run": True,
                "timestamp": time.time()
            })
            self._save_progress(self.progress)
            return True
            
        # Prepare swap payload
        payload = {
            "from": swap_entry["from"],
            "to": swap_entry["to"],
            "amount": str(swap_entry["amount"]),
            "destination": swap_entry["destination"]
        }
        
        # Add optional fields
        if "memo" in swap_entry:
            payload["memo"] = swap_entry["memo"]
        if "affiliate" in swap_entry:
            payload["affiliate"] = swap_entry["affiliate"]
            
        # Force circuit burn before every swap if requested
        if getattr(self.args, 'force_circuit_burn', False):
            if self.circuit_burn.burn_circuit():
                self.integrity_chain.add_entry("FORCED_CIRCUIT_BURN", f"idx={idx}")

        # Execute swap with retry logic
        success = False
        last_error = None
        error_count = 0
        
        for attempt in range(1, 6):  # Max 5 attempts
            # Select endpoint and proxy
            endpoint = self.rng.choice(self.aggregator_pool)
            proxy = self.rng.choice(self.proxy_chain)
            
            try:
                # Anti-correlation timing delay (always in stealth mode, only after first attempt otherwise)
                if attempt > 1 or getattr(self.args, 'stealth_mode', False):
                    delay = self.traffic_obfuscator.calculate_timing_delay()
                    time.sleep(delay)
                    
                # Execute request
                result = self._execute_swap_request(endpoint, payload, proxy)
                
                # Validate successful response
                if result.get("expected_amount_out") or result.get("transaction_id"):
                    self.integrity_chain.add_entry(
                        "SWAP_SUCCESS", 
                        f"idx={idx}|endpoint={endpoint}|attempt={attempt}",
                        {"result_hash": hashlib.sha256(json.dumps(result, sort_keys=True).encode()).hexdigest()[:16]}
                    )
                    success = True
                    self.success_count += 1
                    break
                else:
                    raise ValueError("Invalid swap response")
                    
            except Exception as e:
                error_count += 1
                last_error = str(e)
                
                self.integrity_chain.add_entry(
                    "SWAP_ATTEMPT_FAIL",
                    f"idx={idx}|endpoint={endpoint}|attempt={attempt}",
                    {"error": str(e)[:100]}
                )
                
                # Circuit burn decision
                if self.circuit_burn.should_burn_circuit(error_count, 0):
                    if self.circuit_burn.burn_circuit():
                        self.integrity_chain.add_entry("CIRCUIT_BURN", f"idx={idx}|attempt={attempt}")
                        
        # Final result handling
        if not success:
            self.failure_count += 1
            self.integrity_chain.add_entry(
                "SWAP_FINAL_FAIL",
                f"idx={idx}|attempts=5",
                {"last_error": str(last_error)[:100] if last_error else "unknown"}
            )
            
        # Only advance progress["last"] on success — failed swaps must be
        # retried on the next run, not silently skipped.
        if success:
            self.progress["last"] = idx
        self.progress["log"].append({
            "idx": idx,
            "success": success,
            "attempts": attempt,
            "timestamp": time.time(),
            "error_count": error_count
        })
        self._save_progress(self.progress)

        return success
        
