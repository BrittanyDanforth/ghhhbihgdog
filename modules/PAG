class MemoryScrambler:
    """Secure memory handling with anti-forensics."""
    
    def __init__(self):
        self._sensitive = []
        self._lock_memory()
    
    def _lock_memory(self):
        """Lock memory pages to prevent swapping and disable core dumps."""
        try:
            import resource
            resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        except (ImportError, ValueError, OSError):
            pass
        try:
            import resource
            resource.setrlimit(resource.RLIMIT_MEMLOCK, 
                             (resource.RLIM_INFINITY, resource.RLIM_INFINITY))
            
            libc = ctypes.CDLL("libc.so.6")
            MCL_CURRENT = 1
            MCL_FUTURE = 2
            libc.mlockall(MCL_CURRENT | MCL_FUTURE)
        except (OSError, AttributeError):
            pass
    
    def register(self, data: Any):
        """Register sensitive data for cleanup."""
        self._sensitive.append(data)
    
    def scramble(self):
        """Overwrite all sensitive data."""
        for item in self._sensitive:
            try:
                if isinstance(item, (bytes, bytearray)):
                    for i in range(len(item)):
                        item[i] = secrets.randbits(8)
                elif isinstance(item, dict):
                    for k in list(item.keys()):
                        item[k] = None
                        del item[k]
                elif isinstance(item, list):
                    item.clear()
            except (TypeError, AttributeError):
                pass
        
        self._sensitive.clear()
        gc.collect()

# Global memory handler
mem_guard = MemoryScrambler()

class EntropyMixer:
    """Advanced entropy mixing from multiple sources."""
    
    def __init__(self):
        self.pool = bytearray(8192)
        self.position = 0
        self._init_pool()
    
    def _init_pool(self):
        """Initialize with maximum entropy."""
        sources = []
        
        # Hardware RNG
        try:
            with open('/dev/hwrng', 'rb') as f:
                sources.append(f.read(1024))
        except (OSError, PermissionError):
            pass
        
        # Timing jitter
        jitter = []
        for _ in range(200):
            start = time.perf_counter_ns()
            _ = hashlib.sha3_512(os.urandom(32)).digest()
            end = time.perf_counter_ns()
            jitter.append(struct.pack('<Q', end - start))
        sources.append(b''.join(jitter))
        
        # Process entropy
        try:
            proc_data = []
            for pid in os.listdir('/proc'):
                if pid.isdigit():
                    proc_data.append(pid.encode())
            sources.append(b''.join(proc_data[:100]))
        except (OSError, PermissionError):
            pass
        
        # System entropy
        sources.append(os.urandom(2048))
        
        # Mix all sources
        combined = b''.join(sources)
        
        # Multi-round mixing
        state = hashlib.sha3_512(combined).digest()
        for i in range(10):
            state = hashlib.sha3_512(state + struct.pack('<I', i)).digest()
            
        # Fill pool
        for i in range(0, len(self.pool), 64):
            chunk = hashlib.sha3_512(state + struct.pack('<I', i)).digest()
            self.pool[i:i+64] = chunk[:min(64, len(self.pool)-i)]
        
        # Final scramble
        for i in range(len(self.pool)):
            self.pool[i] ^= secrets.randbits(8)
    
    def get_bytes(self, n: int) -> bytes:
        """Extract n bytes with forward secrecy."""
        result = bytearray(n)
        
        for i in range(n):
            # Extract byte
            result[i] = self.pool[self.position]
            
            # Update pool (forward secrecy)
            self.pool[self.position] ^= secrets.randbits(8)
            
            # Advance position
            self.position = (self.position + 1) % len(self.pool)
            
            # Periodic remixing
            if self.position == 0:
                self._remix()
        
        return bytes(result)
    
    def _remix(self):
        """Remix entire pool."""
        new_entropy = os.urandom(64)
        state = hashlib.sha3_512(bytes(self.pool) + new_entropy).digest()
        
        for i in range(0, len(self.pool), 64):
            self.pool[i:i+64] = state[:min(64, len(self.pool)-i)]
            state = hashlib.sha3_512(state).digest()

# Global entropy mixer
entropy = EntropyMixer()

class PolymorphicGenerator:
    """Generates unique DAG structures that change behavior each run."""
    
    def __init__(self):
        self.mutation_seed = secrets.randbits(128)
        self.strategies = self._build_strategies()
        self.obfuscation_level = secrets.randbelow(5) + 1
    
    def _build_strategies(self) -> List[Callable]:
        """Build randomized generation strategies."""
        # Each strategy produces different graph characteristics
        strategies = []
        
        # Strategy 1: Deep narrow paths
        def deep_narrow(rng, amount):
            depth = rng.randint(4, 8)
            fanout = lambda: rng.randint(1, 2)
            decoy_prob = 0.2
            return self._make_graph(rng, amount, depth, fanout, decoy_prob)
        
        # Strategy 2: Wide shallow tree
        def wide_shallow(rng, amount):
            depth = rng.randint(2, 4)
            fanout = lambda: rng.randint(3, 6)
            decoy_prob = 0.4
            return self._make_graph(rng, amount, depth, fanout, decoy_prob)
        
        # Strategy 3: Irregular structure
        def irregular(rng, amount):
            depth = rng.randint(3, 6)
            fanout = lambda: rng.choice([1, 1, 2, 2, 2, 3, 4, 5])
            decoy_prob = rng.uniform(0.1, 0.5)
            return self._make_graph(rng, amount, depth, fanout, decoy_prob)
        
        # Strategy 4: Fibonacci-like branching
        def fibonacci_branch(rng, amount):
            depth = rng.randint(3, 5)
            fib = [1, 1, 2, 3, 5]
            fanout = lambda: rng.choice(fib)
            decoy_prob = 0.3
            return self._make_graph(rng, amount, depth, fanout, decoy_prob)
        
        # Strategy 5: Chaotic
        def chaotic(rng, amount):
            depth = secrets.randbelow(6) + 2
            fanout = lambda: secrets.randbelow(5) + 1
            decoy_prob = secrets.randbelow(100) / 100.0
            return self._make_graph(rng, amount, depth, fanout, decoy_prob)
        
        strategies.extend([deep_narrow, wide_shallow, irregular, 
                          fibonacci_branch, chaotic])
        
        # Shuffle strategies using CSPRNG (not global random)
        secrets.SystemRandom().shuffle(strategies)
        
        return strategies
    
    def _make_graph(self, rng, amount, max_depth, fanout_func, decoy_prob):
        """Core graph generation with configurable parameters."""
        nodes = []
        edges = []
        
        # Node ID generation with obfuscation
        if self.obfuscation_level > 3:
            # Use random IDs
            def make_id():
                return f"x{secrets.token_hex(4)}"
        else:
            # Sequential with prefix
            counter = [0]
            prefix = rng.choice(['n', 'v', 't', 'x'])
            def make_id():
                counter[0] += 1
                return f"{prefix}{counter[0]}"
        
        # Create root
        root_id = make_id()
        nodes.append({
            "id": root_id,
            "type": "root",
            "amount": round(amount, 8),
            "_depth": 0
        })
        
        # Build tree
        frontier = [(root_id, amount, 0)]
        
        while frontier:
            parent_id, parent_amt, depth = frontier.pop(0)
            
            if depth >= max_depth:
                continue
            
            # Determine fanout
            fan = fanout_func()
            
            # Amount distribution with various strategies
            dist_strategy = rng.randint(0, 3)
            
            if dist_strategy == 0:
                # Even split with noise
                amounts = []
                base = parent_amt / fan
                for _ in range(fan):
                    noise = rng.uniform(0.8, 1.2)
                    amounts.append(base * noise)
            elif dist_strategy == 1:
                # Power law distribution
                amounts = []
                remaining = parent_amt
                for i in range(fan - 1):
                    take = remaining * rng.uniform(0.3, 0.7)
                    amounts.append(take)
                    remaining -= take
                amounts.append(remaining)
                rng.shuffle(amounts)
            elif dist_strategy == 2:
                # Random proportions
                proportions = [rng.random() for _ in range(fan)]
                total = sum(proportions)
                amounts = [(p/total) * parent_amt for p in proportions]
            else:
                # Fibonacci-weighted
                weights = [1, 1, 2, 3, 5, 8][:fan]
                if len(weights) < fan:
                    weights.extend([rng.randint(1, 10) for _ in range(fan - len(weights))])
                total = sum(weights)
                amounts = [(w/total) * parent_amt for w in weights]
            
            # Create child nodes
            children = []
            for i, child_amt in enumerate(amounts):
                child_amt = max(0.00000001, round(child_amt, 8))
                child_id = make_id()
                
                # Node types compatible with labelmask validator:
                # "root", "real", "decoy" (see labelmask validate_dag_structure)
                if rng.random() < 0.15:
                    node_type = "decoy"
                else:
                    node_type = "real"
                
                nodes.append({
                    "id": child_id,
                    "type": node_type,
                    "amount": child_amt,
                    "_depth": depth + 1
                })
                
                edges.append([parent_id, child_id])
                children.append((child_id, child_amt))
            
            # Add decoy nodes
            if rng.random() < decoy_prob:
                num_decoys = rng.randint(1, 3)
                for _ in range(num_decoys):
                    decoy_id = make_id()
                    decoy_amt = round(rng.uniform(0.00000001, 0.001), 8)
                    
                    nodes.append({
                        "id": decoy_id,
                        "type": "decoy",
                        "amount": decoy_amt,
                        "_depth": depth + 1,
                        "decoy_class": rng.choice(["dust", "bait", "noise"])
                    })
                    
                    edges.append([parent_id, decoy_id])
            
            # Add children to frontier
            for child_id, child_amt in children:
                if rng.random() < 0.8:  # 20% chance to prune branch
                    frontier.append((child_id, child_amt, depth + 1))
        
        # Post-processing
        if self.obfuscation_level > 2:
            # Add phantom edges (non-tree edges) — only from earlier to later
            # nodes in the list to preserve DAG acyclicity.
            num_phantom = rng.randint(0, max(1, len(edges) // 10))
            node_order = {n['id']: i for i, n in enumerate(nodes)}
            for _ in range(num_phantom):
                if len(nodes) > 2:
                    i1 = rng.randint(1, len(nodes) - 1)
                    i2 = rng.randint(1, len(nodes) - 1)
                    if i1 < i2:
                        edges.append([nodes[i1]['id'], nodes[i2]['id']])
        
        # Clean internal data
        for node in nodes:
            node.pop('_depth', None)
        
        return {"nodes": nodes, "edges": edges}
    
    def generate(self, rng, amount) -> dict:
        """Generate a unique DAG using selected strategy."""
        # Pick strategy based on entropy
        strategy_idx = int.from_bytes(entropy.get_bytes(1), 'big') % len(self.strategies)
        strategy = self.strategies[strategy_idx]
        
        # Generate graph
        graph = strategy(rng, amount)
        
        # Add metadata
        graph['metadata'] = {
            'strategy': strategy_idx,
            'obfuscation': self.obfuscation_level,
            'mutation': hex(self.mutation_seed)[2:10]
        }
        
        return graph

class StealthWriter:
    """Secure file writing with anti-forensics."""
    
    @staticmethod
    def write_atomic(path: Path, data: bytes):
        """Write file atomically with security measures."""
        # Generate temp name
        temp_path = path.parent / f".{secrets.token_hex(8)}.tmp"
        
        try:
            # Write with sync
            fd = os.open(str(temp_path), 
                        os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                        0o600)
            try:
                os.write(fd, data)
                os.fsync(fd)
            finally:
                os.close(fd)
            
            # Atomic rename
            temp_path.rename(path)
            
            # Anti-forensics
            if PARANOID_MODE:
                # Scramble timestamps
                random_time = time.time() - secrets.randbelow(86400 * 30)
                os.utime(path, (random_time, random_time))
                
                # Clear filesystem caches
                try:
                    subprocess.run(['sync'], capture_output=True)
                    with open('/proc/sys/vm/drop_caches', 'w') as f:
                        f.write('3')
                except (OSError, PermissionError, FileNotFoundError):
                    pass
            
        except Exception as e:
            if temp_path.exists():
                # Secure cleanup
                try:
                    with open(temp_path, 'rb+') as f:
                        size = f.seek(0, 2)
                        f.seek(0)
                        f.write(secrets.token_bytes(size))
                    temp_path.unlink()
                except OSError:
                    pass
            raise

def load_seed_secure(seed_path: Path) -> Tuple[dict, str]:
    """Load seed file with verification."""
    if not seed_path.exists():
        # Generate fake error to avoid leaking info
        fake_paths = [
            "/tmp/.store", "~/.config/data.json", 
            "/var/cache/app/config", "./config.dat"
        ]
        fake_path = secrets.choice(fake_paths)
        print(f"[!] Configuration error: {fake_path}", file=sys.stderr)
        sys.exit(1)
    
    # Read and verify
    raw = seed_path.read_bytes()
    
    # Check size limits
    if len(raw) > 1024 * 1024:  # 1MB max
        print("[!] Invalid configuration", file=sys.stderr)
        sys.exit(1)
    
    # Parse
    try:
        bundle = json.loads(raw)
    except json.JSONDecodeError:
        print("[!] Corrupted data", file=sys.stderr)
        sys.exit(1)
    
    # Register for cleanup
    mem_guard.register(raw)
    mem_guard.register(bundle)
    
    return bundle, hashlib.sha256(raw).hexdigest()

def generate_dag(args):
    """Main DAG generation with full security."""
    # Load seed
    seed_bundle, seed_hash = load_seed_secure(args.seed)
    
    # Initialize RNG with mixed entropy
    seed_bytes = bytes.fromhex(seed_hash)
    mixed_seed = hashlib.sha3_512(seed_bytes + entropy.get_bytes(64)).digest()
    rng_seed = int.from_bytes(mixed_seed[:8], 'big')
    rng = random.Random(rng_seed)
    
    # Create generator
    generator = PolymorphicGenerator()
    
    # Generate graph
    graph = generator.generate(rng, args.amount)
    
    # Build output structure
    output = {
        "version": "3.0-poly",
        "timestamp": "redacted",
        "seed_ref": {
            "sha256": seed_hash
        },
        "graph": graph
    }
    
    # Add integrity hash
    temp_data = json.dumps(output, sort_keys=True).encode()
    output["integrity"] = hashlib.sha3_256(temp_data).hexdigest()
    
    # Final JSON
    final_data = json.dumps(output, indent=2, sort_keys=True).encode()
    
    # Secure write
    StealthWriter.write_atomic(args.out, final_data)
    
    # Cleanup sensitive data
    mem_guard.scramble()
    
    return len(graph['nodes']), len(graph['edges'])

def main():
    parser = argparse.ArgumentParser(description="Generate polymorphic DAG structure")
    parser.add_argument("--seed", "-s", type=Path, 
                       default=_TOOLKIT_ROOT / "entropy_seed.json")
    parser.add_argument("--out", "-o", type=Path, 
                       default=_TOOLKIT_ROOT / "dag_structure.json")
    parser.add_argument("--amount", "-a", type=float, 
                       default=1.0)
    
    args = parser.parse_args()
    
    try:
        # Generate DAG
        nodes, edges = generate_dag(args)
        
        if not STEALTH_MODE:
            print(f"[+] Generated: {nodes} nodes, {edges} edges → {args.out}")
        
        if PARANOID_MODE:
            if not STEALTH_MODE:
                print("[!] PARANOID_MODE: log/history cleanup is the operator's responsibility.")
                print("[!] Consider: history -c && history -w, and review /var/log manually.")
        
    except KeyboardInterrupt:
        mem_guard.scramble()
        sys.exit(0)
    except Exception as e:
        mem_guard.scramble()
        if not STEALTH_MODE:
            print(f"[!] Error: {e}", file=sys.stderr)
        else:
            # Generic error
            print("[!] Operation failed", file=sys.stderr)
        sys.exit(1)
    finally:
        # Final cleanup
        mem_guard.scramble()
        entropy.pool = bytearray(len(entropy.pool))  # Clear entropy pool

if __name__ == "__main__":
    main()
