DUST_XMR = Decimal("0.0001")

#: One piconero, the smallest amount Monero represents. Used to put a gate
#: strictly ABOVE a computed quantity rather than merely at it.
PICONERO = Decimal("0.000000000001")

# How many fee-widths to hold back per remaining peel when sizing what a peel
# forwards to the next rotating carrier. See the reserve comment in the peel
# planner: under-reserving strands funds mid-chain, over-reserving only
# shrinks the final distribution slightly.
#: Per-hop headroom a peel carrier must keep, as a multiple of the daemon's
#: priority-1 fee estimate. MEASURED against monerod/monero-wallet-rpc 0.18.3.1
#: on a chain running CURRENT consensus, not guessed.
#:
#: What a peel actually needs left over is its own real fee, and the real fee
#: grows with the number of INPUTS being spent. With get_fee_estimate reporting
#: 0.0024 XMR, a 2-destination transfer_split measured:
#:
#:     inputs   real fee      x estimate   minimum headroom
#:        1     0.0026328        1.10          1.1x
#:        2     0.0034236        1.43          1.5x
#:        4     0.0050052        2.09          2.5x
#:        8     0.0082176        3.42          4x
#:       16     0.0147360        6.14         10x
#:
#: A peel carrier is paid by exactly one previous peel, so it holds ONE output
#: and lands in the top row: ~1.25x. 8 (x FEE_SAFETY_MARGIN = 12x the estimate)
#: clears even the 16-input row, which only the first hop out of ENTRY could
#: ever approach, and leaves room for the fee drifting upward between the
#: single estimate taken at stage 0 and a peel relayed hours later.
#:
#: TRAP, and the reason this constant has been wrong twice: measure it on a
#: chain that is actually running current consensus. `monerod --regtest` is
#: hard fork v16 (RingCT, ring 16, current fee rules) from height 1.
#: `monerod --testnet --offline` is NOT -- a fresh chain there sits at hard
#: fork v1, PRE-RingCT, where the next fork is height 624634 and outputs are
#: digit-denominated into powers of ten. Under those rules the same 2-
#: destination peel appears to need ~82x the estimate as an ABSOLUTE reserve
#: (~0.16-0.20 XMR regardless of input size). That number is an artifact of
#: denomination bloat and does not exist on mainnet; it is what previously
#: pushed this constant to 100, i.e. ~90x more than needed. Over-reserving is
#: not free: it inflates peel_entry_requirement, which forces the stage-4
#: shrink-to-fit loop to cut the distribution and leave the difference sitting
#: unmixed on ENTRY.
#:
#: (It was also 1 and then 4 at earlier points, both from treating a stranded
#: chain as a fee shortfall. 1 was in fact adequate under real consensus --
#: 1 x 1.5 = 1.5x clears the 1-input requirement -- so those "fixes" were
#: chasing a testnet ghost too.)
PEEL_CARRIER_RESERVE_MULT = Decimal("8")


# Single source of truth for the fee safety margin. It was written inline as
# Decimal("1.5") in the stage-4 fee budget, in compute_hop_amount, and in the
# operator-facing message that reports the reserve -- three copies that could
# drift, so a changed margin would have made the printed number a lie.
FEE_SAFETY_MARGIN = Decimal("1.5")


# Default per-TX broadcast delay, in seconds: 3 to 12 minutes. Written inline
# as `randbelow(540) + 180` in four separate places, which is the same
# single-source-of-truth problem FEE_SAFETY_MARGIN was pulled out for.
DEFAULT_HOP_DELAY = (180, 720)

#: Refuse a delay range longer than this. broadcast_signed_xmr caps a
#: manifest-supplied delay at 7 days, so anything past that would be silently
#: clamped there instead of doing what the operator asked.
HOP_DELAY_MAX = 7 * 24 * 3600


def parse_hop_delay(spec, default=DEFAULT_HOP_DELAY) -> tuple:
    """Parse a "MIN-MAX" (or "N") seconds spec into an inclusive range.

    Raises ValueError with an operator-readable message; the caller turns that
    into an exit. Deliberately strict: a delay silently misread as 0 turns a
    peel chain into a burst of transactions minutes apart, which is the shape
    the delay exists to avoid.
    """
    if spec is None or spec == "":
        return default
    txt = str(spec).strip()
    parts = txt.split("-", 1)
    try:
        lo = int(parts[0])
        hi = int(parts[1]) if len(parts) == 2 else lo
    except ValueError:
        raise ValueError(f"--hop-delay must be SECONDS or MIN-MAX seconds, "
                         f"got {spec!r}")
    if lo < 0 or hi < 0:
        raise ValueError("--hop-delay cannot be negative")
    if hi < lo:
        raise ValueError(f"--hop-delay MIN-MAX is backwards: {lo} > {hi}")
    if hi > HOP_DELAY_MAX:
        raise ValueError(f"--hop-delay above {HOP_DELAY_MAX}s (7 days) would be "
                         f"clamped by the broadcaster anyway; got {hi}s")
    return (lo, hi)


def hop_delay(window=None) -> int:
    """A jittered per-TX broadcast delay in seconds, from `window`.

    HOW LONG THIS IS, IS AN OPSEC PARAMETER, and the default is not a strong
    one. A peel hop cannot be built until the previous hop's output has
    confirmed and unlocked, which is ~10 blocks, and this delay is added on
    top -- so with the default 3-12 minutes each carrier output is spent at
    roughly 11-16 blocks of age and the whole chain finishes inside two hours.

    That is close to the youngest an output can legally be spent. Monero's
    decoy selection draws ring members from a distribution fitted to how
    people actually spend, whose bulk sits far above that floor, so an output
    spent at the floor tends to be the youngest member of its own ring -- and
    "assume the newest ring member is the real one" is a standard heuristic
    against exactly this shape. The peel chain removes the co-created fan-out
    an analyst can cluster; it does not remove that.

    This has NOT been measured here. Doing it honestly needs a chain with a
    realistic output-age distribution, and a throwaway regtest chain has none
    -- every output on it is minutes old, so any ring-age statistic it
    produced would be an artifact. It is stated as a known limitation rather
    than quantified.

    What follows from it is that the operator should be able to choose:
    --hop-delay 21600-86400 spreads a six-hop chain over days, which costs
    time and buys ring-age plausibility. The default stays short because a
    multi-day default would strand operators who close the laptop.
    """
    lo, hi = window or DEFAULT_HOP_DELAY
    # secrets.randbelow, NOT SystemRandom().randbelow. randbelow is a MODULE
    # function; SystemRandom has no such method and the call raises
    # AttributeError. This took no rng parameter for exactly that reason --
    # every caller wants the same CSPRNG, and offering the choice is what let
    # `secrets.SystemRandom().randbelow(540)` sit in the change sweep from the
    # commit that introduced it, raising on every sweep it ever built.
    return lo if hi <= lo else lo + secrets.randbelow(hi - lo)


# Fraction of the post-fee balance the fan-out distributes. The remainder stays
# on ENTRY as headroom for the fan-out transaction's own fee. Verified fundable:
# across every balance/wallet/depth combination that clears the dust guards the
# tightest observed remainder was ~0.0245 XMR against a real 0.0024 XMR fee.
FANOUT_SPEND_FRACTION = Decimal("0.9")

# How many fee-widths the fan-out holds back for the real fee. Anything the
# fan-out does not allocate becomes monerod's change, and monerod's change goes
# to the account's subaddress 0 -- the wallet's identity address -- so this
# buffer is the ONLY thing that lands there and it must be sized against the
# fee, not against the balance. Kept tighter than the peel chain's carrier
# reserve on purpose: a fan-out is one transaction, so an under-sized buffer
# fails before anything moves, while an under-sized peel reserve strands funds
# mid-chain.
FANOUT_FEE_BUFFER_MULT = Decimal("3")
BTC_RE = re.compile(r"^(bc1|tb1)[ac-hj-np-z02-9]{25,59}$", re.I)
SWAPKIT_API = "https://api.swapkit.dev"

MIN_WALLETS = 3
MIN_DEEP = 1
# Extra mix outputs beyond `wallets`, chosen RANDOMLY per run within this range.
# A fixed count (the old NUM_DECOYS = 4) makes the total output count a
