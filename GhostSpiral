def fetch_fee_from_daemon(daemon_url, proxies, fee_priority: int = 1,
                          allow_fallback: bool = False) -> Decimal:
    """Estimate per-TX fee in XMR from monerod's get_fee_estimate.

    get_fee_estimate is a DAEMON json_rpc method -- the wallet-rpc (:18083) does
    NOT expose it, so the original version that queried rpc_primary always threw
    and silently used the constant every run. Query the daemon (args.rpc_daemon,
    :18081) instead. Prefer monerod's explicit per-priority 'fees' array (the
    exact per-byte fee transfer_split will charge at this priority); only if the
    daemon doesn't return it fall back to base-fee x PRIORITY_FEE_MULTIPLIER,
    then to FALLBACK_FEE_XMR. Scaled by a ~2kB typical TX size throughout."""
    multiplier = Decimal(PRIORITY_FEE_MULTIPLIER.get(fee_priority, 1))
    est = daemon_fee_estimate(daemon_url, proxies)
    fees = est.get("fees")
    # Exact path: monerod's per-priority array, indexed by priority (1-based).
    if isinstance(fees, list) and len(fees) >= fee_priority and fees[fee_priority - 1] > 0:
        fee_xmr = Decimal(int(fees[fee_priority - 1]) * 2000) / Decimal(10 ** 12)
        if fee_xmr > 0:
            _reject_implausible_fee(fee_xmr, daemon_url, "per_priority_array")
            integrity_log("fee", "daemon_fee:per_priority_array")
            return fee_xmr
    # Approximate path: older daemon with only a base 'fee'.
    base = est.get("fee", 0) or 0
    if base > 0:
        fee_xmr = (Decimal(int(base) * 2000) / Decimal(10 ** 12)) * multiplier
        if fee_xmr > 0:
            _reject_implausible_fee(fee_xmr, daemon_url, "base_times_multiplier")
            integrity_log("fee", "daemon_fee:base_times_multiplier")
            return fee_xmr
    # NEVER SILENTLY. Reaching here means the daemon gave us nothing usable --
    # unreachable, wrong --rpc-daemon, a non-localhost daemon with no proxies,
    # a timeout, or a reply with neither `fees` nor `fee`. Every one of those
    # returned {} from daemon_fee_estimate, which swallows the reason.
    #
    # This used to return a guess and log "using_fallback_fee" to the chain,
    # while stage0_preflight logged "fee_fetched" -- a line that reads as
    # success either way -- and printed NOTHING to the terminal. The guess was
    # 38-58x below the real fee, so every hop under-reserved and the run failed
    # on a later hop with "not enough money", after the fan-out had already
    # executed on-chain.
    #
    # _reject_implausible_fee, thirty lines down, already refuses a fee that is
    # too HIGH, with the argument that "sizing a spending plan around a bogus
    # fee is worse than refusing ... which the operator must fix, not have
    # papered over". A fee we never obtained is the same case, and it was the
    # only one of the two that proceeded quietly. The asymmetry was the defect.
    fee_xmr = FALLBACK_FEE_BY_PRIORITY.get(fee_priority,
                                           FALLBACK_FEE_XMR * multiplier)
    integrity_log("fee", "using_fallback_fee")
    if not allow_fallback:
        sys.exit(
            f"[!] Could not get a fee estimate from the daemon at {daemon_url}.\n"
            f"    Every amount this run plans is sized against the fee: the "
            f"fan-out floor, whether\n"
            f"    each hop is fundable, and how much of your balance is "
            f"spendable at all. Guessing\n"
            f"    it wrong LOW is not a smaller error than guessing it high — "
            f"the plan passes every\n"
            f"    check and then a later hop fails with 'not enough money', "
            f"after the fan-out has\n"
            f"    already executed on-chain and split your funds across "
            f"subaddresses.\n"
            f"\n"
            f"    Check, in this order:\n"
            f"      * monerod is running and SYNCED, and --rpc-daemon points at "
            f"its RPC port\n"
            f"        (mainnet :18081 — NOT the wallet-rpc on :18083, which "
            f"does not serve\n"
            f"        get_fee_estimate at all)\n"
            f"      * a REMOTE daemon is reachable through --tor-proxy (a "
            f"non-localhost daemon\n"
            f"        with no proxy is refused rather than queried over "
            f"clearnet)\n"
            f"      * the daemon answers: "
            f"curl {daemon_url}/json_rpc -d "
            f"'{{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"get_fee_estimate\"}}'\n"
            f"\n"
            f"    To proceed anyway with the built-in estimate for priority "
            f"{fee_priority}\n"
            f"    ({fee_xmr} XMR per transaction, from a measured mainnet "
            f"daemon), pass\n"
            f"    --accept-fallback-fee. It is a real figure, but it is not "
            f"YOUR daemon's, and\n"
            f"    the mempool moves.")
    print(f"  [!] No fee estimate from the daemon at {daemon_url} — using the "
          f"built-in figure for priority {fee_priority}: {fee_xmr} XMR per "
          f"transaction.")
    print(f"      --accept-fallback-fee was given, so this is not an abort. It "
          f"is a measured mainnet")
    print(f"      value, not your daemon's, and every hop is sized against it.")
    return fee_xmr


def _reject_implausible_fee(fee_xmr: Decimal, daemon_url, source: str) -> None:
    """Abort if the daemon's fee is too high to be real (fresh/offline chain).

    Sizing a spending plan around a bogus fee is worse than refusing: it either
    misreports the operator's balance as insufficient or shrinks every hop to
    nothing. A daemon reporting a real fee is never near FEE_IMPLAUSIBLE_XMR, so
    this only fires on a misconfigured daemon -- which the operator must fix,
    not have papered over."""
    if fee_xmr <= FEE_IMPLAUSIBLE_XMR:
        return
    # Record only WHICH path saw it, not the number: keep amounts off the
    # persistent chain uniformly. The operator sees the value in the abort below.
    integrity_log("fee", f"IMPLAUSIBLE_daemon_fee:{source}")
    sys.exit(
        f"[!] The daemon reports an impossible fee of {fee_xmr} XMR PER TRANSACTION\n"
        f"    ({source}). A real Monero fee is a small fraction of an XMR even at the\n"
        f"    highest priority; a value this large means the daemon at {daemon_url}\n"
        f"    is FRESH, --offline, or not yet synced and is returning its maximum\n"
        f"    default fee.\n"
        f"    Refusing to size a spending plan around it — that would misreport your\n"
        f"    balance as insufficient. Point --rpc-daemon at a synced monerod\n"
        f"    (mainnet :18081) and re-run."
    )


def compute_hop_amount(fanout_amt: Decimal, fee_xmr: Decimal) -> Decimal:
    """How much a mix subaddress can hop onward, after reserving the fee.

    Extracted from stage 4 so tests drive the REAL formula instead of a copy --
    a modelled formula in a test cannot catch a regression in the shipped one.

    Reserves the ACTUAL FEE, not a percentage. The old formula was
    `fanout_amt * 0.85`, and its comment claimed the 15% remainder "covers the
    fee (tiny next to fanout_amt)". That inverts for small fan-outs: the fee is
    an ABSOLUTE amount while a percentage reserve shrinks with the hop. With a
    real daemon fee of ~0.0024 XMR, every fanout_amt below ~0.016 XMR reserved
    LESS than the fee -- the plan cleared the dust guard, then transfer_split
    failed "not enough money" AFTER the fan-out had already executed on-chain,
    leaving funds scattered mid-pipeline.

    Uses FEE_SAFETY_MARGIN (shared with the stage-4 fee budget), and ROUND_DOWN
    so quantising can never round the hop UP past what the output actually
    holds. The caller compares the result against DUST_XMR and skips the DAG
    round when it is not fundable.
    """
    return (fanout_amt - hop_fee_reserve(fee_xmr)).quantize(
        DUST_XMR, rounding=ROUND_DOWN)


class RelayGateAbort(SystemExit):
    """A Tor gate stopped the run. NOT a transaction that failed to build.

    Both arrive as SystemExit, and the loops that relay several transactions
    catch SystemExit so one bad round does not strand the rest. That catch
    swallowed the gates: _run_exit_withdrawals reproduced it with three funded
    outputs and a real leak -- the operator got three "FAILED ... funds are
    still on this wallet" lines, the words Tor and leak appeared nowhere, and
    the loop re-ran the same failing gate on every remaining output. A retry is
    the one response a live deanonymising leak must not get.

    A distinct type so those loops can re-raise the gate and keep catching the
    round. _run_exit_withdrawals tracked it with a local flag instead, which
    worked and did not travel: the change-sweep loop has the same shape and had
    no such flag -- and no gates either, which is what this pass fixes.
    """


def relay_gates(args, proxy, stage: str) -> None:
    """Rotate the circuit or STOP; re-verify Tor or STOP. Before EVERY relay.

    ONE HELPER, because the pair was written out at each relay site and two
    sites did not have it. Audited by walking every _run_round call in this
    file:

        entry veil      newnym(required=True) + tor_recheck   OK
        peel i          newnym(required=True) + tor_recheck   OK
        fan-out         NOTHING
        DAG round       tor_recheck only, and the newnym sat above a wait
                        that can last an hour
        change sweep    NOTHING
        exit output     newnym(required=True) + tor_recheck   OK

    The two bare ones are not minor rounds. The FAN-OUT is the single
    transaction that creates every mix output the run has, and it relays after
    the entry veil's carrier wait -- up to an hour with no gate in between. The
    CHANGE SWEEP moves the one output the distribution could not allocate: its
    input is the transaction that spent the swapped funds, so it is the relay
    that most directly links "the spend of my swap" to a fresh address, and
    with --split N there is one per chunk relaying back to back.

    What they did still have is the best-effort newnym inside _run_round_body,
    which prints on failure and carries on. That is a rotation ATTEMPT, not the
    gate: required=True is what turns "the circuit could not be rotated" into a
    stop instead of a warning, and tor_recheck is the only thing that asks
    whether this is still a real Tor exit at all.

    Raises RelayGateAbort (a SystemExit) rather than plain SystemExit so a
    relay loop can tell a leak from a failed transaction. The message is the
    gate's own -- newnym and tor_recheck already say exactly what happened.
    """
    try:
        newnym(required=True, proxy_url=getattr(args, "tor_proxy", ""))
        tor_recheck(proxy, stage)
    except RelayGateAbort:
        raise
    except SystemExit as e:
        raise RelayGateAbort(str(e) or f"Tor gate failed before {stage}")


def _tool(name: str) -> str:
    """Absolute path to a sibling tool in this repo.

    The pipeline spawned its own children as `["python3", "airgap_tx_signer",
    ...]` -- a bare name resolved against the CURRENT WORKING DIRECTORY, not
    against this file. Run from anywhere except the repo root, every round died
    with "can't open file '<cwd>/airgap_tx_signer'", and it died AFTER the plan
    was written and every account and subaddress had been created. Found by
    running the shipped CLI from an operator's own directory for the first
    time; no test caught it because the suites all import the modules instead
    of spawning them, and the one suite that spawns runs from the repo.

    sys.executable, not "python3", for the same reason gs_console already uses
    it: the child must be the interpreter that has this project's
    dependencies, not whatever "python3" happens to mean on PATH.
    """
    return str(Path(__file__).resolve().parent / name)


def hop_fee_reserve(fee_xmr: Decimal) -> Decimal:
    """Amount withheld from a hop to pay its transaction fee.

    Exposed so the operator-facing message reports the SAME number the
    arithmetic actually used, rather than recomputing the margin at the call
    site where it could drift out of sync.
    """
    return fee_xmr * FEE_SAFETY_MARGIN


def hop_is_fundable(fanout_amt: Decimal, fee_xmr: Decimal) -> bool:
    """Can this output pay for a hop of its own? ONE predicate, TWO callers.

    build_dag_plan decides whether an output hops, and compute_fanout_amounts
    picks a floor that is supposed to guarantee every output it produces can.
    They were two separate expressions of the same rule, and they DISAGREED BY
    ONE TICK.

        min_each          = hop_fee_reserve + DUST          = 0.0037   (fee 0.0024)
        compute_hop_amount(0.0037)                          = 0.0001
        the hop test                    amount <= DUST_XMR  -> UNFUNDABLE

    So an output sitting exactly on the fan-out's own floor was rejected by the
    round the floor exists to guarantee. Measured over 60 planned distributions
    per setting: 19/60 at 0.2 XMR / 10 wallets, 12/60 at 1 XMR / 40, 12/60 at
    2 XMR / 60. The comment above min_each even says "rounding it down could
    leave an output a tick short of funding its hop" -- it was rounded up, and
    the value it rounded up from was already a tick short.

    Two costs, and the second is the one that matters. The output silently
    skips the second mixing round, which is depth the operator paid for and
    did not get. AND, before the destination-pool fix in build_dag_plan, a
    non-hopping output was still a legal hop DESTINATION -- so it kept its own
    output, took delivery of another, and the exit's per-subaddress sweep_all
    spent BOTH IN ONE TRANSACTION. Measured: with one unfundable output among
    ten, 275 of 300 planned rounds put a hop onto it.

    A predicate rather than two inequalities, so the next reader changing one
    changes both.
    """
    return compute_hop_amount(fanout_amt, fee_xmr) > DUST_XMR


def min_hop_fundable(fee_xmr: Decimal) -> Decimal:
    """The smallest DUST-grid amount hop_is_fundable() accepts.

    DERIVED, THEN CHECKED AGAINST THE PREDICATE ITSELF. The closed form is an
    inversion of compute_hop_amount, and an inversion is a copy -- the last
    copy drifted by exactly one tick (see hop_is_fundable). Stepping until the
    predicate agrees costs at most a tick or two, because compute_hop_amount
    rises by exactly one tick for each tick added, and it makes the two
    functions agree BY CONSTRUCTION rather than by comment.
    """
    amt = (hop_fee_reserve(fee_xmr) + DUST_XMR * 2).quantize(
        DUST_XMR, rounding=ROUND_UP)
    for _ in range(4):
        if hop_is_fundable(amt, fee_xmr):
            return amt
        amt += DUST_XMR
    return amt


def exit_is_fundable(fanout_amt: Decimal, fee_xmr: Decimal,
                     dag_enabled: bool) -> bool:
    """Can this output pay for its hop AND THE EXIT SWEEP THAT MUST FOLLOW?

    hop_is_fundable answers a question one transaction wide. A fan-out output
    is spent TWICE: the DAG round sweeps it to its neighbour, and then
    _run_exit_withdrawals issues ONE sweep_all PER FUNDED SUBADDRESS to the
    operator's destination. Both are transactions and both pay a fee. The
    fan-out floor reserved one of them.

    REPRODUCED AGAINST THE SHIPPED CODE, not argued from the arithmetic. At the
    default --wallets 10 with a 0.0024 XMR fee:

        min_hop_fundable(0.0024)                 = 0.0038   the old floor
        compute_hop_amount(0.0038, 0.0024)       = 0.0002   what survives the hop
        the exit's own dust rule, amt <= fee_per_round where
        fee_per_round == hop_fee_reserve         = 0.00360  -> NOT WITHDRAWN

    So the floor's guarantee ended one transaction before the money did.
    Driving compute_fee_budget -> compute_fanout_amounts -> compute_hop_amount
    -> the exit's filter, over settings the CLI accepts. The draw is random, so
    these are the MEDIAN over 200 seeds with the range beside them -- a single
    seed's count would read like a property and is not one:

        0.2 XMR / --wallets 10   10 of 10 unwithdrawable (7-10)  THE DEFAULTS
        1   XMR / --wallets 60   28 of 60                (25-32)
        0.8 XMR / --wallets 40   11 of 40                (6-16)
        0.5 XMR / --wallets 20    4 of 20                (0-8)

    Not one of those 200 draws came back empty at any of those settings, so
    this is what the planner emitted, not what it refused.

    The operator is told about it -- the exit prints "smaller than the ... XMR
    it would cost to move them, so they were NOT withdrawn" -- but it is told
    at the END, after the fan-out, the hop round and hours of delays have all
    executed on chain and paid their fees. That is the same shape as the
    failure hop_is_fundable exists to prevent, one step further down: a
    planning number that is checked after the money has already moved.

    And it is not recoverable by hand afterwards. Every output lives on its own
    subaddress, and this pipeline refuses to sweep two of them together (see
    _run_exit_withdrawals, "ONE TRANSACTION PER (ACCOUNT, SUBADDRESS)") because
    that is permanent public proof they share an owner. So the only spend that
    would rescue the dust is the one spend the whole run exists to prevent.

    WITH --dag-mixing OFF THE FLOOR RESERVED NOTHING AT ALL. That branch was
    `DUST_XMR * 2` -- 0.0002 XMR, against an exit sweep costing 0.0036 -- so
    EVERY output sitting on it was unwithdrawable. That branch matters more
    than its size suggests: "disable --dag-mixing" is one of the three remedies
    main() prints when the floor cannot be funded, so the advice for "these
    outputs are too small" pointed at the setting with no floor.

    RESERVED EVEN WITHOUT --exit-to, and that is deliberate rather than an
    oversight in the signature. Without an exit nothing sweeps these outputs to
    a destination, so the operator holds them -- and an output worth less than
    the fee to spend it is unspendable BY ANYONE, so all skipping the reserve
    would buy is the same dead output with nobody to report it. The reserve is
    one transaction's fee out of a plan that already reserves one per
    transaction it makes; it is not worth a fourth boolean here to shave.

    ONE PREDICATE, and it implies hop_is_fundable rather than restating it:
    x - 2R > DUST gives x - R > DUST + R > DUST. build_dag_plan keeps calling
    hop_is_fundable, because it asks about an amount this function never
    sized -- an output whose value moved between planning and the round.
    """
    after_hop = (compute_hop_amount(fanout_amt, fee_xmr) if dag_enabled
                 else fanout_amt)
    return compute_hop_amount(after_hop, fee_xmr) > DUST_XMR


def min_exit_fundable(fee_xmr: Decimal, dag_enabled: bool) -> Decimal:
    """The smallest DUST-grid amount exit_is_fundable() accepts.

    CLOSED FORM FIRST, THEN CHECKED AGAINST THE PREDICATE, exactly as
    min_hop_fundable does it -- and the first version of this function did NOT,
    which is worth recording because it looked like the safer design.

    It started at min_hop_fundable and stepped up until the predicate agreed,
    on the reasoning that starting from the sibling floor keeps the two tied by
    construction and avoids a third copy of compute_hop_amount's inversion. The
    reasoning was fine; the step budget was nonsense. The gap between the two
    floors is a WHOLE EXTRA FEE RESERVE -- 36 grid ticks at a 0.0024 XMR fee,
    360 at 0.024 -- not the tick or two of quantise drift the bound was sized
    for. Driven over fees 0.0001-0.05: it ran out of steps and returned an
    amount its own predicate REJECTS at 495 of 1000 settings, so the floor
    meant to guarantee withdrawability would itself have produced unwithdrawable
    outputs. Caught by driving the function, not by reading it.

    So: the inversion, doubled for the hop when the DAG round is on. The
    stepping loop stays, now doing the job it is actually sized for: absorbing
    the at-most-one-tick each of the two ROUND_DOWN quantises can cost.

    Measured over fees 0.0001-0.05 in 0.0001 steps, both branches: the loop
    needs at most 1 step, the answer satisfies the predicate at all 1000
    settings, and one tick below it does not.

    NEVER BELOW min_hop_fundable, and NOT BY A max() HERE. The caller's outputs
    still have to clear build_dag_plan's gate, and a floor that dropped under
    it would recreate the one-tick bug hop_is_fundable documents -- so this
    line read `amt = max(amt, min_hop_fundable(fee_xmr))` for exactly that
    reason.

    It never fired. Over 2000 fees, both branches, min_hop_fundable is never
    above the closed form: with the DAG round on the reserve is doubled, and
    with it off the two expressions are THE SAME inversion, equal at all 2000.
    A mutation deleting the max() therefore SURVIVED the whole suite -- the
    signature of an equivalent mutant, and this file already answers that one
    way (see compute_fanout_amounts: "the honest response is to delete the code
    rather than write a test that cannot fail").

    So the relationship is pinned where it can actually fail: test_units checks
    min_exit_fundable >= min_hop_fundable across the fee range directly. If a
    change to either inversion ever breaks it, that goes red and names it,
    which a max() silently absorbing the difference would not.
    """
    amt = (hop_fee_reserve(fee_xmr) * (2 if dag_enabled else 1)
           + DUST_XMR * 2).quantize(DUST_XMR, rounding=ROUND_UP)
    for _ in range(4):
        if exit_is_fundable(amt, fee_xmr, dag_enabled):
            return amt
        amt += DUST_XMR
    return amt


def compute_fanout_amount(usable: Decimal, fanout_count: int) -> Decimal:
    """Per-destination fan-out amount.

    Extracted alongside compute_hop_amount so BOTH money formulas are driven by
    tests against the real function instead of a reimplementation.

    ROUND_DOWN matters: quantising up would make fanout_count * result exceed
    the FANOUT_SPEND_FRACTION budget it was derived from. The caller guards
    fanout_count > 0 (mix_targets excludes ENTRY, so a degenerate subaddress
    set would otherwise divide by zero) and compares the result against
    DUST_XMR.
    """
    return (usable * FANOUT_SPEND_FRACTION / Decimal(fanout_count)).quantize(
        DUST_XMR, rounding=ROUND_DOWN)


def compute_fanout_amounts(usable: Decimal, fanout_count: int, fee_xmr: Decimal,
                           dag_enabled: bool, rng=None,
                           spend_fraction: Decimal = None) -> list:
    """Per-destination fan-out amounts that are DELIBERATELY UNEQUAL.

    Think like a chain analyst. Splitting the balance into N identical outputs
    makes those N outputs, and every hop that later spends them, share one
    value and one transaction shape -- a cluster you can pick out and follow
    even when Monero hides the amounts on-chain (the fee, the input/output
    count, and the timing are all still observable, and a future break in
    amount-hiding would expose the equality directly). Uneven amounts give each
    trail its own magnitude, so the fan-out looks like N unrelated payments
    rather than one split.

    Guarantees, so the plan is always fundable and never over-budget:
      * every amount >= min_each, where min_each reserves EVERY fee this output
        will pay before it reaches the operator -- its own hop when DAG mixing
        is on, and the exit's per-subaddress sweep_all either way (so no hop
        fails "not enough money", and no output survives the mix only to sit
        below the cost of moving it, both AFTER the fan-out has already
        executed on-chain). See exit_is_fundable;
      * the sum never exceeds usable * FANOUT_SPEND_FRACTION (each share is
        ROUND_DOWN, and the fixed min_each floor is reserved before the random
        remainder is distributed);
      * returns [] when the budget cannot fund `fanout_count` viable outputs,
        so the caller can reduce the count or abort rather than emit a plan
        that dies mid-flight.

    rng is injected for deterministic tests; production passes a SystemRandom.
    Uses only rng.random() (uniform 0..1), so any stdlib Random works.
    """
    if fanout_count <= 0:
        return []
    if rng is None:
        import secrets as _s
        rng = _s.SystemRandom()
    # spend_fraction OVERRIDES the default budget; it does not add a reserve.
    # The only caller that passes one is fit_peel_distribution, walking
    # PEEL_BUDGET_FRACTIONS (0.80 down to 0.40) to find a distribution a peel
    # chain can afford -- so every value ever passed here is SMALLER than the
    # default, never larger. Whatever is not distributed becomes monerod's
    # change on the spending account's subaddress 0, which is why the change
    # sweep exists (see _run_change_sweep) and why a lower fraction means MORE
    # change to sweep, not more safety margin.
    budget = usable * (FANOUT_SPEND_FRACTION if spend_fraction is None
                       else spend_fraction)
    # min_exit_fundable, NOT a second spelling of the rule. Two versions of
    # this line have now been a transaction short of the truth:
    #
    #   * `hop_fee_reserve(fee_xmr) + DUST_XMR` rounded up is one tick BELOW
    #     what build_dag_plan's fundability test accepts, so the floor whose
    #     job is "no hop later fails" produced outputs that could not hop at
    #     all (see hop_is_fundable);
    #   * min_hop_fundable reserves the HOP and stops there, so the output
    #     hopped and then could not pay for the exit sweep that spends it --
    #     9 of 10 outputs unwithdrawable at the default --wallets 10 on a
    #     0.2 XMR balance, and with --dag-mixing off the branch below this
    #     reserved nothing at all (see exit_is_fundable).
    #
    # An output is spent by every stage that touches it, so the floor is sized
    # against the LAST one, not the next one.
    min_each = min_exit_fundable(fee_xmr, dag_enabled)
    floor_total = min_each * Decimal(fanout_count)
    if budget < floor_total:
        return []                       # cannot fund this many viable outputs
    remainder = budget - floor_total
    weights = [rng.random() for _ in range(fanout_count)]
    wsum = sum(weights) or 1.0
    amounts = []
    for w in weights:
        share = (remainder * (Decimal(str(w)) / Decimal(str(wsum)))).quantize(
            DUST_XMR, rounding=ROUND_DOWN)
        amounts.append(min_each + share)
    # "DELIBERATELY UNEQUAL" IS THE FIRST LINE OF THIS DOCSTRING, and jitter
    # alone does not deliver it. Every share is quantised onto a DUST_XMR grid
    # (0.0001 XMR), so independent draws collide far more often than continuous
    # odds suggest -- and nothing checked afterwards.
    #
    # Measured with a real SystemRandom, `usable` from the shipped
    # compute_fee_budget, fee 0.0024, --deep 2:
    #
    #     50 XMR  / --wallets 10   0.1% of plans hold a repeat
    #      2 XMR  / --wallets 10   1.5%
    #    0.5 XMR  / --wallets 10   6.4%
    #      1 XMR  / --wallets 20  28.1%
    #    0.5 XMR  / --wallets 20  81.3%, with up to FOUR identical amounts
    #
    # Which is precisely the cluster the paragraph above describes: N outputs
    # sharing one value and one transaction shape, followable through every hop
    # that spends them. The sibling splitter (split_btc_amount) makes exactly
    # this guarantee and enforces it; this one only claimed it.
    #
    # NOT A LACK OF ROOM. Distinct shares on the grid need 0+1+...+(N-1) ticks
    # and the remainder holds far more wherever this returns anything at all --
    # 1119 ticks against the 190 needed at 0.5 XMR / 20, the worst case above.
    # The collisions are collisions, so a construction removes them outright.
    #
    # Same construction split_btc_amount uses, in grid ticks rather than
    # satoshis: sort, force the sequence strictly upward (distinct, and only
    # ADDS), then give the excess back from the top down taking only the slack
    # above the one beneath, so no step can recreate a tie. The sum is
    # preserved exactly, so "never over-budget" still holds, and the floor is
    # min_each for every output, so "every amount >= min_each" does too.
    #
    # Ties broken at random rather than by index, for the same reason
    # split_btc_amount does it: sorted() is stable, so keying on the value
    # alone puts tied entries in original index order and the staircase then
    # hands the lowest index the lowest amount inside every tied group.
    #
    # HONESTLY: unlike the BTC splitter, that bias is NOT MEASURABLE here.
    # Reimplementing this construction with a switchable tie-break and running
    # both gives P(a[i]<a[j]) deltas inside noise at every setting -- +0.0000
    # at 0.5 XMR / 20, -0.0148 at 1 XMR / 20 (the wrong sign), +0.0068 at
    # 0.5 / 10 -- because the remainder here runs to ~1119 grid ticks across 20
    # draws, so ties are rare and their groups are small, and nothing
    # accumulates. In split_btc_amount the tie rate reaches 1.0 at dust totals
    # and the bias reaches 0.66, which is what made it visible there.
    #
    # Kept anyway: it costs one sort key, it matches the sibling construction,
    # and it is the property that stops being true first if the tick budget
    # ever tightens. No mutation asserts a difference it cannot demonstrate.
    _tick = [int(((_a - min_each) / DUST_XMR).to_integral_value())
             for _a in amounts]
    _target = sum(_tick)
    _n = fanout_count
    _order = sorted(range(_n), key=lambda i: (_tick[i], rng.random()))
    for _pos in range(1, _n):
        _i, _prev = _order[_pos], _order[_pos - 1]
        if _tick[_i] <= _tick[_prev]:
            _tick[_i] = _tick[_prev] + 1
    _excess = sum(_tick) - _target
    while _excess > 0:
        _moved = False
        for _pos in range(_n - 1, -1, -1):
            _i = _order[_pos]
            # Floor: strictly above the one beneath it, or 0 ticks for the
            # smallest -- 0 is legal here because every share sits ON TOP of
            # min_each, so a zero share is still a fundable output.
            _floor = (_tick[_order[_pos - 1]] + 1) if _pos > 0 else 0
            _take = min(_tick[_i] - _floor, _excess)
            if _take > 0:
                _tick[_i] -= _take
                _excess -= _take
                _moved = True
                if _excess == 0:
                    break
        if not _moved:
            break
    # Only when the give-back balanced exactly. Below 0+1+...+(N-1) ticks there
    # is no distinct assignment and the staircase cannot be paid for.
    if _excess == 0:
        return [min_each + DUST_XMR * Decimal(_v) for _v in _tick]
    # THE STAIRCASE COULD NOT BE PAID FOR. What happens next used to be
    # "leave the original amounts ... a repeat is a weaker failure than an
    # over-budget plan", with the note "Not reached at any setting measured
    # above."
    #
    # It is reached, and the note was the only thing standing between an
    # operator and an equal-value cluster on chain. Measured against the
    # shipped compute_fee_budget at fee 0.0024 with --dag-mixing:
    #
    #     0.5 XMR / --wallets 40  -> 40/40 runs repeat; 40 outputs, 21 distinct,
    #                                8 clusters, worst 6 outputs all 0.0052 XMR
    #     0.8 XMR / --wallets 60  -> 40/40 runs repeat; worst 4 outputs all
    #                                0.0066 XMR
    #
    # Both are settings the CLI accepts (--wallets tops out at 60), and both
    # are the ordinary way an operator over-splits a small balance. The
    # function printed nothing and the run went on to create those outputs.
    # Six on-chain outputs of identical value is precisely the cluster this
    # whole staircase exists to remove, and it is worse than no staircase,
    # because the docstring promises "DELIBERATELY UNEQUAL".
    #
    # The BTC side already refuses the same situation rather than return
    # repeats -- split_btc_amount raises "Refusing to return repeated deposit
    # amounts" -- so this is the XMR side finally agreeing with it.
    #
    # [] IS THE EXISTING SIGNAL, not a new one: it already means "cannot fund
    # this many viable outputs", and main() answers it with the message this
    # case needs word for word --
    #
    #     Usable balance X XMR too small to fan out across N subaddresses with
    #     the fee reserve each output needs. Use fewer wallets, disable
    #     --dag-mixing, or fund the wallet more.
    #
    # -- at stage 4, before anything has been spent.
    #
    # UNCONDITIONAL, because reaching this line already means the draw had a
    # duplicate. The first version guarded it with
    #
    #     if len(set(amounts)) == len(amounts): return amounts
    #
    # on the reasoning that a failed give-back with an already-distinct draw
    # should not be refused. That case cannot occur, and the guard was dead
    # code wearing the shape of a safety net:
    #
    #   * _order sorts the ticks, so the staircase's `_tick[_i] <= _tick[_prev]`
    #     can only fire on an EQUAL pair, never an inverted one;
    #   * a tick is therefore raised only when two original ticks were equal;
    #   * _excess is the sum of those raises, so _excess > 0 implies at least
    #     one equal pair;
    #   * amounts are min_each + tick * DUST_XMR, so equal ticks are equal
    #     amounts.
    #
    # Reaching here means _excess > 0 means the draw repeats. Confirmed by
    # instrumenting the function over 3186 calls across balance 0.3-100,
    # --wallets 3-60, --deep 1-6, DAG on and off: 3108 took the staircase, 78
    # landed here, and NOT ONE arrived with a distinct draw.
    #
    # Found because a mutation that deleted the guard survived the whole suite
    # -- which is what an equivalent mutant looks like, and the honest response
    # is to delete the code rather than write a test that cannot fail.
    integrity_log("stage4", "fanout_refused:indistinct_amounts")
    return []


def min_fanout_usable(fanout_count: int, fee_xmr: Decimal,
                      dag_enabled: bool) -> Decimal:
    """The smallest `usable` compute_fanout_amounts will reliably fund.

    RELIABLY, not once. compute_fanout_amounts draws random weights, so the
    exact threshold moves seed to seed; a bound that happens to work for one
    draw is not a minimum anyone can be told. This returns a figure that funds
    the plan on EVERY draw, and tests/test_dag_entry.py drives it over many
    SystemRandom draws at every wallet count the CLI accepts.

    TWO CONSTRAINTS, and only the first is obvious:

      * FUNDABILITY. Every output must clear min_exit_fundable -- its own hop
        and the exit sweep that spends it -- so the budget needs
        min_each * n. The budget is usable * FANOUT_SPEND_FRACTION, not usable.

      * DISTINCTNESS. The amounts must be strictly different (identical outputs
        are one value and one shape for an analyst to cluster on -- see the
        docstring above and split_btc_amount's). They live on a DUST_XMR grid,
        so n distinct values need 0+1+...+(n-1) = n(n-1)/2 ticks of remainder
        ABOVE the floor, and compute_fanout_amounts returns [] when it cannot
        pay for that staircase. This is the constraint that bites: at
        --wallets 60 it is 1770 ticks, 0.177 XMR, which is more than the
        fundability floor asks for. A bound derived from the floor alone is
        wrong by that much and wrong in the dangerous direction.

    Plus one tick per output for the ROUND_DOWN each share takes onto the grid.

    NOT A SECOND SPELLING OF THE RULE -- a bound ON it. compute_fanout_amounts
    stays the authority on whether any particular plan is fundable; this only
    has to be safe, and it is checked against the real function rather than
    argued. Measured margin over the true 100%-success floor: 0.34%-0.48%
    across --wallets 3/10/20/60, which is the price of "reliably".
    """
    n = max(0, int(fanout_count))
    if n <= 0:
        return Decimal(0)
    min_each = min_exit_fundable(fee_xmr, dag_enabled)
    ticks = Decimal(n * (n - 1) // 2) + Decimal(n)
    budget = min_each * Decimal(n) + DUST_XMR * ticks
    return (budget / FANOUT_SPEND_FRACTION).quantize(DUST_XMR,
                                                     rounding=ROUND_UP)


def mix_minimum_xmr(fee_xmr: Decimal, wallets: int, *,
                    dag_mixing: bool = True, exit_set: bool = True,
                    chunks: int = 1, usage_pct: Decimal = None) -> Decimal:
    """The smallest WALLET BALANCE that completes a mix and delivers it.

    This is the number an operator can be shown when something asks how much
    they want to mix. min_fanout_usable answers a narrower question -- what the
    fan-out needs once the fees are already set aside -- and three things sit
    between that and a figure anyone can type.

    DECOYS, WHICH THE OPERATOR DOES NOT CHOOSE. The fan-out funds
    `wallets + num_decoys`, and num_decoys is
    `randint(DECOY_MIN, DECOY_MAX)` drawn at RUN TIME, after the money has
    arrived (see the draw at stage 3 and select_fanout_targets). A minimum
    computed from `wallets` alone is short by up to DECOY_MAX outputs and is
    only survivable on a lucky draw. DECOY_MAX is used here for the same reason
    compute_fee_budget uses it: it is the only count that holds for every draw.

    THE FEE RESERVE. compute_fee_budget holds back every transaction fee the
    run will pay, and `usable == bal - total_fees` exactly, with total_fees a
    function of the SETTINGS and not of the balance -- so the balance floor is
    the usable floor plus that reserve. Driven and pinned in
    tests/test_dag_entry.py rather than assumed, because the whole figure rests
    on it.

    THE OPERATOR'S CUT, when one is taken, and it binds more often than it
    looks. `usage_pct` of the balance is removed before the fan-out is planned,
    so the balance has to be larger by that fraction -- but the constraint that
    actually bites is that the cut must be SPENDABLE. An output worth less than
    the fee to spend it is unspendable by anyone (see exit_is_fundable), so a
    cut that merely clears DUST_XMR is a fee the operator can never collect and
    a permanent on-chain output created to do it. At the shipped 1.1% and a
    0.0024 fee that floor is hop_fee_reserve/0.011 = 0.3273 XMR, which is
    ABOVE the mixing minimum at every wallet count up to about 15 -- so with a
    cut enabled the cut, not the mix, is what sets the minimum for a default
    run. Returned as one number so a UI cannot show the smaller half of that.

    NOT FOR --peel. A peel chain sizes itself with fit_peel_distribution
    walking PEEL_BUDGET_FRACTIONS, which is a different rule; this would be a
    second spelling of it. Callers pass dag_mixing/exit_set and leave peel
    alone.
    """
    w = max(1, int(wallets))
    n = w + DECOY_MAX
    # bal is arbitrary: total_fees does not depend on it (asserted in the
    # tests), so this reads the reserve out of the real budget function rather
    # than restating its arithmetic here.
    _usable, total_fees, _txs = compute_fee_budget(
        Decimal(1), fee_xmr, w, peel=False, dag_mixing=dag_mixing,
        exit_set=exit_set, chunks=chunks)
    need = min_fanout_usable(n, fee_xmr, dag_mixing) + total_fees
    if usage_pct and usage_pct > 0:
        need = need / (Decimal(1) - usage_pct)
        # STRICTLY ABOVE the cost of moving it, not equal to it. An output
        # worth exactly the fee to spend it is worth nothing once spent, so
        # `hop_fee_reserve / usage_pct` is one tick short of a collectable cut --
        # driven, and it is the figure a UI would otherwise print as the
        # minimum.
        need = max(need, (hop_fee_reserve(fee_xmr) + DUST_XMR) / usage_pct)
    return need.quantize(DUST_XMR, rounding=ROUND_UP)


def select_fanout_targets(mix_targets: list, decoy_addrs: set,
                          wallets: int, num_decoys: int) -> tuple:
    """Choose which subaddresses the fan-out funds, and which of those HOP.

    Returns (fanout_dests, hop_sources). Extracted from stage 4 so a test drives
    the real selection instead of a copy.

    KERCKHOFFS: this must hold even when the algorithm is fully public. An
    EARLIER design funded `num_decoys` extra outputs and then had them DEAD-END
    (excluded from hop_sources). That is self-defeating once the code is known:
    the rule "decoys never hop" means an analyst who reads it -- or simply
    waits out the one confirmation-gated hop round (~20 min) -- identifies the
    decoys as exactly the outputs that never moved, filters them, and follows
    only the ones that hopped. A behavioural class marker ("this output type
    never moves") is a trace recipe the moment the algorithm is public.

    So EVERY fan-out output hops: hop_sources == fanout_dests. Decoys are not a
    distinguishable class; they are simply extra mix outputs indistinguishable
    from the rest, and knowing there are `num_decoys` of them reveals nothing
    about WHICH outputs they are or where the funds go. `decoy_addrs` is
    accepted for signature compatibility but no longer changes behaviour.

    mix_targets is expected pre-shuffled by the caller.
    """
    target_count = wallets + num_decoys
    fanout_count = min(len(mix_targets), target_count)
    fanout_dests = list(mix_targets[:fanout_count])
    hop_sources = list(fanout_dests)     # every output hops -- no dead-end tell
    return fanout_dests, hop_sources


def size_distribution(fanout_dests: list, entry_unlocked: list,
                      usable: Decimal, fee_xmr: Decimal, dag_enabled: bool,
                      rng) -> tuple:
    """Split the mix targets and the budget across the swap chunks.

    Returns (dest_slices, slice_usable, fanout_amounts, unfundable_index) --
    one slice of destinations and one share of `usable` per chunk, plus the
    flat list of per-destination amounts in the same order as `fanout_dests`,
    plus the index of the first chunk whose share could not fund its slice (or
    None). The caller drops that chunk and asks again.

    PER CARRIER, NOT GLOBALLY, and getting this wrong is not visible until
    monerod refuses the transaction. With one chunk there is one carrier
    holding everything and a global distribution is the same thing. With N,
    each carrier holds only ITS chunk -- so amounts drawn from the whole
    `usable` and then handed out by slice would ask a carrier to spend more
    than it has (compute_fanout_amounts jitters, so a slice's total does not
    track its carrier's share) and the fan-out would fail "not enough money"
    AFTER the veils had already relayed and paid their fees.

    Sliced by each chunk's OWN arrived balance, because chunks are not equal:
    quotes differ, and JoinMarket's UTXOs differ by design.

    A chunk with no destinations is refused rather than skipped -- its value
    would sit on its carrier, unmixed, while the run reported success. Returns
    dest_slices with an empty entry so the caller can say which chunk and how
    many targets it had.

    A chunk whose share cannot fund its slice comes back NAMED rather than as a
    bare empty result. It used to abort the entire run -- under a message about
    the wallet balance being too small, which it was not -- when one small
    chunk arrived above dust but below what even one mix output costs. Every
    other chunk was fine. The caller drops the named one and re-sizes.
    """
    slices = split_by_weight(fanout_dests, entry_unlocked)
    if any(not sl for sl in slices):
        return slices, [], [], None
    total = sum(entry_unlocked, Decimal(0)) or Decimal(1)
    slice_usable = [usable * (u / total) for u in entry_unlocked]
    by_addr = {}
    for i, sl in enumerate(slices):
        got = compute_fanout_amounts(slice_usable[i], len(sl), fee_xmr,
                                     dag_enabled, rng)
        if len(got) != len(sl):
            # WHICH slice could not be funded, so the caller can drop that
            # chunk and try again rather than losing the whole run to it.
            # Returning a bare [] made one small chunk abort a run in which
            # every other chunk was fine, under a message about the wallet
            # balance being too small -- which it was not.
            return slices, slice_usable, [], i
        for _addr, _amt in zip(sl, got):
            by_addr[_addr] = _amt
    # BY ADDRESS, NOT BY POSITION, and that is the whole point of this block.
    #
    # This was `amounts.extend(got)` -- a flat concatenation of the per-slice
    # amounts -- and the caller does `dict(zip(fanout_dests, fanout_amounts))`.
    # That is only correct while concat(slices) == fanout_dests EXACTLY, i.e.
    # while split_by_weight hands back CONTIGUOUS slices IN ORDER. Nothing
    # anywhere said so. split_by_weight's own docstring justifies contiguity as
    # a readability choice -- "contiguity keeps the mapping obvious when a plan
    # is read back by hand" -- and explicitly names round-robin as the
    # equivalent alternative, so the one edit its comment invites is the edit
    # that breaks this silently.
    #
    # Measured, 9 mix targets across chunks weighted 4/3/1: contiguous slices
    # ask each carrier for 2.70/2.02/0.67 XMR against budgets of
    # 3.00/2.25/0.75. The same code with round-robin slices asks for
    # 1.55/0.72/3.12 -- the third carrier holds 0.75 and is told to pay 3.12.
    # The fan-out then dies "not enough money" AFTER the veils have relayed and
    # paid their fees, which is the exact failure the per-carrier sizing above
    # exists to prevent.
    #
    # Keyed by address, any partition works and the coupling is gone. A
    # partition that does not COVER every destination stops the run here, at
    # plan time, before a veil has moved anything -- rather than handing the
    # planner a short list to misalign against.
    _missing = [a for a in fanout_dests if a not in by_addr]
    if _missing:
        raise RuntimeError(
            f"size_distribution: {len(_missing)} of {len(fanout_dests)} mix "
            f"destinations were in no slice, so they have no amount and no "
            f"carrier to pay them. split_by_weight must PARTITION its items. "
            f"Refusing to plan a distribution that would leave them unfunded.")
    amounts = [by_addr[a] for a in fanout_dests]
    return slices, slice_usable, amounts, None


def split_btc_amount(total: Decimal, n: int, rng) -> list:
    """Divide the BTC across n swap chunks, UNEQUALLY. Returns n amounts.

    EQUAL CHUNKS UNDO THE SPLIT ON THE BITCOIN SIDE. This was

        per_chunk = (total / n).quantize(SATOSHI_BTC)
        btc_chunks = [per_chunk] * n

    which is N deposits of an identical amount, made within minutes of each
    other, each carrying an OP_RETURN that names a different Monero address.
    The Monero side of --split is careful: separate entry addresses, separate
    veils, separate distributions, no transaction spending two chunks. None of
    that helps if the BITCOIN chain hands an observer the grouping for free --
    "four deposits of exactly 0.02 BTC to the same vault inside an hour" is a
    cluster, and the memos then read out all four destination addresses.

    So the chunks are jittered the way the fan-out's are, and for the same
    reason (see compute_fanout_amounts): identical values give an analyst one
    number and one shape to cluster on.

    THE BOUND, stated as what it actually is. Each chunk is total * w_i / sum(w)
    with every w_i drawn from [1-j, 1+j] for j = SPLIT_JITTER, so a chunk lands
    between (1-j)/(1+j) and (1+j)/(1-j) of the equal share -- about 0.70x to
    1.44x at j = 0.18, not 0.82x to 1.18x. Normalising is what widens it, and
    normalising is also what keeps the sum exact, so the wider band is the
    price of no chunk carrying the whole imbalance. It is still bounded and
    still symmetric-ish in log terms, which is what "no chunk is conspicuous"
    needs; a test pins the derived figure rather than the naive one.

    The total is EXACT: the sub-satoshi remainder from quantisation is spread a
    satoshi at a time over randomly chosen chunks rather than dumped on the
    first, which would make chunk 0 identifiable as "the odd one" every run.

    An operator sending by hand still sends what they are told; this only
    changes what they are told.
    """
    n = max(1, int(n))
    # A TOTAL THAT IS NOT A WHOLE NUMBER OF SATOSHIS HAS NO EXACT SPLIT, and
    # this docstring promises one ("The total is EXACT"). The construction
    # below works in integer satoshis, so a sub-satoshi total would come back
    # quantised -- 0.1234567891 BTC summing to 0.12345679 -- silently breaking
    # the guarantee two paragraphs up. The nudge loop this replaced kept the
    # sum by putting the sub-satoshi remainder on a random chunk, which is the
    # other half of the same problem: a chunk that is not a whole number of
    # satoshis and cannot be sent.
    #
    # resolve_btc_amount refuses these at parse time and says why. Refusing
    # here too means the promise holds for every input this function accepts,
    # rather than for every input the caller happens to have filtered.
    if total != total.quantize(SATOSHI_BTC):
        raise ValueError(
            f"{total} BTC is finer than one satoshi, so it cannot be split "
            f"into whole-satoshi chunks that sum to it exactly. "
            f"resolve_btc_amount refuses this at parse time.")
    if n == 1:
        return [total]
    # WEIGHTS FIRST, NORMALISED, THEN QUANTISED -- in that order, and the order
    # is the point.
    #
    # The first version jittered each share independently and then put the
    # whole difference from `total` onto one chunk. That difference is not a
    # rounding remainder, it is the ACCUMULATED jitter imbalance, which for
    # eight chunks at +/-18% runs to several percent of the total -- so the
    # correction pushed one chunk far outside the band and made it the
    # conspicuous one, which is exactly what jittering was for. Caught by the
    # test that checks no chunk is conspicuous, not by reading this.
    #
    # Normalising the weights first means every chunk stays inside the band and
    # only the sub-satoshi quantisation remainder is left to place.
    weights = [Decimal(1) + SPLIT_JITTER
               * ((Decimal(rng.randrange(0, 2001)) / Decimal(1000)) - Decimal(1))
               for _ in range(n)]
    wsum = sum(weights, Decimal(0))
    amounts = [(total * (w / wsum)).quantize(SATOSHI_BTC, rounding=ROUND_DOWN)
               for w in weights]
    # The remainder is now at most n-1 satoshis. Spread it ONE SATOSHI AT A
    # TIME over randomly chosen chunks rather than dumping it on chunk 0 --
    # "the one that is not a round fraction" would otherwise name chunk 0 in
    # every run.
    drift = total - sum(amounts, Decimal(0))
    steps = int((drift / SATOSHI_BTC).to_integral_value())
    for _ in range(max(0, steps)):
        amounts[rng.randrange(n)] += SATOSHI_BTC
    # Whatever is left is below a satoshi and cannot be sent; give it to a
    # random chunk so the total is still exact.
    left = total - sum(amounts, Decimal(0))
    if left != 0:
        amounts[rng.randrange(n)] += left
    # NO TWO CHUNKS MAY BE EQUAL, and jitter alone does not guarantee that.
    #
    # Measured on the shipped splitter: 4 chunks of 0.08 BTC collided in 0.085%
    # of draws and 8 chunks of 1 BTC in 0.585% -- quantising to satoshis, plus
    # the drift step nudging random chunks by one, puts two values together far
    # more often than the continuous odds suggest. A test asserting "all
    # distinct" was therefore ASSERTING SOMETHING FALSE and would have gone red
    # about once in every 150 runs, which teaches an operator to re-run rather
    # than to look.
    #
    # Two equal deposits among four is a weaker tell than four equal ones, but
    # it is still a repeated number where the whole point is that there is not
    # one -- and it costs a satoshi to remove. Take from the largest so the sum
    # is preserved and the band is not disturbed.
    #
    # THE SEARCH-AND-NUDGE LOOP THIS REPLACES CYCLED, and gave up holding
    # duplicates while the docstring promised there were none. It found the
    # first duplicate, then moved a satoshi to it FROM THE LARGEST -- and the
    # largest is usually the chunk it incremented on the previous pass, so it
    # handed the satoshi straight back. Measured: with every weight equal it
    # returns 3 distinct values out of 8, oscillating until n*4 passes run out;
    # with a real SystemRandom at 0.00001 BTC across 8 chunks, 1100 of 20000
    # draws came back with duplicates. It only ever worked because realistic
    # totals produce at most ONE tied pair, which is the one case it can fix.
    #
    # This is not a search. n distinct positive satoshi values summing to S
    # exist exactly when S >= 1+2+...+n, so the construction below always
    # succeeds above that bound and resolve_btc_amount refuses below it.
    #
    #   1. Sort a view of the chunks and force the sequence strictly upward,
    #      which makes them distinct and can only ADD satoshis.
    #   2. Give the added satoshis back from the top down, taking from each
    #      chunk only the slack above the one beneath it, so no step can
    #      recreate a tie.
    #
    # Written back to the ORIGINAL indices, so chunk 0 is not systematically
    # the smallest -- an ordered result would be its own tell.
    _sat = [int((a_ / SATOSHI_BTC).to_integral_value()) for a_ in amounts]
    _total_sat = int((total / SATOSHI_BTC).to_integral_value())
    # TIES BROKEN AT RANDOM, NOT BY INDEX -- which is what makes the sentence
    # above true. sorted() is STABLE, so keying on the satoshi value alone puts
    # equal chunks in ORIGINAL INDEX ORDER, and the staircase then walks that
    # order handing out +1 as it climbs: among any tied group, the lowest index
    # gets the lowest amount, every single run. That is precisely the ordering
    # tell "written back to the ORIGINAL indices" claims to avoid, reintroduced
    # by the sort rather than by the write-back.
    #
    # Measured as P(chunk[i] < chunk[j]) over all i<j, which is 0.5 for an
    # unbiased split. It tracks the pre-staircase tie rate exactly:
    #
    #     1 BTC / 8       tie rate 0.008   ->  0.501   (no bias)
    #     0.00001 BTC / 8 tie rate 0.478   ->  0.514
    #     0.000002 BTC/ 8 tie rate 0.980   ->  0.551
    #     36 sat / 8      tie rate 1.000   ->  0.659
    #     10 sat / 4      tie rate 0.996   ->  0.688
    #
    # So the earlier "4.2% of draws come out sorted for n=4, exactly 1/4!" was
    # measured where ties essentially never happen, and generalised to a claim
    # that does not hold where they do. Randomising the tie-break drives every
    # one of those totals to 0.494-0.502, including the ones at 0.66+.
    #
    # Only dust totals collide often enough for this to bite, and nobody mixes
    # dust -- but the cost of removing it is one sort key, and a tell that only
    # shows up on small amounts is still a tell that the docstring denies.
    _order = sorted(range(n), key=lambda i: (_sat[i], rng.random()))
    for _pos in range(1, n):
        _i, _prev = _order[_pos], _order[_pos - 1]
        if _sat[_i] <= _sat[_prev]:
            _sat[_i] = _sat[_prev] + 1
    _excess = sum(_sat) - _total_sat
    # SWEPT TO CONVERGENCE, not once. A single top-down pass stalls whenever
    # the staircase is already tight: every chunk sits exactly one satoshi
    # above the one beneath it, so only the SMALLEST has slack -- and giving
    # that back opens slack for the next one up, which the pass has already
    # gone past. Measured on the one-pass version, 50 satoshis across 8 chunks
    # left duplicates in 20000 draws out of 20000, even though 50 is above the
    # 36 that 8 distinct positive values need. Each sweep strictly lowers the
    # sum while any slack remains, so this terminates.
    while _excess > 0:
        _moved = False
        for _pos in range(n - 1, -1, -1):
            _i = _order[_pos]
            # Floor: strictly above the chunk beneath it, or 1 satoshi for the
            # smallest. Both keep every chunk positive and distinct.
            _floor = (_sat[_order[_pos - 1]] + 1) if _pos > 0 else 1
            _take = min(_sat[_i] - _floor, _excess)
            if _take > 0:
                _sat[_i] -= _take
                _excess -= _take
                _moved = True
                if _excess == 0:
                    break
        if not _moved:
            break
    if _excess == 0:
        amounts = [SATOSHI_BTC * _v for _v in _sat]
    else:
        # Below 1+2+...+n satoshis there is no set of n distinct positive
        # amounts, so this cannot be repaired -- and it must not be returned
        # quietly, because equal deposits are the Bitcoin-side tell the whole
        # function exists to remove. resolve_btc_amount refuses this at parse
        # time; reaching it means that gate was bypassed or changed.
        raise ValueError(
            f"{_total_sat} satoshis cannot be split into {n} DISTINCT positive "
            f"chunks (the smallest such split needs {n * (n + 1) // 2}). "
            f"Refusing to return repeated deposit amounts.")

    # REPAIR the boundary rather than raise on it. At (or just above) n
    # satoshis every chunk must be exactly one satoshi, so there is no room to
    # jitter: quantising ROUND_DOWN sends them all to zero and the drift loop
    # then hands the satoshis out at random, which can put two on one chunk and
    # none on another. Move one from the largest to each empty chunk -- the sum
    # is preserved and the result is sendable.
    for _ in range(n):
        if all(a_ > 0 for a_ in amounts):
            break
        _lo = amounts.index(min(amounts))
        _hi = amounts.index(max(amounts))
        if amounts[_hi] <= SATOSHI_BTC:
            break                      # nothing left to give
        amounts[_hi] -= SATOSHI_BTC
        amounts[_lo] += SATOSHI_BTC
    if any(a_ <= 0 for a_ in amounts):
        # A total too small to give every chunk at least one satoshi. The old
        # fallback here divided equally and put the difference on chunk 0,
        # which for 1 satoshi across 3 chunks produced [-1, 1, 1] -- a NEGATIVE
        # amount, i.e. an instruction to send less than nothing, summing
        # correctly and passing every other check. resolve_btc_amount refuses
        # the pair up front so this is unreachable from the CLI; it raises
        # rather than inventing a number, because there is no correct answer
        # and a wrong one here is a payment instruction.
        raise ValueError(
            f"{total} BTC cannot be split {n} ways: every chunk needs at "
            f"least one satoshi, so {n} chunks need at least "
            f"{SATOSHI_BTC * Decimal(n)} BTC.")
    # DISTINCTNESS RE-CHECKED, because the positivity repair above can UNDO it.
    #
    # The construction leaves the chunks distinct, but it can leave the smallest
    # at zero (its share quantised to nothing and no excess forced it up). The
    # positivity loop then moves a satoshi from the largest to the zero chunk --
    # and just below the feasibility floor that lands both on the same value:
    # 2 satoshis across 2 chunks came back [1, 1], 3 across 3 came back with a
    # tied pair, roughly half the draws each, instead of raising. Distinct in
    # the branch that promises it, tied in the branch that repairs positivity,
    # with nothing between them to notice.
    #
    # resolve_btc_amount refuses every total below 1+2+...+n, which is exactly
    # the range where this can happen, so the CLI never reaches it -- measured
    # zero duplicates across every feasible total. But the ValueError above
    # states the contract as "reaching it means that gate was bypassed... it
    # raises rather than returning repeated amounts", and returning [1, 1] here
    # is that promise broken for an input the function ACCEPTS. Repeated deposit
    # amounts are the Bitcoin-side cluster this whole function exists to remove;
    # returning them silently is worse than any raise. So the promise is made to
    # hold for every input this function accepts, not only the ones the caller
    # filtered.
    if len(set(amounts)) != n:
        raise ValueError(
            f"{total} BTC across {n} chunks could not be made into {n} distinct "
            f"positive amounts (smallest such split needs "
            f"{n * (n + 1) // 2} satoshis). Refusing to return repeated deposit "
            f"amounts, which are the cluster the split exists to remove.")
    return amounts




def peel_carrier_reserves(amounts: list, hop_headroom: Decimal) -> list:
    """How much each carrier must keep so the NEXT peel is CONSTRUCTIBLE.

    Returns n-1 reserves, one per carrier. PURE, so the arithmetic that decides
    whether a peel chain can run at all is testable directly instead of only by
    stranding funds on a real chain.

    Every hop needs the SAME headroom, because every hop is the same shape: a
    carrier holding one output, spending it to one or two destinations. That
    headroom is the hop's own fee (see PEEL_CARRIER_RESERVE_MULT for the
    measurements), and it does not depend on how much the hop is carrying --
    an input of 2.6 XMR and an input of 10 XMR need the identical amount left
    over.

    With carrier i-1 holding sum(amounts[i:]) + reserve_{i-1} and peel i
    spending sum(amounts[i:]) + reserve_i, the surplus is exactly
    reserve_{i-1} - reserve_i, so each reserve must exceed the next by one
    headroom:

        reserve_i = (n - 1 - i) * headroom

    which is the shape the code already had; only the constant was ever wrong.

    (An earlier attempt at this modelled the limit as a FRACTION of the input,
    on the hypothesis that a wallet refuses to spend more than ~98% of an
    output. Measuring killed that: the requirement is a fixed amount per hop,
    not a ratio. The function is kept because the arithmetic decides whether a
    chain can run at all and deserves a name and a direct test, rather than
    being discovered by stranding real funds mid-chain.)
    """
    n = len(amounts)
    if n <= 1:
        return []
    # FLAT AGAIN, and this time the flatness leaks nothing.
    #
    # It briefly carried a per-carrier random EXTRA, because with a flat
    # schedule reserve_i - reserve_{i+1} is exactly one headroom for every i,
    # so every peel left the IDENTICAL change and the exit delivered a cluster
    # of near-equal outputs. That was a real leak and the jitter did break it.
    #
    # The peel does not create change at all now (see build_peel_plan): every
    # hop consumes its carrier exactly and the last one sweeps. There is no
    # leftover to be equal, so there is nothing to de-cluster, and the
    # schedule's only remaining job is to answer "how much must ENTRY hold for
    # the whole chain to be constructible" -- which is a sizing question with
    # one right answer.
    return [hop_headroom * Decimal(n - 1 - i) for i in range(n - 1)]


def peel_entry_requirement(amounts: list, reserves: list) -> Decimal:
    """What peel 0 must be able to spend from ENTRY: everything plus reserve 0.

    Separate from the reserves so the caller can compare it against the real
    balance and shrink the distribution before building a plan that cannot run.
    """
    if not amounts:
        return Decimal(0)
    return sum(amounts, Decimal(0)) + (reserves[0] if reserves else Decimal(0))




#: Fractions of `usable` the peel planner will try, in order, when the default
#: distribution does not leave every hop its headroom. None means "whatever
#: compute_fanout_amounts already produced".
PEEL_BUDGET_FRACTIONS = (None, Decimal("0.80"), Decimal("0.70"),
                         Decimal("0.60"), Decimal("0.50"), Decimal("0.40"))


class PeelBudgetError(Exception):
    """No distribution leaves every hop the headroom it needs to be built."""

    def __init__(self, hop_headroom: Decimal, hops: int):
        self.hop_headroom = hop_headroom
        self.hops = hops
        super().__init__(f"peel chain of {hops} hops needs "
                         f"{hop_headroom * hops} XMR of headroom")


def fit_peel_distribution(amounts: list, bal: Decimal, usable: Decimal,
                          fanout_count: int, fee_xmr: Decimal,
                          dag_enabled: bool, rng, hop_headroom: Decimal):
    """Shrink the distribution until peel 0 is affordable. Returns (amounts, frac).

    A PEEL CHAIN CANNOT DISTRIBUTE AS MUCH AS A FAN-OUT, and the planner has to
    know that BEFORE it builds a plan that cannot run.

    A fan-out is ONE transaction: it spends one input, once. A peel chain is N
    SEQUENTIAL transactions, each spending nearly all of what the previous one
    forwarded -- and each has to leave its own fee behind (measured; see
    PEEL_CARRIER_RESERVE_MULT). N hops cost N headrooms out of the same
    balance, so a peel chain distributes slightly less than an equal fan-out.

    Left unchecked this failed on peel 2 with "not enough money" and stranded
    the entire remaining balance on a carrier subaddress, which this pipeline
    has no auto-resume for. Reproduced end to end before this existed.

    `frac` is None when the default distribution already fit, otherwise the
    fraction that did -- the caller reports it rather than this deciding how to
    talk to the operator. Raises PeelBudgetError when nothing fits, so the
    caller fails BEFORE any money moves.

    Returns (amounts, frac).
    """
    # Peel 0 spends from ENTRY and needs the same per-hop headroom as every
    # later hop, so it comes off the balance before anything is distributed.
    cap = bal - hop_headroom
    for frac in PEEL_BUDGET_FRACTIONS:
        trial = (amounts if frac is None else compute_fanout_amounts(
            usable, fanout_count, fee_xmr, dag_enabled, rng,
            spend_fraction=frac))
        if not trial:
            continue
        reserves = peel_carrier_reserves(trial, hop_headroom)
        if peel_entry_requirement(trial, reserves) <= cap:
            return trial, frac
    raise PeelBudgetError(hop_headroom, max(0, fanout_count - 1))


def entry_output_count(rpc, account: int, index: int):
    """How many separate outputs sit on one subaddress, or None if unknown.

    build_entry_veil's entire shape argument depends on this being 1, and
    nothing measured it. incoming_transfers is the only RPC that reports
    OUTPUTS rather than a summed balance -- get_balance would say "2 XMR"
    whether that is one output or five, which is precisely the distinction
    that decides how many rings the veil transaction carries.

    Returns None rather than a guess when the RPC cannot answer: "I do not
    know how many inputs this will have" and "it will have one" are different
    statements, and only the second is a claim.
    """
    try:
        r = rpc.raw_request("incoming_transfers", {
            "transfer_type": "available",
            "account_index": int(account),
            "subaddr_indices": [int(index)],
        }) or {}
    except Exception:                                        # noqa: BLE001
        return None
    xfers = r.get("transfers")
    if not isinstance(xfers, list):
        return None
    return sum(1 for t in xfers
               if isinstance(t, dict) and not t.get("spent")
               and int(t.get("amount", 0) or 0) > 0)


def build_entry_veils(rpc, entries: list, delay_window=None) -> tuple:
    """The first spend out of each entry output, shaped like ordinary traffic.

    `entries` is [(addr, account, index)] from create_entry_set -- one per swap
    chunk. Returns (plan_entries, carriers), where carriers is
    [(account, index, address)] parallel to `entries`.

    THE ONE OUTPUT AN ANALYST GETS FOR FREE. A ThorChain swap's settlement
    transaction is public, so for each chunk an analyst knows exactly ONE
    on-chain output: the one that paid this run. He cannot see the entry
    ADDRESS -- Monero outputs are one-time keys -- only that output. Ring
    signatures still hide WHICH later transaction spent it: he has a list of
    candidates, every transaction whose ring happens to include it, and no way
    to pick the real one out of sixteen.

    Unless the real one looks different. Measured on a chain running current
    consensus, the first transaction out of an entry address used to be:

        fan-out mode (the default) :  1-in / 7-out,  extra 259
        peel mode                  :  1-in / 3-out,  extra 131
        an ordinary sweep          :  1-in / 2-out,  extra  44

    Two outputs is the overwhelmingly common shape on the network. Seven is
    not. So an analyst holding the swap output does not need to break the ring:
    he lists the transactions that reference it and keeps the ones with the
    unusual shape, and in fan-out mode that is close to a single candidate.
    The distribution advertised itself.

    THE `extra` COLUMN ABOVE IS tx_extra, AND NOTHING HERE MAY WRITE TO IT.
    That is worth stating loudly, because until recently every plan entry in
    this file carried

        "extra": secure_hex(16),

    -- sixteen cryptographically random bytes, at six sites, which read
    exactly like tx_extra randomisation next to the measurements above. It was
    INERT: airgap_tx_signer never forwarded it to any RPC (its _canonical_plan
    says so outright, which is also why the signing fingerprint does not cover
    it), so it was dead weight that looked like a defence.

    It was worse than dead. A standard Monero transaction's tx_extra is the
    transaction public key and little else -- the 44 bytes measured above.
    Appending sixteen random bytes would make every transaction this tool
    produces a size no ordinary wallet emits, which is a unique fingerprint on
    EVERY hop rather than a defence on any. So the field is gone rather than
    "completed", and this note exists so the next reader does not finish the
    job. tx_extra is left to the wallet's default, deliberately.

    So each entry output is swept, once, into a fresh carrier -- 1-in/2-out,
    zero change, the shape most of the network is making -- and the
    distribution runs from the carriers instead. Every transaction after this
    one spends an output the analyst has never seen and cannot enumerate.

    THE INVARIANT THIS ENFORCES, which is stronger than "the veil has one
    input" and is the one that actually holds:

        NO TRANSACTION MAY EVER SPEND VALUE DERIVED FROM TWO DIFFERENT SWAP
        CHUNKS.

    "One input per veil" is not sufficient, because the intersection works at
    ANY depth. Suppose two chunks are veiled separately but into ONE shared
    carrier, and the distribution then spends both carrier outputs. For each
    chunk the analyst holds a candidate set: every transaction whose ring
    happens to reference that chunk's known output. The distribution is a
    transaction whose input rings touch BOTH sets, and a transaction that
    touches one set has no reason to touch the other, so very few candidates
    survive being in both. Convergence is where the two sets meet; N chunks
    therefore get N carriers and N distributions, and no transaction in the run
    ever holds value from two of them.

    WHAT THE CANDIDATE SET IS NOT: SIXTEEN. An earlier version of this note
    sized it as the ring size, which is the wrong quantity and points the wrong
    way. Sixteen is how many members hide the real input OF A KNOWN
    TRANSACTION. The attack here runs the other way -- from a known OUTPUT to
    "which transaction spent it" -- and the size of THAT set is how many
    transactions on the chain happened to draw this output as a decoy, which
    is not a constant and is not sixteen. It depends on the output's age when
    it is spent, through Monero's decoy-selection distribution, and this
    pipeline spends the entry output within minutes of its arrival, when few
    transactions have had the chance to reference it. That cuts BOTH ways and
    neither is quantified here: the set may be small, which makes the veil
    weaker than the shape argument alone suggests, and it makes an intersection
    correspondingly more decisive. The design conclusion is unchanged and the
    number was never load-bearing -- one known output gives the analyst nothing
    to intersect against, two give him something -- but a confident figure that
    measures the wrong thing is worse than no figure, so it is gone rather than
    corrected.

    For the same reason "convergence leaks wherever it is put" is stated here
    as a design rule rather than a theorem. How much it leaks depends on that
    same age-dependent set; with outputs held for days before spending, the
    intersection can carry real false positives. This pipeline does not hold
    them for days, and a rule that does not depend on an unmeasured
    distribution is the one worth building on.

    A further understatement worth keeping honest: a swap settlement usually
    has TWO outputs, the payment and the provider's change, and a chain
    observer cannot tell which is which. So the analyst carries both forward
    and his starting set is twice what is assumed above. That makes the attack
    somewhat harder than described, not easier -- the argument is written to
    the pessimistic side on purpose.

    TWO KNOWN OUTPUTS IS THE DANGER; ONE KNOWN PLUS DUST IS NOT. An earlier
    version of this note listed three ways an entry address ends up with more
    than one output and treated them as equivalent. They are not, and the
    difference decides what to do about each:

      * TWO OR MORE PUBLICLY-KNOWN outputs on one subaddress -- N chunks routed
        to one address (fixed: create_entry_set), a receive bundle paid by two
        swaps, or one swap settling in two payments. Sweeping them together
        gives the analyst two sets to intersect. CATASTROPHIC, and the reason
        this function exists in the plural.
      * ONE KNOWN OUTPUT PLUS OUTPUTS THE ANALYST DID NOT CREATE -- dust from
        a stranger, which nobody can prevent. He knows only the one output, so
        there is no second set to intersect with; all he learns is that the
        true transaction has more than one input, and 2-in/2-out is a common
        shape. MILD.

        BUT ONLY IF THE DUSTER IS NOT THE ANALYST, and the party with the
        motive to dust this address is exactly the analyst: the swap memo hands
        him the entry address in plaintext, and sending a piconero to it costs
        nothing. He then knows BOTH outputs, has two candidate sets, and the
        intersection is back -- deliberately, for a fee. There is no way from
        inside the wallet to tell a stranger's dust from a poisoned output;
        they are the same event. So "mild" describes the accidental case only,
        and the report below says so instead of reassuring.

    So the count is measured per entry address and reported when it is not 1,
    with the two cases described differently rather than as one alarm.

    WHY NOT sweep_single, WHICH WOULD SPEND THEM ONE AT A TIME. It is not a
    missing feature here, it is architecturally unavailable, and adding it
    would weaken the signing boundary:

      * phase_create talks to a VIEW-ONLY wallet (OPSEC_SETUP.md, and
        airgap_tx_signer's own phase description). A watch-only wallet cannot
        compute key images -- they need the spend key -- and sweep_single
        resolves its target by key image and nothing else, so the call cannot
        even be formed. sweep_all is unaffected because it selects by
        (account_index, subaddr_indices).
      * Obtaining them needs a THIRD air-gap crossing, offline -> online,
        ordered BEFORE the phase it feeds, which inverts the create -> sign
        pipeline the signer is built around.
      * sweep_single takes no account_index and no subaddr_indices, so the
        one-account-per-hop invariant the peel chain depends on would become
        unenforceable -- the spend goes wherever the named output lives.
      * _canonical_plan has no key_image field, so two plans naming DIFFERENT
        outputs would hash identically and the signing fingerprint gate would
        pass a swapped plan.
      * The RPC currently picks and reserves the outputs, which is what stops
        one plan double-spending; with the plan naming them, two entries
        carrying one key image both build and the daemon only objects at relay.

    It costs one transaction and one fee per chunk, and one confirmation wait
    for all of them together -- the N veils are independent, so they confirm in
    parallel. Each inherits --hop-delay, which matters more here than anywhere
    else: this is the only hop where an analyst knows one endpoint of the wait.
    """
    plan = []
    carriers = []
    for _pos, (addr_in, acct_in, idx_in) in enumerate(entries):
        _n_inputs = entry_output_count(rpc, acct_in, idx_in)
        _label = (f"entry {_pos + 1}/{len(entries)}" if len(entries) > 1
                  else "ENTRY")
        if _n_inputs is None:
            print(f"  [!] Could not count the outputs on {_label}, so it is "
                  f"not known whether its veil is the 1-input transaction the "
                  f"shape argument depends on.")
            integrity_log("stage4", "veil_input_count_unknown")
        elif _n_inputs > 1:
            integrity_log("stage4", "veil_multi_input")
            print(f"  [!] {_label} holds {_n_inputs} separate outputs, so its "
                  f"veil will be a {_n_inputs}-INPUT transaction rather than "
                  f"the 1-in/2-out shape it is meant to be.")
            print("      If more than one of those came from a SWAP, this is "
                  "serious: each swap's settlement is public, so an analyst "
                  "has one known output per swap and can intersect their rings "
                  "to pick this transaction out — and with it the carrier the "
                  "rest of the run spends from. That happens when one address "
                  "was paid by two swaps, or when a single swap settled in two "
                  "payments.")
            print("      If the extras are dust somebody sent to the address "
                  "the memo publishes, it is milder: a stranger's dust is an "
                  "output the analyst does not know, so he has nothing to "
                  "intersect against and learns only that this transaction "
                  "has more than one input — a shape most of the network also "
                  "makes.")
            print("      That holds only while the duster is NOT the analyst. "
                  "The swap memo gives him this address in plaintext and a "
                  "piconero costs him nothing, so poisoning it to create a "
                  "second known input is cheap and deliberate. Nothing inside "
                  "this wallet can tell the two apart — they are the same "
                  "event.")
            print("      If you can, wait and run against a receive wallet "
                  "that was paid once (create_receive_wallet mints a fresh "
                  "one).")

        acct = create_fresh_account(rpc, label="")
        addr, idx = rpc.new_subaddress_indexed(account_index=acct, label="")
        plan.append({
            "src": addr_in,
            "src_index": idx_in,
            "account_index": acct_in,
            "dst": addr,
            "sweep": True,
            # THE ORDINARY PER-HOP DELAY, AND NOTHING EXTRA. This briefly
            # multiplied the window by the chunk count, on the reasoning that
            # "the N veils relay in one round, so N of them land inside the
            # window meant for one" -- which would hand an analyst a joint
            # timing constraint across all N known swap outputs at once.
            #
            # THAT PREMISE WAS WRONG, and reading the broadcaster is what
            # showed it. broadcast_signed_xmr relays a plan file with a single
            # `for item in items:` loop that SLEEPS item.delay before each
            # submit, so the delays are CUMULATIVE, not offsets from a common
            # start. N veils therefore already span N full gaps -- about an
            # hour at N=8 with the default window -- and there is no narrow
            # window to spread out of.
            #
            # The multiplication also cost far more than it looked: with each
            # of N veils drawing from a window N times wider, the round scales
            # as N-squared. Measured against the shipped constants, N=8 went
            # from 1.0h to 6.6h for no property that was not already held.
            "delay": hop_delay(delay_window),
        })
        carriers.append((acct, idx, addr))
    # THE CARRIERS MUST BE DISTINCT, and this is the invariant's last gap.
    #
    # Two veils paying ONE carrier is precisely the convergence the plural
    # design exists to remove: the analyst has a candidate set per chunk, and
    # the transaction that later spends both carrier outputs is the unique one
    # whose input rings touch both sets. Nothing downstream would notice --
    # the distribution would simply see one funded source instead of two, and
    # the run would report success.
    #
    # Verified rather than assumed for the reason every other RPC answer here
    # is (create_fresh_account refuses a reported index of 0;
    # new_subaddress_indexed checks the address is address-shaped): the wallet
    # is not expected to lie, but the failure mode if it does is the silent
    # kind. Found by a test written against the invariant rather than against
    # this function's shape.
    _caddrs = [a for _c, _i, a in carriers]
    _caccts = [c for c, _i, _a in carriers]
    if len(set(_caddrs)) != len(_caddrs) or len(set(_caccts)) != len(_caccts):
        integrity_log("stage4", "DUPLICATE_VEIL_CARRIER")
        sys.exit(
            f"[!] Two of the {len(carriers)} entry veils would pay the SAME "
            f"carrier.\n"
            f"    Refusing: that merges two swap chunks into one output, which "
            f"is the convergence\n"
            f"    splitting the swap exists to avoid — the transaction that "
            f"later spends it is the\n"
            f"    one an analyst can pick out by intersecting the two chunks' "
            f"candidate rings.")
    return plan, carriers

def build_peel_stage_plan(rpc, addr_index: dict, entry_account: int,
                          entry_addr: str, entry_index: int, dests: list,
                          amount_by_addr: dict, hop_fee: Decimal,
                          delay_window=None):
    """Provision the peel chain's carriers and turn a peel plan into stage-5
    entries. Returns (plan, change_accounts).

    PEELING CHAIN: one transaction per destination, each spending what the
    previous peel forwarded, so the N mix outputs appear in N separate
    transactions over time instead of co-created in one fan-out an analyst can
    cluster.

    ROTATING CARRIERS: one fresh subaddress per hop, so no address is ever
    spent twice and subaddress 0 is never spent at all. They are provisioned
    BEFORE the plan is built, because build_peel_plan refuses to fall back to
    subaddress 0 rather than quietly rebuild the very hub the peel exists to
    avoid.

    ONE ACCOUNT PER HOP, which is the part that is not obvious. Monero sends a
    transaction's change to the SPENDING ACCOUNT's subaddress 0 -- that is not
    selectable. Run every hop in one account and all N peels deposit their
    change onto one subaddress 0, and then the sweep that collects it is a
    single N-INPUT transaction.

    That transaction is the whole peel chain undone. Spending N outputs
    together is public, permanent proof that those N outputs share one owner,
    and it needs no ring analysis to read -- the input count is right there in
    the transaction. Those N outputs are the change of the N peels, so the
    sweep announces that all N peels were one entity, which is exactly the
    fact the chain spent N transactions and several hours hiding. Measured on
    a chain running current consensus: six peels produced a six-input sweep,
    while sweeping the same six outputs separately produced six 1-in/2-out
    transactions -- the most common shape on the network -- for about 0.005
    XMR more in fees at a 0.0024 XMR estimate.

    Giving each hop its own account puts each hop's change on a DIFFERENT
    subaddress 0, so every one of them can be swept alone. Accounts are free
    (they are only a subaddress derivation domain) and invisible on-chain;
    this buys the sweep structure, nothing else.

    The second return value is EMPTY. It used to be the accounts whose
    subaddress 0 would hold change, one per hop, so the caller could provision
    a sweep destination for each; the chain leaves no change now (see
    build_peel_plan), so there is nothing to sweep and no destination to mint.

    The carrier accounts are registered in `addr_index` instead. That is what
    puts them on the EXIT's account list, so if a fee moves between
    _build_exact_consume's two passes and monerod does emit a small change
    output after all, the exit finds it and withdraws it rather than
    abandoning it. Registering them also makes reject_self_exit refuse an
    --exit-to that happens to be one of this run's own carriers.
    """
    amounts = [amount_by_addr[a] for a in dests]
    carriers = []
    hop_accounts = []
    for _ in range(max(0, len(dests) - 1)):
        # A fresh account per carrier. create_fresh_account fails closed: a
        # wallet that answers without a usable index aborts the run here,
        # before any money moves, rather than silently handing back account 0
        # and putting a hop's change on the operator's PRIMARY address.
        acct = create_fresh_account(rpc, label="")
        addr, idx = rpc.new_subaddress_indexed(account_index=acct, label="")
        hop_accounts.append(acct)
        carriers.append((addr, idx))
        # SO THE EXIT CAN SEE IT. _exit_account_list is built from
        # addr_index's values plus change_accounts plus bal_account, and
        # change_accounts is empty now -- without this the carrier accounts
        # would be invisible to the exit, which is the "silently leaves money
        # behind" failure _funded_subaddresses names.
        addr_index[addr] = (acct, idx)
    # VERIFIED, not assumed -- the same check build_entry_veils, create_subs
    # and create_entry_set all make, and this loop mints the same way from the
    # same RPC without it. create_fresh_account validates the SHAPE of one
    # answer; it has no memory across calls, so nothing there can notice the
    # wallet handing back an index it already gave.
    #
    # Both halves of this function's own docstring die on a duplicate:
    #   * ROTATING CARRIERS -- "one fresh subaddress per hop, so no address is
    #     ever spent twice". Two equal carriers make one address the input of
    #     two peels, which is the repeated-spender hub the rotation removes.
    #   * ONE ACCOUNT PER HOP -- two equal accounts put two peels' change on
    #     ONE subaddress 0, and the sweep that collects it is then a 2-INPUT
    #     transaction: public, permanent proof those peels share an owner,
    #     which is the exact fact the chain spends hours hiding.
    #
    # Before any money moves: the carriers are provisioned here, and the peel
    # plan is built below.
    _pc_addrs = [a for a, _i in carriers]
    if len(set(_pc_addrs)) != len(_pc_addrs) or len(set(hop_accounts)) != len(hop_accounts):
        integrity_log("stage4", "DUPLICATE_PEEL_CARRIER")
        sys.exit(
            f"[!] Two of the {len(carriers)} peel carriers came back the SAME.\n"
            f"    Refusing: the chain would spend one address twice (the hub the\n"
            f"    rotation exists to remove), and two hops' change would land on one\n"
            f"    subaddress 0 -- so the sweep collecting it becomes a 2-input\n"
            f"    transaction proving those peels share an owner. Nothing has been\n"
            f"    spent. Check the wallet RPC.")
    core = build_peel_plan(
        entry_index=entry_index, change_index=0, dests=dests, amounts=amounts,
        carriers=carriers)
    plan = []
    for p in core:
        # Peel 0 spends ENTRY, which lives in the mix account. Peel i>0 spends
        # carrier i-1, which lives in that carrier's own account.
        hop_acct = entry_account if p["peel_num"] == 0 else hop_accounts[p["peel_num"] - 1]
        entry = {
            "src": entry_addr if p["peel_num"] == 0 else carriers[p["peel_num"] - 1][0],
            "src_index": p["src_index"],
            "account_index": hop_acct,
            "dst": p["dst"],
            "delay": hop_delay(delay_window),
            "peel_num": p["peel_num"],
        }
        if p.get("sweep"):
            # The last peel. sweep_all carries no amount -- one would look
            # authoritative and be ignored, which is the rule the DAG hops
            # already follow.
            entry["sweep"] = True
        else:
            entry["amt"] = p["amt"]
            entry["destinations"] = p["destinations"]
            entry["consume_to"] = p["consume_to"]
            entry["carrier"] = p["carrier"]
            entry["carrier_index"] = p["carrier_index"]
        plan.append(entry)
    # NO CHANGE ACCOUNTS. Every hop consumes its carrier exactly and the last
    # one sweeps, so nothing lands on any subaddress 0 -- there is nothing for
    # a change sweep to move. The caller used to be handed
    # [entry_account] + hop_accounts here and minted a fresh account and a
    # sweep transaction for each of them.
    #
    # The accounts are still in addr_index, so the EXIT still looks at them:
    # if a fee moves between the two build passes and monerod does emit a small
    # change output after all, it is found and withdrawn rather than abandoned.
    return plan, []


def build_peel_plan(entry_index: int, change_index: int,
                    dests: list, amounts: list,
                    carriers: list = None) -> list:
    """A PEELING CHAIN: N single-destination transactions instead of one
    N-output fan-out.

    The fan-out's unavoidable weakness is that its N outputs are created in ONE
    transaction, so an analyst who spots that transaction sees the whole output
    set co-created and can follow it as a group. A peeling chain removes that:
    it sends to ONE mix subaddress per transaction and lets the remainder carry
    to the next, so the N mix outputs appear in N SEPARATE transactions spread
    over time, never co-created.

    ROTATING CARRIERS. Peel 0 spends ENTRY; every later peel spends a FRESH
    carrier subaddress that the previous peel paid explicitly.

    The obvious implementation -- and the one this replaces -- let the change
    fall where monerod puts it and spent that. Verified against real monerod
    0.18, spending from subaddr i returns the change to the ACCOUNT'S
    SUBADDRESS 0, so "spend the previous peel's change" means every peel after
    the first spends subaddress 0. For an 8-destination chain that is subaddr 0
    spent 7 times: one address, spent over and over, with each spend consuming
    the output the previous one created.

    That is a hub, and against anyone holding the view key it is not a
    probabilistic weakness, it is a walk. Spot any peel, follow its change
    input backwards, and every hop lands on the same address until you reach
    the origin -- recovering the whole chain and the entry. A repeated spender
    is also the single most reliable change heuristic there is, so the same
    address is simultaneously labelled "this wallet's change" for free. The
    peel mode existed to beat fan-out clustering, and it did, while building a
    cleaner signal in its place.

    So the remainder is now paid FORWARD as an explicit destination to a fresh
    carrier instead of being left to become change:

        peel i:  spend carrier[i-1]  ->  [ dests[i], carrier[i] ]

    Each carrier is spent exactly once, no address is spent more than twice,
    and subaddress 0 is never spent at all. The chain still walks -- an output
    still funds the next transaction -- but it walks across N distinct
    one-time addresses instead of collapsing onto one, so there is no repeated
    spender to anchor on and no single address that names the wallet.

    ZERO CHANGE, on every hop. This is the second thing the peel got wrong and
    it was the larger of the two.

    A peel used to name BOTH its destination and the next carrier as
    fixed-amount destinations, which leaves monerod's own change output -- so
    each peel was 1-input / 3-output with a 131-byte tx_extra, against the
    1-input / 2-output / 44-byte shape of everything else in the run. Measured
    on a completed --peel --dag-mixing chain: 30 transactions at
    out=2 extra=44 fee=0.001810, and six at out=3 extra=131 fee=0.002633,
    identical to the piconero. The six peels were the only transactions of
    their shape in the run and they were indistinguishable from each other.

    Worse, that change was a FIXED quantity by construction -- one headroom
    minus the fee, from two public constants -- so the six change outputs
    reached the exit as a cluster of near-equal amounts (measured: six arrivals
    inside three piconero). Jittering the reserve broke the equality; it could
    not remove the third output, the longer tx_extra or the higher fee.

    The change is gone entirely now:

      * peels 0..n-2 name ONE fixed destination and CONSUME THE CARRIER
        EXACTLY. The plan says `consume_to`, and phase_create computes that
        output's amount at build time as (unlocked - fixed destination - the
        real fee), which it learns by building the transaction once with slack
        and reading the fee back. Verified end to end through the cold-signing
        path on a real chain -- view-only build, offline sign, relay:
        in=1 out=2 extra=99, carrier balance afterwards 0.
      * the LAST peel is a sweep_all to its destination, which is genuinely
        zero-change and needs no second output at all.

    So the whole chain leaves nothing on subaddress 0, there are no change
    sweeps for a peel run (n fewer transactions), and no change-sweep
    destinations for the exit to withdraw (another n fewer).

    CONFIRMED by re-running the same --peel --dag-mixing shape end to end
    against a real chain afterwards. Before and after, same 12 XMR entry:

                             before          after
        transactions            36              22
        output counts       {2:30, 3:6}      {2:22}
        tx_extra          {44:30, 131:6}   {44:16, 99:6}
        exit arrivals           14               7
        total fee          0.072714 XMR    0.045544 XMR
        exit cluster      six inside 3 pico    none

    Every transaction the run makes is now 2-output, every peel emptied its
    carrier, every withdrawal reported "emptied", and the run finished clean
    enough to wipe its own plans.

    WHY NOT subtract_fee_from_outputs. Monero v0.18.3.1 accepts the field on
    transfer_split and silently ignores it -- measured: both destinations were
    paid in full, the change output still appeared, the fee was identical, and
    an out-of-range index in that list raised no error, which is how you can
    tell it is never parsed. Asking for destinations that sum to the whole
    balance fails "not enough money" whether the field is present or not. The
    two-pass build is what actually works.

    WHERE THE SURPLUS GOES. Each hop's headroom is slightly more than its real
    fee, and with exact consumption that difference is no longer left behind --
    it flows down the chain into the final sweep's destination. That is why
    PEEL_CARRIER_RESERVE_MULT is 1 and not 8: at 8 the last destination would
    arrive roughly 0.19 XMR fatter than planned on an 8-hop chain, which is the
    cluster problem inverted.

    Because each peel spends an output the previous peel created, the peels are
    necessarily SEQUENTIAL and CONFIRMATION-GATED (unspendable until ~10 blocks
    later) -- which is what spreads them over time. The caller runs each peel
    as its own gated round.

    `carriers` is a list of (address, subaddress_index) for the fresh carriers,
    one per peel; the last peel needs none and any extra is ignored. Pure and
    deterministic; returns core entries the caller decorates with the src
    address, a per-peel delay and tx 'extra'. Returns [] for no dests.

    There is no `remainders` argument any more. It used to carry what each peel
    forwarded, computed from the reserve schedule at PLANNING time -- hours
    before the transaction is built, against an estimated fee. Nothing can know
    the real fee then, which is precisely why the old plan needed a change
    output to absorb the difference.
    """
    n = min(len(dests), len(amounts))
    if n <= 0:
        return []
    carriers = list(carriers or [])
    plan = []
    for i in range(n):
        if i == 0:
            src_idx = entry_index
        elif i - 1 < len(carriers):
            src_idx = carriers[i - 1][1]
        else:
            # No carrier was provisioned for this hop. Falling back to
            # change_index would silently rebuild the exact hub this function
            # exists to remove, so refuse instead.
            raise ValueError(
                f"peel {i} has no carrier to spend: {len(carriers)} carrier(s) "
                f"provided for {n} peels (need at least {n - 1}). Refusing to "
                f"fall back to subaddress 0, which would rebuild the hub.")
        entry = {
            "src_index": src_idx,
            "dst": dests[i],
            "amt": str(amounts[i]),
            "peel_num": i,
        }
        # Every peel but the last consumes its carrier EXACTLY: one fixed
        # destination, and everything else (minus the real fee, learned at
        # build time) forwarded to the next carrier. No change output.
        #
        # REFUSE rather than silently skip when there is no carrier, for the
        # same reason the branch above raises. A non-last peel with nowhere to
        # forward pays only its destination, so the leftover falls to monerod's
        # change on subaddress 0 -- rebuilding the hub this function exists to
        # remove -- AND the next peel then waits forever on a carrier nobody
        # funded.
        if i < n - 1:
            if i >= len(carriers):
                raise ValueError(
                    f"peel {i} has no carrier to forward to "
                    f"({len(carriers)} carrier(s) for {n} peels, need at least "
                    f"{n - 1}). Refusing to let the leftover fall to "
                    f"subaddress 0 as change, which would rebuild the hub and "
                    f"strand the next carrier unfunded.")
            entry["destinations"] = [
                {"address": dests[i], "amount": str(amounts[i])},
            ]
            # THE REST, MINUS THE REAL FEE. phase_create resolves this amount
            # against the live balance; the plan states the intent, because the
            # number cannot be known until the transaction is built.
            entry["consume_to"] = carriers[i][0]
            entry["carrier"] = carriers[i][0]
            entry["carrier_index"] = carriers[i][1]
        else:
            # THE LAST PEEL IS A SWEEP. It has nothing to forward, so sweep_all
            # -- genuinely zero-change -- is exactly right, and it is what
            # carries the chain's accumulated fee surplus to its destination
            # instead of leaving it as one final change output.
            entry["sweep"] = True
            entry.pop("amt", None)
        plan.append(entry)
    return plan


def parse_swap_route(route: dict) -> tuple:
    """Extract (deposit_addr, memo, expected_output_str) from ONE SwapKit route.

    Extracted from the inlined stage2 loop so tests exercise the actual code
    rather than a copy. The `nullsafe:` block in test_units.py used to assert on
    a hand-written parse_route(); reverting the real function would not have
    turned that test red. Same defect appeared in thor_swap_preparer -- both
    call this now.

    Uses `x or fallback` NOT `dict.get(k, default)` because SwapKit routinely
    returns these keys PRESENT with a null value: .get("transaction", {}) hands
    back None (not the default) for a null value, then .get() on None raises
    AttributeError. `or` collapses missing AND null to the safe fallback.
    """
    tx_info = route.get("transaction") or route.get("calldata") or {}
    deposit = tx_info.get("depositAddress") or tx_info.get("to") or ""
    memo = tx_info.get("memo") or tx_info.get("data") or ""
    expected = route.get("expectedOutput") or "0"
    return deposit, memo, expected


def validate_swap_route(deposit_addr, memo, xmr_dest: str, idx: int,
                        allow_unbound_memo: bool = False) -> None:
    """Refuse a swap quote that would send the operator's BTC into a black hole.

    Every check here guards an IRREVERSIBLE payment, and this whole function is
    the fix for a real defect: GhostSpiral's stage 2 validated the deposit
    address and then printed "Send N BTC to <addr> with memo <memo>" without
    ever checking the memo -- while thor_swap_preparer, fetching the same
    quotes from the same API, refused to print exactly those instructions
    unless the memo named the operator's own address. The safe path and the
    unsafe path were the same operation in one repo.

    Three ways a quote can cost the operator everything:
      * no deposit address, or one that is not a real BTC address -- the funds
        go nowhere recoverable;
      * NO memo at all -- a BTC->XMR swap is routed entirely by the memo, so
        BTC paid into the shared inbound vault without one is not routed to
        anybody, least of all you;
      * a memo naming a DIFFERENT address -- the vault is shared, so the swap
        delivers your sender's money to whoever that address belongs to.

    Raises SystemExit with an operator-readable reason; never returns on
    failure. Amounts and the full address stay out of the integrity log.
    """
    if not deposit_addr:
        integrity_log("stage2", f"no_deposit_in_route_{idx}")
        sys.exit(f"[!] Chunk {idx}: the route carries no deposit address.")
    dep = str(deposit_addr)
    # A typo'd-but-in-charset address passes the regex alone, so the checksum
    # is verified too: this string is about to be handed to somebody as "send
    # real bitcoin here".
    if not BTC_RE.match(dep) or not bech32_checksum_ok(dep):
        integrity_log("stage2", f"bad_deposit_format_{idx}")
        sys.exit(
            f"[!] Chunk {idx}: the deposit address failed bech32 checksum\n"
            f"    validation: {scrub_address(dep)}\n"
            f"    The API response shape may have changed. Refusing to tell you to\n"
            f"    send BTC to an address this tool could not verify."
        )
    if not memo:
        integrity_log("stage2", f"no_memo_{idx}")
        sys.exit(
            f"[!] Chunk {idx}: the quote returned NO memo. A BTC->XMR swap is\n"
            f"    routed entirely by the memo -- BTC sent to the inbound vault\n"
            f"    without one is not routed to you and cannot be recovered.\n"
            f"    Refusing to issue deposit instructions."
        )
    if not memo_binds_destination(memo, xmr_dest):
        # ONCE, and written BEFORE the abort check: with --allow-unbound-memo
        # the run CONTINUES, so it repeats per chunk. Same defect and same fix
        # as thor_swap_preparer's copy -- these two swap paths are the pair
        # this file keeps having to stop from drifting.
        integrity_log_once("stage2", "memo_dest_mismatch")
        if not allow_unbound_memo:
            sys.exit(
                f"[!] Chunk {idx}: the returned memo does NOT contain your XMR\n"
                f"    destination {scrub_address(xmr_dest)}.\n"
                f"    The memo is what tells ThorChain where to deliver the XMR, and\n"
                f"    the deposit address is a SHARED inbound vault -- following these\n"
                f"    instructions could pay someone else, irreversibly. Refusing.\n"
                f"    Override only if you have verified the memo by hand:\n"
                f"    --allow-unbound-memo"
            )
        print(f"  [!] Chunk {idx}: memo does not name your destination — continuing "
              f"because --allow-unbound-memo was given. VERIFY IT BY HAND.")


def parse_jm_amounts(stdout: str, dest: str) -> List[Decimal]:
    """Best-effort parse of JoinMarket tumbler stdout for BTC amounts sent to
    `dest`, returned as BTC Decimals (empty if nothing recognisable).

    JoinMarket's tumbler/sendpayment reports the coins it moves either in BTC
    ('... 0.12345678 BTC ...') or in satoshi ('sending 12345678 sats to <addr>').
    We only trust lines that also reference `dest`, so unrelated amounts in the
    log aren't picked up. FORMAT-DEPENDENT: validate against the JoinMarket
    version in use -- the caller fails loudly if this returns nothing after a
    tumble, rather than silently pretending JoinMarket contributed (the old
    behaviour). Deduplicated, since a summary line may repeat a per-tx amount.
    """
    # PRIMARY: the transaction JSON. Read off upstream rather than guessed --
    # jmbitcoin.human_readable_transaction returns json.dumps(outdict,
    # indent=4), and human_readable_output builds each output dict in the order
    # value_sats, scriptPubKey, address. So a real tumbler log contains:
    #
    #     "outputs": [
    #         {
    #             "value_sats": 12345678,
    #             "scriptPubKey": "0014...",
    #             "address": "bc1qdest..."
    #         },
    #
    # WHICH IS WHY THE OLD PARSER COULD NEVER MATCH. It required the
    # destination and an amount on the SAME line and JoinMarket never puts them
    # there: value_sats and address are two lines apart, and the one line that
    # does carry a formatted amount ("total estimated amount spent = 0.001 BTC
    # (100000 sat)", via amount_to_str) has no address on it -- and is an
    # ESTIMATE INCLUDING FEES, not what was delivered. The regex also looked
    # for digits followed by "sat", while the JSON key is "value_sats" with the
    # number after it. So a tumble could complete and the caller would still
    # abort with "no output amount could be parsed", throwing away a real
    # tumble. Fixing the invocation without fixing this would have moved the
    # failure one step later, not removed it.
    #
    # Grouped BY TXID and overwritten when a txid reappears, because a tumbler
    # makes several transactions and logs the same one more than once
    # ("obtained tx", then again when it completes). The old dedup was on the
    # amount VALUE, which silently discarded a genuine second payment that
    # happened to be the same size -- likely in a tumble, whose whole design is
    # similar-sized chunks.
    # ORDER MATTERS AND IT IS NOT THE OBVIOUS ONE. human_readable_transaction
    # builds its dict as hex, inputs, OUTPUTS, txid, nLockTime, nVersion -- so
    # every output line is read BEFORE the txid that owns it. Outputs are
    # therefore collected into a pending block and committed when the txid
    # arrives; keying them off "the last txid seen" would attribute each tx's
    # outputs to the PREVIOUS transaction. "hex" opens a block and resets the
    # buffer, so a partial block cannot bleed into the next one.
    #
    # Committing with = rather than .append() is what makes the duplicate
    # logging harmless: JM prints the same transaction more than once
    # ("obtained tx", then again on completion), and the second block simply
    # replaces the first. A block with no txid is dropped and the caller fails
    # loudly, which is the safe direction.
    per_tx: dict = {}
    block: List[Decimal] = []
    pending = None
    for line in stdout.splitlines():
        if re.search(r'"hex"\s*:', line):
            block = []
            pending = None
            continue
        m = re.search(r'"txid"\s*:\s*"([0-9a-fA-F]{64})"', line)
        if m:
            per_tx[m.group(1)] = block
            block = []
            pending = None
            continue
        m = re.search(r'"value_sats"\s*:\s*(\d+)', line)
        if m:
            pending = int(m.group(1))
            continue
        m = re.search(r'"address"\s*:\s*"([^"]+)"', line)
        if m:
            if m.group(1) == dest and pending and pending > 0:
                block.append(Decimal(pending) / Decimal(10 ** 8))
            pending = None
    if any(per_tx.values()):
        out: List[Decimal] = []
        for _t, vals in per_tx.items():
            out.extend(vals)
        return out

    # FALLBACK for a JoinMarket that reports differently: a line carrying the
    # destination AND an amount together. This was the only path before, and it
    # matches nothing in current JM output -- kept because it costs nothing and
    # a future/older version may emit such a line. Dedup by value here is
    # acceptable: without a txid there is nothing better to key on, and the
    # caller fails loudly on an empty result either way.
    amounts: List[Decimal] = []
    seen = set()
    for line in stdout.splitlines():
        if dest not in line:
            continue
        for m in re.findall(r"(\d+\.\d{1,8})\s*BTC", line, re.I):
            v = Decimal(m)
            if v > 0 and str(v) not in seen:
                seen.add(str(v)); amounts.append(v)
        for m in re.findall(r"(\d{4,})\s*sat", line, re.I):
            v = (Decimal(m) / Decimal(10 ** 8))
            if v > 0 and str(v) not in seen:
                seen.add(str(v)); amounts.append(v)
    return amounts


def create_subs(rpc, n: int, decoys: int) -> tuple:
    """Returns (address_list, {address: (account_index, subaddress_index)},
    decoy_address_set).

    ONE ACCOUNT PER OUTPUT, and this is the pipeline's exit defence.

    These subaddresses are where the mix comes to REST: after the run they are
    what the operator holds and will eventually spend. They all used to live in
    one account, and that made the operator's next action the thing that undid
    the entire mix. Measured on a chain running current consensus, six mix
    outputs in one account:

        "empty this account"   -> ONE transaction, 6 inputs
        "send 5 XMR"           -> ONE transaction, 4 inputs

    A transaction's inputs are public. Spending six outputs together is
    permanent proof that all six have one owner -- no ring analysis needed,
    the input count is right there -- and those six outputs are exactly what
    the peel chain spent six transactions and several hours separating. The
    off-ramp planner does not help: it plans WHERE to sell, not how to spend.

    Giving each output its own account makes the merge IMPOSSIBLE rather than
    merely discouraged, because a Monero transaction cannot spend across
    accounts. Verified: an account holding 1.4 XMR asked for 5 answers "not
    enough money" while a sibling account holds the rest. The same six outputs
    then leave as six 1-in transactions, for about 0.005 XMR more in fees at a
    0.0024 XMR estimate.

    Decoys get their own accounts too. They are FUNDED fan-out outputs -- subs
    is shuffled before the fan-out picks its targets, so a decoy is as likely
    to hold money as any other -- and an output that cannot be merged is the
    point regardless of which list it came from.

    Uses new_subaddress_indexed (not new_subaddress) so each address's
    real subaddress index is known. transfer_split needs that index in
    'subaddr_indices' to actually restrict spending to the one
    subaddress a plan TX names as 'src' -- without it, monero-wallet-rpc
    pools funds from every subaddress in the account and the per-hop
    mixing the DAG plan is built around never happens on-chain.

    SUBADDRESSES ARE CREATED WITH NO LABEL, and that is a security decision.

    They used to be labelled Mix_0..Mix_N and Decoy_0..Decoy_D, defended as
    "LOCAL ONLY -- on-chain every subaddress is an indistinguishable one-time
    key". The on-chain half of that is true and the reassurance is the wrong
    one, because labels are written into the WALLET FILE, and the wallet file
    is the one artifact paranoia_mode deliberately never deletes (it holds the
    money). OPSEC_SETUP.md's accepted worst case is "door kick, they take the
    ThinkPad -- view-only if auto-unlock", i.e. an adversary reading that
    wallet.

    At that point labels hand them the entire answer with no analysis at all:
    which outputs are decoys, which are real mix targets, which are peel
    carriers and in what order, which is the change sweep, and -- via
    "GhostSpiral_entry" -- the name of the tool. Every heuristic this pipeline
    defeats on-chain is bypassed by reading a string.

    Nothing in the toolchain ever reads a label back; they were decoration.
    The plan file carries the roles, and the plan file IS wiped.

    The extra outputs are FUNDED real fan-out outputs, and (since the Kerckhoffs
    pass) they HOP like every other output rather than dead-ending. This
    docstring used to say they "DEAD-END (they never hop)", which was both stale
    and the trace recipe itself: if extra outputs never hop, an analyst who has
    read this file filters the fan-out by "did it move again?" and recovers the
    real mixing path exactly. select_fanout_targets now returns every output as
    a hop source, so that filter selects nothing.
    """
    subs = []
    addr_index = {}
    decoy_addrs = set()
    for i in range(n + decoys):
        acct = create_fresh_account(rpc, label="")
        addr, idx = rpc.new_subaddress_indexed(account_index=acct, label="")
        subs.append(addr)
        addr_index[addr] = (acct, idx)
        if i >= n:
            decoy_addrs.add(addr)
    # PROVE THEY ARE ACTUALLY SEPARATE, rather than assuming the wallet
    # numbered them for us.
    #
    # Stated honestly: this is defence in depth, not a reproduced bug. Real
    # monero-wallet-rpc 0.18.3.1 hands out 1, 2, 3... and no run here has seen
    # otherwise. But the guarantee resting on it is the one this docstring
    # calls the exit defence -- "makes the merge IMPOSSIBLE rather than merely
    # discouraged" -- and it holds ONLY because a Monero transaction cannot
    # spend across accounts. Two outputs that share an account can be merged,
    # and nothing downstream would notice: the run would print the
    # one-account-per-output promise and be wrong.
    #
    # A repeated ADDRESS is worse than a wasted account, and silently so. The
    # dict above is keyed by address, so a duplicate collapses two entries into
    # one while `subs` keeps both -- then fanout_by_addr = dict(zip(dests,
    # amounts)) collapses again and one output's amount is dropped without a
    # word. len(subs) still passes its floor.
    #
    # Every other RPC answer in this toolchain is verified the same way and for
    # the same stated reason (get_subaddress_balance matches the indices it
    # asked about; new_subaddress_indexed checks the address is address-shaped;
    # create_fresh_account refuses a reported index of 0) -- because the wallet
    # is not expected to lie, but the failure mode if it does is the silent
    # kind. Costs one set comparison and no RPC.
    if len(set(subs)) != len(subs):
        integrity_log("stage3", "DUPLICATE_SUBADDRESS")
        sys.exit(
            f"[!] The wallet handed out the same subaddress twice while "
            f"creating {len(subs)} of them.\n"
            f"    Refusing to plan: two mix outputs on one address can be "
            f"spent by ONE transaction,\n"
            f"    which is the merge every output getting its own account "
            f"exists to make impossible —\n"
            f"    and the fan-out would silently drop one output's amount on "
            f"the way there.")
    _accts = [a for a, _ in addr_index.values()]
    if len(set(_accts)) != len(_accts):
        integrity_log("stage3", "DUPLICATE_MIX_ACCOUNT")
        sys.exit(
            f"[!] Two mix subaddresses were created in the SAME wallet "
            f"account.\n"
            f"    Refusing to plan: one account per output is what makes "
            f"merging them impossible\n"
            f"    rather than merely discouraged, and a Monero transaction "
            f"CAN spend two subaddresses\n"
            f"    of one account. The run would report a separation it does "
            f"not have.")
    return subs, addr_index, decoy_addrs


def planned_chunk_count(args, jm_utxos) -> int:
    """How many swap chunks this run will have. Decides the entry-set size.

    THE ENTRY SET HAS TO EXIST BEFORE THE QUOTES, because each chunk's quote
    names its own entry address -- that is the whole point (see
    create_entry_set). So the count is derived here, at stage 3, from the same
    three inputs the stage-2 block uses a moment later to build `btc_chunks`,
    and the two must not drift: a mismatch is caught loudly by
    stage2_get_swap_quotes, which refuses to quote when the number of chunks
    and the number of destinations disagree.

    JoinMarket first, because when it ran its UTXOs ARE the chunks and --split
    is not consulted. Then --btc-amount / --split. Manual mode has no amount
    for --split to divide, so --split there means "I am going to send this many
    swaps by hand" -- and each of those still deserves its own address.

    Never returns less than 1: a run always has one entry.
    """
    if jm_utxos:
        # BOUNDED THE SAME WAY --split IS. resolve_split caps the flag, but a
        # JoinMarket tumbler decides its own UTXO count, so this path could
        # mint an unbounded number of accounts -- and the offline signing
        # wallet derives subaddresses for a bounded number of them (50 by
        # default, measured being passed during the second run;
        # OPSEC_SETUP.md). Past the cap the chunks share entry addresses again,
        # which is the linkage this exists to remove, so refuse rather than
        # silently fold them together.
        n = len(jm_utxos)
        if n > MAX_SPLIT:
            integrity_log("stage1", "jm_utxos_over_split_cap")
            sys.exit(
                f"[!] JoinMarket produced {n} UTXOs, which would mean {n} swap "
                f"chunks and {n} entry\n"
                f"    addresses — above the maximum of {MAX_SPLIT}. Each costs "
                f"a swap fee, a veil transaction\n"
                f"    and a wallet account, and the offline signing wallet "
                f"derives subaddresses for a\n"
                f"    bounded number of accounts (see OPSEC_SETUP.md).\n"
                f"    Run the tumbler with fewer output addresses, or swap in "
                f"more than one run.")
        return max(1, n)
    return max(1, int(getattr(args, "split", 1) or 1))


def refuse_thin_mix(subs: list, entry_addrs, decoy_addrs, wallets: int,
                    num_decoys: int, n_chunks: int) -> None:
    """Refuse a run with fewer mix outputs than swap chunks, BEFORE the swap.

    split_by_weight hands back an EMPTY slice for every chunk it has no
    destination left for ("If there are fewer items than weights the extra
    slices come back empty and the caller has to say so"), and stage 4 answers
    that with sys.exit: "N swap chunk(s) would have no mix subaddress to
    distribute into ... Use more --wallets, or fewer --split chunks."

    Both of those are FLAGS, and the count they decide is known here -- one
    screen after create_subs drew the decoys and establish_entry_set minted the
    entries, and BEFORE stage 2 fetches a quote or prints a deposit address.
    The stage-4 exit is reached only after stage4_await_swap has watched the
    XMR land, so the operator is told to change a flag with their money already
    sitting on entry addresses a public ThorChain memo names, and a send-mode
    re-run mints a NEW entry set rather than adopting those.

    Same family as refuse_peel_multichunk, and the same argument: the answer
    was always knowable before the swap, and only the question was being asked
    late.

    EXACT, not conservative. The decoy count is drawn at random
    (DECOY_MIN..DECOY_MAX) and it is drawn ALREADY by the time this runs, so
    this asks select_fanout_targets -- the same function stage 4 asks, with the
    same four arguments -- rather than bounding it. Nothing is refused that
    would have fitted.

    `decoy_addrs` is threaded through even though select_fanout_targets ignores
    it today ("accepted for signature compatibility but no longer changes
    behaviour"). Passing an empty set instead would be a second call with
    DIFFERENT inputs, and this gate is only worth anything while it cannot
    answer differently from the stage it is standing in front of.

    The one run this newly refuses is one that would have fitted only because
    some of its swaps FAILED TO ARRIVE: select_funded_entries drops an empty
    chunk, so the surviving chunks then fit the slices. That is not a shape to
    preserve, and the remedy costs nothing -- more --wallets works whether the
    chunks arrive or not.
    """
    if n_chunks <= 1:
        return
    _mix = [a for a in subs if a not in set(entry_addrs or ())]
    _dests, _ = select_fanout_targets(_mix, decoy_addrs, wallets, num_decoys)
    if len(_dests) >= n_chunks:
        return
    integrity_log("stage3", "thin_mix_refused")
    sys.exit(
        f"[!] {n_chunks} swap chunks, but only {len(_dests)} mix "
        f"subaddress(es) to distribute into.\n"
        f"    {n_chunks - len(_dests)} chunk(s) would have NOWHERE to go: "
        f"their value would sit on a\n"
        f"    carrier, unmixed, while the run reported success — so this "
        f"refuses to plan it.\n"
        f"\n"
        f"    NOTHING HAS BEEN SWAPPED. No quote has been fetched and no "
        f"deposit address has\n"
        f"    been printed. The same refusal used to happen at the "
        f"distribution, which runs\n"
        f"    AFTER stage 4 has watched the XMR arrive — at which point the "
        f"money is on entry\n"
        f"    addresses the swap memo names in public and a send-mode re-run "
        f"mints new ones.\n"
        f"    Use --wallets {n_chunks} or more, or fewer chunks.")


def refuse_peel_multichunk(args, jm_utxos) -> None:
    """Refuse --peel with more than one swap chunk, BEFORE the swap.

    resolve_split already refuses `--split N --peel` at parse time, and its
    comment says exactly why the answer has to come early: the refusal used to
    live in build_distribution_plan, which "runs after the quotes are fetched,
    after the deposit instructions are printed, and therefore possibly after
    the operator has already sent Bitcoin -- at which point 'refused' means
    their money is mid-swap with no run to receive it."

    IT ONLY CLOSED THE --split DOOR. The chunk count is not --split; it is
    planned_chunk_count, and that function's first line is "JoinMarket first,
    because when it ran its UTXOs ARE the chunks and --split is not consulted".
    So `--peel --joinmarket` with a tumbler that produced two or more UTXOs
    walks straight past the parse-time gate and lands on the stage-4 backstop
    -- after the tumble, after the entry set is minted, after the quotes, after
    the deposit instructions, and after stage4_await_swap has watched the XMR
    arrive. Driven through the shipped functions: resolve_split passes,
    planned_chunk_count returns 3 with --split still 1, and
    build_distribution_plan exits.

    The message it lands on is wrong too. It reads "--split 3 with --peel is
    not supported" and its remedy is "Use --split with the fan-out
    distribution" -- naming a flag this operator never passed, about a count
    they did not choose, so the one instruction they are given does not apply
    to their command line.

    HERE is the earliest moment the answer can be known: the tumbler has run,
    so the UTXO count exists, and nothing Monero-side has been created, no
    quote has been fetched and no deposit address has been printed. The BTC
    tumble is not undone by refusing -- those coins are the operator's and
    were going to be tumbled either way -- but the swap has not started, which
    is the part that cannot be taken back.

    Asks planned_chunk_count rather than re-deriving the count, so this gate
    and the entry set it is protecting cannot answer differently.
    """
    if not getattr(args, "peel", False):
        return
    n = planned_chunk_count(args, jm_utxos)
    if n <= 1:
        return
    integrity_log("stage1", "peel_multichunk_refused")
    # `n`, not args.split: planned_chunk_count normalises None and 0 to 1, so
    # reading the flag back here could print "--split None".
    _why = (f"JoinMarket's tumble produced {len(jm_utxos)} UTXOs, so this run "
            f"has {n} swap chunks"
            if jm_utxos else
            f"--split {n} gives this run {n} swap chunks")
    sys.exit(
        f"[!] --peel needs a SINGLE swap chunk, and {_why}.\n"
        f"    Each chunk needs its own peel chain — merging them into one "
        f"would re-create\n"
        f"    exactly the convergence that splitting the swap exists to avoid "
        f"— and a peel\n"
        f"    chain is sequential and confirmation-gated, so {n} of them would "
        f"take\n"
        f"    {n} x hops x ~20 minutes with no resume if one stops part-way.\n"
        f"\n"
        f"    NOTHING HAS BEEN SWAPPED. No quote has been fetched, no deposit "
        f"address has been\n"
        f"    printed and no Monero has moved — this stops here rather than "
        f"at the distribution,\n"
        f"    which is after the swap has landed.\n"
        f"    Drop --peel for the fan-out distribution, which handles "
        f"{n} chunks, or run the\n"
        f"    tumbler with a single output address and swap the rest in "
        f"another run.")


def create_entry_set(rpc, n: int) -> list:
    """Mint N entry subaddresses, ONE PER SWAP CHUNK. Returns [(addr, acct, idx)].

    ONE ENTRY ADDRESS CANNOT SERVE N SWAPS, and routing them to one was the
    audit's G5. A swap's settlement transaction is public, so each chunk hands
    an analyst exactly ONE known on-chain output. Land all N on one subaddress
    and the veil's sweep_all spends them in a single transaction whose N input
    rings each contain one of those known outputs; intersecting N sets of
    sixteen identifies that transaction, and with it the carrier the whole run
    then spends from. See the INVARIANT note on build_entry_veils.

    It also un-fixes two things that are already meant to be fixed elsewhere:
    the aggregator sees N deposits routed to one Monero address and links the
    payments (thor_swap_preparer.resolve_destinations refuses exactly this),
    and the per-chunk NEWNYM rotation becomes theatre because every request
    body still carries the same unique 95-character destination.

    EACH IN ITS OWN FRESH ACCOUNT, for the reason create_subs gives: a Monero
    transaction cannot spend across accounts, so nothing later can merge two
    chunks by accident. It matters more here than for a mix output, because
    merging two ENTRY outputs is the exact attack above.

    Verified separate rather than assumed, the same way create_subs does it --
    a duplicated address would collapse the (addr -> pair) mapping while the
    list kept both, and the chunk whose entry vanished would be quoted to an
    address nothing waits on.
    """
    entries = []
    for _ in range(max(1, int(n))):
        acct = create_fresh_account(rpc, label="")
        addr, idx = rpc.new_subaddress_indexed(account_index=acct, label="")
        entries.append((addr, acct, idx))
    _addrs = [a for a, _, _ in entries]
    if len(set(_addrs)) != len(_addrs):
        integrity_log("stage3", "DUPLICATE_ENTRY_SUBADDRESS")
        sys.exit(
            f"[!] The wallet handed out the same entry subaddress twice while "
            f"creating {len(entries)} of them.\n"
            f"    Refusing to plan: two swap chunks would be quoted to one "
            f"address, which is the\n"
            f"    linkage --split exists to avoid, and the chunk whose entry "
            f"vanished would have\n"
            f"    nothing waiting on it.")
    _accts = [c for _, c, _ in entries]
    if len(set(_accts)) != len(_accts):
        integrity_log("stage3", "DUPLICATE_ENTRY_ACCOUNT")
        sys.exit(
            f"[!] Two entry subaddresses were created in the SAME wallet "
            f"account.\n"
            f"    Refusing to plan: one transaction can spend two subaddresses "
            f"of one account, so\n"
            f"    two swap chunks could be merged — which is the intersection "
            f"attack --split N is\n"
            f"    being fixed to prevent.")
    return entries


def entry_addrs(entries: list) -> list:
    """Just the addresses, in chunk order."""
    return [a for a, _, _ in entries]


def entry_pairs(entries: list) -> list:
    """Just the (account, index) pairs, in chunk order."""
    return [(c, i) for _, c, i in entries]


def _src_index(addr_index: dict, addr: str) -> int:
    """Resolve a source address to its real subaddress index, or abort.

    transfer_split gets this in 'subaddr_indices' to restrict spending to
    exactly the one subaddress the plan names as 'src'. A silent fallback
    to 0 here would instead spend from the primary subaddress (which holds
    the bulk of the funds) -- the OPPOSITE of the intended per-hop mixing,
    and invisible to the operator. Every source we plan is created in
    create_subs (or is ENTRY, set explicitly above), so a miss is a real
    internal bug: fail loudly rather than silently spend the wrong output.
    """
    if addr not in addr_index:
        integrity_log("stage4", "src_index_missing")
        sys.exit(
            f"[!] Internal error: no subaddress index recorded for source "
            f"{scrub_address(addr)}. Refusing to build a TX that could spend "
            f"from the wrong subaddress."
        )
    return addr_index[addr][1]


def _src_account(addr_index: dict, addr: str) -> int:
    """Resolve a source address to the ACCOUNT that holds it.

    Every planned source lives in its own account now (see create_subs), so a
    subaddress index alone no longer identifies an output: index 1 exists in
    every one of them. Spending the right index in the wrong account is the
    failure this exists to prevent, and it is silent -- the wallet would
    happily spend some other output of the same index.
    """
    _src_index(addr_index, addr)          # shared not-found abort
    return addr_index[addr][0]


def xmr_balance(rpc_primary, bal_account: int,
                entry_index: int) -> tuple[Decimal, Decimal]:
    """Return (total, unlocked) for ENTRY's subaddress in XMR.

    Scoped to ENTRY's subaddress index, NOT the whole account. Fan-out
    spends only from ENTRY (transfer_split subaddr_indices=[entry_index]),
    so sizing the plan off an account-wide balance that also counted funds
    parked on other subaddresses would let fanout_amt exceed what ENTRY can
    actually spend, and every fan-out TX would fail 'not enough money'.
    A refresh is forced first so freshly-arrived outputs are reflected.
    """
    try:
        rpc_primary.raw_request("refresh", {})
    except Exception:
        pass  # refresh is best-effort; background sync still applies
    tot_atomic, unlk_atomic = rpc_primary.get_subaddress_balance(bal_account, entry_index)
    total = Decimal(str(tot_atomic)) / Decimal(10 ** 12)
    unlocked = Decimal(str(unlk_atomic)) / Decimal(10 ** 12)
    return total, unlocked


def entry_set_balances(rpc_primary, pairs: list, on_unreadable=None) -> list:
    """[(total, unlocked)] in XMR, one per entry subaddress, in chunk order.

    The distribution needs the BREAKDOWN, not just the sum: with --split N each
    chunk is veiled into its own carrier and funds its own fan-out, so each
    carrier's slice of the mix targets has to be sized from the chunk that
    actually landed on it. Chunks are not equal -- quotes differ, and
    JoinMarket's UTXOs differ by design -- so sizing them equally would plan a
    fan-out one carrier cannot afford and leave another under-spent.

    An unreadable subaddress reads as zero rather than aborting: this is used
    inside a poll loop, and under-reporting only makes the arrival gate
    stricter. get_subaddress_balance already refuses to report another
    address's balance as this one's.

    BUT "READ AS ZERO" IS NOT "IS ZERO", and for a long time nothing here
    could tell the two apart. That is safe for the arithmetic and unsafe for
    everything that reads the arithmetic:

      * In the arrival wait, a wallet-rpc that answers nothing at all -- a
        dropped socket, a wallet mid-rescan, the wrong --rpc-primary port --
        produced a wait that is INDISTINGUISHABLE from a swap that never
        settled. The operator saw "unlocked 0 XMR · 0.0%" every five minutes
        and was finally told the swap stalled, which sends them to look at
        ThorChain. The money may have been sitting on ENTRY the whole time.
        wait_for_swap_arrival has always had the right branch for this ("wallet-
        rpc did not answer this tick") -- but this function caught the
        exception one level BELOW it, so that branch was unreachable from the
        only caller that matters. A dead safety net.
      * At the one-shot read that feeds select_funded_entries, a single failed
        poll makes a FULLY FUNDED chunk look unarrived; it is dropped from the
        distribution, the run announces "1 of 4 swap chunk(s) have NOT
        arrived" -- untrue -- and that chunk's money stays on ENTRY, unmixed,
        for a run that reports success on the rest.

    So the zero stays (the gate must not open on a guess) and the FACT of the
    failure now escapes, via on_unreadable(acct, idx, exc). Default None is
    exactly the old behaviour, which is what the existing callers and the
    "an unreadable entry reads as ZERO" test still assert.
    """
    out = []
    try:
        rpc_primary.raw_request("refresh", {})
    except Exception as _re:                                 # noqa: BLE001
        # Best-effort in the sense that background sync may still apply -- but
        # if the wallet is not reaching its daemon then nothing is syncing and
        # every balance below is stale. Reported through the same channel
        # rather than silently passed; the caller decides whether one stale
        # tick matters.
        if on_unreadable is not None:
            on_unreadable(None, None, _re)
    for acct, idx in pairs:
        try:
            tot_atomic, unlk_atomic = rpc_primary.get_subaddress_balance(
                int(acct), int(idx))
        except Exception as _be:                             # noqa: BLE001
            out.append((Decimal(0), Decimal(0)))
            if on_unreadable is not None:
                on_unreadable(int(acct), int(idx), _be)
            continue
        out.append((Decimal(str(tot_atomic or 0)) / Decimal(10 ** 12),
                    Decimal(str(unlk_atomic or 0)) / Decimal(10 ** 12)))
    return out


def split_by_weight(items: list, weights: list) -> list:
    """Partition `items` into len(weights) contiguous slices sized by weight.

    Every slice gets at least one item, because a carrier with no destinations
    has nothing to distribute into and its chunk would sit on the carrier
    unmixed -- which is the failure this whole path exists to avoid. If there
    are fewer items than weights the extra slices come back empty and the
    caller has to say so rather than silently dropping a chunk.

    Contiguous rather than round-robin because the caller's list is already
    shuffled (select_fanout_targets works on a pre-shuffled mix_targets), so a
    slice is a random sample either way -- and contiguity keeps the mapping
    obvious when a plan is read back by hand.
    """
    n = len(weights)
    if n <= 1:
        return [list(items)]
    if len(items) < n:
        return [[it] for it in items] + [[] for _ in range(n - len(items))]
    total = sum(weights) or 1
    counts = []
    for w in weights:
        counts.append(max(1, int(Decimal(len(items)) * Decimal(str(w))
                                 / Decimal(str(total)))))
    # Reconcile: give or take from the largest slices so the counts sum exactly.
    while sum(counts) > len(items):
        counts[counts.index(max(counts))] -= 1
    while sum(counts) < len(items):
        counts[counts.index(min(counts))] += 1
    out, pos = [], 0
    for c in counts:
        out.append(list(items[pos:pos + c]))
        pos += c
    return out


def entry_set_balance(rpc_primary, pairs: list, on_unreadable=None) -> tuple:
    """(total, unlocked) summed across every entry subaddress, in XMR.

    With --split N the swap arrives as N payments to N DIFFERENT addresses
    (create_entry_set), so "has the swap arrived" is a question about the SUM.
    Polling one of them would finish as soon as one chunk landed -- which is
    the first-chunk defect stage4_await_swap was written to remove, reopened
    one level up.

    An unreadable subaddress contributes NOTHING rather than aborting: the wait
    is a poll loop that must survive a transient RPC hiccup, and reporting less
    than has arrived only makes the gate stricter. get_subaddress_balance
    already refuses to report another address's balance as this one's.
    """
    rows = entry_set_balances(rpc_primary, pairs, on_unreadable)
    return (sum((t for t, _ in rows), Decimal(0)),
            sum((u for _, u in rows), Decimal(0)))


def arrival_blindness_note(arrival: dict) -> str:
    """A line to append when a shortfall may be the WALLET, not the swap.

    Every non-'funded' arrival verdict is reported to the operator as a fact
    about the swap. That wording is only earned when the wallet was actually
    answering. A wallet-rpc that failed some or all of the polls produces the
    same verdict from the same code path, and the operator is then told to go
    and look at ThorChain for money that never left their own wallet's view.

    Returns "" when every poll was answered, so the common case is unchanged.
    """
    polls = int(arrival.get("polls") or 0)
    errs = int(arrival.get("poll_errors") or 0)
    if not errs or not polls:
        return ""
    if errs >= polls:
        return (f"\n    THE WALLET WAS NOT READABLE. All {polls} balance "
                f"poll(s) failed\n"
                f"    ({str(arrival.get('last_error') or '')[:120]}), so this "
                f"run never saw ENTRY at all\n"
                f"    and the shortfall above is NOT evidence about the swap. "
                f"Check wallet-rpc\n"
                f"    first — the money may already be there.")
    return (f"\n    NOTE: {errs} of {polls} balance poll(s) FAILED "
            f"({str(arrival.get('last_error') or '')[:120]}),\n"
            f"    so the figure above may be lower than what is really on "
            f"ENTRY. Check\n"
            f"    wallet-rpc before concluding the swap is short.\n")


def entry_balance_reader(rpc_primary, pairs: list, echo=print, clock=None):
    """A balance_fn for wait_for_swap_arrival that cannot go silently blind.

    Returns a zero-argument callable with the same (total, unlocked) contract
    the wait already expects, so the wait's own logic is untouched.

    WHY THIS EXISTS AT ALL. The wait polls for hours; the thing it polls is a
    wallet-rpc on the other end of a socket. entry_set_balances treats an
    unreadable subaddress as zero, deliberately -- see its docstring -- and
    with a bare `lambda: entry_set_balance(...)` as the balance_fn that made a
    completely dead wallet look exactly like a swap that had not settled:

        [*] still waiting for the swap - unlocked 0 XMR . 4 to go (0.0%) . 5 min
        [*] still waiting for the swap - unlocked 0 XMR . 4 to go (0.0%) . 10 min
        ...
        [!] The expected XMR has NOT fully arrived (nothing new arrived).

    Every word of that is about ThorChain. None of it is about the wallet, and
    the wallet was the problem. Driven against an RPC that raises on every
    call, which is what a dropped socket or a wrong --rpc-primary port is.

    Two failure shapes, two different answers:

      TOTAL blindness (every pair unreadable, and there is at least one pair)
        -- RAISE. wait_for_swap_arrival already handles a raising balance_fn
        correctly: it logs arrival_poll_error, prints "wallet-rpc did not
        answer this tick", KEEPS the previous total rather than re-anchoring
        the stall clock on a phantom drop to zero, and polls again. That
        branch was written for exactly this and was unreachable. This makes it
        reachable instead of adding a second, parallel one.

      PARTIAL blindness (some pairs read, some did not) -- return the partial
        sum, because under-reporting keeps the gate strict, and SAY SO. The
        sum is now lower than the truth, so the gate will not open when it
        should; the operator needs to know the shortfall may be the socket
        rather than the swap.

    Rate-limited to one line per UNREADABLE_REPORT_S, for the reason the
    heartbeat is time-based: at a 30s poll a permanently half-dead wallet
    would otherwise push every real event out of the console's line buffer.
    """
    # `None`, NOT 0.0, and the difference is a fresh boot.
    #
    # time.monotonic() is CLOCK_MONOTONIC on Linux -- seconds since BOOT, not
    # since the epoch. Starting the rate-limiter at 0.0 makes the first tick
    # ask "is the host older than UNREADABLE_REPORT_S?" instead of "have I
    # reported yet?", so within ten minutes of boot the FIRST warning is
    # suppressed entirely. Driven against the shipped reader with one of three
    # entry addresses unreadable:
    #
    #     host up    5s   reports 7 XMR of 10, SILENT
    #     host up  599s   reports 7 XMR of 10, SILENT
    #     host up  601s   reports 7 XMR of 10, warns
    #
    # The total is the same either way; the line is the ONLY thing that says
    # the missing 3 XMR was unreadable rather than absent, and this feeds the
    # swap-arrival gate, where "less than expected" reads as a short swap.
    # Ten minutes after boot is exactly when a run starts on the freshly
    # booted machine this toolchain is meant to be run from.
    #
    # The sibling limiter in wait_for_swap_arrival already gets this right and
    # says so -- "FIRST one immediately, then at most one per
    # UNREADABLE_REPORT_S" -- with a None sentinel. This is that, here.
    #
    # (Found because the offline suite went red on a container that had been
    # up for four minutes, and green on the same tree ten minutes later.)
    # `clock` is injected for the same reason wait_for_swap_arrival takes one:
    # the branch below is a TIME decision, and a test that cannot move the
    # clock can only assert it on whatever the host happens to read -- which
    # is precisely how the bug above survived.
    state = {"beat": None, "clock": clock or time.monotonic}

    def _read():
        blind = []
        stale = []

        def _note(acct, idx, exc):
            (stale if acct is None else blind).append((acct, idx, exc))

        rows = entry_set_balances(rpc_primary, pairs, _note)
        if pairs and len(blind) == len(pairs):
            # Every single one. Let it out; the wait knows what to do with it.
            integrity_log("stage4", "arrival_entry_all_unreadable")
            raise RuntimeError(
                f"all {len(pairs)} entry address(es) unreadable: "
                f"{str(blind[0][2])[:60]}")
        now = state["clock"]()
        if (blind or stale) and (state["beat"] is None
                                 or now - state["beat"] >= UNREADABLE_REPORT_S):
            state["beat"] = now
            if blind:
                integrity_log("stage4", "arrival_entry_partly_unreadable")
                echo(f"  [!] {len(blind)} of {len(pairs)} entry address(es) "
                     f"could NOT be read this tick "
                     f"({str(blind[0][2])[:50]}); the total below is therefore "
                     f"LOWER than what may actually be on ENTRY. If this "
                     f"persists, the shortfall is your wallet-rpc, not the "
                     f"swap.")
            else:
                integrity_log("stage4", "arrival_refresh_failed")
                echo(f"  [!] The wallet would not refresh this tick "
                     f"({str(stale[0][2])[:50]}); balances may be stale. If "
                     f"this persists the wallet is not reaching its daemon, "
                     f"and no arrival will ever be seen.")
        return (sum((t for t, _u in rows), Decimal(0)),
                sum((u for _t, u in rows), Decimal(0)))

    return _read


def read_entry_balances_strict(rpc_primary, pairs: list, what: str,
                               attempts: int = 3, sleep_fn=None) -> list:
    """entry_set_balances for a DECISION, not for a poll. Fails closed.

    The poll loop can afford to under-report: it just polls again. The read
    that feeds select_funded_entries cannot, and that is where treating an
    unreadable subaddress as an empty one costs real money.

    select_funded_entries drops every entry whose unlocked balance is at or
    below dust and continues with the rest. That is right for a swap chunk
    that genuinely never landed. Fed a zero that is really an RPC failure, it
    drops a chunk that is FULLY FUNDED: the distribution never sizes a slice
    for it, no fan-out spends it, and it sits on ENTRY -- the address the swap
    memo names in public -- unmixed, while the run prints

        [!] 1 of 4 swap chunk(s) have NOT arrived on their entry address.

    which is false, and finishes reporting success on the other three. One
    dropped RPC read, one quarter of the money left behind and mislabelled.

    So: retry, and if a subaddress is still unreadable, stop. Nothing has been
    spent at this point in the run -- this read happens before the veil -- so
    aborting costs the operator a re-run and keeps every chunk recoverable,
    which is strictly better than silently mixing three quarters of it.
    """
    sleep_fn = sleep_fn or time.sleep
    last = []
    for attempt in range(1, max(1, int(attempts)) + 1):
        bad = []
        rows = entry_set_balances(
            rpc_primary, pairs,
            lambda a, i, e: bad.append((a, i, e)) if a is not None else None)
        if not bad:
            return rows
        last = bad
        if attempt < attempts:
            print(f"  [!] {len(bad)} of {len(pairs)} entry address(es) could "
                  f"not be read ({what}); retrying "
                  f"({attempt}/{attempts - 1}).")
            sleep_fn(min(10, 2 ** attempt))
    integrity_log("stage4", "entry_balance_unreadable_abort")
    sys.exit(
        f"[!] {len(last)} of {len(pairs)} entry address(es) could not be read "
        f"from wallet-rpc ({str(last[0][2])[:80]}).\n"
        f"    NOTHING HAS BEEN SPENT. This read decides which swap chunks the "
        f"run distributes,\n"
        f"    and an unreadable address is indistinguishable from an empty "
        f"one: continuing would\n"
        f"    drop a chunk that is fully funded, leave its money on ENTRY "
        f"unmixed, and tell you\n"
        f"    it never arrived. Fix the wallet-rpc connection and run again — "
        f"every chunk is\n"
        f"    still where the swap put it.")


def swap_expected_total(deposits: list) -> tuple:
    """How much XMR this run is waiting for.
    Returns (total, n_unreadable, per_chunk_amounts).

    Sums the quoted output of EVERY chunk, because that -- not the first
    deposit to settle -- is what "the swap arrived" means under --split N.

    An unreadable quote contributes nothing and is COUNTED, so the caller can
    say so out loud. stage2_get_swap_quotes already warns when it cannot read a
    route's expected output, but that warning scrolls past hours before this
    number is used, and a target silently built from 2 of 3 chunks is a target
    the run will reach while a third of the money is still in flight -- which
    is the exact failure the summed target exists to prevent. Same reasoning as
    receive_watch.expected_total, which returns (total, unreadable).

    The per-chunk amounts come back too, and they are not decoration: the gate
    has to know the SMALLEST chunk, not just how many there are. See
    swap_arrival_floor.

    The body is gs_common.sum_quoted_xmr, SHARED with receive_watch. These were
    two separate implementations of the same function, and fixing this one left
    receive_watch's holding every defect it started with -- a NaN quote raising
    out of it, an Infinity quote summed as readable. Two copies is what let
    them drift.
    """
    return sum_quoted_xmr(deposits)


def swap_arrival_step(target: Decimal, dust: Decimal = DUST_XMR) -> Decimal:
    """The smallest increase that counts as another chunk arriving.

    Anything smaller does not restart the stall clock. ENTRY is not a secret --
    the swap memo names it in plaintext and the sender puts that memo in a
    Bitcoin OP_RETURN -- so without this floor anyone reading the BTC chain
    could hold the wait open indefinitely with periodic dust, and the run would
    sit at stage 4 believing more of its own money was still on the way.
    """
    if target > 0:
        return max(dust, target * SWAP_ARRIVAL_STEP_FRACTION)
    return dust


def wait_for_swap_arrival(balance_fn, floor_: Decimal, chunks: int,
                          stall_s: int = XMR_ARRIVAL_STALL,
                          timeout_s: int = XMR_ARRIVAL_TIMEOUT,
                          poll_s: int = XMR_ARRIVAL_POLL,
                          step: Decimal = None, dust: Decimal = DUST_XMR,
                          sleep_fn=None, clock=None,
                          echo=print) -> dict:
    """Wait for ALL of the swapped XMR to arrive and unlock on ENTRY.

    Returns a result dict rather than falling through, so the caller has to
    decide what a shortfall means instead of inheriting one silently.
    Outcomes: 'funded' (>= floor_, unlocked), 'stalled' (nothing new for a full
    stall window), 'timeout' (the absolute cap), 'interrupted'.

    THE GATE IS THE SUMMED TARGET, NOT "SOME MONEY IS HERE". This loop used to
    be `while unlocked <= DUST_XMR`, which is the right test for exactly one
    swap and wrong for every other case. With --split N the operator makes N
    separate BTC deposits, ThorChain settles them independently, and their XMR
    lands on ENTRY minutes to hours apart -- so the old gate opened on chunk 1
    of N. Everything downstream then sized itself from that fraction: the entry
    veil swept it, the distribution spread it, and chunks 2..N arrived on an
    ENTRY that the run had already finished with. They were never mixed. The
    exit found them sitting there and swept them out, one transaction each,
    from the address the swap memo publicly names straight to --exit-to. The
    run's whole purpose is to break that link and it re-created it, for the
    majority of the money, whenever --split was used.

    `floor_` <= 0 means no target could be built (manual mode, or every quote
    unreadable) and the old dust gate is all that is available. The caller must
    say so; this cannot tell chunk 1 from chunk N without a number to compare
    against.
    """
    if step is None:
        step = swap_arrival_step(floor_ if floor_ > 0 else Decimal(0), dust)
    # Resolved HERE, not in the signature. `sleep_fn=time.sleep` as a default
    # binds the real function when this module is imported, so a caller that
    # cannot pass them -- stage4_await_swap does not -- was untestable: a test
    # replacing the module's `time` got the captured originals and slept for
    # real. That is how the orchestration around this loop came to have no test
    # at all while the loop itself had thirty.
    sleep_fn = sleep_fn or time.sleep
    clock = clock or time.monotonic
    started = clock()
    # The total as of the last MEANINGFUL arrival -- compared against this and
    # not against the previous tick, so a long run of sub-step increments that
    # add up to a real chunk still restarts the clock. Same reasoning as
    # receive_watch's marked_total.
    marked = Decimal(0)
    last_arrival = started
    last_beat = started
    total = unlocked = Decimal(0)
    locked_reported = False
    # HOW MUCH OF THIS WAIT WAS BLIND, carried out in the result.
    #
    # Every non-'funded' outcome here is worded by the caller as a statement
    # about the SWAP -- "nothing new arrived", "the time limit was reached" --
    # and those are the right words only when the wallet was actually being
    # read. A wallet-rpc that answered nothing for two hours produces the
    # identical verdict, and sends the operator to go looking at ThorChain for
    # money that is sitting on ENTRY. The counts go back so the caller can tell
    # the two apart instead of guessing.
    polls = poll_errors = 0
    last_err = ""
    last_err_beat = None
    while True:
        if shutdown_requested():
            return {"state": "interrupted", "total": total, "unlocked": unlocked,
                    "polls": polls, "poll_errors": poll_errors,
                    "last_error": last_err}
        polls += 1
        try:
            total, unlocked = balance_fn()
        except Exception as e:                               # noqa: BLE001
            # Transient by assumption: a wallet that is momentarily busy or
            # resyncing is normal across a multi-hour wait, and dropping the
            # run over one bad poll would lose hours for nothing.
            poll_errors += 1
            last_err = str(e)
            integrity_log("stage4", "arrival_poll_error")
            # FIRST one immediately, then at most one per UNREADABLE_REPORT_S.
            # Unrate-limited, a wallet that is down for the whole stall window
            # printed this every XMR_ARRIVAL_POLL seconds -- 240 identical
            # lines across a two-hour stall, which is exactly the flood the
            # heartbeat was made time-based to avoid, and it buries the run's
            # real events in the console's line buffer.
            _now = clock()
            if last_err_beat is None or _now - last_err_beat >= UNREADABLE_REPORT_S:
                _rep = ("" if last_err_beat is None else
                        f" [{poll_errors} failed poll(s) so far]")
                last_err_beat = _now
                # 200, not 50. This line is the ONLY thing that tells the
                # operator a multi-hour wait is stuck on their wallet rather
                # than on the swap, and 50 characters truncated the reason away
                # -- "could not be read (" reads as if there were no reason at
                # all. The chain log above still records only the FACT; this
                # goes to the terminal.
                echo(f"  [!] wallet-rpc did not answer this tick "
                     f"({str(e)[:200]}); retrying.{_rep}")

        if unlocked > dust and (floor_ <= 0 or unlocked >= floor_):
            return {"state": "funded", "total": total,
                    "unlocked": unlocked, "polls": polls,
                    "poll_errors": poll_errors, "last_error": last_err}

        if total - marked >= step:
            marked = total
            last_arrival = clock()
            if floor_ > 0:
                echo(f"  [*] {total} XMR on ENTRY so far, of ~{floor_} needed "
                     f"across {chunks} chunk(s); still waiting.")
            else:
                echo(f"  [*] {total} XMR on ENTRY so far; still waiting.")
        elif total < marked:
            # RE-ANCHOR ON A DECREASE. `marked` only ever moved up, so one
            # transient low reading -- a wallet mid-rescan, a reorg, an RPC
            # answering from a stale cache -- permanently raised the bar for
            # what counts as the next arrival: every later chunk was measured
            # against a total the wallet no longer reported, the step was never
            # cleared again, and the run stalled out with money still landing.
            # receive_watch's loop has carried this branch for the same reason.
            marked = total
            last_arrival = clock()
        elif total > dust and unlocked <= dust and not locked_reported:
            echo(f"  [*] Seen {total} XMR total; waiting for it to unlock...")
            locked_reported = True


        now = clock()
        # A HEARTBEAT, because silence here is indistinguishable from a dead run.
        #
        # Every branch above prints only when something CHANGES. While a
        # cross-chain swap is still settling -- which is the entire purpose of
        # this wait, and routinely takes hours -- nothing changes, so this loop
        # printed NOTHING for up to XMR_ARRIVAL_TIMEOUT (24 hours). An operator
        # watching the console saw a pane that had not moved since the run
        # started, with no way to tell "waiting" from "hung", right after
        # sending real BTC. That is the moment they most need to see the run is
        # alive.
        #
        # receive_watch answers the same question and has always echoed
        # progress_line on EVERY poll; the console even documents tuning its
        # output buffering around that cadence. Stage 4 was the waiter that
        # stayed quiet. Same shared helper now, so the two cannot describe the
        # same balance differently.
        #
        # Time-based rather than every poll: at a 30s poll that would be ~2900
        # lines over a full 24-hour wait, which pushes the run's real events out
        # of the console's line buffer. Every ARRIVAL_HEARTBEAT_S keeps it
        # obviously alive without burying anything.
        if now - last_beat >= ARRIVAL_HEARTBEAT_S:
            last_beat = now
            echo(f"  [*] still waiting for the swap — "
                 f"{progress_line(unlocked, total, floor_)}"
                 f" · {int((now - started) // 60)} min elapsed")
        if now - started >= timeout_s:
            return {"state": "timeout", "total": total,
                    "unlocked": unlocked, "polls": polls,
                    "poll_errors": poll_errors, "last_error": last_err}
        # The stall clock runs from the start too, so a swap that is never sent
        # at all fails in one stall window rather than holding the run for the
        # full absolute cap.
        if now - last_arrival >= stall_s:
            return {"state": "stalled", "total": total,
                    "unlocked": unlocked, "polls": polls,
                    "poll_errors": poll_errors, "last_error": last_err}
        sleep_fn(poll_s)


def stage1_joinmarket(args, btc_addr: str) -> List[Decimal]:
    if not args.joinmarket:
        integrity_log("stage1", "JM_skipped")
        return []
    if not args.joinmarket_wallet:
        sys.exit("[!] --joinmarket-wallet required when --joinmarket is set")
    # THE OLD INVOCATION COULD NOT HAVE RUN. Checked against JoinMarket-Org/
    # joinmarket-clientserver at HEAD, not from memory:
    #
    #   1. it ran "tumble.py". The script is scripts/tumbler.py. There is no
    #      tumble.py in the project.
    #   2. it passed --socks5-host/--socks5-port. get_tumbler_parser() defines
    #      no such options -- it has no socks, tor or proxy option at all, and
    #      JoinMarket takes its Tor settings from joinmarket.cfg. The comment
    #      beside the flags said exactly that and then passed them anyway.
    #      optparse exits on an unknown option, so this died before doing
    #      anything.
    #   3. it passed "all" as a third positional. The usage is
    #      "[wallet file] [destaddr(s)...]", so args[1:] are DESTINATIONS and
    #      each is run through validate_address -- "all" fails that. There is
    #      no positional amount/sweep argument; the schedule is controlled by
    #      --mixdepth and friends.
    #
    # So: the real script name, no invented flags, and destinations only.
    #
    # --yes for the confirmations JoinMarket can ask. It is NOT sufficient on
    # its own: tumbler.py guards its miner-fee question with `not
    # options['restart']` rather than answeryes, so a bare input() still runs
    # when expected fees exceed 5% of the tumble. Under the old call --
    # capture_output=True with INHERITED stdin -- that prompt would sit unread
    # for the full 3600s timeout. stdin=DEVNULL turns it into an immediate
    # EOFError and a loud non-zero exit, which the handler below reports.
    #
    # NOT VALIDATED END TO END HERE. Running a real tumble needs a JoinMarket
    # install, a Bitcoin node and live maker counterparties, which is outside
    # what this work is allowed to touch. The invocation is corrected against
    # upstream's actual CLI; it is not claimed to be exercised.
    # THE ADDRESS IS ON THE CHILD'S ARGV, AND CANNOT NOT BE.
    #
    # tumbler.py takes the destination positionally; there is no environment or
    # stdin form to use instead, and this toolchain does not get to change a
    # third-party CLI. So for as long as the tumble runs -- upstream's own
    # default schedule is hours -- the operator's Bitcoin address sits in
    # /proc/<pid>/cmdline at mode 0444, readable by every account on the host.
    #
    # That is the exact exposure GS_BTC_ENTRY exists to prevent, and
    # _child_env's default-deny (which strips every GS_ variable from this very
    # call) does nothing about it: the environment was only ever half the
    # channel. Said out loud rather than left for someone to find in `ps`,
    # because the rest of the toolchain's promise not to put this value on a
    # command line does not hold here.
    print("  [!] JoinMarket's tumbler takes the destination address on its "
          "COMMAND LINE, so your BTC address is readable via ps and "
          "/proc/<pid>/cmdline (mode 444) for the whole tumble. Nothing here "
          "can change that — it is upstream's CLI. Run this on a host where "
          "you are the only user.")
    integrity_log("stage1", "JM_dest_on_child_argv")
    try:
        result = subprocess.run(
            [args.joinmarket_python, args.joinmarket_tumbler,
             "--yes",
             args.joinmarket_wallet, btc_addr],
            check=True, capture_output=True, text=True, timeout=3600,
            stdin=subprocess.DEVNULL,
            env=_child_env(),   # third-party child: password scrubbed
        )
        integrity_log("stage1", "JM_tumble_OK")
        # Recover the BTC amounts the tumbler sent to btc_addr and hand them
        # to Stage 2 as the chunks to swap. If the tumble ran but nothing is
        # parseable, FAIL LOUDLY -- the old code returned [] here and the
        # pipeline silently continued as though JoinMarket contributed
        # nothing, which is worse than stopping.
        amounts = parse_jm_amounts(result.stdout, btc_addr)
        if amounts:
            integrity_log("stage1", f"JM_parsed:{len(amounts)}_outputs")
            print(f"  [+] JoinMarket sent {len(amounts)} output(s) totaling "
                  f"{sum(amounts)} BTC to {scrub_address(btc_addr)}")
            return amounts
        integrity_log("stage1", "JM_parse_empty")
        sys.exit(
            "[!] JoinMarket tumble completed but no output amount could be\n"
            "    parsed from its result. Refusing to continue as if the tumble\n"
            "    fed nothing into the pipeline. Inspect tumbler.py output; if the\n"
            "    coins did move, re-run supplying the tumbled total via\n"
            "    --btc-amount, or update parse_jm_amounts for your JM version."
        )
    except subprocess.TimeoutExpired:
        integrity_log("stage1", "JM_timeout")
        sys.exit("[!] JoinMarket tumble timed out after 1 hour")
    except FileNotFoundError:
        integrity_log("stage1", "JM_not_found")
        # Name what was actually looked for and how to point at it. This said
        # "tumble.py not found", a file JoinMarket does not ship, so an
        # operator who HAD installed JoinMarket correctly was told their
        # install was missing.
        sys.exit(f"[!] Could not run {args.joinmarket_tumbler!r} with "
                 f"{args.joinmarket_python!r}. JoinMarket ships this as "
                 f"scripts/tumbler.py inside its own virtualenv — pass "
                 f"--joinmarket-tumbler /path/to/scripts/tumbler.py and "
                 f"--joinmarket-python /path/to/jmvenv/bin/python.")
    except subprocess.CalledProcessError as e:
        integrity_log("stage1", f"JM_fail:{e.returncode}")
        # optparse exits 2 on an unknown option, and tumbler.py exits on a
        # destination that fails validate_address. Both used to be produced by
        # this function's own argv rather than by anything the operator did.
        # PRINT IT, DO NOT POINT AT IT. This said "its stderr is above" while
        # the call three hundred lines up passes capture_output=True, which
        # sets stdout and stderr to PIPE -- so nothing was above, and the
        # operator was told to read something that did not exist. That leaves
        # them with an exit code and no way to tell a moved CLI flag from a
        # wallet that would not open.
        #
        # Redacted rather than raw: the tumbler echoes destination addresses
        # in its own errors, and this line reaches a terminal.
        #
        # terminal_safe, NOT chain_safe: a tumbler failure is diagnosed from
        # its line numbers, ports and exit codes, and chain_safe turns every
        # one of them into '#' -- `File "tumbler.py", line 412` becomes
        # `line #`. Addresses and MACs are still removed.
        _jm_err = terminal_safe((e.stderr or e.stdout or "").strip())[-800:]
        sys.exit(f"[!] JoinMarket tumble failed (exit {e.returncode}).\n"
                 f"    Its output was captured, so here it is:\n"
                 f"    {_jm_err or '(the tumbler printed nothing)'}\n"
                 f"    A usage/option error means the tumbler CLI has moved on "
                 f"from what this call expects.")


def _receive_pairs_for(args, entry_addr: str) -> list:
    """The swap quotes routed to this receive address, or [].

    Receiver mode has always known WHERE the money is going and not HOW MUCH
    was coming: the target had to be retyped into --expect-total-xmr by hand.

    Filtered to THIS receive address, because a bundle can describe swaps to
    several destinations and summing all of them sets a target this subaddress
    is never going to reach -- the run would sit out its whole wait and then
    report a shortfall that is really someone else's swap.
    A hand-typed decimal fails silently in the direction that costs money -- a
    dropped digit makes the target smaller, the arrival gate opens early, and
    the run plans against part of the swap while the rest lands on an ENTRY it
    has already finished with.

    Reading the bundle also gives the gate the PER-CHUNK amounts. Passed [],
    swap_arrival_floor can only apply the flat tolerance; given the real
    amounts it tightens when the smallest chunk is worth less than that
    tolerance, which is the case where a whole missing chunk would otherwise
    hide inside it.

    NEVER FATAL. This is a convenience over --expect-total-xmr, not a new
    requirement: a missing, malformed or unrelated bundle warns and returns [],
    leaving the run exactly as it was before the flag existed. The bundle is a
    file on disk that anything able to write it can shape, and sum_quoted_xmr
    already treats NaN/Infinity/absurd quotes as unreadable rather than
    believing them.
    """
    path = getattr(args, "swap_pairs", None)
    if not path:
        return []
    try:
        allp = load_pairs(path)
    except Exception as e:                                   # noqa: BLE001
        integrity_log("stage2", "receive_pairs_unreadable")
        print(f"  [!] --swap-pairs {path} could not be read ({str(e)[:80]}).")
        print(f"      Continuing without it: the run has NO target unless you "
              f"pass --expect-total-xmr, and with no target it does not wait.")
        return []
    matched = pairs_for_dest(allp, entry_addr)
    if not matched:
        # Loud, because the operator supplied a bundle and reasonably believes
        # it is being used. Silently ignoring it leaves them thinking the run
        # is gated when it is not.
        integrity_log("stage2", "receive_pairs_wrong_dest")
        print(f"  [!] None of the {len(allp)} swap pair(s) in {path} are "
              f"routed to this receive address, so NONE of them describe this "
              f"run's money.")
        print(f"      Continuing without a target unless --expect-total-xmr "
              f"is set. Check you passed the bundle for THIS receive wallet.")
        return []
    _tot, _unreadable, _ = sum_quoted_xmr(matched)
    integrity_log("stage2", f"receive_pairs_loaded:{len(matched)}")
    print(f"  [+] --swap-pairs: {len(matched)} swap(s) routed here, quoted "
          f"{_tot} XMR in total. The run waits for that sum.")
    if _unreadable:
        print(f"  [!] {_unreadable} of them carry no readable expected_xmr and "
              f"contribute NOTHING to the target, so the run will proceed once "
              f"the readable ones have landed even if those never do.")
    return matched


def stage2_get_swap_quotes(args, proxy, chunks: List[Decimal],
                           xmr_dests) -> List[dict]:
    """Get ThorChain swap quotes via SwapKit API for each BTC chunk.

    Uses the REAL SwapKit v3 API (https://docs.swapkit.dev):
      POST /v3/quote
      Body: {sellAsset, buyAsset, sellAmount, destinationAddress}
      Response: {quoteId, routes: [{..., expectedOutput, depositAddress, memo}]}

    Returns list of deposit instructions for the operator.
    The operator must MANUALLY send BTC to each deposit address.

    ONE DESTINATION PER CHUNK, and that is the audit's G5. This took a single
    `xmr_dest` string and posted it in EVERY chunk's request body, which cost
    two things at once:

      * the aggregator saw N deposits routed to one Monero address and could
        link the N payments -- and thor_swap_preparer.resolve_destinations
        refuses precisely this, in this repo, for this reason;
      * the newnym(required=True) between chunks below became theatre. A fresh
        Tor circuit cannot disguise N request bodies that all carry the same
        unique 95-character identifier. The rotation is only real once the
        bodies differ.

    And on-chain it was worse than either: N chunks landing on one subaddress
    are swept by one veil transaction whose N input rings each contain a
    publicly-known swap output, so intersecting them identifies the carrier the
    whole run then spends from (see build_entry_veils).

    A list is accepted (one address per chunk, in order); a bare string is
    still accepted and used for every chunk, which is exactly right when there
    is only one.
    """
    if isinstance(xmr_dests, str):
        xmr_dests = [xmr_dests] * len(chunks)
    xmr_dests = list(xmr_dests)
    if len(xmr_dests) != len(chunks):
        # Not a warning. A short list would silently re-use an address for the
        # remaining chunks, which is the exact defect this parameter was made
        # plural to remove -- and it would do it after the quotes were fetched.
        integrity_log("stage2", "dest_count_mismatch")
        sys.exit(
            f"[!] {len(chunks)} swap chunk(s) but {len(xmr_dests)} destination "
            f"address(es).\n"
            f"    Refusing to quote: a chunk without its own address would be "
            f"routed to another\n"
            f"    chunk's, which links the two at the aggregator and merges "
            f"them on-chain.")
    if len(set(xmr_dests)) != len(xmr_dests):
        integrity_log("stage2", "duplicate_swap_dest")
        sys.exit(
            "[!] Two swap chunks share a destination address. Refusing: the "
            "aggregator is told\n"
            "    each destination, so one address across two swaps hands it a "
            "link between those\n"
            "    payments, and no amount of mixing afterwards retracts a link "
            "it already recorded.")
    # One oracle fetch for the batch. None = unreachable, which DISABLES
    # the cross-check loudly rather than measuring against an invented rate.
    btc_per_xmr = btc_per_xmr_oracle(proxy, getter=safe_get)
    if btc_per_xmr is None:
        print("  [!] Price oracle unreachable — the slippage cross-check is "
              "DISABLED for this batch. Verify each quote by hand.")

    deposits = []
    for i, amt in enumerate(chunks):
        if shutdown_requested():
            integrity_log("stage2", f"shutdown_at_chunk_{i}")
            sys.exit("[!] Shutdown requested during quote fetch.")

        if amt <= Decimal(0):
            continue

        if i > 0:
            newnym(required=True, proxy_url=getattr(args, "tor_proxy", ""))   # per-chunk quote isolation
            secure_delay(3.0, 10.0)

        # AND A CIRCUIT THIS CHUNK OWNS, not merely a hope of a fresh one.
        #
        # newnym above asks Tor to retire its circuits; it does not say which
        # circuit the next stream lands on, and newnym()'s own docstring is
        # explicit that a True "means 'Tor accepted the request', not 'this
        # stream is provably on a new circuit'" because Tor coalesces signals
        # sent close together. Verified against a running Tor: three NEWNYM
        # signals in a row were each accepted in 0.000s while Tor's internal
        # MAX_SIGNEWNYM_RATE is 10 seconds.
        #
        # Tor's SocksPort carries IsolateSOCKSAuth by default, so a distinct
        # SOCKS username puts this quote on its own circuit deterministically.
        # That is the guarantee this loop needs: resolve_destinations' docstring
        # says the rotation "exists so the aggregator sees N unrelated clients
        # rather than one client arranging N swaps", and one client arranging N
        # swaps is exactly what a coalesced NEWNYM leaves behind.
        #
        # Additive: newnym still runs. Verified against the live Tor that the
        # derived credentials are accepted (SOCKS method 0x02, auth 0x00).
        _qproxy = isolated_proxy(args.tor_proxy, f"quote:{i}") if getattr(
            args, "tor_proxy", None) else proxy

        # THIS chunk's own destination -- see the docstring. Indexed by the
        # loop variable, not a shared value captured above.
        chunk_dest = xmr_dests[i]

        # SwapKit v3 API uses sellAsset/buyAsset not from/to
        payload = {
            "sellAsset": "BTC.BTC",
            "buyAsset": "XMR.XMR",
            # Fixed notation here too: this crosses the wire to the
            # aggregator, and an API that parses "3E-8" as a decimal string is
            # not something to rely on for a payment amount.
            "sellAmount": fmt_btc(amt),
            "destinationAddress": chunk_dest,
        }

        try:
            quote_resp = safe_post(f"{SWAPKIT_API}/v3/quote", payload, _qproxy)
        except Exception as e:
            newnym(proxy_url=getattr(args, "tor_proxy", ""))
            integrity_log("stage2", f"quote_api_error:{i}")
            sys.exit(f"[!] SwapKit quote API failed for chunk {i}: {str(e)[:60]}")

        # Parse the routes from the response
        routes = quote_resp.get("routes", [])
        if not routes:
            error = quote_resp.get("error", "unknown")
            provider_errors = quote_resp.get("providerErrors", [])
            integrity_log("stage2", f"no_routes_chunk_{i}")
            sys.exit(
                f"[!] No swap routes available for chunk {i}.\n"
                f"    Error: {str(error)[:80]}\n"
                f"    Provider errors: {str(provider_errors)[:120]}"
            )

        # Use the first (best) route. NOTE: use `or` fallbacks, not dict
        # .get() defaults: the API often returns these keys PRESENT but
        # null, and .get("k", default) returns None (not the default) when
        # the key exists with a null value. `route.get("transaction", {})`
        # would then hand back None and the next .get() raises
        # AttributeError; Decimal(str(None)) raises InvalidOperation. `or`
        # collapses both missing AND null to the safe fallback.
        route = routes[0]
        # Single call to the extracted parser -- so a regression in null-
        # handling here is caught by the test that drives parse_swap_route,
        # not just documented in a comment. See parse_swap_route above.
        deposit_addr, memo, expected_output = parse_swap_route(route)

        # ONE gate for every way this quote can cost the operator their
        # money -- missing/garbage deposit address, no memo, or a memo
        # naming somebody else's address. Shared shape with
        # thor_swap_preparer so the two swap paths cannot diverge again.
        validate_swap_route(deposit_addr, memo, chunk_dest, i,
                            allow_unbound_memo=args.allow_unbound_memo)

        # finite_decimal: `Decimal("NaN")` parses, and then `expected_dec <= 0`
        # RAISES InvalidOperation -- so the guard meant to reject an unreadable
        # quote was itself the crash. A SwapKit response of
        # expectedOutput="NaN" took stage 2 out with an uncaught traceback.
        # Infinity is quieter: it passes `<= 0` and reaches the slippage
        # arithmetic, which then tells the operator the quote is "Infinity%"
        # away from the oracle.
        expected_dec = finite_decimal(expected_output, Decimal(0))
        if expected_dec <= 0:
            # A silent 0 here defeats the slippage cross-check below AND
            # prints "Expected: ~0 XMR" in the deposit instructions. Say so;
            # it usually means the route field name changed.
            # ONCE. A per-index kind writes one line PER CHUNK, and chain_safe
            # redacts the digits so they come out byte-identical -- which means
            # COUNTING them gives the batch size, the run-structure value
            # chain_safe promises to withhold ("...AND HOW MANY THERE WERE,
            # does not [survive]"). Driven: 2 chunks -> 2 lines, 4 -> 4, 5 -> 5,
            # against the 1 that pair_ready (already once-logged) writes. The
            # index stays on the terminal line below, where it reaches the
            # operator and stops. See integrity_log_once.
            integrity_log_once("stage2", "expected_output_unreadable")
            print(f"  [!] Chunk {i}: could not read the expected XMR from the "
                  f"quote (the route field name may have changed) — the "
                  f"slippage check is DISABLED for it.")

        # Same cross-check thor_swap_preparer applies, from the same shared
        # helper: a quote wildly off the market rate is either a bad route
        # or a stale oracle, and neither should be handed to a sender
        # unexamined. Deviation is a ratio, never the amounts themselves,
        # so nothing linkable reaches the integrity chain.
        dev = quote_deviation(expected_dec, amt, btc_per_xmr)
        if dev is not None:
            if dev > args.max_slippage:
                integrity_log("stage2", f"slippage_ABORT_{i}:dev={dev:.4f}")
                sys.exit(
                    f"[!] Chunk {i}: the quote is {dev * 100:.1f}% away from the\n"
                    f"    price oracle, past the --max-slippage limit of\n"
                    f"    {args.max_slippage * 100:.0f}%. That is either a bad route\n"
                    f"    or a stale oracle — either way, not something to hand a\n"
                    f"    sender unexamined. Raise --max-slippage only after\n"
                    f"    checking the rate yourself."
                )
            if dev > Decimal("0.05"):
                # ONCE -- see thor_swap_preparer's copy of this line. The oracle
                # is sampled once before the loop, so the warning is all-or-nothing
                # and the line count is the chunk count.
                integrity_log_once("stage2", "slippage_warn")
                print(f"  [!] Chunk {i}: quote deviates {dev * 100:.1f}% from the oracle.")

        deposit_info = {
            "chunk": i,
            # fmt_btc, not str(): Decimal renders a small amount in
            # scientific notation, and this string is printed verbatim as
            # "Send exactly: <x> BTC". "Send exactly: 3E-8 BTC" is not
            # something an operator can enter into a wallet.
            "btc_amount": fmt_btc(amt),
            "deposit_address": deposit_addr,
            "memo": str(memo),
            "expected_xmr": str(expected_dec),
            "quote_id": quote_resp.get("quoteId", ""),
            # WHICH ENTRY ADDRESS THIS CHUNK WAS QUOTED TO. Recorded because
            # nothing else binds the two: once --split gives every chunk its
            # own destination, the only link between "chunk 2's quote" and
            # "entry address 2" was list POSITION, so any later reordering
            # would silently pair a chunk with another chunk's address --
            # exactly the merge the split exists to prevent, arrived at by a
            # bookkeeping slip rather than by design.
            "xmr_dest": chunk_dest,
        }
        deposits.append(deposit_info)

        print(f"  [*] Chunk {i}/{len(chunks)-1}:")
        print(f"      Send {amt} BTC to: {scrub_address(deposit_addr)}")
        # validate_swap_route has already refused an absent or unbound memo,
        # so this always prints and always names the operator's own address.
        print(f"      With memo: {str(memo)[:40]}...")
        print(f"      Expected: ~{expected_dec} XMR")
        integrity_log_once("stage2", "quote_ready")

        secure_delay(5.0, 15.0)

    return deposits


def build_cli() -> argparse.ArgumentParser:
    """Every command-line option GhostSpiral accepts, in one place.

    Pulled out of main() so the flag surface can be read, diffed and tested
    on its own. It was 75 lines wedged between install_signal_handlers() and
    the password handling -- which is how --max-slippage and
    --allow-unbound-memo could sit beside --allow-clearnet-relay while the
    swap path behind them had no memo check at all.

    Returns the parser, not parsed args, so tests can inspect defaults and
    mutual exclusivity without driving a pipeline run.
    """
    cli = argparse.ArgumentParser(
        "GhostSpiral v10.5",
        description="BTC->XMR mixing pipeline with Tor, ThorChain, and JoinMarket support",
    )

    # NOT required=True: the BTC entry may arrive in GS_BTC_ENTRY instead of
    # argv (see resolve_sensitive_inputs). The "exactly one mode" contract is
    # enforced there, after the environment has been read.
    mode_group = cli.add_mutually_exclusive_group(required=False)
    mode_group.add_argument("--btc-entry",
                            help="BTC entry address (bech32) — SENDER mode: you own the BTC")
    mode_group.add_argument("--receive-wallet",
                            help="gs_receive_wallet_v1 JSON from create_receive_wallet — "
                                 "RECEIVER mode: XMR already arrived on this address")

    cli.add_argument("--swap-pairs", metavar="PATH",
                     help="thor_pairs.json from thor_swap_preparer. RECEIVER "
                          "mode only: the run reads the quotes routed to this "
                          "receive address and waits for their SUM, instead of "
                          "the operator retyping the total into "
                          "--expect-total-xmr.")
    cli.add_argument("--tor-proxy", required=True,
                     help="SOCKS5 proxy (e.g. socks5h://127.0.0.1:9050)")
    cli.add_argument("--joinmarket", action="store_true",
                     help="Enable JoinMarket tumble before ThorChain swap")
    cli.add_argument("--split", type=int, default=1,
                     help=f"Number of BTC chunks to swap (max {MAX_SPLIT}). "
                          f"Each chunk gets its OWN entry address, its own "
                          f"quote, its own entry veil and its own fan-out, so "
                          f"the aggregator is never told the payments belong "
                          f"together and no transaction ever spends two "
                          f"chunks. Not supported with --peel.")
    cli.add_argument("--btc-amount", type=decimal_arg,
                     help="Total BTC amount for ThorChain swap "
                          "(required when --split > 0 in sender mode)")
    # The three flags below all size ONE decision: when has all of the swapped
    # XMR arrived on ENTRY? Under --split N that is a real question with a
    # wrong answer available (see wait_for_swap_arrival).
    cli.add_argument("--expect-total-xmr", type=decimal_arg,
                     help="Total XMR expected across ALL swap chunks. PREFER "
                          "GS_EXPECT_TOTAL_XMR=... in the environment: an argv "
                          "amount is world-readable via ps and "
                          "/proc/<pid>/cmdline (mode 444) for the whole run. "
                          "Only "
                          "needed in MANUAL mode (no --btc-amount, quotes "
                          "fetched by thor_swap_preparer instead): without a "
                          "target this run cannot tell the first chunk of N "
                          "from all N, and will plan against whatever landed "
                          "first. With --btc-amount the target is summed from "
                          "the quotes automatically.")
    cli.add_argument("--swap-tolerance", type=decimal_arg,
                     default=SWAP_TOLERANCE_DEFAULT,
                     help=f"How far below the expected total still counts as "
                          f"fully arrived (default "
                          f"{SWAP_TOLERANCE_DEFAULT} = "
                          f"{SWAP_TOLERANCE_DEFAULT * 100:.0f}%%). Rates move "
                          f"between quote and settlement, so an exact-match "
                          f"gate waits for a number that never comes. Same "
                          f"meaning as receive_watch --tolerance.")
    cli.add_argument("--accept-partial-swap", action="store_true",
                     help="Proceed when only part of the expected XMR has "
                          "arrived. WITHOUT this the run STOPS and leaves the "
                          "funds on ENTRY, because planning against a fraction "
                          "is how the rest ends up unmixed: a chunk that lands "
                          "after the plan is built is never distributed, and "
                          "the swap memo naming ENTRY is public. Nothing has "
                          "been spent at that point, so waiting or re-running "
                          "costs only time.")
    cli.add_argument("--wallets", type=int, default=10,
                     help=f"Number of mix wallets (min {MIN_WALLETS})")
    cli.add_argument("--deep", type=int, default=2,
                     help=f"Multiplier on the DAG adjacency's out-degree "
                          f"(min {MIN_DEEP}). It does NOT add hop rounds: "
                          f"there is one DAG round and every output hops "
                          f"exactly once whatever this is set to, and it no "
                          f"longer costs anything either — the fee reserve is "
                          f"now one fee per transaction the run will actually "
                          f"make (compute_fee_budget), so this knob does not "
                          f"push money out of the mix the way it used to. "
                          f"Raise it for a wider choice of hop destination, "
                          f"not for more mixing.")
    cli.add_argument("--rpc-primary", default="http://127.0.0.1:18083",
                     help="Primary monero-wallet-rpc endpoint")
    cli.add_argument("--rpc-alt",
                     help="Fallback monero-wallet-rpc endpoint")
    cli.add_argument("--output", default="./unsigned",
                     help="Output directory for unsigned TX plans")
    cli.add_argument("--joinmarket-wallet",
                     help="JoinMarket wallet file for tumbles")
    # JoinMarket is a SEPARATE project with its own virtualenv. Its tumbler is
    # not a sibling of this file, so it cannot be resolved with _tool(), and it
    # must be run by the interpreter that has JoinMarket's dependencies -- not
    # this one. Both were previously implicit: the script was named on argv as
    # a bare "tumble.py" (resolved against the CWD) and run with whatever
    # "python3" meant on PATH.
    cli.add_argument("--joinmarket-tumbler", default="tumbler.py",
                     help="Path to JoinMarket's scripts/tumbler.py (default: "
                          "'tumbler.py', resolved on PATH/CWD)")
    cli.add_argument("--joinmarket-python", default="python3",
                     help="Interpreter for JoinMarket's tumbler — must be the "
                          "python from JoinMarket's own virtualenv, which is "
                          "not this pipeline's interpreter")
    # THE EXIT. Repeatable, because sending every withdrawal to ONE address
    # hands whoever controls it the whole set -- the run separated these
    # outputs on-chain and a single destination re-joins them off-chain, which
    # no amount of mixing can undo. See report_holdings.
    cli.add_argument("--exit-to", action="append", metavar="XMR_ADDRESS",
                     help="Withdraw the mixed funds to this address when the "
                          "mix completes, ONE TRANSACTION PER OUTPUT. Repeat "
                          "the flag to spread the withdrawal across several "
                          "destinations. Without it nothing is withdrawn and "
                          "the funds stay on this wallet.")
    cli.add_argument("--usage-fee", action="store_true",
                     help=f"Keep {(USAGE_FEE_PCT * 100).normalize()}%% of the deposit as your "
                          f"USAGE FEE, paid as one more destination on "
                          f"the fan-out. By default it goes to a FRESH "
                          f"account and subaddress minted for this run, so no "
                          f"address collects from two runs. XMR side only -- "
                          f"there is no BTC-side fee and there will not be "
                          f"one; see --usage-fee-address.")
    cli.add_argument("--usage-fee-pct", type=decimal_arg, metavar="FRACTION",
                     help=f"Override the usage fee (default {USAGE_FEE_PCT} = "
                          f"{(USAGE_FEE_PCT * 100).normalize()}%%). Ceiling "
                          f"{USAGE_FEE_PCT_MAX}. Implies --usage-fee.")
    cli.add_argument("--usage-fee-address", metavar="XMR_ADDRESS",
                     help="Send the usage fee to THIS address instead of a freshly "
                          "minted one. Prefer GS_USAGE_FEE_ADDRESS=... : an "
                          "argv address is world-readable via ps and "
                          "/proc/<pid>/cmdline (mode 444). Note what it costs: "
                          "one address collecting a slice of every run is the "
                          "reuse this toolchain refuses everywhere else, and "
                          "it survives the mix. The default mints a fresh one "
                          "per run for that reason.")
    cli.add_argument("--print-limits", action="store_true",
                     help="Print the minimum and maximum amounts this "
                          "configuration accepts, as JSON, and exit. Reads no "
                          "wallet and opens no socket -- gs_console uses it to "
                          "put a real minimum beside its amount fields "
                          "instead of carrying a second copy of the "
                          "arithmetic.")
    cli.add_argument("--fee-priority", type=int, choices=[1, 2, 3, 4], default=1,
                     help="Monero fee priority: 1=default, 2=x4, 3=x20, 4=x166")
    cli.add_argument("--allow-test-chain", action="store_true",
                     help="proceed when the daemon is on testnet, stagenet or a "
                          "regtest fakechain instead of mainnet. WITHOUT this the "
                          "run STOPS, because the mix-up is silent in both "
                          "directions: a 'test' pointed at mainnet spends real "
                          "money irreversibly, and a 'real' run on a private chain "
                          "moves nothing anyone else can see. The wallet cannot "
                          "tell you which it is — regtest uses mainnet address "
                          "prefixes — so only the daemon knows.")
    cli.add_argument("--accept-fallback-fee", action="store_true",
                     help="proceed when the daemon gives no fee estimate, using "
                          "the built-in per-priority figure instead of aborting. "
                          "WITHOUT this the run STOPS, because every amount is "
                          "sized against the fee and a low guess fails on a "
                          "later hop with 'not enough money' — after the fan-out "
                          "has already executed on-chain. The built-in figures "
                          "are measured mainnet values, but they are not YOUR "
                          "daemon's and the mempool moves.")
    cli.add_argument("--dag-mixing", action="store_true",
                     help="Enable the second-round DAG hop-mixing across mix "
                          "subaddresses. This REQUIRES waiting for the fan-out "
                          "round to confirm on-chain (~10 blocks), and then "
                          "relays ONE hop per funded output, each preceded by "
                          "its own --hop-delay. That second part dominates: "
                          "the confirmation wait is ~20 min, but the hops are "
                          "roughly (wallets + decoys) x the delay, so with the "
                          "defaults a run takes about TWO AND A HALF HOURS "
                          "longer, not 20 minutes. Budget for it before you "
                          "start; interrupting mid-round is what strands funds. "
                          "Off by default: the default run does the fan-out "
                          "distribution only (fast, and still spreads funds "
                          "across fresh subaddresses).")
    cli.add_argument("--hop-delay", default=None, metavar="SECONDS|MIN-MAX",
                     help="How long to wait before broadcasting each planned "
                          "transaction, in seconds (default 180-720, i.e. 3-12 "
                          "minutes of jitter). THIS IS AN OPSEC PARAMETER. A "
                          "peel hop cannot be built until the previous hop's "
                          "output has confirmed and unlocked (~10 blocks), and "
                          "this is added on top, so the default spends each "
                          "carrier output at roughly 11-16 blocks of age — "
                          "close to the youngest an output can legally be "
                          "spent, and Monero's decoy selection draws ring "
                          "members from a distribution whose bulk sits far "
                          "above that. Something like 21600-86400 spreads a "
                          "six-hop chain over days instead of under two "
                          "hours; it costs time and buys ring-age "
                          "plausibility. The default is short so a run "
                          "finishes in one sitting, not because it is the "
                          "strong choice.")
    cli.add_argument("--no-entry-veil", dest="entry_veil", action="store_false",
                     default=True,
                     help="Spend the swap's output DIRECTLY in the "
                          "distribution instead of sweeping it into a fresh "
                          "carrier first. Saves one transaction, one fee and "
                          "one confirmation wait — and costs the one thing an "
                          "analyst is handed for free. The ThorChain memo is "
                          "public, so the output that funded the run is known; "
                          "ring signatures hide which transaction spent it "
                          "only for as long as that transaction looks like "
                          "everything else. Measured: the fan-out spending it "
                          "directly is 1-in/7-out where an ordinary send is "
                          "1-in/2-out. Not recommended.")
    cli.add_argument("--peel", action="store_true",
                     help="PEELING CHAIN instead of a single fan-out: distribute "
                          "to the mix subaddresses ONE PER TRANSACTION, each "
                          "spending the previous transaction's change, so the "
                          "outputs are created in N separate transactions spread "
                          "over time rather than co-created in one fan-out tx an "
                          "analyst can cluster. MUCH SLOWER: every peel is "
                          "confirmation-gated (~10 blocks each), so N peels take "
                          "roughly N * 20 min. Strongest unlinkability; use for "
                          "high-value sends where time is not a constraint.")
    cli.add_argument("--wallet-file", default="offline.wallet",
                     help="Path to Monero wallet file for auto-mode signing")
    cli.add_argument("--wallet-password", default="",
                     help="Password for the wallet file (empty for no password). "
                          "PREFER GS_WALLET_PASSWORD=... in the environment: an "
                          "argv password is world-readable via ps and "
                          "/proc/<pid>/cmdline (mode 444).")
    cli.add_argument("--max-slippage", type=decimal_arg, default=Decimal("0.25"),
                     help="refuse a swap quote deviating more than this fraction from "
                          "an independent price oracle (default 0.25 = 25%%). 5%% still "
                          "only warns; this is the hard stop. When the oracle is "
                          "unreachable the cross-check is disabled and said so loudly.")
    cli.add_argument("--allow-unbound-memo", action="store_true",
                     help="proceed even when a swap quote's memo does not contain your "
                          "XMR destination. ONLY for a genuine aggregator format change "
                          "-- normally it means the swap would deliver to someone else's "
                          "address, irreversibly.")
    cli.add_argument("--allow-clearnet-relay", action="store_true",
                     help="Proceed even when monerod is verified to relay to raw-IP "
                          "peers. Every transaction this run creates would then be "
                          "broadcast from your IP.")
    cli.add_argument("--rpc-daemon", default="http://127.0.0.1:18081",
                     help="monerod daemon RPC endpoint for broadcast (NOT wallet-rpc)")
    return cli


def resolve_sensitive_inputs(args) -> None:
    """Move the operator-identifying inputs off the command line.

    --btc-entry is the SENDER'S OWN BITCOIN ADDRESS and --btc-amount is the sum
    being moved. Both sat in /proc/<pid>/cmdline, which is mode 0444: every
    account on the host could read the address that links this run to a
    Bitcoin identity, and the size of it, for as long as the pipeline ran.

    This toolchain keeps both values out of the integrity chain precisely
    because they deanonymise the operator, and refuses argv for the wallet
    password in the same breath -- then put the address on a command line.
    GS_BTC_ENTRY / GS_BTC_AMOUNT are read first; argv still works for a manual
    run but warns. Enforces the mode contract afterwards, because argparse can
    no longer do it once the entry may come from the environment.
    """
    args.btc_entry = env_or_argv("GS_BTC_ENTRY", args.btc_entry,
                                 "The BTC entry address")
    _amt = env_or_argv("GS_BTC_AMOUNT",
                       str(args.btc_amount) if args.btc_amount is not None else None,
                       "The BTC amount")
    if _amt is not None:
        # decimal_env: --btc-amount is type=decimal_arg, this was a bare
        # Decimal, and this is the path the tool tells operators to prefer.
        #
        # max_value, because positive=True alone leaves 1e30 through -- finite,
        # positive, and 39 digits against a 28-digit context, so the first
        # fmt_btc() on it raises InvalidOperation. See BTC_ABSURD_TOTAL.
        args.btc_amount = decimal_env("GS_BTC_AMOUNT", _amt, positive=True,
                                      max_value=BTC_ABSURD_TOTAL)

    # Exactly one entry mode. argparse enforced this while --btc-entry was a
    # required mutually-exclusive member; it cannot once the value may come
    # from the environment, so the same contract is enforced here.
    if args.btc_entry and args.receive_wallet:
        sys.exit("[!] Give either a BTC entry (--btc-entry / GS_BTC_ENTRY) or "
                 "--receive-wallet, not both.")
    if not args.btc_entry and not args.receive_wallet:
        sys.exit("[!] No entry mode. Set GS_BTC_ENTRY=<bc1...> (preferred) or pass "
                 "--btc-entry, or use --receive-wallet for receive mode.")


def resolve_wallet_password(args) -> None:
    """Take the wallet password from the environment, never from argv.

    argv is world-readable: any local user can read /proc/<pid>/cmdline or run
    ps. The environment is not a secret store either, but it is not published
    to every process on the box the way a command line is. Env wins over argv,
    matching airgap_tx_signer, and using argv warns loudly rather than silently
    accepting a password that has already leaked to every user on the machine.

    Mutates args in place, the way the pipeline already expects.
    """
    # Prefer the environment over argv for the wallet password (see the
    # --wallet-password help and the env handoff in _stage5_run). Same
    # precedence rule the signer uses, so the two agree.
    # THE SHARED HELPER, not a fourth hand-rolled copy.
    #
    # This, airgap_tx_signer and exit_strategy_simulator each carried their own
    # `if env: use env / elif argv: warn`, and all three had the same hole: when
    # BOTH were supplied the warning never fired, even though the password was
    # sitting in /proc/<pid>/cmdline (0444) for the whole run. Setting the
    # environment variable AND passing the flag is a natural belt-and-braces
    # move, so the silent case was the one an operator was most likely to hit.
    # Fixing the helper and leaving the copies would have been the same defect
    # this file keeps being audited for.
    #
    # allow_empty=True because an empty wallet password is legitimate:
    # GS_WALLET_PASSWORD="" must mean "no password", not "unset".
    args.wallet_password = env_or_argv(
        "GS_WALLET_PASSWORD", args.wallet_password, "The wallet password",
        allow_empty=True)
    return None


def resolve_entry_mode(args) -> tuple:
    """Decide where this run's money comes IN, and validate that source.

    Two mutually exclusive entries: a receive bundle (XMR is already on a
    subaddress we own) or a BTC address to tumble and swap. Returns
    (receive_mode, entry_addr, account_index, subaddress_index) -- for the BTC
    path the last three are None/0 and ENTRY is created later in stage 3.

    Both branches fail closed. The bundle goes through the one shared strict
    loader; the BTC address is checked with a real bech32 checksum, not just
    the charset regex, because a single flipped character is in-charset and
    would send a tumble somewhere unrecoverable.
    """
    # ---- Determine mode ----
    receive_mode = bool(args.receive_wallet)
    receive_entry_addr = None
    receive_account_index = 0
    receive_subaddress_index = 0

    if receive_mode:
        # ONE strict loader, shared with receive_watch and thor_swap_preparer
        # (gs_common.load_receive_bundle). The inline parse this replaces did
        # `rw_data.get("subaddress_index") or 0`, so a bundle missing the index
        # silently became subaddress 0 -- the account's primary AND change
        # address -- and the pipeline would have used the change carrier as its
        # entry without reporting anything wrong.
        try:
            rw_data = load_receive_bundle(args.receive_wallet)
        except ValueError as e:
            sys.exit(f"[!] {e}")
        receive_entry_addr = rw_data["address"]
        receive_account_index = rw_data["account_index"]
        receive_subaddress_index = rw_data["subaddress_index"]
        integrity_log("stage0", f"receive_mode:entry={scrub_address(receive_entry_addr)}")
        print(f"  [*] RECEIVER MODE: XMR entry address = {scrub_address(receive_entry_addr)}")
        if args.joinmarket:
            sys.exit("[!] --joinmarket is not applicable in receiver mode (no BTC to tumble)")
    else:
        # BTC_RE + bech32 checksum, matching every other BTC-address consumer
        # in the codebase (stage2 deposit validation, thor_swap_preparer).
        # BTC_RE alone accepts a typo'd-but-in-charset address; combined with
        # bech32_checksum_ok this rejects a single-character flip that would
        # otherwise reach the JoinMarket tumbler and waste the tumble.
        if not BTC_RE.match(args.btc_entry) or not bech32_checksum_ok(args.btc_entry):
            sys.exit("[!] Invalid BTC entry address: failed bech32 checksum "
                     "(expected bc1.../tb1... with a valid checksum)")
        integrity_log("stage0", "btc_entry_validated")
        if getattr(args, "swap_pairs", None):
            # SAID, not silently discarded. Send mode fetches its own quotes
            # in stage 2 and derives the arrival target from those, so a bundle
            # handed in here is genuinely unused -- but an operator who passed
            # one believes the run is gated by it, and this file has already
            # shipped two "NO EFFECT" messages that were wrong about their own
            # code. A flag that is accepted, validated and then dropped in
            # silence is how that belief survives to the point where it costs
            # money.
            integrity_log("stage0", "swap_pairs_ignored_send_mode")
            print(f"  [!] --swap-pairs is ignored in SEND mode: this run "
                  f"fetches its own quotes and takes the arrival target from "
                  f"them. The flag exists for RECEIVER mode, where there are "
                  f"no quotes to fetch.")
    return (receive_mode, receive_entry_addr, receive_account_index,
            receive_subaddress_index)


def refuse_hot_wallet(rpc) -> None:
    """The online wallet must be VIEW-ONLY, and nothing checked.

    The pipeline is create -> sign -> broadcast across an air gap: phase_create
    asks monero-wallet-rpc for an `unsigned_txset`, an offline full wallet
    signs it, the broadcaster relays it. monero-wallet-rpc only returns an
    unsigned_txset for a WATCH-ONLY wallet -- a full (hot) wallet builds and
    relays directly and returns no such field.

    OPSEC_SETUP.md says view-only in six places and airgap_tx_signer's usage
    block says "Phase 1 -- create unsigned TXs (online, view-only wallet)".
    Nothing enforced it. Pointing --rpc-primary at an ordinary hot wallet --
    the wallet that HAS the money, so the obvious thing to point at -- produced
    this, deep inside Round 0:

        [!] TX 0: RPC returned no unsigned_txset
        [+] Phase 1 complete: 0 unsigned TXs created, 1 failed.
        [!] 1 TXs failed. Check RPC connection and balances.

    The connection is fine and the balance is fine, so that advice sends the
    operator to debug the two things that are not wrong. And it arrives AFTER
    the veil and fan-out plans are on disk in plaintext and after several Tor
    rotations, rather than before anything has happened.

    Observed by running the real pipeline against a real wallet, not deduced.

    THE PROBE IS sign_transfer WITH A JUNK TXSET, and the obvious alternatives
    were tried against a real monero-wallet-rpc 0.18.3.1 first:

      * `sign` -- on a watch-only wallet the RPC closes the connection and the
        PROCESS DIES. A preflight that kills the operator's wallet-rpc is worse
        than no preflight.
      * `export_key_images` -- same, it kills a watch-only wallet outright.
      * `query_key {"key_type": "spend_key"}` discriminates cleanly, but on a
        hot wallet it pulls the SPEND KEY over the wire into this process to
        answer a yes/no question.

    sign_transfer errors on both kinds, returns no key material either way, and
    both wallets survive it:

        full wallet  -> "cannot load unsigned_txset"
        view-only    -> "command not supported by watch-only wallet"

    An unrecognised answer is treated as "cannot tell" and let through. This is
    a preflight; refusing a run over a diagnostic string a future RPC version
    words differently would be worse than the failure it prevents.
    """
    try:
        r = rpc.raw_request("sign_transfer", {"unsigned_txset": "00"})
    except Exception as e:                                   # noqa: BLE001
        # An RPC that reports by raising is saying the same thing the error
        # body would. Read the text and fall through if it is not ours.
        msg = str(e).lower()
    else:
        msg = str(r).lower() if r is not None else ""
    if "watch-only" in msg or "watch only" in msg:
        integrity_log("stage0", "wallet_view_only_ok")
        return
    if "cannot load unsigned_txset" not in msg:
        integrity_log("stage0", "wallet_kind_unknown")
        return
    integrity_log("stage0", "REFUSED:hot_wallet_online")
    sys.exit(
        "[!] --rpc-primary is serving a FULL (hot) wallet, and this pipeline "
        "cannot use one.\n"
        "    Every round is built as an UNSIGNED transaction, signed offline, "
        "then relayed\n"
        "    separately, and monero-wallet-rpc only returns an unsigned txset "
        "for a\n"
        "    WATCH-ONLY wallet. A full wallet builds and relays directly, so "
        "Round 0 would\n"
        "    fail with 'RPC returned no unsigned_txset' once the plans were "
        "already on disk.\n"
        "\n"
        "    NOTHING HAS BEEN SPENT. Serve a view-only wallet here and keep "
        "the full one\n"
        "    offline for --wallet-file:\n"
        "        monero-wallet-cli --generate-from-view-key <name>    "
        "(address + private VIEW key)\n"
        "    then point --rpc-primary at a monero-wallet-rpc holding THAT "
        "wallet, and\n"
        "    --wallet-file at the full wallet on the offline machine. "
        "OPSEC_SETUP.md walks\n"
        "    through it — the air gap is the point, not an inconvenience.")


def stage0_preflight(args, proxy) -> tuple:
    """Every gate that must hold BEFORE this run is allowed to touch money.

    These checks were spread through 60 lines of main(), interleaved with
    wallet setup, so "what does GhostSpiral actually verify before it spends?"
    could only be answered by reading the whole function. Collected here so an
    auditor -- or the operator following OPSEC_SETUP.md -- can read the gate
    stack in one place and see that nothing skips it.

    In order:
      * free disk and RAM, so a plan is not written half-way onto a full disk;
      * Tor verified as a REAL Tor exit, not merely a reachable SOCKS port;
      * monerod relay egress -- the transaction leaves over monerod's peer
        connections, so a Tor-routed wallet-rpc in front of a clearnet-relaying
        daemon still broadcasts from the operator's IP. Checked at startup,
        not at broadcast time, because by then the plan exists and the
        temptation is to send it anyway;
      * wallet-rpc reachable AND synced, so balances are real;
      * a live fee estimate, which refuses an implausible one rather than
        sizing a spend off a fresh/offline chain's numbers.

    Returns (rpc_primary, rpc_alt, fee_xmr). Any failure exits; nothing here
    returns a degraded value that a later stage could mistake for success.
    """
    # ---- Stage 0: Environment checks ----
    require_resources(min_disk_gb=2.0)
    verify_tor(proxy)
    integrity_log("stage0", "tor_ok")

    # Relay egress is checked HERE, at startup -- not at broadcast time. The
    # transaction leaves the machine over monerod's peer connections, so a
    # clearnet-relaying daemon deanonymises the whole run no matter how well
    # this process is proxied. Discovering that at the broadcast step would mean
    # refusing AFTER the fan-out, the on-chain confirmation wait (up to an hour)
    # and the signing -- leaving signed transactions on disk and the operator's
    # time wasted. Fail before any of that happens.
    egress = check_daemon_relay_egress(args.rpc_daemon, proxy)
    integrity_log("stage0", f"relay_egress:{egress['verdict']}")

    # WHICH CHAIN IS THIS, and does the operator know?
    #
    # Nothing anywhere in this toolchain asked. check_daemon_relay_egress has
    # always fetched get_info and has always thrown away its `nettype` field.
    #
    # THE WALLET CANNOT ANSWER IT. Driven against a real monerod --regtest with
    # a real monero-wallet-rpc: regtest uses MAINNET address prefixes, so the
    # wallet's validate_address returns nettype "mainnet" for its own addresses
    # AND for a genuine mainnet address, and gs_common.validate_xmr_address --
    # which checks format and checksum entirely offline and never asks the
    # wallet at all -- accepts both. The daemon reported `nettype: fakechain`
    # the whole time.
    #
    # Both directions of the mix-up are expensive, and the console makes the
    # first one easy: rpc_daemon is a text field that stays at :18081 while the
    # wallet is swapped for a test one.
    #
    #   * believing it is a TEST run when --rpc-daemon points at real mainnet
    #     -> the pipeline spends REAL money, and every "test" transaction is a
    #        real, irreversible one;
    #   * believing it is a REAL run when the daemon is a fakechain -> the
    #     operator thinks their funds are mixed and sitting at --exit-to, and
    #     nothing has happened on any chain anyone else can see.
    #
    # So: say it out loud always, and REFUSE a non-mainnet chain unless the
    # operator asked for one. Refusing is the right default because this is the
    # tool that SPENDS -- the same argument _reject_implausible_fee makes about
    # sizing a plan around a bogus number.
    _net = str(egress.get("nettype") or "unknown")
    integrity_log("stage0", f"chain:{_net}")
    if _net == "mainnet":
        print(f"  [+] Chain: MAINNET (daemon at {args.rpc_daemon}).")
    elif _net == "unknown":
        print(f"  [!] Could not determine which chain the daemon at "
              f"{args.rpc_daemon} is on.")
        print( "      Proceeding, but you are spending without confirmation of "
               "which network this is.")
    else:
        print(f"  [!] Chain: {_net.upper()} — this is NOT mainnet.")
        if not args.allow_test_chain:
            sys.exit(
                f"[!] The daemon at {args.rpc_daemon} is on {_net}, not mainnet.\n"
                f"    Refusing before anything is created. Two ways this bites, "
                f"and both are quiet:\n"
                f"      * you think this is a test and it is spending REAL "
                f"money — every\n"
                f"        transaction is irreversible;\n"
                f"      * you think this is real and it is a private chain — "
                f"nothing you can\n"
                f"        see afterwards exists to anyone else, and the funds "
                f"never moved.\n"
                f"    The WALLET cannot tell you which it is: regtest uses "
                f"mainnet address\n"
                f"    prefixes, so the addresses look identical. Only the "
                f"daemon knows.\n"
                f"    If you meant to run on {_net}, pass --allow-test-chain.")
        print(f"  [!] --allow-test-chain given; proceeding on {_net}. "
              f"Nothing here touches mainnet.")
    if egress["verdict"] == "clearnet":
        print(f"  [!] RELAY EGRESS IS CLEARNET: {egress['detail']}")
        if not args.allow_clearnet_relay:
            sys.exit(
                "[!] Aborting BEFORE any work is done. Your monerod is relaying to\n"
                "    raw-IP peers, so every transaction this run creates would be\n"
                "    broadcast from your IP — defeating the entire mixing pipeline.\n"
                "    Fix: restart monerod with --tx-proxy tor,127.0.0.1:9050\n"
                "    WHAT THIS DID AND DID NOT OBSERVE: monerod exposes no RPC that\n"
                "    reports its --tx-proxy setting (checked on 0.18.3.1), so this reads\n"
                "    the P2P PEER LIST instead. If you HAVE set --tx-proxy, your tx relay\n"
                "    may already be anonymous while block sync legitimately keeps clearnet\n"
                "    peers — and this check cannot tell those apart. In that case the\n"
                "    override below is the right answer; otherwise it is not.\n"                "    Override only if you understand the exposure: --allow-clearnet-relay"
            )
        print("  [!] --allow-clearnet-relay given; proceeding DESPITE clearnet egress.")
    elif egress["verdict"] == "offline":
        sys.exit(f"[!] {egress['detail']} — every broadcast this run would silently "
                 f"go nowhere. Start monerod without --offline.")
    elif egress["verdict"] == "tor":
        print(f"  [+] Relay egress verified anonymous: {egress['detail']}")
    else:
        print(f"  [!] Could NOT verify relay egress ({egress['detail']}).")
        print("  [!] Treat the broadcast as clearnet unless you configured "
              "monerod --tx-proxy.")

    # Fee estimation done after RPC is connected (needs the RPC)
    integrity_log("stage0", "env_checks_ok")

    rpc_primary = connect_rpc(args.rpc_primary, proxy_url=getattr(args, "tor_proxy", ""))
    rpc_alt = connect_rpc(args.rpc_alt, proxy_url=getattr(args, "tor_proxy", "")) if args.rpc_alt else None

    # BEFORE ANYTHING IS PLANNED. A hot wallet cannot produce the unsigned
    # transactions this pipeline is built on, and discovering that in Round 0
    # costs a confusing failure with the plans already written to disk.
    refuse_hot_wallet(rpc_primary)

    # Sync guard: wait for nodes to agree on height
    for attempt in range(30):
        if shutdown_requested():
            sys.exit("[!] Shutdown requested during sync wait.")
        try:
            h1 = rpc_primary.raw_request("get_height", {})["height"]
            if rpc_alt:
                h2 = rpc_alt.raw_request("get_height", {})["height"]
                if abs(h1 - h2) <= 2:
                    break
            else:
                if h1 > 0:
                    break
        except Exception as e:
            integrity_log("stage0", f"rpc_height_err:{type(e).__name__}")
        time.sleep(10)
    else:
        sys.exit("[!] RPC nodes out of sync after 5 min; abort.")
    # Height coarsened to the SAME granularity integrity_log coarsens its own
    # timestamp to. That function buckets time to 600s specifically "to reduce
    # the correlation window between the log and blockchain timestamps" -- and
    # then this line wrote an exact block height, which pins the run to a
    # single ~2-minute block and defeats the bucketing by a factor of five.
    # Five blocks is the same ~10 minutes, so the diagnostic value survives and
    # the precision does not.
    integrity_log("stage0", f"rpc_sync_ok:height~{int(h1) // 5 * 5}")

    # allow_fallback forwarded, and "fee_fetched" no longer claims more than
    # happened: it read as success whether the daemon answered or the run
    # fell back to a guess, which is how a 48x-low fee went unnoticed.
    fee_xmr = fetch_fee_from_daemon(args.rpc_daemon, proxy, args.fee_priority,
                                    allow_fallback=getattr(
                                        args, "accept_fallback_fee", False))
    integrity_log("stage0", "fee_resolved")
    return rpc_primary, rpc_alt, fee_xmr


def compute_fee_budget(bal: Decimal, fee_xmr: Decimal, wallets: int,
                       *, peel: bool, dag_mixing: bool, exit_set: bool,
                       chunks: int = 1) -> tuple:
    """How much of `bal` is actually spendable once every fee is held back.

    Returns (usable, total_fees, transactions). PURE -- no RPC, no logging, no
    exit -- so the arithmetic that decides whether a spend is affordable can be
    tested directly instead of only through a live pipeline. The caller decides
    what an unaffordable result means; this function never aborts, because "the
    budget does not work out" is a legitimate answer, not an error.

    THE RESERVE IS ONE FEE PER TRANSACTION THE RUN WILL ACTUALLY MAKE, counted
    by _runtime_terms -- the same function that produces the wall-clock
    estimate, and the only count in this file that has been checked against a
    chain.

    It used to be `wallets * 2 * deep`, and that number is not the transaction
    count in either direction:

      * UNDER, on the default peel path. A measured --wallets 4 --deep 2 --peel
        --dag-mixing run relayed 36 transactions and paid 0.072714 XMR in fees.
        This function reserved 0.05760 -- 26% short of what the run then spent.
        The docstring said, and still says, that under-reserving "fails on the
        LAST hop with 'not enough money', after the funds have already been
        split across subaddresses". The shipped default did it.
      * OVER, wherever --deep was raised. `deep` multiplies the DAG adjacency's
        out-degree and adds no transactions at all; the old comment here said
        so and kept the term anyway as a safety margin. At 40 wallets and
        --deep 6 that reserved 1.728 XMR against a real cost near 0.5. The
        excess is not lost, but it is not distributed either: it stays as
        change, is swept once and reported UNMIXED. Turning the knob up moved
        the operator's money OUT of the mix.

    So the shape has to be known here, and it is now REQUIRED rather than
    defaulted: a caller that forgets --peel gets a reserve for a fan-out and
    the under-reserve back. Keyword-only for the same reason -- these are three
    booleans in a row and a positional mix-up is silent.

    DECOY_MAX decoys are assumed, because the real count is drawn at random
    later and this is a reserve. FEE_SAFETY_MARGIN stays on top, via
    hop_fee_reserve: the estimate is taken once at startup and the mempool can
    move under a multi-day run. On the measured run that lands at 0.1296 XMR
    against 0.0727 actually spent -- 1.8x, where the old formula was 0.79x.
    """
    # `deep` INFLATES THIS RESERVE WITHOUT ADDING A SINGLE TRANSACTION, and
    # that is stated rather than quietly corrected.
    #
    # The formula reads as "one transaction per round", and `deep` sits in it
    # as though depth meant more hop ROUNDS. It does not: --deep is a
    # multiplier on the DAG adjacency's out-degree (build_dag_adjacency),
    # assign_hop_destinations still gives every source exactly ONE
    # destination, and _stage5_run runs exactly one DAG round. So a wider
    # `deep` widens the candidate pool for a choice made once, and changes the
    # transaction count not at all.
    #
    # Measured on a 10 XMR run, 12 wallets, 0.0024 XMR fee: --deep 1 holds
    # back 0.0864 XMR and --deep 6 holds back 0.5184 XMR, for the same ~35
    # transactions. The 0.432 XMR difference does not vanish -- it is not
    # distributed, so it stays as change, is swept once to a fresh address,
    # and is reported UNMIXED. Turning the knob up moves the operator's money
    # OUT of the mix.
    #
    # NOT SILENTLY CHANGED HERE. Under-reserving is the expensive failure --
    # the docstring above says it "fails on the LAST hop with 'not enough
    # money', after the funds have already been split across subaddresses" --
    # and a live chain's real per-transaction fee cannot be measured from
    # here. Dropping `deep` would be a 2-to-6x cut in the safety margin
    # justified by arithmetic alone. The cost is made visible to the operator
    # instead (see --deep's help), and the reserve stays conservative.
    class _Shape:
        pass
    _Shape.peel = bool(peel)
    _Shape.dag_mixing = bool(dag_mixing)
    _Shape.exit_to = ["x"] if exit_set else None
    _, rounds = _runtime_terms(
        _Shape, max(1, int(chunks)), max(1, int(wallets)) + DECOY_MAX,
        Decimal(0), Decimal(0))
    # hop_fee_reserve, not a second copy of `fee_xmr * FEE_SAFETY_MARGIN`.
    # It was written out here as `per_round_fee`, which made this the third
    # place that expression lived AND left main() referencing the local by
    # name -- see the NameError note on the meta dict below.
    total_fees = hop_fee_reserve(fee_xmr) * rounds
    return bal - total_fees, total_fees, rounds


def fee_budget_shortfall(bal, total_fees, txs, usable, peel: bool) -> str:
    """The message for a balance that cannot cover its own fees.

    One function, two call sites: size_and_prune_chunks checks the projected
    balance and stage 4 re-checks the post-veil one, and they had two different
    wordings of the same refusal -- both reporting "rounds", a unit that is no
    longer what compute_fee_budget counts and never was the transaction count.

    Says what the run would actually relay and what to change, because
    "insufficient" alone leaves the operator choosing between funding the
    wallet, lowering --wallets and dropping --peel, and those differ by an
    order of magnitude in effect.
    """
    return (f"[!] Balance {bal} XMR insufficient.\n"
            f"    This shape relays about {txs} transactions -- the entry "
            f"veil, the distribution, any DAG hops,\n"
            f"    one change sweep per change location and one withdrawal per "
            f"funded output -- so it\n"
            f"    reserves {total_fees} XMR in fees. Usable after fees: "
            f"{usable} XMR\n"
            f"\n"
            f"    NOTHING HAS BEEN SPENT. Fund the wallet more, or use fewer "
            f"--wallets"
            + (", or drop --peel:\n"
               "    a peel chain is one transaction per destination plus a "
               "change sweep for each, so it\n"
               "    costs several times a fan-out's fees for the same balance."
               if peel else "."))


def resolve_mix_account(args, rpc_primary, receive_mode: bool,
                        receive_account_index: int) -> int:
    """The account a RECEIVE run is pinned to, or None for a send run.

    A send run's account is whichever one create_subs made for ENTRY; the
    caller reads it back from addr_index. Returning None rather than a guess
    is deliberate -- there is no correct value to invent here.
    """
    # WHICH ACCOUNT THE MIX RUNS IN. This decides where every leftover in the
    # run comes to rest.
    #
    # Verified against real monerod 0.18: change is returned to the SPENDING
    # ACCOUNT's subaddress 0 -- not to the wallet's account 0. That one fact is
    # what makes this fixable. Running the mix in account 0 sends the fan-out's
    # unallocated remainder, and the dust left by every DAG hop, to account 0 /
    # subaddress 0: the wallet's own primary address, the same address on every
    # run. Two runs then share a change sink, so they are trivially the same
    # wallet, and the address that identifies the wallet slowly accumulates a
    # slice of everything that was ever mixed.
    #
    # A FRESH ACCOUNT per run moves that sink to an address created for this
    # run and used for nothing else. The wallet's real primary address is not
    # touched by the mix at all, and two runs no longer share a change address.
    #
    # In RECEIVE mode the account is fixed by the bundle -- the money is
    # already sitting in it -- so rotation there belongs to
    # create_receive_wallet, which now issues a fresh account per receive.
    #
    # SEND MODE NO LONGER ROTATES HERE, and that is not a weakening. This used
    # to create one fresh account and create_subs put ENTRY and every mix
    # subaddress in it. create_subs now gives EVERY subaddress its own fresh
    # account -- so ENTRY already lands in one, already never account 0
    # (create_fresh_account refuses that outcome), and the run's change already
    # rests in an account made for this run and used for nothing else. Creating
    # a second account on top, that nothing spends and nothing receives, and
    # then announcing it as "the mix account", would be exactly the theatre the
    # paragraphs above object to.
    #
    # So: receive mode is fixed by the bundle, send mode is answered by
    # whichever account create_subs made for ENTRY, and main() reads that back
    # with _src_account rather than either of them being assumed.
    return receive_account_index if receive_mode else None


def verify_spend_source(rpc_primary, account: int, index: int,
                        expect_addr: str) -> None:
    """Confirm the wallet really holds `expect_addr` at (account, index).

    Every spend in the run names this account and this index. If they point
    somewhere else the pipeline does not crash -- it plans against a different
    subaddress's balance and moves money out of a different account, with the
    change coming to rest wherever that account's subaddress 0 happens to be.
    That is precisely how the spend account silently stayed 0 after the mix
    account was rotated: nothing failed, and the wallet's primary address quietly
    became the run's change sink again.

    So the pair is verified against the wallet itself before anything is
    planned, the same way create_receive_wallet verifies the address it hands
    out. Fail closed: an unverifiable source is not a source to spend from.
    """
    try:
        res = rpc_primary.raw_request("get_address", {
            "account_index": int(account), "address_index": [int(index)]})
        entries = (res or {}).get("addresses") or []
    except Exception as e:                                   # noqa: BLE001
        integrity_log("stage4", "spend_source_readback_failed")
        sys.exit(
            f"[!] Could not read the spend source back from the wallet "
            f"({str(e)[:60]}).\n"
            f"    Refusing to spend from an account/index pair the wallet has not\n"
            f"    confirmed.")
    match = [e for e in entries if e.get("address_index") == int(index)]
    if not match or match[0].get("address") != expect_addr:
        got = match[0].get("address") if match else None
        integrity_log("stage4", "SPEND_SOURCE_MISMATCH")
        sys.exit(
            f"[!] SPEND SOURCE MISMATCH. The plan plans to spend from account "
            f"{account} / subaddress {index},\n"
            f"    but the wallet reports that as {scrub_address(got)}\n"
            f"    while ENTRY is         {scrub_address(expect_addr)}.\n"
            f"    Spending would move funds from the wrong account, and this run's\n"
            f"    change would come to rest on THAT account's subaddress 0.\n"
            f"    Refusing.")
    # ONCE PER RUN, NOT ONCE PER ENTRY. resolve_entry_accounts calls this in a
    # loop -- "Once per entry", as the comment at the call site says -- and
    # chain_safe redacts the payload to `spend_source_ok:acct=#:idx=#`, so a
    # --split 5 run wrote five byte-identical lines and the split count came
    # straight off the file by tallying them. That is the number of swap
    # chunks, which is the run's whole shape, and it is a SUCCESS line so the
    # "failure events stay countable" exemption does not cover it.
    #
    # chain_safe's docstring uses THIS payload as its worked example of what
    # redaction removes -- "spend_source_ok:acct=3:idx=1 becomes
    # spend_source_ok:acct=#:idx=#... which output or address it happened to,
    # and how many there were, does not [survive]" -- and the second half of
    # that sentence was false for its own example.
    #
    # The account and index are redacted to nothing on disk anyway; they are in
    # the abort messages above, where they reach the operator and stop.
    integrity_log_once("stage4", "spend_source_ok")


def build_dag_adjacency(subs: list, entry_addrs, deep: int, rng) -> dict:
    """The hop graph: {subaddress: [candidate destinations]}.

    ENTRY IS NEVER A HOP DESTINATION, and that is the whole reason this is a
    function rather than eight lines in main().

    The adjacency was built over all of `subs`, and subs contains ENTRY.
    assign_hop_destinations prefers a source's own adjacency
    (`dag.get(s, mix_targets)`) and falls back to mix_targets only when that is
    exhausted -- and mix_targets is the list that excludes ENTRY. So the
    exclusion existed and the primary path walked straight past it. Measured
    over 400 planning runs per size, driving the real assign_hop_destinations:

        wallets=10 deep=2   350/400 runs (87.5%) paid a hop to ENTRY
        wallets= 6 deep=2   341/400 runs (85.2%)
        wallets=20 deep=3   355/400 runs (88.8%)

    ENTRY is the address the ThorChain memo names in plaintext, in a Bitcoin
    OP_RETURN, to anyone who reads the BTC chain. build_entry_veil exists
    because that output is "THE ONE OUTPUT AN ANALYST GETS FOR FREE", and its
    premise is that ENTRY is spent ONCE into a fresh carrier and then
    abandoned. Paying a MIXED output back to it gives an analyst a second look
    at the one address they already have -- this time holding value that has
    been through the mix. Nine runs in ten.

    Excluding it here takes that to 0/400 at every size. The fan-out already
    excluded it (mix_targets); only the hop graph did not.
    """
    # A SET, and the WHOLE entry set. This took one address; --split N creates
    # one entry subaddress per chunk (create_entry_set) and every one of them
    # is the address a public swap settlement points at, so every one of them
    # must stay out of the hop destinations for the reason below. A bare
    # string is still accepted -- that is the ordinary one-chunk run.
    _entry_set = ({entry_addrs} if isinstance(entry_addrs, str)
                  else set(entry_addrs or ()))
    dag = {}
    for a in subs:
        others = [b for b in subs if b != a and b not in _entry_set]
        if not others:
            # Nothing legal to point at. An empty adjacency is handled by
            # assign_hop_destinations' mix_targets fallback; randbelow(0)
            # raises ValueError instead.
            dag[a] = []
            continue
        max_k = len(others)
        k = min((rng.randbelow(3) + 1) * deep, max_k)
        k = max(k, 1)
        chosen = []
        pool = list(others)
        for _ in range(k):
            chosen.append(pool.pop(rng.randbelow(len(pool))))
        dag[a] = chosen
    return dag


def assign_hop_destinations(sources: list, dag: dict, mix_targets: list,
                            rng) -> dict:
    """One destination per hop source, and NO destination used twice.

    THE HOP ROUND USED TO UNDO THE RUN'S CENTRAL GUARANTEE. Each source picked
    its destination independently:

        d = dst_candidates[rng.randbelow(len(dst_candidates))]

    with nothing coordinating in-degree, so two sources routinely swept onto
    the SAME address. Measured over 200 planning runs at each size, every
    single run collided:

        outputs   runs with a collision   avg outputs sharing a destination
              7        200 / 200                        4.2
             12        200 / 200                        7.3
             20        200 / 200                       12.5

    Two outputs on one subaddress are two outputs one transaction can spend.
    _funded_subaddresses returns a single entry per funded SUBADDRESS and the
    exit issues one sweep_all for it, so those outputs leave in one multi-input
    transaction -- public, permanent proof of common ownership, which is
    exactly what create_subs gives every output its own account to make
    "IMPOSSIBLE rather than merely discouraged". On the default 12-output run
    the majority of the mix was being re-merged, and --dag-mixing is checked by
    default in the console, so this was the ordinary path.

    A destination is now claimed at most once, which makes the hop round a
    permutation: every mix subaddress ends holding exactly one output, the
    invariant the rest of the pipeline is built on. Preference still goes to
    the source's own DAG adjacency; the fallback is any unclaimed target, so a
    sparse graph costs randomness rather than correctness.

    Returns {source: destination}. A source with no assignable destination is
    OMITTED rather than given a colliding one -- the caller reports it.
    """
    assigned: dict = {}
    used: set = set()
    order = list(sources)
    rng.SystemRandom().shuffle(order)
    for s in order:
        cands = [d for d in dag.get(s, mix_targets) if d != s and d not in used]
        if not cands:
            # The adjacency is exhausted; any unclaimed target still preserves
            # the invariant, which matters more than staying inside the graph.
            cands = [d for d in mix_targets if d != s and d not in used]
        if not cands:
            continue
        d = cands[rng.randbelow(len(cands))]
        assigned[s] = d
        used.add(d)

    # REPAIR the one case greedy assignment can strand: a source left over when
    # the only unclaimed target is itself. Hand it another source's destination
    # and give that source the leftover. Both moves stay legal -- the leftover
    # is not t (it is s, and t != s), and the borrowed destination is not s
    # (s was unclaimed, so nothing was assigned to it).
    for s in order:
        if s in assigned:
            continue
        free = [d for d in mix_targets if d not in used]
        if free != [s]:
            continue
        for t in order:
            if t in assigned and t != s and assigned[t] != s:
                assigned[s] = assigned[t]
                assigned[t] = s
                used.add(s)
                break
    return assigned


def close_hop_cycles(dsts: dict, must_hop) -> dict:
    """Make every hop destination a hop SOURCE too, by closing paths into cycles.

    THE MERGE THIS EXISTS TO PREVENT. A hop is a sweep_all, and every hop in a
    round is CREATED before any is broadcast -- so a target that hops sends its
    own output away and ends holding exactly the one it received. A target that
    does NOT hop keeps its own output AND takes delivery, so that subaddress
    holds TWO. The exit issues one sweep_all per funded subaddress
    (_funded_subaddresses), so those two leave in ONE MULTI-INPUT TRANSACTION
    -- the permanent, ring-independent proof of common ownership that
    create_subs gives every output its own account to make "IMPOSSIBLE rather
    than merely discouraged", and that _run_change_sweeps pays ~0.005 XMR in
    extra fees to avoid.

    Measured on the shipped planner with one unfundable output among ten:
    275 of 300 planned rounds routed a hop onto it, against 0 of 300 with every
    output fundable. With overlapping dest_slices -- the other door, where the
    cross-call dedupe drops a hop and leaves its source holding its own output
    -- 62 of 150 rounds merged without this function.

    build_dag_plan's docstring already described this and called it "harmless"
    when all the value is one swap chunk, so the only guard added was the
    per-chunk restriction. It is not harmless under --peel: the whole point of
    a peeling chain is that the distribution outputs are NOT co-created, so
    there is no public transaction already grouping them -- and one merged
    sweep re-groups two of them, on the setting whose help text calls itself
    "Strongest unlinkability".

    HOW. assign_hop_destinations returns a partial INJECTIVE map, so the hop
    graph is a disjoint union of simple paths and cycles. A cycle is already
    safe: every node on it hops. A path is not: its tail receives and never
    hops. Closing tail -> head turns the path into a cycle, which

      * keeps every hop already planned rather than dropping any (a dropped
        hop is mixing depth the operator paid for),
      * ADDS one, for the tail that was not hopping at all,
      * cannot break the per-chunk rule, because in-degree is at most one so a
        path's nodes are reached only through its own group's edges, and
      * cannot break injectivity, because the head had in-degree zero -- that
        is what made it the head.

    The tail always differs from the head: the tail has a predecessor, and a
    node on a path cannot reach itself.

    ONLY TAILS IN `must_hop` ARE CLOSED, and that set is the addresses holding
    an output of their OWN -- the distribution's targets. An address holding
    nothing is already safe as a destination (it ends the round with exactly
    the one output it received) and must NOT be made a source: every hop in a
    round is created before any is broadcast, so a sweep_all built for an
    address whose only output has not arrived yet would find nothing to sweep.
    Callers must also keep unfundable holders out of the destination pool; a
    tail that holds an output and cannot fund a hop cannot be closed, so its
    incoming edge is dropped instead and the caller reports it.
    """
    out = dict(dsts)
    _must = set(must_hop)
    # Bounded by the number of paths, and each pass closes one. The explicit
    # bound is a backstop, not the termination argument.
    for _ in range(len(out) + 1):
        _rev = {}
        for _k, _v in out.items():
            _rev[_v] = _k
        _tails = sorted(d for d in _rev if d not in out and d in _must)
        if not _tails:
            return out
        _d = _tails[0]
        _head = _d
        _seen = {_head}
        while _head in _rev and _rev[_head] not in _seen:
            _head = _rev[_head]
            _seen.add(_head)
        if _head == _d or _head in _rev:
            # Unreachable on the shipped path (a tail always has a predecessor,
            # and the walk stops at a node with none). Drop rather than build a
            # second in-edge, which is the merge this function exists to stop.
            del out[_rev[_d]]
            continue
        out[_d] = _head
    return out


def build_dag_plan(args, fee_xmr, hop_sources_real, fanout_by_addr, dag,
                   mix_targets, addr_index, _secrets,
                   delay_window=None, dest_slices=None) -> list:
    """Plan the DAG hop round: one SWEEP per fan-out output.

    Returns the hop plan (empty when DAG mixing is off or nothing can fund
    a hop). Extracted from stage 4 so the hop shape -- which is where the
    per-hop change leak lived -- can be read and tested on its own.

    A HOP NEVER CROSSES SWAP CHUNKS, and without that the entry-set invariant
    ("no transaction ever spends value from two different chunks") is false --
    quietly, in the exit, hours later.

    The round is a permutation, so every target that hops its own output away
    ends holding exactly one output and it does not matter whose it is. But TWO
    kinds of target do NOT hop and are still eligible to RECEIVE one:

      * a source whose fan-out output is so small that compute_hop_amount lands
        at or below dust (_unfundable below), and
      * a source that could not be given a destination of its own
        (_unassigned below).

    Such a target keeps its original output AND takes delivery of the incoming
    hop. With one chunk that is harmless -- both outputs are the same money.
    With N chunks, if the two came from different chunks, the exit's per-
    subaddress sweep_all then spends BOTH IN ONE TRANSACTION, which is exactly
    the convergence the entry set exists to prevent, reached by a route that
    has nothing to do with the entry addresses.

    Found by tracing the round by hand rather than by a failing test: it needs
    a small-enough fan-out output or an exhausted candidate pool, so it is
    occasional rather than reliable -- which is worse, not better.

    `dest_slices` is the per-chunk partition of the mix targets
    (size_distribution). Destinations are drawn from the source's OWN slice, so
    a hop cannot cross chunks whatever happens to the target afterwards. It
    costs nothing real: the chunks are already unlinkable to each other, so
    interleaving them adds no mixing an analyst could not already be denied --
    it only adds the merge risk. With one chunk the single slice IS mix_targets
    and the behaviour is unchanged.
    """
    dag_plan = []
    if args.dag_mixing:
        # Hop amount comes from each source's OWN fan-out balance (fanout_amt).
        # Reserve the ACTUAL FEE, not a percentage. The old formula was
        # fanout_amt * 0.85, whose comment claimed the 15% "covers the fee
        # (tiny next to fanout_amt)" -- but the fee is an ABSOLUTE amount while
        # the reserve scales with the hop, so the claim inverts for small
        # fan-outs. With a real daemon fee of ~0.0024 XMR, any fanout_amt below
        # ~0.016 XMR reserved LESS than the fee, and the plan passed every
        # guard here and then failed "not enough money" inside transfer_split --
        # after the fan-out had already executed on-chain and spent its fee,
        # leaving funds scattered mid-pipeline. The dust guard did not catch it:
        # it only required the hop to exceed 0.0001 XMR.
        #
        # Reserve and hop both come from the shared helpers, so the number
        # printed below is the number the arithmetic actually used.
        _hop_reserve = hop_fee_reserve(fee_xmr)
        # EVERY fan-out output hops -- no output has a behavioural tell that a
        # public-code analyst could use to separate "decoy" from "real" (see
        # select_fanout_targets). hop_sources_real is all of them.
        hop_sources = list(hop_sources_real)
        _secrets.SystemRandom().shuffle(hop_sources)
        # FUNDABILITY FIRST, then destinations. A source that cannot fund a hop
        # must not claim a destination on its way to being skipped -- that
        # would strand a target for a hop that never happens and force a later
        # source onto a shared one.
        _unfundable = 0
        _fundable = []
        for s in hop_sources:
            if not hop_is_fundable(fanout_by_addr[s], fee_xmr):
                _unfundable += 1
                continue
            _fundable.append(s)
        # One destination each, none used twice -- see assign_hop_destinations
        # for what independent picking did to the no-merge invariant. Assigned
        # PER CHUNK, so a hop cannot cross chunks; see the docstring.
        _slices = [list(sl) for sl in (dest_slices or []) if sl]
        # ANY SOURCE NOT IN A SLICE STILL HOPS.
        #
        # The first version of this iterated the slices only, so a fundable
        # source that belonged to no slice was silently given no destination
        # and never hopped -- a whole round quietly doing nothing, reported as
        # success. Every source IS in a slice on the real path (the slices
        # partition fanout_dests, and hop_sources_real == fanout_dests), which
        # is exactly why the omission would not have shown up in a run: it
        # needed a caller that passes no slices, or an inconsistent one.
        #
        # So the leftovers are collected into their own group over the targets
        # no slice claimed. With dest_slices absent that group is EVERYTHING,
        # which is the behaviour this had before chunks existed.
        # NO ADDRESS MAY END THE ROUND HOLDING TWO OUTPUTS.
        #
        # After the round an address holds its OWN distribution output (unless
        # it hopped it away) plus any arrival. Two of those on one subaddress
        # is one multi-input exit transaction -- see close_hop_cycles.
        #
        # So a destination is safe when it holds nothing of its own, OR when it
        # will sweep what it holds away. An UNFUNDABLE HOLDER is neither: it
        # can never hop, so paying it always merges. That is the first of the
        # two doors; the second -- a fundable holder that greedy leaves with no
        # destination of its own -- is closed by close_hop_cycles below, once
        # the assignment is known.
        _fundable_set = set(_fundable)
        _holds_output = set(hop_sources_real)
        _safe_dsts = {d for d in mix_targets
                      if d not in _holds_output or d in _fundable_set}
        _claimed = {d for sl in _slices for d in sl}
        _residual = [d for d in mix_targets if d not in _claimed]
        _groups = _slices + ([_residual] if _residual else [])
        if not _groups:
            _groups = [list(mix_targets)]
        _dsts = {}
        _placed = set()
        for _grp in _groups:
            _grp_set = set(_grp)
            _grp_srcs = [s for s in _fundable
                         if s not in _placed and s in _grp_set]
            if not _grp_srcs:
                continue
            _placed.update(_grp_srcs)
            # The adjacency is restricted to this group too, or the graph
            # fallback would reach across it and undo the point.
            _grp_pool = [d for d in _grp if d in _safe_dsts]
            _grp_dag = {k: [d for d in v if d in _grp_set and d in _safe_dsts]
                        for k, v in dag.items() if k in _grp_set}
            _dsts.update(assign_hop_destinations(_grp_srcs, _grp_dag, _grp_pool,
                                                 _secrets))
        # A source in NO group at all (a caller whose slices and mix_targets
        # disagree) would otherwise never hop and never be reported. Give it
        # the whole target list -- correctness of the round first; the
        # same-chunk restriction is meaningless for a source no chunk claims.
        _orphans = [s for s in _fundable if s not in _placed]
        if _orphans:
            # ONLY THE DESTINATIONS NOTHING HAS CLAIMED. This passed the FULL
            # mix_targets, and assign_hop_destinations guarantees "no
            # destination used twice" only WITHIN ONE CALL -- so the orphan
            # pass happily re-picked addresses the per-group passes had already
            # assigned. Driven directly: 300 of 300 plans put two hops on one
            # destination, and 300 of 300 of those merged sources from
            # DIFFERENT chunk groups. That address then holds value from two
            # swap chunks, and the exit's single sweep_all for it spends both
            # in one transaction -- the convergence the whole split exists to
            # prevent, produced by the branch written as a safety net.
            #
            # It contradicted the policy stated fifteen lines below, in this
            # same function: "a missed hop costs mixing depth, sharing a
            # destination would cost the no-merge guarantee". An orphan with
            # nowhere legal to go now falls into _unassigned, which already
            # reports exactly that.
            _free = [d for d in mix_targets
                     if d in _safe_dsts and d not in set(_dsts.values())]
            _free_dag = {k: [d for d in v if d in set(_free)]
                         for k, v in dag.items()}
            _dsts.update(assign_hop_destinations(_orphans, _free_dag, _free,
                                                 _secrets))
        # NO DESTINATION TWICE, ACROSS EVERY CALL, checked rather than assumed.
        #
        # The per-group passes above are safe only because the groups are
        # DISJOINT -- and nothing here checks that. dest_slices arrives as a
        # parameter; split_by_weight partitions today, but this function does
        # not verify it, so overlapping slices would let two groups pick the
        # same address by the same mechanism as the orphan pass. Rather than
        # add a second unstated assumption, the merged result is verified.
        #
        # Keeping the FIRST claim and dropping the rest is the policy this
        # function already states: a dropped hop costs mixing depth, a shared
        # destination costs the no-merge guarantee. The dropped sources fall
        # into _unassigned and are reported there.
        _by_dst = {}
        _dupe_srcs = []
        for _s in list(_dsts):
            _d = _dsts[_s]
            if _d in _by_dst:
                _dupe_srcs.append(_s)
                del _dsts[_s]
            else:
                _by_dst[_d] = _s
        if _dupe_srcs:
            integrity_log("stage4", f"dag_dest_collision_dropped:{len(_dupe_srcs)}")
            print(f"  [!] {len(_dupe_srcs)} hop(s) had been given a destination "
                  f"another hop was already sweeping to, so they were DROPPED "
                  f"rather than relayed. Two hops onto one address put value "
                  f"from two swap chunks on it, and the exit spends a "
                  f"subaddress in ONE transaction — which is the merge this "
                  f"run's whole structure exists to prevent.")
        # SECOND DOOR: a fundable source that greedy left without a
        # destination still RECEIVES one, and then holds two outputs. Closing
        # each path into a cycle gives it a hop of its own instead of dropping
        # somebody else's. See close_hop_cycles.
        _pre_close = len(_dsts)
        _dsts = close_hop_cycles(_dsts, _holds_output & _fundable_set)
        if len(_dsts) > _pre_close:
            integrity_log("stage4", "dag_paths_closed")
        # CHECKED, NOT ASSUMED. Every destination must also be a source, or
        # some subaddress ends the round holding two outputs and the exit
        # spends them together. Cheap, and it is the invariant the exit's
        # one-transaction-per-subaddress rule rests on.
        # TO A FIXED POINT, not one pass. Dropping s -> d makes S itself a
        # non-hopper, so if anything was hopping onto s that is a NEW merge --
        # and a single sweep left it in place. Driven with overlapping slices
        # and close_hop_cycles disabled: one pass still merged 62 of 150 plans
        # while reporting that it had cleaned them up. Each pass strictly
        # shrinks _dsts, so the loop terminates; the bound is a backstop.
        _dropped = 0
        for _ in range(len(_dsts) + 1):
            _merge_dsts = {d for d in set(_dsts.values())
                           if d in _holds_output and d not in _dsts}
            if not _merge_dsts:
                break
            for _ms in [_s for _s, _d in _dsts.items() if _d in _merge_dsts]:
                del _dsts[_ms]
                _dropped += 1
        if _dropped:
            integrity_log("stage4", f"dag_merge_hops_dropped:{_dropped}")
            print(f"  [!] {_dropped} hop(s) would have paid an address "
                  f"that is not sweeping its own output away, leaving two "
                  f"outputs on one subaddress — and the exit spends a "
                  f"subaddress in ONE transaction, which proves they share an "
                  f"owner. Those hops were DROPPED.")
        _unassigned = [s for s in _fundable if s not in _dsts]
        # A SLICE OF ONE CANNOT HOP AT ALL, and with several chunks and few
        # wallets that is most of them. A hop's destination must differ from
        # its source and must belong to the same chunk (see the docstring), so
        # a chunk holding a single mix subaddress has nowhere legal to send it.
        # The round then reports "N output(s) could not be given a hop
        # destination" without saying that the shape of the run guaranteed it.
        _thin = [len(g_) for g_ in _groups if len(g_) < 2]
        if _thin and len(_groups) > 1:
            integrity_log("stage4", f"dag_slices_too_thin:{len(_thin)}")
            print(f"  [!] {len(_thin)} of {len(_groups)} swap chunk(s) have "
                  f"fewer than two mix subaddresses, so their outputs have "
                  f"nowhere to hop: a hop cannot leave its own chunk (that is "
                  f"what stops two chunks meeting in one transaction) and it "
                  f"cannot pay itself.")
            print(f"      Those chunks get the fan-out but not the second "
                  f"mixing round. For --dag-mixing to do anything for every "
                  f"chunk, use at least {len(_groups) * 2} --wallets, or fewer "
                  f"--split chunks.")
        if _unassigned:
            integrity_log("stage4", f"dag_unassigned:{len(_unassigned)}")
            print(f"  [!] {len(_unassigned)} output(s) could not be given a hop "
                  f"destination of their own and will NOT hop. They stay where "
                  f"they are, each still alone in its account — a missed hop "
                  f"costs mixing depth, sharing a destination would cost the "
                  f"no-merge guarantee.")
        for s in _fundable:
            if shutdown_requested():
                integrity_log("stage4", "shutdown_during_dag_plan")
                break
            # Each source hops onward from its OWN fan-out balance, so the hop
            # amounts stay as unequal as the fan-out that funded them -- no
            # single hop value for an analyst to cluster on.
            d = _dsts.get(s)
            if d is None:
                continue
            # SWEEP, not a fixed amount. A hop means "move everything from
            # this subaddress to that one", and sweep_all expresses exactly
            # that -- sending the whole balance minus the fee, with NO CHANGE
            # OUTPUT AT ALL. Verified on a real chain through the full
            # cold-signing path: a 3.0 XMR source swept 2.998 with a 0.002 fee
            # and returned nothing to the account.
            #
            # transfer_split cannot do this. The amount has to be chosen before
            # the fee is known, so it always leaves a remainder, and monerod
            # returns that remainder to the account's subaddress 0. At
            # wallets=10 deep=2 that is 40 hops each depositing dust on ONE
            # address -- the run's own convergence point, and the thing that
            # made every hop traceable to a single sink even after the account
            # rotation moved that sink off the wallet's primary address.
            #
            # NO AMOUNT IN THE ENTRY, deliberately -- a sweep has no amount,
            # and one sitting here would look authoritative while being
            # ignored.
            #
            # This block used to open by recomputing
            # `src_hop_amt = compute_hop_amount(fanout_by_addr[s], fee_xmr)`
            # and the comment here said that computation "is the fundability
            # check ... and it decides whether the hop is planned". It decided
            # nothing. Nothing read it. The fundability check is the one that
            # BUILDS `_fundable` above -- "FUNDABILITY FIRST, then
            # destinations" -- and by the time a source reaches this loop it
            # has already passed it, so the recomputation could only ever
            # return the same answer to no one.
            #
            # Proven rather than assumed: replacing the line with
            # `assert compute_hop_amount(...) > DUST_XMR` never fired across
            # 483 checks in the five suites that drive this planner, and
            # compute_hop_amount is pure, so the line had no effect to lose.
            #
            # A comment claiming a gate where there is none is the expensive
            # half of this. It tells the next reader that deleting an obviously
            # redundant line removes a safety check, and it tells anyone
            # auditing the planner that per-source fundability is enforced
            # HERE, one screen below the loop that actually enforces it.
            dag_plan.append({
                "src": s,
                "src_index": _src_index(addr_index, s),
                # Each hop source is in its own account, so the index alone
                # would not identify it -- index 1 exists in all of them.
                "account_index": _src_account(addr_index, s),
                "dst": d,
                "sweep": True,
                "delay": hop_delay(delay_window),
            })
        if not dag_plan:
            integrity_log("stage4", "dag_mixing_skipped:hop_unfundable")
            print(f"  [!] DAG mixing skipped: no mix subaddress holds enough to "
                  f"fund a hop after reserving ~{_hop_reserve} XMR for its fee. "
                  f"Fan-out distribution still runs.")
        else:
            if _unfundable:
                print(f"  [!] {_unfundable} mix subaddress(es) too small to hop; "
                      f"they keep their fan-out output. {len(dag_plan)} hop(s) planned.")
            # Hop COUNT only, never the per-hop amount — same reason as the
            # fan-out above: the amount on the persistent chain deanonymises the
            # hop it is meant to hide.
            integrity_log("stage4", f"dag_plan:{len(dag_plan)}_hops")
    else:
        integrity_log("stage4", "dag_mixing_disabled")
        print("  [*] DAG hop-mixing disabled (default). Run with --dag-mixing to "
              "add a second confirmation-gated hop round.")
    return dag_plan


def announce_distribution_shape(args, n_outputs: int,
                                fee_out: bool = False) -> None:
    """Say that the default distribution leaves ONE distinctive transaction.

    --dag-mixing announces itself when it is OFF ("Run with --dag-mixing to add
    a second confirmation-gated hop round"). --peel does not, and its absence
    is the one that shows up on the chain.

    MEASURED, on a completed run of this pipeline against a real chain. Eleven
    transactions were relayed; ten of them were 1-input, 2-output, 44-byte
    tx_extra, ~0.0018 XMR fee -- the shape of essentially every ordinary Monero
    payment. The fan-out was the eleventh:

        height  in  out  extra      fee
           371   1    2     44   0.001808   <- entry veil
           409   1    8    291   0.004519   <- the fan-out
           451   1    2     44   0.001808   <- change sweep
           491+  1    2     44   0.001808   <- one per exit

    Eight outputs where the chain's overwhelming default is two, a tx_extra six
    times the length, and a fee two and a half times everything around it. All
    three are public. It is the transaction an analyst picks out without
    trying, and --peel is the flag that removes it.

    WHAT --peel LOOKS LIKE, also measured, because the notice used to call its
    transactions "ordinary" and they were not. On a completed --peel
    --dag-mixing run:

        30 tx   in=1 out=2 extra= 44  fee 0.001810   <- veils, hops, sweeps
         6 tx   in=1 out=3 extra=131  fee 0.002633   <- the peels

    The six peels were the only transactions of their shape in the run and
    identical to each other to the piconero. That third output was monerod's
    change, left because a peel named a FIXED amount for the next carrier and
    the real fee is not knowable at planning time.

    A peel consumes its carrier EXACTLY now and the last one sweeps, so there
    is no change output: in=1 out=2 extra=99, verified end to end through the
    cold-signing path.

    99 AND NOT 44, AND THAT IS IRREDUCIBLE. Measured on current consensus:

        pay ONE subaddress, take change      in=2 out=2 extra= 44
        pay ONE standard address, take change in=2 out=2 extra= 44
        pay TWO subaddresses, take change     in=2 out=3 extra=131
        a peel: TWO subaddresses, no change   in=1 out=2 extra= 99

    An ordinary payment carries one real destination, so monerod needs a single
    tx pubkey; a peel carries two, so it needs one per output. The output count
    now matches the ordinary shape and the tx_extra does not, and that is the
    whole of what is left -- said to the operator rather than described as
    "ordinary". Removing it would mean a peel with ONE real destination, i.e.
    letting the forward be monerod's change -- which lands on the spending
    account's subaddress 0 and rebuilds the repeated-spender hub the rotating
    carriers exist to remove. monero-wallet-rpc's transfer has no change-address
    parameter, so there is no third option.

    The entry veil's own notice, printed moments earlier, says the transaction
    spending the swap output is "an ordinary 2-output send rather than one an
    analyst can pick out by shape". That is true of the veil and it is the only
    thing it is true of; read alone it suggests shape has been dealt with. The
    veil moves the distinctive transaction one hop away from ENTRY. It does not
    make it ordinary.

    A NOTICE, not a default change. Peeling is confirmation-gated per output --
    its own help says roughly N * 20 minutes -- so making it the default would
    turn a twenty-minute run into hours for operators who did not ask for that.
    The operator picks; this makes sure they are picking rather than inheriting.
    """
    if getattr(args, "peel", False):
        return
    integrity_log("stage4", "distribution_mode:fanout_default")
    # THE COUNT INCLUDES THE USAGE FEE, because the chain does.
    #
    # This said "{n_outputs} outputs" while a run with --usage-fee builds
    # n_outputs + 1 -- the fee is one more destination on the same
    # transaction. Off by one is not a rounding error here: this is the
    # paragraph whose entire subject is that the output count is PUBLIC, so a
    # figure that does not match what an analyst will count is the one wrong
    # number the operator cannot check against anything.
    _real = int(n_outputs) + (1 if fee_out else 0)
    print(f"  [*] Distribution: ONE fan-out transaction creating "
          f"{_real} outputs at once (the default).")
    if fee_out:
        # AND WHY THE EXTRA ONE IS NOT A TELL. The output count is public, so
        # an operator who has just been told the fee adds to it deserves the
        # rest of the reasoning rather than a number and a silence.
        print(f"      {n_outputs} of those are the mix; the last is your "
              f"usage fee. It does not give the transaction a shape of its "
              f"own: the mix count is already --wallets plus a random "
              f"{DECOY_MIN}-{DECOY_MAX} decoys drawn at run time, so one more "
              f"output lands inside a spread the run was making anyway. What "
              f"an analyst reads off the chain is a number in that range, not "
              f"a number with a fee in it.")
    print(f"      That transaction is visibly different from the ~2-output "
          f"payments around it — its output count, its tx_extra length and "
          f"its fee are all public, and all three scale with the number of "
          f"outputs. The entry veil keeps that shape one hop away from the "
          f"address your swap memo names; it does not make it ordinary.")
    print(f"      --peel creates the same {n_outputs} outputs in "
          f"{n_outputs} separate transactions instead, spread over time. "
          f"Each is 1-input / 2-output, the commonest shape on the network: "
          f"a peel consumes its carrier exactly and the last one sweeps, so "
          f"none of them leaves a change output. Measured, the only thing "
          f"still setting them apart from an ordinary payment is a 99-byte "
          f"tx_extra against 44 — two real destinations need two output "
          f"pubkeys.")
    print(f"      It is much slower — each one is confirmation-gated, so "
          f"roughly {n_outputs} * 20 min — and it is the stronger choice when "
          f"time is not the constraint.")
    if fee_out:
        # DO NOT OFFER A SWITCH THAT WILL BE REFUSED. --peel and --usage-fee
        # are mutually exclusive (see _refuse_fee_combinations: the peel branch
        # of build_distribution_plan has no fee destination at all, so a peel
        # run would charge the fee and pay nobody). Advising the switch without
        # saying that sends the operator to a sys.exit on their next run.
        print("      NOT ON THIS RUN, though: --peel and --usage-fee are "
              "refused together, because the peeling chain has no destination "
              "to pay the fee to and would deduct it without paying it. To "
              "peel, drop the usage fee for that run.")


def resolve_exit_destinations(args) -> None:
    """Validate every --exit-to address, HERE, before anything happens.

    Checked at flag-parse time rather than at the withdrawal, which is hours
    later on a peel chain. A typo found then would be found after the mix has
    fully executed, with the operator watching an exit fail on the last step
    of a run they cannot repeat -- and the alternative, discovering it only
    when the wallet accepts a well-formed address nobody holds the key to, is
    unrecoverable. There is no confirmation step and no reversal on Monero.

    Duplicates are rejected too: passing the same address twice looks like a
    request to spread the withdrawal while actually sending more of it to one
    place, which is the opposite of what repeating the flag is for.

    GS_EXIT_TO FIRST, argv only with a warning, and this was the LAST sensitive
    input in the toolchain without an environment path -- while being the most
    sensitive one there is. The exit destination is the operator's final
    address: the single value the whole pipeline exists to unlink from the
    public ThorChain memo. /proc/<pid>/cmdline is mode 0444, readable by every
    local account for the whole multi-hour run.

    Every less-sensitive input already had this: GS_BTC_ENTRY, GS_BTC_AMOUNT,
    GS_SWAP_AMOUNTS, GS_WALLET_PASSWORD, and GS_SWAP_DESTS -- which covers
    thor_swap_preparer's swap destinations, an address the swap provider is
    told anyway. The one address nobody is supposed to be able to tie to the
    swap went on argv.

    gs_console made it worse rather than better: it composes --exit-to onto
    GhostSpiral's argv while passing the others by environment, and
    OPSEC_SETUP.md describes that arrangement as "the console hands its
    children the sensitive values through the environment, not argv ... which
    is why no secret appears in it". The command preview it shows contains the
    exit address.

    Separator is whitespace or commas, so several destinations fit one
    variable: GS_EXIT_TO="addr1 addr2".
    """
    # The argv value is handed to env_or_argv, not withheld from it: that is
    # what makes it WARN when the destination came from the command line. A
    # None here would have taken the environment silently and said nothing
    # about argv, which is the half of the helper that matters.
    _argv_dests = getattr(args, "exit_to", None)
    _env_dests = env_or_argv("GS_EXIT_TO",
                             " ".join(_argv_dests) if _argv_dests else None,
                             "The exit destination(s)")
    if _env_dests:
        args.exit_to = [d for d in re.split(r"[\s,]+", str(_env_dests)) if d]
    dests = getattr(args, "exit_to", None)
    if not dests:
        return
    seen = set()
    for d in dests:
        if d in seen:
            sys.exit(f"[!] --exit-to {scrub_address(d)} was given more than "
                     f"once. Repeating the flag is for SPREADING the "
                     f"withdrawal; the same address twice just sends more of "
                     f"it to one place.")
        seen.add(d)
        validate_xmr_address(d, "--exit-to address")
    integrity_log("exit", f"exit_destinations_validated:{len(dests)}")
    # HOW MANY, not just which. Said HERE, hours before the exit runs, because
    # by the time the exit runs it is far too late to add one.
    #
    # The run spends hours giving the money separate accounts and separate
    # outputs. The exit then sends ONE TRANSACTION PER OUTPUT -- and with a
    # single destination all of them land on the same address. This flag's own
    # help says "repeat the flag to spread the withdrawal", and the comment
    # beside it says a single destination "re-joins them off-chain, which no
    # amount of mixing can undo". Neither of those reaches an operator who has
    # already typed the command.
    #
    # Observed in the first end-to-end run of this pipeline: with --wallets 4
    # the exit reported
    #
    #     === EXIT: withdrawing 9 output(s) in 9 SEPARATE transactions
    #         to 1 destination(s) ===
    #
    # and nothing anywhere called that a problem. Whoever watches that one
    # address sees nine arrivals and knows they are one person's -- the
    # separation the run just bought, handed back at the last step.
    #
    # A WARNING, NOT A REFUSAL. One destination is a legitimate choice: an
    # exchange deposit address is one address and cannot be spread. The
    # operator has to be told what it costs, not overruled.
    # THE REAL COUNT, which is not --wallets.
    #
    # select_fanout_targets funds `wallets + num_decoys` outputs, and
    # num_decoys is randint(DECOY_MIN, DECOY_MAX) per run -- deliberately, so
    # the output count is not a fingerprint of the --wallets setting. The first
    # version of this warning printed args.wallets, so with --wallets 4 it said
    # "roughly 4 separate output(s)" while the run measurably withdrew 8 and 9
    # in two real end-to-end runs. Understating is the wrong direction for a
    # warning whose whole force is HOW MANY arrivals land on one address.
    _w = max(int(getattr(args, "wallets", 0) or 0), 1)
    # A FLOOR, not a range, and not --wallets.
    #
    # Four measured end-to-end runs, all --wallets 4:
    #     fan-out, no DAG                      ->  8 outputs
    #     fan-out, no DAG                      ->  9 outputs
    #     --peel --dag-mixing, WITH peel change -> 18 outputs
    #     --peel --dag-mixing, zero-change peel ->  8 outputs
    #
    # The first draft printed args.wallets (4). The second printed
    # wallets + DECOY_MIN..DECOY_MAX (6-11), which brackets the fan-out runs
    # and understated the third by half, because a peel chain then left one
    # change output per carrier and the exit had to withdraw each of them.
    #
    # It no longer does: a peel consumes its carrier exactly and the last one
    # sweeps (see build_peel_plan), so a peel run's withdrawals are its mix
    # outputs and nothing else -- which is exactly this floor. A FAN-OUT still
    # returns its remainder to the spending account, so it adds one more per
    # swap chunk.
    #
    # A number that can be too LOW is the wrong failure for a warning whose
    # whole force is how many arrivals land on one address, so the floor stays
    # a floor: the decoy count is drawn at random in DECOY_MIN..DECOY_MAX and
    # the run may hold dust the operator does not know about.
    _lo = _w + DECOY_MIN
    _deeper = not bool(getattr(args, "peel", False))
    if len(dests) == 1:
        integrity_log("exit", "single_exit_destination")
        print(f"  [!] ONE exit destination, and this run will withdraw AT "
              f"LEAST {_lo} separate output(s) to it"
              + (" — and one more per swap chunk for the fan-out's change, "
                 "which --peel does not produce."
                 if _deeper else
                 " — a peel chain leaves no change, so that is the whole of "
                 "it plus however many decoys this run drew."))
        print(f"      Each goes in its own transaction, so whoever watches "
              f"that address sees that many arrivals and knows they belong "
              f"together. The run spends hours giving these outputs separate "
              f"accounts precisely so they cannot be grouped; one destination "
              f"groups them again off-chain, and no amount of mixing undoes "
              f"that.")
        print(f"      Repeat --exit-to for more addresses, or set several in "
              f"one variable: GS_EXIT_TO=\"addr1 addr2 addr3\". Say this now "
              f"— the exit is the last step, and nothing can add a "
              f"destination once it starts.")
    elif len(dests) > 1 and _lo > len(dests) * 2:
        integrity_log("exit", "few_exit_destinations")
        print(f"  [!] {len(dests)} exit destinations for at least {_lo} "
              f"output(s): {_lo // len(dests)}+ arrivals on each, and more on "
              f"the deeper settings. More destinations means fewer each.")


def reject_self_exit(args, addr_index: dict, entry_addr: str) -> None:
    """Refuse an --exit-to that names an address THIS RUN itself created.

    resolve_exit_destinations validates the exit addresses at flag-parse time,
    which is the right moment to catch a typo. But at that moment the run has
    created nothing, so it cannot yet ask the question that matters most: is
    the destination somewhere the money already is? This is that question,
    asked as soon as ENTRY and the mix subaddresses exist and still BEFORE the
    swap is quoted -- so a run that would end by undoing itself dies before a
    single satoshi is deposited, rather than hours later on its last step.

    NOTHING CHECKED THIS. The exit destination was validated for FORM (base58,
    checksum, network byte) and for DUPLICATES, and then swept to. A
    well-formed address the operator already owns passes both tests, and there
    are two ways to arrive at one:

      * GS_EXIT_TO IS AN ENVIRONMENT VARIABLE, so it is the kind of value that
        gets set once in a shell profile and reused. The receive bundle's
        address changes every run (create_receive_wallet mints a fresh
        account per receive). A GS_EXIT_TO left over from a previous receive
        wallet is a 95-character string that still validates perfectly.
      * In receive mode the operator handles ENTRY by hand -- it is the
        address they paste to whoever is paying them. Pasting the wrong
        clipboard entry into an exit destination is the ordinary failure mode
        of 95-character base58, not an exotic one.

    THE ENTRY CASE IS THE WORST OUTCOME THIS PIPELINE HAS. ENTRY is the
    address the ThorChain memo names in a public Bitcoin OP_RETURN. The exit
    holds ENTRY as a SOURCE for exactly that reason (see _exit_hold_list:
    "sweeping it would be ... the one link the entire pipeline exists to
    break"). Holding it as a source while allowing it as a DESTINATION covers
    one direction of the same edge: every mixed output would be swept back
    onto the memo address, in N transactions that all converge there. The run
    would spend hours and N fees separating those outputs and then publish
    them, together, on the one address an analyst already has.

    A MIX SUBADDRESS IS THE SECOND CASE, and it defeats the run's other
    defence plus lies about it. Each output gets its own account so that no
    later transaction can merge two of them (see create_subs -- "makes the
    merge IMPOSSIBLE rather than merely discouraged"). Sweeping every output
    to one mix subaddress merges all of them by hand, on purpose. It also
    corrupts the report: _run_exit_withdrawals reads _change_residue right
    after each sweep, so the destination is measured before the later sweeps
    refill it and the operator is told it was "emptied" while the balance
    climbs behind them.

    REFUSED, NOT WARNED. Both outcomes are unrecoverable -- Monero has no
    reversal -- and neither has a legitimate use: an exit destination is by
    definition somewhere other than the wallet being emptied.

    SCOPE, STATED PLAINLY. `addr_index` is every subaddress this run created,
    which is ENTRY plus every mix and extra output, and it is known LOCALLY --
    no RPC, so this check cannot fail open the way a wallet lookup would if
    monero-wallet-rpc were unreachable. It does NOT cover a subaddress
    elsewhere in the same wallet that this run did not create, including the
    accounts' own subaddress 0 change sinks. Those are never printed and never
    handed to the operator, so there is no path by which they reach a
    clipboard; the addresses that DO reach one are exactly the ones checked
    here.
    """
    dests = getattr(args, "exit_to", None)
    if not dests:
        return
    _entry_addrs = ({entry_addr} if isinstance(entry_addr, str)
                    else set(entry_addr or ()))
    for d in dests:
        if d not in addr_index:
            continue
        acct, idx = addr_index[d]
        if d in _entry_addrs:
            integrity_log("exit", "SELF_EXIT_REFUSED:entry")
            sys.exit(
                f"[!] The exit destination {scrub_address(d)} is this run's "
                f"ENTRY address.\n"
                f"    That is the address the ThorChain memo publishes in a "
                f"Bitcoin OP_RETURN. Withdrawing\n"
                f"    to it would sweep every mixed output back onto the one "
                f"address an analyst already\n"
                f"    has, which is the exact link this run exists to break.\n"
                f"    Use an address outside this wallet. If GS_EXIT_TO is set "
                f"in your shell profile,\n"
                f"    it is probably a leftover from an earlier receive wallet "
                f"— check it.")
        integrity_log("exit", "SELF_EXIT_REFUSED:mix_output")
        sys.exit(
            f"[!] The exit destination {scrub_address(d)} is one of this run's "
            f"own mix subaddresses\n"
            f"    (account {acct} / subaddr {idx}). Every output would be "
            f"swept onto it, merging by hand\n"
            f"    the outputs this run gives separate accounts so they can "
            f"NEVER be merged — and the\n"
            f"    exit would report them 'emptied' while the balance piles up "
            f"behind it.\n"
            f"    Use an address outside this wallet.")


def resolve_hop_delay(args) -> tuple:
    """Turn --hop-delay into a window, exiting on a bad spec.

    Separate from parse_hop_delay so the parsing stays pure and testable while
    the exit-and-announce behaviour lives in one place. A non-default window
    is announced BECAUSE it changes how long the run takes -- an operator who
    passes 21600-86400 and then watches nothing happen for six hours should
    have been told, and one who fat-fingers it should not silently get the
    default back.
    """
    try:
        window = parse_hop_delay(getattr(args, "hop_delay", None))
    except ValueError as exc:
        sys.exit(f"[!] {exc}")
    if window != DEFAULT_HOP_DELAY:
        integrity_log("stage0", f"hop_delay:{window[0]}-{window[1]}")
        print(f"  [*] Per-TX broadcast delay: {window[0]}-{window[1]}s "
              f"(default is {DEFAULT_HOP_DELAY[0]}-{DEFAULT_HOP_DELAY[1]}s).")
    return window


def resolve_btc_amount(args) -> None:
    """Refuse a --btc-amount finer than a satoshi.

    Bitcoin's smallest unit is 10^-8 BTC. decimal_arg guards argv against
    non-numbers, NaN and Infinity, but 0.123456789 parses cleanly and is not a
    payable amount -- and every path downstream then hands the operator an
    instruction they cannot follow: the deposit line says "Send exactly
    0.123456789 BTC", the quote was fetched for an amount that cannot be paid,
    and split_btc_amount has a sub-satoshi remainder it must put SOMEWHERE,
    which lands as a chunk that is not a whole number of satoshis either.

    REFUSED rather than rounded. Rounding silently changes how much of the
    operator's money is swapped, and the number they typed is the number they
    meant; a run that quietly swaps a different amount than it was asked to is
    the kind of surprise this toolchain exists not to spring. Found by a test
    asserting every chunk is a whole number of satoshis, which cannot be true
    of a total that is not.
    """
    amt = getattr(args, "btc_amount", None)
    if amt is None:
        return
    # POSITIVE, AND CHECKED HERE. This lived in main()'s stage-2 block, which
    # runs after Tor verification, after the wallet is opened, after the mix
    # subaddresses and the entry set have been created -- so `--btc-amount 0`
    # did all of that work before saying no. Its only test asserted the
    # message existed IN THE SOURCE, with the honest comment "the branch lives
    # inside main(), which nothing executes"; deleting the guard left every
    # suite green. main() is drivable by a test now, but the right answer is
    # that a flag this simple should be refused where the other flag checks
    # are, before anything happens. The stage-2 branch stays as a backstop.
    if amt <= 0:
        integrity_log("stage0", "btc_amount_not_positive")
        sys.exit(
            f"[!] --btc-amount must be positive (got {fmt_btc(amt)}).\n"
            f"    A zero or negative amount is not a swap. Nothing has been "
            f"created and nothing sent.")
    n = max(1, int(getattr(args, "split", 1) or 1))
    # DISTINCT satoshis, not merely one each. n chunks that are positive AND
    # all different need at least 1+2+...+n of them; the old bound was n, which
    # let through totals where split_btc_amount could only return repeated
    # deposit amounts -- the exact Bitcoin-side cluster the split exists to
    # remove, and it returned them silently.
    #
    # EVERY CHUNK STILL NEEDS A SATOSHI, which is the weaker half of this and
    # the reason the bound existed at all: the version before it invented an
    # answer, and 1 satoshi across 3 chunks came out as [-1, 1, 1] -- a
    # NEGATIVE amount, summing correctly, passing every other check, and
    # reaching the operator as "send exactly -0.00000001 BTC".
    _min_sat = n * (n + 1) // 2
    if n > 1 and amt < SATOSHI_BTC * Decimal(_min_sat):
        integrity_log("stage0", "btc_amount_too_small_to_split")
        sys.exit(
            f"[!] --btc-amount {fmt_btc(amt)} cannot be split {n} ways: every chunk "
            f"needs at least one\n"
            f"    satoshi and no two may be equal, so {n} chunks need at least "
            f"{fmt_btc(SATOSHI_BTC * Decimal(_min_sat))} BTC\n"
            f"    ({_min_sat} satoshis). Equal chunks would put {n} identical "
            f"deposits on the Bitcoin\n"
            f"    chain, which is the cluster splitting the amount exists to "
            f"avoid. Use fewer --split chunks.")
    if amt != amt.quantize(SATOSHI_BTC):
        integrity_log("stage0", "btc_amount_subsatoshi")
        sys.exit(
            f"[!] --btc-amount {amt} is finer than one satoshi "
            f"(0.00000001 BTC).\n"
            f"    Refusing rather than rounding: rounding would swap a "
            f"different amount than you\n"
            f"    asked for, and the deposit instructions would name a figure "
            f"no wallet can send.\n"
            f"    Use {fmt_btc(amt.quantize(SATOSHI_BTC, rounding=ROUND_DOWN))} or "
            f"{fmt_btc(amt.quantize(SATOSHI_BTC, rounding=ROUND_DOWN) + SATOSHI_BTC)}.")


def resolve_usage_fee(args) -> None:
    """Validate the operator's cut, before anything is fetched or spent.

    Mirrors resolve_exit_destinations deliberately: same env-first rule, same
    validator, same refusal-not-warning stance. A cut destination is the
    operator's OWN address, which makes it exactly as sensitive as --exit-to --
    the run spends hours unlinking the mix from the swap memo, and an address
    that collects a slice of every run is the one value that could put it back.

    FOUR REFUSALS, and each is a thing that would otherwise be discovered after
    the money moved:

      * A CUT WITH NOWHERE TO GO. --usage-fee-pct without a destination is a
        request to skim into nothing.
      * AN OUT-OF-BAND PERCENTAGE. Zero or negative is not a cut; above
        USAGE_FEE_PCT_MAX is not one either. Sanity ceiling, not a judgement --
        see the constant.
      * THE CUT ADDRESS IS AN EXIT DESTINATION. Then the cut is not a cut: it
        lands with the mixed funds, in the same wallet, and the operator has
        paid a transaction to move money to itself. Refused rather than
        warned, because the fan-out has already been planned around it by the
        time anything would notice.
      * THE CUT ADDRESS IS THE BTC ENTRY. A Monero validator would not catch
        it, and it is the shape a copy-paste slip takes.

    THERE IS NO BTC-SIDE CUT AND THERE WILL NOT BE ONE. Bitcoin amounts are
    public and exact, and the ThorChain memo publishes ENTRY in a plaintext
    OP_RETURN -- so a cut taken there is both readable to six significant
    figures and attached, on the public chain, to the Monero address it was
    meant to be unlinked from. See USAGE_FEE_PCT. The cut is XMR-side only, and
    the flag names say so.
    """
    # THE RATE GOES THROUGH env_or_argv TOO. The address did and the rate did
    # not, which is the same split exit_strategy_simulator's --fee-pct had. The
    # DEFAULT is public in the source, so it leaks nothing -- but an OVERRIDE
    # is a per-operator constant, and putting it on argv publishes it to `ps`
    # and to every local account for the life of the run, next to amounts it
    # divides exactly into.
    _pct_given = env_or_argv("GS_USAGE_FEE_PCT",
                             getattr(args, "usage_fee_pct", None),
                             "The usage-fee fraction")
    _addr = env_or_argv("GS_USAGE_FEE_ADDRESS",
                        getattr(args, "usage_fee_address", None),
                        "The usage-fee destination")
    args.usage_fee_address = _addr or None
    if not args.usage_fee_address:
        # A fresh account+subaddress is minted per run instead (see stage 4),
        # which is the no-reuse default. Nothing to validate here.
        args.usage_fee_pct = (Decimal(str(_pct_given)) if _pct_given is not None
                            else None)
        if args.usage_fee_pct is None and getattr(args, "usage_fee", False):
            args.usage_fee_pct = USAGE_FEE_PCT
        _check_fee_pct(args)
        _refuse_fee_combinations(args)
        return
    if not getattr(args, "usage_fee", False) and _pct_given is None:
        sys.exit(
            "[!] A usage-fee destination was given but --usage-fee was not.\n"
            "    Refusing to guess: an address alone does not say whether this "
            "run should skim.\n"
            "    Add --usage-fee to take the default "
            f"{(USAGE_FEE_PCT * 100).normalize()}% , or drop the address.")
    args.usage_fee_pct = (Decimal(str(_pct_given)) if _pct_given is not None
                        else USAGE_FEE_PCT)
    _check_fee_pct(args)
    validate_xmr_address(args.usage_fee_address, "--usage-fee-address")
    _refuse_fee_combinations(args)
    for _d in (getattr(args, "exit_to", None) or []):
        if _d == args.usage_fee_address:
            sys.exit(
                f"[!] --usage-fee-address is also an --exit-to destination "
                f"({scrub_address(_d)}).\n"
                f"    Then it is not a fee: it lands in the same place "
                f"as the mixed funds,\n"
                f"    having paid a transaction to move your money to itself. "
                f"Give the usage fee its own\n"
                f"    address, or drop --usage-fee.")
    if args.usage_fee_address == (getattr(args, "btc_entry", None) or object()):
        sys.exit("[!] --usage-fee-address is the BTC entry address. That is a "
                 "copy-paste slip, not a destination.")
    integrity_log("usagefee", "address_validated")


def _refuse_fee_combinations(args) -> None:
    """The two shapes where the cut is charged and never paid.

    Both were REAL in the first version of this feature, both silent, and both
    are refused rather than patched -- the same answer resolve_split already
    gives to `--split N --peel`, and for the identical reason: the code has no
    representation for a partial one.

      * --peel. plan_usage_fee deducts the cut from the balance
        unconditionally, but only the FAN-OUT branch of build_distribution_plan
        builds a cut destination; the peel branch has no reference to it at
        all. So a peel run charges the cut, pays nobody, and leaves the residue
        on the veil carrier -- which is in addr_index, so the exit sweeps it
        straight to --exit-to. The operator is silently paid nothing.

      * --split > 1. The cut is split across N fan-out transactions relayed as
        one batch. Two things break: a partial relay pays a partial cut, and
        the spendability floor is checked against the TOTAL while the operator
        receives N separate outputs -- each of which can be individually below
        the fee to move it, which is the exact uncollectable output the floor
        exists to prevent. Loading the whole cut onto chunk 0 instead would
        make one fan-out one destination wider than its siblings, which the
        placement doctrine rejects on its own terms.

    With --split 1 the window does not exist: the fan-out is one
    transfer_split and _run_round aborts on any failure, so either the mix
    outputs and the cut exist under one txid or nothing was spent. "The mix
    started" and "the operator was paid" are the same event.
    """
    if not getattr(args, "usage_fee_pct", None):
        return
    if getattr(args, "peel", False):
        sys.exit(
            "[!] --usage-fee with --peel is refused.\n"
            "    The peel planner has no fee destination, so the fee would be "
            "deducted from the\n"
            "    balance and paid to nobody -- the residue lands on the veil "
            "carrier and the exit\n"
            "    sweeps it to your --exit-to. Charged and never paid, "
            "silently.\n"
            "    Use --peel without --usage-fee, or --usage-fee without --peel.")
    if int(getattr(args, "split", 1) or 1) > 1:
        sys.exit(
            f"[!] --usage-fee with --split "
            f"{int(getattr(args, 'split', 1) or 1)} is refused.\n"
            f"    The fee would be split across that many fan-out "
            f"transactions. A partial relay\n"
            f"    pays a partial fee, and the spendability floor is checked "
            f"against the total while\n"
            f"    you would receive one output per chunk -- each of which can "
            f"be worth less than the\n"
            f"    fee to move it. Take the usage fee on a --split 1 run.")


def _check_fee_pct(args) -> None:
    """The percentage band. Split out so both branches above take one rule."""
    _p = getattr(args, "usage_fee_pct", None)
    if _p is None:
        return
    if _p <= 0:
        sys.exit(f"[!] --usage-fee-pct must be positive (got {_p}). A zero fee "
                 f"is the default already -- leave --usage-fee off.")
    if _p > USAGE_FEE_PCT_MAX:
        sys.exit(
            f"[!] --usage-fee-pct {_p} is above the ceiling of "
            f"{USAGE_FEE_PCT_MAX}.\n"
            f"    That is a sanity bound, not an opinion about your fee: above "
            f"it the remainder\n"
            f"    stops being able to fund the mix it is supposed to pay for.")


def resolve_split(args) -> None:
    """Bounds-check --split. It is SUPPORTED now; it used to be refused.

    THE REFUSAL WAS A PLACEHOLDER FOR THIS CHANGE. --split N used to route all
    N chunks to one entry address, which cost three things, and the third is
    the one that made refusing it correct at the time:

      * the aggregator saw N deposits to one Monero address and could link the
        payments -- thor_swap_preparer.resolve_destinations refuses exactly
        this, in this repo, for this reason;
      * the per-chunk newnym(required=True) became theatre, because a fresh
        circuit cannot disguise N request bodies carrying the same unique
        95-character destination;
      * all N swap outputs landed on one subaddress, so the entry veil's
        sweep_all spent them in ONE transaction whose N input rings each
        contained a publicly-known swap output. Intersecting N sets of sixteen
        identifies that transaction and with it the carrier the rest of the run
        spends from. The veil did not merely stop helping; it became the thing
        that gave the carrier away.

    All three are fixed at the source rather than worked around: the run mints
    one entry subaddress per chunk (create_entry_set), each chunk's quote names
    its own address (stage2_get_swap_quotes), each entry output gets its own
    veil into its own carrier, and each carrier funds its own fan-out over its
    own slice of the mix targets (build_entry_veils states the invariant:
    no transaction ever spends value from two different chunks).

    WHAT IS STILL REFUSED IS --split WITH --peel, and that refusal lives at the
    distribution rather than here, because it depends on the mode: each chunk
    would need its own sequential, confirmation-gated chain, and N of them is
    N x hops x ~20 minutes with no resume when one stops part-way.

    An upper bound, because every chunk costs a swap fee, a veil transaction
    and an account -- and because the offline wallet's subaddress lookahead is
    a real, measured limit (OPSEC_SETUP.md: the online wallet passes 50
    accounts during the second run). Splitting further buys nothing an extra
    run would not.
    """
    n = getattr(args, "split", 1)
    if n is None:
        return
    n = int(n)
    if n < 1:
        integrity_log("stage0", "split_invalid")
        sys.exit(f"[!] --split must be at least 1 (got {n}).")
    if n > MAX_SPLIT:
        integrity_log("stage0", "split_too_large")
        sys.exit(
            f"[!] --split {n} is above the maximum of {MAX_SPLIT}.\n"
            f"    Every chunk costs a swap fee, its own veil transaction and "
            f"its own wallet account,\n"
            f"    and the offline signing wallet derives subaddresses for a "
            f"bounded number of accounts\n"
            f"    (50 by default, fixed when it was created — see "
            f"OPSEC_SETUP.md). Past this point an\n"
            f"    extra run buys more than an extra chunk.")
    if n > 1 and getattr(args, "peel", False):
        # HERE, NOT AT THE DISTRIBUTION. This refusal used to live in
        # build_distribution_plan, which runs after the quotes are fetched,
        # after the deposit instructions are printed, and therefore possibly
        # after the operator has already sent Bitcoin -- at which point
        # "refused" means their money is mid-swap with no run to receive it.
        # Both flags are known at parse time, so the answer is known at parse
        # time. build_distribution_plan keeps its check as a backstop for a
        # caller that reaches it another way.
        integrity_log("stage0", "split_peel_refused")
        sys.exit(
            f"[!] --split {n} with --peel is not supported.\n"
            f"    Each chunk needs its own peel chain — merging them into one "
            f"would re-create\n"
            f"    exactly the convergence that splitting the swap exists to "
            f"avoid — and a peel\n"
            f"    chain is sequential and confirmation-gated, so {n} of them "
            f"would take\n"
            f"    {n} x hops x ~20 minutes with no resume if one stops "
            f"part-way.\n"
            f"    Use --split with the fan-out distribution (drop --peel), or "
            f"--peel with a\n"
            f"    single chunk.")
    if n > 1:
        integrity_log("stage0", f"split:{n}_chunks")

def resolve_swap_arrival(args) -> None:
    """Bounds-check the flags that decide when the swap has fully arrived.

    Up front, next to the other syntactic checks, because every one of these is
    only consulted at stage 4 -- after the accounts are made, the quotes are
    fetched and the operator has already sent BTC. A tolerance of 1.5 accepted
    there would compute a NEGATIVE floor, which no balance can fail to clear:
    the gate would open on the first piconero and the run would be back to the
    defect this whole path exists to fix, silently.
    """
    # GS_EXPECT_TOTAL_XMR FIRST, argv only with a warning.
    #
    # /proc/<pid>/cmdline is mode 0444 -- readable by every account on the host
    # for the whole life of a run that lasts hours -- and this value is the
    # total XMR the swap is delivering. It is precisely the class of number the
    # integrity chain redacts and report_holdings refuses to write to disk, and
    # env_or_argv exists because it kept reappearing on argv anyway: the
    # off-ramp amount, then the BTC entry ADDRESS, then the swap amounts. Its
    # docstring says it is there "so the next caller cannot half-apply the
    # lesson". This flag was the next caller, and did.
    #
    # Cast here rather than through env_or_argv's `cast`, so a bad environment
    # value produces this tool's own message instead of a raw traceback.
    _exp = env_or_argv(
        "GS_EXPECT_TOTAL_XMR",
        str(args.expect_total_xmr) if args.expect_total_xmr is not None else None,
        "The expected total XMR")
    if _exp is not None:
        args.expect_total_xmr = decimal_env(
            "GS_EXPECT_TOTAL_XMR", _exp, positive=True,
            max_value=XMR_ABSURD_TOTAL)

    tol = getattr(args, "swap_tolerance", SWAP_TOLERANCE_DEFAULT)
    if not (Decimal(0) <= tol < Decimal(1)):
        sys.exit(f"[!] --swap-tolerance must be >= 0 and < 1 (got {tol}). It is "
                 f"the FRACTION of the expected total that may be missing and "
                 f"still count as fully arrived, so 0.10 means 10%.")
    exp = getattr(args, "expect_total_xmr", None)
    if exp is not None:
        # NOT just `<= 0`. decimal_arg accepts "Infinity" and "NaN" -- they are
        # valid Decimal literals -- and both defeat this gate in different
        # ways: Infinity is a target no balance ever reaches, so the run waits
        # out its whole timeout and blames the swap; NaN makes every
        # comparison False, so the gate never opens either and `<= 0` does not
        # catch it because NaN <= 0 is False.
        if not exp.is_finite():
            sys.exit(f"[!] --expect-total-xmr must be a real number (got "
                     f"{exp}). Infinity and NaN are valid Decimal literals and "
                     f"neither is an amount the wallet can ever reach: the run "
                     f"would wait out its whole timeout and report the swap as "
                     f"short.")
        if exp <= 0:
            sys.exit(f"[!] --expect-total-xmr must be positive (got {exp}). A "
                     f"non-positive target is no target: the run would stop "
                     f"waiting on the first chunk of however many are coming.")
        try:
            accept_floor(exp, tol)
        except ValueError as e:
            sys.exit(f"[!] --expect-total-xmr {exp} is unusable: {e}.")
    if getattr(args, "accept_partial_swap", False):
        integrity_log("stage0", "accept_partial_swap")


def resolve_entry_accounts(rpc, addr_index: dict, entry_addr_list: list,
                           bundle_account) -> list:
    """Which (account, subaddress) the run spends from. Returns one pair per
    entry address, in chunk order.

    READ BACK, never assigned from a branch. This used to be

        bal_account = receive_account_index if receive_mode else 0

    and that hard-coded 0 drove the balance poll, the peel carriers, the plan's
    account_index, the change-sweep destination and change_target -- so a send
    run polled a balance that was not ENTRY's, sized its plan from it, and put
    every spend and all its change on account 0 / subaddress 0, the wallet's
    PRIMARY address, which the change sweep then spent. Nothing failed.

    PLURAL, because --split N mints one entry subaddress per chunk
    (create_entry_set) and each is spent by its own veil. Verifying only the
    first would leave the rest unproven, and an unverified pair is exactly the
    silent failure this function exists for: the pipeline does not crash, it
    plans against a different subaddress's balance.

    `bundle_account` is what the receive bundle claimed, or None for a send
    run. The two are derived independently -- one from a file on disk, one from
    the wallet -- so a disagreement means the bundle does not describe this
    wallet: a stale bundle, the wrong wallet open, an edited file. It exits
    rather than picking one, because spending on the strength of a
    disagreement is how funds move from somewhere the operator did not intend.
    A receive run has exactly one entry, so the bundle is compared against it.
    """
    pairs = []
    for _pos, entry_addr in enumerate(entry_addr_list):
        account = _src_account(addr_index, entry_addr)
        index = _src_index(addr_index, entry_addr)
        if bundle_account is not None and bundle_account != account:
            integrity_log("stage3", "entry_account_mismatch")
            sys.exit(
                f"[!] The receive bundle says ENTRY is in account "
                f"{bundle_account}, but the wallet puts it in account "
                f"{account}.\n"
                f"    Refusing to spend: one of them is describing a different "
                f"wallet. Check that the\n"
                f"    bundle belongs to the wallet monero-wallet-rpc currently "
                f"has open.")
        # And PROVE the pair, rather than trusting it. A one-line mistake here
        # is invisible: the pipeline runs, the plan looks sane, and the only
        # symptom is that the money moves from the wrong account. Ask the
        # wallet to resolve (account, index) back to an address; it must be
        # this entry. Once per entry -- see the docstring.
        verify_spend_source(rpc, account, index, entry_addr)
        pairs.append((account, index))
    return pairs

def stage4_await_swap(args, rpc, entry_pair_list: list,
                      entry_addr_list: list, swap_deposits: list,
                      receive_mode: bool,
                      total_bal: Decimal, unlocked_bal: Decimal) -> tuple:
    """Block until ALL of the swapped XMR has arrived. Returns (total, unlocked).

    ACROSS THE WHOLE ENTRY SET, not one address. With --split N the chunks land
    on N different subaddresses (create_entry_set), settling minutes to hours
    apart, so the balance this gate compares against its target is the SUM --
    see entry_set_balance. Watching one of them would finish the moment that
    one chunk landed, which is the first-chunk defect this function exists to
    remove, reintroduced one level up.

    Sender mode only: the swapped XMR lands on ENTRY after the operator sends
    BTC and ThorChain settles (and in manual mode, whenever they send it).
    ENTRY is fresh this run, so a single check is always ~0 and would abort a
    perfectly good run. Receiver mode already has the funds.

    WAIT FOR ALL OF IT, not for the first thing to land. --split N means N
    independent swaps settling minutes to hours apart; the gate that decides
    "the swap has arrived" is the SUMMED quote, not any balance above dust.
    See wait_for_swap_arrival for what the old gate cost.

    A shortfall EXITS unless --accept-partial-swap. Nothing has been spent at
    this point, so stopping costs time and nothing else -- while proceeding
    commits the run to planning against a fraction, and whatever lands
    afterwards is money nothing in the pipeline will ever mix.
    """
    n_chunks = len(swap_deposits) or max(args.split, 1)
    quoted, unreadable, chunk_amounts = swap_expected_total(swap_deposits)
    # KEPT BEFORE THE OVERRIDE BELOW REPLACES IT. The rescale further down
    # needs the quotes' own sum as its denominator, and `quoted` stops being
    # that the moment --expect-total-xmr is applied. See the comment there.
    _quoted_sum = quoted
    if args.expect_total_xmr is not None:
        # An explicit target overrides the quotes: in manual mode there are
        # none, and where there are both, the operator holding the
        # thor_swap_preparer bundle knows what was actually sent.
        #
        # LOUDLY when it is SMALLER, though. A target below what the quotes
        # already promise lowers the gate this whole path exists to raise, and
        # the difference is money that will arrive after the run has planned.
        # resolve_swap_arrival can only check the flag is positive; the quotes
        # do not exist yet when it runs.
        if quoted > 0 and args.expect_total_xmr < quoted:
            print(f"  [!] --expect-total-xmr ({args.expect_total_xmr} XMR) is "
                  f"BELOW the {quoted} XMR the swap quotes promise. Using the "
                  f"lower number lowers the bar for 'the swap has arrived' — "
                  f"anything between the two lands after this run has planned "
                  f"and is never mixed.")
            integrity_log("stage4", "expect_total_below_quotes")
        quoted = args.expect_total_xmr
        unreadable = 0
    # RESCALE the breakdown; do not throw it away.
    #
    # This read `chunk_amounts = []`, on the reasoning that an explicit target
    # replaces the quotes so it replaces their breakdown too. That is wrong,
    # and it undid the unequal-chunk protection at the exact moment the
    # operator did what this tool asks them to do. With JoinMarket's quotes
    # 0.50/0.30/0.15/0.05 the gate correctly held at 0.95 -- and passing
    # --expect-total-xmr dropped the floor to 0.90 and called it PAID with a
    # whole chunk in flight. Measured.
    #
    # The operator's total corrects the MAGNITUDE. It says nothing about the
    # proportions, and the quotes remain the only evidence of those, so the
    # breakdown is scaled onto the new total rather than discarded. With no
    # quotes at all (manual mode) there is genuinely nothing to scale, and the
    # count-only path below says so out loud.
    # AGAINST THE QUOTES' OWN SUM, not against `quoted`. This divided by
    # `quoted`, which the block above has already REPLACED with
    # args.expect_total_xmr -- so the expression was
    # `args.expect_total_xmr / args.expect_total_xmr`, _scale was exactly 1,
    # and "rescale the breakdown" left the breakdown untouched. Proven in the
    # real path, not by reading: asserting `_scale == 1` here runs four times
    # in test_swap_arrival and never fires, and the suite stays green with it
    # asserted -- no existing test could tell the rescale from a no-op.
    #
    # The cost is a gate on MISMATCHED SCALES: `quoted` carried the operator's
    # total while chunk_amounts still carried the quotes' raw magnitudes, and
    # swap_arrival_floor keys "everything except the smallest chunk" off the
    # smaller of the two. When the operator's total is BELOW the quotes' sum --
    # the case ten lines up prints a dedicated warning for, so it is expected,
    # not exotic -- the unscaled smallest is too LARGE, the floor drops to the
    # bare tolerance, and the gate opens with a whole chunk still in flight.
    #
    # Driven on quotes of 0.60/0.30/0.08/0.02 with --expect-total-xmr 0.1:
    # unscaled floor 0.095, correct floor 0.098000000001, and the balance with
    # the smallest swap still unarrived is 0.098 -- ARRIVED on the broken gate,
    # still waiting on the fixed one. That chunk then lands after the run has
    # planned against a fraction and is never mixed, which is verbatim the
    # failure the comment above says this block was written to stop.
    #
    # Above the quotes' sum it fails the safe way (too strict, waits longer),
    # which is why it never showed up as a stall anyone chased.
    if args.expect_total_xmr is not None:
        if _quoted_sum > 0 and chunk_amounts:
            _scale = args.expect_total_xmr / _quoted_sum
            chunk_amounts = [_a * _scale for _a in chunk_amounts]
        else:
            chunk_amounts = []
    # Keyed on the SMALLEST chunk, not on how many there are -- see
    # swap_arrival_floor for the two paths the count-based version missed.
    floor_, _tightened = swap_arrival_floor(quoted, args.swap_tolerance,
                                            chunk_amounts, n_chunks)
    if _tightened:
        # "The smallest chunk" is only KNOWN when the quotes are. With a total
        # and a count alone the size is assumed equal, and this said otherwise
        # — asserting a measured fact about the operator's swaps that nothing
        # here measured. Say which of the THREE it is.
        #
        # The third was missing and is reached the same way the second is. When
        # --expect-total-xmr covers a swap whose quote could not be read,
        # swap_expected_total returns amounts for the READABLE ones only and
        # the rescale above scales that partial set onto the operator's total.
        # chunk_amounts is then truthy, so this printed "The smallest quoted
        # chunk is" about a set that does not include every swap in the target
        # -- the exact claim the paragraph above says the line must not make,
        # through the door it did not check. Measured over 4000 random shapes
        # (2-8 swaps, 1..N-1 quotes unreadable): 1007 of them printed it.
        #
        # The rescale itself STAYS. Over those same 4000 it opened a gate the
        # count-only fallback would have held zero times, so it is not the
        # looser answer -- only the less certain one, which is what the wording
        # now carries.
        _basis = (f"Split equally, each of the {n_chunks} chunks would be"
                  if not chunk_amounts
                  else ("The smallest chunk this target implies is"
                        if len(chunk_amounts) != n_chunks
                        else "The smallest quoted chunk is"))
        print(f"  [*] Arrival gate tightened to {floor_} XMR, above what the "
              f"{args.swap_tolerance * 100:.0f}% slippage tolerance alone "
              f"would allow. {_basis} worth less than that tolerance, so at "
              f"the wider figure a whole chunk could be missing and still "
              f"count as a complete swap.")
        if not chunk_amounts:
            print(f"      That assumes your {n_chunks} swaps were EQUAL. If "
                  f"they were not, the smallest one may be smaller than this "
                  f"gate allows for — pass --pairs, or check the arrival "
                  f"yourself before the run plans.")
        elif len(chunk_amounts) != n_chunks:
            print(f"      {n_chunks - len(chunk_amounts)} of your {n_chunks} "
                  f"swaps carried no readable quote, so their size is inferred "
                  f"from the others rather than read. If one of those is the "
                  f"smallest, this gate may be looser than it looks — check "
                  f"that swap's arrival yourself before the run plans.")
        integrity_log("stage4", "arrival_gate_tightened_for_smallest_chunk")
    # NO CHUNK COUNT, NO GUARANTEE. In manual mode swap_deposits is empty, so
    # n_chunks falls back to --split -- which is 1 by default and does nothing
    # else in manual mode. An operator who sent twelve swaps by hand and passed
    # only --expect-total-xmr gets the plain tolerance, and one of the twelve
    # can be absent inside it. Say so; do not let it pass as a checked run.
    if (quoted > 0 and not chunk_amounts and n_chunks <= 1):
        print(f"  [!] The number of swaps is UNKNOWN to this run, so the gate "
              f"below can only check the TOTAL: any single swap worth less "
              f"than {args.swap_tolerance * 100:.0f}% of it could be missing "
              f"and still count as complete. If you sent more than one, pass "
              f"--split <how many> as well.")
        integrity_log("stage4", "arrival_chunk_count_unknown")

    # ENTERED ON A SHORTFALL, not only on an empty ENTRY. The guard used to
    # read `unlocked_bal <= DUST_XMR` alone, which is sound only while ENTRY is
    # guaranteed fresh and empty here -- true today, and exactly the kind of
    # assumption that makes the wait skippable the moment something upstream
    # changes. With a target in hand, "not enough has arrived yet" is the
    # condition that actually matters.
    if receive_mode:
        # "THE FUNDS ARE ALREADY THERE" IS AN ASSUMPTION, NOT A FACT, and this
        # branch used to treat it as one: it returned immediately and printed
        # that --expect-total-xmr, --swap-tolerance and --accept-partial-swap
        # "have NO EFFECT in receiver mode".
        #
        # They have an effect. Receiver mode means the XMR arrives from a swap
        # the operator arranged with thor_swap_preparer, and a --split N swap
        # lands N chunks minutes to hours apart -- the same staggered arrival
        # the send-mode wait below exists for. Nothing forces the operator to
        # run receive_watch first, and nothing checks that they did.
        #
        # Driven: receiver mode, --expect-total-xmr 4.0, 1.0 XMR on ENTRY.
        # It returned (1.0, 1.0) immediately, printed "NO EFFECT", and the run
        # planned against a QUARTER of the money. The dust guard downstream
        # cannot catch it -- 1.0 XMR is four orders of magnitude above
        # DUST_XMR. Chunks 2-4 then land on an ENTRY the run has finished with:
        # the veil has already swept it, the distribution has already sized
        # itself, and the exit correctly refuses to sweep ENTRY -- so they sit
        # on the one address the public ThorChain memo names, unmixed, until
        # the operator notices.
        #
        # So when the operator HAS told us the total, wait for it, with the
        # same floor, the same tolerance and the same --accept-partial-swap
        # escape hatch as the send path. The only thing receiver mode genuinely
        # lacks is quotes to derive the total FROM; given one, there is no
        # difference worth a separate code path.
        # THE TARGET, from whichever source has one.
        #
        # --expect-total-xmr wins where both exist: the operator holding the
        # bundle can know something the file does not (a swap they cancelled, a
        # sender who paid a different amount), and stage4 already warns above
        # when an explicit target sits BELOW what the quotes promise.
        #
        # Otherwise the quotes, when --swap-pairs supplied them. This is the
        # "only thing receiver mode genuinely lacks" named a few lines up, and
        # it removes a hand-typed decimal from the one place where typing it
        # too small opens the gate early and spends part of a swap.
        _rtarget = (args.expect_total_xmr if args.expect_total_xmr is not None
                    else (quoted if quoted > 0 else None))
        if _rtarget is None:
            # No target, so nothing can be checked -- and that is worth saying,
            # because "it returned immediately" reads as "it verified".
            if unlocked_bal <= DUST_XMR:
                print("  [!] Receiver mode with no --expect-total-xmr: this "
                      "run does NOT wait, and ENTRY holds nothing yet.")
            print("      Pass --expect-total-xmr <total XMR>, or --swap-pairs "
                  "<thor_pairs.json> to take the total from the quotes.")
            integrity_log("stage4", "arrival_receive_no_target")
            return total_bal, unlocked_bal

        # chunk_amounts, NOT []. With the bundle read this is the real
        # per-swap breakdown, and swap_arrival_floor uses it to tighten the
        # gate when the SMALLEST chunk is worth less than the flat tolerance --
        # the case where one whole missing swap would otherwise hide inside it.
        # Empty when no bundle was given, which is the old behaviour exactly.
        _rfloor, _rtight = swap_arrival_floor(
            _rtarget, args.swap_tolerance, chunk_amounts, n_chunks)
        if _rtight:
            print(f"  [*] Arrival gate tightened to {_rfloor} XMR, above what "
                  f"the {args.swap_tolerance * 100:.0f}% tolerance alone would "
                  f"allow: the smallest quoted swap is worth less than that "
                  f"tolerance, so at the wider figure it could be missing "
                  f"entirely and this run would still start mixing.")
            integrity_log("stage4", "receive_gate_tightened_for_smallest_chunk")
        if unlocked_bal >= _rfloor:
            integrity_log("stage4", "arrival_receive_already_complete")
            return total_bal, unlocked_bal

        print(f"  [*] Receiver mode: waiting for ~{_rfloor} XMR of the "
              f"{_rtarget} XMR you expect "
              f"({n_chunks} chunk(s), "
              f"{args.swap_tolerance * 100:.0f}% tolerance). "
              f"{unlocked_bal} XMR unlocked so far.")
        _rarr = wait_for_swap_arrival(
            entry_balance_reader(rpc, entry_pair_list), _rfloor, n_chunks)
        total_bal, unlocked_bal = _rarr["total"], _rarr["unlocked"]
        if _rarr["state"] == "interrupted":
            sys.exit("[!] Shutdown requested while waiting for XMR arrival.")
        if _rarr["state"] == "funded":
            integrity_log("stage4", "xmr_arrival_done")
            return total_bal, unlocked_bal
        integrity_log("stage4", f"arrival_incomplete:{_rarr['state']}")
        if not args.accept_partial_swap:
            sys.exit(
                f"[!] The expected XMR has NOT fully arrived "
                f"({'nothing new arrived' if _rarr['state'] == 'stalled' else 'the time limit was reached'}).\n"
                f"    On ENTRY now: {unlocked_bal} XMR unlocked "
                f"({total_bal} XMR total); expected ~{_rfloor}.\n"
                + arrival_blindness_note(_rarr) +
                f"    Nothing has been spent. Planning against a fraction "
                f"leaves the rest UNMIXED on ENTRY -- the address your swap "
                f"memo names in public -- and nothing in this run will ever "
                f"mix it.\n"
                f"    Wait and re-run, or pass --accept-partial-swap to plan "
                f"against what is here.")
        print(f"  [!] --accept-partial-swap: planning against {unlocked_bal} "
              f"XMR. Anything arriving later stays on ENTRY unmixed.")
        return total_bal, unlocked_bal
    if not (unlocked_bal <= DUST_XMR
            or (floor_ > 0 and unlocked_bal < floor_)):
        return total_bal, unlocked_bal

    if unreadable:
        print(f"  [!] {unreadable} of {len(swap_deposits)} swap quote(s) carry "
              f"no readable expected XMR, so they contribute NOTHING to the "
              f"target below. The wait will finish once the READABLE ones have "
              f"landed, even if the others are still in flight — pass "
              f"--expect-total-xmr to set the real total.")
        integrity_log("stage4", f"arrival_quotes_unreadable:"
                                f"{unreadable}_of_{len(swap_deposits)}")
    if floor_ > 0:
        _where = (f"ENTRY {scrub_address(entry_addr_list[0])}"
                  if len(entry_addr_list) == 1
                  else f"the {len(entry_addr_list)} entry addresses")
        print(f"  [*] Waiting for ~{floor_} XMR ({n_chunks} chunk(s), "
              f"{args.swap_tolerance * 100:.0f}% slippage tolerance) to "
              f"arrive+unlock on {_where}...")
    else:
        # NO TARGET AT ALL, which means the gate below is `unlocked > DUST_XMR`
        # -- the pre-fix condition, verbatim. Say so unconditionally.
        #
        # This warning used to sit behind `if n_chunks > 1`, and in manual mode
        # n_chunks falls back to `max(args.split, 1)` -- a flag that does
        # NOTHING in manual mode, because manual mode is defined by there being
        # no --btc-amount for --split to divide. So the default manual run
        # (--split unset, i.e. 1) printed nothing at all and quietly reverted
        # to first-chunk behaviour: the exact defect this function was written
        # to remove, hidden behind a condition that looked like it was about
        # chunk count.
        print(f"  [*] Waiting for swapped XMR to arrive+unlock on "
              + (f"ENTRY {scrub_address(entry_addr_list[0])}..."
                 if len(entry_addr_list) == 1
                 else f"the {len(entry_addr_list)} entry addresses..."))
        print("  [!] NO EXPECTED TOTAL is known for this run, so this wait "
              "CANNOT tell one chunk from all of them: it finishes as soon as "
              "any balance above dust unlocks. Anything arriving after that is "
              "never mixed by this run. ENTRY is named in plaintext by the "
              "public swap memo, so a stranger can trip this gate for the cost "
              "of dust.")
        print("      Pass --expect-total-xmr <total XMR> to wait for all of "
              "it. With --btc-amount the target is summed from the quotes "
              "automatically.")
        integrity_log("stage4", "arrival_no_target")

    arrival = wait_for_swap_arrival(
        entry_balance_reader(rpc, entry_pair_list), floor_, n_chunks)
    total_bal, unlocked_bal = arrival["total"], arrival["unlocked"]

    if arrival["state"] == "interrupted":
        sys.exit("[!] Shutdown requested while waiting for XMR arrival.")
    if arrival["state"] == "funded":
        # NOT the balance: unlocked_bal is the exact XMR that arrived from the
        # swap, the most linkable amount on the receive side. Log only that
        # arrival completed.
        integrity_log("stage4", "xmr_arrival_done")
        return total_bal, unlocked_bal

    # A SHORTFALL IS NOT A DETAIL TO PROCEED THROUGH. Whatever is missing
    # arrives on ENTRY after this run has finished planning against the rest,
    # and nothing downstream ever spends it: the veil already swept ENTRY, the
    # distribution already sized itself. It sits on the one address the swap
    # memo names in public until the exit sweeps it, in a single transaction,
    # to the operator's destination.
    short = floor_ - unlocked_bal if floor_ > 0 else Decimal(0)
    integrity_log("stage4", f"arrival_incomplete:{arrival['state']}")
    why = (f"nothing new arrived for {XMR_ARRIVAL_STALL // 60} min"
           if arrival["state"] == "stalled"
           else f"the {XMR_ARRIVAL_TIMEOUT // 3600}h limit was reached")
    _blind = arrival_blindness_note(arrival)
    if not args.accept_partial_swap:
        sys.exit(
            f"[!] The swap has NOT fully arrived: {why}.\n"
            f"    On ENTRY now: {unlocked_bal} XMR unlocked "
            f"({total_bal} XMR total).\n"
            + (f"    Expected:     ~{floor_} XMR — short by {short}.\n"
               if floor_ > 0 else "")
            + f"    Chunks expected: {n_chunks}.\n"
            + _blind
            + f"\n"
            f"    NOTHING HAS BEEN SPENT. The funds are on ENTRY and they are "
            f"safe.\n"
            f"    Planning against part of the money is what leaves the rest "
            f"unmixed:\n"
            f"    a chunk that lands after the plan is built is never "
            f"distributed, and\n"
            f"    the swap memo naming ENTRY is public — so it would leave in "
            f"one hop\n"
            f"    from that address to your --exit-to destination.\n"
            f"\n"
            f"    WAIT for the rest to land, then run this again. Do that\n"
            f"    BEFORE re-running: a send-mode run mints a NEW ENTRY every\n"
            f"    time, so re-running now leaves what did arrive stranded on\n"
            f"    the address above with nothing pointed at it.\n"
            f"\n"
            f"    If the rest is never coming, --accept-partial-swap mixes what\n"
            f"    arrived. To mix the stranded remainder afterwards: mint a\n"
            f"    fresh receive wallet (create_receive_wallet), send the ENTRY\n"
            f"    balance to it as ONE ordinary transfer — that hop is the\n"
            f"    entry veil, done by hand, and its destination appears in no\n"
            f"    public memo — then run this with --receive-wallet on that\n"
            f"    bundle. A bundle cannot be made for ENTRY itself:\n"
            f"    create_receive_wallet mints a new subaddress, it does not\n"
            f"    describe an existing one.")
    print(f"  [!] --accept-partial-swap: proceeding with {unlocked_bal} XMR "
          f"after {why}.")
    # AND SAY IF THE NUMBER MIGHT BE WRONG. --accept-partial-swap means "mix
    # what is here", and it is about to be taken literally: the figure becomes
    # the whole run's budget. If some balance polls FAILED, that figure is
    # lower than what is really on ENTRY, and the difference is not a chunk
    # that is still in flight -- it is money already sitting there that this
    # run is about to walk past and leave unmixed on the address the swap memo
    # names. The flag was consent to proceed on a short swap, not consent to
    # proceed on a balance the wallet would not report.
    if _blind:
        print(_blind.strip("\n").replace("\n    ", "\n      "))
    if floor_ > 0:
        print(f"  [!] That is {short} XMR short of the ~{floor_} expected.")
    print("  [!] ANYTHING THAT ARRIVES FROM HERE ON is NOT mixed by this run. "
          "It stays on ENTRY, which the swap memo names in public.")
    # Unconditional, because the hold is now unconditional -- see
    # _exit_hold_list. This used to branch on --no-entry-veil and tell that
    # operator the exit WOULD sweep it, which was true of the code and wrong
    # as a design: the link being avoided is swap -> destination, and nobody
    # consented to that by turning off the veil.
    print("      The exit will NOT withdraw it — that would be a one-hop link "
          "from the swap to your destination.")
    integrity_log("stage4", "arrival_partial_accepted")
    return total_bal, unlocked_bal


def report_holdings(rpc, accounts, entry_account=None) -> list:
    """Tell the operator WHERE their money is, and how to spend it without
    undoing the run. Returns the funded (account, balance_atomic) pairs.

    This is the necessary other half of putting every output in its own
    account. Isolation is what stops one transaction merging the mix, but it
    also means the run no longer ends with "the mix account" holding
    everything: it ends with a dozen accounts holding a slice each. An
    operator who does not know that has been handed a privacy win in exchange
    for forgotten money, and that trade is worse than the leak.

    NOTHING IS WRITTEN TO DISK, and the first version of this did write a
    holdings file "because a terminal scrollback is not a record". That was
    wrong, and wrong in a way this codebase had already ruled on: create_subs
    stopped labelling subaddresses because labels live in the WALLET FILE and
    hand an adversary who reads it the run's whole structure with no analysis.
    A file listing exactly which accounts belong to one run is that same
    disclosure under a different name -- and the grouping is the only part an
    adversary could not already read, since the wallet shows every account and
    balance regardless.

    The operator does not need the list preserved. They need the RULE, and the
    wallet already shows which accounts hold money. So: say it, once, and
    leave no artifact.

    Amounts reach the terminal but never the integrity chain: that file
    persists, and per-account amounts are the one quantity that correlates
    directly against the on-chain outputs.
    """
    funded, blind = [], 0
    for acct in sorted(set(accounts)):
        try:
            bal = rpc.raw_request("get_balance", {"account_index": int(acct)}) or {}
        except Exception:                                    # noqa: BLE001
            # NOT SILENT. This `continue` made the total a floor while the
            # report presented it as the amount the operator holds -- the same
            # silent-skip the exit had, in the report the operator reads to
            # decide whether the exit left anything behind.
            blind += 1
            continue
        total = int(bal.get("balance", 0) or 0)
        if total > 0:
            funded.append((int(acct), total))
    if blind:
        print(f"  [!] {blind} of {len(set(accounts))} account(s) could not be "
              f"read, so the total below is a FLOOR, not the whole of it. "
              f"Check the wallet directly before assuming the run is done.")
    if not funded:
        return funded

    _tot = sum(b for _, b in funded)
    print()
    print(f"  [*] THIS RUN'S FUNDS ARE IN {len(funded)} SEPARATE ACCOUNTS:")
    for acct, total in funded:
        print(f"        account {acct:>4}   {Decimal(total) / Decimal(10 ** 12)} XMR")
    print(f"      total {Decimal(_tot) / Decimal(10 ** 12)} XMR")
    print()
    print("      SPEND THEM ONE ACCOUNT AT A TIME. They are in separate")
    print("      accounts on purpose: a transaction's inputs are public, so")
    print("      spending several of these outputs together is permanent proof")
    print("      that they share an owner — which is exactly what this run")
    print("      spent hours separating. A Monero transaction cannot reach")
    print("      across accounts, so the wallet will refuse to merge them; do")
    print("      not defeat that by consolidating them by hand first.")
    print("      Sending them all to ONE exchange deposit address tells that")
    print("      exchange they are yours. That link is not on-chain and no")
    print("      structure here can remove it — split across venues and time.")

    # A SET, and the whole entry set. --split N gives the run N entry accounts
    # (create_entry_set), so naming only the first would tell the operator that
    # one of the addresses on their screen is the swap entry and leave the rest
    # looking like ordinary mix accounts -- the exact confusion this warning
    # exists to prevent, on the addresses a public swap settlement points at.
    _entry_accts = set()
    if entry_account is not None:
        _entry_accts = ({int(entry_account)}
                        if isinstance(entry_account, int)
                        else {int(a) for a in entry_account})
    _entry_funded = sorted(_entry_accts & {a for a, _ in funded})
    if _entry_funded:
        # THE ONE ACCOUNT THIS ADVICE MUST NOT COVER.
        #
        # Everything above says "spend them one account at a time" -- correct
        # for a mixed output, and exactly wrong for this one. A balance on
        # ENTRY is a swap chunk that landed after the run had planned: it has
        # been through none of the mixing, and its funding transaction is named
        # in plaintext by the public ThorChain memo. Sending it anywhere the
        # operator is going to send the rest publishes swap -> destination in
        # one hop.
        #
        # The exit already refuses to withdraw it (see _exit_hold_list) -- but
        # the exit only runs with --exit-to, and on the DEFAULT run this report
        # is the last thing the operator is told. It was listing ENTRY as
        # ordinary spendable money and closing with instructions to spend it.
        print()
        print(f"  [!] ACCOUNT{'S' if len(_entry_funded) > 1 else ''} "
              f"{', '.join(str(a) for a in _entry_funded)} "
              f"{'ARE' if len(_entry_funded) > 1 else 'IS'} THE SWAP ENTRY. Do NOT spend "
              f"it with the rest.")
        print("      It holds value that arrived after this run had planned, "
              "so nothing here")
        print("      mixed it — and the swap memo names that address in "
              "public. Sending it to")
        print("      the same place as the others ties your destination to "
              "the swap in one hop.")
        print("      To mix it: mint a fresh receive wallet "
              "(create_receive_wallet), send this")
        print("      balance to it as ONE ordinary transfer, then run again "
              "with --receive-wallet.")
        integrity_log("main", "holdings_entry_flagged")

    print("      Not written to disk: a file naming this run's accounts would")
    print("      hand anyone who reads the machine the grouping, which is the")
    print("      one thing the wallet does not already show. Note the account")
    print("      numbers now if you want them.")
    # Count only. The account NUMBERS would let anyone reading the persistent
    # chain reconstruct the grouping the print above deliberately leaves on
    # the screen and nowhere else.
    integrity_log("main", f"holdings:{len(funded)}_accounts")
    return funded


def report_completion(rpc, incomplete, accounts, spent_plans=(),
                      withheld=(), entry_account=None, fee_pair=None) -> None:
    """Say what actually happened, then say where the money is. Exits non-zero
    on an incomplete run.

    This used to print "pipeline complete." unconditionally, so a peel chain
    that stopped partway or a DAG round that was skipped still read as a
    finished mix -- the same fake-success pattern already removed from
    paranoia_mode.

    The holdings report runs only on a COMPLETE run. On an incomplete one the
    accounts are mid-flight: value is sitting on carriers that were meant to
    forward it, and listing balances then would read as "here is your result"
    when the result is a half-executed chain.

    spent_plans is wiped for the same reason and on the same condition: this is
    the one place that knows the run completed, so it is the one place that can
    tell a plan that is SPENT from a plan the operator still needs. See
    _wipe_spent_plans. Default empty so every other caller is unaffected.

    `withheld` is NOT `incomplete`, and conflating them costs more than it
    looks. Withheld means the pipeline did everything it planned and then
    deliberately declined to spend something -- the exit refusing to sweep an
    unmixed ENTRY balance to a public destination. That is the pipeline
    working. Routed through `incomplete` it took the branch above: no holdings
    report, exit 1, and -- because this is the only place that knows a plan is
    spent -- EVERY PLAN FILE LEFT ON DISK, each carrying its hops'
    destinations and amounts in plaintext. So it is reported, prominently,
    after a run that still counts as complete.
    """
    print()
    # THE USAGE FEE, SAID AGAIN AT THE END, and this is durability rather than
    # repetition.
    #
    # plan_usage_fee prints the account and subaddress once, in stage 4. That
    # is the ONLY record anywhere: the fee account is deliberately kept out of
    # addr_index (so the exit cannot sweep it), which also keeps it out of
    # report_holdings' enumeration below; the plan file holds the ADDRESS but
    # not the index, and a run that completes securely wipes that plan by
    # design; and the integrity chain carries structure only, never an account
    # number. Meanwhile gs_console keeps child output in a 5000-line ring and
    # drops 1500 at a time, and a stage-4 line has stages 4 and 5 printing over
    # it. So the one pointer to the operator's own money could be evicted from
    # the only surface carrying it.
    #
    # BEFORE the incomplete branch, which sys.exits: a fee taken in stage 4
    # survives a run that fails in stage 5, and that is exactly the run whose
    # scrollback is longest.
    #
    # SEPARATE FROM THE HOLDINGS COUNT, not folded into it. report_holdings
    # says "THIS RUN'S FUNDS ARE IN N SEPARATE ACCOUNTS ... SPEND THEM ONE
    # ACCOUNT AT A TIME"; the fee is not one of those N, it is not mixed, and
    # it must not be spent alongside them.
    if fee_pair:
        integrity_log("usagefee", "restated_at_end")
        print(f"  [*] YOUR USAGE FEE is on account {fee_pair[0]}, subaddress "
              f"{fee_pair[1]} of this wallet.")
        print(f"      Write that down — nothing else does. It is not one of "
              f"the accounts listed below, it is not in any plan file, and it "
              f"is not on the integrity chain.")
        print(f"      It never went through the fan-out or the hop rounds, so "
              f"do NOT spend it together with the mixed outputs or with "
              f"another run's fee: each fee is a fixed fraction of its own "
              f"deposit, so one transaction spending two of them proves a "
              f"common owner AND divides back into two deposit sizes.")
    if incomplete:
        integrity_log("main", f"pipeline_incomplete:{len(incomplete)}")
        print("  [!] GhostSpiral finished, but the mix is NOT what was planned:")
        for w in incomplete:
            print(f"      - {w}")
        print("  [!] Funds are safe in the wallet, but do NOT assume the full "
              "mixing depth was applied.")
        sys.exit(1)
    report_holdings(rpc, accounts, entry_account=entry_account)
    _wipe_spent_plans(*spent_plans)
    integrity_log("main", "pipeline_complete")
    print("  [+] GhostSpiral v10.5 pipeline complete — every planned round ran.")
    if withheld:
        integrity_log("main", "value_withheld_from_exit")
        print()
        print("  [!] ...but value was DELIBERATELY LEFT ON THIS WALLET:")
        for w in withheld:
            print(f"      - {w}")
        print("      This is the exit doing its job, not a failure — but the "
              "two kinds are not")
        print("      the same, and the exit messages above say which you have:")
        print("        * UNMIXED value (a late swap chunk on ENTRY, or a "
              "distribution change")
        print("          the sweep did not reach). Do NOT send it to your exit "
              "destination —")
        print("          that is the one hop this run exists to avoid. Mix it "
              "first.")
        print("        * MIXED value that relayed but could not be confirmed "
              "empty. That is")
        print("          yours to withdraw normally once it unlocks; it is not "
              "a link risk.")
        print("      Blanket advice not to move it would strand the second "
              "kind for ever.")


def resolve_entry_veils(rpc, args, addr_index: dict, entries: list,
                        bal: Decimal, fee_xmr: Decimal,
                        delay_window=None) -> tuple:
    """Decide what the distribution actually spends. Returns
    (veil_plan, sources, balance), where `sources` is [(addr, account, index)]
    -- one distribution source per swap chunk.

    With the veil on (the default) each source is a fresh carrier one sweep fee
    lighter than its entry output; with --no-entry-veil the sources ARE the
    entry addresses, unchanged. Everything downstream sizes and plans against
    whatever comes back, so the two paths cannot drift apart. See
    build_entry_veils for the measurement that makes the veil the default, and
    for the invariant that makes this plural rather than singular.

    ONE FEE PER CHUNK. The reserve is len(entries) sweep fees, not one: N
    chunks means N veil transactions, and charging for one of them would size
    the distribution against money that has already gone to miners.
    """
    if not getattr(args, "entry_veil", True):
        integrity_log("stage4", "entry_veil_disabled")
        print("  [!] --no-entry-veil: the distribution spends the swap's "
              "output DIRECTLY. That transaction's shape is unusual and the "
              "swap settlement is public, so an analyst can filter the "
              "candidate transactions down to it by output count alone.")
        return [], list(entries), bal

    veil_plan, carriers = build_entry_veils(rpc, entries, delay_window)
    sources = []
    for acct, idx, addr in carriers:
        addr_index[addr] = (acct, idx)
        sources.append((addr, acct, idx))
    integrity_log("stage4", "entry_veiled")
    _n = len(entries)
    print(f"  [*] {'Each entry output is' if _n > 1 else 'ENTRY is'} swept "
          f"once into a fresh carrier before the distribution, so the "
          f"transaction spending {'each' if _n > 1 else 'the'} swap output is "
          f"an ordinary 2-output send rather than one an analyst can pick out "
          f"by shape.")
    if _n > 1:
        print(f"      {_n} separate carriers, and {_n} separate "
              f"distributions: no transaction in this run will ever spend "
              f"value from two different swap chunks, which is what stops an "
              f"analyst intersecting their rings.")
    return veil_plan, sources, bal - hop_fee_reserve(fee_xmr) * _n


def limits_report(args) -> dict:
    """The minimum and maximum a UI may state, and what they are worth.

    ONE SOURCE, because the alternative is two. The four amount fields in
    gs_console are bare inputs today -- no type="number", no min, no max, and a
    regex that accepts literal zero -- while the same page puts min/max on
    --split, --wallets and --deep, which are counts. Money is the one thing it
    asks for without saying what the bounds are.

    THE MINIMUM IS NOT ONE NUMBER, and pretending otherwise is how a UI lies.
    It moves with --wallets (each mix output reserves its own fees), with
    --dag-mixing (an output that never hops reserves one transaction fewer),
    and with the cut (which binds harder than the mix below about 15 wallets).
    So this returns the whole curve and lets the page look up the row the
    operator has actually selected.

    AT THE FALLBACK FEE, and said so in the payload. The real per-transaction
    fee comes from the daemon at run time and this runs before any socket is
    opened, so every figure here is computed at FALLBACK_FEE_BY_PRIORITY --
    correct at --fee-priority 1 and an UNDERSTATEMENT at 2, 3 or 4, where the
    fee is 4x, 20x and 200x. The payload carries the assumption so the page can
    show it rather than imply a precision it does not have.

    THE MAXIMUM IS HONEST ABOUT BEING USELESS. XMR_ABSURD_TOTAL is a sanity
    ceiling that exists to stop a Decimal context overflow -- it says "that is
    not an amount", never "that amount looks wrong". The real ceiling is the
    wallet balance and the swap's liquidity, and this tool knows neither. Both
    facts go in the payload; a page that shows the first without the second is
    quoting a limit nobody will ever hit as though it were the limit.
    """
    fee = FALLBACK_FEE_BY_PRIORITY.get(
        int(getattr(args, "fee_priority", 1) or 1), FALLBACK_FEE_XMR)
    dag = bool(getattr(args, "dag_mixing", False))
    exit_set = bool(getattr(args, "exit_to", None))
    cut = getattr(args, "usage_fee_pct", None) or USAGE_FEE_PCT
    rows = {}
    for w in range(MIN_WALLETS, MAX_WALLETS + 1):
        rows[str(w)] = {
            "min_xmr": str(mix_minimum_xmr(fee, w, dag_mixing=dag,
                                           exit_set=exit_set)),
            "min_xmr_with_cut": str(mix_minimum_xmr(
                fee, w, dag_mixing=dag, exit_set=exit_set, usage_pct=cut)),
        }
    return {
        "schema": "gs_limits_v1",
        "fee_assumed_xmr": str(fee),
        "fee_priority": int(getattr(args, "fee_priority", 1) or 1),
        "fee_note": ("computed at the FALLBACK fee for this priority; the real "
                     "fee comes from the daemon at run time, so these are a "
                     "guide and an understatement at higher priorities"),
        "dag_mixing": dag,
        "exit_set": exit_set,
        "usage_pct": str(cut),
        "cut_spend_floor_xmr": str(hop_fee_reserve(fee)),
        "cut_note": (f"a usage fee worth less than {hop_fee_reserve(fee)} XMR "
                     f"cannot "
                     f"be spent by anyone, so below the with-fee minimum the "
                     f"run is refused rather than taking a fee that cannot be "
                     f"collected"),
        "by_wallets": rows,
        "max_xmr": str(XMR_ABSURD_TOTAL),
        "max_btc": str(BTC_ABSURD_TOTAL),
        "max_note": ("a sanity ceiling that exists to stop a Decimal overflow, "
                     "not a policy limit. The real ceiling is your wallet "
                     "balance and the swap's liquidity, and this tool knows "
                     "neither -- it will not invent them"),
    }


def maybe_print_limits() -> bool:
    """Handle --print-limits and say whether it did. True means main() is done.

    BEFORE build_cli(), and that is deliberate rather than convenient.

    --print-limits reads no wallet, opens no socket and spends nothing; it is
    arithmetic over constants, so gs_console can put a real minimum beside the
    box it asks for an amount in without carrying a second copy of
    min_exit_fundable, hop_fee_reserve and compute_fee_budget. (The console
    already mirrors three timeout constants that way and needed a test to stop
    them drifting -- see JOB_TIMEOUT_FLOOR_S. One process boundary is cheaper.)

    THE TOR GATE IS NOT RELAXED TO MAKE ROOM FOR IT. --tor-proxy is
    required=True on the real parser, so an info mode either runs before that
    parser or weakens it. A separate, tiny parser reading only the flags the
    arithmetic depends on is the option that cannot make the pipeline reachable
    without Tor by accident: this returns True and main() stops, while every
    path that spends anything still goes through build_cli().

    A FUNCTION RATHER THAN A BLOCK IN main(), because tests/test_units.py holds
    main() under 500 lines and it was at 502 with this inline. That check is
    the reason main() is readable at all; the honest response to tripping it is
    to extract, not to raise it.
    """
    if "--print-limits" not in sys.argv[1:]:
        return False
    _lp = argparse.ArgumentParser(add_help=False)
    _lp.add_argument("--wallets", type=int, default=10)
    _lp.add_argument("--fee-priority", type=int, default=1)
    _lp.add_argument("--dag-mixing", action="store_true")
    _lp.add_argument("--exit-to", action="append")
    _lp.add_argument("--usage-fee-pct", type=decimal_arg)
    _la, _ = _lp.parse_known_args()
    print(json.dumps(limits_report(_la), indent=2))
    return True


def _wallet_owns_address(rpc, addr: str):
    """(major, minor) if THIS wallet holds the keys to `addr`, else None.

    Exists for one question plan_usage_fee has to ask about a static
    --usage-fee-address and cannot answer from the flags: is the operator's fee
    destination inside the very wallet the run is emptying? _exit_account_list
    includes bal_account, which is account 0 in send mode -- the wallet's
    pre-existing primary account -- so "an address the run did not create" is
    NOT the same as "an address the exit will not touch".

    NONE ON ANY ERROR, deliberately, and this is the opposite of the usual
    fail-closed rule here for a measured reason: monero-wallet-rpc answers
    get_address_index for a foreign address with an ERROR, not with a null
    result. An error is therefore the EXPECTED answer for a correctly-supplied
    external destination, and treating it as "unknown, so refuse" would waive
    the fee on every correct configuration. The failure this guards is the
    operator pasting their own address, and that case answers successfully.

    A malformed answer is also None: the address is already validated by
    validate_xmr_address, so a lookup that succeeds without an index is a
    wallet not saying what it was asked, and guessing "ours" from it would
    waive a fee that was fine.
    """
    try:
        res = rpc.raw_request("get_address_index", {"address": addr})
    except Exception:                                        # noqa: BLE001
        return None
    _ix = (res or {}).get("index") if isinstance(res, dict) else None
    if not isinstance(_ix, dict):
        return None
    _maj, _min = _ix.get("major"), _ix.get("minor")
    if isinstance(_maj, bool) or isinstance(_min, bool):
        return None
    if not isinstance(_maj, int) or not isinstance(_min, int):
        return None
    return (_maj, _min)


def plan_usage_fee(rpc, args, bal: Decimal, fee_xmr: Decimal) -> tuple:
    """Decide the operator's cut and where it lands.

    Returns (address, amount, pair), where `pair` is the (account, subaddress)
    the cut was minted on, or None when it went to an address this run did not
    create. (None, 0, None) when no cut was asked for, which is the default.

    FOUR WAYS TO TAKE NOTHING, and every one of them WAIVES rather than exits.
    This runs after stage4_await_swap, so the BTC is already through ThorChain
    and the XMR is sitting on an address a public OP_RETURN names: a sys.exit
    here strands a settled swap on a pipeline with no auto-resume, which is
    strictly worse for everyone than skipping one run's fee. The four are: no
    fee asked for; a cut below the cost of ever spending it; a wallet that will
    not mint the account to put it on; and a static destination that turns out
    to be inside THIS wallet, where the exit would sweep it out again.

    THE PAIR EXISTS FOR THE EXIT TO REFUSE. Nothing here writes the cut into
    addr_index -- that omission is what keeps the exit from sweeping it, and a
    test walks this function's AST to assert the name is never USED (prose does
    not count, or the paragraph explaining the rule would break it). But a hold
    built out of an omission is a hold that a later change
    silently removes: add the cut to addr_index for any reason, and
    _exit_account_list picks it up, the exit sweeps the operator's own fee to
    --exit-to, and NOTHING SAYS SO. Handing the pair back lets stage 4 name it
    in exit_hold as well, so the same mistake becomes a withheld-value report
    with the address on it instead of a quiet payment to the wrong place.

    It is not merely bookkeeping. The cut is a direct output of the fan-out --
    no veil, no hop rounds -- so sweeping it to --exit-to would put UNMIXED
    value on the destination beside the mixed outputs, which is the leak the
    ENTRY, change and remainder holds all already exist for. It is worse than
    those, because this output's size is a FIXED FRACTION of the deposit:
    anyone watching --exit-to could divide by the rate and read the deposit
    off it.

    A FRESH ACCOUNT AND SUBADDRESS PER RUN, unless the operator named an
    address. This is the whole reason the cut is affordable in OPSEC terms and
    it is not a nicety: thor_swap_preparer refuses a reused destination by
    sys.exit, GhostSpiral refuses a duplicate swap destination, and
    create_receive_wallet refuses --count > 1 with --account -- three separate
    refusals of the same thing. A fixed cut address is that thing at its
    maximum: the SAME address collecting from every deposit of every run,
    forever. Minting one per run costs one create_account plus one
    create_address and removes the linkage outright.

    Its own account, not just its own subaddress, for the reason create_subs
    gives at length: spending several outputs together is permanent public
    proof they share an owner, and one account per output makes that merge
    impossible rather than merely discouraged. The cut inherits that.

    THE CUT MUST BE SPENDABLE, and this is the refusal that fires in practice.
    An output worth less than the fee to move it is unspendable by anyone -- so
    a cut that clears DUST_XMR but not the sweep fee is a fee the operator can
    never collect, and a permanent on-chain output created to fail at it.
    Driven: at 1.1% and a 0.0024 fee that floor is 0.3364 XMR of deposit, which
    is ABOVE the mixing minimum at every wallet count up to about 15 -- so on a
    default run it is the CUT, not the mix, that sets how small a deposit may
    be. Refused here rather than discovered later, and refused BEFORE the
    fan-out is planned around it.

    ROUND_DOWN, so the cut is never larger than the fraction asked for. The
    remainder stays with the mix, which is the direction that cannot surprise
    the depositor.
    """
    pct = getattr(args, "usage_fee_pct", None)
    if not pct or pct <= 0:
        return None, Decimal(0), None
    cut = (bal * pct).quantize(DUST_XMR, rounding=ROUND_DOWN)
    _spend_cost = hop_fee_reserve(fee_xmr)
    if cut <= _spend_cost:
        # WAIVED, NOT ABORTED, and the first version of this had it backwards.
        #
        # It called sys.exit with "Nothing has been spent." That is true of
        # Monero and FALSE OF THE DEPOSIT: this runs after stage4_await_swap,
        # so the BTC is already through ThorChain and the XMR is sitting on
        # ENTRY -- an address the swap memo names in plaintext in a Bitcoin
        # OP_RETURN. Aborting here to protect a fee strands a swapped,
        # publicly-named balance on a pipeline with no auto-resume. That is
        # strictly worse for everyone than skipping one run's cut.
        #
        # Waiving is also the only branch that cannot produce the thing the
        # check exists to prevent: an on-chain output nobody can ever spend.
        # The gate that CAN refuse safely is the one before the deposit
        # instructions are printed, where "nothing has been spent" is true of
        # the deposit too -- and limits_note/--print-limits put the same figure
        # in front of the operator before they send anything.
        integrity_log("usagefee", "waived_below_spend_cost")
        _need = mix_minimum_xmr(
            fee_xmr, args.wallets,
            dag_mixing=bool(getattr(args, "dag_mixing", False)),
            exit_set=bool(getattr(args, "exit_to", None)),
            usage_pct=pct)
        print(f"  [!] NO USAGE FEE TAKEN. {(pct * 100).normalize()}% of this "
              f"deposit "
              f"is {cut} XMR, which is not more\n"
              f"      than the {_spend_cost} XMR it costs to move one output — "
              f"a fee you could never\n"
              f"      collect, and a permanent on-chain output created to fail "
              f"at it.\n"
              f"      This deposit needed to be at least {_need} XMR at these "
              f"settings. The mix is\n"
              f"      going ahead in full; the swap has already happened and "
              f"aborting now would\n"
              f"      strand it on an address the swap memo names publicly.")
        return None, Decimal(0), None
    addr = getattr(args, "usage_fee_address", None)
    if addr:
        # THE REFUSAL IS TESTED FIRST, and the order is not cosmetic. Warning
        # "the usage fee goes to a FIXED address you supplied" and then, four
        # lines later, "NO USAGE FEE TAKEN" is two statements about the same
        # run that cannot both be true, and the operator has to work out which
        # one won. Found by reading the real output of every branch side by
        # side rather than each one on its own.
        #
        # IT MUST NOT BE AN ADDRESS OF THIS WALLET.
        #
        # An earlier version of this returned here with the note "the exit only
        # ever enumerates accounts THIS RUN made, and a fixed external address
        # is in none of them". That is FALSE, and the counter-example is the
        # likeliest paste of all. _exit_account_list returns addr_index's
        # accounts PLUS change_accounts PLUS bal_account -- and bal_account is
        # `receive_account_index if receive_mode else 0`, i.e. account 0, the
        # wallet's pre-existing primary account, which the run did not make.
        # _funded_subaddresses then walks EVERY subaddress of it. So a fee sent
        # to the wallet's own primary address, or to any subaddress of the
        # receive account, is in the exit's withdrawal set: it goes to
        # --exit-to as unmixed value whose size is a fixed fraction of the
        # deposit, which is precisely the disclosure the whole placement
        # argument exists to avoid. Subaddress 0 of that account is worse
        # still -- it is the fan-out's change address, so the change sweep
        # moves the fee INTO the mix and the operator never sees it.
        #
        # WAIVED, NOT REFUSED, for the reason both branches above waive: this
        # runs after stage4_await_swap, so a sys.exit strands a settled swap on
        # an address a public OP_RETURN names. One run's fee is the cheaper
        # loss, and waiving creates no output at all, so there is nothing left
        # for the exit or the change sweep to move.
        #
        # AN RPC ERROR IS THE NORMAL ANSWER HERE, not a failure:
        # monero-wallet-rpc answers get_address_index for a FOREIGN address
        # with an error ("Address doesn't belong to the wallet"), which is the
        # expected case for a correctly-supplied external destination. So an
        # error means "not ours" and the fee proceeds -- the status quo. Only a
        # successful lookup, which can only happen for an address this wallet
        # holds the keys to, waives.
        _own = _wallet_owns_address(rpc, addr)
        if _own is not None:
            integrity_log("usagefee", "waived_address_in_wallet")
            print(f"  [!] NO USAGE FEE TAKEN — the address you gave is one of "
                  f"THIS WALLET's own\n"
                  f"      (account {_own[0]}, subaddress {_own[1]}), and this "
                  f"is the wallet the run is\n"
                  f"      mixing out of. The exit enumerates account "
                  f"{_own[0]} among others and would have\n"
                  f"      swept the fee to your --exit-to destination: unmixed "
                  f"value, sized at a fixed\n"
                  f"      fraction of the deposit, landing beside the mixed "
                  f"outputs. On subaddress 0 it\n"
                  f"      is worse: that is where the fan-out's change lands, "
                  f"so the change sweep moves\n"
                  f"      your fee to a fresh address of this run — which "
                  f"goes into addr_index, and\n"
                  f"      straight out to --exit-to with everything else.\n"
                  f"      The mix is going ahead in full. Use an address "
                  f"OUTSIDE this wallet, or drop\n"
                  f"      --usage-fee-address and let a fresh account be "
                  f"minted per run.")
            return None, Decimal(0), None
        # The operator's own external address, reused every run by
        # construction. Said once, here, where it is actually about to happen
        # -- and only once the fee is definitely being taken, so this is never
        # a warning about something that then does not occur.
        integrity_log("usagefee", "to_static_address")
        print(f"  [!] The usage fee goes to a FIXED address you supplied. It "
              f"will "
              f"collect from every run\n"
              f"      that uses it, which is the address reuse this toolchain "
              f"refuses everywhere\n"
              f"      else -- and mixing does not retract it. Drop "
              f"--usage-fee-address to have a\n"
              f"      fresh account and subaddress minted per run instead.")
        # No pair: the wallet does not know this address, so it is outside the
        # accounts the exit enumerates and there is nothing to hold.
        return addr, cut, None
    # WAIVED IF THE MINT FAILS, for the same reason the below-floor branch
    # waives -- and this door was left open when that one was closed.
    #
    # create_fresh_account RAISES (it refuses an absent, non-int, or zero
    # account_index rather than defaulting to the wallet's primary account),
    # and new_subaddress_indexed validates its answer the same way. Uncaught,
    # either one takes down main() with a traceback at stage 4 -- AFTER
    # stage4_await_swap, so the BTC is already through ThorChain and the XMR is
    # sitting on ENTRY, an address a public OP_RETURN memo names. That is the
    # exact outcome the "Nothing has been spent" abort was removed for,
    # reached through the RPC instead of through the arithmetic.
    #
    # Nothing is half-done on this path. The account may exist, but it is empty
    # and unreferenced: the cut is only ever paid as a destination on the
    # fan-out plan, and that is built later, from the values returned here.
    # Waiving costs one run's fee; raising costs a settled swap.
    try:
        _acct = create_fresh_account(rpc, label="")
        addr, _idx = rpc.new_subaddress_indexed(account_index=_acct, label="")
    except Exception as _e:
        integrity_log("usagefee", "waived_mint_failed")
        print(f"  [!] NO USAGE FEE TAKEN — the wallet would not mint an "
              f"account to put it on:\n"
              f"      {_e}\n"
              f"      The mix is going ahead in full. The swap has already "
              f"settled, so stopping\n"
              f"      here would strand it on an address the swap memo names "
              f"publicly, and one\n"
              f"      run's fee is the cheaper loss. If it repeats, the "
              f"wallet-rpc is the thing to\n"
              f"      look at — every later stage of this run mints accounts "
              f"too.")
        return None, Decimal(0), None
    integrity_log("usagefee", "subaddress_minted")
    # SAY IT, AND SAY WHERE. The first version printed nothing at all on this
    # branch: the cut account was minted, paid, and never mentioned -- not on
    # the terminal, not in report_holdings, which lists "THIS RUN'S FUNDS ARE
    # IN N SEPARATE ACCOUNTS" and had no idea this one existed. An operator
    # cannot check they were paid against a number they were never given, and
    # the wallet is the only authoritative record; this line is what makes a
    # discrepancy noticeable at all.
    print(f"  [*] USAGE FEE: {cut} XMR ({(pct * 100).normalize()}% of the "
          f"deposit) "
          f"goes to a freshly minted\n"
          f"      account {_acct}, subaddress {_idx}, as one more destination "
          f"on the fan-out.\n"
          f"      It is not mixed and it is not swept by the exit — it is "
          f"yours where it lands.")
    # SPEND HYGIENE, HERE, because nothing else covers these accounts.
    #
    # report_holdings prints "SPEND THEM ONE ACCOUNT AT A TIME" over the run's
    # accounts -- and this account is not one of them. It is deliberately kept
    # out of addr_index so the exit cannot sweep it, which also keeps it out of
    # the holdings report, so the accounts that accumulate run after run are
    # the only ones the warning never reaches. They are also the ones most
    # exposed to it: a fee is small, small piles invite being collected
    # together, and the operator collecting them is the same person every time.
    #
    # And the merge costs more here than anywhere else in the run. Every mixed
    # output is an arbitrary amount; each of these is a FIXED FRACTION of one
    # deposit. Spending two together proves common ownership (any transaction
    # does that) AND hands over two amounts that divide by a known rate into
    # two deposit sizes -- so the merge does not just link the fees, it
    # measures the runs behind them.
    print(f"      SPEND IT ON ITS OWN. Every run mints another of these, and "
          f"each one is\n"
          f"      exactly {(pct * 100).normalize()}% of that run's deposit. A "
          f"single transaction spending two of\n"
          f"      them proves they share an owner AND lets anyone divide by "
          f"the rate to read\n"
          f"      both deposits off it. One account per transaction, and not "
          f"into the same\n"
          f"      destination as your mixed output.")
    return addr, cut, (int(_acct), int(_idx))


def build_distribution_plan(args, rpc_primary, addr_index, SPEND_SOURCES,
                            fanout_dests, fanout_by_addr, _dest_slices,
                            fee_xmr, bal_account, fanout_count,
                            _delay_window, _secrets, bal,
                            usable, fee_addr=None,
                            fee_amt=Decimal(0)) -> tuple:
    """Build the plan that spends the carriers. Returns
    (fanout_plan, change_accounts, distribution_mode, fanout_by_addr).

    THE AMOUNTS COME BACK OUT, and that is not tidiness. The peel branch below
    can SHRINK the distribution (fit_peel_distribution), and it rebuilt
    fanout_by_addr to match -- but fanout_by_addr is a PARAMETER, so the rebind
    stayed inside this function while main() went on to hand build_dag_plan the
    pre-shrink dict. The hop planner reads it in exactly one place,
    hop_is_fundable, and today both the stale and the real amount clear the
    same floor (compute_fanout_amounts pins every amount at min_hop_fundable
    when DAG mixing is on), so nothing was misplanned. That is luck, not
    design: it holds only while the floor is the only thing anyone asks the
    amounts for, and the next reader who asks for a magnitude gets a number
    the mix subaddress never received. Returning it removes the trap instead
    of documenting it.

    `bal` and `usable` are REQUIRED, not defaulted. They exist so the peel
    branch can run fit_peel_distribution, and a default of None would let a
    caller skip the affordability gate by simply not knowing about it -- which
    is how that gate came to be dead code in the first place. A caller that
    forgets now fails at the call, loudly, instead of building a peel chain
    that strands funds on a carrier.

    Extracted from main() so the N-chunk shape can be driven directly by a
    test: this is where the invariant "no transaction ever spends value from
    two different swap chunks" is either kept or broken, and it was previously
    inline in a function nothing executes.
    """
    distribution_mode = "peel" if args.peel else "fanout"
    # Say what shape the chain will show. Here, where the mode is decided and
    # the output count is known -- not in main(), which is at its size gate.
    announce_distribution_shape(args, fanout_count,
                                fee_out=bool(fee_addr and fee_amt > 0))
    # ONE DISTRIBUTION PER CHUNK, and this is what keeps the invariant.
    #
    # A single distribution spending N carriers would be a CONVERGENCE: the
    # analyst has one candidate set of sixteen veils per chunk, and the
    # transaction whose input rings touch every one of those sets is
    # essentially unique. Veiling each chunk separately and then merging
    # them buys nothing -- the intersection just happens one hop later. So
    # every chunk keeps its own carrier, its own slice of the mix targets
    # and its own fan-out transaction, and no transaction in the run ever
    # spends value from two chunks. See build_entry_veils.
    #
    # They all go in ONE batch. The comment below explains why a single
    # source cannot emit N transactions at once -- it holds one confirmed
    # output, spendable once per batch. N DIFFERENT carriers each hold
    # their own confirmed output, so the constraint does not apply across
    # them; this is exactly the shape the DAG round already relays, N
    # sweeps from N distinct accounts in one plan file.
    if args.peel:
        # A peel chain has to leave every hop the headroom to be built at all;
        # under-reserving strands the remainder on a carrier and this pipeline
        # has no auto-resume. Found on a real chain, where a one-fee-per-hop
        # reserve failed on the second peel.
        if len(SPEND_SOURCES) > 1:
            # NOT ATTEMPTED, and said plainly rather than half-built. Each
            # chunk needs its OWN chain (merging them is the convergence
            # this whole change removes), and a peel chain is sequential
            # and confirmation-gated -- N chunks of H hops is N x H x ~20
            # minutes, and _run_peel_chain has no representation for a
            # partial failure in one chain out of N.
            integrity_log("stage4", "split_peel_refused")
            sys.exit(
                f"[!] --split {len(SPEND_SOURCES)} with --peel is not "
                f"supported.\n"
                f"    Each chunk needs its own peel chain — merging them "
                f"into one would re-create\n"
                f"    exactly the convergence that splitting the swap "
                f"exists to avoid — and a peel\n"
                f"    chain is sequential and confirmation-gated, so "
                f"{len(SPEND_SOURCES)} of them would take\n"
                f"    {len(SPEND_SOURCES)} x hops x ~20 minutes with no "
                f"resume if one stops part-way.\n"
                f"    Use --split with the fan-out distribution (drop "
                f"--peel), or --peel with a\n"
                f"    single chunk.")
        _hop_fee = fee_xmr * FEE_SAFETY_MARGIN * PEEL_CARRIER_RESERVE_MULT
        # AND NOW ACTUALLY CHECK IT. The comment above has claimed this gate
        # since it was written; fit_peel_distribution implements it, is fully
        # unit-tested, and was called from NOWHERE. Confirmed by walking the
        # AST of this file: `fit_peel_distribution` appears in one comment and
        # in tests, and in no call. peel_entry_requirement, the arithmetic it
        # exists to evaluate, is reachable only from inside it.
        #
        # So the peel chain built a plan without ever asking whether peel 0
        # could afford it, which is the exact failure fit_peel_distribution's
        # docstring records: "failed on peel 2 with 'not enough money' and
        # stranded the entire remaining balance on a carrier subaddress, which
        # this pipeline has no auto-resume for."
        #
        # Not a corner case. Comparing peel_entry_requirement against the
        # spendable balance across the shipped compute_fee_budget at fee
        # 0.0024, 28 (balance, --wallets) combinations are unaffordable and
        # every one of them was built anyway -- including --wallets 10, THE
        # DEFAULT, on a 1 XMR balance (short by 0.12) and on 2 XMR (short by
        # 0.02).
        _peel_amounts = [fanout_by_addr[_a] for _a in fanout_dests]
        # _secrets IS THE MODULE HERE, not a generator. main() does
        # `import secrets as _secrets` and every other user in this function
        # writes `_secrets.SystemRandom()` before drawing anything. Passing the
        # module straight through gave
        #
        #     AttributeError: module 'secrets' has no attribute 'random'
        #
        # from inside peel_change_extras -- and fit_peel_distribution has the
        # same hazard, because it hands rng to compute_fanout_amounts, which
        # calls rng.random() whenever it has to shrink.
        #
        # Every offline test passed: they inject a real SystemRandom or a stub.
        # Only running the pipeline found it, on the first peel of a real
        # chain. Same family as this file's other rng trap, recorded in
        # hop_delay: "secrets.randbelow, NOT secrets.SystemRandom().randbelow".
        _peel_rng = _secrets.SystemRandom()
        try:
            _fitted, _frac = fit_peel_distribution(
                _peel_amounts, bal, usable, fanout_count, fee_xmr,
                bool(getattr(args, "dag_mixing", False)), _peel_rng, _hop_fee)
        except PeelBudgetError as _pbe:
            integrity_log("stage4", "peel_refused:unaffordable")
            sys.exit(
                f"[!] A peel chain of {_pbe.hops} hops cannot be built from "
                f"this balance.\n"
                f"    Every hop must leave {_pbe.hop_headroom} XMR behind so "
                f"the NEXT one can be\n"
                f"    constructed at all, and {_pbe.hops} hops need "
                f"{_pbe.hop_headroom * _pbe.hops} XMR of headroom on top of "
                f"everything\n"
                f"    being distributed. This balance does not cover it at any "
                f"distribution size\n"
                f"    the planner will try.\n"
                f"\n"
                f"    NOTHING HAS BEEN SPENT. A peel chain that runs out "
                f"part-way strands the\n"
                f"    remainder on a carrier subaddress and there is no "
                f"auto-resume, so this\n"
                f"    stops before the first transaction rather than during "
                f"the chain.\n"
                f"    Use fewer --wallets, drop --peel for the fan-out "
                f"distribution, or fund\n"
                f"    the wallet more.")
        if _frac is not None:
            # SHRUNK, and said so. The operator asked to distribute a certain
            # amount and is getting less; the remainder stays on ENTRY rather
            # than being silently absorbed.
            integrity_log("stage4", f"peel_distribution_shrunk:{_frac}")
            print(f"  [!] The peel chain could not carry the full "
                  f"distribution: {fanout_count} hops need "
                  f"{_hop_fee * (fanout_count - 1)} XMR of headroom on top of "
                  f"it, which this balance does not leave.")
            print(f"      Distributing {_frac * 100:.0f}% of the usable "
                  f"balance instead. The rest stays on ENTRY — it is not "
                  f"lost, and it is not mixed either.")
        _peel_amounts = _fitted
        # ONE SOURCE OF TRUTH for the amounts from here down. fanout_by_addr is
        # what build_peel_stage_plan reads, so a shrunk plan that did not
        # rebuild it would size the check against one set of amounts and the
        # transactions against another.
        fanout_by_addr = dict(zip(fanout_dests, _peel_amounts))
        # A peel chain has exactly ONE source: the refusal above guarantees
        # len(SPEND_SOURCES) == 1 here, so read it from there rather than from
        # a separate variable that could drift out of step with it.
        _peel_addr, _peel_acct, _peel_idx = SPEND_SOURCES[0]
        fanout_plan, change_accounts = build_peel_stage_plan(
            rpc_primary, addr_index, _peel_acct, _peel_addr, _peel_idx,
            fanout_dests, fanout_by_addr,
            _hop_fee, delay_window=_delay_window)
        integrity_log("stage4", f"peel_plan:{len(fanout_plan)}_peels")
        print(f"  [*] PEELING CHAIN: {len(fanout_plan)} confirmation-gated peels "
              f"(~{len(fanout_plan) * 20} min). Each output is created in its own "
              f"transaction — no co-created fan-out for an analyst to cluster.")
        print(f"      Every peel consumes its carrier EXACTLY and the last one "
              f"sweeps, so none of them leaves a change output: there are no "
              f"change sweeps for this run and nothing rests on a subaddress 0.")
    else:
        fanout_plan = []
        # THE CUT RIDES ON THE FAN-OUT, SPLIT ACROSS THE CHUNKS IT COMES FROM.
        #
        # One more destination, on a transaction that is already 1-in/N-out.
        # tx_extra grows by 32 bytes (33 + 2 + 32n, verified against all five
        # shapes this file measures) and the output count by one, on the single
        # transaction of the run that is already unique by arity -- so no shape
        # CLASS is created. Everything else in the run stays 2-output.
        #
        # PROPORTIONAL, NOT ALL ON CHUNK 0. With --split there is one fan-out
        # per swap chunk and each carrier holds only ITS chunk, so a cut sized
        # against the whole deposit but charged to one carrier can exceed what
        # that carrier has. Splitting it by each chunk's share keeps every
        # fan-out fundable and gives them all the same +1 destination, rather
        # than making one of them the odd one out.
        #
        # The remainder from the division lands on the LAST chunk, and it is at
        # most a DUST_XMR tick per chunk -- the same treatment split_btc_amount
        # gives its satoshi remainder, for the same reason: it has to go
        # somewhere and a fixed choice is the only one that cannot be a draw.
        _fee_by_chunk = []
        if fee_addr and fee_amt > 0:
            _n_src = len(SPEND_SOURCES)
            _per = (fee_amt / Decimal(_n_src)).quantize(DUST_XMR,
                                                        rounding=ROUND_DOWN)
            _fee_by_chunk = [_per] * _n_src
            _fee_by_chunk[-1] = fee_amt - _per * Decimal(_n_src - 1)
        for _si, (_src_addr, _src_acct, _src_idx) in enumerate(SPEND_SOURCES):
            _slice = _dest_slices[_si]
            _dests = [{"address": a, "amount": str(fanout_by_addr[a])}
                      for a in _slice]
            if _fee_by_chunk and _fee_by_chunk[_si] > 0:
                _dests.append({"address": fee_addr,
                               "amount": str(_fee_by_chunk[_si])})
            fanout_plan.append({
                "src": _src_addr,
                "src_index": _src_idx,
                "account_index": _src_acct,
                "destinations": _dests,
                "delay": hop_delay(_delay_window),
            })
        if fee_addr:
            # STRUCTURE, NOT THE AMOUNT. The cut is a fixed fraction of the
            # deposit, so logging it would put the deposit on a chain that
            # persists -- the one quantity every other integrity_log call on
            # this path is careful to leave out. That the run took a cut, and
            # across how many chunks, is safe; how much is not.
            integrity_log("usagefee", f"on_fanout:{len(_fee_by_chunk)}_chunks")
        # Log the STRUCTURE (one TX, N destinations) but NOT the per-destination
        # amount. integrity_chain.log persists on disk, and the exact fan-out
        # amount is the single most linkable quantity in the whole pipeline:
        # recovered from the log it correlates directly against the on-chain
        # outputs and unmixes what the fan-out exists to mix. The amount stays
        # in the plan file (0600), off the persistent hash chain.
        integrity_log("stage4",
                      f"fanout_plan:{len(fanout_plan)}_tx:"
                      f"{fanout_count}_dests")
        if len(fanout_plan) > 1:
            print(f"  [*] {len(fanout_plan)} fan-out transactions, one per "
                  f"swap chunk, each into its own {len(_dest_slices[0])}-ish "
                  f"slice of the mix subaddresses. They relay in one batch "
                  f"— separate carriers, separate confirmed outputs.")
        # Each fan-out leaves change on ITS OWN spending account's
        # subaddress 0, so there are as many change locations as there are
        # fan-outs. Listing only the first would leave the rest unswept and
        # unheld -- and an unheld change output is one the exit sweeps
        # straight to --exit-to.
        change_accounts = [a for _d, a, _i in SPEND_SOURCES]
    return fanout_plan, change_accounts, distribution_mode, fanout_by_addr


def establish_entry_set(args, rpc_primary, addr_index, jm_utxos,
                        receive_mode, receive_entry_addr,
                        receive_account_index, receive_subaddress_index) -> tuple:
    """Mint (or adopt) the addresses this run's value arrives on.

    Returns (ENTRY_SET, ENTRY_ADDRS) where ENTRY_SET is
    [(addr, account, index)] in chunk order.

    Extracted from main() because it is the decision the rest of the run is
    shaped by -- how many entry addresses there are decides how many veils,
    how many carriers and how many distributions the run has -- and nothing
    executes main().
    """
    # THE ENTRY SET. One address per swap chunk, and no longer stolen from
    # the mix targets.
    #
    # This was `ENTRY = subs[0]`, so the entry address was one of the
    # subaddresses create_subs made for mixing and `mix_targets` then
    # excluded it -- an operator who asked for 12 wallets got 11 mix
    # outputs plus a decoy count. Minting the entry set separately is what
    # makes --split N possible at all (N chunks need N addresses; see
    # create_entry_set) and it incidentally hands over the number of mix
    # outputs that was actually requested.
    if receive_mode:
        # A bundle describes exactly ONE address, so a receive run has one
        # entry however --split is set. --split divides --btc-amount, which
        # receive mode does not have.
        ENTRY_SET = [(receive_entry_addr, receive_account_index,
                      receive_subaddress_index)]
        addr_index[receive_entry_addr] = (receive_account_index,
                                          receive_subaddress_index)
        if int(getattr(args, "split", 1) or 1) > 1:
            # SAID, not silently ignored -- but say the TRUE thing.
            #
            # This claimed "--split N has NO EFFECT in receiver mode", and that
            # is false. stage4 computes
            #
            #     n_chunks = len(swap_deposits) or max(args.split, 1)
            #
            # and receiver mode has no swap_deposits, so --split IS n_chunks
            # here, and n_chunks feeds swap_arrival_floor. Measured: with
            # --expect-total-xmr 4 and the default 10% tolerance, --split 1
            # gives a floor of 3.6 and --split 12 gives 3.666..., because once
            # the implied per-chunk size falls below the tolerance the gate
            # tightens so a whole missing chunk cannot hide inside it. So the
            # flag changes the one thing in receiver mode that decides whether
            # the run waits or spends.
            #
            # Normally that count is 1, and deliberately so: thor_swap_preparer
            # REFUSES a batch that routes two swaps to one address, because
            # reusing a destination tells the aggregator those BTC payments
            # belong together. So --split > 1 here is the operator who got more
            # than one payment onto this address anyway -- separate
            # thor_swap_preparer runs against the same bundle, which the
            # per-batch refusal does not see, or a sender who paid in
            # instalments. That is against this toolchain's advice, and it is
            # exactly when the arrival gate most needs to know: the run should
            # still refuse to spend a fraction, whatever the operator did to
            # get there.
            #
            # What --split genuinely cannot do here is create N entries: a
            # bundle describes exactly one address, and there is no
            # --btc-amount to divide. That is what the message should have
            # said. This is the second "NO EFFECT" claim in this file that was
            # wrong about its own code -- the first one, in stage4, was telling
            # operators that --expect-total-xmr did nothing in receiver mode
            # while the run planned against a quarter of the money.
            integrity_log("stage3", "split_receive_mode_gate_only")
            print(f"  [!] --split {args.split} does NOT create {args.split} "
                  f"entries in receiver mode: a bundle describes exactly one "
                  f"address, and there is no --btc-amount to divide. For N "
                  f"genuinely separate entries, mint N bundles "
                  f"(create_receive_wallet --count N) and run once per bundle.")
            print(f"      It DOES tell the arrival gate to expect "
                  f"{args.split} separate payments to this one address, which "
                  f"tightens the gate so one missing payment cannot hide "
                  f"inside the tolerance. That is the right value if "
                  f"{args.split} swaps are routed here.")
        integrity_log("stage3", "entry_reused_from_receive_wallet")
        print(f"  [+] ENTRY (from receive wallet): "
              f"{scrub_address(receive_entry_addr)}")
    else:
        _n_entries = planned_chunk_count(args, jm_utxos)
        ENTRY_SET = create_entry_set(rpc_primary, _n_entries)
        for _ea, _ec, _ei in ENTRY_SET:
            addr_index[_ea] = (_ec, _ei)
        integrity_log("stage3", f"entry_created:{len(ENTRY_SET)}")
        if len(ENTRY_SET) > 1:
            print(f"  [+] {len(ENTRY_SET)} entry addresses, one per swap "
                  f"chunk — so the aggregator is never told that these "
                  f"payments belong together, and no transaction in this "
                  f"run ever spends two chunks at once.")
    return ENTRY_SET, entry_addrs(ENTRY_SET)


def print_sender_instructions(swap_deposits: list) -> None:
    """What the operator has to do by hand, per chunk.

    Presentation only, extracted from main() so the stage-2 block reads as the
    decisions it makes rather than as a wall of prints. Each chunk carries its
    OWN deposit address, memo and expected amount -- and, since --split became
    real, its own XMR destination too, which is why the instructions are
    per-chunk rather than one address repeated.
    """
    print()
    print("  ============================================================")
    print("  SENDER INSTRUCTIONS — send BTC to these deposit addresses:")
    print("  ============================================================")
    for dep in swap_deposits:
        print(f"\n  --- Chunk {dep['chunk']} ---")
        print(f"  Send exactly: {dep['btc_amount']} BTC")
        print(f"  To address:   {dep['deposit_address']}")
        if dep.get("memo"):
            print(f"  With memo:    {dep['memo']}")
        print(f"  Expected XMR: ~{dep['expected_xmr']}")
    print()
    print("  ============================================================")
    print("  [!] YOU MUST manually send BTC to each deposit address above!")
    print("  [!] Include the memo in the BTC transaction OP_RETURN field!")
    print("  [!] Wait for XMR to arrive and confirm before proceeding!")
    print("  ============================================================")


def select_funded_entries(entry_set: list, entry_unlocked: list) -> tuple:
    """Drop the swap chunks that never arrived. Returns (entries, unlocked).

    A CHUNK THAT NEVER ARRIVED MUST NOT SINK THE RUN, and before this it did --
    with a message that was wrong in every particular.

    The arrival gate compares the SUM against the target, so a chunk can be
    missing while the total still clears: one swap overshooting its quote
    covers another that has not landed, and --accept-partial-swap allows a
    shortfall outright. That chunk's entry subaddress is then empty, and
    everything downstream misreads it. The veil would sweep an address holding
    nothing, and size_distribution -- which cannot fund a slice from a zero
    share -- returns no amounts at all, which main() reported as

        "usable balance too small to fan out across N subaddresses.
         Use fewer wallets, or fund the wallet more."

    The balance is fine, the wallet count is fine, and the real problem is that
    a swap has not settled. Found by running split_by_weight and
    size_distribution against a zero weight, not by a failing test.

    The dropped entries keep their addresses, and _exit_hold_list still takes
    the FULL set -- so a chunk that lands later is held back from the exit
    rather than swept to the operator's destination in one hop from an address
    the swap publicly names.

    Returns ([], []) when nothing arrived; the caller decides that is fatal.
    """
    funded = [(e, u) for e, u in zip(entry_set, entry_unlocked) if u > DUST_XMR]
    if len(funded) == len(entry_set):
        return list(entry_set), list(entry_unlocked)
    missing = len(entry_set) - len(funded)
    integrity_log("stage4", f"entry_chunks_unfunded:{missing}")
    if not funded:
        return [], []
    print(f"  [!] {missing} of {len(entry_set)} swap chunk(s) have NOT arrived "
          f"on their entry address. The run continues with the {len(funded)} "
          f"that did.")
    print("      The missing chunk(s) are NOT mixed by this run. Their entry "
          "addresses are held back from the exit, so nothing sweeps them to "
          "your destination in one hop if they land later — but nothing "
          "distributes them either. To mix one afterwards: send it to a fresh "
          "receive wallet as ONE ordinary transfer, then run again with "
          "--receive-wallet.")
    return [e for e, _u in funded], [u for _e, u in funded]


def size_and_prune_chunks(args, entries: list, unlocked: list,
                          fanout_dests: list, bal_before_veils: Decimal,
                          fee_xmr: Decimal, rng) -> tuple:
    """Fit the distribution to the chunks that arrived. Returns
    (entries, unlocked, bal, usable, dest_slices, slice_usable, amounts).

    SIZE BEFORE VEILING, so a chunk that turns out to be too small to
    distribute is dropped BEFORE a veil spends it. Ordering matters and getting
    it wrong is invisible to a test that calls the pieces separately: veil
    first, and the dropped chunk has already been swept to a carrier nothing
    then distributes -- an orphan output on an account the exit does not hold,
    which is strictly worse than leaving it on the entry address where the hold
    covers it.

    A chunk can arrive above dust and still be too small to fund even one mix
    output. select_funded_entries only knows about DUST_XMR; the real
    requirement is a whole fan-out output plus its fee, and that is not known
    until the slices exist. That used to abort the entire run under a message
    about the wallet balance being too small, while every other chunk was fine.

    Dropping a chunk changes N, which changes the veil-fee reserve, which
    changes `usable` -- so the whole budget is recomputed each round rather than
    patched. Bounded by the chunk count; dropping one gives the rest a larger
    share, so it converges.
    """
    # SIZE BEFORE VEILING, so a chunk that turns out to be too small to
    # distribute is dropped BEFORE a veil spends it.
    #
    # Ordering matters here and getting it wrong is not visible in a test
    # that calls the pieces separately: veil first and the dropped chunk
    # has already been swept to a carrier that nothing then distributes --
    # an orphan output on an account the exit does not hold, which is
    # strictly worse than leaving it on the entry address where the hold
    # covers it.
    #
    # Dropping a chunk changes N, which changes the veil-fee reserve, which
    # changes `usable`, so the whole budget is recomputed each round rather
    # than patched. Bounded by the chunk count; dropping one gives the rest
    # a larger share, so it converges.
    for _attempt in range(max(1, len(entries))):
        # `bal` here is the balance AFTER the veils will have paid their fees,
        # which is what the distribution can actually spend. It is local: the
        # value returned is the caller's untouched `bal_before_veils`, because
        # resolve_entry_veils subtracts the same reserve itself. Returning the
        # netted figure subtracted it TWICE -- silently, since the result is
        # merely conservative -- and left `bal` meaning something different
        # either side of the veil call. Caught by re-reading the diff, not by a
        # test: nothing fails, the peel fit just quietly tightens.
        _veil_cost = (hop_fee_reserve(fee_xmr) * len(entries)
                      if getattr(args, "entry_veil", True) else Decimal(0))
        bal = bal_before_veils - _veil_cost
        if bal <= DUST_XMR:
            sys.exit(f"[!] Balance {bal} XMR left after the entry "
                     f"sweep's fee reserve. Fund the wallet more.")
        usable, total_fees, rounds = compute_fee_budget(
            bal, fee_xmr, args.wallets,
            peel=bool(getattr(args, "peel", False)),
            dag_mixing=bool(getattr(args, "dag_mixing", False)),
            exit_set=bool(getattr(args, "exit_to", None)),
            chunks=len(entries))
        if usable <= DUST_XMR:
            sys.exit(fee_budget_shortfall(bal, total_fees, rounds, usable,
                                          getattr(args, "peel", False)))
        _sl, _su, _amts, _bad = size_distribution(
            fanout_dests, unlocked, usable, fee_xmr,
            args.dag_mixing, rng)
        if _bad is None or len(entries) <= 1:
            break
        _dropped = entries[_bad]
        integrity_log("stage4", "chunk_too_small_to_distribute")
        print("  [!] One swap chunk arrived with too little to fund even "
              "one mix output, so it is left undistributed and the rest of "
              "the run continues without it.")
        print(f"      Its value stays on its entry address (account "
              f"{_dropped[1]}), which the exit holds back — so nothing "
              f"sweeps it to your destination in one hop. Nothing "
              f"distributes it either.")
        entries = [e for i, e in enumerate(entries)
                            if i != _bad]
        unlocked = [u for i, u in enumerate(unlocked)
                           if i != _bad]
    # bal_before_veils, NOT the netted `bal` -- see the note in the loop.
    return (entries, unlocked, bal_before_veils, usable, _sl, _su, _amts)


def estimate_runtime(args, n_chunks: int, mix_outputs: int,
                     delay_window) -> str:
    """A rough wall-clock estimate for this run, as an operator-readable line.

    THE DELAYS DOMINATE, AND NOTHING SAID SO. --dag-mixing's help promised "a
    run takes ~20+ min longer", counting only the on-chain confirmation wait --
    but the DAG round relays ONE transaction per funded output and
    broadcast_signed_xmr sleeps that transaction's --hop-delay before each
    submit, sequentially. With the default 3-12 minute jitter and a default
    12-wallet run that is ~2 hours of sleeping, not 20 minutes of waiting.

    An operator who is told "20 minutes" and sees nothing happen for two hours
    concludes the run has hung and interrupts it -- and an interrupt mid-round
    is the one failure this pipeline has no automatic recovery from. The
    estimate is cheap; the misunderstanding is not.

    Deliberately rough and stated as such. It cannot know the real fee, the
    real block times, or how long a swap takes to settle, and it does not try:
    every figure here is the planned delays plus the confirmation gates, which
    are the parts this tool actually controls.
    """
    lo, hi = delay_window or DEFAULT_HOP_DELAY
    mean = (Decimal(lo) + Decimal(hi)) / 2
    confirm = Decimal(FANOUT_CONFIRM_POLL_ESTIMATE)
    secs, _ = _runtime_terms(args, n_chunks, mix_outputs, mean, confirm)
    hours = secs / Decimal(3600)
    if hours >= 48:
        return f"~{hours / 24:.1f} days"
    return (f"~{hours:.1f}h" if hours >= 1
            else f"~{int(secs / 60)} min")


def _runtime_terms(args, n_chunks: int, mix_outputs: int, mean: Decimal,
                   confirm: Decimal):
    """(seconds, delayed_transaction_count) for a run of this shape.

    COUNT EVERY TRANSACTION THAT SLEEPS, and the old version counted 22 of the
    36 a measured run actually relayed.

    broadcast_signed_xmr sleeps a per-transaction --hop-delay before EVERY
    submit, so the wall clock is (transactions x mean delay) plus the
    confirmation gates. Two whole phases were missing from the sum:

      * THE CHANGE SWEEPS. A peel chain leaves change on every carrier and
        _run_change_sweeps moves each one in its OWN transaction (deliberately
        -- see its docstring). That is one delayed transaction per carrier, and
        the estimate counted none of them.
      * HALF THE EXIT. The exit withdraws every funded subaddress, which is the
        mix outputs AND the change-sweep destinations, so under --peel it is
        2 x mix_outputs, not mix_outputs. This is the same undercount
        resolve_exit_destinations' arrival warning had before it was corrected
        to a floor.

    Measured against a full --peel --dag-mixing run with one chunk and seven
    mix outputs: veil 1 + peels 7 + hops 7 + change sweeps 7 + exits 14 = 36
    transactions on chain. The old terms summed to 22 -- a 39% undercount, on
    the number whose own docstring says an operator who believes it and then
    waits longer "concludes the run has hung and interrupts it", which is the
    one failure this pipeline cannot recover from automatically.

    Returned as a pair so the count can be shown alongside the time: "~14h" is
    a number to doubt, "36 transactions, ~14h" is a number to check.
    """
    _peel = bool(getattr(args, "peel", False))
    # ZERO under --peel. Every peel consumes its carrier exactly and the last
    # one sweeps, so nothing lands on any subaddress 0 and there is nothing to
    # sweep -- see build_peel_plan. This was `mix_outputs`, one change sweep
    # per carrier, which is n transactions the run no longer makes and n
    # withdrawals the exit no longer has to issue.
    #
    # A fan-out still leaves its remainder on the spending account's
    # subaddress 0, one per chunk.
    change_locations = 0 if _peel else n_chunks
    txs = n_chunks                                   # one veil per chunk
    secs = mean * n_chunks
    secs += confirm                                  # carriers confirm+unlock
    if _peel:
        secs += (mean + confirm) * mix_outputs       # sequential, gated per peel
        txs += mix_outputs
    else:
        secs += mean * n_chunks                      # one fan-out per chunk
        txs += n_chunks
    if getattr(args, "dag_mixing", False):
        secs += confirm + mean * mix_outputs
        txs += mix_outputs
    # ONE GATE PER PHASE, not per transaction. Everything a phase spends was
    # relayed together, so the first _wait_for_change_settled absorbs the
    # unlock and the rest are already unlocked when their turn comes.
    if change_locations:
        secs += confirm + mean * change_locations
        txs += change_locations
    if getattr(args, "exit_to", None):
        _exits = mix_outputs + change_locations
        secs += confirm + mean * _exits
        txs += _exits
    return secs, txs


def build_change_sweep_jobs(rpc_primary, addr_index, change_accounts) -> list:
    """A fresh destination for each account's change. Returns
    [(account, 0, dest_addr, dest_index)].

    A distribution cannot allocate its input exactly, so monerod returns the
    remainder to subaddress 0 of the SPENDING account. That output never went
    through the hop rounds, so it is unmixed, and leaving it on the account
    that spent the swapped funds is the leak the sweep exists to close.

    ONE JOB PER CHANGE ACCOUNT, and with N carriers there are N of them.

    A job whose destination could not be created is SKIPPED, and the caller
    must still HOLD that account: the exit is what would otherwise withdraw
    the change nobody could sweep. That coupling lived in the caller and got
    it wrong -- the hold was built from the jobs, so the one account whose
    sweep failed was also the one not held. See the hold in _stage5_run.
    """
    change_sweep_jobs = []
    for _acct in change_accounts:
        try:
            _csacct = create_fresh_account(rpc_primary, label="")
            _csa, _csi = rpc_primary.new_subaddress_indexed(
                account_index=_csacct, label="")
        except Exception as e:                           # noqa: BLE001
            integrity_log("stage4", f"change_sweep_target_FAILED:{_acct}")
            print(f"  [!] Could not create a destination for the change on "
                  f"account {_acct} ({str(e)[:60]}). That change will stay "
                  f"on account {_acct}, subaddress 0 — UNMIXED. The exit "
                  f"HOLDS it, so it is not withdrawn to your destination; "
                  f"it simply sits there. Move it by hand, or leave it.")
            continue
        addr_index[_csa] = (_csacct, _csi)
        change_sweep_jobs.append((_acct, 0, _csa, _csi))
    # SAME CHECK AS THE VEIL CARRIERS, and for the same reason. Each change
    # location holds the remainder of ONE chunk's distribution, so two jobs
    # sharing a destination sweep two different swap chunks onto one address --
    # and the exit issues a single sweep_all per funded subaddress, so both
    # then leave in ONE multi-input transaction. That is the convergence the
    # split exists to prevent, reached through the tidying step.
    #
    # build_entry_veils refuses exactly this and says so ("that merges two swap
    # chunks into one output"); create_subs and create_entry_set refuse it too.
    # This loop mints from the same RPC in the same shape and was the one that
    # did not look. create_fresh_account cannot cover it: it validates a single
    # answer and has no memory across calls.
    #
    # Before any money moves -- these are provisioned in stage 4, and the
    # sweeps run at the end of stage 5.
    _cs_addrs = [j[2] for j in change_sweep_jobs]
    _cs_accts = [addr_index[j[2]][0] for j in change_sweep_jobs]
    if len(set(_cs_addrs)) != len(_cs_addrs) or len(set(_cs_accts)) != len(_cs_accts):
        integrity_log("stage4", "DUPLICATE_CHANGE_SWEEP_TARGET")
        sys.exit(
            f"[!] Two of the {len(change_sweep_jobs)} change sweeps would pay the "
            f"SAME fresh address.\n"
            f"    Refusing: each change location holds a DIFFERENT swap chunk's "
            f"remainder, so that\n"
            f"    address would hold value from two chunks -- and the exit sweeps a "
            f"subaddress in ONE\n"
            f"    transaction, which would spend both together and prove they share "
            f"an owner.\n"
            f"    Nothing has been spent. Check the wallet RPC.")
    return change_sweep_jobs


def resolve_swap_deposits(args, proxy, jm_utxos, receive_mode, entry_addr,
                          entry_addrs, entry_set) -> list:
    """Stage 2 execution: turn this run's BTC into deposit instructions.

    Returns the deposit list stage 4 waits on -- the --swap-pairs bundle in
    receiver mode, one quote per chunk when there is BTC to split, and [] in
    manual mode, where the operator drives thor_swap_preparer themselves.

    Extracted from main() unchanged. It is 80-odd lines of branching that
    decides how much BTC goes to how many swaps and which entry address each
    one names -- the binding the whole --split invariant rests on -- and it sat
    inline in the one function nothing executes, which is the reason given
    every other time something was lifted out of here (see establish_entry_set,
    build_distribution_plan, size_and_prune_chunks). `swap_deposits` is the
    only name that escaped the block, so this is a move, not a rewrite.
    """
    swap_deposits = []
    if receive_mode:
        integrity_log("stage2", "skipped:receive_mode:xmr_already_on_entry")
        print(f"\n  [+] RECEIVER MODE: Skipping ThorChain swap (XMR already on entry address).")
        print(f"  [+] Entry address: {scrub_address(entry_addr)}")
        swap_deposits = _receive_pairs_for(args, entry_addr)   # --swap-pairs
    else:
        btc_chunks = []

        if jm_utxos:
            btc_chunks = jm_utxos
        elif args.btc_amount is not None and args.btc_amount <= 0:
            # Falling through the `> 0` test below landed in the manual-mode
            # branch, which told the operator "No --btc-amount specified"
            # for an amount they had plainly specified.
            sys.exit(f"[!] --btc-amount must be positive (got "
                     f"{args.btc_amount}).")
        elif args.btc_amount and args.btc_amount > 0:
            num_splits = max(args.split, 1)
            btc_chunks = split_btc_amount(args.btc_amount, num_splits,
                                          secrets.SystemRandom())
            # COUNT only, never the per-chunk BTC amount: the integrity log
            # persists, and the exact BTC-per-swap correlates directly with the
            # on-chain BTC deposit and the ThorChain swap it feeds. Same reason
            # the fan-out/hop amounts stay off the chain.
            integrity_log("stage2", f"btc_split:{num_splits}_chunks")
            print(f"\n  [*] Splitting {args.btc_amount} BTC into "
                  f"{num_splits} UNEQUAL chunk(s) — equal deposits made "
                  f"minutes apart are one cluster on the Bitcoin chain, "
                  f"and their memos read out every destination.")

        if btc_chunks:
            # ONE DESTINATION PER CHUNK. entry_addrs is in chunk
            # order and was sized from planned_chunk_count, so a drift
            # between the two is caught inside the quote loop rather
            # than silently re-using an address.
            swap_deposits = stage2_get_swap_quotes(
                args, proxy, btc_chunks, entry_addrs)
            # READ BACK what each chunk was actually quoted to. The
            # deposits carry the destination they used (xmr_dest), and
            # until this existed nothing consumed it -- the binding
            # between "chunk 2's quote" and "entry address 2" was list
            # POSITION and a comment claiming that mattered. A reordering
            # anywhere between here and the arrival wait would pair a
            # chunk with another chunk's address, which is the merge the
            # split exists to prevent, reached by a bookkeeping slip.
            _quoted_dests = [d.get("xmr_dest") for d in swap_deposits]
            if _quoted_dests != entry_addrs[:len(_quoted_dests)]:
                integrity_log("stage2", "QUOTE_DEST_MISMATCH")
                sys.exit(
                    "[!] The quotes were not fetched against this run's "
                    "entry addresses, in order.\n"
                    "    Refusing to issue deposit instructions: a chunk "
                    "quoted to another chunk's\n"
                    "    address would route two swaps to one entry, "
                    "which links them at the\n"
                    "    aggregator and merges them on-chain.")
            integrity_log("stage2", "swap_quotes_generated")
            total_expected, _unreadable_quotes, _ = swap_expected_total(swap_deposits)
            print(f"\n  [+] {len(swap_deposits)} deposit instruction(s) generated.")
            print(f"  [+] Expected total: ~{total_expected} XMR after swaps")
            print_sender_instructions(swap_deposits)
        else:
            integrity_log("stage2", "manual_mode")
            print(f"\n  [!] MANUAL MODE: No --btc-amount specified.")
            print(f"  [!] Use thor_swap_preparer to generate deposit addresses:")
            print(f"        python3 thor_swap_preparer \\")
            print(f"          --amounts <BTC_AMOUNT> \\")
            # ONE --dests PER entry_addr ADDRESS, and printing only the first
            # would be this defect issued as an instruction: with
            # --split N the operator would send N swaps to one address,
            # which is precisely what the entry set exists to stop --
            # and thor_swap_preparer would refuse the repeat anyway.
            print(f"          --dests "
                  + " ".join(scrub_address(_a) for _a in entry_addrs)
                  + " \\")
            print(f"          --tor-proxy {args.tor_proxy}")
            if len(entry_addrs) > 1:
                print(f"  [!] The addresses are SCRUBBED above. Read the "
                      f"{len(entry_addrs)} full ones from the wallet: they "
                      f"are subaddress 1 of accounts "
                      + ", ".join(str(_c) for _a, _c, _i in entry_set)
                      + ".")
                print(f"  [!] One per swap, never the same one twice — "
                      f"that is what keeps the aggregator from linking "
                      f"them.")
            print(f"  [!] Then wait for the XMR to arrive before proceeding.")
    return swap_deposits


def main():
    install_signal_handlers()

    if maybe_print_limits():
        return

    cli = build_cli()
    args = cli.parse_args()

    # Purely syntactic flag validation, so a typo is reported before anything
    # semantic (a wallet password prompt, a bech32 checksum) can mask it.
    _delay_window = resolve_hop_delay(args)
    resolve_exit_destinations(args)
    # AFTER the exit destinations, because one of its refusals compares against
    # them: a cut address that is also an exit address is not a cut.
    resolve_usage_fee(args)
    resolve_split(args)
    resolve_swap_arrival(args)

    resolve_wallet_password(args)
    resolve_sensitive_inputs(args)

    # AFTER resolve_sensitive_inputs, BECAUSE THAT IS WHAT DECIDES THE AMOUNT.
    #
    # This ran three lines up, with the rest of the syntactic checks, and
    # resolve_sensitive_inputs then OVERWROTE args.btc_amount from
    # GS_BTC_AMOUNT -- so every check in here was applied to the argv value and
    # none of them to the environment value. The environment is the path this
    # tool tells operators to PREFER (argv publishes the amount to
    # /proc/<pid>/cmdline, mode 0444), so the preferred path was the
    # unvalidated one. Exactly the defect decimal_env was written for, one
    # layer up: decimal_env catches NaN/Infinity/non-positive, and the two
    # checks it does not know about are the two that live here.
    #
    # DRIVEN, both of them, against the shipped call order:
    #
    #   GS_BTC_AMOUNT=0.123456789            accepted (argv: refused, sub-satoshi)
    #   GS_BTC_AMOUNT=0.00000003 --split 3   accepted (argv: refused, needs 6 sat)
    #
    # The first then reaches split_btc_amount, which raises ValueError for a
    # total finer than a satoshi -- uncaught, so a raw traceback, and only
    # after Tor was verified, the wallet opened, the mix subaddresses and the
    # entry set created. That is the same "did all of that work before saying
    # no" this function's own docstring records fixing for `--btc-amount 0`.
    #
    # Nothing here reads a value resolve_sensitive_inputs does not already
    # have, and nothing between the two prompts or touches the network, so the
    # stated ordering rule still holds: this is still before the bech32
    # checksum in resolve_entry_mode.
    resolve_btc_amount(args)

    (receive_mode, receive_entry_addr, receive_account_index,
     receive_subaddress_index) = resolve_entry_mode(args)

    # ---- Validate inputs early ----
    args.wallets = max(args.wallets, MIN_WALLETS)
    args.deep = max(args.deep, MIN_DEEP)

    proxy = validate_proxy(args.tor_proxy)

    rpc_primary, rpc_alt, fee_xmr = stage0_preflight(args, proxy)

    ###########################################################################
    # Stage 1 - JoinMarket (optional BTC tumble before ThorChain)
    ###########################################################################
    newnym(required=True, proxy_url=getattr(args, "tor_proxy", ""))   # anonymity gate before stage 1 network ops

    if receive_mode:
        jm_utxos = []
        integrity_log("stage1", "skipped:receive_mode")
    else:
        jm_utxos = stage1_joinmarket(args, args.btc_entry)
    integrity_log("stage1", f"done:jm_utxos={len(jm_utxos)}")
    # THE CHUNK COUNT IS KNOWN NOW, AND --peel NEEDS ONE. resolve_split can
    # only see --split; JoinMarket's UTXOs decide the count without it. Asked
    # here, before the entry set, the quotes and the deposit instructions --
    # see refuse_peel_multichunk for the walk that lands on the stage-4
    # backstop instead.
    refuse_peel_multichunk(args, jm_utxos)

    ###########################################################################
    # Stage 2 - ThorChain swap definition
    ###########################################################################

    ###########################################################################
    # Stage 3 - Build wallets & DAG (runs BEFORE stage2 invocation so
    # the ENTRY receive address exists for ThorChain destination)
    ###########################################################################
    newnym(required=True, proxy_url=getattr(args, "tor_proxy", ""))   # anonymity gate before stage 3
    tor_recheck(proxy, "stage3_pre")

    # ONE RUN AT A TIME, AND THE GUARD STARTS BEFORE THE FIRST WALLET
    # MUTATION -- not before the last one.
    #
    # This lock used to be taken 400 lines below, around the change-sweep
    # provisioning, with a comment claiming that 'locking before the read is
    # the point of locking at all'. The balance read, the account rotation,
    # every mix subaddress, every peel carrier and every per-hop account were
    # all created above it. Two concurrent runs would both read the same
    # balance, both build a complete plan, both litter the wallet with
    # accounts and subaddresses, and only then would the loser discover it
    # had been planning against money the winner was already spending.
    #
    # Nothing here double-spends -- the loser exits before stage 5 -- so the
    # cost was wasted work and an unexplained late failure, plus orphan
    # accounts left in the wallet. That is still not what the comment said
    # was happening, and a guard that starts after the thing it guards is a
    # guard in name only.
    #
    # flock, so the kernel releases it if this process dies: there is no
    # stale-lock state and therefore no advice anywhere that tells an
    # operator to delete the lock file, which is what made the original race
    # dangerous. It is held for the whole run, which is hours for a peel
    # chain, and that is the intent: two GhostSpiral runs against one wallet
    # is never safe.
    with run_lock(Path(".ghostspiral.lock"), "GhostSpiral"):
        sub_account = resolve_mix_account(args, rpc_primary, receive_mode,
                                         receive_account_index)

        # Random per-run extra-output count, so the total (wallets + this) is not a
        # deterministic fingerprint of the `wallets` setting under public code.
        _num_decoys = secrets.SystemRandom().randint(DECOY_MIN, DECOY_MAX)
        subs, addr_index, decoy_addrs = create_subs(
            rpc_primary, args.wallets, _num_decoys)
        if len(subs) < MIN_WALLETS:
            sys.exit("[!] Failed to create enough subaddresses")

        ENTRY_SET, ENTRY_ADDRS = establish_entry_set(
            args, rpc_primary, addr_index, jm_utxos, receive_mode,
            receive_entry_addr, receive_account_index,
            receive_subaddress_index)
        # Kept for the handful of places that legitimately name ONE
        # address to the operator (the manual-mode instructions).
        ENTRY = ENTRY_ADDRS[0]

        import secrets as _secrets
        _secrets.SystemRandom().shuffle(subs)

        # BEFORE THE SWAP, not at the exit. The entry set and every mix
        # subaddress now exist, so this is the first moment the run can ask
        # whether --exit-to points back at itself -- and it is still the last
        # moment before any money moves. See reject_self_exit.
        reject_self_exit(args, addr_index, ENTRY_ADDRS)
        # AND THE SHAPE HAS TO FIT. The decoys are drawn, the entries are
        # minted, so the mix-output count and the chunk count are both exact
        # here -- and this is still before the first quote. See refuse_thin_mix
        # for the stage-4 exit it replaces, which is reached only after the
        # swap has landed.
        refuse_thin_mix(subs, ENTRY_ADDRS, decoy_addrs, args.wallets,
                        _num_decoys, len(ENTRY_SET))

        ###########################################################################
        # Stage 2 execution - ThorChain swap (now that ENTRY address exists)
        ###########################################################################
        newnym(required=True, proxy_url=getattr(args, "tor_proxy", ""))   # anonymity gate before ThorChain execution
        tor_recheck(proxy, "stage2_exec")

        # The quotes outlive the stage that fetched them: the arrival wait below
        # needs the SUM of what every chunk was quoted to deliver, not just the
        # instructions that were printed here. It used to be a local inside the
        # `if btc_chunks:` arm, so the wait had no idea how many chunks were
        # coming or how much they were worth, and stopped on the first one --
        # which is why this is a RETURN VALUE and every path in there sets it,
        # manual mode included.
        swap_deposits = resolve_swap_deposits(
            args, proxy, jm_utxos, receive_mode, ENTRY, ENTRY_ADDRS, ENTRY_SET)

        # THE WHOLE ENTRY SET, not ENTRY_ADDRS[0]. Every entry address is one
        # a public swap settlement points at, so a hop paying any of them puts
        # mixed value back on an address the analyst already has. This call
        # said `ENTRY` while the function had been made plural -- the function
        # fixed, the call site not, which is how the 87%-of-runs defect its
        # docstring measured got there in the first place.
        dag = build_dag_adjacency(subs, ENTRY_ADDRS, args.deep, _secrets)
        integrity_log("stage3", "dag_built")

        ###########################################################################
        # Stage 4 - Balance, amounts, plan
        ###########################################################################

        # THE SPEND ACCOUNT IS THE MIX ACCOUNT. Not "0 unless receiving".
        #
        # This line used to read `receive_account_index if receive_mode else 0`,
        # written before the mix account was rotated and never revisited when it
        # was. resolve_mix_account creates a fresh account and create_subs puts
        # ENTRY and every mix subaddress in it -- and then send mode came back
        # here and hard-coded 0, which is used for:
        #   * the balance poll (xmr_balance),
        #   * the peel carriers,
        #   * the PLAN's account_index, i.e. which account every spend comes from,
        #   * the change-sweep destination, and
        #   * change_target -- so change went to account 0 / subaddress 0.
        #
        # Two failures, and the second is the one that matters.
        #
        # FUNCTIONAL: the balance was polled from account 0 at ENTRY's index. That
        # is a DIFFERENT subaddress -- account 0's subaddress at that number -- so
        # send mode sized its plan from an unrelated balance, or from nothing.
        #
        # OPSEC: every spend named account 0, so the run's change came to rest on
        # account 0 / subaddress 0 -- the wallet PRIMARY -- and the change sweep
        # then SPENT it. The account rotation was theatre in send mode: the fresh
        # account held the subaddresses while the wallet's identity address did all
        # the work. An analyst labelling that address recovers it from every send
        # graph, which is exactly what rotation was added to prevent.
        #
        ENTRY_PAIRS = resolve_entry_accounts(
            rpc_primary, addr_index, ENTRY_ADDRS, sub_account)
        # The first entry's account is still the run's "home" account for the
        # things that legitimately have exactly one (the change fallback the
        # peel planner uses when a plan names none). Everything that plans or
        # spends takes the whole list.
        bal_account, entry_index = ENTRY_PAIRS[0]

        total_bal, unlocked_bal = entry_set_balance(rpc_primary, ENTRY_PAIRS)

        total_bal, unlocked_bal = stage4_await_swap(
            args, rpc_primary, ENTRY_PAIRS, ENTRY_ADDRS, swap_deposits,
            receive_mode, total_bal, unlocked_bal)

        integrity_log("stage4", "balance_fetched")

        if total_bal > unlocked_bal + DUST_XMR:
            print(f"  [!] {total_bal - unlocked_bal} XMR still locked (pending confirmations)")

        bal = unlocked_bal
        if bal <= DUST_XMR:
            sys.exit(
                f"[!] Unlocked balance is {unlocked_bal} XMR (below dust threshold).\n"
                f"    Cannot create a real TX plan without funds.\n"
                f"    Total balance: {total_bal} XMR (may be locked/unconfirmed)."
            )

        # PER-ENTRY BALANCES, captured before the veil spends them. Each
        # carrier will hold its own chunk, so each carrier's slice of the mix
        # targets has to be sized from the chunk that actually landed on it --
        # chunks are not equal (quotes differ; JoinMarket's UTXOs differ by
        # design), and sizing them equally would plan a fan-out one carrier
        # cannot afford while another sits under-spent.
        # STRICT, not best-effort: select_funded_entries cannot tell a zero
        # that means "never arrived" from a dropped socket. See the helper.
        _entry_unlocked = [u for _t, u in read_entry_balances_strict(
            rpc_primary, ENTRY_PAIRS, "sizing the distribution")]

        ENTRY_SET_FUNDED, _entry_unlocked = select_funded_entries(
            ENTRY_SET, _entry_unlocked)
        if not ENTRY_SET_FUNDED:
            sys.exit(
                f"[!] None of the {len(ENTRY_SET)} entry address(es) holds an "
                f"unlocked balance.\n"
                f"    Nothing has been spent. Wait for the swap(s) to settle "
                f"and run again.")

        # -- Phase A: Fan-out -------------------------------------------------
        # Distribute funds from ENTRY into mix subaddresses. In receiver mode ALL
        # funds sit on ENTRY; in sender mode ThorChain deposits to ENTRY. Either
        # way funds must spread outward before any hop-mixing can source from a
        # mix subaddress. Fan-out sources from ENTRY, which is already funded and
        # confirmed, so this round can always be created in one batch.
        # The entry set is no longer taken from `subs` at all, so this filter
        # is an invariant rather than a subtraction -- kept because an entry
        # address reachable as a hop destination is the defect build_dag_adjacency
        # measured at 87% of runs, and a silent regression here would restore it.
        _entry_addr_set = set(ENTRY_ADDRS)
        mix_targets = [s for s in subs if s not in _entry_addr_set]
        # Fund wallets + a random number of extra outputs; ALL of them hop (no
        # dead-end tell). hop_sources_real == fanout_dests, so no output is a
        # distinguishable class under public code.
        fanout_dests, hop_sources_real = select_fanout_targets(
            mix_targets, decoy_addrs, args.wallets, _num_decoys)
        fanout_count = len(fanout_dests)
        if fanout_count <= 0:
            # Guard the divisor. mix_targets excludes ENTRY, so a degenerate
            # subaddress set (or a create_subs that returned only ENTRY) would
            # divide by zero here and crash with a bare ZeroDivisionError after
            # the wallet work was already done.
            integrity_log("stage4", "no_mix_targets")
            sys.exit("[!] No mix subaddresses available to fan out into "
                     f"(got {len(mix_targets)}). Cannot build a plan.")
        # THE CUT COMES OFF BEFORE ANYTHING SIZES AGAINST THE BALANCE.
        #
        # It is one more destination on the fan-out, so the fan-out spends the
        # same total either way -- what changes is how much of it the MIX gets.
        # Taking it here, from the pre-veil balance, is what makes that true
        # everywhere downstream: size_and_prune_chunks slices this figure,
        # resolve_entry_veils reduces it again, and compute_fee_budget is
        # recomputed from the result. Deducting it later would leave the
        # fan-out promising more than the carrier holds.
        #
        # PRE-VEIL, because that is the deposit. The veil reserve is a cost of
        # mixing; the cut is a share of what arrived, and an operator quoting
        # 1.1% means 1.1% of what was sent, not of what survived the plumbing.
        _fee_addr, _fee_amt, _fee_pair = plan_usage_fee(
            rpc_primary, args, bal, fee_xmr)
        if _fee_addr:
            bal = bal - _fee_amt
        # Unequal, jittered amounts -- see compute_fanout_amounts: identical splits
        # give a chain analyst one value and one shape to cluster and follow.
        (ENTRY_SET_FUNDED, _entry_unlocked, bal, usable,
         _dest_slices, _slice_usable, fanout_amounts) = size_and_prune_chunks(
            args, ENTRY_SET_FUNDED, _entry_unlocked, fanout_dests, bal,
            fee_xmr, _secrets.SystemRandom())

        veil_plan, SPEND_SOURCES, bal = resolve_entry_veils(
            rpc_primary, args, addr_index, ENTRY_SET_FUNDED, bal, fee_xmr,
            _delay_window)
        # The first source is the run's "home" for the one or two things that
        # genuinely have exactly one (the peel planner's change fallback).
        SPEND_ADDR, bal_account, entry_index = SPEND_SOURCES[0]
        if bal <= DUST_XMR:
            sys.exit(f"[!] Balance {bal} XMR left after the entry sweep's fee "
                     f"reserve. Fund the wallet more.")

        # Recomputed from the POST-veil balance, and it agrees with what
        # size_and_prune_chunks used: that returns the pre-veil balance and
        # resolve_entry_veils subtracts the reserve exactly once. Recomputed
        # rather than reused so the dust guards below run against the balance
        # that exists after the veil plan, not the one projected before it --
        # and with THE SAME SHAPE, or the two disagree.
        usable, total_fees, rounds = compute_fee_budget(
            bal, fee_xmr, args.wallets, chunks=len(SPEND_SOURCES),
            peel=bool(getattr(args, "peel", False)),
            dag_mixing=bool(getattr(args, "dag_mixing", False)),
            exit_set=bool(getattr(args, "exit_to", None)))
        if usable <= DUST_XMR:
            sys.exit(fee_budget_shortfall(bal, total_fees, rounds, usable,
                                          getattr(args, "peel", False)))

        integrity_log("stage4", "plan_calculated")

        _empty_slices = [i for i, sl in enumerate(_dest_slices) if not sl]
        if _empty_slices:
            integrity_log("stage4", "chunk_without_destinations")
            sys.exit(
                f"[!] {len(_empty_slices)} swap chunk(s) would have no mix "
                f"subaddress to distribute into\n"
                f"    ({fanout_count} target(s) for {len(_dest_slices)} "
                f"chunk(s)). That chunk's value would sit\n"
                f"    on its carrier, unmixed, while the run reported success. "
                f"Use more --wallets, or fewer\n"
                f"    --split chunks.")
        if not fanout_amounts:
            sys.exit(
                f"[!] Usable balance {usable} XMR too small to fan out across "
                f"{fanout_count} subaddresses with the fee reserve each output needs. "
                f"Use fewer wallets, disable --dag-mixing, or fund the wallet more."
            )
        # Fan-out is ONE transaction: a single transfer_split from ENTRY's single
        # confirmed output to all fanout_count mix subaddresses at once (one input
        # -> many outputs). Emitting fanout_count SEPARATE TXs from ENTRY would fail
        # for the SAME reason the DAG round is confirmation-gated: ENTRY holds ONE
        # confirmed output (one swap / one deposit), spendable once per batch, so
        # the 2nd..Nth separate TX would fail 'no unlocked output' and abort the run
        # (the change output from TX0 is unconfirmed and unspendable in the batch).
        # Per-destination amount, so each mix subaddress receives its OWN magnitude.
        fanout_by_addr = dict(zip(fanout_dests, fanout_amounts))

        # fanout_by_addr COMES BACK. A shrunk peel distribution rebinds it in
        # there, and the old call discarded that -- build_dag_plan below then
        # sized its fundability check from amounts no subaddress received.
        (fanout_plan, change_accounts, distribution_mode,
         fanout_by_addr) = build_distribution_plan(
            args, rpc_primary, addr_index, SPEND_SOURCES, fanout_dests,
            fanout_by_addr, _dest_slices, fee_xmr, bal_account,
            fanout_count, _delay_window, _secrets, bal, usable,
            fee_addr=_fee_addr, fee_amt=_fee_amt)

        # Subaddresses that will receive a fan-out output, with the (account, index)
        # pair Stage 5 polls to confirm they've unlocked before hop-mixing.
        funded_targets = list(fanout_dests)
        fanout_targets_indexed = [(_src_account(addr_index, a),
                                   _src_index(addr_index, a))
                                  for a in funded_targets]

        # -- Phase B: DAG hop-mixing (opt-in, --dag-mixing) -------------------
        # Each funded mix subaddress hops a chunk of its balance onward to a DAG
        # neighbour. CRITICAL: after fan-out, a mix subaddress holds exactly ONE
        # confirmed output. Monero can spend that output only once per confirmation
        # round, so each subaddress may source AT MOST ONE hop in a single created
        # batch -- source it twice and every hop after the first fails for "no
        # unlocked output". We therefore iterate each funded subaddress once (a
        # permutation), not random-with-replacement. This whole round also cannot
        # be created until the fan-out confirms on-chain, which is why it runs as a
        # separate confirmation-gated round in Stage 5 (see _stage5_run).
        dag_plan = build_dag_plan(args, fee_xmr, hop_sources_real, fanout_by_addr,
                                  dag, mix_targets, addr_index, _secrets,
                                  delay_window=_delay_window,
                                  dest_slices=_dest_slices)

        meta = {
            "schema": "unsigned_v1",
            "version": VERSION,
            "created": int(time.time()) // 600 * 600,
            "rounds": len(fanout_plan) + len(dag_plan),
            # hop_fee_reserve(fee_xmr), NOT `per_round_fee` (a local of
            # compute_fee_budget) -- that name raised NameError here on every
            # run, so no plan was ever written. See compute_fee_budget.
            "fee_per_round": str(hop_fee_reserve(fee_xmr)),
            "total_fees": str(total_fees),
            "account_index": bal_account,
            "distribution_mode": distribution_mode,
        }

        fanout_file, veil_file, dag_file = _write_plans(
            args, meta, fanout_plan, veil_plan, dag_plan)

        ###########################################################################
        # Stage 5 - Auto sign + broadcast
        ###########################################################################
        newnym(required=True, proxy_url=getattr(args, "tor_proxy", ""))   # anonymity gate before broadcast
        tor_recheck(proxy, "stage5_pre")

        _stage5_cleanup(Path(args.output), fanout_file, dag_file, veil_file)
        # AFTER the cleanup, which erases this directory. See the function.
        open_chain_once_marker(args.output)

        staging_dir = "tx_staging"
        # ONE SWEEP DESTINATION PER CHANGE LOCATION, and one sweep each --
        # distinct ADDRESSES and distinct ACCOUNTS, because N outputs in one
        # account can be spent by one transaction and that transaction's input
        # count proves they share an owner. A peel chain has no change
        # locations at all now; a fan-out has one per chunk. See
        # build_change_sweep_jobs and _run_change_sweeps for the full argument.
        change_sweep_jobs = build_change_sweep_jobs(
            rpc_primary, addr_index, change_accounts)
        # Where the last rounds pay. The exit gates on these having landed
        # before it reads the wallet -- see _stage5_run's landing gate.
        _dag_ix, _sweep_tg = _landing_targets(addr_index, dag_plan,
                                              change_sweep_jobs)

        # HOW LONG THIS WILL TAKE, BEFORE IT STARTS. The delays are the
        # dominant cost and nothing said so -- see estimate_runtime. An
        # operator who thinks a run takes twenty minutes and sees two hours of
        # silence interrupts it, and an interrupt mid-round is the failure
        # this pipeline cannot recover from automatically.
        print(f"  [*] Expected wall-clock for the rounds below: "
              f"{estimate_runtime(args, len(SPEND_SOURCES), fanout_count, _delay_window)}"
              f" — mostly the per-transaction --hop-delay, which is an OPSEC "
              f"parameter, not overhead. Do NOT interrupt it.")

        # All four veil/delay kwargs below are required -- see _stage5_run.
        incomplete, withheld = _stage5_run(args, fanout_file, dag_file,
                                 fanout_targets_indexed,
                                 staging_dir, proxy, usable,
                                 distribution_mode=distribution_mode,
                                 change_target=(bal_account, 0),
                                 change_sweep_jobs=change_sweep_jobs,
                                 change_accounts=change_accounts,
                                 delay_window=_delay_window,
                                 veil_file=veil_file,
                                 veil_target=[(_a, _i) for _d, _a, _i
                                              in SPEND_SOURCES],
                                 veil_need=[
                                     min(_su, _eu - hop_fee_reserve(fee_xmr))
                                     for _su, _eu in zip(_slice_usable,
                                                         _entry_unlocked)],
                                 exit_accounts=_exit_account_list(
                                     addr_index, change_accounts, bal_account),
                                 exit_hold=_exit_hold_list(args, addr_index,
                                                           ENTRY_ADDRS),
                                 # Defence in depth on an isolation that is
                                 # otherwise only an omission -- see the note
                                 # in _stage5_run where this joins _hold.
                                 exit_fee_hold=([_fee_pair] if _fee_pair
                                                else []),
                                 dag_dst_index=_dag_ix,
                                 sweep_targets=_sweep_tg)

        report_completion(rpc_primary, incomplete,
                          [a for a, _ in addr_index.values()] + list(change_accounts),
                          spent_plans=(veil_file, fanout_file, dag_file),
                          withheld=withheld,
                          # .get, NOT _src_account: that helper aborts on a
                          # miss (it guards TX BUILDING, where guessing an
                          # account spends the wrong output). Here the value
                          # only decides whether one warning prints, and this
                          # is an ARGUMENT to report_completion -- so a miss
                          # would sys.exit before the holdings report and
                          # before _wipe_spent_plans, leaving every plan file
                          # on disk at the end of a run that fully succeeded.
                          # That is the same defect as folding a withheld
                          # output into `incomplete`, through a new door.
                          # _exit_hold_list, three lines up, already treats a
                          # missing ENTRY as "nothing to hold".
                          # The only durable pointer to the operator's own
                          # fee -- see the note in report_completion.
                          fee_pair=_fee_pair,
                          entry_account=[a for a, _ in ENTRY_PAIRS])


def _write_plans(args, meta, fanout_plan, veil_plan, dag_plan) -> tuple:
    """Materialise the round plans to --output. Returns (fanout, veil, dag).

    veil and dag are None when that round is not planned, and every caller
    downstream relies on that: _stage5_run skips Round 0 on a falsy veil_file,
    and _wipe_spent_plans tolerates the Nones so a completed run erases exactly
    the plans that exist.

    All three share ONE plan_tag, so the files of a single run are
    recognisable as a set -- and _stage5_cleanup erases every unsigned_*.json
    it is not explicitly told to keep, which is how a previous run's plans stop
    accumulating in the output directory.
    """
    outdir = Path(args.output)
    secure_mkdir(outdir)          # 0700, not 0755: listing leaks TX count/timing
    _warn_unwiped_outdir(outdir)
    plan_tag = secure_hex(8)
    fanout_file = outdir / f"unsigned_fanout_{plan_tag}.json"
    atomic_write_json({"meta": meta, "txs": fanout_plan}, fanout_file)
    veil_file = None
    if veil_plan:
        veil_file = outdir / f"unsigned_veil_{plan_tag}.json"
        atomic_write_json({"meta": meta, "txs": veil_plan}, veil_file)
    dag_file = None
    if dag_plan:
        dag_file = outdir / f"unsigned_dag_{plan_tag}.json"
        atomic_write_json({"meta": meta, "txs": dag_plan}, dag_file)
    integrity_log("stage4", "unsigned_dump_saved")
    print(f"  [+] Fan-out plan: {fanout_file} ({len(fanout_plan)} TXs)")
    if dag_file:
        print(f"  [+] DAG hop plan: {dag_file} ({len(dag_plan)} hops)")
    # However this run ends, the operator gets told these exist. Registered
    # HERE, at the one place all three are created, so no later path can
    # forget: a complete run wipes them and the report stays silent; every
    # other ending -- including an uncaught exception, where nothing else runs
    # at all -- names them. See register_sensitive_plan.
    register_sensitive_plan(fanout_file, veil_file, dag_file)
    return fanout_file, veil_file, dag_file


def _warn_unwiped_outdir(outdir: Path) -> bool:
    """Warn if --output sits where paranoia_mode's sweep will never look.

    That sweep globs four FIXED roots (cwd, $HOME, $HOME/ghostspiral,
    $HOME/GhostSpiral) at depth 0 and 1, so `--output /mnt/usb/plans` puts
    every hop's source, destination, amount and account index somewhere nothing
    will ever erase -- and the run reports success identically either way.

    A COMPLETE run now wipes its own plans (see _wipe_spent_plans), but an
    INCOMPLETE one keeps them deliberately, and that is precisely the run that
    strands them. So the warning goes out when the directory is chosen, while
    the operator can still do something about it. Returns True if it warned.
    """
    if wipe_covers(outdir):
        return False
    integrity_log("stage4", "outdir_outside_wipe_roots")
    print(f"  [!] {outdir} is outside every directory paranoia_mode searches. "
          f"The unsigned plans written there carry every hop's destination and "
          f"amount. If this run does not complete they will NOT be wiped — "
          f"erase them yourself, or pass --search-dir {outdir.resolve()} to "
          f"paranoia_mode.")
    return True


#: Plan files this run has written that are NOT safe to leave lying around.
#: Each unsigned_*.json carries every hop's source, destination, amount and
#: account index in plaintext.
#:
#: NOT "including --exit-to". Only the EXIT plan carries the final
#: destination; the fan-out, veil and DAG-round plans move funds between this
#: run's own accounts and never contain it. _report_surviving_plans used to
#: tell the operator otherwise and was corrected -- this comment, on the very
#: list that feeds it, kept asserting the same wrong thing to the next reader.
_SENSITIVE_PLANS = []


def register_sensitive_plan(*paths) -> None:
    """Remember a plan file so an ABNORMAL exit can still name it.

    A COMPLETE run erases its own plans (_wipe_spent_plans) and this list goes
    quiet. Every other ending was silent about them:

      * An INCOMPLETE run keeps its plans deliberately -- those accounts are
        mid-flight and the operator may need to see what was meant to happen --
        and report_completion's incomplete branch says "Funds are safe in the
        wallet" and exits 1 WITHOUT ever mentioning that the run's whole
        routing table is sitting in ./unsigned.
      * An UNCAUGHT EXCEPTION is worse: report_completion never runs at all, so
        there is no message of any kind. The operator sees a traceback, and the
        plans stay until the START of some later run (_stage5_cleanup) or a
        paranoia_mode they have to remember to invoke -- forever, if neither
        happens.

    _warn_unwiped_outdir already covers ONE corner of it -- an --output outside
    paranoia_mode's four search roots -- but it fires when the directory is
    chosen, which is hours before the failure it warns about, and says nothing
    at all for the DEFAULT output directory, where most runs put them.

    Not a wipe. Deleting a plan on a crash would destroy the only record of
    what a half-executed run intended, which is exactly what the operator needs
    after a crash. This tells them it exists.
    """
    for pth in paths:
        if pth and pth not in _SENSITIVE_PLANS:
            _SENSITIVE_PLANS.append(pth)


def _report_surviving_plans() -> None:
    """atexit: name the plan files still on disk, however this run ended.

    Runs on a clean exit, on sys.exit, and after an uncaught exception -- the
    three ways this pipeline actually stops. (Not on SIGKILL, where nothing
    can run.) Silent when there is nothing left, so a complete run that wiped
    its own plans prints exactly what it printed before.
    """
    left = [p for p in _SENSITIVE_PLANS if p and Path(p).exists()]
    if not left:
        return
    try:
        # NOT "--exit-to". The three plans registered here are the fan-out,
        # the entry veil and the DAG round; their destinations are mix
        # subaddresses and carriers, never the withdrawal address. The exit
        # plan is written later, is erased in its own `finally`, and warns by
        # name if that erase fails. Naming --exit-to here was a sentence that
        # made an operator look for the wrong thing in the right files -- and
        # made the real disclosure sound smaller than it is.
        print(f"\n  [!] {len(left)} unsigned plan file(s) are STILL ON DISK. "
              f"Each holds every hop's source, destination, amount and "
              f"account index in plaintext — the mix graph of this run:")
        for _p in left:
            print(f"        {Path(_p).resolve()}")
        print("      They were kept on purpose: this run did not complete, and "
              "they are the only record of what it intended. Read them if you "
              "need to, then erase them — paranoia_mode, or `shred -u` on "
              "each. Nothing else will: a later run only clears its own output "
              "directory, and if there is no later run they stay here.")
    except Exception:                                        # noqa: BLE001
        # An atexit hook must never turn a bad ending into a worse one.
        pass


def _wipe_spent_plans(*plan_files):
    """Securely erase the unsigned plan files after a fully complete run.

    Each unsigned_*.json holds every hop's source, destination, amount and
    account index in plaintext -- the most sensitive artifact this pipeline
    writes. On a complete run every transaction it describes has been
    broadcast, so the plan is spent and has no resume value. Left behind, it
    sat in ./unsigned (or --output) until the START of the next run, when
    _stage5_cleanup finally erased it -- and forever if there was no next run.
    paranoia_mode also globs it, but that is a separate step an operator can
    forget, and it misses a plan written under a --output outside its four
    search roots.

    Called only past report_completion's incomplete-run sys.exit, so an
    INCOMPLETE run KEEPS its plan on purpose: those accounts are mid-flight and
    the operator may need to see what was meant to happen. The staging blobs
    are already gone -- each _run_round wipes its own.
    """
    for pf in plan_files:
        if pf and Path(pf).exists() and not secure_delete_file(pf):
            print(f"  [!] Could not securely erase the spent plan {pf}; it holds "
                  f"every hop's destination and amount. Remove it by hand.")
    # The chain marker goes with them. It holds only redacted event NAMES, so
    # it is not sensitive in itself -- but it lists which routine events this
    # run reached, and a file whose existence dates a run is the artifact
    # _stage5_run already rmdir's the empty staging directory to avoid.
    _cm = _CHAIN_ONCE_FILE[0]
    if _cm and Path(_cm).exists():
        secure_delete_or_warn(Path(_cm), "this run's chain marker")
    _CHAIN_ONCE_FILE[0] = ""


#: Env var carrying the wallet spend-key password to the SIGN child only.
GS_PW_ENV = "GS_WALLET_PASSWORD"

#: Path of this run's shared "already chained" marker, or "" before it exists.
#:
#: A one-element list rather than a plain global so _child_env can read it
#: without a `global` declaration and the value has exactly one home. Created
#: by open_chain_once_marker at the start of stage 5 and erased by its caller;
#: it holds only event NAMES, which are already redacted, and never a value.
_CHAIN_ONCE_FILE = [""]


def open_chain_once_marker(outdir) -> str:
    """Create this run's shared once-per-run chain marker. Returns its path.

    Children get the path through GS_CHAIN_RUN_ONCE (see _child_env), so
    integrity_log_once's set spans the RUN rather than each child process.
    Without it a loop of N rounds writes N copies of every routine line and the
    count is read off the chain by counting -- see _child_env.

    In the run's own output directory so _stage5_cleanup and paranoia_mode
    already cover it, and 0600 like everything else this run writes.
    """
    try:
        _p = Path(outdir) / f".chain_once_{secure_hex(6)}"
        _fd = os.open(str(_p), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.close(_fd)
        _CHAIN_ONCE_FILE[0] = str(_p)
        return str(_p)
    except OSError:
        # A missing marker costs duplicate chain lines, not a broken run.
        _CHAIN_ONCE_FILE[0] = ""
        return ""


def _child_env(wallet_password: str = None) -> dict:
    """Environment for a child process, with the wallet password scrubbed unless
    that child is the one that needs it.

    subprocess.run() with no env= hands the child a COPY OF OUR WHOLE
    ENVIRONMENT. Once the password is supplied via GS_WALLET_PASSWORD -- which
    this toolchain now recommends over argv -- every child inherits the Monero
    spend-key password by default, including JoinMarket's third-party
    tumble.py, the create-phase signer (which never signs anything), broadcast,
    and the exit simulator. None of them need it, and a third-party child that
    logs or dumps its environment would leak it.

    EVERY GS_ VARIABLE, not just the password. This popped GS_WALLET_PASSWORD
    alone, under a docstring whose own argument -- "a third-party child that
    logs or dumps its environment would leak it" -- applies word for word to
    the rest of them. Verified by calling this function: JoinMarket's tumbler
    was handed GS_BTC_ENTRY (the operator's Bitcoin address), GS_BTC_AMOUNT,
    and GS_EXPECT_TOTAL_XMR under the comment "third-party child: password
    scrubbed".

    GS_EXPECT_TOTAL_XMR is the sharpest version of the mistake, because it was
    added to get the swapped total OFF argv -- world-readable via
    /proc/<pid>/cmdline -- and landed it in an environment passed verbatim to a
    third-party program. That is not a fix, it is a change of address.

    Default-deny is free here: nothing GhostSpiral spawns reads a GS_ variable
    except the SIGN phase, which reads GS_WALLET_PASSWORD. Checked by grepping
    every child -- airgap_tx_signer reads only GS_WALLET_PASSWORD,
    broadcast_signed_xmr reads none.
    """
    env = {k: v for k, v in os.environ.items() if not k.startswith("GS_")}
    if wallet_password is not None:
        env[GS_PW_ENV] = wallet_password
    # THE ONE GS_ VARIABLE A CHILD IS GIVEN BACK, and it carries no value of
    # the operator's -- only the path of a marker file listing which ROUTINE
    # chain events this run has already recorded.
    #
    # gs_common.integrity_log_once collapses a repeated event to one line
    # because "cardinality survives redaction whenever a loop writes a line per
    # turn". Its set was per PROCESS, and a round spawns three fresh children,
    # so an N-round loop wrote N copies of every line the guard exists to
    # collapse. Measured on a completed run: nine `signer|using_account_index:#`
    # lines between the exit's own withdraw_start and withdraw_done markers,
    # for a run that made exactly nine withdrawals -- the number the exit
    # collapses its OWN lines into a set to avoid recording.
    if _CHAIN_ONCE_FILE[0]:
        env["GS_CHAIN_RUN_ONCE"] = _CHAIN_ONCE_FILE[0]
    return env


def _stage5_cleanup(outdir_path: Path, *current_files):
    """Securely erase the PREVIOUS run's artifacts before this run starts.

    Extracted from main() so it is directly testable -- the old inline version
    could only be exercised by running the whole pipeline, which is why it went
    unaudited while every one of its deletions was insecure.

    Every path here is overwritten, not merely unlinked. What the old
    unlink/rmtree left recoverable on disk:
      * tx_staging/ -- the prior run's FULLY SIGNED, RELAYABLE transactions,
        its unsigned tx sets, and signed_manifest_v1.json with unscrubbed
        destinations and amounts. This is the worst of the three: a recovered
        signed blob can simply be broadcast.
      * unsigned_*.json plans -- the code's own comment already said these
        "contain full destination addresses"; it then deleted them with a plain
        unlink, so the whole mix graph (every subaddress, amount and per-TX
        delay) survived in freed blocks.
      * *_progress.json -- relayed txids paired with blob paths, i.e. a direct
        map from this machine to on-chain transactions.
    """
    for stale in ["signer_progress.json", "broadcast_progress.json"]:
        stale_path = Path(stale)
        if stale_path.exists():
            ok = secure_delete_file(stale_path)
            integrity_log("stage5", f"cleaned_stale:{stale}:{'ok' if ok else 'FAILED'}")
            if not ok:
                print(f"  [!] Could not securely erase {stale}; remove it manually.")

    for old_dir in ["signed_blobs", "tx_staging"]:
        old_path = Path(old_dir)
        if old_path.is_dir():
            ok = secure_delete_tree(old_path)
            integrity_log("stage5", f"cleaned_old_dir:{old_dir}:{'ok' if ok else 'FAILED'}")
            if not ok:
                print(f"  [!] Could not securely erase {old_dir}/ — it may still hold "
                      f"a previous run's signed transactions. Remove it manually.")

    # Old unsigned plans, but NOT the ones Stage 4 just created.
    #
    # `current_files` is variadic and Nones are dropped, so a round added later
    # is kept by passing its file rather than by remembering to extend a pair
    # of named parameters. The entry veil was added as a third plan file and
    # this loop, which securely erases every unsigned_*.json it is not told
    # about, deleted it between stage 4 writing it and stage 5 running it.
    if outdir_path.is_dir():
        current_names = {f.name for f in current_files if f}
        for old_plan in list(outdir_path.glob("unsigned_*.json")):
            if old_plan.name not in current_names:
                ok = secure_delete_file(old_plan)
                integrity_log("stage5",
                              f"cleaned_old_plan:{old_plan.name}:{'ok' if ok else 'FAILED'}")
                if not ok:
                    print(f"  [!] Could not securely erase {old_plan}; remove it manually.")


def _run_round(args, plan_file, staging_dir, label, wipe: bool = True):
    """Create -> sign -> broadcast one plan file. Aborts on any failure.

    Each round gets its own staging subdir so its unsigned/signed blobs and
    manifest never collide with another round's. Returns the number of TXs
    broadcast for this round.

    THE STAGING IS WIPED HERE, for every round, because three of the five
    rounds were not wiping it. _run_peel_chain wipes its own per-peel staging
    and says why -- "a peel chain runs for hours, and leaving each peel's
    signed (relayable) blob on disk for the whole run is exactly the exposure
    secure staging exists to avoid" -- and the entry veil, the fan-out (the
    DEFAULT distribution) and the DAG round all left theirs behind. Observed
    on a real run: tx_staging/veil/ still held signed/tx_0.signed, its
    manifest with destinations and amounts, and outputs_export.hex (a map of
    the wallet's holdings) long after the transaction was on-chain.

    Doing it in the caller is what allowed three callers to differ, so it is
    done here where a new round cannot forget it. Mode is already 0600/0700;
    this is about the blobs existing at all, not about who can read them.

    It wipes on the FAILURE path too, deliberately. Every failure below is a
    sys.exit, i.e. the whole pipeline is over; the operator restarts, and a
    restart designs a fresh plan against the balances that actually exist, so
    the old round's unsigned/signed blobs and its bcast_progress.json have no
    remaining use. Worse, they have negative use: a stale bcast_progress.json
    left in this same staging path is exactly what the resume guard treats as
    a half-finished broadcast, so keeping it would make the NEXT run abort.
    """
    _ok = False
    try:
        _result = _run_round_body(args, plan_file, staging_dir, label)
        _ok = True
        return _result
    finally:
        _sd = Path(staging_dir)
        if wipe and _sd.is_dir():
            # THE BROADCASTER'S LAST WORDS ARE "retry with --resume", AND THIS
            # IS THE LINE THAT MAKES THAT IMPOSSIBLE.
            #
            # broadcast_signed_xmr exits non-zero on a partial relay with
            # "rest transient -- retry with --resume {progF}", where progF is
            # {staging_dir}/bcast_progress.json -- inside the tree wiped two
            # lines below, along with signed/*.signed. So the last thing an
            # operator reads is an instruction naming a file this function then
            # securely erases, and they are left hunting for it.
            #
            # The wipe is still right: a partially relayed round leaves SIGNED,
            # RELAYABLE transactions on disk, and that is the exposure secure
            # staging exists for. What was wrong is only that nothing said the
            # resume was gone. Saying it costs three lines.
            #
            # Gated on the round having actually reached the broadcast, so an
            # early create/sign failure -- which prints no resume advice and
            # leaves no signed blob -- does not get a correction to a message
            # the operator never saw.
            if not _ok and ((_sd / "bcast_progress.json").exists()
                            or (_sd / "signed").is_dir()):
                print(f"  [!] {label}: --resume is NOT available for this round. "
                      f"Its signed transactions and its progress file are being "
                      f"securely erased right now, deliberately: leaving "
                      f"relayable blobs on disk is a worse exposure than losing "
                      f"the ability to retry. Ignore the broadcaster's "
                      f"'--resume' line above — that file will not exist.")
                print(f"      Anything that DID relay is on-chain and cannot be "
                      f"recalled; anything that did not is still unspent where "
                      f"it was. Nothing is lost, and nothing left this wallet "
                      f"that had not already left it.")
            if not secure_delete_tree(_sd):
                print(f"  [!] Could not securely wipe {staging_dir}; it holds this "
                      f"round's signed, relayable transaction blob. Remove it "
                      f"manually.")


#: Round events already recorded, as (event, role). One entry per KIND, not
#: per round.
#:
#: A run drives _run_round once per peel, once per change sweep, once per exit
#: withdrawal, plus the veil, the fan-out and the DAG -- and each success wrote
#: three chain lines carrying the round's label. Redacting the digits out of
#: "Exit 7/11" gives "exit #/#", which is fine on its own and useless as a
#: defence: an analyst counts the `broadcast_ok:exit` lines instead and has the
#: number of outputs the run holds, which is exactly what removing the
#: per-output `withdrawn:<acct>/<sub>` lines from the exit was meant to take
#: away. Cardinality survives redaction whenever a loop writes a line per turn.
#:
#: So the chain records THAT peels were created, signed and broadcast, and that
#: one of them failed if one did. How many, and which, are printed to the
#: terminal, where they reach the operator and stop.
#:
#: Process-scoped, which is run-scoped: one GhostSpiral process is one run, and
#: the run lock guarantees it.
_ROUND_EVENTS_LOGGED = set()


def _round_role(label: str) -> str:
    """"Peel 3/6" -> "peel". The role is what the chain may keep; the ordinal
    is the part that counts the run."""
    return re.sub(r"[\d/]+", " ", str(label)).strip().lower() or "round"


def _round_log(event: str, label: str, detail: str = "") -> None:
    """Record a round event ONCE per (event, role). See _ROUND_EVENTS_LOGGED."""
    role = _round_role(label)
    key = (event, role)
    if key in _ROUND_EVENTS_LOGGED:
        return
    _ROUND_EVENTS_LOGGED.add(key)
    integrity_log("stage5", f"{event}:{role}" + (f":{detail}" if detail else ""))


def _run_round_body(args, plan_file, staging_dir, label):
    """The three phases themselves. Split out only so _run_round can wrap
    them in the staging wipe without re-indenting all of this; nothing else
    calls it."""
    try:
        print(f"  [*] {label} 5a: Creating unsigned TXs via wallet-rpc...")
        subprocess.run(
            [sys.executable, _tool("airgap_tx_signer"), str(plan_file),
             "--phase", "create",
             "--rpc", args.rpc_primary,
             "--tor-proxy", args.tor_proxy,
             "--outdir", staging_dir,
             f"--fee-priority={args.fee_priority}"],
            check=True, timeout=1800,
            env=_child_env(),       # create phase never signs: password scrubbed
        )
        _round_log("create_unsigned_ok", label)

        unsigned_count = len(list(Path(staging_dir).glob("*.unsigned")))
        if unsigned_count == 0:
            _round_log("no_unsigned_txs_created", label)
            sys.exit(f"[!] {label}: phase 'create' produced no unsigned TX files. "
                     f"Check RPC and balance.")
        print(f"  [+] {label}: {unsigned_count} unsigned TXs created.")
    except subprocess.TimeoutExpired:
        _round_log("create_timeout", label)
        sys.exit(f"[!] {label}: unsigned TX creation timed out after 30 min")
    except subprocess.CalledProcessError as e:
        _round_log("create_fail", label, str(e.returncode))
        sys.exit(f"[!] {label}: unsigned TX creation failed (exit {e.returncode})")

    newnym(proxy_url=getattr(args, "tor_proxy", ""))
    secure_delay(3.0, 8.0)

    try:
        print(f"  [*] {label} 5b: Signing unsigned TXs (offline wallet)...")
        # Password goes through the ENVIRONMENT, never argv. As argv it sat in
        # the child's world-readable /proc/<pid>/cmdline (mode 444) for the
        # whole signing run -- up to the 1800s timeout below -- where any local
        # user could read it with `ps -eo args`. /proc/<pid>/environ is mode
        # 400, so only the owner and root can read it.
        _sign_env = _child_env(args.wallet_password or "")
        subprocess.run(
            [sys.executable, _tool("airgap_tx_signer"), str(plan_file),
             "--phase", "sign",
             "--wallet-file", args.wallet_file,
             "--outdir", staging_dir],
            check=True, timeout=1800, env=_sign_env,
        )
        _round_log("sign_ok", label)

        signed_dir = Path(staging_dir) / "signed"
        signed_count = len(list(signed_dir.glob("*.signed"))) if signed_dir.is_dir() else 0
        if signed_count == 0:
            _round_log("no_signed_txs", label)
            sys.exit(f"[!] {label}: phase 'sign' produced no signed TX files. "
                     f"Check wallet file and password.")
        print(f"  [+] {label}: {signed_count} TXs signed.")
    except subprocess.TimeoutExpired:
        _round_log("sign_timeout", label)
        sys.exit(f"[!] {label}: signing timed out after 30 min")
    except subprocess.CalledProcessError as e:
        _round_log("sign_fail", label, str(e.returncode))
        sys.exit(f"[!] {label}: signing failed (exit {e.returncode})")

    newnym(proxy_url=getattr(args, "tor_proxy", ""))
    secure_delay(5.0, 15.0)

    try:
        print(f"  [*] {label} 5c: Broadcasting signed TXs...")
        # Relay via wallet-rpc submit_transfer (NOT the daemon). Each round gets
        # its own progress file under its own staging subdir so the fan-out and
        # DAG rounds -- distinct blob sets -- never trip each other's stale-
        # progress guard (which would abort the second round).
        # --rpc-daemon is forwarded so the child VERIFIES relay egress rather
        # than only warning. Stage 0 already checked it, but peers change over
        # a long run: a daemon that was Tor-only at startup can pick up
        # clearnet peers before this broadcast happens, so it is re-checked at
        # the moment of relay. --allow-clearnet-relay is forwarded too, or the
        # operator's explicit override at the top level would be silently
        # dropped and the child would refuse anyway.
        # THE TIMEOUT MUST INCLUDE THE DELAYS THIS ROUND PLANNED TO SERVE.
        #
        # This was `timeout=7200`, a constant, while the delays are served
        # INSIDE this child and are CUMULATIVE -- the comment at the veil
        # builder says so in as many words: broadcast_signed_xmr "relays a plan
        # file with a single `for item in items:` loop that SLEEPS item.delay
        # before each submit, so the delays are CUMULATIVE, not offsets from a
        # common start."
        #
        # So the round's entire planned delay budget had to fit in two hours,
        # and nothing checked that it did. Measured with the shipped hop_delay
        # over 600 trials per cell, P(one round exceeds 7200s):
        #
        #                            N=1     N=2     N=8    N=10    N=20
        #   default 180-720          0.0%    0.0%    0.0%    0.0%   99.3%
        #   1800-7200                0.0%   78.2%  100.0%  100.0%  100.0%
        #   7200-21600             100.0%  100.0%  100.0%  100.0%  100.0%
        #   21600-86400            100.0%  100.0%  100.0%  100.0%  100.0%
        #
        # 21600-86400 is the window hop_delay()'s OWN docstring recommends for
        # ring-age plausibility, and every draw from it exceeded the cap at
        # N=1. So the tool's own advice guaranteed the round was killed with
        # nothing relayed -- and the default did too once --wallets reached 20,
        # which gs_console offers up to 60.
        #
        # What made it expensive rather than merely annoying: _run_round's
        # finally securely erases this round's signed blobs AND
        # bcast_progress.json, so --resume is gone with them, and on the entry
        # veil -- the first stage-5 round, whose _run_round is not wrapped --
        # the sys.exit takes the whole run down with the funds still on ENTRY,
        # the address the public ThorChain memo names.
        #
        # The plan file is right here and carries every delay, so the bound is
        # derived instead of guessed: the sum of what this round will actually
        # sleep, plus the original two hours for the work itself (egress
        # re-checks, submits, retries).
        _planned_delay = 0
        try:
            _ptxs = json.loads(Path(plan_file).read_text()).get("txs") or []
            # delay_is_sane, NOT the coercion this replaces:
            #
            #     _planned_delay = sum(max(0, int(t.get("delay") or 0))
            #                          for t in _ptxs)
            #
            # This is the THIRD reader of a per-TX plan delay and it was the
            # one still coercing -- the precise construct delay_is_sane was
            # written to remove from broadcast_signed_xmr's fallback, left in
            # the file that does not import it. int() takes bools, floats and
            # numeric strings, and `max(0, ...)` hides a negative rather than
            # refusing it.
            #
            # WHAT IT COSTS HERE IS THE TIMEOUT, WHICH IS THE POINT OF THE
            # LINE. _bcast_timeout is what kills a hung broadcast child, and it
            # is derived from this sum. Driven on the shipped expression: a
            # plan delay of 10**12 yields a timeout of ~31,700 years, so the
            # kill never happens; "604800" quietly buys a week. plan_file is an
            # UNSIGNED file on local disk -- a weaker boundary than the
            # manifest, which refuses all five of these outright.
            #
            # A bad delay raises, so the except below applies its conservative
            # fallback rather than this loop inventing a number: the failure
            # mode stays "wait longer", never "never kill".
            for _t in _ptxs:
                _d = _t.get("delay") or 0
                if not delay_is_sane(_d):
                    raise ValueError(
                        f"plan delay {_d!r} is not a sane per-TX delay")
                _planned_delay += _d
        except Exception:                                    # noqa: BLE001
            # A plan we cannot re-read is not a reason to pick a bound that is
            # too SHORT: fall back to the old constant plus the widest window
            # the operator could have asked for, so the failure mode is a wait
            # rather than a kill with the blobs erased.
            _planned_delay = HOP_DELAY_MAX
        _bcast_timeout = BROADCAST_WORK_TIMEOUT + _planned_delay
        if _planned_delay > BROADCAST_WORK_TIMEOUT:
            print(f"  [*] {label}: this round will sleep ~{_planned_delay // 60} min "
                  f"of planned inter-transaction delay before it finishes "
                  f"(--hop-delay). Allowing {_bcast_timeout // 60} min.")
        _bcast_cmd = [sys.executable, _tool("broadcast_signed_xmr"), f"{staging_dir}/signed",
                      "--tor-proxy", args.tor_proxy,
                      "--rpc", args.rpc_primary,
                      "--rpc-daemon", args.rpc_daemon,
                      "--resume", f"{staging_dir}/bcast_progress.json"]
        if args.allow_clearnet_relay:
            _bcast_cmd.append("--allow-clearnet-relay")
        subprocess.run(_bcast_cmd, check=True, timeout=_bcast_timeout,
                       env=_child_env())
        _round_log("broadcast_ok", label)
    except subprocess.TimeoutExpired:
        _round_log("broadcast_timeout", label)
        sys.exit(f"[!] {label}: broadcast timed out after "
                 f"{_bcast_timeout // 60} min (planned delays "
                 f"{_planned_delay // 60} min + {BROADCAST_WORK_TIMEOUT // 60} "
                 f"min for the relay work itself).")
    except subprocess.CalledProcessError as e:
        _round_log("broadcast_fail", label, str(e.returncode))
        sys.exit(f"[!] {label}: broadcast failed (exit {e.returncode})")

    return signed_count


def _wait_for_fanout_confirm(args, targets, proxy, what="fan-out"):
    """Block until `targets` have UNLOCKED balance.

    The DAG hop round spends outputs the fan-out round just created, and Monero
    outputs are unspendable until they confirm and unlock (~10 blocks). We poll
    each target's unlocked balance via wallet-rpc and return True once all of
    them are unlocked. On timeout we return False so the caller can skip
    DAG rather than create hops that would fail for 'no unlocked output'.

    `what` names the outputs in the operator-facing lines, because this is no
    longer only the fan-out gate: the EXIT uses it too, to refuse to enumerate
    what it will withdraw until the round that funded it has landed. Saying
    "fan-out" there would send an operator looking at the wrong round.
    """
    if not targets:
        return False
    try:
        rpc = connect_rpc(args.rpc_primary, proxy_url=getattr(args, "tor_proxy", ""))
    except Exception as e:
        integrity_log("stage5", f"confirm_rpc_connect_fail:{type(e).__name__}")
        print(f"  [!] Could not connect wallet-rpc to await fan-out confirmation: {e}")
        return False

    print(f"  [*] Waiting for {len(targets)} {what} output(s) to confirm+unlock "
          f"(~10 blocks; up to {FANOUT_CONFIRM_TIMEOUT // 60} min)...")
    waited = 0
    while waited < FANOUT_CONFIRM_TIMEOUT:
        if shutdown_requested():
            integrity_log("stage5", "confirm_wait_interrupted")
            return False
        # Force a sync first: without it a wallet-rpc that isn't auto-refreshing
        # never sees the just-broadcast fan-out outputs and we'd spin to timeout.
        try:
            rpc.raw_request("refresh", {})
        except Exception:
            pass
        unlocked = 0
        for acct, sub_idx in targets:
            try:
                _total, unlk = rpc.get_subaddress_balance(acct, sub_idx)
                if unlk and int(unlk) > 0:
                    unlocked += 1
            except Exception as e:
                integrity_log("stage5", f"confirm_poll_err:{type(e).__name__}")
        if unlocked >= len(targets):
            integrity_log("stage5", f"fanout_confirmed:{unlocked}_targets")
            print(f"  [+] All {unlocked} {what} output(s) confirmed and unlocked.")
            return True
        print(f"  [*] {unlocked}/{len(targets)} confirmed; waiting {FANOUT_CONFIRM_POLL}s...")
        time.sleep(FANOUT_CONFIRM_POLL)
        waited += FANOUT_CONFIRM_POLL

    integrity_log("stage5", "fanout_confirm_timeout")
    print(f"  [!] Timed out after {FANOUT_CONFIRM_TIMEOUT // 60} min waiting for "
          f"the {what} output(s) to unlock.")
    return False


def _wait_for_carrier(args, account, sub_idx, min_unlocked_xmr, proxy, label):
    """Block until subaddress `sub_idx` holds at least min_unlocked_xmr UNLOCKED.

    The peeling carrier (the change address) only becomes spendable for the next
    peel once the previous peel's change has confirmed and unlocked (~10 blocks).
    Waiting on a >= threshold (not merely > 0) is what makes the peels
    sequential: a bare > 0 would return on stale unlocked dust and the next
    peel's create would fail 'not enough money'. Returns False on timeout so the
    caller can stop cleanly with the remaining balance intact.
    """
    try:
        rpc = connect_rpc(args.rpc_primary, proxy_url=getattr(args, "tor_proxy", ""))
    except Exception as e:
        integrity_log("stage5", f"carrier_rpc_connect_fail:{type(e).__name__}")
        print(f"  [!] {label}: cannot connect wallet-rpc to await the carrier: {e}")
        return False
    need_atomic = int((Decimal(str(min_unlocked_xmr)) * Decimal(10 ** 12)).to_integral_value())
    print(f"  [*] {label}: waiting for the carrier (subaddr {sub_idx}) to hold the "
          f"peeled change, confirmed+unlocked (~10 blocks; up to "
          f"{FANOUT_CONFIRM_TIMEOUT // 60} min)...")
    waited = 0
    while waited < FANOUT_CONFIRM_TIMEOUT:
        if shutdown_requested():
            integrity_log("stage5", "carrier_wait_interrupted")
            return False
        try:
            rpc.raw_request("refresh", {})
            _t, unlk = rpc.get_subaddress_balance(account, sub_idx)
            if unlk and int(unlk) >= need_atomic:
                integrity_log_once("stage5", "carrier_ready")
                print(f"  [+] {label}: carrier funded and unlocked.")
                return True
        except Exception as e:
            integrity_log("stage5", f"carrier_poll_err:{type(e).__name__}")
        time.sleep(FANOUT_CONFIRM_POLL)
        waited += FANOUT_CONFIRM_POLL
    integrity_log("stage5", "carrier_confirm_timeout")
    print(f"  [!] {label}: carrier change did not confirm within "
          f"{FANOUT_CONFIRM_TIMEOUT // 60} min.")
    return False


def peel_stuck_carrier(peels: list, relayed: int, fallback) -> tuple:
    """(account, subaddress) holding a stopped chain's UNDISTRIBUTED remainder.

    A peel consumes its carrier EXACTLY and pays the rest FORWARD to the next
    one (build_peel_plan), so when the chain stops at peel `relayed` the whole
    remainder is sitting on that peel's SOURCE -- the carrier it would have
    spent. Everything the chain had left is there: on a 10-peel chain that
    stopped at 3, that was 9.62 of 12 XMR.

    None when the chain finished: the last peel is a sweep_all, so there is no
    remainder to name.

    A function rather than two copies, because it is read in two places that
    must agree -- the operator message _run_peel_chain prints, and the hold
    _stage5_run gives the exit. They did not agree: the message said "the
    undistributed balance is safe on account N, subaddress M ... distribute it
    manually", and the exit then swept exactly that output to --exit-to and
    printed EXIT COMPLETE.
    """
    _acct, _sub = fallback
    if relayed >= len(peels) or relayed < 0:
        return None
    _e = peels[relayed] or {}
    try:
        return (int(_e.get("account_index", _acct)), int(_e.get("src_index", _sub)))
    except (TypeError, ValueError):                          # noqa: BLE001
        # A plan entry we cannot read must not resolve to SOME OTHER account's
        # subaddress and get that one held instead. The same rule the DAG
        # filter's _hop_src follows.
        return None


def _run_peel_chain(args, peel_file, staging_dir, proxy, change_target):
    """Run a peeling chain: each peel is its OWN confirmation-gated round.

    peel_file holds N peels (build_peel_stage_plan). Peel 0 spends ENTRY; each
    later peel spends a fresh ROTATING CARRIER that the previous peel paid
    explicitly, which only holds the funds once that peel confirms and unlocks
    -- so between peels we WAIT for that carrier to hold enough unlocked
    balance to fund the next. That wait is what spreads the N mix outputs
    across N transactions over time instead of one co-created fan-out.

    Both the carrier's subaddress AND its account come from the plan entry.
    Each hop lives in its own account so that its change lands on a distinct
    subaddress 0 and can be swept alone; `change_target` is only the fallback
    for a plan that names no account.

    Returns the number of peels relayed. A peel's create/sign/broadcast aborts
    the run (fail closed) exactly as any round does. If the chain stops partway
    (shutdown or a carrier timeout), the peels already relayed are on-chain and
    the UNDISTRIBUTED remainder is safe on the wallet's change subaddress -- but
    there is NO automatic resume: a fresh run rebuilds a new plan from the entry
    balance, so the operator finishes a partial chain by hand, not by re-running.
    """
    with open(peel_file) as f:
        pdata = json.load(f)
    meta = pdata.get("meta", {})
    peels = pdata.get("txs", [])
    acct, csub = change_target
    per_round_fee = Decimal(str(meta.get("fee_per_round", "0.01")))
    n = len(peels)
    print(f"  [*] === Peeling chain: {n} confirmation-gated peels ===")

    def _partial(done):
        # Honest state on an incomplete chain: NOT "re-run to finish" (a re-run
        # starts a brand-new plan and, in receive mode, would find the entry
        # address already drained). The remainder is safe, just not distributed.
        print(f"  [!] Peeling chain stopped at {done}/{n} peels. The {done} relayed "
              f"peel(s) are on-chain; the remaining ~{n - done} destination(s) were "
              f"NOT sent.")
        _pair = peel_stuck_carrier(peels, done, (acct, csub)) or (acct, csub)
        _stuck_acct, _stuck = _pair
        print(f"  [!] The undistributed balance is safe on this wallet's account "
              f"{_stuck_acct}, subaddress {_stuck} (the carrier this peel would "
              f"have spent). There is no auto-"
              f"resume: distribute it manually, or accept the partial distribution. "
              f"Do NOT simply re-run — that builds a new plan from a now-empty entry.")

    relayed = 0
    for i, peel in enumerate(peels):
        if shutdown_requested():
            integrity_log("stage5", f"peel_shutdown_at_{i}")
            _partial(relayed)
            break
        # Peels after the first spend a ROTATING carrier: the fresh subaddress
        # the previous peel paid its remainder to. Wait for THAT subaddress to
        # hold this peel's amount + a fee reserve, unlocked.
        #
        # The index comes from the plan (src_index), not from change_target.
        # Waiting on subaddress 0 while the funds are on a rotating carrier
        # would block forever; worse, if the wait were satisfied by unrelated
        # change sitting on subaddr 0, the peel would spend the hub after all
        # and undo the rotation.
        if i > 0:
            # The peel spends its destination AND forwards the remainder to
            # the next carrier, so the carrier must hold BOTH plus a fee.
            # Sizing this on "amt" alone (which is only the mix destination)
            # let the wait succeed on a carrier that could not fund the
            # transaction, and monerod then answered "not enough money" --
            # found by the real-chain test, not by the unit suite.
            if peel.get("destinations"):
                need = sum((Decimal(str(d["amount"])) for d in peel["destinations"]),
                           Decimal(0)) + per_round_fee
            else:
                need = Decimal(str(peel.get("amt", "0"))) + per_round_fee
            wait_sub = peel.get("src_index")
            if wait_sub is None:
                integrity_log("stage5", f"peel_no_src_index:{i}")
                print(f"  [!] peel {i + 1}/{n}: the plan carries no src_index, so the "
                      f"carrier to wait on is unknown. Refusing to guess subaddress 0 "
                      f"— that is the hub the rotation exists to avoid.")
                _partial(relayed)
                break
            # ...and in WHICH account. Each hop runs in its own account so its
            # change lands on its own subaddress 0 (see build_peel_stage_plan),
            # so polling `acct` for every hop would watch an account the funds
            # never reach and block until the timeout on peel 2 of every run.
            wait_acct = peel.get("account_index", acct)
            if not _wait_for_carrier(args, wait_acct, wait_sub, need, proxy,
                                     f"peel {i + 1}/{n}"):
                integrity_log("stage5", f"peel_carrier_timeout:{i}")
                _partial(relayed)
                break
        one_path = Path(str(peel_file)[:-5] + f"_peel{i}.json") \
            if str(peel_file).endswith(".json") else Path(str(peel_file) + f".peel{i}")
        atomic_write_json({"meta": meta, "txs": [peel]}, one_path)
        peel_stage = f"{staging_dir}/peel{i}"
        try:
            # INSIDE the try, next to the relay it guards, so the `finally`
            # below still erases this peel's plan -- destination and amount --
            # when a gate stops the run. Every relay site in this file now
            # reads the same way; test_tor_gates walks them and proves it.
            relay_gates(args, proxy, f"stage5_peel_{i}")
            _run_round(args, one_path, peel_stage, f"Peel {i + 1}/{n}")
            relayed += 1
        finally:
            # The per-peel plan carries the full destination + amount; wipe it.
            # The staging subdir itself is wiped by _run_round -- this loop used
            # to be the ONLY caller that did it, which is precisely why the
            # veil, fan-out and DAG rounds did not.
            secure_delete_or_warn(one_path, "this peel's plan (its destination and amount)")
    integrity_log("stage5", f"peel_chain_done:{relayed}_of_{n}")
    print(f"  [+] Peeling chain: {relayed}/{n} peels relayed.")
    return relayed


def _wait_for_change_settled(args, account, sub_idx, proxy, label):
    """Block until `sub_idx` has NO balance still confirming, then report it.

    Returns (ok, total_atomic). ok is False on timeout or a dead RPC.

    sweep_all can only spend UNLOCKED outputs -- proven on a real chain: a
    subaddress holding 2 XMR unlocked and 3 XMR still locked swept the 2 and
    LEFT THE 3 BEHIND, while the caller printed "nothing is parked on the
    change address". The old wait asked only for DUST_XMR to be unlocked,
    which is satisfied the moment ANY change confirms.

    That was found when a peel chain put every hop's change on one subaddress,
    where peel 0's change satisfied the wait long before the last peel's had
    confirmed. Each hop now runs in its own account, so this is called once per
    hop and each call watches a subaddress holding exactly one output -- but
    the guard is not obsolete, it is just no longer racing several outputs
    against each other. A single change output is still locked for ~10 blocks
    after its peel confirms, and sweeping before then sweeps nothing at all.

    "Nothing still confirming" (total == unlocked) is the right condition
    because it is the sweep's ACTUAL precondition, rather than a guess at how
    much change to expect -- which cannot be known in advance, since it is
    whatever the real fee left over.
    """
    try:
        rpc = connect_rpc(args.rpc_primary, proxy_url=getattr(args, "tor_proxy", ""))
    except Exception as e:                                   # noqa: BLE001
        integrity_log("stage5", f"change_settle_rpc_fail:{type(e).__name__}")
        print(f"  [!] {label}: cannot connect wallet-rpc to await the change: {e}")
        return False, 0
    print(f"  [*] {label}: waiting for the change on account {account} / subaddr "
          f"{sub_idx} to confirm and unlock (sweep_all can only spend unlocked "
          f"outputs, so sweeping early sweeps nothing)...")
    waited = 0
    while waited < FANOUT_CONFIRM_TIMEOUT:
        if shutdown_requested():
            integrity_log("stage5", "change_settle_interrupted")
            return False, 0
        try:
            rpc.raw_request("refresh", {})
            tot, unlk = rpc.get_subaddress_balance(account, sub_idx)
            tot, unlk = int(tot or 0), int(unlk or 0)
            if tot > 0 and tot == unlk:
                integrity_log_once("stage5", "change_settled")
                return True, tot
        except Exception as e:                               # noqa: BLE001
            integrity_log("stage5", f"change_settle_poll_err:{type(e).__name__}")
        time.sleep(FANOUT_CONFIRM_POLL)
        waited += FANOUT_CONFIRM_POLL
    integrity_log("stage5", "change_settle_timeout")
    return False, 0


def _change_residue(args, account, sub_idx):
    """Atomic balance left on the change subaddress, or None if unreadable."""
    try:
        rpc = connect_rpc(args.rpc_primary, proxy_url=getattr(args, "tor_proxy", ""))
        rpc.raw_request("refresh", {})
        tot, _ = rpc.get_subaddress_balance(account, sub_idx)
        return int(tot or 0)
    except Exception:                                        # noqa: BLE001
        return None


def _run_change_sweeps(args, jobs, staging_dir, proxy, meta,
                       delay_window=None) -> int:
    """Sweep each change location in its OWN transaction. Returns how many failed.

    Deliberately a loop of single sweeps rather than one collecting sweep. The
    inputs of a transaction are public: spending N outputs together proves,
    permanently and without any ring analysis, that those N outputs have one
    owner. In a peel chain those N outputs are the change of the N peels, so
    one tidy sweep would publish the very fact the chain spent N transactions
    and several hours concealing.

    Measured on a chain running current consensus: six change outputs swept
    together produced ONE 6-input transaction; swept separately they produced
    six 1-in/2-out transactions -- the most common shape on the network -- for
    about 0.005 XMR more in total fees against a 0.0024 XMR fee estimate. The
    fee difference is the entire cost of not announcing the link.

    A failure is reported and the remaining sweeps still run: change stranded
    on one hop is bad, but skipping the rest would strand the others too.
    """
    failed = 0
    _outcomes = set()
    for n, (account, change_index, dest_addr, dest_index) in enumerate(jobs, 1):
        label = f"change sweep {n}/{len(jobs)}"
        # THE PROMISE ABOVE IS "the remaining sweeps still run", and it only
        # covered ONE of the two ways a sweep fails.
        #
        # _run_change_sweep returns False when _wait_for_change_settled times
        # out, and that was handled. Its other failure mode is _run_round,
        # which aborts the PROCESS with sys.exit on any create, sign or
        # broadcast failure -- and it is called there with a `finally` but no
        # `except`, so SystemExit propagated straight out of this loop.
        #
        # Driven with four jobs and a round that fails on the second: two
        # _run_round calls made, sweeps 3 and 4 never attempted, SystemExit out
        # of the function. Not "reported and the rest still run".
        #
        # And this loop runs BEFORE the exit (_run_change_sweeps at the top of
        # stage 5, _run_exit_withdrawals ~100 lines later), so one failed sweep
        # took the whole pipeline down with the mixed funds still sitting on
        # the wallet -- the exit never got to withdraw any of them. A stranded
        # change output is the small loss here; the un-run exit is the large
        # one.
        #
        # _run_exit_withdrawals already has exactly this guard, with a comment
        # making the same argument ("one failure must not strand them"). This
        # is that guard, on the loop whose docstring already claimed it.
        try:
            _swept = _run_change_sweep(args, account, change_index, dest_addr,
                                       dest_index, staging_dir, proxy, meta,
                                       label=label, seq=n,
                                       delay_window=delay_window,
                                       outcomes=_outcomes)
        except RelayGateAbort:
            # NOT a failed sweep. Reporting a live Tor leak as "FAILED to
            # create, sign or broadcast" invites a retry, and this loop would
            # then re-run the same gate on every remaining sweep and hand the
            # run on to the exit. Out it goes, with its own message.
            raise
        except SystemExit:
            _outcomes.add("round_failed")
            print(f"  [!] {label}: FAILED to create, sign or broadcast. The "
                  f"change on account {account} / subaddr {change_index} is "
                  f"UNMIXED and still there.\n"
                  f"      Continuing with the remaining sweeps and the exit — "
                  f"stopping here would strand every other output too.")
            failed += 1
            continue
        if not _swept:
            failed += 1
    if _outcomes:
        integrity_log("stage5", "change_sweeps:" + ",".join(sorted(_outcomes)))
    if len(jobs) > 1:
        print(f"  [+] Change swept in {len(jobs) - failed}/{len(jobs)} SEPARATE "
              f"transactions — no single transaction spends more than one of "
              f"them, so none of them are publicly linked to each other.")
    return failed


def _run_change_sweep(args, account, change_index, dest_addr, dest_index,
                      staging_dir, proxy, meta, label="change sweep", seq=0,
                      delay_window=None, outcomes=None):
    """Sweep ONE change location onto a fresh address, leaving nothing behind.

    IT DOES NOT GO "INTO THE MIX", and this said it did -- in the summary line,
    in two operator messages and in the caller. The destination is a subaddress
    of an account created moments earlier (create_fresh_account at the call
    site); it is not in `subs`, so it is not in `mix_targets`, so it is not in
    `fanout_dests`, so it is not in `hop_sources`, and build_dag_adjacency has
    never heard of it. Verified by driving the real selection: the change
    destination appears in none of them.

    So the swept change moves exactly ONCE and then rests.

    It cannot currently do more, and the reason is structural rather than an
    oversight: the DAG plan is BUILT AND SIGNED before this destination exists,
    and the change amount is not known until the distribution has executed and
    paid its fee. A hop out of this address cannot be sized in a pre-signed
    plan. Giving it one would need a second, dynamically-built hop round after
    the sweeps -- a feature, not a correction, and not something to imply in a
    message.

    What the sweep IS worth: the change is the one output of the distribution
    that would otherwise never move at all, sitting on the spending account
    where anyone who identifies that transaction can watch it. One hop to an
    address that appears in no plan is materially better than zero. It is just
    not mixing, and calling it mixing is how an operator comes to believe the
    remainder is as protected as the rest.

    Neither distribution can allocate its input exactly, because the fee is not
    known when the amounts are chosen. A fan-out holds ~FANOUT_SPEND_FRACTION
    back and monerod returns the remainder as change to the spending account's
    subaddress 0; a peel chain does the same at every hop, which is why each
    hop runs in its own account and each gets its own call here. Two separate
    problems follow from leaving that change alone, and both are fixed here.

    OPSEC: the remainder sits on one address for the whole run and is never
    mixed. It is the only output of the fan-out that does not move, which is a
    behavioural tell of exactly the kind this pipeline removed elsewhere (the
    decoy dead-end, the peel hub) -- and it is the run's change address, so the
    tell points at the one output whose identity matters most.

    CORRECTNESS, and arguably the bigger one: that ~10% is the operator's
    money, and leaving it parked means a tenth of the balance was never mixed
    at all while the run reported success. An operator reading "pipeline
    complete" has no reason to suspect a tenth of it stayed behind.

    So the change is swept -- sweep_all, whole balance, ZERO change of its own
    (proven on-chain in tests/real_hop_sweep_testnet.py) -- into a fresh mix
    subaddress, which then hops with everything else.

    This SPENDS one account's subaddress 0, exactly once. That is safe here and
    would not have been before the account rotation: these are per-run
    accounts, so none of them is the wallet's identity address, and one spend
    is not a repeated-spender hub. The wallet's real primary address is still
    spent zero times by the pipeline.

    ONE LOCATION ONLY. This deliberately does not accept several accounts and
    collect them: see _run_change_sweeps for why a collecting sweep is the one
    transaction that would undo a peel chain.

    Returns True if the change was swept (or there was nothing to sweep).
    """
    # OUTCOME KIND, not "which account". A peel chain calls this once per
    # hop, so one chain line per call counted the peels -- and the account
    # number is the grouping report_holdings refuses to write to disk. The
    # caller collapses these to one line; every detail below still reaches
    # the operator on the terminal. `outcomes is None` keeps this callable
    # on its own, which the tests do.
    def _note(kind):
        if outcomes is None:
            integrity_log("stage5", f"change_sweep:{kind}")
        else:
            outcomes.add(kind)

    # Wait for the change to actually exist and unlock -- it is an output of
    # the distribution transaction, so it is locked for the usual ~10 blocks.
    if not _wait_for_change_settled(args, account, change_index, proxy, label)[0]:
        _note("skipped_not_confirmed")
        print(f"  [!] The change on account {account} did not confirm in time, so "
              f"it was NOT swept to a fresh address. It is safe on account {account}, "
              f"subaddress {change_index} — but it is UNMIXED, and it is an "
              f"output that never moved. Sweep it by hand.")
        return False

    sweep_tx = {
        "src": f"change(acct {account}/sub {change_index})",
        "src_index": change_index,
        # Each sweep names its OWN account: with a peel chain these are all
        # different, and meta carries only the mix account.
        "account_index": account,
        "dst": dest_addr,
        "sweep": True,
        "delay": hop_delay(delay_window),
    }
    # THE OPERATOR'S --output DIRECTORY, NOT THE CURRENT ONE. This was
    # `Path(staging_dir).parent`, and staging_dir is the bare string
    # "tx_staging", so its parent is "." -- the shell's working directory.
    # Every other plan this run writes goes to args.output, which secure_mkdir
    # creates 0700 and which _stage5_cleanup erases; these two did not.
    #
    # These are the two worst plans to misplace. The exit plan names the
    # operator's FINAL destination -- the one address the whole pipeline exists
    # to keep unlinked from the public ThorChain memo -- and the change-sweep
    # plan names where each carrier's change goes. atomic_write_json writes
    # 0600, so the CONTENTS were not readable by other accounts; the filenames
    # were, and "unsigned_exit_*.json" in a directory dates a withdrawal.
    # Worse, they sat outside the directory the cleanup erases, so a run that
    # tidied up after itself left exactly these behind.
    # ENSURED, not assumed. A real run created it in stage 4, but crashing
    # HERE -- after the mix has run and the gates have passed, one step before
    # the money moves -- is the worst place in the pipeline to discover a
    # missing directory.
    _outdir = Path(args.output)
    secure_mkdir(_outdir, narrow_existing=False)
    path = _outdir / f"unsigned_changesweep_{secure_hex(6)}.json"
    atomic_write_json({"meta": meta, "txs": [sweep_tx]}, path)
    stage = f"{staging_dir}/changesweep{seq}" if seq else f"{staging_dir}/changesweep"
    try:
        # INSIDE the try, so the `finally` still erases this plan -- it carries
        # the change destination -- when a gate stops the run.
        relay_gates(args, proxy, f"stage5_changesweep_{seq or 1}")
        _run_round(args, path, stage, label.capitalize())
        # VERIFY, do not assert. This printed "nothing is parked on the change
        # address" unconditionally -- a claim the code never checked, and one
        # that was false whenever the sweep ran while some change was still
        # locked (sweep_all can only spend unlocked outputs). If something is
        # still there, the operator needs to know, because it is the one output
        # of the distribution that never moves.
        _left = _change_residue(args, account, change_index)
        if _left is None:
            _note("swept_unverified")
            print("  [+] The change sweep was relayed, but the balance could not "
                  "be re-read to confirm the address is now empty. Check "
                  f"account {account} / subaddr {change_index} yourself.")
        elif _left > 0:
            _note("swept_residual")
            print(f"  [!] The change sweep relayed, but "
                  f"{Decimal(_left) / Decimal(10 ** 12)} XMR is STILL on account "
                  f"{account} / subaddr {change_index} — change that had not "
                  f"unlocked when the sweep was built, so sweep_all could not "
                  f"take it. It is safe, but it is UNMIXED and it is the one "
                  f"output that never moves. Sweep it by hand once it unlocks.")
        else:
            _note("swept_into_mix")
            print(f"  [+] The change on account {account} was swept to a fresh "
                  f"address (it moves once and rests there -- it does NOT go "
                  f"through the hop rounds; see _run_change_sweep); "
                  f"verified nothing is parked on that change address.")
        return True
    finally:
        secure_delete_or_warn(path, "the change-sweep plan (its destination)")
        _cs = Path(stage)
        if _cs.is_dir() and not secure_delete_tree(_cs):
            print(f"  [!] Could not securely wipe {stage}; remove it manually.")


def _exit_account_list(addr_index, change_accounts, bal_account) -> list:
    """Every account this run could be holding money in, for the exit to empty.

    Three sources, and the third is the one that is easy to miss:
      * addr_index -- every mix subaddress, the veil carrier and each change
        sweep destination.
      * change_accounts -- the per-hop accounts a peel chain leaves change on.
      * bal_account -- where a FAN-OUT's change lands. If its change sweep
        fails, that value sits there and an exit that did not look would leave
        it behind silently, which is the same defect as a wipe that misses a
        file.

    Duplicates cost nothing: _funded_subaddresses sorts a set and skips
    anything with no balance.
    """
    return ([a for a, _ in addr_index.values()]
            + list(change_accounts)
            + [bal_account])


def _exit_hold_list(args, addr_index, entry_addr) -> list:
    """The outputs the exit must refuse to withdraw: ENTRY, and only ENTRY.

    ENTRY is spent once -- by the veil, or by the distribution under
    --no-entry-veil -- and then abandoned. A balance on it when the exit runs
    therefore arrived AFTERWARDS: under --split N, a swap chunk that settled
    late. It has been through none of the mixing, and the transaction that
    funded it is named by a public ThorChain memo in a Bitcoin OP_RETURN, so
    one sweep to --exit-to publishes swap -> destination in a single hop. That
    is the link the entire pipeline exists to break, and no later transaction
    retracts it.

    HELD IN EVERY MODE, including --no-entry-veil. That flag was a carve-out
    here, on the reasoning that an operator who accepts ENTRY being spent in
    the open has accepted this too. They have not: --no-entry-veil publishes
    ENTRY -> the mix, which is a graph an analyst still has to unpick.
    Sweeping a late chunk publishes ENTRY -> YOUR DESTINATION, which is not a
    graph, it is the answer. Two different links, and only one of them was
    consented to. The carve-out also cost nothing to remove: under
    --no-entry-veil the distribution's change goes to the spending account's
    subaddress 0, not to ENTRY, so ENTRY is empty on the ordinary path and the
    hold fires only on the late-chunk case it is written for.

    (An earlier version of this note said the DAG could also pay a MIXED
    output back here, and blamed `mix_targets` for containing ENTRY.
    mix_targets never contained ENTRY -- build_dag_adjacency did, and
    assign_hop_destinations prefers that adjacency over mix_targets. It is
    fixed there now, so a held output is a late swap chunk and nothing else.)
    """
    _addrs = ([entry_addr] if isinstance(entry_addr, str)
              else list(entry_addr or ()))
    # EVERY entry address, because --split N makes N of them and each one is
    # named by its own public swap settlement. Holding only the first would
    # sweep the others straight to --exit-to.
    return [addr_index[a] for a in _addrs if a in addr_index]


def _landing_targets(addr_index, dag_plan, change_sweep_jobs) -> tuple:
    """(dag_dst_index, sweep_targets) -- where the last rounds PAY INTO.

    The exit may not enumerate what it will withdraw until the round that
    funded it has landed (see the landing gate in _stage5_run), and "landed"
    can only be checked against the addresses that were paid. Those are known
    here, in stage 4, where both the plan and addr_index exist -- _stage5_run
    has neither.

    A MAP rather than a list, because _stage5_run may DROP hops before it runs
    the round: a peel chain that stopped part-way never funded the later
    sources, so their sweeps cannot be built. It filters the plan and then has
    to name the destinations of what SURVIVED, which a positional list cannot
    answer once entries have been removed. Keyed by the destination address the
    plan entry already carries.

    A change sweep carries its destination index but not the ACCOUNT it was
    minted in, which build_change_sweep_jobs put in addr_index and nowhere
    else -- so those are resolved here too, and stay a list because nothing
    filters them afterwards.

    Anything the index cannot resolve is left out rather than guessed: a wrong
    pair would make the gate poll an address nobody paid, and the exit would
    then wait out the full hour before running. What is left out costs the gate
    a little coverage, which the straggler pass in the exit backstops.
    """
    _dag = {}
    for _e in (dag_plan or ()):
        _dst = _e.get("dst")
        _pair = addr_index.get(_dst)
        if _dst and _pair:
            _dag[_dst] = (int(_pair[0]), int(_pair[1]))
    _sweep = []
    for _j in (change_sweep_jobs or ()):
        _pair = addr_index.get(_j[2])
        if _pair:
            _sweep.append((int(_pair[0]), int(_pair[1])))
    return _dag, _sweep


def _funded_subaddresses(rpc, accounts) -> tuple:
    """Every (account, subaddress, atomic_balance) in `accounts` holding money.

    The exit spends per SUBADDRESS, not per account, because that is the unit a
    Monero sweep takes and because it keeps the guarantee the whole run is
    built on: one transaction never spends two of these outputs. Reading the
    per_subaddress breakdown (rather than assuming subaddress 1) is what makes
    it find swept change and any dust the operator does not know about -- an
    exit that silently leaves money behind is the same defect as a wipe that
    silently leaves files behind.
    Returns (found, unreadable). THE SECOND HALF IS THE POINT.

    An account whose balance could not be read was `continue`d past -- silently
    -- so a single transient wallet-rpc error during the exit dropped every
    output on that account out of the withdrawal list. The exit then announced
    "withdrawing N output(s)" with N too small and finished reporting success,
    while the money stayed on the wallet with nothing said about it.

    That is the failure this function's own docstring names: "an exit that
    silently leaves money behind is the same defect as a wipe that silently
    leaves files behind". The wipe side of that comparison already fails loudly
    (secure_delete_or_warn, wipe_covers); this side did not.

    Read errors are retried first, because the overwhelmingly likely cause is a
    busy wallet-rpc mid-refresh rather than a real problem -- and a retry is
    free next to leaving funds behind. What survives the retries is returned so
    the caller can report it; nothing here decides what an unreadable account
    means, the same rule the rest of this file follows.
    """
    # REFRESH FIRST, like every other balance reader in this file.
    #
    # _wait_for_fanout_confirm, _wait_for_carrier, _wait_for_change_settled and
    # _change_residue all open with `refresh`, and the first of them says why:
    # "without it a wallet-rpc that isn't auto-refreshing never sees the
    # just-broadcast outputs". This function -- the one that decides what the
    # exit withdraws AT ALL -- was the only one that did not, and it runs
    # SECONDS after the last round relayed.
    #
    # monero-wallet-rpc only learns about a txpool payment to itself when it
    # scans the pool, which happens on refresh; its server auto-refreshes on a
    # 20-second period. commit_tx marks the SOURCE spent immediately, so the
    # instant a round returns the swept subaddresses read 0 while their
    # destinations read 0 too -- the value is in the pool and simply invisible.
    # An output missing from this list is never withdrawn and never mentioned.
    #
    # Measured by driving this function and the withdrawal loop against a
    # wallet modelled on those rules (scan lag uniform 0-20s, submit-to-
    # enumerate gap uniform 5-15s): the last hop was missed in 146/300 runs at
    # --wallets 10 and 156/300 at --wallets 20 -- and the caller printed
    # "EXIT COMPLETE ... Nothing left on this run's accounts" every time.
    #
    # The refresh is necessary and NOT sufficient: it closes the scan lag, not
    # the case where the daemon has not yet handed the pool tx over. The
    # landing gate in _stage5_run and the straggler pass in the caller cover
    # that; this is the cheap half.
    try:
        rpc.raw_request("refresh", {})
    except Exception as e:                                   # noqa: BLE001
        # Not fatal -- a stale read is still a read, and the retries below may
        # succeed. Logged because everything after it is then a snapshot of
        # what the wallet knew BEFORE the last round, and that is the exact
        # condition this call exists to remove.
        integrity_log("exit", f"enumerate_refresh_failed:{type(e).__name__}")
    found, unreadable = [], []
    for acct in sorted(set(int(a) for a in accounts)):
        bal = None
        for _try in range(3):
            if shutdown_requested():
                break
            try:
                bal = rpc.raw_request("get_balance",
                                      {"account_index": acct,
                                       "all_accounts": False}) or {}
                break
            except Exception:                                # noqa: BLE001
                bal = None
                if _try < 2:
                    time.sleep(2 * (_try + 1))
        if bal is None:
            unreadable.append(acct)
            continue
        for sub in bal.get("per_subaddress", []) or []:
            amt = int(sub.get("balance", 0) or 0)
            if amt > 0:
                found.append((acct, int(sub.get("address_index", 0)), amt))
    return found, unreadable


def _run_exit_withdrawals(args, accounts, dests, staging_dir, proxy, meta,
                          delay_window=None, hold=(), entry_pairs=(),
                          remainder_pairs=(), fee_pairs=()) -> tuple:
    """ACTUALLY SPEND THE MIXED FUNDS OUT.
    Returns (relayed, failed, skipped, held, unclean), where `held` is a
    {"entry": n, "change": n, "remainder": n, "usagefee": n} breakdown -- NOT a
    count. The caller words its report from it: the four are different
    addresses with different reasons and different remedies. Test the numbers,
    never the dict: a populated dict is always truthy, and `not held` in the
    caller silenced the clean-exit message entirely.

    `remainder_pairs` is the third kind, and it is the largest: the carrier a
    PEELING CHAIN stopped on holds everything the chain had left to distribute
    (see peel_stuck_carrier). Calling that "a distribution CHANGE address"
    would print the change sweep's remedy -- "The change sweep would have
    moved it once, to a fresh address" -- about a mode that has no change
    sweeps at all.

    `fee_pairs` is the fourth and the only one that should never fire: the
    usage fee is minted on an account plan_usage_fee keeps out of addr_index
    entirely, so the exit does not enumerate it and there is nothing to hold.
    Named anyway, because that safety is an OMISSION -- one line added to
    addr_index anywhere would put the operator's own cut in exit_accounts and
    sweep it to --exit-to in silence. With the pair here the same mistake
    prints an address and a reason instead. It gets its own kind rather than
    riding on `entry_pairs` because every one of ENTRY's remedies is wrong for
    it: no public memo names it, and it is not waiting to be mixed.

    THIS IS THE EXIT, and it moves real value. Everything before it only
    rearranges coins inside one wallet; until this runs, the operator still
    holds every output the run created and nothing has left. The stage that
    used to sit here computed a fiat valuation and printed it -- useful, but it
    moved nothing, so the pipeline's last step was a report rather than an exit.

    ONE TRANSACTION PER (ACCOUNT, SUBADDRESS), never a collecting sweep. A
    transaction's inputs are public: spending N of these outputs together is
    permanent proof they share an owner, and they are exactly the outputs the
    run spent hours separating. A Monero transaction cannot spend across
    accounts, so the wallet enforces most of this for us -- but two subaddresses
    inside one account COULD be merged, and this refuses to.

    Destinations are consumed round-robin over a SHUFFLED list, and the outputs
    are visited in shuffled order, so neither the order money leaves nor the
    pairing of output to destination follows the order the run created them.

    Each withdrawal waits for its output to settle first: sweep_all can only
    spend UNLOCKED outputs, so sweeping early sweeps less than everything and
    reports success (proven on a real chain -- see _wait_for_change_settled).

    `hold` is the (account, index) pairs this must NOT withdraw, and it exists
    for exactly one output: ENTRY. The veil swept ENTRY once, hours ago, so a
    balance there now arrived afterwards -- typically a swap chunk that settled
    late (see _exit_hold_list for the other, still-open way value gets there).
    Sweeping it would be a single transaction from the address the ThorChain
    memo names in public to the operator's own destination: the one link the
    entire pipeline exists to break, re-created in its final step. It is left
    where it is and reported instead, because "your money is on a known
    address" is a problem the operator can fix with another run and "your
    destination is now publicly tied to your swap" is not fixable at all.
    """
    targets, _unreadable = _funded_subaddresses(
        connect_rpc(args.rpc_primary,
                    proxy_url=getattr(args, "tor_proxy", "")),
        accounts)
    # ZERO FUNDED OUTPUTS, ACROSS EVERY ACCOUNT OF THE RUN, IS ANOMALOUS.
    #
    # This function is only reached because --exit-to was given and a
    # distribution has just been relayed, so these accounts should be holding
    # the run's whole balance. Reading nothing is far more likely to mean the
    # wallet has not caught up than that the money is not there.
    #
    # It cannot be rescued further down either: the straggler pass at the
    # bottom is only reached when there was something to withdraw in the first
    # place -- the empty case returns before it. So the second look has to be
    # HERE, and it has to WAIT. A re-read taken in the same millisecond as the
    # first re-reads the same wallet state and only looks diligent; the refresh
    # inside _funded_subaddresses closes the wallet's scan lag but cannot make
    # the daemon hand over a transaction it has not relayed yet.
    #
    # Two extra looks, one poll interval apart. Against a run that has been
    # going for hours that is a minute, and against accounts that really are
    # empty it is a minute spent proving it instead of asserting it.
    for _look in range(2):
        if targets or shutdown_requested():
            break
        integrity_log("exit", "nothing_visible_retrying")
        print(f"  [!] EXIT: no funded output is visible on any of this run's "
              f"accounts. That should not happen straight after a "
              f"distribution, so waiting {FANOUT_CONFIRM_POLL}s and looking "
              f"again rather than reporting an empty wallet.")
        time.sleep(FANOUT_CONFIRM_POLL)
        targets, _unreadable = _funded_subaddresses(
            connect_rpc(args.rpc_primary,
                        proxy_url=getattr(args, "tor_proxy", "")),
            accounts)
    # AN OUTPUT SMALLER THAN ITS OWN SWEEP FEE CANNOT BE WITHDRAWN AT ALL, and
    # trying is not a failure to report as one.
    #
    # Measured: a peel whose fee moved 1200 piconero between the signer's two
    # build passes left a 0.0000012 XMR change output. _funded_subaddresses
    # returned it (balance > 0), _wait_for_change_settled reported it settled
    # (it was: total == unlocked), and sweep_all then answered "No unlocked
    # balance in the specified subaddress(es)" -- monerod's way of saying no
    # output there is worth more than the fee to spend it. The exit counted
    # that as a FAILED withdrawal and the run was reported incomplete over
    # a millionth of an XMR.
    #
    # The fee estimate comes from the plan's own meta, so the threshold is the
    # number this run actually priced its transactions with rather than a
    # constant that could drift from it. Absent, nothing is filtered -- an
    # unknown threshold must not silently drop an output.
    _dust = []
    try:
        _sweep_cost = Decimal(str((meta or {}).get("fee_per_round") or 0))
    except (TypeError, ValueError, InvalidOperation):        # noqa: BLE001
        _sweep_cost = Decimal(0)
    # -1, so "no threshold known" filters nothing. Named unconditionally
    # because the straggler pass at the bottom applies the same floor, and a
    # name that only exists on one branch would be a NameError on the other.
    _floor = int(_sweep_cost * Decimal(10 ** 12)) if _sweep_cost > 0 else -1
    if _sweep_cost > 0:
        _dust = [t for t in targets if t[2] <= _floor]
        if _dust:
            targets = [t for t in targets if t not in _dust]
            integrity_log("exit", f"dust_below_sweep_fee:{len(_dust)}")
            _dtot = Decimal(sum(t[2] for t in _dust)) / Decimal(10 ** 12)
            print(f"  [!] EXIT: {len(_dust)} output(s) totalling {_dtot} XMR "
                  f"are smaller than the {_sweep_cost} XMR it would cost to "
                  f"move them, so they were NOT withdrawn.")
            print(f"      Sweeping one costs more than it is worth and "
                  f"monerod refuses it outright. This is not money you can "
                  f"recover on its own; it stays where it is.")
    if _unreadable:
        # LOUD, AND COUNTED AS A FAILURE. An account this could not read may
        # hold anything, so the run must not be reported as a complete exit --
        # see the `failed` term in the return below.
        integrity_log("exit", f"accounts_unreadable:{len(_unreadable)}")
        print(f"  [!] EXIT: {len(_unreadable)} of "
              f"{len(set(int(a) for a in accounts))} account(s) could not be "
              f"read after three tries, so anything on them was NOT "
              f"withdrawn.")
        print(f"      Accounts: {', '.join(str(a) for a in _unreadable)}. "
              f"Check each one and withdraw it yourself; the wallet-rpc was "
              f"probably busy, not broken. This run's exit is NOT complete.")
    _hold_set = {(int(a), int(i)) for a, i in (hold or ())}
    held = [t for t in targets if (t[0], t[1]) in _hold_set]
    # WHICH KIND, not just how many. The caller's report used to assert ENTRY
    # for any held output, so a run that withheld only a distribution CHANGE
    # sent the operator to look at an address the memo does not name, with the
    # wrong remedy attached. Counts only -- the per-output detail stays on the
    # terminal below, because the NUMBER of outputs is itself the on-chain
    # search key the entry veil exists to hide.
    _entry_set = {(int(_a), int(_i)) for _a, _i in (entry_pairs or ())}
    _remainder_set = {(int(_a), int(_i)) for _a, _i in (remainder_pairs or ())}
    _fee_set = {(int(_a), int(_i)) for _a, _i in (fee_pairs or ())}

    def _held_kind(pair):
        """Which of the four a held output is. ENTRY wins a tie: it is the
        only one whose address a public memo names, so if a pair were somehow
        in two sets the strictest description is the right one. The usage fee
        is tested before CHANGE and after the other two for the same reason --
        it is the mildest of the four, so anything it collides with outranks
        it, but a fee address is never a distribution's change."""
        if pair in _entry_set:
            return "entry"
        if pair in _remainder_set:
            return "remainder"
        if pair in _fee_set:
            return "usagefee"
        return "change"

    #: What each kind IS, in the operator's words. One place, because the
    #: initial enumeration and the straggler passes both print it and they said
    #: different things when only the first was updated.
    _HELD_WHAT = {"entry": "the swap ENTRY",
                  "remainder": "the peel chain's UNDISTRIBUTED balance",
                  "usagefee": "YOUR OWN USAGE FEE",
                  "change": "a distribution CHANGE"}
    _held_kinds = {"entry": 0, "change": 0, "remainder": 0, "usagefee": 0}
    # EVERY HELD ADDRESS THIS HAS ALREADY NAMED, so the straggler passes below
    # cannot report one twice. A held output is never withdrawn -- that is what
    # holding it means -- so it is STILL FUNDED on every later re-read, and the
    # only thing keeping the second pass quiet was the `held` list, which the
    # first pass never adds to. Reproduced: one late chunk on ENTRY plus one
    # ordinary late output (which is what keeps the loop alive for a second
    # pass) printed the "arrived on the swap ENTRY address" paragraph twice and
    # returned held["entry"] == 2 -- so the caller's report said "2 entry
    # addresses" about one address, and sent the operator looking for a second
    # one that does not exist.
    _named_held = {(t[0], t[1]) for t in held}
    if held:
        targets = [t for t in targets if t not in held]
        # Once, outside the loop, and naming nothing: one line per held output
        # would count them, and the account/subaddress pair is the grouping
        # report_holdings refuses to put on disk. The operator gets both, in
        # full, on the terminal below.
        integrity_log("exit", "withheld_unmixed")
        for _ha, _hi, _hamt in held:
            # NOT ALWAYS "ENTRY". The hold also covers every change location
            # now, because a distribution returns its remainder to subaddress 0
            # of the spending account and the exit was sweeping that out.
            # Calling both cases ENTRY sends the operator to look at an address
            # that has nothing on it, and describes the wrong risk.
            # EVERY entry pair. --split N gives the run N of them
            # (create_entry_set) and each is named by its own public swap
            # settlement, so testing only the first would describe the other
            # chunks as "a distribution CHANGE address" -- the wrong risk and
            # the wrong remedy, on the outputs where getting it wrong costs
            # the most.
            _kind = _held_kind((_ha, _hi))
            _is_entry = _kind == "entry"
            _held_kinds[_kind] += 1
            print(f"  [!] EXIT: {Decimal(_hamt) / Decimal(10 ** 12)} XMR is on "
                  f"{_HELD_WHAT[_kind]}"
                  f" address (account {_ha} / subaddr {_hi}) and was NOT "
                  f"withdrawn.")
            if _kind == "remainder":
                print("      The peeling chain stopped before it spent this. "
                      "It went through NO fan-out and NO hop round — it is the "
                      "run's whole undistributed balance, sitting where the "
                      "chain left it, and it can be most of what you swapped. "
                      "Sending it to your exit destination would put unmixed "
                      "value on the same address as the mixed outputs, which "
                      "tells whoever watches that address that all of it is "
                      "one owner's.")
            elif _kind == "usagefee":
                # THIS BRANCH IS A BUG REPORT, not an advisory. The fee account
                # is not in addr_index, so _exit_account_list cannot name it and
                # _funded_subaddresses never reads it -- reaching here means
                # something put it back. Say that, because the operator's next
                # question is why their own money is being described as
                # withheld, and the honest answer is that the exit was one
                # omission away from paying it to --exit-to.
                print("      This is the usage fee this run took for you, and "
                      "the "
                      "exit is not supposed to be able to see it at all — it "
                      "was minted on an account deliberately left out of the "
                      "run's index. Seeing it here means something added it "
                      "back, and the hold is the only reason it did not go to "
                      "your exit destination.")
                print("      Sending it there would have been the worst of the "
                      "four: it never went through a veil or a hop round, so "
                      "it is unmixed value landing beside the mixed outputs — "
                      "and its size is a fixed fraction of the deposit, so "
                      "anyone watching that destination could divide by the "
                      "rate and read what was deposited.")
            elif _is_entry:
                print("      It landed after the run had planned — usually a "
                      "swap chunk that settled late. The swap memo names that "
                      "address in public, so sending it to your exit "
                      "destination would tie the two together in one hop — "
                      "which is what the rest of this run spent hours "
                      "preventing.")
            else:
                print("      This is the remainder the distribution could not "
                      "allocate. The change sweep would have moved it once, to "
                      "a fresh address — it never goes through the hop rounds, "
                      "so it is UNMIXED either way — and it did not even get "
                      "that far. It is an output of the transaction that spent "
                      "your swapped funds, so withdrawing it publishes that "
                      "link in one hop.")
            if _kind == "usagefee":
                # NOT the mix-it-again remedy. The other three are value that
                # was meant to go through the pipeline and did not; this is
                # value that was never meant to. Telling the operator to feed
                # their own fee back through a run would spend the fee on
                # fees, and the fresh-receive-wallet hop is pointless for an
                # output no public memo names.
                print("      It is safe where it is, and it is not waiting on "
                      "anything: it is yours, on an account of your own "
                      "wallet, and it was never meant to be mixed. Note the "
                      "account and subaddress above — this output is not in "
                      "the holdings report either, and nothing else writes it "
                      "down for you. Spend it on its own, in its own "
                      "transaction, never together with another run's fee.")
            else:
                print("      It is safe where it is. To mix it: mint a fresh "
                      "receive wallet (create_receive_wallet), send this "
                      "balance to it as ONE ordinary transfer — that hop is "
                      "the entry veil done by hand, and its destination is in "
                      "no public memo — then run this again with "
                      "--receive-wallet on that bundle. Note the account and "
                      "subaddress above; nothing writes them down for you.")
        # ONE BUNDLE EACH, said ONCE, after the per-output advice above.
        #
        # That advice is printed inside the loop, so an operator holding two
        # late swap chunks is told twice to "mint a fresh receive wallet" and
        # the natural reading is to mint ONE and send both balances to it.
        # That single transaction spends two ENTRY outputs, and every swap's
        # settlement is public -- so it hands an analyst the intersection of
        # two known candidate sets and identifies the transaction outright.
        # It is the exact convergence --split exists to prevent, arrived at by
        # following the tool's own instructions.
        #
        # report_holdings says "SPEND THEM ONE ACCOUNT AT A TIME", but it runs
        # only on a COMPLETE run -- report_completion skips it whenever
        # `incomplete` is non-empty -- and a run can reach the exit, hold two
        # entry outputs, and still finish incomplete. Then this is the only
        # place the warning could come from, and it was not here.
        if _held_kinds["entry"] > 1:
            print(f"      ONE FRESH BUNDLE PER ADDRESS, and do NOT send two of "
                  f"them to the same one. The {_held_kinds['entry']} ENTRY "
                  f"outputs above are different swap chunks, and each of those "
                  f"swaps settled in public: a single transaction spending two "
                  f"of them proves they share an owner and lets an analyst "
                  f"intersect two known candidate sets — the convergence this "
                  f"run kept them in separate accounts to prevent. Recover "
                  f"them one at a time, as separate runs.")
    if not targets:
        if held:
            # NAME WHAT IS ACTUALLY HELD. This said "the unmixed one on ENTRY"
            # for every case, so a run whose only funded output was a
            # distribution change -- or a peel chain's undistributed
            # remainder -- sent the operator to look at an address the swap
            # memo does not name, with the wrong remedy attached. Same defect
            # the per-output lines above were fixed for; this line was left
            # asserting the old single kind.
            _only = [_k for _k in ("entry", "remainder", "usagefee", "change")
                     if _held_kinds[_k]]
            print(f"  [!] EXIT: nothing was withdrawn — the only funded "
                  f"output(s) are the unmixed ones on "
                  + " and ".join(f"{_HELD_WHAT[_k]}" for _k in _only)
                  + " described above.")
            return (0, len(_unreadable), 0, dict(_held_kinds), 0)
        print("  [!] EXIT: no funded output was found on this run's accounts, "
              "so nothing was withdrawn. If you expected funds here, do NOT "
              "assume they are gone — check the wallet before re-running.")
        integrity_log("exit", "no_funded_outputs")
        return (0, len(_unreadable), 0,
                {"entry": 0, "change": 0, "remainder": 0}, 0)

    # `secrets`, the module-level import -- NOT `_secrets`, which is a local
    # alias created inside main() and passed around as a parameter. Writing the
    # local's name here parsed fine and would have raised NameError the first
    # time a withdrawal ran. Caught by the pyflakes gate added earlier in this
    # audit, which is the whole reason that gate exists.
    _rng = secrets.SystemRandom()
    _rng.shuffle(targets)
    dest_pool = list(dests)
    _rng.shuffle(dest_pool)

    total = len(targets)
    print(f"  [*] === EXIT: withdrawing {total} output(s) in {total} SEPARATE "
          f"transactions to {len(dest_pool)} destination(s) ===")
    # SAY IT AGAIN HERE, with the real numbers rather than the estimate the
    # early warning had. Too late to fix on this run -- the point is that the
    # operator reads it while the arrivals are happening and knows to spread
    # the next one, instead of discovering the shape later on-chain.
    if total > len(dest_pool):
        integrity_log("exit", "outputs_exceed_destinations")
        print(f"  [!] {total} outputs into {len(dest_pool)} address(es): "
              f"~{-(-total // len(dest_pool))} arrivals on each. Whoever "
              f"watches one sees that group and knows it is one person's — "
              f"the separation this run spent hours building, re-joined "
              f"off-chain at the last step. Next run: repeat --exit-to.")
    integrity_log("exit", f"withdraw_start:{total}_outputs:{len(dest_pool)}_dests")

    # An unreadable account starts the failure count, so a run that could not
    # even LOOK at part of the wallet cannot be reported as a clean exit.
    relayed = skipped = unclean = 0
    failed = len(_unreadable)
    # ONE CHAIN LINE PER OUTCOME KIND, not one per output.
    #
    # Redacting the numbers out of `withdrawn:<acct>/<sub>` is not enough
    # here: eleven redacted lines still count to eleven, and the number of
    # outputs the distribution created is the on-chain search key the entry
    # veil exists to hide (see build_entry_veil -- an analyst picks the
    # transaction out of the ring candidates by its output count). This loop
    # visits every output the run holds, so its line count WAS that number.
    #
    # A set, so the chain still records that a residual or a failure
    # happened -- which is what a later reader needs -- without recording
    # how many, or to which account. Every per-output detail is printed to
    # the terminal below, where it reaches the operator and stops.
    _outcomes = set()
    # EVERY (acct, sub) THIS HAS ALREADY TRIED, so the straggler pass below
    # cannot re-sweep an address the main loop already emptied or already
    # reported as failed.
    _attempted = set()
    _done = 0

    def _withdraw_one(acct, sub, label, dst):
        """Withdraw ONE subaddress in ONE transaction.

        Extracted from the loop so the straggler pass can reuse it verbatim.
        A second copy of this body is the last thing this function needs: it
        carries the settle wait, the Tor gates, the re-raise that distinguishes
        a leak from a failed round, and the finally that erases the operator's
        --exit-to destination from disk.
        """
        nonlocal relayed, failed, unclean
        # Settle first, for the reason sweep_all makes unavoidable.
        if not _wait_for_change_settled(args, acct, sub, proxy, label)[0]:
            _outcomes.add("unsettled")
            print(f"  [!] {label}: account {acct} / subaddr {sub} did not settle "
                  f"in time, so it was NOT withdrawn. It is safe where it is.")
            failed += 1
            return
        tx = {
            "src": f"exit(acct {acct}/sub {sub})",
            "src_index": sub,
            "account_index": acct,
            "dst": dst,
            "sweep": True,
            "delay": hop_delay(delay_window),
        }
        # See _run_change_sweep for why this is args.output and not
        # Path(staging_dir).parent, which resolved to the shell's cwd.
        _outdir = Path(args.output)
        secure_mkdir(_outdir, narrow_existing=False)
        path = _outdir / f"unsigned_exit_{secure_hex(6)}.json"
        atomic_write_json({"meta": meta, "txs": [tx]}, path)
        # "3/10" -> "3_10". A slash would make the staging path a directory
        # deeper than intended and put a "/" in the Tor gate's stage name.
        _tok = label.split()[-1].replace("/", "_")
        stage = f"{staging_dir}/exit{_tok}"
        # A TOR FAILURE IS NOT A WITHDRAWAL FAILURE, and the except below
        # cannot tell them apart on its own.
        #
        # newnym(required=True) and tor_recheck() both report by sys.exit --
        # tor_recheck's is "[!] Tor leak detected during {stage} - aborting."
        # -- and Python only prints that when it reaches the top level. Sitting
        # inside this try, they were caught by the `except SystemExit` written
        # for a failed ROUND: the message was discarded, replaced by the loop's
        # generic per-output line, and the loop moved on to the next output and
        # re-ran the same failing gate.
        #
        # Driven with tor_recheck's real leak behaviour and three funded
        # outputs: the operator got three "FAILED. Account N / subaddr M was
        # NOT withdrawn and its funds are still on this wallet" lines, and the
        # words "Tor" and "leak" appeared nowhere in the output. That reads as
        # a wallet or daemon problem and invites a retry, which is the one
        # response a live deanonymising leak must not get.
        #
        # So the gates are tracked separately and their abort is RE-RAISED,
        # carrying its own message. Re-raising still runs the `finally` below,
        # so the exit plan -- which holds --exit-to -- is still wiped.
        try:
            relay_gates(args, proxy, f"exit_{_tok}")
            _run_round(args, path, stage, label.capitalize())
            _left = _change_residue(args, acct, sub)
            if _left is None:
                _outcomes.add("relayed_unverified")
                unclean += 1
                print(f"  [+] {label}: relayed, but the balance could not be "
                      f"re-read to confirm account {acct} / subaddr {sub} is "
                      f"empty. Check it yourself.")
            elif _left > 0:
                _outcomes.add("relayed_residual")
                unclean += 1
                print(f"  [!] {label}: relayed, but "
                      f"{Decimal(_left) / Decimal(10 ** 12)} XMR is STILL on "
                      f"account {acct} / subaddr {sub} — it had not unlocked "
                      f"when the sweep was built. Withdraw it once it unlocks.")
            else:
                _outcomes.add("emptied")
                print(f"  [+] {label}: account {acct} / subaddr {sub} emptied.")
            relayed += 1
        except RelayGateAbort:
            # THE TOR GATES ABOVE ARE NOT ROUNDS. A gate abort is a
            # fail-closed safety stop about the network, it carries its own
            # message, and continuing the loop would re-run the same gate on
            # every remaining output. `finally` still wipes the plan.
            #
            # A distinct exception type rather than the local flag this used to
            # keep: the flag could not travel to the change-sweep loop, which
            # has the same shape and the same catch. See RelayGateAbort.
            raise
        except SystemExit:
            # _run_round aborts the PROCESS on a failed round. An exit is a
            # loop over independent transactions and the rest are still
            # withdrawable, so one failure must not strand them -- and it must
            # not be silent either.
            _outcomes.add("failed")
            print(f"  [!] {label}: FAILED. Account {acct} / subaddr {sub} was "
                  f"NOT withdrawn and its funds are still on this wallet.")
            failed += 1
        finally:
            secure_delete_or_warn(path, "the exit plan (YOUR --exit-to destination)")
            _es = Path(stage)
            if _es.is_dir() and not secure_delete_tree(_es):
                print(f"  [!] Could not securely wipe {stage}; remove it manually.")

    for acct, sub, amt in targets:
        if shutdown_requested():
            _outcomes.add("interrupted")
            skipped = total - _done
            print(f"  [!] EXIT interrupted: {relayed} withdrawn, {skipped} NOT "
                  f"sent. The remainder is still on this wallet.")
            break
        _done += 1
        _attempted.add((acct, sub))
        _withdraw_one(acct, sub, f"exit {_done}/{total}",
                      dest_pool[(_done - 1) % len(dest_pool)])

    # -- STRAGGLERS: read the wallet again, because the first read was a
    #    snapshot and this loop has been running for hours.
    #
    # Two things put value on an account after the enumeration at the top:
    #
    #   * an output the wallet had not scanned yet when the exit started. The
    #     landing gate in _stage5_run closes most of that window, but the gate
    #     can time out, and a --no-exit-to caller does not run it at all;
    #   * an output that arrived DURING this loop -- a late swap chunk, or a
    #     hop whose confirmation landed while an earlier withdrawal was
    #     serving its --hop-delay, which can be hours.
    #
    # Without this the run's last word on those was "EXIT COMPLETE ... Nothing
    # left on this run's accounts", asserted from a snapshot taken before they
    # existed. Re-reading costs one RPC per account and turns a false claim
    # into either a withdrawal or a named residue.
    #
    # Bounded, and _attempted makes it monotone: nothing already tried is
    # retried, so each pass strictly shrinks what is left to find. Two passes
    # rather than "until dry" because an address that keeps being funded is a
    # live incoming stream, not a straggler, and this must terminate.
    for _pass in range(2):
        if shutdown_requested() or not dest_pool:
            break
        _late, _late_unreadable = _funded_subaddresses(
            connect_rpc(args.rpc_primary,
                        proxy_url=getattr(args, "tor_proxy", "")),
            accounts)
        # AN ACCOUNT THIS PASS COULD NOT READ IS NOT A CLEAN EXIT EITHER, and
        # the same rule the initial enumeration follows applies here: it may
        # hold anything. Only accounts the FIRST read could see are counted --
        # one already in _unreadable is already in `failed`, and counting it
        # twice would report more failures than there are accounts.
        _new_unreadable = [a for a in _late_unreadable if a not in _unreadable]
        if _new_unreadable:
            _outcomes.add("recheck_unreadable")
            failed += len(_new_unreadable)
            print(f"  [!] EXIT: {len(_new_unreadable)} account(s) could not be "
                  f"re-read after the withdrawals "
                  f"({', '.join(str(a) for a in _new_unreadable)}), so this "
                  f"exit cannot be called complete. Check them yourself.")
        # A HELD ADDRESS THAT BECAME FUNDED DURING THE EXIT STILL HAS TO BE
        # NAMED. This is not a corner case -- it is the case _exit_hold_list is
        # written for: "a swap chunk that settled late". If it settles while
        # the withdrawals above are serving their --hop-delay, the initial
        # enumeration never saw it, so the block that prints where held money
        # is and what to do with it never ran for it. Filtering it out here
        # without a word would leave the operator with an unmixed balance on an
        # address a public ThorChain memo names, and nothing anywhere saying so.
        _late_held = [t for t in _late
                      if (t[0], t[1]) in _hold_set
                      and (t[0], t[1]) not in _named_held]
        for _la, _li, _lamt in _late_held:
            # BEFORE the report, not after the loop: two passes is the bound
            # today, and a third would otherwise re-open the same hole.
            _named_held.add((_la, _li))
            _lkind = _held_kind((_la, _li))
            _held_kinds[_lkind] += 1
            print(f"  [!] EXIT: {Decimal(_lamt) / Decimal(10 ** 12)} XMR "
                  f"arrived on "
                  f"{_HELD_WHAT[_lkind]}"
                  f" address (account {_la} / subaddr {_li}) while this exit "
                  f"was running, and was NOT withdrawn — for the same reason "
                  f"the held outputs above were not. It is safe where it is; "
                  # The mix-it-again remedy is wrong for the fee, here for the
                  # same reason it is wrong in the enumeration above -- and
                  # this line is reached on its own, by an output the first
                  # pass never saw, so it cannot borrow that branch.
                  + ("spend it on its own, and not with another run's fee."
                     if _lkind == "usagefee"
                     else "mix it with a fresh receive wallet as described "
                          "above."))
        if _late_held:
            integrity_log("exit", "withheld_unmixed")
        _late = [t for t in _late
                 if (t[0], t[1]) not in _attempted
                 and (t[0], t[1]) not in _hold_set
                 and t[2] > _floor]
        if not _late:
            break
        _outcomes.add("late_outputs")
        integrity_log("exit", "late_outputs_found")
        print(f"  [!] EXIT: {len(_late)} output(s) are funded now that were "
              f"not when this exit started — either the wallet had not scanned "
              f"them yet, or they arrived while the withdrawals above were "
              f"serving their delays. Withdrawing them too rather than "
              f"reporting a clean exit over them.")
        total += len(_late)
        for acct, sub, amt in _late:
            if shutdown_requested():
                _outcomes.add("interrupted")
                skipped += 1
                continue
            _done += 1
            _attempted.add((acct, sub))
            _withdraw_one(acct, sub, f"exit {_done}/{total}",
                          dest_pool[(_done - 1) % len(dest_pool)])

    integrity_log("exit", "withdraw_done:" +
                  (",".join(sorted(_outcomes)) or "nothing_attempted"))
    return (relayed, failed, skipped, dict(_held_kinds), unclean)


def _stage5_run(args, fanout_file, dag_file, fanout_targets, staging_dir,
                proxy, spendable_amount, distribution_mode="fanout",
                change_target=(0, 0), change_sweep_jobs=None,
                change_accounts=None,
                delay_window=None, veil_file=None, veil_target=None,
                veil_need=None, exit_accounts=None, exit_hold=None,
                exit_fee_hold=None,
                dag_dst_index=None, sweep_targets=None):
    """Execute the create -> sign -> broadcast pipeline as confirmation-gated
    rounds: the distribution (a one-shot fan-out OR a peeling chain), then
    (optionally) the DAG hop round once the mix outputs have unlocked on-chain,
    then the exit-strategy simulation.

    veil_file/veil_target/veil_need and delay_window are REQUIRED for a real
    run even though they default to None. The entry veil (Round 0 below) and
    --hop-delay were added to this signature and then, at the one call site in
    main(), silently never passed -- so the veil round did not run and the
    first peel spent a carrier that had never been funded ("not enough
    money"). No test caught it because nothing executes main(). They default
    to None only so the confirmation-gated helper stays callable in isolation;
    the pipeline must pass all four.

    dag_dst_index maps each hop's destination ADDRESS to the (account, index)
    a balance poll takes, and sweep_targets is the same for the change sweeps.
    They exist for one reason: the exit must not enumerate what it will
    withdraw until the round that funded it has landed. See the landing gate
    below -- without it the exit reads the wallet seconds after the last relay,
    misses whatever the wallet has not scanned yet, and reports a complete exit
    anyway."""
    # -- Round 0: veil the entry ------------------------------------------
    # ENTRY holds the one output an analyst is handed for free (the swap memo
    # is public). Sweep it into a fresh carrier FIRST, so the transaction that
    # spends it is an ordinary 2-output send rather than the distribution's
    # unusual shape, and everything afterwards spends an output nobody outside
    # this wallet can enumerate. See build_entry_veil.
    #
    # The distribution cannot be created until this has confirmed and unlocked
    # -- it spends the carrier -- so the wait is not optional politeness.
    incomplete = []
    withheld = []
    # WHAT THE EXIT MUST WAIT FOR. Accumulated as each round relays, because
    # only this function knows which rounds actually ran and how far they got.
    # See the landing gate just before the exit.
    _landed = []
    # The DISTRIBUTION's destinations that were actually funded, kept apart
    # from _landed because the DAG round needs them for a second job: they are
    # the only outputs a hop can be built from, so they decide which hops the
    # round may still contain when the distribution stopped part-way.
    _dist_landed = []
    if veil_file:
        print("  [*] === Round 0: entry veil ===")
        relay_gates(args, proxy, "stage5_veil")
        _run_round(args, veil_file, f"{staging_dir}/veil", "Entry veil")
        # ONE WAIT PER CARRIER, and ALL of them must land.
        #
        # With --split N there are N veils into N carriers. They are
        # independent transactions from independent subaddresses, so they
        # confirm in PARALLEL -- the loop costs one confirmation window in
        # wall-clock, not N, because a carrier that is already unlocked
        # returns from _wait_for_carrier on its first poll.
        #
        # All-or-nothing on purpose. A distribution built while one chunk's
        # carrier is still unconfirmed would be missing that chunk's fan-out
        # transaction, and nothing downstream ever goes back for it: the
        # chunk would sit on its carrier, unmixed, while the run reported the
        # rounds it did manage. Stopping here leaves every carrier holding its
        # own chunk, which is recoverable by hand.
        _targets = (list(veil_target) if isinstance(veil_target, list)
                    else [tuple(veil_target)])
        # WHAT EACH CARRIER WILL ACTUALLY HOLD, not a proportional slice of the
        # run's budget. The first plural version passed slice_usable, which is
        # `usable` split in proportion to each chunk -- but the sweep fee a
        # carrier pays is ABSOLUTE, not proportional. For an unequal split (the
        # case the design exists to handle: quotes differ, JoinMarket's UTXOs
        # differ) the small chunk's proportional share exceeds what its carrier
        # can possibly hold after one fee, so the wait could never be satisfied
        # and _stage5_run sat out the full timeout before reporting "the entry
        # sweep did not confirm" -- about a chunk that had confirmed perfectly.
        # main() now passes min(share, arrived - fee reserve), which is
        # `usable` unchanged for a single chunk.
        _needs = (list(veil_need) if isinstance(veil_need, list)
                  else [veil_need] * len(_targets))
        for _vi, (_vacct, _vidx) in enumerate(_targets):
            _vlabel = (f"entry veil {_vi + 1}/{len(_targets)}"
                       if len(_targets) > 1 else "entry veil")
            if not _wait_for_carrier(args, _vacct, _vidx, _needs[_vi], proxy,
                                     _vlabel):
                integrity_log("stage5", "veil_carrier_timeout")
                # "RE-RUN ONCE IT CONFIRMS" WAS WRONG, AND WRONG IN THE ONE
                # DIRECTION THAT COSTS MONEY. Nothing re-runs onto a carrier: a
                # send-mode run calls create_entry_set and mints a brand-new
                # entry set, and receiver mode needs a bundle, which
                # create_receive_wallet only ever mints for a NEW subaddress --
                # it cannot describe an address that already exists. So a
                # re-run waits for money on addresses that hold nothing while
                # the balance sits here forever.
                #
                # The swap-shortfall gate already says this correctly ("a
                # send-mode run mints a NEW ENTRY every time, so re-running now
                # leaves what did arrive stranded"). Two messages about parked
                # money, one fixed and one still sending the operator the way
                # that strands it.
                print(f"  [!] The entry sweep did not confirm and unlock in "
                      f"time, so the distribution was NOT created. The funds "
                      f"are safe on account {_vacct}, subaddress {_vidx} — but "
                      f"they are UNDISTRIBUTED.")
                print(f"      DO NOT simply re-run: this run's carriers are "
                      f"not an entry any later run can adopt. A send-mode "
                      f"re-run mints a NEW entry set and waits for a NEW swap; "
                      f"receiver mode needs a bundle, and "
                      f"create_receive_wallet only mints one for a FRESH "
                      f"subaddress. Either way nothing points at the accounts "
                      f"below and the balance stays there.")
                print(f"      To mix it: mint a fresh receive wallet "
                      f"(create_receive_wallet), send ONE carrier's balance to "
                      f"it as a single ordinary transfer, then run this with "
                      f"--receive-wallet on that bundle. The carrier is "
                      f"already one hop past the address the swap memo names, "
                      f"so that transfer discloses nothing new.")
                if len(_targets) > 1:
                    # NAME EVERY CARRIER, because this is the last chance to.
                    # report_completion deliberately skips report_holdings on an
                    # incomplete run, so if these accounts are not printed here
                    # the operator finishes the run knowing only the account
                    # that FAILED -- and the ones that succeeded are holding
                    # money on accounts nothing has told them about.
                    print(f"      This is carrier {_vi + 1} of "
                          f"{len(_targets)}. The others may have confirmed; "
                          f"each holds its own swap chunk, on its own account "
                          f"— none of them has been distributed. Every carrier "
                          f"this run created, so you can find all of them: "
                          + ", ".join(f"account {_a}/subaddr {_x}"
                                      for _a, _x in _targets) + ".")
                    print(f"      ONE BUNDLE PER CARRIER, and do NOT sweep "
                          f"them together into one. Each carrier holds a "
                          f"DIFFERENT swap chunk, and every one of those swaps "
                          f"settled in public: a single transaction spending "
                          f"two of them is the convergence --split exists to "
                          f"prevent, and it hands an analyst the intersection "
                          f"of two known candidate sets. Recover them one at a "
                          f"time, as separate runs.")
                return (["the entry sweep did not confirm, so nothing was distributed"],
                        withheld)

    # WHERE A STOPPED PEEL CHAIN LEFT ITS REMAINDER. Set below when the chain
    # stops part-way; the exit HOLDS it rather than withdrawing it. See
    # peel_stuck_carrier.
    _stuck_carrier = None
    if distribution_mode == "peel":
        _peel_txs = []
        try:
            with open(fanout_file) as _pf:
                _peel_txs = list(json.load(_pf).get("txs") or [])
        except Exception:                                    # noqa: BLE001
            _peel_txs = []
        _total_peels = len(_peel_txs)
        _relayed = _run_peel_chain(args, fanout_file, staging_dir, proxy, change_target)
        # THE UNDISTRIBUTED REMAINDER IS NOT SPARE CHANGE, and it is not mixed.
        #
        # Every peel consumes its carrier exactly and pays the rest forward, so
        # a chain that stops at peel R leaves EVERYTHING IT HAD LEFT on peel R's
        # source. Driven through the shipped main() with a 10-peel chain stopped
        # at 3: the exit withdrew 9.62 of the run's 12 XMR from that carrier,
        # straight to --exit-to, and printed "EXIT COMPLETE: 4 output(s)
        # withdrawn" -- while _run_peel_chain had already told the operator the
        # balance was "safe on this wallet's account N, subaddress M ...
        # distribute it manually".
        #
        # It is the same object the fan-out's change hold refuses: the
        # distribution's unallocated remainder, through NO hop round. The peel
        # just moved it off subaddress 0 onto a rotating carrier, so the hold
        # built from change_accounts -- empty in peel mode -- never covered it.
        # The exit sends it to the SAME address as the mixed outputs, so an
        # analyst watching that address gets the barely-mixed 80% and the mixed
        # remainder as one owner's.
        if _relayed < _total_peels:
            _stuck_carrier = peel_stuck_carrier(_peel_txs, _relayed,
                                                tuple(change_target))
        # Peel i pays fanout_dests[i] (build_peel_plan walks them in order), so
        # a chain that stopped at _relayed funded exactly the first _relayed
        # targets. The rest can never hold anything and waiting on them would
        # be an hour of polling an address nobody paid.
        _dist_landed = list(fanout_targets or ())[:_relayed]
        _landed += _dist_landed
        if _total_peels and _relayed < _total_peels:
            incomplete.append(f"peeling chain relayed only {_relayed}/{_total_peels} peels")
        # Every peel left (carrier reserve - real fee) as change on its OWN
        # account's subaddress 0. Rotating carriers stopped any address being
        # spent twice; running each hop in its own account is what lets each
        # of those change outputs be swept SEPARATELY.
        #
        # They must not be collected in one transaction. N inputs in one tx is
        # public, permanent proof that those N outputs share an owner, and
        # they are the change of the N peels -- so a single tidy sweep would
        # announce that the whole chain was one entity. One sweep each.
        if change_sweep_jobs and _relayed:
            try:
                with open(fanout_file) as _mf:
                    _cs_meta = json.load(_mf).get("meta", {})
            except Exception:                                # noqa: BLE001
                _cs_meta = {}
            # ONLY THE PEELS THAT ACTUALLY RAN LEFT CHANGE.
            #
            # change_sweep_jobs is provisioned for EVERY hop in the plan, in
            # hop order, before the chain runs. A chain that stops early leaves
            # the rest of those accounts never funded -- and _wait_for_change_settled
            # cannot distinguish "nothing arrived yet" from "nothing is ever
            # coming", so it waited out FANOUT_CONFIRM_TIMEOUT on each one.
            # That is one hour per unrun peel: a 7-peel chain that stopped at
            # the first peel spent ~6 hours polling accounts that could not
            # hold anything, and then reported them as "NOT swept — UNMIXED",
            # which is true of an empty address and tells the operator to go
            # looking for money that was never there.
            #
            # _relayed is the count the chain actually relayed, and the jobs are
            # in the same hop order, so everything past it is provably empty.
            _runnable = change_sweep_jobs[:_relayed]
            _skipped_jobs = change_sweep_jobs[_relayed:]
            if _skipped_jobs:
                integrity_log("stage5", "change_sweeps_skipped_unrun_peels")
                print(f"  [*] {len(_skipped_jobs)} change location(s) belong to "
                      f"peels that never ran, so they hold nothing. Skipping "
                      f"them rather than waiting "
                      f"{FANOUT_CONFIRM_TIMEOUT // 60} minutes each to watch an "
                      f"empty address.")
            _missed = _run_change_sweeps(args, _runnable, staging_dir,
                                         proxy, _cs_meta, delay_window)
            # Only when every sweep relayed. A sweep that failed left its fresh
            # destination unfunded, and the landing gate would poll it for the
            # full hour before giving up on money that was never sent.
            if not _missed:
                _landed += list(sweep_targets or ())[:len(_runnable)]
            if _missed:
                incomplete.append(
                    f"{_missed} of {len(_runnable)} peel change output(s) "
                    f"were NOT swept to a fresh address — they are unmixed on their "
                    f"hop's change address")
    else:
        print("  [*] === Round 1: Fan-out distribution ===")
        # THE ONE TRANSACTION THAT CREATES EVERY MIX OUTPUT, and it was the
        # only main round with no gate of its own. It relays after the entry
        # veil's carrier wait, which can be a full hour: the last gate this
        # round passed was the one before the veil.
        relay_gates(args, proxy, "stage5_fanout")
        _run_round(args, fanout_file, f"{staging_dir}/fanout", "Fan-out")
        # One transaction, every target paid. Nothing to trim.
        _dist_landed = list(fanout_targets or ())
        _landed += _dist_landed
        # The fan-out could not allocate its input exactly, so ~10% came back
        # as change. Sweep it to a fresh address rather than leaving a tenth of the
        # balance parked, unmixed, on the one output that never moves.
        if change_sweep_jobs:
            try:
                with open(fanout_file) as _mf:
                    _cs_meta = json.load(_mf).get("meta", {})
            except Exception:                                # noqa: BLE001
                _cs_meta = {}
            if not _run_change_sweeps(args, change_sweep_jobs, staging_dir,
                                      proxy, _cs_meta, delay_window):
                _landed += list(sweep_targets or ())
            else:
                incomplete.append("the fan-out's change was NOT swept to a fresh address "
                                  "— roughly a tenth of the balance is unmixed on "
                                  "the change address")

    # -- Round 2: DAG hop-mixing (only if planned) ------------------------
    if dag_file:
        newnym(required=True, proxy_url=getattr(args, "tor_proxy", ""))   # anonymity gate before DAG broadcast round
        secure_delay(5.0, 15.0)
        # A HOP CAN ONLY BE BUILT FROM AN OUTPUT THAT EXISTS.
        #
        # The gate below used to wait on EVERY distribution target and the
        # round used every hop in the plan. Both are wrong after a peel chain
        # that stopped part-way, and they were wrong in a way that cost the
        # whole round:
        #
        #   * the gate polled the carriers the chain never reached. Those
        #     addresses cannot ever hold anything, so it spent the full
        #     FANOUT_CONFIRM_TIMEOUT -- an hour -- and then returned False;
        #   * so the DAG round was skipped ENTIRELY. Every output the chain DID
        #     fund lost its second mixing round, and the operator was told the
        #     outputs "did not confirm in time" about outputs that had
        #     confirmed perfectly.
        #
        # Trimming the wait alone would be worse than leaving it: phase_create
        # exits 1 if ANY transaction in a batch fails to build, and _run_round
        # turns that into sys.exit -- so the round would have reached monerod,
        # been told "no unlocked balance" for the unfunded sources, and killed
        # the run AFTER the peels were on-chain and BEFORE the exit. The plan
        # has to be filtered to match the wait.
        #
        # Dropping a hop whose SOURCE was never funded cannot create the merge
        # build_dag_plan spends its length preventing. That merge needs an
        # address to end the round holding TWO outputs, which needs an address
        # that holds its own output and does not sweep it away. After this
        # filter an address holds its own output only if the distribution
        # funded it, and a funded source's hop is exactly the kind this filter
        # KEEPS -- so the two conditions cannot both be true. An unfunded
        # destination holds nothing and ends with the one hop it receives.
        _dag_txs, _dag_meta = [], {}
        try:
            _dag_doc = json.loads(Path(dag_file).read_text())
            _dag_txs = list(_dag_doc.get("txs") or [])
            _dag_meta = _dag_doc.get("meta", {}) or {}
        except Exception:                                    # noqa: BLE001
            _dag_txs, _dag_meta = [], {}
        _kept = _dag_txs
        # Only when the distribution really is partial. In fan-out mode one
        # transaction pays every target, so _dist_landed IS fanout_targets and
        # this filter would be a no-op that could only introduce a bug; and a
        # caller that passed no targets at all must not have its plan emptied.
        if fanout_targets and len(_dist_landed) < len(fanout_targets):
            _funded_srcs = {(int(a), int(i)) for a, i in _dist_landed}
            def _hop_src(_e):
                """(account, subaddress) a hop spends, or None if unreadable.

                None -- and therefore DROPPED -- rather than an exception or a
                guess. This runs on a file that has been on disk since stage 4;
                a truncated write or a hand-edited plan must not take the run
                down here, and must certainly not resolve to some other
                account's subaddress and get that one swept instead.
                """
                try:
                    _a = _e.get("account_index")
                    if _a is None:
                        _a = _dag_meta.get("account_index")
                    return (int(_a), int(_e["src_index"]))
                except (TypeError, ValueError, KeyError):    # noqa: BLE001
                    return None

            _kept = [_e for _e in _dag_txs if _hop_src(_e) in _funded_srcs]
            _dropped_hops = len(_dag_txs) - len(_kept)
            if _dropped_hops:
                integrity_log("stage5", "dag_hops_dropped_unfunded_source")
                print(f"  [!] {_dropped_hops} planned hop(s) would have swept a "
                      f"mix subaddress the distribution never reached, so they "
                      f"were removed from the round. Building them would have "
                      f"failed 'no unlocked balance' and taken the whole run "
                      f"down with the distribution already on-chain.")
                atomic_write_json({"meta": _dag_meta, "txs": _kept}, Path(dag_file))
        if not _kept:
            integrity_log("stage5", "dag_round_skipped:no_funded_source")
            print("  [!] Skipping the DAG hop round — the distribution funded "
                  "no output that can source a hop. What it did distribute is "
                  "on-chain and untouched.")
            incomplete.append("DAG hop round was SKIPPED (no distribution output "
                              "survived to source a hop) — the second mixing "
                              "round did not happen")
        elif _wait_for_fanout_confirm(args, _dist_landed, proxy,
                                      what="distribution"):
            print("  [*] === Round 2: DAG hop-mixing ===")
            # HERE, not above the wait. The newnym at the top of this block
            # guards the balance polling; by the time the round actually
            # relays, that rotation is up to FANOUT_CONFIRM_TIMEOUT old and
            # nothing has re-asked whether Tor is still up.
            relay_gates(args, proxy, "stage5_dag")
            _run_round(args, dag_file, f"{staging_dir}/dag", "DAG")
            # EVERY HOP SOURCE IS NOW EMPTY. A hop is a sweep_all, so the
            # distribution targets this list held have paid their whole balance
            # onward -- keeping them would make the landing gate poll addresses
            # that hold nothing until it timed out. The value is on the hop
            # DESTINATIONS, and those are what the exit will withdraw.
            #
            # From the KEPT entries, not from the plan as it was written: a
            # destination whose hop was just dropped is never paid, and waiting
            # on it would put back the hour this filter exists to remove.
            #
            # Sources that did not hop (unfundable or unassigned -- see
            # build_dag_plan) keep their own output, which unlocked before this
            # round even started, so nothing is lost by dropping them here.
            _ix = dag_dst_index or {}
            _landed = [_ix[_e["dst"]] for _e in _kept if _e.get("dst") in _ix]
        else:
            integrity_log("stage5", "dag_round_skipped:unconfirmed")
            print("  [!] Skipping the DAG hop round — the distribution outputs "
                  "did not all unlock in time. The distribution is already "
                  "broadcast; only the second mixing round is lost.")
            incomplete.append("DAG hop round was SKIPPED (the distribution outputs "
                              "did not confirm in time) — the second mixing round "
                              "did not happen")

    newnym(proxy_url=getattr(args, "tor_proxy", ""))
    secure_delay(5.0, 15.0)

    # -- THE LANDING GATE. The exit must not read a wallet that is still moving.
    #
    # _run_exit_withdrawals enumerates the funded subaddresses ONCE and
    # withdraws exactly what that snapshot contained. Until this gate existed
    # the snapshot was taken seconds after the last round relayed, and
    # monero-wallet-rpc does not know about a txpool payment to itself until it
    # scans the pool -- which its server does on a 20-second period. Meanwhile
    # commit_tx marks the SOURCE spent the instant the round returns. So for a
    # window of up to 20 seconds the money is in neither place as far as the
    # wallet is concerned, and an output missing from that snapshot is never
    # withdrawn and never mentioned.
    #
    # Measured by driving the shipped enumeration and withdrawal loop against a
    # wallet modelled on those rules -- scan lag uniform 0-20s, submit-to-
    # enumerate gap uniform 5-15s, ten hop destinations of 0.3 XMR:
    #
    #     last hop not yet scanned    9/10 withdrawn, 0.3 XMR left behind
    #     last two not yet scanned    8/10 withdrawn, 0.6 XMR left behind
    #     none scanned yet            0/10 withdrawn, 3.0 XMR left behind
    #
    # and the caller printed "EXIT COMPLETE ... Nothing left on this run's
    # accounts" in the first two and NOTHING AT ALL in the third. Across 300
    # runs the last hop was stranded in 146 (--wallets 10) and 156
    # (--wallets 20) of them.
    #
    # The pipeline already owns the right primitive -- it is the same gate that
    # stops the DAG round being created before the distribution unlocks. It was
    # simply never applied to the step that moves the money OUT, which is the
    # one place where being early costs the whole point of the run.
    #
    # Waiting for UNLOCKED, not merely visible: sweep_all can only spend
    # unlocked outputs, so an output that is merely in the pool would be
    # enumerated and then swept for nothing.
    if getattr(args, "exit_to", None) and _landed:
        if not _wait_for_fanout_confirm(args, _landed, proxy,
                                        what="last round's"):
            integrity_log("stage5", "exit_landing_timeout")
            print("  [!] Not every output from the last round unlocked within "
                  f"{FANOUT_CONFIRM_TIMEOUT // 60} min. The exit runs anyway on "
                  "what IS visible, and reports whatever it could not take — "
                  "but read its lines carefully: value may be left on this "
                  "wallet.")

    # -- Stage 5d: THE EXIT. This is the step that moves value off this wallet.
    #
    # It used to run exit_strategy_simulator, which fetches a price and prints
    # a valuation. That is a report, not an exit: every output the run created
    # was still sitting on this wallet when the pipeline announced it was
    # complete. The exit is the withdrawal, so the withdrawal is what runs here.
    #
    # It is opt-in through --exit-to because a withdrawal needs a destination
    # and there is no safe default for one. When it is not given, say so
    # plainly -- an operator who thinks the pipeline exited when it did not is
    # exactly the confusion the old step created.
    if getattr(args, "exit_to", None):
        try:
            with open(fanout_file) as _ef:
                _exit_meta = json.load(_ef).get("meta", {})
        except Exception:                                    # noqa: BLE001
            _exit_meta = {}
        # EVERY CHANGE LOCATION IS HELD TOO, unconditionally.
        #
        # The hold covered ENTRY's own subaddress only. A distribution cannot
        # allocate its input exactly, so monerod returns the remainder as
        # change to subaddress 0 of the SPENDING account -- and the exit was
        # sweeping that straight to --exit-to. Reproduced: with ENTRY at
        # account 3 / subaddr 1 held, the fan-out change at 3/0 was withdrawn.
        #
        # That output is the one the change sweep exists to push INTO the mix,
        # and _run_change_sweep's own failure message calls what it leaves
        # behind "UNMIXED ... the one output that never moves". Withdrawing it
        # is the same publication the ENTRY hold refuses, on the same run.
        #
        # Unconditional rather than conditional on the sweep having failed: a
        # swept change address is EMPTY, so _funded_subaddresses never returns
        # it and holding it costs nothing. Keying it off the sweep's own return
        # code would trust the bookkeeping of the step being checked, and would
        # miss the residual case where the sweep relayed but left value behind.
        _hold = list(exit_hold or ())
        # AND THE USAGE FEE, which the exit should never have been able to see
        # in the first place -- plan_usage_fee keeps its account out of
        # addr_index, so _exit_account_list does not name it and
        # _funded_subaddresses does not read it. Held anyway: that safety is
        # an omission, and an omission is exactly the kind of guard a later
        # change removes without noticing. Costs nothing while the omission
        # holds (a pair that is never enumerated is never matched), and turns
        # the day it stops holding into a named withheld output instead of the
        # operator's own cut arriving at --exit-to in silence.
        for _fp in (exit_fee_hold or ()):
            _hold.append((int(_fp[0]), int(_fp[1])))
        for _cj in (change_sweep_jobs or ()):
            _hold.append((int(_cj[0]), int(_cj[1])))
        # EVERY CHANGE ACCOUNT, NOT ONLY THE ONES THAT GOT A SWEEP JOB.
        #
        # The comment above says this hold is "unconditional rather than
        # conditional on the sweep having failed". It was not: it was built
        # from change_sweep_jobs, and a job is SKIPPED when its fresh
        # destination could not be created (stage 4 catches that and prints
        # "That change will stay on account N, subaddress 0 — UNMIXED, and it
        # is an output that never moves").
        #
        # So exactly the account whose change could not be swept was also the
        # one not held, and with --exit-to the exit then swept it to the
        # operator's destination -- while the message told them it never
        # moves. Conditional in the one case where it mattered, and a false
        # statement to go with it.
        #
        # One carrier hid this: change_target covered the only account there
        # was. N carriers give N-1 more chances for that create to fail.
        for _ca in (change_accounts or ()):
            _hold.append((int(_ca), 0))
        if change_target:
            _hold.append((int(change_target[0]), int(change_target[1])))
        # AND THE CARRIER A STOPPED PEEL CHAIN LEFT EVERYTHING ON. See the note
        # where _stuck_carrier is set.
        if _stuck_carrier:
            _hold.append((int(_stuck_carrier[0]), int(_stuck_carrier[1])))
        _relayed, _failed, _skipped, _held, _unclean = _run_exit_withdrawals(
            args, exit_accounts or [], args.exit_to, staging_dir, proxy,
            _exit_meta, delay_window, hold=_hold,
            entry_pairs=list(exit_hold or ()),
            remainder_pairs=([_stuck_carrier] if _stuck_carrier else []),
            fee_pairs=list(exit_fee_hold or ()))
        _held_entry = (_held or {}).get("entry", 0)
        _held_change = (_held or {}).get("change", 0)
        _held_remainder = (_held or {}).get("remainder", 0)
        _held_fee = (_held or {}).get("usagefee", 0)
        if _held_entry or _held_change or _held_remainder or _held_fee:
            # WITHHELD, NOT INCOMPLETE, and the distinction is not cosmetic.
            #
            # This started life in `incomplete`, which reads as "the mix is not
            # what was planned" -- and report_completion answers that by
            # skipping the holdings report, skipping _wipe_spent_plans and
            # exiting 1. So a run that did every single thing it planned, and
            # then deliberately declined to publish one link, was reported as a
            # failed run AND LEFT ITS PLAN FILES ON DISK: every hop's
            # destination and amount, in plaintext, because the one place that
            # knows a plan is spent had been told the run did not finish.
            #
            # The exit refusing to withdraw is the pipeline working. It is
            # money left behind, so it is reported -- loudly, with the reason,
            # or the operator reads it as a bug and sweeps it by hand, which is
            # the exact transaction being avoided.
            # SAY WHICH KIND. These are different addresses with different
            # reasons and different remedies, and asserting ENTRY for a
            # change output sends the operator to look at an address the
            # swap memo does not name.
            if _held_entry:
                withheld.append(
                    f"unmixed value on "
                    f"{'an entry address' if _held_entry == 1 else f'{_held_entry} entry addresses'}"
                    f" was NOT withdrawn — it arrived after the run had "
                    f"planned, and the swap that funded it is public, so "
                    f"withdrawing it would link the swap to your exit "
                    f"destination in one hop")
            if _held_change:
                withheld.append(
                    f"the remainder on "
                    f"{'a distribution change address' if _held_change == 1 else f'{_held_change} distribution change addresses'}"
                    f" was NOT withdrawn — it never went through the hop "
                    f"rounds, so it is unmixed, and it is an output of the "
                    f"transaction that spent your swapped funds")
            if _held_remainder:
                # ITS OWN LINE, not folded into the change one. This is not a
                # rounding remainder: it is everything the peel chain had left
                # when it stopped, which can be most of the run.
                withheld.append(
                    "the UNDISTRIBUTED balance the peeling chain stopped on "
                    "was NOT withdrawn — the chain never spent it, so it went "
                    "through no fan-out and no hop round at all. It is the "
                    "same money _run_peel_chain told you to distribute by "
                    "hand")
            if _held_fee:
                # ITS OWN LINE, and it is a regression report. The exit cannot
                # normally see this account at all (plan_usage_fee keeps it out
                # of addr_index), so if it is here, the isolation that keeps
                # the operator's cut out of --exit-to has been broken
                # somewhere upstream and the hold was the last thing standing.
                withheld.append(
                    "your own USAGE FEE was NOT withdrawn — the exit should "
                    "not be able to see that account at all, so something has "
                    "put it back in this run's index; the hold is why it did "
                    "not go to your exit destination, where its size alone "
                    "would have given away the deposit")
        if _failed or _skipped:
            incomplete.append(
                f"the exit withdrew {_relayed} output(s) but {_failed + _skipped} "
                f"were NOT sent — that value is still on this wallet")
        elif _unclean:
            # NOT "COMPLETE", and this is why the count is returned at all.
            # `relayed` collapsed three different per-output results into one
            # number: emptied, relayed-but-residue-left (sweep_all could not
            # take an output that had not unlocked), and relayed-but-the-
            # balance-could-not-be-re-read. So the exit printed
            # "X XMR is STILL on account N / subaddr M" and this line then
            # printed "Nothing left on this run's accounts" immediately after
            # it, and the run exited 0. Reproduced end to end.
            print(f"  [!] EXIT INCOMPLETE: {_relayed} output(s) were relayed, "
                  f"but {_unclean} of them still hold value or could not be "
                  f"re-read to confirm they are empty — see the lines above. "
                  f"That value has NOT left the wallet.")
            print("      It is safe where it is. Withdraw it once it unlocks; "
                  "do not assume this run finished the job.")
            withheld.append(
                f"{_unclean} withdrawn output(s) still hold value or could not "
                f"be verified empty")
        # NOT `not _held`. _held is a {"entry": n, "change": n, ...} breakdown
        # now, and a populated dict is ALWAYS truthy -- so this branch, the only
        # place a clean exit is announced, could never be reached after the
        # return type changed. Count, never test the container. EVERY count:
        # each kind added since has had to be added here too, and the one that
        # is not would announce a clean exit over withheld value.
        elif _relayed and not (_held_entry or _held_change or _held_remainder
                               or _held_fee):
            print(f"  [+] EXIT COMPLETE: {_relayed} output(s) withdrawn, each in "
                  f"its own transaction. The wallet was re-read afterwards and "
                  f"nothing further is funded on this run's accounts.")
    else:
        integrity_log("exit", "no_exit_to:not_withdrawn")
        print("  [*] Stage 5d: NO EXIT PERFORMED — --exit-to was not given, so "
              "the mixed funds are still on this wallet. They are yours and "
              "they are safe; they have simply not left. Re-run with "
              "--exit-to <address> (repeatable) to withdraw them, and read the "
              "holdings note below before spending them by hand.")

    # Every round wipes its OWN staging subdir, which leaves the parent behind
    # as an empty directory. It holds nothing, but its existence and mtime date
    # a run on a host that is supposed to look untouched -- and the operator
    # has no reason to think anything is left, because the run just reported
    # success. rmdir, not a recursive delete: if anything is still in there a
    # round failed to clean up after itself, and silently destroying it would
    # hide that. OSError (not empty / already gone) is the correct no-op.
    try:
        Path(staging_dir).rmdir()
    except OSError:
        pass

    integrity_log("stage5", f"stage5_done:incomplete={len(incomplete)}")
    return incomplete, withheld


if __name__ == "__main__":
    # Registered before main() so it fires on EVERY ending: a clean return, a
    # sys.exit from any gate, and an uncaught exception (atexit hooks run after
    # the traceback). Only under __main__ -- importing this module for its
    # helpers, which every test does, must not install a process-wide hook.
    atexit.register(_report_surviving_plans)
    main()
