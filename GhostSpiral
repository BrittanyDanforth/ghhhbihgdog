DUST_XMR = Decimal("0.0001")

# How many fee-widths to hold back per remaining peel when sizing what a peel
# forwards to the next rotating carrier. See the reserve comment in the peel
# planner: under-reserving strands funds mid-chain, over-reserving only
# shrinks the final distribution slightly.
PEEL_CARRIER_RESERVE_MULT = Decimal("4")

# Single source of truth for the fee safety margin. It was written inline as
# Decimal("1.5") in the stage-4 fee budget, in compute_hop_amount, and in the
# operator-facing message that reports the reserve -- three copies that could
# drift, so a changed margin would have made the printed number a lie.
FEE_SAFETY_MARGIN = Decimal("1.5")

# Fraction of the post-fee balance the fan-out distributes. The remainder stays
# on ENTRY as headroom for the fan-out transaction's own fee. Verified fundable:
# across every balance/wallet/depth combination that clears the dust guards the
# tightest observed remainder was ~0.0245 XMR against a real 0.0024 XMR fee.
FANOUT_SPEND_FRACTION = Decimal("0.9")
BTC_RE = re.compile(r"^(bc1|tb1)[ac-hj-np-z02-9]{25,59}$", re.I)
SWAPKIT_API = "https://api.swapkit.dev"

MIN_WALLETS = 3
MIN_DEEP = 1
# Extra mix outputs beyond `wallets`, chosen RANDOMLY per run within this range.
# A fixed count (the old NUM_DECOYS = 4) makes the total output count a
# deterministic function of `wallets` -- so with public code, seeing 44 outputs
# tells the analyst wallets=40 (a named preset). A per-run random count in
# [DECOY_MIN, DECOY_MAX] breaks that: the output count no longer reveals the
# setting. These extra outputs are NOT dead-ends -- they hop like every other
# output (see select_fanout_targets), so they add real, indistinguishable
# volume rather than a filterable class.
DECOY_MIN = 2
DECOY_MAX = 7

# Fallback fee: conservative estimate for typical 2-input/2-output Monero TX.
# Updated periodically; safe to overshoot slightly (operator keeps the change).
FALLBACK_FEE_XMR = Decimal("0.00005")

# Per-TX fee above which the daemon's estimate is not believable and is refused
# rather than used to size a spending plan. A monerod that is FRESH, --offline,
# or unsynced reports the maximum default base fee (2e9 piconero/byte, observed),
# which this tool's ~2 kB conversion turns into ~4 XMR PER TRANSACTION -- and at
# a higher priority, hundreds of XMR. The sibling gs_console already flags this
# ("fresh or offline chain"); GhostSpiral is the tool that actually SPENDS, so
# it must not build a plan around that number. Sizing stage 4 with a 4-XMR fee
# turns a working wallet into "insufficient balance: estimated fees 240 XMR",
# misdiagnosing a daemon misconfiguration as the operator's balance.
# The ceiling is set FAR above any real fee (even an extreme-congestion
# priority-4 mainnet fee is a fraction of an XMR) and far below the fresh-chain
# value, so it catches the pathological case without ever rejecting a real one.
FEE_IMPLAUSIBLE_XMR = Decimal("1.0")

# FALLBACK per-priority fee multipliers, used ONLY when monerod's
# get_fee_estimate doesn't return an explicit per-priority 'fees' array (older
# daemons). Modern monerod DOES return that array and fetch_fee_from_daemon
# prefers it (the exact per-priority fee the daemon will charge), so this table
# is a best-effort approximation, not authoritative.
#
# Verified against real monerod 0.18.3.1: get_fee_estimate returned
#   fees = [1200000, 4700000, 19000000, 240000000]  (ratios ~ 1 / 3.9 / 15.8 / 200)
# i.e. the real priority-4 multiplier is ~200x, NOT the classic 166x below. That
# is exactly why we prefer the daemon's fees[] and treat this table as a rough
# fallback for ancient daemons only. At priority 1 it's exact regardless.
PRIORITY_FEE_MULTIPLIER = {1: 1, 2: 4, 3: 20, 4: 166}

# Fan-out outputs are spendable only after they confirm and unlock (~10 blocks,
# roughly 20 min on mainnet). The DAG-mixing round sources FROM those fan-out
# subaddresses, so it cannot be created until the fan-out has confirmed. These
# bound how long Stage 5 waits for that before giving up and skipping DAG.
FANOUT_CONFIRM_TIMEOUT = 3600   # seconds to wait for fan-out to unlock
FANOUT_CONFIRM_POLL = 30        # seconds between balance polls

# In sender mode the XMR from the ThorChain swap lands on ENTRY only AFTER the
# operator sends BTC and the cross-chain swap settles (minutes to well over an
# hour). ENTRY is created fresh this run, so its balance starts at zero -- we
# poll for the funds to arrive rather than checking once and aborting.
XMR_ARRIVAL_TIMEOUT = 7200      # seconds to wait for swapped XMR to arrive
XMR_ARRIVAL_POLL = 30           # seconds between arrival polls


def fetch_fee_from_daemon(daemon_url, proxies, fee_priority: int = 1) -> Decimal:
    """Estimate per-TX fee in XMR from monerod's get_fee_estimate.

    get_fee_estimate is a DAEMON json_rpc method -- the wallet-rpc (:18083) does
    NOT expose it, so the original version that queried rpc_primary always threw
    and silently used the constant every run. Query the daemon (args.rpc_daemon,
    :18081) instead. Prefer monerod's explicit per-priority 'fees' array (the
    exact per-byte fee transfer_split will charge at this priority); only if the
    daemon doesn't return it fall back to base-fee x PRIORITY_FEE_MULTIPLIER,
    then to FALLBACK_FEE_XMR. Scaled by a ~2kB typical TX size throughout."""
    multiplier = Decimal(PRIORITY_FEE_MULTIPLIER.get(fee_priority, 1))
    est = daemon_fee_estimate(daemon_url, proxies)
    fees = est.get("fees")
    # Exact path: monerod's per-priority array, indexed by priority (1-based).
    if isinstance(fees, list) and len(fees) >= fee_priority and fees[fee_priority - 1] > 0:
        fee_xmr = Decimal(int(fees[fee_priority - 1]) * 2000) / Decimal(10 ** 12)
        if fee_xmr > 0:
            _reject_implausible_fee(fee_xmr, daemon_url, "per_priority_array")
            integrity_log("fee", "daemon_fee:per_priority_array")
            return fee_xmr
    # Approximate path: older daemon with only a base 'fee'.
    base = est.get("fee", 0) or 0
    if base > 0:
        fee_xmr = (Decimal(int(base) * 2000) / Decimal(10 ** 12)) * multiplier
        if fee_xmr > 0:
            _reject_implausible_fee(fee_xmr, daemon_url, "base_times_multiplier")
            integrity_log("fee", "daemon_fee:base_times_multiplier")
            return fee_xmr
    integrity_log("fee", "using_fallback_fee")
    return FALLBACK_FEE_XMR * multiplier


def _reject_implausible_fee(fee_xmr: Decimal, daemon_url, source: str) -> None:
    """Abort if the daemon's fee is too high to be real (fresh/offline chain).

    Sizing a spending plan around a bogus fee is worse than refusing: it either
    misreports the operator's balance as insufficient or shrinks every hop to
    nothing. A daemon reporting a real fee is never near FEE_IMPLAUSIBLE_XMR, so
    this only fires on a misconfigured daemon -- which the operator must fix,
    not have papered over."""
    if fee_xmr <= FEE_IMPLAUSIBLE_XMR:
        return
    # Record only WHICH path saw it, not the number: keep amounts off the
    # persistent chain uniformly. The operator sees the value in the abort below.
    integrity_log("fee", f"IMPLAUSIBLE_daemon_fee:{source}")
    sys.exit(
        f"[!] The daemon reports an impossible fee of {fee_xmr} XMR PER TRANSACTION\n"
        f"    ({source}). A real Monero fee is a small fraction of an XMR even at the\n"
        f"    highest priority; a value this large means the daemon at {daemon_url}\n"
        f"    is FRESH, --offline, or not yet synced and is returning its maximum\n"
        f"    default fee.\n"
        f"    Refusing to size a spending plan around it — that would misreport your\n"
        f"    balance as insufficient. Point --rpc-daemon at a synced monerod\n"
        f"    (mainnet :18081) and re-run."
    )


def compute_hop_amount(fanout_amt: Decimal, fee_xmr: Decimal) -> Decimal:
    """How much a mix subaddress can hop onward, after reserving the fee.

    Extracted from stage 4 so tests drive the REAL formula instead of a copy --
    a modelled formula in a test cannot catch a regression in the shipped one.

    Reserves the ACTUAL FEE, not a percentage. The old formula was
    `fanout_amt * 0.85`, and its comment claimed the 15% remainder "covers the
    fee (tiny next to fanout_amt)". That inverts for small fan-outs: the fee is
    an ABSOLUTE amount while a percentage reserve shrinks with the hop. With a
    real daemon fee of ~0.0024 XMR, every fanout_amt below ~0.016 XMR reserved
    LESS than the fee -- the plan cleared the dust guard, then transfer_split
    failed "not enough money" AFTER the fan-out had already executed on-chain,
    leaving funds scattered mid-pipeline.

    Uses FEE_SAFETY_MARGIN (shared with the stage-4 fee budget), and ROUND_DOWN
    so quantising can never round the hop UP past what the output actually
    holds. The caller compares the result against DUST_XMR and skips the DAG
    round when it is not fundable.
    """
    return (fanout_amt - hop_fee_reserve(fee_xmr)).quantize(
        DUST_XMR, rounding=ROUND_DOWN)


def hop_fee_reserve(fee_xmr: Decimal) -> Decimal:
    """Amount withheld from a hop to pay its transaction fee.

    Exposed so the operator-facing message reports the SAME number the
    arithmetic actually used, rather than recomputing the margin at the call
    site where it could drift out of sync.
    """
    return fee_xmr * FEE_SAFETY_MARGIN


def compute_fanout_amount(usable: Decimal, fanout_count: int) -> Decimal:
    """Per-destination fan-out amount.

    Extracted alongside compute_hop_amount so BOTH money formulas are driven by
    tests against the real function instead of a reimplementation.

    ROUND_DOWN matters: quantising up would make fanout_count * result exceed
    the FANOUT_SPEND_FRACTION budget it was derived from. The caller guards
    fanout_count > 0 (mix_targets excludes ENTRY, so a degenerate subaddress
    set would otherwise divide by zero) and compares the result against
    DUST_XMR.
    """
    return (usable * FANOUT_SPEND_FRACTION / Decimal(fanout_count)).quantize(
        DUST_XMR, rounding=ROUND_DOWN)


def compute_fanout_amounts(usable: Decimal, fanout_count: int, fee_xmr: Decimal,
                           dag_enabled: bool, rng=None) -> list:
    """Per-destination fan-out amounts that are DELIBERATELY UNEQUAL.

    Think like a chain analyst. Splitting the balance into N identical outputs
    makes those N outputs, and every hop that later spends them, share one
    value and one transaction shape -- a cluster you can pick out and follow
    even when Monero hides the amounts on-chain (the fee, the input/output
    count, and the timing are all still observable, and a future break in
    amount-hiding would expose the equality directly). Uneven amounts give each
    trail its own magnitude, so the fan-out looks like N unrelated payments
    rather than one split.

    Guarantees, so the plan is always fundable and never over-budget:
      * every amount >= min_each, where min_each reserves this output's own hop
        fee when DAG mixing is on (so no hop later fails "not enough money"
        AFTER the fan-out already executed on-chain), or a dust margin when it
        is off;
      * the sum never exceeds usable * FANOUT_SPEND_FRACTION (each share is
        ROUND_DOWN, and the fixed min_each floor is reserved before the random
        remainder is distributed);
      * returns [] when the budget cannot fund `fanout_count` viable outputs,
        so the caller can reduce the count or abort rather than emit a plan
        that dies mid-flight.

    rng is injected for deterministic tests; production passes a SystemRandom.
    Uses only rng.random() (uniform 0..1), so any stdlib Random works.
    """
    if fanout_count <= 0:
        return []
    if rng is None:
        import secrets as _s
        rng = _s.SystemRandom()
    budget = usable * FANOUT_SPEND_FRACTION
    min_each = (hop_fee_reserve(fee_xmr) + DUST_XMR) if dag_enabled else (DUST_XMR * 2)
    # Round the floor UP so every output is genuinely at least min_each after
    # quantisation -- rounding it down could leave an output a tick short of
    # funding its hop.
    min_each = min_each.quantize(DUST_XMR, rounding=ROUND_UP)
    floor_total = min_each * Decimal(fanout_count)
    if budget < floor_total:
        return []                       # cannot fund this many viable outputs
    remainder = budget - floor_total
    weights = [rng.random() for _ in range(fanout_count)]
    wsum = sum(weights) or 1.0
    amounts = []
    for w in weights:
        share = (remainder * (Decimal(str(w)) / Decimal(str(wsum)))).quantize(
            DUST_XMR, rounding=ROUND_DOWN)
        amounts.append(min_each + share)
    return amounts


def select_fanout_targets(mix_targets: list, decoy_addrs: set,
                          wallets: int, num_decoys: int) -> tuple:
    """Choose which subaddresses the fan-out funds, and which of those HOP.

    Returns (fanout_dests, hop_sources). Extracted from stage 4 so a test drives
    the real selection instead of a copy.

    KERCKHOFFS: this must hold even when the algorithm is fully public. An
    EARLIER design funded `num_decoys` extra outputs and then had them DEAD-END
    (excluded from hop_sources). That is self-defeating once the code is known:
    the rule "decoys never hop" means an analyst who reads it -- or simply
    waits out the one confirmation-gated hop round (~20 min) -- identifies the
    decoys as exactly the outputs that never moved, filters them, and follows
    only the ones that hopped. A behavioural class marker ("this output type
    never moves") is a trace recipe the moment the algorithm is public.

    So EVERY fan-out output hops: hop_sources == fanout_dests. Decoys are not a
    distinguishable class; they are simply extra mix outputs indistinguishable
    from the rest, and knowing there are `num_decoys` of them reveals nothing
    about WHICH outputs they are or where the funds go. `decoy_addrs` is
    accepted for signature compatibility but no longer changes behaviour.

    mix_targets is expected pre-shuffled by the caller.
    """
    target_count = wallets + num_decoys
    fanout_count = min(len(mix_targets), target_count)
    fanout_dests = list(mix_targets[:fanout_count])
    hop_sources = list(fanout_dests)     # every output hops -- no dead-end tell
    return fanout_dests, hop_sources


def build_peel_plan(entry_index: int, change_index: int,
                    dests: list, amounts: list,
                    carriers: list = None, remainders: list = None) -> list:
    """A PEELING CHAIN: N single-destination transactions instead of one
    N-output fan-out.

    The fan-out's unavoidable weakness is that its N outputs are created in ONE
    transaction, so an analyst who spots that transaction sees the whole output
    set co-created and can follow it as a group. A peeling chain removes that:
    it sends to ONE mix subaddress per transaction and lets the remainder carry
    to the next, so the N mix outputs appear in N SEPARATE transactions spread
    over time, never co-created.

    ROTATING CARRIERS. Peel 0 spends ENTRY; every later peel spends a FRESH
    carrier subaddress that the previous peel paid explicitly.

    The obvious implementation -- and the one this replaces -- let the change
    fall where monerod puts it and spent that. Verified against real monerod
    0.18, spending from subaddr i returns the change to the ACCOUNT'S
    SUBADDRESS 0, so "spend the previous peel's change" means every peel after
    the first spends subaddress 0. For an 8-destination chain that is subaddr 0
    spent 7 times: one address, spent over and over, with each spend consuming
    the output the previous one created.

    That is a hub, and against anyone holding the view key it is not a
    probabilistic weakness, it is a walk. Spot any peel, follow its change
    input backwards, and every hop lands on the same address until you reach
    the origin -- recovering the whole chain and the entry. A repeated spender
    is also the single most reliable change heuristic there is, so the same
    address is simultaneously labelled "this wallet's change" for free. The
    peel mode existed to beat fan-out clustering, and it did, while building a
    cleaner signal in its place.

    So the remainder is now paid FORWARD as an explicit destination to a fresh
    carrier instead of being left to become change:

        peel i:  spend carrier[i-1]  ->  [ dests[i], carrier[i] ]

    Each carrier is spent exactly once, no address is spent more than twice,
    and subaddress 0 is never spent at all. The chain still walks -- an output
    still funds the next transaction -- but it walks across N distinct
    one-time addresses instead of collapsing onto one, so there is no repeated
    spender to anchor on and no single address that names the wallet.

    HONEST LIMIT: monerod still creates its own change output for whatever the
    real fee leaves over, and that dust still lands on subaddress 0. It is
    never spent here, so it cannot be walked, but an analyst with the view key
    does see several small outputs arriving at one address. That is a
    common-receiver correlation, weaker than a spend-walk and not zero. Only
    sweep_all is genuinely zero-change, and sweep_all cannot also pay a
    destination.

    Because each peel spends an output the previous peel created, the peels are
    necessarily SEQUENTIAL and CONFIRMATION-GATED (unspendable until ~10 blocks
    later) -- which is what spreads them over time. The caller runs each peel
    as its own gated round.

    `carriers` is a list of (address, subaddress_index) for the fresh carriers,
    one per peel; the last peel needs none and any extra is ignored.
    `remainders[i]` is what peel i forwards to carrier i. Pure and
    deterministic; returns core entries the caller decorates with the src
    address, a per-peel delay and tx 'extra'. Returns [] for no dests.
    """
    n = min(len(dests), len(amounts))
    if n <= 0:
        return []
    carriers = list(carriers or [])
    remainders = list(remainders or [])
    plan = []
    for i in range(n):
        if i == 0:
            src_idx = entry_index
        elif i - 1 < len(carriers):
            src_idx = carriers[i - 1][1]
        else:
            # No carrier was provisioned for this hop. Falling back to
            # change_index would silently rebuild the exact hub this function
            # exists to remove, so refuse instead.
            raise ValueError(
                f"peel {i} has no carrier to spend: {len(carriers)} carrier(s) "
                f"provided for {n} peels (need at least {n - 1}). Refusing to "
                f"fall back to subaddress 0, which would rebuild the hub.")
        entry = {
            "src_index": src_idx,
            "dst": dests[i],
            "amt": str(amounts[i]),
            "peel_num": i,
        }
        # Every peel but the last carries the remainder forward explicitly.
        if i < n - 1 and i < len(carriers) and i < len(remainders) \
                and remainders[i] is not None and Decimal(str(remainders[i])) > 0:
            entry["destinations"] = [
                {"address": dests[i], "amount": str(amounts[i])},
                {"address": carriers[i][0], "amount": str(remainders[i])},
            ]
            entry["carrier"] = carriers[i][0]
            entry["carrier_index"] = carriers[i][1]
        plan.append(entry)
    return plan


def parse_swap_route(route: dict) -> tuple:
    """Extract (deposit_addr, memo, expected_output_str) from ONE SwapKit route.

    Extracted from the inlined stage2 loop so tests exercise the actual code
    rather than a copy. The `nullsafe:` block in test_units.py used to assert on
    a hand-written parse_route(); reverting the real function would not have
    turned that test red. Same defect appeared in thor_swap_preparer -- both
    call this now.

    Uses `x or fallback` NOT `dict.get(k, default)` because SwapKit routinely
    returns these keys PRESENT with a null value: .get("transaction", {}) hands
    back None (not the default) for a null value, then .get() on None raises
    AttributeError. `or` collapses missing AND null to the safe fallback.
    """
    tx_info = route.get("transaction") or route.get("calldata") or {}
    deposit = tx_info.get("depositAddress") or tx_info.get("to") or ""
    memo = tx_info.get("memo") or tx_info.get("data") or ""
    expected = route.get("expectedOutput") or "0"
    return deposit, memo, expected


def validate_swap_route(deposit_addr, memo, xmr_dest: str, idx: int,
                        allow_unbound_memo: bool = False) -> None:
    """Refuse a swap quote that would send the operator's BTC into a black hole.

    Every check here guards an IRREVERSIBLE payment, and this whole function is
    the fix for a real defect: GhostSpiral's stage 2 validated the deposit
    address and then printed "Send N BTC to <addr> with memo <memo>" without
    ever checking the memo -- while thor_swap_preparer, fetching the same
    quotes from the same API, refused to print exactly those instructions
    unless the memo named the operator's own address. The safe path and the
    unsafe path were the same operation in one repo.

    Three ways a quote can cost the operator everything:
      * no deposit address, or one that is not a real BTC address -- the funds
        go nowhere recoverable;
      * NO memo at all -- a BTC->XMR swap is routed entirely by the memo, so
        BTC paid into the shared inbound vault without one is not routed to
        anybody, least of all you;
      * a memo naming a DIFFERENT address -- the vault is shared, so the swap
        delivers your sender's money to whoever that address belongs to.

    Raises SystemExit with an operator-readable reason; never returns on
    failure. Amounts and the full address stay out of the integrity log.
    """
    if not deposit_addr:
        integrity_log("stage2", f"no_deposit_in_route_{idx}")
        sys.exit(f"[!] Chunk {idx}: the route carries no deposit address.")
    dep = str(deposit_addr)
    # A typo'd-but-in-charset address passes the regex alone, so the checksum
    # is verified too: this string is about to be handed to somebody as "send
    # real bitcoin here".
    if not BTC_RE.match(dep) or not bech32_checksum_ok(dep):
        integrity_log("stage2", f"bad_deposit_format_{idx}")
        sys.exit(
            f"[!] Chunk {idx}: the deposit address failed bech32 checksum\n"
            f"    validation: {scrub_address(dep)}\n"
            f"    The API response shape may have changed. Refusing to tell you to\n"
            f"    send BTC to an address this tool could not verify."
        )
    if not memo:
        integrity_log("stage2", f"no_memo_{idx}")
        sys.exit(
            f"[!] Chunk {idx}: the quote returned NO memo. A BTC->XMR swap is\n"
            f"    routed entirely by the memo -- BTC sent to the inbound vault\n"
            f"    without one is not routed to you and cannot be recovered.\n"
            f"    Refusing to issue deposit instructions."
        )
    if not memo_binds_destination(memo, xmr_dest):
        integrity_log("stage2", f"memo_dest_mismatch_{idx}")
        if not allow_unbound_memo:
            sys.exit(
                f"[!] Chunk {idx}: the returned memo does NOT contain your XMR\n"
                f"    destination {scrub_address(xmr_dest)}.\n"
                f"    The memo is what tells ThorChain where to deliver the XMR, and\n"
                f"    the deposit address is a SHARED inbound vault -- following these\n"
                f"    instructions could pay someone else, irreversibly. Refusing.\n"
                f"    Override only if you have verified the memo by hand:\n"
                f"    --allow-unbound-memo"
            )
        print(f"  [!] Chunk {idx}: memo does not name your destination — continuing "
              f"because --allow-unbound-memo was given. VERIFY IT BY HAND.")


def parse_jm_amounts(stdout: str, dest: str) -> List[Decimal]:
    """Best-effort parse of JoinMarket tumbler stdout for BTC amounts sent to
    `dest`, returned as BTC Decimals (empty if nothing recognisable).

    JoinMarket's tumbler/sendpayment reports the coins it moves either in BTC
    ('... 0.12345678 BTC ...') or in satoshi ('sending 12345678 sats to <addr>').
    We only trust lines that also reference `dest`, so unrelated amounts in the
    log aren't picked up. FORMAT-DEPENDENT: validate against the JoinMarket
    version in use -- the caller fails loudly if this returns nothing after a
    tumble, rather than silently pretending JoinMarket contributed (the old
    behaviour). Deduplicated, since a summary line may repeat a per-tx amount.
    """
    amounts: List[Decimal] = []
    seen = set()
    for line in stdout.splitlines():
        if dest not in line:
            continue
        for m in re.findall(r"(\d+\.\d{1,8})\s*BTC", line, re.I):
            v = Decimal(m)
            if v > 0 and str(v) not in seen:
                seen.add(str(v)); amounts.append(v)
        for m in re.findall(r"(\d{4,})\s*sat", line, re.I):
            v = (Decimal(m) / Decimal(10 ** 8))
            if v > 0 and str(v) not in seen:
                seen.add(str(v)); amounts.append(v)
    return amounts


def create_subs(rpc, n: int, decoys: int, acct_idx: int = 0) -> tuple:
    """Returns (address_list, {address: subaddress_index}, decoy_address_set).

    Uses new_subaddress_indexed (not new_subaddress) so each address's
    real subaddress index is known. transfer_split needs that index in
    'subaddr_indices' to actually restrict spending to the one
    subaddress a plan TX names as 'src' -- without it, monero-wallet-rpc
    pools funds from every subaddress in the account and the per-hop
    mixing the DAG plan is built around never happens on-chain.

    The Mix_/Decoy_ labels are LOCAL ONLY -- on-chain every subaddress is an
    indistinguishable one-time key, and nothing derived from the label reaches
    a transaction.

    The extra outputs are FUNDED real fan-out outputs, and (since the Kerckhoffs
    pass) they HOP like every other output rather than dead-ending. This
    docstring used to say they "DEAD-END (they never hop)", which was both stale
    and the trace recipe itself: if extra outputs never hop, an analyst who has
    read this file filters the fan-out by "did it move again?" and recovers the
    real mixing path exactly. select_fanout_targets now returns every output as
    a hop source, so that filter selects nothing.
    """
    subs = []
    addr_index = {}
    decoy_addrs = set()
    for i in range(n):
        addr, idx = rpc.new_subaddress_indexed(account_index=acct_idx, label=f"Mix_{i}")
        subs.append(addr)
        addr_index[addr] = idx
    for d in range(decoys):
        addr, idx = rpc.new_subaddress_indexed(account_index=acct_idx, label=f"Decoy_{d}")
        subs.append(addr)
        addr_index[addr] = idx
        decoy_addrs.add(addr)
    return subs, addr_index, decoy_addrs


def _src_index(addr_index: dict, addr: str) -> int:
    """Resolve a source address to its real subaddress index, or abort.

    transfer_split gets this in 'subaddr_indices' to restrict spending to
    exactly the one subaddress the plan names as 'src'. A silent fallback
    to 0 here would instead spend from the primary subaddress (which holds
    the bulk of the funds) -- the OPPOSITE of the intended per-hop mixing,
    and invisible to the operator. Every source we plan is created in
    create_subs (or is ENTRY, set explicitly above), so a miss is a real
    internal bug: fail loudly rather than silently spend the wrong output.
    """
    if addr not in addr_index:
        integrity_log("stage4", "src_index_missing")
        sys.exit(
            f"[!] Internal error: no subaddress index recorded for source "
            f"{scrub_address(addr)}. Refusing to build a TX that could spend "
            f"from the wrong subaddress."
        )
    return addr_index[addr]


def xmr_balance(rpc_primary, bal_account: int,
                entry_index: int) -> tuple[Decimal, Decimal]:
    """Return (total, unlocked) for ENTRY's subaddress in XMR.

    Scoped to ENTRY's subaddress index, NOT the whole account. Fan-out
    spends only from ENTRY (transfer_split subaddr_indices=[entry_index]),
    so sizing the plan off an account-wide balance that also counted funds
    parked on other subaddresses would let fanout_amt exceed what ENTRY can
    actually spend, and every fan-out TX would fail 'not enough money'.
    A refresh is forced first so freshly-arrived outputs are reflected.
    """
    try:
        rpc_primary.raw_request("refresh", {})
    except Exception:
        pass  # refresh is best-effort; background sync still applies
    tot_atomic, unlk_atomic = rpc_primary.get_subaddress_balance(bal_account, entry_index)
    total = Decimal(str(tot_atomic)) / Decimal(10 ** 12)
    unlocked = Decimal(str(unlk_atomic)) / Decimal(10 ** 12)
    return total, unlocked


def stage1_joinmarket(args, btc_addr: str) -> List[Decimal]:
    if not args.joinmarket:
        integrity_log("stage1", "JM_skipped")
        return []
    if not args.joinmarket_wallet:
        sys.exit("[!] --joinmarket-wallet required when --joinmarket is set")
    try:
        # JoinMarket has its own Tor config in joinmarket.cfg, but we pass
        # --socks5-host/port to be explicit (JM >= 0.9 supports this).
        # Without this, JM may resolve maker addresses over clearnet.
        from urllib.parse import urlparse as _urlparse
        _parsed_proxy = _urlparse(args.tor_proxy)
        result = subprocess.run(
            ["python3", "tumble.py",
             "--socks5-host", _parsed_proxy.hostname or "127.0.0.1",
             "--socks5-port", str(_parsed_proxy.port or 9050),
             args.joinmarket_wallet, btc_addr, "all"],
            check=True, capture_output=True, text=True, timeout=3600,
            env=_child_env(),   # third-party child: password scrubbed
        )
        integrity_log("stage1", "JM_tumble_OK")
        # Recover the BTC amounts the tumbler sent to btc_addr and hand them
        # to Stage 2 as the chunks to swap. If the tumble ran but nothing is
        # parseable, FAIL LOUDLY -- the old code returned [] here and the
        # pipeline silently continued as though JoinMarket contributed
        # nothing, which is worse than stopping.
        amounts = parse_jm_amounts(result.stdout, btc_addr)
        if amounts:
            integrity_log("stage1", f"JM_parsed:{len(amounts)}_outputs")
            print(f"  [+] JoinMarket sent {len(amounts)} output(s) totaling "
                  f"{sum(amounts)} BTC to {scrub_address(btc_addr)}")
            return amounts
        integrity_log("stage1", "JM_parse_empty")
        sys.exit(
            "[!] JoinMarket tumble completed but no output amount could be\n"
            "    parsed from its result. Refusing to continue as if the tumble\n"
            "    fed nothing into the pipeline. Inspect tumble.py output; if the\n"
            "    coins did move, re-run supplying the tumbled total via\n"
            "    --btc-amount, or update parse_jm_amounts for your JM version."
        )
    except subprocess.TimeoutExpired:
        integrity_log("stage1", "JM_timeout")
        sys.exit("[!] JoinMarket tumble timed out after 1 hour")
    except FileNotFoundError:
        integrity_log("stage1", "JM_not_found")
        sys.exit("[!] tumble.py not found - JoinMarket not installed?")
    except subprocess.CalledProcessError as e:
        integrity_log("stage1", f"JM_fail:{e.returncode}")
        sys.exit(f"[!] JoinMarket tumble failed (exit {e.returncode})")


def stage2_get_swap_quotes(args, proxy, chunks: List[Decimal],
                           xmr_dest: str) -> List[dict]:
    """Get ThorChain swap quotes via SwapKit API for each BTC chunk.

    Uses the REAL SwapKit v3 API (https://docs.swapkit.dev):
      POST /v3/quote
      Body: {sellAsset, buyAsset, sellAmount, destinationAddress}
      Response: {quoteId, routes: [{..., expectedOutput, depositAddress, memo}]}

    Returns list of deposit instructions for the operator.
    The operator must MANUALLY send BTC to each deposit address.
    """
    # One oracle fetch for the batch. None = unreachable, which DISABLES
    # the cross-check loudly rather than measuring against an invented rate.
    btc_per_xmr = btc_per_xmr_oracle(proxy, getter=safe_get)
    if btc_per_xmr is None:
        print("  [!] Price oracle unreachable — the slippage cross-check is "
              "DISABLED for this batch. Verify each quote by hand.")

    deposits = []
    for i, amt in enumerate(chunks):
        if shutdown_requested():
            integrity_log("stage2", f"shutdown_at_chunk_{i}")
            sys.exit("[!] Shutdown requested during quote fetch.")

        if amt <= Decimal(0):
            continue

        if i > 0:
            newnym(required=True)   # per-chunk quote isolation
            secure_delay(3.0, 10.0)

        # SwapKit v3 API uses sellAsset/buyAsset not from/to
        payload = {
            "sellAsset": "BTC.BTC",
            "buyAsset": "XMR.XMR",
            "sellAmount": str(amt),
            "destinationAddress": xmr_dest,
        }

        try:
            quote_resp = safe_post(f"{SWAPKIT_API}/v3/quote", payload, proxy)
        except Exception as e:
            newnym()
            integrity_log("stage2", f"quote_api_error:{i}")
            sys.exit(f"[!] SwapKit quote API failed for chunk {i}: {str(e)[:60]}")

        # Parse the routes from the response
        routes = quote_resp.get("routes", [])
        if not routes:
            error = quote_resp.get("error", "unknown")
            provider_errors = quote_resp.get("providerErrors", [])
            integrity_log("stage2", f"no_routes_chunk_{i}")
            sys.exit(
                f"[!] No swap routes available for chunk {i}.\n"
                f"    Error: {str(error)[:80]}\n"
                f"    Provider errors: {str(provider_errors)[:120]}"
            )

        # Use the first (best) route. NOTE: use `or` fallbacks, not dict
        # .get() defaults: the API often returns these keys PRESENT but
        # null, and .get("k", default) returns None (not the default) when
        # the key exists with a null value. `route.get("transaction", {})`
        # would then hand back None and the next .get() raises
        # AttributeError; Decimal(str(None)) raises InvalidOperation. `or`
        # collapses both missing AND null to the safe fallback.
        route = routes[0]
        # Single call to the extracted parser -- so a regression in null-
        # handling here is caught by the test that drives parse_swap_route,
        # not just documented in a comment. See parse_swap_route above.
        deposit_addr, memo, expected_output = parse_swap_route(route)

        # ONE gate for every way this quote can cost the operator their
        # money -- missing/garbage deposit address, no memo, or a memo
        # naming somebody else's address. Shared shape with
        # thor_swap_preparer so the two swap paths cannot diverge again.
        validate_swap_route(deposit_addr, memo, xmr_dest, i,
                            allow_unbound_memo=args.allow_unbound_memo)

        try:
            expected_dec = Decimal(str(expected_output))
        except Exception:                                 # noqa: BLE001
            expected_dec = Decimal(0)
        if expected_dec <= 0:
            # A silent 0 here defeats the slippage cross-check below AND
            # prints "Expected: ~0 XMR" in the deposit instructions. Say so;
            # it usually means the route field name changed.
            integrity_log("stage2", f"expected_output_unreadable_{i}")
            print(f"  [!] Chunk {i}: could not read the expected XMR from the "
                  f"quote (the route field name may have changed) — the "
                  f"slippage check is DISABLED for it.")

        # Same cross-check thor_swap_preparer applies, from the same shared
        # helper: a quote wildly off the market rate is either a bad route
        # or a stale oracle, and neither should be handed to a sender
        # unexamined. Deviation is a ratio, never the amounts themselves,
        # so nothing linkable reaches the integrity chain.
        dev = quote_deviation(expected_dec, amt, btc_per_xmr)
        if dev is not None:
            if dev > args.max_slippage:
                integrity_log("stage2", f"slippage_ABORT_{i}:dev={dev:.4f}")
                sys.exit(
                    f"[!] Chunk {i}: the quote is {dev * 100:.1f}% away from the\n"
                    f"    price oracle, past the --max-slippage limit of\n"
                    f"    {args.max_slippage * 100:.0f}%. That is either a bad route\n"
                    f"    or a stale oracle — either way, not something to hand a\n"
                    f"    sender unexamined. Raise --max-slippage only after\n"
                    f"    checking the rate yourself."
                )
            if dev > Decimal("0.05"):
                integrity_log("stage2", f"slippage_warn_{i}:dev={dev:.4f}")
                print(f"  [!] Chunk {i}: quote deviates {dev * 100:.1f}% from the oracle.")

        deposit_info = {
            "chunk": i,
            "btc_amount": str(amt),
            "deposit_address": deposit_addr,
            "memo": str(memo),
            "expected_xmr": str(expected_dec),
            "quote_id": quote_resp.get("quoteId", ""),
        }
        deposits.append(deposit_info)

        print(f"  [*] Chunk {i}/{len(chunks)-1}:")
        print(f"      Send {amt} BTC to: {scrub_address(deposit_addr)}")
        # validate_swap_route has already refused an absent or unbound memo,
        # so this always prints and always names the operator's own address.
        print(f"      With memo: {str(memo)[:40]}...")
        print(f"      Expected: ~{expected_dec} XMR")
        integrity_log("stage2", f"quote_ready:{i}")

        secure_delay(5.0, 15.0)

    return deposits


def build_cli() -> argparse.ArgumentParser:
    """Every command-line option GhostSpiral accepts, in one place.

    Pulled out of main() so the flag surface can be read, diffed and tested
    on its own. It was 75 lines wedged between install_signal_handlers() and
    the password handling -- which is how --max-slippage and
    --allow-unbound-memo could sit beside --allow-clearnet-relay while the
    swap path behind them had no memo check at all.

    Returns the parser, not parsed args, so tests can inspect defaults and
    mutual exclusivity without driving a pipeline run.
    """
    cli = argparse.ArgumentParser(
        "GhostSpiral v10.5",
        description="BTC->XMR mixing pipeline with Tor, ThorChain, and JoinMarket support",
    )

    mode_group = cli.add_mutually_exclusive_group(required=True)
    mode_group.add_argument("--btc-entry",
                            help="BTC entry address (bech32) — SENDER mode: you own the BTC")
    mode_group.add_argument("--receive-wallet",
                            help="gs_receive_wallet_v1 JSON from create_receive_wallet — "
                                 "RECEIVER mode: XMR already arrived on this address")

    cli.add_argument("--tor-proxy", required=True,
                     help="SOCKS5 proxy (e.g. socks5h://127.0.0.1:9050)")
    cli.add_argument("--joinmarket", action="store_true",
                     help="Enable JoinMarket tumble before ThorChain swap")
    cli.add_argument("--split", type=int, default=1,
                     help="Number of BTC chunks to split across ThorChain")
    cli.add_argument("--btc-amount", type=Decimal,
                     help="Total BTC amount for ThorChain swap "
                          "(required when --split > 0 in sender mode)")
    cli.add_argument("--wallets", type=int, default=10,
                     help=f"Number of mix wallets (min {MIN_WALLETS})")
    cli.add_argument("--deep", type=int, default=2,
                     help=f"Depth multiplier for DAG edges (min {MIN_DEEP})")
    cli.add_argument("--rpc-primary", default="http://127.0.0.1:18083",
                     help="Primary monero-wallet-rpc endpoint")
    cli.add_argument("--rpc-alt",
                     help="Fallback monero-wallet-rpc endpoint")
    cli.add_argument("--output", default="./unsigned",
                     help="Output directory for unsigned TX plans")
    cli.add_argument("--joinmarket-wallet",
                     help="JoinMarket wallet file for tumbles")
    cli.add_argument("--fee-priority", type=int, choices=[1, 2, 3, 4], default=1,
                     help="Monero fee priority: 1=default, 2=x4, 3=x20, 4=x166")
    cli.add_argument("--dag-mixing", action="store_true",
                     help="Enable the second-round DAG hop-mixing across mix "
                          "subaddresses. This REQUIRES waiting for the fan-out "
                          "round to confirm on-chain (~10 blocks) before the hop "
                          "TXs can be created, so a run takes ~20+ min longer. "
                          "Off by default: the default run does the fan-out "
                          "distribution only (fast, and still spreads funds "
                          "across fresh subaddresses).")
    cli.add_argument("--peel", action="store_true",
                     help="PEELING CHAIN instead of a single fan-out: distribute "
                          "to the mix subaddresses ONE PER TRANSACTION, each "
                          "spending the previous transaction's change, so the "
                          "outputs are created in N separate transactions spread "
                          "over time rather than co-created in one fan-out tx an "
                          "analyst can cluster. MUCH SLOWER: every peel is "
                          "confirmation-gated (~10 blocks each), so N peels take "
                          "roughly N * 20 min. Strongest unlinkability; use for "
                          "high-value sends where time is not a constraint.")
    cli.add_argument("--wallet-file", default="offline.wallet",
                     help="Path to Monero wallet file for auto-mode signing")
    cli.add_argument("--wallet-password", default="",
                     help="Password for the wallet file (empty for no password). "
                          "PREFER GS_WALLET_PASSWORD=... in the environment: an "
                          "argv password is world-readable via ps and "
                          "/proc/<pid>/cmdline (mode 444).")
    cli.add_argument("--max-slippage", type=Decimal, default=Decimal("0.25"),
                     help="refuse a swap quote deviating more than this fraction from "
                          "an independent price oracle (default 0.25 = 25%%). 5%% still "
                          "only warns; this is the hard stop. When the oracle is "
                          "unreachable the cross-check is disabled and said so loudly.")
    cli.add_argument("--allow-unbound-memo", action="store_true",
                     help="proceed even when a swap quote's memo does not contain your "
                          "XMR destination. ONLY for a genuine aggregator format change "
                          "-- normally it means the swap would deliver to someone else's "
                          "address, irreversibly.")
    cli.add_argument("--allow-clearnet-relay", action="store_true",
                     help="Proceed even when monerod is verified to relay to raw-IP "
                          "peers. Every transaction this run creates would then be "
                          "broadcast from your IP.")
    cli.add_argument("--rpc-daemon", default="http://127.0.0.1:18081",
                     help="monerod daemon RPC endpoint for broadcast (NOT wallet-rpc)")
    return cli


def resolve_wallet_password(args) -> None:
    """Take the wallet password from the environment, never from argv.

    argv is world-readable: any local user can read /proc/<pid>/cmdline or run
    ps. The environment is not a secret store either, but it is not published
    to every process on the box the way a command line is. Env wins over argv,
    matching airgap_tx_signer, and using argv warns loudly rather than silently
    accepting a password that has already leaked to every user on the machine.

    Mutates args in place, the way the pipeline already expects.
    """
    # Prefer the environment over argv for the wallet password (see the
    # --wallet-password help and the env handoff in _stage5_run). Same
    # precedence rule the signer uses, so the two agree.
    _env_pw = os.environ.get("GS_WALLET_PASSWORD")
    if _env_pw is not None:
        args.wallet_password = _env_pw
    elif args.wallet_password:
        print("  [!] --wallet-password puts the wallet password on this "
              "process's argv, where any local user can read it via ps or "
              "/proc/<pid>/cmdline. Prefer GS_WALLET_PASSWORD=... instead.")
        integrity_log("main", "warn:password_on_argv")
    return None


def resolve_entry_mode(args) -> tuple:
    """Decide where this run's money comes IN, and validate that source.

    Two mutually exclusive entries: a receive bundle (XMR is already on a
    subaddress we own) or a BTC address to tumble and swap. Returns
    (receive_mode, entry_addr, account_index, subaddress_index) -- for the BTC
    path the last three are None/0 and ENTRY is created later in stage 3.

    Both branches fail closed. The bundle goes through the one shared strict
    loader; the BTC address is checked with a real bech32 checksum, not just
    the charset regex, because a single flipped character is in-charset and
    would send a tumble somewhere unrecoverable.
    """
    # ---- Determine mode ----
    receive_mode = bool(args.receive_wallet)
    receive_entry_addr = None
    receive_account_index = 0
    receive_subaddress_index = 0

    if receive_mode:
        # ONE strict loader, shared with receive_watch and thor_swap_preparer
        # (gs_common.load_receive_bundle). The inline parse this replaces did
        # `rw_data.get("subaddress_index") or 0`, so a bundle missing the index
        # silently became subaddress 0 -- the account's primary AND change
        # address -- and the pipeline would have used the change carrier as its
        # entry without reporting anything wrong.
        try:
            rw_data = load_receive_bundle(args.receive_wallet)
        except ValueError as e:
            sys.exit(f"[!] {e}")
        receive_entry_addr = rw_data["address"]
        receive_account_index = rw_data["account_index"]
        receive_subaddress_index = rw_data["subaddress_index"]
        integrity_log("stage0", f"receive_mode:entry={scrub_address(receive_entry_addr)}")
        print(f"  [*] RECEIVER MODE: XMR entry address = {scrub_address(receive_entry_addr)}")
        if args.joinmarket:
            sys.exit("[!] --joinmarket is not applicable in receiver mode (no BTC to tumble)")
    else:
        # BTC_RE + bech32 checksum, matching every other BTC-address consumer
        # in the codebase (stage2 deposit validation, thor_swap_preparer).
        # BTC_RE alone accepts a typo'd-but-in-charset address; combined with
        # bech32_checksum_ok this rejects a single-character flip that would
        # otherwise reach the JoinMarket tumbler and waste the tumble.
        if not BTC_RE.match(args.btc_entry) or not bech32_checksum_ok(args.btc_entry):
            sys.exit("[!] Invalid BTC entry address: failed bech32 checksum "
                     "(expected bc1.../tb1... with a valid checksum)")
        integrity_log("stage0", "btc_entry_validated")
    return (receive_mode, receive_entry_addr, receive_account_index,
            receive_subaddress_index)


def stage0_preflight(args, proxy) -> tuple:
    """Every gate that must hold BEFORE this run is allowed to touch money.

    These checks were spread through 60 lines of main(), interleaved with
    wallet setup, so "what does GhostSpiral actually verify before it spends?"
    could only be answered by reading the whole function. Collected here so an
    auditor -- or the operator following OPSEC_SETUP.md -- can read the gate
    stack in one place and see that nothing skips it.

    In order:
      * free disk and RAM, so a plan is not written half-way onto a full disk;
      * Tor verified as a REAL Tor exit, not merely a reachable SOCKS port;
      * monerod relay egress -- the transaction leaves over monerod's peer
        connections, so a Tor-routed wallet-rpc in front of a clearnet-relaying
        daemon still broadcasts from the operator's IP. Checked at startup,
        not at broadcast time, because by then the plan exists and the
        temptation is to send it anyway;
      * wallet-rpc reachable AND synced, so balances are real;
      * a live fee estimate, which refuses an implausible one rather than
        sizing a spend off a fresh/offline chain's numbers.

    Returns (rpc_primary, rpc_alt, fee_xmr). Any failure exits; nothing here
    returns a degraded value that a later stage could mistake for success.
    """
    # ---- Stage 0: Environment checks ----
    require_resources(min_disk_gb=2.0)
    verify_tor(proxy)
    integrity_log("stage0", "tor_ok")

    # Relay egress is checked HERE, at startup -- not at broadcast time. The
    # transaction leaves the machine over monerod's peer connections, so a
    # clearnet-relaying daemon deanonymises the whole run no matter how well
    # this process is proxied. Discovering that at the broadcast step would mean
    # refusing AFTER the fan-out, the on-chain confirmation wait (up to an hour)
    # and the signing -- leaving signed transactions on disk and the operator's
    # time wasted. Fail before any of that happens.
    egress = check_daemon_relay_egress(args.rpc_daemon, proxy)
    integrity_log("stage0", f"relay_egress:{egress['verdict']}")
    if egress["verdict"] == "clearnet":
        print(f"  [!] RELAY EGRESS IS CLEARNET: {egress['detail']}")
        if not args.allow_clearnet_relay:
            sys.exit(
                "[!] Aborting BEFORE any work is done. Your monerod is relaying to\n"
                "    raw-IP peers, so every transaction this run creates would be\n"
                "    broadcast from your IP — defeating the entire mixing pipeline.\n"
                "    Fix: restart monerod with --tx-proxy tor,127.0.0.1:9050\n"
                "    Override only if you understand the exposure: --allow-clearnet-relay"
            )
        print("  [!] --allow-clearnet-relay given; proceeding DESPITE clearnet egress.")
    elif egress["verdict"] == "offline":
        sys.exit(f"[!] {egress['detail']} — every broadcast this run would silently "
                 f"go nowhere. Start monerod without --offline.")
    elif egress["verdict"] == "tor":
        print(f"  [+] Relay egress verified anonymous: {egress['detail']}")
    else:
        print(f"  [!] Could NOT verify relay egress ({egress['detail']}).")
        print("  [!] Treat the broadcast as clearnet unless you configured "
              "monerod --tx-proxy.")

    # Fee estimation done after RPC is connected (needs the RPC)
    integrity_log("stage0", "env_checks_ok")

    rpc_primary = connect_rpc(args.rpc_primary, proxy_url=args.tor_proxy)
    rpc_alt = connect_rpc(args.rpc_alt, proxy_url=args.tor_proxy) if args.rpc_alt else None

    # Sync guard: wait for nodes to agree on height
    for attempt in range(30):
        if shutdown_requested():
            sys.exit("[!] Shutdown requested during sync wait.")
        try:
            h1 = rpc_primary.raw_request("get_height", {})["height"]
            if rpc_alt:
                h2 = rpc_alt.raw_request("get_height", {})["height"]
                if abs(h1 - h2) <= 2:
                    break
            else:
                if h1 > 0:
                    break
        except Exception as e:
            integrity_log("stage0", f"rpc_height_err:{str(e)[:40]}")
        time.sleep(10)
    else:
        sys.exit("[!] RPC nodes out of sync after 5 min; abort.")
    integrity_log("stage0", f"rpc_sync_ok:height={h1}")

    fee_xmr = fetch_fee_from_daemon(args.rpc_daemon, proxy, args.fee_priority)
    integrity_log("stage0", "fee_fetched")
    return rpc_primary, rpc_alt, fee_xmr


def compute_fee_budget(bal: Decimal, fee_xmr: Decimal, wallets: int,
                       deep: int) -> tuple:
    """How much of `bal` is actually spendable once every round's fee is held back.

    Returns (usable, total_fees, rounds). PURE -- no RPC, no logging, no exit --
    so the arithmetic that decides whether a spend is affordable can be tested
    directly instead of only through a live pipeline. The caller decides what an
    unaffordable result means; this function never aborts, because "the budget
    does not work out" is a legitimate answer, not an error.

    Every round is one transaction, so the reserve is per-round fee times
    rounds, with FEE_SAFETY_MARGIN on top: the estimate is taken once at
    startup and the mempool can move under a multi-hour run. Under-reserving
    does not fail early or cheaply -- it fails on the LAST hop with "not enough
    money", after the funds have already been split across subaddresses.
    """
    rounds = wallets * 2 * deep
    per_round_fee = fee_xmr * FEE_SAFETY_MARGIN
    total_fees = per_round_fee * rounds
    return bal - total_fees, total_fees, rounds


def main():
    install_signal_handlers()

    cli = build_cli()
    args = cli.parse_args()

    resolve_wallet_password(args)

    (receive_mode, receive_entry_addr, receive_account_index,
     receive_subaddress_index) = resolve_entry_mode(args)

    # ---- Validate inputs early ----
    args.wallets = max(args.wallets, MIN_WALLETS)
    args.deep = max(args.deep, MIN_DEEP)

    proxy = validate_proxy(args.tor_proxy)

    rpc_primary, rpc_alt, fee_xmr = stage0_preflight(args, proxy)

    ###########################################################################
    # Stage 1 - JoinMarket (optional BTC tumble before ThorChain)
    ###########################################################################
    newnym(required=True)   # anonymity gate before stage 1 network ops

    if receive_mode:
        jm_utxos = []
        integrity_log("stage1", "skipped:receive_mode")
    else:
        jm_utxos = stage1_joinmarket(args, args.btc_entry)
    integrity_log("stage1", f"done:jm_utxos={len(jm_utxos)}")

    ###########################################################################
    # Stage 2 - ThorChain swap definition
    ###########################################################################

    ###########################################################################
    # Stage 3 - Build wallets & DAG (runs BEFORE stage2 invocation so
    # the ENTRY receive address exists for ThorChain destination)
    ###########################################################################
    newnym(required=True)   # anonymity gate before stage 3
    tor_recheck(proxy, "stage3_pre")

    sub_account = receive_account_index if receive_mode else 0

    # Random per-run extra-output count, so the total (wallets + this) is not a
    # deterministic fingerprint of the `wallets` setting under public code.
    _num_decoys = secrets.SystemRandom().randint(DECOY_MIN, DECOY_MAX)
    subs, addr_index, decoy_addrs = create_subs(
        rpc_primary, args.wallets, _num_decoys, acct_idx=sub_account)
    if len(subs) < MIN_WALLETS + 1:
        sys.exit("[!] Failed to create enough subaddresses")

    if receive_mode:
        ENTRY = receive_entry_addr
        if ENTRY in subs:
            subs.remove(ENTRY)
        subs.insert(0, ENTRY)
        addr_index[ENTRY] = receive_subaddress_index
        integrity_log("stage3", "entry_reused_from_receive_wallet")
        print(f"  [+] ENTRY (from receive wallet): {scrub_address(ENTRY)}")
    else:
        ENTRY = subs[0]
        integrity_log("stage3", "entry_created")

    import secrets as _secrets
    _secrets.SystemRandom().shuffle(subs)

    ###########################################################################
    # Stage 2 execution - ThorChain swap (now that ENTRY address exists)
    ###########################################################################
    newnym(required=True)   # anonymity gate before ThorChain execution
    tor_recheck(proxy, "stage2_exec")

    if receive_mode:
        integrity_log("stage2", "skipped:receive_mode:xmr_already_on_entry")
        print(f"\n  [+] RECEIVER MODE: Skipping ThorChain swap (XMR already on entry address).")
        print(f"  [+] Entry address: {scrub_address(ENTRY)}")
    else:
        btc_chunks = []

        if jm_utxos:
            btc_chunks = jm_utxos
        elif args.btc_amount and args.btc_amount > 0:
            num_splits = max(args.split, 1)
            per_chunk = (args.btc_amount / Decimal(num_splits)).quantize(Decimal("0.00000001"))
            btc_chunks = [per_chunk] * num_splits
            remainder = args.btc_amount - (per_chunk * num_splits)
            if remainder > 0:
                btc_chunks[0] += remainder
            # COUNT only, never the per-chunk BTC amount: the integrity log
            # persists, and the exact BTC-per-swap correlates directly with the
            # on-chain BTC deposit and the ThorChain swap it feeds. Same reason
            # the fan-out/hop amounts stay off the chain.
            integrity_log("stage2", f"btc_split:{num_splits}_chunks")
            print(f"\n  [*] Splitting {args.btc_amount} BTC into {num_splits} chunk(s) of ~{per_chunk} BTC")

        if btc_chunks:
            swap_deposits = stage2_get_swap_quotes(args, proxy, btc_chunks, ENTRY)
            integrity_log("stage2", "swap_quotes_generated")
            total_expected = sum(Decimal(d["expected_xmr"]) for d in swap_deposits)
            print(f"\n  [+] {len(swap_deposits)} deposit instruction(s) generated.")
            print(f"  [+] Expected total: ~{total_expected} XMR after swaps")
            print()
            print("  ============================================================")
            print("  SENDER INSTRUCTIONS — send BTC to these deposit addresses:")
            print("  ============================================================")
            for dep in swap_deposits:
                print(f"\n  --- Chunk {dep['chunk']} ---")
                print(f"  Send exactly: {dep['btc_amount']} BTC")
                print(f"  To address:   {dep['deposit_address']}")
                if dep.get("memo"):
                    print(f"  With memo:    {dep['memo']}")
                print(f"  Expected XMR: ~{dep['expected_xmr']}")
            print()
            print("  ============================================================")
            print("  [!] YOU MUST manually send BTC to each deposit address above!")
            print("  [!] Include the memo in the BTC transaction OP_RETURN field!")
            print("  [!] Wait for XMR to arrive and confirm before proceeding!")
            print("  ============================================================")
        else:
            integrity_log("stage2", "manual_mode")
            print(f"\n  [!] MANUAL MODE: No --btc-amount specified.")
            print(f"  [!] Use thor_swap_preparer to generate deposit addresses:")
            print(f"        python3 thor_swap_preparer \\")
            print(f"          --amounts <BTC_AMOUNT> \\")
            print(f"          --dests {scrub_address(ENTRY)} \\")
            print(f"          --tor-proxy {args.tor_proxy}")
            print(f"  [!] Then wait for XMR to arrive at ENTRY before proceeding.")

    dag = {}
    for a in subs:
        others = [b for b in subs if b != a]
        max_k = len(others)
        k = min((_secrets.randbelow(3) + 1) * args.deep, max_k)
        k = max(k, 1)
        chosen = []
        pool = list(others)
        for _ in range(k):
            idx = _secrets.randbelow(len(pool))
            chosen.append(pool.pop(idx))
        dag[a] = chosen
    integrity_log("stage3", "dag_built")

    ###########################################################################
    # Stage 4 - Balance, amounts, plan
    ###########################################################################

    bal_account = receive_account_index if receive_mode else 0
    entry_index = addr_index[ENTRY]  # fan-out spends ONLY from this subaddress

    total_bal, unlocked_bal = xmr_balance(rpc_primary, bal_account, entry_index)

    # Sender mode: the swapped XMR lands on ENTRY only AFTER the operator sends
    # BTC and ThorChain settles (and in manual mode, whenever they send it).
    # ENTRY is fresh this run so a single check here is always ~0 -> abort.
    # Poll for arrival instead. Receiver mode already has funds on ENTRY.
    if not receive_mode and unlocked_bal <= DUST_XMR:
        print(f"  [*] Waiting for swapped XMR to arrive+unlock on ENTRY "
              f"{scrub_address(ENTRY)} (up to {XMR_ARRIVAL_TIMEOUT // 60} min)...")
        waited = 0
        while unlocked_bal <= DUST_XMR and waited < XMR_ARRIVAL_TIMEOUT:
            if shutdown_requested():
                sys.exit("[!] Shutdown requested while waiting for XMR arrival.")
            time.sleep(XMR_ARRIVAL_POLL)
            waited += XMR_ARRIVAL_POLL
            total_bal, unlocked_bal = xmr_balance(rpc_primary, bal_account, entry_index)
            if total_bal > DUST_XMR and unlocked_bal <= DUST_XMR:
                print(f"  [*] Seen {total_bal} XMR total; waiting for it to unlock...")
        # NOT the balance: unlocked_bal is the exact XMR that arrived from the
        # swap, the most linkable amount on the receive side. Log only that
        # arrival completed.
        integrity_log("stage4", "xmr_arrival_done")

    integrity_log("stage4", "balance_fetched")

    if total_bal > unlocked_bal + DUST_XMR:
        print(f"  [!] {total_bal - unlocked_bal} XMR still locked (pending confirmations)")

    bal = unlocked_bal
    if bal <= DUST_XMR:
        sys.exit(
            f"[!] Unlocked balance is {unlocked_bal} XMR (below dust threshold).\n"
            f"    Cannot create a real TX plan without funds.\n"
            f"    Total balance: {total_bal} XMR (may be locked/unconfirmed)."
        )

    usable, total_fees, rounds = compute_fee_budget(bal, fee_xmr, args.wallets,
                                                    args.deep)
    if usable <= DUST_XMR:
        sys.exit(
            f"[!] Balance {bal} XMR insufficient.\n"
            f"    Estimated fees: {total_fees} XMR for {rounds} rounds.\n"
            f"    Usable after fees: {usable} XMR"
        )

    integrity_log("stage4", "plan_calculated")

    # -- Phase A: Fan-out -------------------------------------------------
    # Distribute funds from ENTRY into mix subaddresses. In receiver mode ALL
    # funds sit on ENTRY; in sender mode ThorChain deposits to ENTRY. Either
    # way funds must spread outward before any hop-mixing can source from a
    # mix subaddress. Fan-out sources from ENTRY, which is already funded and
    # confirmed, so this round can always be created in one batch.
    mix_targets = [s for s in subs if s != ENTRY]
    # Fund wallets + a random number of extra outputs; ALL of them hop (no
    # dead-end tell). hop_sources_real == fanout_dests, so no output is a
    # distinguishable class under public code.
    fanout_dests, hop_sources_real = select_fanout_targets(
        mix_targets, decoy_addrs, args.wallets, _num_decoys)
    fanout_count = len(fanout_dests)
    if fanout_count <= 0:
        # Guard the divisor. mix_targets excludes ENTRY, so a degenerate
        # subaddress set (or a create_subs that returned only ENTRY) would
        # divide by zero here and crash with a bare ZeroDivisionError after
        # the wallet work was already done.
        integrity_log("stage4", "no_mix_targets")
        sys.exit("[!] No mix subaddresses available to fan out into "
                 f"(got {len(mix_targets)}). Cannot build a plan.")
    # Unequal, jittered amounts -- see compute_fanout_amounts: identical splits
    # give a chain analyst one value and one shape to cluster and follow.
    fanout_amounts = compute_fanout_amounts(
        usable, fanout_count, fee_xmr, args.dag_mixing, _secrets.SystemRandom())
    if not fanout_amounts:
        sys.exit(
            f"[!] Usable balance {usable} XMR too small to fan out across "
            f"{fanout_count} subaddresses with the fee reserve each output needs. "
            f"Use fewer wallets, disable --dag-mixing, or fund the wallet more."
        )
    # Fan-out is ONE transaction: a single transfer_split from ENTRY's single
    # confirmed output to all fanout_count mix subaddresses at once (one input
    # -> many outputs). Emitting fanout_count SEPARATE TXs from ENTRY would fail
    # for the SAME reason the DAG round is confirmation-gated: ENTRY holds ONE
    # confirmed output (one swap / one deposit), spendable once per batch, so
    # the 2nd..Nth separate TX would fail 'no unlocked output' and abort the run
    # (the change output from TX0 is unconfirmed and unspendable in the batch).
    # Per-destination amount, so each mix subaddress receives its OWN magnitude.
    fanout_by_addr = dict(zip(fanout_dests, fanout_amounts))

    distribution_mode = "peel" if args.peel else "fanout"
    if args.peel:
        # PEELING CHAIN: one transaction per destination, each spending the
        # previous peel's change (which Monero returns to the account's
        # subaddress 0), so the N mix outputs appear in N separate transactions
        # over time instead of co-created in one fan-out an analyst can cluster.
        # ROTATING CARRIERS. One fresh subaddress per hop, so no address is
        # ever spent twice and subaddress 0 is never spent at all. Provisioned
        # here, before the plan is built, because build_peel_plan REFUSES to
        # fall back to subaddress 0 rather than quietly rebuild the hub.
        _peel_amts = [fanout_by_addr[a] for a in fanout_dests]
        _n_peels = len(fanout_dests)
        _carriers = []
        for _c in range(max(0, _n_peels - 1)):
            _addr, _idx = rpc_primary.new_subaddress_indexed(
                account_index=bal_account, label=f"Carrier_{_c}")
            _carriers.append((_addr, _idx))
            addr_index[_addr] = _idx
        # What each peel forwards: everything still to be distributed after
        # this hop's own destination, less a fee reserve per remaining hop.
        # The carrier reserve is deliberately generous. Each hop's fee comes
        # out of the amount the previous hop forwarded, and monerod also needs
        # its own change output to clear dust, so a reserve sized at exactly
        # one fee per hop leaves nothing for fee variance across a chain that
        # runs for hours. The asymmetry decides it: over-reserving costs a
        # slightly smaller final distribution, while under-reserving stops the
        # chain part-way with "not enough money" and strands the remainder on
        # a carrier -- and this pipeline has no auto-resume, so that is a
        # manual recovery. Found on a real chain, where a one-fee-per-hop
        # reserve failed on the second peel.
        _hop_fee = fee_xmr * FEE_SAFETY_MARGIN * PEEL_CARRIER_RESERVE_MULT
        _remainders = []
        for _i in range(max(0, _n_peels - 1)):
            _left = sum(_peel_amts[_i + 1:], Decimal(0))
            _left += _hop_fee * (_n_peels - _i - 1)
            _remainders.append(_left)
        _peel_core = build_peel_plan(
            entry_index=_src_index(addr_index, ENTRY), change_index=0,
            dests=fanout_dests, amounts=_peel_amts,
            carriers=_carriers, remainders=_remainders)
        fanout_plan = []
        for _p in _peel_core:
            _src_addr = ENTRY if _p["peel_num"] == 0 else _carriers[_p["peel_num"] - 1][0]
            _entry = {
                "src": _src_addr,
                "src_index": _p["src_index"],
                "dst": _p["dst"],
                "amt": _p["amt"],
                "delay": _secrets.randbelow(540) + 180,
                "extra": secure_hex(16),
                "peel_num": _p["peel_num"],
            }
            if _p.get("destinations"):
                _entry["destinations"] = _p["destinations"]
                _entry["carrier"] = _p["carrier"]
                _entry["carrier_index"] = _p["carrier_index"]
            fanout_plan.append(_entry)
        integrity_log("stage4", f"peel_plan:{len(fanout_plan)}_peels")
        print(f"  [*] PEELING CHAIN: {len(fanout_plan)} confirmation-gated peels "
              f"(~{len(fanout_plan) * 20} min). Each output is created in its own "
              f"transaction — no co-created fan-out for an analyst to cluster.")
    else:
        fanout_plan = [{
            "src": ENTRY,
            "src_index": _src_index(addr_index, ENTRY),
            "destinations": [{"address": a, "amount": str(fanout_by_addr[a])} for a in fanout_dests],
            "delay": _secrets.randbelow(540) + 180,
            "extra": secure_hex(16),
        }]
        # Log the STRUCTURE (one TX, N destinations) but NOT the per-destination
        # amount. integrity_chain.log persists on disk, and the exact fan-out
        # amount is the single most linkable quantity in the whole pipeline:
        # recovered from the log it correlates directly against the on-chain
        # outputs and unmixes what the fan-out exists to mix. The amount stays
        # in the plan file (0600), off the persistent hash chain.
        integrity_log("stage4", f"fanout_plan:1_tx:{fanout_count}_dests")

    # Subaddresses that will receive a fan-out output, with the (account, index)
    # pair Stage 5 polls to confirm they've unlocked before hop-mixing.
    funded_targets = list(fanout_dests)
    fanout_targets_indexed = [(sub_account, _src_index(addr_index, a))
                              for a in funded_targets]

    # -- Phase B: DAG hop-mixing (opt-in, --dag-mixing) -------------------
    # Each funded mix subaddress hops a chunk of its balance onward to a DAG
    # neighbour. CRITICAL: after fan-out, a mix subaddress holds exactly ONE
    # confirmed output. Monero can spend that output only once per confirmation
    # round, so each subaddress may source AT MOST ONE hop in a single created
    # batch -- source it twice and every hop after the first fails for "no
    # unlocked output". We therefore iterate each funded subaddress once (a
    # permutation), not random-with-replacement. This whole round also cannot
    # be created until the fan-out confirms on-chain, which is why it runs as a
    # separate confirmation-gated round in Stage 5 (see _stage5_run).
    dag_plan = []
    if args.dag_mixing:
        # Hop amount comes from each source's OWN fan-out balance (fanout_amt).
        # Reserve the ACTUAL FEE, not a percentage. The old formula was
        # fanout_amt * 0.85, whose comment claimed the 15% "covers the fee
        # (tiny next to fanout_amt)" -- but the fee is an ABSOLUTE amount while
        # the reserve scales with the hop, so the claim inverts for small
        # fan-outs. With a real daemon fee of ~0.0024 XMR, any fanout_amt below
        # ~0.016 XMR reserved LESS than the fee, and the plan passed every
        # guard here and then failed "not enough money" inside transfer_split --
        # after the fan-out had already executed on-chain and spent its fee,
        # leaving funds scattered mid-pipeline. The dust guard did not catch it:
        # it only required the hop to exceed 0.0001 XMR.
        #
        # Reserve and hop both come from the shared helpers, so the number
        # printed below is the number the arithmetic actually used.
        _hop_reserve = hop_fee_reserve(fee_xmr)
        # EVERY fan-out output hops -- no output has a behavioural tell that a
        # public-code analyst could use to separate "decoy" from "real" (see
        # select_fanout_targets). hop_sources_real is all of them.
        hop_sources = list(hop_sources_real)
        _secrets.SystemRandom().shuffle(hop_sources)
        _unfundable = 0
        for s in hop_sources:
            if shutdown_requested():
                integrity_log("stage4", "shutdown_during_dag_plan")
                break
            # Each source hops onward from its OWN fan-out balance, so the hop
            # amounts stay as unequal as the fan-out that funded them -- no
            # single hop value for an analyst to cluster on.
            src_hop_amt = compute_hop_amount(fanout_by_addr[s], fee_xmr)
            if src_hop_amt <= DUST_XMR:
                _unfundable += 1
                continue
            dst_candidates = [d for d in dag.get(s, mix_targets) if d != s]
            if not dst_candidates:
                continue
            d = dst_candidates[_secrets.randbelow(len(dst_candidates))]
            dag_plan.append({
                "src": s,
                "src_index": _src_index(addr_index, s),
                "dst": d,
                "amt": str(src_hop_amt),
                "delay": _secrets.randbelow(540) + 180,
                "extra": secure_hex(16),
            })
        if not dag_plan:
            integrity_log("stage4", "dag_mixing_skipped:hop_unfundable")
            print(f"  [!] DAG mixing skipped: no mix subaddress holds enough to "
                  f"fund a hop after reserving ~{_hop_reserve} XMR for its fee. "
                  f"Fan-out distribution still runs.")
        else:
            if _unfundable:
                print(f"  [!] {_unfundable} mix subaddress(es) too small to hop; "
                      f"they keep their fan-out output. {len(dag_plan)} hop(s) planned.")
            # Hop COUNT only, never the per-hop amount — same reason as the
            # fan-out above: the amount on the persistent chain deanonymises the
            # hop it is meant to hide.
            integrity_log("stage4", f"dag_plan:{len(dag_plan)}_hops")
    else:
        integrity_log("stage4", "dag_mixing_disabled")
        print("  [*] DAG hop-mixing disabled (default). Run with --dag-mixing to "
              "add a second confirmation-gated hop round.")

    meta = {
        "schema": "unsigned_v1",
        "version": VERSION,
        "created": int(time.time()) // 600 * 600,
        "rounds": len(fanout_plan) + len(dag_plan),
        "fee_per_round": str(per_round_fee),
        "total_fees": str(total_fees),
        "account_index": bal_account,
        "distribution_mode": distribution_mode,
    }

    outdir = Path(args.output)
    secure_mkdir(outdir)          # 0700, not 0755: listing leaks TX count/timing
    plan_tag = secure_hex(8)
    fanout_file = outdir / f"unsigned_fanout_{plan_tag}.json"
    atomic_write_json({"meta": meta, "txs": fanout_plan}, fanout_file)
    dag_file = None
    if dag_plan:
        dag_file = outdir / f"unsigned_dag_{plan_tag}.json"
        atomic_write_json({"meta": meta, "txs": dag_plan}, dag_file)
    integrity_log("stage4", "unsigned_dump_saved")
    print(f"  [+] Fan-out plan: {fanout_file} ({len(fanout_plan)} TXs)")
    if dag_file:
        print(f"  [+] DAG hop plan: {dag_file} ({len(dag_plan)} hops)")

    ###########################################################################
    # Stage 5 - Auto sign + broadcast
    ###########################################################################
    newnym(required=True)   # anonymity gate before broadcast
    tor_recheck(proxy, "stage5_pre")

    _stage5_cleanup(Path(args.output), fanout_file, dag_file)

    # Lock file to prevent concurrent runs
    lock_path = Path(".ghostspiral.lock")
    if lock_path.exists():
        sys.exit(
            "[!] Lock file exists: .ghostspiral.lock\n"
            "    Another GhostSpiral instance may be running.\n"
            "    If not, delete the lock file manually."
        )
    lock_path.write_text(str(os.getpid()))
    secure_file_perms(lock_path)

    staging_dir = "tx_staging"

    try:  # ensures lock file is cleaned even on error
        incomplete = _stage5_run(args, fanout_file, dag_file, fanout_targets_indexed,
                                 staging_dir, proxy, usable,
                                 distribution_mode=distribution_mode,
                                 change_target=(bal_account, 0))
    finally:
        if lock_path.exists():
            lock_path.unlink()

    # Honest completion. This used to print "pipeline complete." unconditionally,
    # so a peel chain that stopped partway or a DAG round that was skipped still
    # read as a finished mix -- the same fake-success pattern already removed
    # from paranoia_mode. Say what actually happened.
    print()
    if incomplete:
        integrity_log("main", f"pipeline_incomplete:{len(incomplete)}")
        print("  [!] GhostSpiral finished, but the mix is NOT what was planned:")
        for _w in incomplete:
            print(f"      - {_w}")
        print("  [!] Funds are safe in the wallet, but do NOT assume the full "
              "mixing depth was applied.")
        sys.exit(1)
    integrity_log("main", "pipeline_complete")
    print("  [+] GhostSpiral v10.5 pipeline complete — every planned round ran.")


#: Env var carrying the wallet spend-key password to the SIGN child only.
GS_PW_ENV = "GS_WALLET_PASSWORD"


def _child_env(wallet_password: str = None) -> dict:
    """Environment for a child process, with the wallet password scrubbed unless
    that child is the one that needs it.

    subprocess.run() with no env= hands the child a COPY OF OUR WHOLE
    ENVIRONMENT. Once the password is supplied via GS_WALLET_PASSWORD -- which
    this toolchain now recommends over argv -- every child inherits the Monero
    spend-key password by default, including JoinMarket's third-party
    tumble.py, the create-phase signer (which never signs anything), broadcast,
    and the exit simulator. None of them need it, and a third-party child that
    logs or dumps its environment would leak it.

    So: pass wallet_password only for the sign child; every other child gets an
    environment with the variable removed.
    """
    env = dict(os.environ)
    env.pop(GS_PW_ENV, None)
    if wallet_password is not None:
        env[GS_PW_ENV] = wallet_password
    return env


def _stage5_cleanup(outdir_path: Path, fanout_file: Path, dag_file):
    """Securely erase the PREVIOUS run's artifacts before this run starts.

    Extracted from main() so it is directly testable -- the old inline version
    could only be exercised by running the whole pipeline, which is why it went
    unaudited while every one of its deletions was insecure.

    Every path here is overwritten, not merely unlinked. What the old
    unlink/rmtree left recoverable on disk:
      * tx_staging/ -- the prior run's FULLY SIGNED, RELAYABLE transactions,
        its unsigned tx sets, and signed_manifest_v1.json with unscrubbed
        destinations and amounts. This is the worst of the three: a recovered
        signed blob can simply be broadcast.
      * unsigned_*.json plans -- the code's own comment already said these
        "contain full destination addresses"; it then deleted them with a plain
        unlink, so the whole mix graph (every subaddress, amount and per-TX
        delay) survived in freed blocks.
      * *_progress.json -- relayed txids paired with blob paths, i.e. a direct
        map from this machine to on-chain transactions.
    """
    for stale in ["signer_progress.json", "broadcast_progress.json"]:
        stale_path = Path(stale)
        if stale_path.exists():
            ok = secure_delete_file(stale_path)
            integrity_log("stage5", f"cleaned_stale:{stale}:{'ok' if ok else 'FAILED'}")
            if not ok:
                print(f"  [!] Could not securely erase {stale}; remove it manually.")

    for old_dir in ["signed_blobs", "tx_staging"]:
        old_path = Path(old_dir)
        if old_path.is_dir():
            ok = secure_delete_tree(old_path)
            integrity_log("stage5", f"cleaned_old_dir:{old_dir}:{'ok' if ok else 'FAILED'}")
            if not ok:
                print(f"  [!] Could not securely erase {old_dir}/ — it may still hold "
                      f"a previous run's signed transactions. Remove it manually.")

    # Old unsigned plans, but NOT the ones Stage 4 just created.
    if outdir_path.is_dir():
        current_names = {fanout_file.name}
        if dag_file:
            current_names.add(dag_file.name)
        for old_plan in list(outdir_path.glob("unsigned_*.json")):
            if old_plan.name not in current_names:
                ok = secure_delete_file(old_plan)
                integrity_log("stage5",
                              f"cleaned_old_plan:{old_plan.name}:{'ok' if ok else 'FAILED'}")
                if not ok:
                    print(f"  [!] Could not securely erase {old_plan}; remove it manually.")


def _run_round(args, plan_file, staging_dir, label):
    """Create -> sign -> broadcast one plan file. Aborts on any failure.

    Each round gets its own staging subdir so its unsigned/signed blobs and
    manifest never collide with another round's. Returns the number of TXs
    broadcast for this round.
    """
    try:
        print(f"  [*] {label} 5a: Creating unsigned TXs via wallet-rpc...")
        subprocess.run(
            ["python3", "airgap_tx_signer", str(plan_file),
             "--phase", "create",
             "--rpc", args.rpc_primary,
             "--tor-proxy", args.tor_proxy,
             "--outdir", staging_dir,
             f"--fee-priority={args.fee_priority}"],
            check=True, timeout=1800,
            env=_child_env(),       # create phase never signs: password scrubbed
        )
        integrity_log("stage5", f"create_unsigned_ok:{label}")

        unsigned_count = len(list(Path(staging_dir).glob("*.unsigned")))
        if unsigned_count == 0:
            integrity_log("stage5", f"no_unsigned_txs_created:{label}")
            sys.exit(f"[!] {label}: phase 'create' produced no unsigned TX files. "
                     f"Check RPC and balance.")
        print(f"  [+] {label}: {unsigned_count} unsigned TXs created.")
    except subprocess.TimeoutExpired:
        integrity_log("stage5", f"create_timeout:{label}")
        sys.exit(f"[!] {label}: unsigned TX creation timed out after 30 min")
    except subprocess.CalledProcessError as e:
        integrity_log("stage5", f"create_fail:{label}:{e.returncode}")
        sys.exit(f"[!] {label}: unsigned TX creation failed (exit {e.returncode})")

    newnym()
    secure_delay(3.0, 8.0)

    try:
        print(f"  [*] {label} 5b: Signing unsigned TXs (offline wallet)...")
        # Password goes through the ENVIRONMENT, never argv. As argv it sat in
        # the child's world-readable /proc/<pid>/cmdline (mode 444) for the
        # whole signing run -- up to the 1800s timeout below -- where any local
        # user could read it with `ps -eo args`. /proc/<pid>/environ is mode
        # 400, so only the owner and root can read it.
        _sign_env = _child_env(args.wallet_password or "")
        subprocess.run(
            ["python3", "airgap_tx_signer", str(plan_file),
             "--phase", "sign",
             "--wallet-file", args.wallet_file,
             "--outdir", staging_dir],
            check=True, timeout=1800, env=_sign_env,
        )
        integrity_log("stage5", f"sign_ok:{label}")

        signed_dir = Path(staging_dir) / "signed"
        signed_count = len(list(signed_dir.glob("*.signed"))) if signed_dir.is_dir() else 0
        if signed_count == 0:
            integrity_log("stage5", f"no_signed_txs:{label}")
            sys.exit(f"[!] {label}: phase 'sign' produced no signed TX files. "
                     f"Check wallet file and password.")
        print(f"  [+] {label}: {signed_count} TXs signed.")
    except subprocess.TimeoutExpired:
        integrity_log("stage5", f"sign_timeout:{label}")
        sys.exit(f"[!] {label}: signing timed out after 30 min")
    except subprocess.CalledProcessError as e:
        integrity_log("stage5", f"sign_fail:{label}:{e.returncode}")
        sys.exit(f"[!] {label}: signing failed (exit {e.returncode})")

    newnym()
    secure_delay(5.0, 15.0)

    try:
        print(f"  [*] {label} 5c: Broadcasting signed TXs...")
        # Relay via wallet-rpc submit_transfer (NOT the daemon). Each round gets
        # its own progress file under its own staging subdir so the fan-out and
        # DAG rounds -- distinct blob sets -- never trip each other's stale-
        # progress guard (which would abort the second round).
        # --rpc-daemon is forwarded so the child VERIFIES relay egress rather
        # than only warning. Stage 0 already checked it, but peers change over
        # a long run: a daemon that was Tor-only at startup can pick up
        # clearnet peers before this broadcast happens, so it is re-checked at
        # the moment of relay. --allow-clearnet-relay is forwarded too, or the
        # operator's explicit override at the top level would be silently
        # dropped and the child would refuse anyway.
        _bcast_cmd = ["python3", "broadcast_signed_xmr", f"{staging_dir}/signed",
                      "--tor-proxy", args.tor_proxy,
                      "--rpc", args.rpc_primary,
                      "--rpc-daemon", args.rpc_daemon,
                      "--resume", f"{staging_dir}/bcast_progress.json"]
        if args.allow_clearnet_relay:
            _bcast_cmd.append("--allow-clearnet-relay")
        subprocess.run(_bcast_cmd, check=True, timeout=7200, env=_child_env())
        integrity_log("stage5", f"broadcast_ok:{label}")
    except subprocess.TimeoutExpired:
        integrity_log("stage5", f"broadcast_timeout:{label}")
        sys.exit(f"[!] {label}: broadcast timed out after 2 hours")
    except subprocess.CalledProcessError as e:
        integrity_log("stage5", f"broadcast_fail:{label}:{e.returncode}")
        sys.exit(f"[!] {label}: broadcast failed (exit {e.returncode})")

    return signed_count


def _wait_for_fanout_confirm(args, targets, proxy):
    """Block until the fan-out subaddresses have UNLOCKED balance.

    The DAG hop round spends outputs the fan-out round just created, and Monero
    outputs are unspendable until they confirm and unlock (~10 blocks). We poll
    each fan-out target's unlocked balance via wallet-rpc and return True once
    all of them are unlocked. On timeout we return False so the caller can skip
    DAG rather than create hops that would fail for 'no unlocked output'.
    """
    if not targets:
        return False
    try:
        rpc = connect_rpc(args.rpc_primary, proxy_url=args.tor_proxy)
    except Exception as e:
        integrity_log("stage5", f"confirm_rpc_connect_fail:{str(e)[:40]}")
        print(f"  [!] Could not connect wallet-rpc to await fan-out confirmation: {e}")
        return False

    print(f"  [*] Waiting for {len(targets)} fan-out output(s) to confirm+unlock "
          f"(~10 blocks; up to {FANOUT_CONFIRM_TIMEOUT // 60} min)...")
    waited = 0
    while waited < FANOUT_CONFIRM_TIMEOUT:
        if shutdown_requested():
            integrity_log("stage5", "confirm_wait_interrupted")
            return False
        # Force a sync first: without it a wallet-rpc that isn't auto-refreshing
        # never sees the just-broadcast fan-out outputs and we'd spin to timeout.
        try:
            rpc.raw_request("refresh", {})
        except Exception:
            pass
        unlocked = 0
        for acct, sub_idx in targets:
            try:
                _total, unlk = rpc.get_subaddress_balance(acct, sub_idx)
                if unlk and int(unlk) > 0:
                    unlocked += 1
            except Exception as e:
                integrity_log("stage5", f"confirm_poll_err:{str(e)[:30]}")
        if unlocked >= len(targets):
            integrity_log("stage5", f"fanout_confirmed:{unlocked}_targets")
            print(f"  [+] All {unlocked} fan-out output(s) confirmed and unlocked.")
            return True
        print(f"  [*] {unlocked}/{len(targets)} confirmed; waiting {FANOUT_CONFIRM_POLL}s...")
        time.sleep(FANOUT_CONFIRM_POLL)
        waited += FANOUT_CONFIRM_POLL

    integrity_log("stage5", "fanout_confirm_timeout")
    print(f"  [!] Timed out after {FANOUT_CONFIRM_TIMEOUT // 60} min waiting for "
          f"fan-out to unlock. Skipping DAG hop round (fan-out is already broadcast).")
    return False


def _wait_for_carrier(args, account, sub_idx, min_unlocked_xmr, proxy, label):
    """Block until subaddress `sub_idx` holds at least min_unlocked_xmr UNLOCKED.

    The peeling carrier (the change address) only becomes spendable for the next
    peel once the previous peel's change has confirmed and unlocked (~10 blocks).
    Waiting on a >= threshold (not merely > 0) is what makes the peels
    sequential: a bare > 0 would return on stale unlocked dust and the next
    peel's create would fail 'not enough money'. Returns False on timeout so the
    caller can stop cleanly with the remaining balance intact.
    """
    try:
        rpc = connect_rpc(args.rpc_primary, proxy_url=args.tor_proxy)
    except Exception as e:
        integrity_log("stage5", f"carrier_rpc_connect_fail:{str(e)[:40]}")
        print(f"  [!] {label}: cannot connect wallet-rpc to await the carrier: {e}")
        return False
    need_atomic = int((Decimal(str(min_unlocked_xmr)) * Decimal(10 ** 12)).to_integral_value())
    print(f"  [*] {label}: waiting for the carrier (subaddr {sub_idx}) to hold the "
          f"peeled change, confirmed+unlocked (~10 blocks; up to "
          f"{FANOUT_CONFIRM_TIMEOUT // 60} min)...")
    waited = 0
    while waited < FANOUT_CONFIRM_TIMEOUT:
        if shutdown_requested():
            integrity_log("stage5", "carrier_wait_interrupted")
            return False
        try:
            rpc.raw_request("refresh", {})
            _t, unlk = rpc.get_subaddress_balance(account, sub_idx)
            if unlk and int(unlk) >= need_atomic:
                integrity_log("stage5", f"carrier_ready:idx={sub_idx}")
                print(f"  [+] {label}: carrier funded and unlocked.")
                return True
        except Exception as e:
            integrity_log("stage5", f"carrier_poll_err:{str(e)[:30]}")
        time.sleep(FANOUT_CONFIRM_POLL)
        waited += FANOUT_CONFIRM_POLL
    integrity_log("stage5", "carrier_confirm_timeout")
    print(f"  [!] {label}: carrier change did not confirm within "
          f"{FANOUT_CONFIRM_TIMEOUT // 60} min.")
    return False


def _run_peel_chain(args, peel_file, staging_dir, proxy, change_target):
    """Run a peeling chain: each peel is its OWN confirmation-gated round.

    peel_file holds N single-destination peels (build_peel_plan). Peel 0 spends
    ENTRY; each later peel spends the change address (change_target=(account,
    0)), which only holds the previous peel's change once it confirms and
    unlocks -- so between peels we WAIT for that subaddress to hold enough
    unlocked balance to fund the next. That wait is what spreads the N mix
    outputs across N transactions over time instead of one co-created fan-out.

    Returns the number of peels relayed. A peel's create/sign/broadcast aborts
    the run (fail closed) exactly as any round does. If the chain stops partway
    (shutdown or a carrier timeout), the peels already relayed are on-chain and
    the UNDISTRIBUTED remainder is safe on the wallet's change subaddress -- but
    there is NO automatic resume: a fresh run rebuilds a new plan from the entry
    balance, so the operator finishes a partial chain by hand, not by re-running.
    """
    with open(peel_file) as f:
        pdata = json.load(f)
    meta = pdata.get("meta", {})
    peels = pdata.get("txs", [])
    acct, csub = change_target
    per_round_fee = Decimal(str(meta.get("fee_per_round", "0.01")))
    n = len(peels)
    print(f"  [*] === Peeling chain: {n} confirmation-gated peels ===")

    def _partial(done):
        # Honest state on an incomplete chain: NOT "re-run to finish" (a re-run
        # starts a brand-new plan and, in receive mode, would find the entry
        # address already drained). The remainder is safe, just not distributed.
        print(f"  [!] Peeling chain stopped at {done}/{n} peels. The {done} relayed "
              f"peel(s) are on-chain; the remaining ~{n - done} destination(s) were "
              f"NOT sent.")
        _stuck = peels[done].get("src_index", csub) if done < n else csub
        print(f"  [!] The undistributed balance is safe on this wallet's account "
              f"{acct}, subaddress {_stuck} (the carrier this peel would have "
              f"spent). There is no auto-"
              f"resume: distribute it manually, or accept the partial distribution. "
              f"Do NOT simply re-run — that builds a new plan from a now-empty entry.")

    relayed = 0
    for i, peel in enumerate(peels):
        if shutdown_requested():
            integrity_log("stage5", f"peel_shutdown_at_{i}")
            _partial(relayed)
            break
        # Peels after the first spend a ROTATING carrier: the fresh subaddress
        # the previous peel paid its remainder to. Wait for THAT subaddress to
        # hold this peel's amount + a fee reserve, unlocked.
        #
        # The index comes from the plan (src_index), not from change_target.
        # Waiting on subaddress 0 while the funds are on a rotating carrier
        # would block forever; worse, if the wait were satisfied by unrelated
        # change sitting on subaddr 0, the peel would spend the hub after all
        # and undo the rotation.
        if i > 0:
            # The peel spends its destination AND forwards the remainder to
            # the next carrier, so the carrier must hold BOTH plus a fee.
            # Sizing this on "amt" alone (which is only the mix destination)
            # let the wait succeed on a carrier that could not fund the
            # transaction, and monerod then answered "not enough money" --
            # found by the real-chain test, not by the unit suite.
            if peel.get("destinations"):
                need = sum((Decimal(str(d["amount"])) for d in peel["destinations"]),
                           Decimal(0)) + per_round_fee
            else:
                need = Decimal(str(peel.get("amt", "0"))) + per_round_fee
            wait_sub = peel.get("src_index")
            if wait_sub is None:
                integrity_log("stage5", f"peel_no_src_index:{i}")
                print(f"  [!] peel {i + 1}/{n}: the plan carries no src_index, so the "
                      f"carrier to wait on is unknown. Refusing to guess subaddress 0 "
                      f"— that is the hub the rotation exists to avoid.")
                _partial(relayed)
                break
            if not _wait_for_carrier(args, acct, wait_sub, need, proxy,
                                     f"peel {i + 1}/{n}"):
                integrity_log("stage5", f"peel_carrier_timeout:{i}")
                _partial(relayed)
                break
        newnym(required=True)
        tor_recheck(proxy, f"stage5_peel_{i}")
        one_path = Path(str(peel_file)[:-5] + f"_peel{i}.json") \
            if str(peel_file).endswith(".json") else Path(str(peel_file) + f".peel{i}")
        atomic_write_json({"meta": meta, "txs": [peel]}, one_path)
        peel_stage = f"{staging_dir}/peel{i}"
        try:
            _run_round(args, one_path, peel_stage, f"Peel {i + 1}/{n}")
            relayed += 1
        finally:
            # The per-peel plan carries the full destination + amount; wipe it.
            secure_delete_file(one_path)
            # And securely wipe THIS peel's staging subdir now that it is
            # broadcast: a peel chain runs for hours, and leaving each peel's
            # signed (relayable) blob on disk for the whole run is exactly the
            # exposure secure staging exists to avoid. The tx is already
            # on-chain, so the blob is spent -- there is nothing to keep.
            _ps = Path(peel_stage)
            if _ps.is_dir() and not secure_delete_tree(_ps):
                print(f"  [!] Could not securely wipe {peel_stage}; remove it manually.")
    integrity_log("stage5", f"peel_chain_done:{relayed}_of_{n}")
    print(f"  [+] Peeling chain: {relayed}/{n} peels relayed.")
    return relayed


def _stage5_run(args, fanout_file, dag_file, fanout_targets, staging_dir,
                proxy, spendable_amount, distribution_mode="fanout",
                change_target=(0, 0)):
    """Execute the create -> sign -> broadcast pipeline as confirmation-gated
    rounds: the distribution (a one-shot fan-out OR a peeling chain), then
    (optionally) the DAG hop round once the mix outputs have unlocked on-chain,
    then the exit-strategy simulation."""
    # -- Distribution: fan-out (one tx) or peel chain (N gated txs) --------
    incomplete = []
    if distribution_mode == "peel":
        try:
            with open(fanout_file) as _pf:
                _total_peels = len(json.load(_pf).get("txs", []))
        except Exception:
            _total_peels = 0
        _relayed = _run_peel_chain(args, fanout_file, staging_dir, proxy, change_target)
        if _total_peels and _relayed < _total_peels:
            incomplete.append(f"peeling chain relayed only {_relayed}/{_total_peels} peels")
    else:
        print("  [*] === Round 1: Fan-out distribution ===")
        _run_round(args, fanout_file, f"{staging_dir}/fanout", "Fan-out")

    # -- Round 2: DAG hop-mixing (only if planned) ------------------------
    if dag_file:
        newnym(required=True)   # anonymity gate before DAG broadcast round
        secure_delay(5.0, 15.0)
        if _wait_for_fanout_confirm(args, fanout_targets, proxy):
            print("  [*] === Round 2: DAG hop-mixing ===")
            tor_recheck(proxy, "stage5_dag")
            _run_round(args, dag_file, f"{staging_dir}/dag", "DAG")
        else:
            integrity_log("stage5", "dag_round_skipped:unconfirmed")
            incomplete.append("DAG hop round was SKIPPED (the distribution outputs "
                              "did not confirm in time) — the second mixing round "
                              "did not happen")

    newnym()
    secure_delay(5.0, 15.0)

    try:
        print("  [*] Stage 5d: Exit strategy simulation...")
        subprocess.run(
            ["python3", "exit_strategy_simulator", str(spendable_amount),
             "--method", "bisq", "--tor-proxy", args.tor_proxy],
            check=True, timeout=300,
            env=_child_env(),       # no password needed
        )
        integrity_log("stage5", "exit_sim_ok")
    except Exception as e:
        integrity_log("stage5", f"exit_sim_warn:{str(e)[:40]}")
        print(f"  [!] Exit simulation failed (non-fatal): {e}")

    integrity_log("stage5", f"stage5_done:incomplete={len(incomplete)}")
    return incomplete


