#!/usr/bin/env python3
"""
GhostSpiral v10.5 - Fully-wired BTC->XMR Mixer Core
=====================================================
!! RESEARCH / RED-TEAM TOOL !!
Never use on main-net coins you do not own.

End-to-end pipeline:
  Stage 0: Validate inputs, Tor, RPC sync
  Stage 1: JoinMarket receive (optional BTC tumble)
  Stage 2: ThorChain BTC->XMR swap
  Stage 3: Build wallets & DAG mixing graph
  Stage 4: Build unsigned TX plan with fee-aware amounts
  Stage 5: Auto-sign + broadcast (or dump for cold/airgap)

OPSEC hardening (v10.5):
  - All traffic forced through Tor with leak checks at every stage
  - NEWNYM circuit rotation between stages
  - CSPRNG for all security-critical randomness (delays, hex extras)
  - Timing jitter between operations
  - Secure file permissions (0600) on all outputs
  - Signal handlers for graceful shutdown
  - Integrity hash-chain logging for every action
  - Resource sentinel prevents operation under system stress
"""
from __future__ import annotations
import argparse, json, os, re, sys, time, subprocess
from decimal import Decimal
from pathlib import Path
from typing import Dict, List

from gs_common import (
    VERSION, integrity_log, verify_tor, tor_recheck, newnym,
    safe_get, safe_post, connect_rpc, require_resources,
    secure_hex, secure_delay, atomic_write_json, secure_file_perms,
    validate_proxy, install_signal_handlers, shutdown_requested,
    scrub_address,
)

DUST_XMR = Decimal("0.0001")
BTC_RE = re.compile(r"^(bc1|tb1)[ac-hj-np-z02-9]{25,59}$", re.I)
SWAPKIT_API = "https://api.swapkit.dev"
# Fee oracle endpoints (tried in order; LocalMonero is defunct since 2023)
FEE_ORACLE_URLS = [
    "https://moneroblocks.info/api/get_stats",
    "https://xmrchain.net/api/emission",
]

# Minimum wallets/rounds to provide meaningful mixing
MIN_WALLETS = 3
MIN_DEEP = 1
NUM_DECOYS = 4


def fetch_fee(proxy: Dict[str, str]) -> Decimal:
    """Fetch current median XMR fee from oracle. Tries multiple sources."""
    for url in FEE_ORACLE_URLS:
        try:
            j = safe_get(url, proxy)
            # Different APIs return fee in different fields
            raw_fee = j.get("fee_per_kb_median") or j.get("fee_per_byte")
            if raw_fee:
                fee = Decimal(str(raw_fee)) / Decimal(1024)
                if fee > 0:
                    return fee
        except Exception:
            continue

    # All oracles failed - use conservative fallback based on typical XMR fees
    # (~0.00005 XMR per TX as of 2024-2025)
    fallback = Decimal("0.00005")
    integrity_log("fee", "all_oracles_failed:using_fallback")
    return fallback


def main():
    install_signal_handlers()

    cli = argparse.ArgumentParser(
        "GhostSpiral v10.5",
        description="BTC->XMR mixing pipeline with Tor, ThorChain, and JoinMarket support",
    )
    cli.add_argument("--btc-entry", required=True,
                     help="BTC entry address (bech32)")
    cli.add_argument("--tor-proxy", required=True,
                     help="SOCKS5 proxy (e.g. socks5h://127.0.0.1:9050)")
    cli.add_argument("--joinmarket", action="store_true",
                     help="Enable JoinMarket tumble before ThorChain swap")
    cli.add_argument("--split", type=int, default=1,
                     help="Number of BTC chunks to split across ThorChain")
    cli.add_argument("--wallets", type=int, default=10,
                     help=f"Number of mix wallets (min {MIN_WALLETS})")
    cli.add_argument("--deep", type=int, default=2,
                     help=f"Depth multiplier for DAG edges (min {MIN_DEEP})")
    cli.add_argument("--airgap", action="store_true",
                     help="Dump unsigned plan and stop (manual sign required)")
    cli.add_argument("--cold", action="store_true",
                     help="Dump unsigned plan for cold-wallet signing")
    cli.add_argument("--rpc-primary", default="http://127.0.0.1:18083",
                     help="Primary monero-wallet-rpc endpoint")
    cli.add_argument("--rpc-alt",
                     help="Fallback monero-wallet-rpc endpoint")
    cli.add_argument("--output", default="./unsigned",
                     help="Output directory for unsigned TX plans")
    cli.add_argument("--joinmarket-wallet",
                     help="JoinMarket wallet file for tumbles")
    args = cli.parse_args()

    # ---- Validate inputs early ----
    args.wallets = max(args.wallets, MIN_WALLETS)
    args.deep = max(args.deep, MIN_DEEP)

    proxy = validate_proxy(args.tor_proxy)

    if not BTC_RE.match(args.btc_entry):
        sys.exit("[!] Invalid BTC entry address (expected bech32 bc1.../tb1...)")
    integrity_log("stage0", "btc_entry_validated")

    # ---- Stage 0: Environment checks ----
    require_resources(min_disk_gb=2.0)
    verify_tor(proxy)
    integrity_log("stage0", "tor_ok")

    fee_xmr = fetch_fee(proxy)
    integrity_log("stage0", "fee_fetched")

    rpc_primary = connect_rpc(args.rpc_primary, proxy_url=args.tor_proxy)
    rpc_alt = connect_rpc(args.rpc_alt, proxy_url=args.tor_proxy) if args.rpc_alt else None

    # Sync guard: wait for nodes to agree on height
    for attempt in range(30):
        if shutdown_requested():
            sys.exit("[!] Shutdown requested during sync wait.")
        try:
            h1 = rpc_primary.raw_request("get_height", {})["height"]
            if rpc_alt:
                h2 = rpc_alt.raw_request("get_height", {})["height"]
                if abs(h1 - h2) <= 2:
                    break
            else:
                if h1 > 0:
                    break
        except Exception as e:
            integrity_log("stage0", f"rpc_height_err:{str(e)[:40]}")
        time.sleep(10)
    else:
        sys.exit("[!] RPC nodes out of sync after 5 min; abort.")
    integrity_log("stage0", f"rpc_sync_ok:height={h1}")

    ###########################################################################
    # Stage 1 - JoinMarket (optional BTC tumble before ThorChain)
    ###########################################################################
    newnym()

    def stage1_joinmarket(btc_addr: str) -> List[Decimal]:
        if not args.joinmarket:
            integrity_log("stage1", "JM_skipped")
            return []
        if not args.joinmarket_wallet:
            sys.exit("[!] --joinmarket-wallet required when --joinmarket is set")
        try:
            # JoinMarket has its own Tor config in joinmarket.cfg, but we pass
            # --socks5-host/port to be explicit (JM >= 0.9 supports this).
            # Without this, JM may resolve maker addresses over clearnet.
            from urllib.parse import urlparse as _urlparse
            _parsed_proxy = _urlparse(args.tor_proxy)
            result = subprocess.run(
                ["python3", "tumble.py",
                 "--socks5-host", _parsed_proxy.hostname or "127.0.0.1",
                 "--socks5-port", str(_parsed_proxy.port or 9050),
                 args.joinmarket_wallet, btc_addr, "all"],
                check=True, capture_output=True, text=True, timeout=3600,
            )
            integrity_log("stage1", "JM_tumble_OK")
            # TODO: parse actual UTXO amounts from result.stdout
            # For now return empty - operator must check JM output manually
            return []
        except subprocess.TimeoutExpired:
            integrity_log("stage1", "JM_timeout")
            sys.exit("[!] JoinMarket tumble timed out after 1 hour")
        except FileNotFoundError:
            integrity_log("stage1", "JM_not_found")
            sys.exit("[!] tumble.py not found - JoinMarket not installed?")
        except subprocess.CalledProcessError as e:
            integrity_log("stage1", f"JM_fail:{e.returncode}")
            sys.exit(f"[!] JoinMarket tumble failed (exit {e.returncode})")

    jm_utxos = stage1_joinmarket(args.btc_entry)
    integrity_log("stage1", f"done:jm_utxos={len(jm_utxos)}")

    ###########################################################################
    # Stage 2 - ThorChain swap definition
    ###########################################################################

    def stage2_get_swap_quotes(chunks: List[Decimal], xmr_dest: str) -> List[dict]:
        """Get ThorChain swap quotes via SwapKit API for each BTC chunk.

        Uses the REAL SwapKit v3 API (https://docs.swapkit.dev):
          POST /v3/quote
          Body: {sellAsset, buyAsset, sellAmount, destinationAddress}
          Response: {quoteId, routes: [{..., expectedOutput, depositAddress, memo}]}

        Returns list of deposit instructions for the operator.
        The operator must MANUALLY send BTC to each deposit address.
        """
        deposits = []
        for i, amt in enumerate(chunks):
            if shutdown_requested():
                integrity_log("stage2", f"shutdown_at_chunk_{i}")
                sys.exit("[!] Shutdown requested during quote fetch.")

            if amt <= Decimal(0):
                continue

            if i > 0:
                newnym()
                secure_delay(3.0, 10.0)

            # SwapKit v3 API uses sellAsset/buyAsset not from/to
            payload = {
                "sellAsset": "BTC.BTC",
                "buyAsset": "XMR.XMR",
                "sellAmount": str(amt),
                "destinationAddress": xmr_dest,
            }

            try:
                quote_resp = safe_post(f"{SWAPKIT_API}/v3/quote", payload, proxy)
            except Exception as e:
                newnym()
                integrity_log("stage2", f"quote_api_error:{i}")
                sys.exit(f"[!] SwapKit quote API failed for chunk {i}: {str(e)[:60]}")

            # Parse the routes from the response
            routes = quote_resp.get("routes", [])
            if not routes:
                error = quote_resp.get("error", "unknown")
                provider_errors = quote_resp.get("providerErrors", [])
                integrity_log("stage2", f"no_routes_chunk_{i}")
                sys.exit(
                    f"[!] No swap routes available for chunk {i}.\n"
                    f"    Error: {str(error)[:80]}\n"
                    f"    Provider errors: {str(provider_errors)[:120]}"
                )

            # Use the first (best) route
            route = routes[0]
            expected_output = route.get("expectedOutput", "0")
            # The actual deposit details come from executing the route
            # For THORChain routes, the deposit info is in the route's transaction object
            tx_info = route.get("transaction", route.get("calldata", {}))
            deposit_addr = tx_info.get("depositAddress", tx_info.get("to", ""))
            memo = tx_info.get("memo", tx_info.get("data", ""))

            if not deposit_addr:
                integrity_log("stage2", f"no_deposit_in_route_{i}")
                sys.exit(f"[!] Route has no deposit address for chunk {i}")

            expected_dec = Decimal(str(expected_output))

            deposit_info = {
                "chunk": i,
                "btc_amount": str(amt),
                "deposit_address": deposit_addr,
                "memo": str(memo),
                "expected_xmr": str(expected_dec),
                "quote_id": quote_resp.get("quoteId", ""),
            }
            deposits.append(deposit_info)

            print(f"  [*] Chunk {i}/{len(chunks)-1}:")
            print(f"      Send {amt} BTC to: {scrub_address(deposit_addr)}")
            if memo:
                print(f"      With memo: {str(memo)[:40]}...")
            print(f"      Expected: ~{expected_dec} XMR")
            integrity_log("stage2", f"quote_ready:{i}")

            secure_delay(5.0, 15.0)

        return deposits

    ###########################################################################
    # Stage 3 - Build wallets & DAG (runs BEFORE stage2 invocation so
    # the ENTRY receive address exists for ThorChain destination)
    ###########################################################################
    newnym()
    tor_recheck(proxy, "stage3_pre")

    def create_subs(rpc, n: int, decoys: int) -> List[str]:
        subs = []
        for i in range(n):
            addr = rpc.new_subaddress(account_index=0, label=f"Mix_{i}")
            subs.append(addr)
        for d in range(decoys):
            addr = rpc.new_subaddress(account_index=0, label=f"Decoy_{d}")
            subs.append(addr)
        return subs

    subs = create_subs(rpc_primary, args.wallets, NUM_DECOYS)
    if len(subs) < MIN_WALLETS + 1:
        sys.exit("[!] Failed to create enough subaddresses")

    ENTRY = subs[0]
    integrity_log("stage3", "entry_created")

    import secrets as _secrets
    _secrets.SystemRandom().shuffle(subs)

    ###########################################################################
    # Stage 2 execution - ThorChain swap (now that ENTRY address exists)
    ###########################################################################
    newnym()
    tor_recheck(proxy, "stage2_exec")

    # Determine what BTC chunks to swap:
    # - If JoinMarket produced UTXOs, use those
    # - If --split > 1, operator plans to manually split their BTC
    # - Otherwise this is a direct single-chunk flow
    # NOTE: ThorChain swap produces deposit addresses for the operator
    # to manually send BTC to. The operator must do the actual BTC send.
    if jm_utxos:
        btc_chunks = jm_utxos
    elif args.split >= 1:
        # Operator hasn't specified amounts per chunk, so we can't auto-split.
        # Instead, generate deposit addresses for --split chunks and let
        # the operator decide amounts. Use placeholder to get quotes.
        print(f"\n  [!] No JoinMarket UTXOs. Generating {args.split} ThorChain deposit(s).")
        print(f"  [!] You must manually send BTC to the deposit addresses below.")
        print(f"  [!] XMR will arrive at ENTRY address after ThorChain processes.")
        btc_chunks = []
    else:
        btc_chunks = []

    if btc_chunks:
        swap_deposits = stage2_get_swap_quotes(btc_chunks, ENTRY)
        integrity_log("stage2", "swap_quotes_generated")
        total_expected = sum(Decimal(d["expected_xmr"]) for d in swap_deposits)
        print(f"\n  [+] {len(swap_deposits)} deposit instruction(s) generated.")
        print(f"  [+] Expected total: ~{total_expected} XMR after swaps")
        print(f"  [!] YOU MUST manually send BTC to each deposit address above!")
        print(f"  [!] Wait for XMR to arrive and confirm before proceeding!")
    else:
        integrity_log("stage2", "manual_mode")
        print(f"\n  [!] MANUAL MODE: Send BTC through ThorChain to your ENTRY address.")
        print(f"  [!] Use thor_swap_preparer to generate deposit addresses.")
        print(f"  [!] Then wait for XMR to arrive and confirm before proceeding.")

    dag = {}
    for a in subs:
        others = [b for b in subs if b != a]
        max_k = len(others)
        k = min((_secrets.randbelow(3) + 1) * args.deep, max_k)
        k = max(k, 1)
        chosen = []
        pool = list(others)
        for _ in range(k):
            idx = _secrets.randbelow(len(pool))
            chosen.append(pool.pop(idx))
        dag[a] = chosen
    integrity_log("stage3", "dag_built")

    ###########################################################################
    # Stage 4 - Balance, amounts, plan
    ###########################################################################

    def xmr_balance() -> tuple[Decimal, Decimal]:
        """Returns (total_balance, unlocked_balance) in XMR."""
        res = rpc_primary.raw_request(
            "get_balance", {"account_index": 0, "address_indices": []}
        )
        total = Decimal(str(res.get("balance", 0))) / Decimal(10 ** 12)
        unlocked = Decimal(str(res.get("unlocked_balance", 0))) / Decimal(10 ** 12)
        return total, unlocked

    total_bal, unlocked_bal = xmr_balance()
    integrity_log("stage4", "balance_fetched")

    if total_bal > unlocked_bal + DUST_XMR:
        print(f"  [!] {total_bal - unlocked_bal} XMR still locked (pending confirmations)")

    bal = unlocked_bal
    if bal <= DUST_XMR:
        if args.cold or args.airgap:
            print("[!] Balance too low - producing dry-run plan with mock 10 XMR")
            print("[!] DO NOT sign/broadcast this plan without real funds!")
            bal = Decimal("10.0")
            integrity_log("stage4", "mock_balance:dry_run_only")
        else:
            sys.exit(
                f"[!] Unlocked balance is {unlocked_bal} XMR (below dust threshold).\n"
                f"    Cannot create a real TX plan without funds.\n"
                f"    Total balance: {total_bal} XMR (may be locked/unconfirmed).\n"
                f"    Use --cold or --airgap for dry-run planning."
            )

    rounds = args.wallets * 2 * args.deep
    per_round_fee = fee_xmr * Decimal("1.5")  # 1 TX/round + 50% safety margin for fee spikes
    total_fees = per_round_fee * rounds
    usable = bal - total_fees

    if usable <= DUST_XMR:
        sys.exit(
            f"[!] Balance {bal} XMR insufficient.\n"
            f"    Estimated fees: {total_fees} XMR for {rounds} rounds.\n"
            f"    Usable after fees: {usable} XMR"
        )

    split_amt = usable / Decimal(rounds)
    integrity_log("stage4", "plan_calculated")

    # Guard against rounding dust loss: sum of all TX amounts must not exceed usable
    quantized_split = split_amt.quantize(Decimal("0.0001"))
    total_planned = quantized_split * rounds
    if total_planned > usable:
        quantized_split -= Decimal("0.0001")
        integrity_log("stage4", f"rounding_adj:new_split={quantized_split}")

    plan = []
    for r in range(rounds):
        if shutdown_requested():
            integrity_log("stage4", f"shutdown_at_round_{r}")
            break
        src_idx = _secrets.randbelow(len(subs))
        s = subs[src_idx]
        dst_idx = _secrets.randbelow(len(dag[s]))
        d = dag[s][dst_idx]
        plan.append({
            "src": s,
            "dst": d,
            "amt": str(quantized_split),
            "delay": _secrets.randbelow(540) + 180,  # 180-720s
            "extra": secure_hex(16),
        })

    meta = {
        "schema": "unsigned_v1",
        "version": VERSION,
        "created": int(time.time()) // 600 * 600,  # coarsen to 10-min bucket
        "rounds": len(plan),
        "fee_per_round": str(per_round_fee),
        "total_fees": str(total_fees),
    }
    unsigned = {"meta": meta, "txs": plan}

    outdir = Path(args.output)
    outdir.mkdir(parents=True, exist_ok=True)
    ufile = outdir / f"unsigned_{secure_hex(8)}.json"
    atomic_write_json(unsigned, ufile)
    integrity_log("stage4", "unsigned_dump_saved")
    print(f"  [+] Unsigned plan: {ufile} ({len(plan)} TXs)")

    if args.cold or args.airgap:
        mode = "cold" if args.cold else "airgap"
        for stale in ["signer_progress.json", "broadcast_progress.json"]:
            stale_path = Path(stale)
            if stale_path.exists():
                stale_path.unlink()
                integrity_log("stage4", f"cleaned_stale:{stale}")
        print(f"  [+] {mode.upper()} mode - transfer {ufile} to signer manually.")
        integrity_log("stage4", f"{mode}_exit")
        sys.exit(0)

    ###########################################################################
    # Stage 5 - Auto sign + broadcast
    ###########################################################################
    newnym()
    tor_recheck(proxy, "stage5_pre")

    # Clean stale progress files from prior runs to prevent poisoning
    for stale in ["signer_progress.json", "broadcast_progress.json"]:
        stale_path = Path(stale)
        if stale_path.exists():
            stale_path.unlink()
            integrity_log("stage5", f"cleaned_stale:{stale}")

    # Clean old signed blobs directory
    signed_dir = Path("signed_blobs")
    if signed_dir.is_dir():
        import shutil
        shutil.rmtree(signed_dir)
        integrity_log("stage5", "cleaned_old_signed_blobs")

    try:
        print("  [*] Stage 5a: Signing...")
        sign_cmd = [
            "python3", "airgap_tx_signer", str(ufile),
            "--wallet-file", "offline.wallet",
            "--outdir", "signed_blobs",
        ]
        subprocess.run(sign_cmd, check=True, timeout=1800)
        integrity_log("stage5", "signer_ok")
    except subprocess.TimeoutExpired:
        integrity_log("stage5", "signer_timeout")
        sys.exit("[!] Signer timed out after 30 min")
    except subprocess.CalledProcessError as e:
        integrity_log("stage5", f"signer_fail:{e.returncode}")
        sys.exit(f"[!] Signer failed (exit {e.returncode})")

    newnym()
    secure_delay(5.0, 15.0)

    try:
        print("  [*] Stage 5b: Broadcasting...")
        subprocess.run(
            ["python3", "broadcast_signed_xmr", "signed_blobs",
             "--tor-proxy", args.tor_proxy],
            check=True, timeout=7200,
        )
        integrity_log("stage5", "broadcast_ok")
    except subprocess.TimeoutExpired:
        integrity_log("stage5", "broadcast_timeout")
        sys.exit("[!] Broadcast timed out after 2 hours")
    except subprocess.CalledProcessError as e:
        integrity_log("stage5", f"broadcast_fail:{e.returncode}")
        sys.exit(f"[!] Broadcast failed (exit {e.returncode})")

    newnym()
    secure_delay(5.0, 15.0)

    try:
        print("  [*] Stage 5c: Exit strategy simulation...")
        subprocess.run(
            ["python3", "exit_strategy_simulator", str(bal),
             "--method", "bisq", "--tor-proxy", args.tor_proxy],
            check=True, timeout=300,
        )
        integrity_log("stage5", "exit_sim_ok")
    except Exception as e:
        integrity_log("stage5", f"exit_sim_warn:{str(e)[:40]}")
        print(f"  [!] Exit simulation failed (non-fatal): {e}")

    integrity_log("stage5", "full_pipeline_complete")
    print("\n  [+] GhostSpiral v10.5 pipeline complete.")


if __name__ == "__main__":
    main()
