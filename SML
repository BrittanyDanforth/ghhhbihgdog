class SecureHasher:
    """Military-grade hashing with environmental entropy"""
    
    @staticmethod
    def secure_hash(data: bytes, additional_entropy: Optional[bytes] = None) -> str:
        """Create secure hash with environmental mixing"""
        hasher = hashlib.sha3_256()  # Use SHA-3 for better security
        
        # Add input data
        hasher.update(data)
        
        # Mix in environmental entropy
        env_entropy = SecureHasher._gather_environmental_entropy()
        hasher.update(env_entropy)
        
        # Add additional entropy if provided
        if additional_entropy:
            hasher.update(additional_entropy)
        
        # Add timestamp with microsecond precision
        timestamp = struct.pack('<Q', int(time.time() * 1000000))
        hasher.update(timestamp)
        
        return hasher.hexdigest()
    
    @staticmethod
    def _gather_environmental_entropy() -> bytes:
        """Gather entropy from system environment"""
        entropy_sources = []
        
        try:
            # Process information
            entropy_sources.append(struct.pack('<I', os.getpid()))
            entropy_sources.append(struct.pack('<I', os.getppid()))
            
            # System load (if available)
            if hasattr(os, 'getloadavg'):
                load = os.getloadavg()
                entropy_sources.append(struct.pack('<fff', *load))
            
            # Memory usage
            try:
                import psutil
                mem = psutil.virtual_memory()
                entropy_sources.append(struct.pack('<Q', mem.available))
            except ImportError:
                pass
            
            # Network interface MACs (first few bytes only for privacy)
            try:
                import uuid
                node = uuid.getnode()
                entropy_sources.append(struct.pack('<Q', node)[:3])  # Only first 3 bytes
            except:
                pass
                
        except:
            pass
        
        # Always include high-quality random bytes
        entropy_sources.append(secrets.token_bytes(32))
        
        return b''.join(entropy_sources)


class SecureLockManager:
    """Ultra-secure lock file manager"""
    
    def __init__(self, security_ctx: SecurityContext):
        self.security_ctx = security_ctx
        self.seed_file = Path("entropy_seed.json")
        self.default_lock_path = self._get_secure_lock_path()
        self.lock_schema = "secure_memseed_v2"
    
    def _get_secure_lock_path(self) -> Path:
        """Get secure lock file path (RAM-based if possible)"""
        # Try multiple RAM-based locations
        ram_paths = [
            Path("/dev/shm"),
            Path("/run/shm"),
            Path("/tmp")  # Fallback
        ]
        
        for ram_path in ram_paths:
            if ram_path.exists() and ram_path.is_dir():
                # Use obfuscated filename
                lock_name = f".{secrets.token_hex(8)}.lock"
                return ram_path / lock_name
        
        # Ultimate fallback
        return Path(tempfile.gettempdir()) / f".{secrets.token_hex(8)}.lock"
    
    def _load_seed_hash(self) -> str:
        """Load and hash seed file securely"""
        if not self.seed_file.exists():
            raise FileNotFoundError("Seed file not found")
        
        try:
            seed_data = self.seed_file.read_bytes()
            # Add timing resistance
            time.sleep(random.uniform(0.001, 0.01))
            return SecureHasher.secure_hash(seed_data)
        except Exception as e:
            raise RuntimeError(f"Failed to load seed: {e}")
    
    def _secure_mlock(self, path: Path) -> bool:
        """Attempt to lock file in memory"""
        try:
            if not path.exists():
                return False
            
            fd = os.open(str(path), os.O_RDONLY)
            try:
                stat_info = os.fstat(fd)
                if stat_info.st_size > 0:
                    mm = mmap.mmap(fd, stat_info.st_size, access=mmap.ACCESS_READ)
                    mm.mlock()
                    return True
            finally:
                os.close(fd)
        except (OSError, AttributeError):
            pass
        return False
    
    def create_lock(self, lock_path: Optional[Path] = None, ttl: Optional[int] = None) -> bool:
        """Create secure lock file"""
        try:
            target_path = lock_path or self.default_lock_path
            seed_hash = self._load_seed_hash()
            
            # Create lock data with security metadata
            lock_data = {
                "schema": self.lock_schema,
                "seed_hash": seed_hash,
                "created_utc": datetime.now(timezone.utc).isoformat(),
                "ttl_seconds": ttl,
                "session_id": secrets.token_hex(16),
                "process_id": os.getpid(),
                "security_level": "maximum",
                "anti_forensic": True
            }
            
            # Write atomically
            temp_path = target_path.with_suffix(f".{secrets.token_hex(4)}.tmp")
            temp_path.write_text(json.dumps(lock_data, indent=2))
            temp_path.replace(target_path)
            
            # Lock in memory
            self._secure_mlock(target_path)
            
            # Schedule auto-cleanup if TTL specified
            if ttl:
                self._schedule_cleanup(target_path, ttl)
            
            return True
            
        except Exception:
            return False
    
    def verify_lock(self, lock_path: Optional[Path] = None) -> bool:
        """Verify lock file integrity and validity"""
        try:
            target_path = lock_path or self.default_lock_path
            
            if not target_path.exists():
                return False
            
            # Add timing resistance
            time.sleep(random.uniform(0.001, 0.005))
            
            lock_data = json.loads(target_path.read_text())
            
            # Verify schema
            if lock_data.get("schema") != self.lock_schema:
                return False
            
            # Verify seed hash
            current_seed_hash = self._load_seed_hash()
            if lock_data.get("seed_hash") != current_seed_hash:
                return False
            
            # Check TTL expiration
            ttl = lock_data.get("ttl_seconds")
            if ttl:
                created = datetime.fromisoformat(lock_data["created_utc"])
                if datetime.now(timezone.utc) > created + timedelta(seconds=ttl):
                    # Auto-cleanup expired lock
                    self._secure_delete(target_path)
                    return False
            
            # Lock in memory for this process
            self._secure_mlock(target_path)
            
            return True
            
        except Exception:
            return False
    
    def _schedule_cleanup(self, lock_path: Path, ttl: int):
        """Schedule automatic lock cleanup"""
        def cleanup_task():
            time.sleep(ttl)
            self._secure_delete(lock_path)
        
        cleanup_thread = threading.Thread(target=cleanup_task, daemon=True)
        cleanup_thread.start()
    
    def _secure_delete(self, path: Path):
        """Securely delete file with overwriting"""
        try:
            if path.exists():
                # Overwrite with random data multiple times
                file_size = path.stat().st_size
                for _ in range(3):
                    path.write_bytes(secrets.token_bytes(file_size))
                    time.sleep(0.01)
                # Final overwrite with poison pattern
                path.write_bytes(MEMORY_POISON_PATTERN[:file_size])
                path.unlink()
        except:
            pass
    
    def get_lock_info(self, lock_path: Optional[Path] = None) -> Optional[Dict[str, Any]]:
        """Get lock information (sanitized for security)"""
        try:
            target_path = lock_path or self.default_lock_path
            if not target_path.exists():
                return None
            
            data = json.loads(target_path.read_text())
            
            # Return sanitized info (no sensitive data)
            return {
                "schema": data.get("schema"),
                "created_utc": data.get("created_utc"),
                "has_ttl": data.get("ttl_seconds") is not None,
                "security_level": data.get("security_level"),
                "session_active": True
            }
        except:
            return None


