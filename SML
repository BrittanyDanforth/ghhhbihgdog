            # Fake cache data
            struct.pack('<I', int(time.time())) + secrets.token_bytes(100),
        ]
        return random.choice(content_types) + secrets.token_bytes(random.randint(50, 200))
    
    def secure_cleanup(self):
        """Secure cleanup of all artifacts"""
        # Clean up decoy files
        for decoy in self.decoy_files:
            try:
                # Overwrite before deletion
                if decoy.exists():
                    decoy.write_bytes(MEMORY_POISON_PATTERN)
                    decoy.unlink()
            except:
