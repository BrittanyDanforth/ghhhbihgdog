            self.secure_cleanup()
            sys.exit(0)
        
        signal.signal(signal.SIGTERM, emergency_cleanup)
        signal.signal(signal.SIGINT, emergency_cleanup)
        if hasattr(signal, 'SIGHUP'):
            signal.signal(signal.SIGHUP, emergency_cleanup)
    
