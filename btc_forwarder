def _history_truncated(total):
    """The address's history was longer than the reader's window and was
    read as its newest entries (gs_btc_broadcast.spends_of, the MED pass
    after the deep read): a kind on the chain, and the count in the job
    log, so a flood of dust on the address is seen for what it is."""
    integrity_log("forward", "history_truncated")
    print(f"  [!] the address's history has {int(total)} entries; only the "
          f"newest {int(bcast.MAX_HISTORY)} were read. A forward that fell "
          "off that window cannot be reconciled from here (the run fails, "
          "nothing is signed); one within it is.")

#: The forward's floor, in satoshis, on what reaches ThorChain AFTER the
#: fee. It equals gs_wake_proto.DEPOSIT_MIN_SAT (10,000 sat, 0.0001 BTC),
#: and that figure is not a coincidence: ThorChain's BTC dust threshold is
#: 10,000 sat -- an inbound below it is ignored, not swapped, and the money
#: is gone. tests/test_btc_forwarder.py pins the two constants together.
#: DECLARED IN gs_btc_tx beside the fee fraction, because the vault's
#: deposit floor is built from both (gs_btc_tx.forward_floor_sat) and two
#: copies is how the floor and this tool's guards came to disagree
#: (STAGE5_PLAN.md section 1, item 7).
FORWARD_MIN_SAT = btx.FORWARD_MIN_SAT
#: A fee larger than this fraction of the settled deposit is refused: at
#: that point the forward is paying the miner more than a fifth of the
#: client's money, and the right answer is to wait for cheaper blocks, not
#: to burn it.
MAX_FEE_FRACTION = btx.FORWARD_MAX_FEE_FRACTION
#: KERCKHOFFS, ON THE CHAIN (fix pass after the deep read). The fee this
#: tool paid was EXACTLY the vsize bound times an integer rate, and the
#: limit it wrote into the memo was EXACTLY 99 times an integer (six
#: decimals of XMR, times 1e8, times 0.99): two public formulas that
#: together picked this host's forwards out of every ThorChain inbound
#: with public data alone -- one false positive in ~27,000 -- and through
#: them every client's deposit address. Each now carries a little
#: randomness from the system's CSPRNG: the fee is bound*rate plus
#: 0..bound-1 sat (never a satoshi the deposit cannot bear), the limit is
#: the floor less 0..LIMIT_JITTER_MAX base units (never more than 1% of
#: it, never below 1). Both are injectable so the tests can pin them.
LIMIT_JITTER_MAX = 5000


def _fee_jitter(bound):
    """0..bound-1 satoshis, so the fee modulo the bound is uniform."""
    return secrets.randbelow(max(1, int(bound)))


def _limit_jitter(cap):
    """0..cap base units."""
    return secrets.randbelow(max(0, int(cap)) + 1)


#: THE LIMIT'S MARGIN IS DRAWN PER FORWARD (self-doubt over the fix pass).
#: The jitter above killed the "99 times an integer" test, but the limit
#: it was taken from was still 0.99 of 0.90 of the quote: a public RATIO,
#: 0.891 to five decimals, and Midgard lists every swap's memo, in and out
#: amounts -- a soft but sharp classifier over the BTC->XMR inbounds. Now
#: the margin under the quote is drawn once per forward from the band
#: common wallet settings cover (3% to the arrival tolerance, in basis
#: points), so the ratio is a band the population shares, not a number.
#: Never above the tolerance: a swap that executes lands at or above what
#: the watcher accepts, and a tighter limit only refunds sooner.
LIMIT_MARGIN_MIN_BPS = 300
LIMIT_MARGIN_MAX_BPS = 1000


def _limit_margin():
    """LIMIT_MARGIN_MIN_BPS..LIMIT_MARGIN_MAX_BPS basis points, uniform."""
    return LIMIT_MARGIN_MIN_BPS + secrets.randbelow(
        max(0, LIMIT_MARGIN_MAX_BPS - LIMIT_MARGIN_MIN_BPS) + 1)


#: THE BUMP WINDOW IS DRAWN TOO (the host-privacy pass). --bump-after is
#: an exact number of seconds from the keyfile, so every replacement this
#: host ever made appeared in the mempool at the SAME offset after the
#: transaction it replaced -- 7200 s by default, on a chain where both
#: transactions and both times are public. A replacement is already rare
#: and already recognisable as one (same outpoints, higher fee); the
#: offset is what made this host's replacements one population. The window
#: is drawn per reconciliation from the band below, so the observed
#: offsets are a spread and the mean is the operator's setting. NEVER
#: BELOW the setting: it is a "has waited at least this long" bound, and
#: bumping sooner than the operator asked would be this tool overriding
#: them to pay a second fee.
BUMP_SPREAD_MAX = Decimal("0.5")
#: A plan's `ts` is int(time.time()) // STAMP_BUCKET_S * STAMP_BUCKET_S.
STAMP_BUCKET_S = 600


def _bump_window(bump_after_s):
    """`bump_after_s` .. bump_after_s * (1 + BUMP_SPREAD_MAX), uniform in
    whole seconds. Zero stays zero: REPLACE AT ONCE -- the testnet drill's
    setting (gs_wake_keys --btc-bump-after says so). It said "the operator
    turned the bump off", and an operator who paired 0 on that word got a
    replacement on every recheck."""
    base = max(0, int(bump_after_s))
    if base <= 0:
        return 0
    return base + secrets.randbelow(int(base * BUMP_SPREAD_MAX) + 1)


FEE_JITTER = _fee_jitter
LIMIT_JITTER = _limit_jitter
LIMIT_MARGIN_BPS = _limit_margin
BUMP_WINDOW = _bump_window
