                    help="THORNode base URL to cross-check the inbound "
                         "address and halt status against, over Tor")
    ap.add_argument("--timeout", type=float, default=30.0)
    ap.add_argument("--outfile", required=True)
    return ap


def main(argv=None):
    install_signal_handlers()
    args = build_cli().parse_args(argv)
    # EXACTLY ONE MODE. None is the stage-2 refusal (kept by name: an old
    # caller that passes nothing still gets it); two is a contradiction. A
    # reconciliation SENDS when it must, so it is held to the broadcast's
    # own requirements below.
    if sum(1 for m in (args.dry_run, args.broadcast, args.reconcile) if m) \
            != 1:
        raise Refused("not_dry_run", "exactly one of --dry-run, --broadcast "
                      "and --reconcile is required: no mode is reached by "
                      "omission, and a dry run cannot also send")
    if (args.broadcast or args.reconcile) and args.plan_only:
        raise Refused("bad_args", "--plan-only writes an unsigned plan; "
                      "there is nothing to broadcast or reconcile")
    if args.reconcile:
        # THE SENDING MODE'S RULES, because a reconciliation may send.
        args.broadcast = True
    if args.broadcast and (args.quote_max_age < 1 or args.seen_wait < 0
                           or args.seen_interval <= 0):
        raise Refused("bad_args", "--quote-max-age must be >= 1, "
                      "--seen-wait >= 0, --seen-interval > 0")
    if args.bump_after < 0:
        raise Refused("bad_args", "--bump-after cannot be negative")
    if args.returns_max < 0:
        raise Refused("bad_args", "--returns-max cannot be negative")
    # MONEY DOES NOT MOVE ON THE AGGREGATOR'S WORD ALONE (STAGE5_PLAN.md
    # 3.5). The THORNode cross-check of the inbound address was optional,
    # so a sending forward could pay whatever address a compromised
    # aggregator named with the one check against that never running. A
    # rehearsal may still run without it; a broadcast may not.
    if args.thornode and not watch.thornode_url_ok(args.thornode):
        raise Refused("bad_args", "--thornode must be https://, or http:// "
                      "to a .onion: over plain http any Tor exit could answer "
                      "for THORNode, and its inbound list is the one check "
                      "against an aggregator naming its own address. Re-pair "
                      "with --thornode https://... (gs_wake_keys).")
    if args.broadcast and not args.thornode:
        raise Refused("bad_args", "--broadcast needs --thornode: a forward "
                      "that sends pays the inbound address the aggregator "
                      "names, and THORNode's own inbound list is the one "
                      "check against an aggregator naming its own. Pair "
                      "--thornode (gs_wake_keys) or rehearse with --dry-run.")
    # WHICH ACCOUNT OF THE SEED THE XPUB IS (STAGE5_PLAN.md 3.5): 0 unless
    # the pair was retired to a fresh chain. From the environment like the
    # xpub; absent means 0, which every pair before the field was.
    account_no = env_or_argv("GS_BTC_ACCOUNT",
                             None if args.account is None else
                             str(args.account), "the account number")
    try:
        account_no = int(str(account_no)) if account_no not in (None, "") \
            else 0
    except ValueError:
        raise Refused("bad_args", "the account number is not a whole number")
    if account_no < 0 or account_no > btx.MAX_ACCOUNT:
        raise Refused("bad_args", f"the account number must be in "
                      f"0..{btx.MAX_ACCOUNT}")
    # THE XPUB AND THE INDEX, from the environment by preference (the wake
    # agent puts them there); argv still works for a hand run, with the
    # warning env_or_argv prints. Neither present is a refusal.
    xpub = env_or_argv("GS_BTC_XPUB", args.xpub, "the account xpub")
    index = env_or_argv("GS_BTC_INDEX",
                        None if args.index is None else str(args.index),
                        "the deposit index")
    if not xpub or index is None or index == "":
        raise Refused("bad_args", "the account xpub and the deposit index "
                      "are required (GS_BTC_XPUB / GS_BTC_INDEX, or --xpub "
                      "/ --index)")
    try:
        index = int(str(index))
    except ValueError:
        raise Refused("bad_args", "the deposit index is not a whole number")
    if index < 0 or args.min_conf < 1 or args.fee_target_blocks < 1:
        raise Refused("bad_args", "index, min-conf and fee target must be "
                      "sensible")
    if not 0 <= args.max_affiliate_bps <= 1000:
        raise Refused("bad_args", "--max-affiliate-bps must be 0..1000")
    if not 1 <= args.feerate_floor <= args.feerate_ceiling:
        raise Refused("bad_args", "the fee band must be 1 <= floor <= ceiling")
    if not 1 <= args.op_return_max_bytes <= btx.MAX_OP_RETURN_DATA:
        raise Refused("bad_args", "--op-return-max-bytes must be 1..255")
    if args.min_send_sat < FORWARD_MIN_SAT:
        raise Refused("bad_args", f"--min-send-sat cannot be under "
                      f"{FORWARD_MIN_SAT} (ThorChain's BTC dust threshold)")
    min_out = None
    if args.min_out_xmr:
        min_out = finite_decimal(args.min_out_xmr)
        if min_out is None or min_out <= 0:
            raise Refused("bad_args", "--min-out-xmr is not a positive number")
    try:
        servers = [parse_server(s) for s in args.electrum]
        address = derive_receive_address(xpub, index, args.network)
    except watch.BtcWatchError as e:
        raise Refused("bad_args", str(e))
    # MONEY MOVES ONLY ON A SERVER THAT IS WHO IT SAYS (the review of
    # stages 2-6): a .onion or a pinned certificate. Over an unpinned
    # clearnet server any Tor exit can answer the fee estimate (up to the
    # ceiling, burned to miners) or forge the history that proves a
    # broadcast seen. A rehearsal may still look where it likes.
    if (args.broadcast or args.reconcile) and not all(
            watch.server_authenticated(s) for s in servers):
        raise Refused("bad_args", "a forward that sends needs every "
                      "--electrum server to be a .onion or pinned "
                      "(host:port,<sha256 of its certificate>): over an "
                      "unpinned clearnet server any Tor exit can forge the "
                      "fee estimate or the history. Re-pair (gs_wake_keys "
                      "--btc-electrum) with an onion or a pin.")
    try:
        dest_xmr = load_receive_bundle(args.dest_from_receive_wallet)["address"]
    except (ValueError, OSError) as e:
        raise Refused("bad_bundle", f"{type(e).__name__}: {e}")
    proxy = validate_proxy(args.tor_proxy)
    # On its own circuit, not the bare proxy's default one (the
    # host-privacy pass): the Tor check is the first request of every
    # forward, and it shared Tor's default circuit with any other
    # uncredentialed stream on the box.
    verify_tor(isolated_proxy(args.tor_proxy, "forward:verify"))
    integrity_log("forward", "start")

    # 1. what settled, and the server's fee estimate, in one session
    try:
        picture = look(address, servers, args.tor_proxy, min_conf=args.min_conf,
                       network=args.network, timeout=args.timeout,
                       fee_blocks=None if args.feerate_sat_vb else
                       args.fee_target_blocks)
    except watch.PinMismatch as e:
        raise Refused("pin_mismatch", str(e))
    except watch.BtcWatchError as e:
        integrity_log("forward", "look_failed")
        print(f"[!] could not look at the deposit address: {e}")
        raise SystemExit(EXIT_FAILED)
    if shutdown_requested():
        raise SystemExit(EXIT_FAILED)
    # THE RECONCILIATION (STAGE5_PLAN.md 3.1): a forward already went out.
    # What became of it decides everything after this point; a fresh
    # forward, when one follows, leaves out every outpoint a listed forward
    # of ours consumed and does not overwrite the earlier plan.
    exclude, why, _replaces, _prev_ins = (), None, None, None
    _round_ops = set()
    if args.reconcile:
        try:
            plan0 = _read_plan(args.outfile)
        except (OSError, ValueError):
            # NO CURRENT PLAN. A chain whose current plan was rotated aside
            # by a fresh forward that then refused (stage 5's ordering) is
            # read from its newest predecessor rather than refused for
            # ever (STAGE6_PLAN.md 1(b), 3.2); only a chain with no plan
            # anywhere is `no_plan`.
            plan0 = _recover_plan(args.outfile)
            if plan0 is None:
                raise Refused("no_plan", "--reconcile needs the plan of the "
                              "forward that went out, at --outfile")
            integrity_log("forward", "plan_recovered")
            print("  [!] no current plan at the outfile; reading the newest "
                  "rotated one (a fresh forward was refused after the "
                  "rotation)")
        verdict = reconcile(args, plan0, picture, address, index, servers,
                            dest_xmr)
        if verdict[0] == "resend":
            verdict = resend(args, plan0, verdict[1], address, servers,
                             kept_exclude=(verdict[2] if len(verdict) > 2
                                           else ()))
        if verdict[0] == "done":
            return verdict[1]
        _, exclude, why = verdict[:3]
        exclude = [tuple(x) for x in exclude]
        integrity_log("forward", f"reconcile_{why}")
        # WHICH OUTPUTS ON THE ADDRESS ARE A ROUND OF RETURNED MONEY, for
        # the bound (round_outpoints): the refunds the reconciliation
        # recorded on the plan this run (in memory, whether or not it
        # wrote it) and the sizes of every forward on the chain. Counted
        # into the new plan below (carried_refunds).
        _round_ops = round_outpoints(picture.get("utxos"),
                                     plan0.get("refunds"),
                                     [plan0] + _chain_plans(args.outfile))
        if why in ("evicted", "rejected"):
            # THE INPUTS THE RE-SIGN IS FOR: anything else it carries came
            # back meanwhile (carried_returned), and the bound counts the
            # rounds among it (carried_refunds).
            _prev_ins = _outpoints(plan0.get("inputs"))
        if why == "bumped":
            # THE REPLACEMENT SPENDS WHAT THE STUCK TRANSACTION SPENDS
            # (stage 6, STAGE6_PLAN.md 3.1): that plan's inputs join the
            # picture as settled money that MUST be spent, and the run's
            # floor rises to what a node holding the original will take
            # in its place -- and any node holding another forward of ours
            # over the same outpoints (replacement_floor). The stuck plan
            # is the current one or a rotated predecessor (stuck_forward);
            # either way the new plan names it in `replaces` and the
            # current plan is rotated aside when the new one is written.
            plan_b, _conflicts = verdict[3], verdict[4]
            _replaces = str(plan_b.get("txid") or "").lower()
            _prev_ins = _outpoints(plan_b.get("inputs"))
            with_plan_inputs(picture, plan_b, args.min_conf)
            args.feerate_floor = replacement_floor(
                plan_b, _conflicts, args.op_return_max_bytes,
                args.feerate_floor)
            if args.feerate_floor > args.feerate_ceiling:
                # The original already pays what this box allows; more
                # would be over the ceiling. It stands, and the Pi asks
                # again after the fee window.
                write_status(args.outfile, STATUS_DELAYED)
                raise Refused("bump_over_ceiling",
                              "replacing the forward would have to pay "
                              f"over the {args.feerate_ceiling} sat/vB "
                              "ceiling this box accepts; the original "
                              "stands")
        # THE OLD PLAN IS NOT ROTATED HERE. It stays the current plan until
        # the fresh forward below has a plan to write (see write_plan at
        # the end): every refusal between here and there -- a fee over the
        # ceiling (`delayed`), a quote that fails, a memo that will not fit
        # -- used to leave the chain with no current plan, and the next
        # run refused `no_plan` about a forward whose record sat one file
        # over (STAGE6_PLAN.md 1(b)).
    if picture["settled_sat"] <= 0:
        # NOTHING UNSPENT AT ALL: was it ever paid, and where did it go? A
        # forward that went out and died before its plan was written is
        # found here and reconstructed (stage 5); a spend this tool did
        # not sign fails the run; a never-paid address falls through.
        if picture["state"] == watch.STATE_NOT_SEEN:
            found = reconcile_emptied(address, index, servers, args.tor_proxy,
                                      args.network, args.timeout, dest_xmr,
                                      args.outfile, picture["tip"])
            if found is not None:
                return found
        # WHAT WAS SEEN, FOR THE PHONE. A forward that found nothing settled
        # is not a failed machine; it is "not yet" or "still confirming",
        # and the wake agent maps this one word onto the phase vocabulary
        # (STAGE4_PLAN.md 3.6). One word, no amount, no depth.
        write_status(args.outfile, picture["state"])
        raise Refused("nothing_settled",
                      f"nothing is settled at this address to {args.min_conf} "
                      "confirmations; ask again later")

    # 2. the fee, sized against the largest transaction the policy allows,
    #    over the inputs worth spending at that rate
    try:
        rate = fee_band(args.feerate_sat_vb or picture.get("fee_sat_vb"),
                        args.feerate_floor, args.feerate_ceiling)
        chosen, skipped_dust, unsettled = select_inputs(picture["utxos"],
                                                        args.min_conf, rate,
                                                        exclude=exclude)
        if not chosen:
            raise Refused("nothing_economic",
                          "what is settled here is all dust at this fee "
                          "rate: each output would cost more to spend than "
                          "it carries")
        settled_sat = sum(u["value"] for u in chosen)
        n_inputs = len(chosen)
        vsize_bound, fee_sat = size_the_fee(n_inputs,
                                            args.op_return_max_bytes, rate)
        # ...PLUS 0..bound-1 sat (FEE_JITTER), so the fee is not the bound
        # times anything -- and never a satoshi the deposit cannot bear:
        # capped by the room above the smallest forward and under the
        # fee fraction, so at the exact floor there is no jitter rather
        # than a refusal the floor said could not happen.
        _room = min(settled_sat - fee_sat - int(args.min_send_sat),
                    int(settled_sat * MAX_FEE_FRACTION) - fee_sat)
        # DRAWN OVER THE ROOM THERE IS, not drawn over the bound and then
        # clamped (the review of stages 2-6): with less room than a bound,
        # every draw past it landed ON the cap -- the fee exactly
        # bound x rate, or exactly a fifth of the inputs, or the send
        # exactly the minimum, on most runs near the floor. Uniform over
        # what is allowed, the cap is one value among the rest. The clamp
        # stays for a jitter that ignores its argument.
        _w = max(1, min(int(vsize_bound), int(_room) + 1))
        _jit = max(0, min(int(FEE_JITTER(_w)), _room))
        fee_sat += _jit
        send_sat = amount_to_send(settled_sat, fee_sat, args.min_send_sat)
    except Refused as e:
        # A REFUSAL ABOUT TODAY'S FEE IS A WORD, NOT A DEAD END (STAGE5_PLAN.md
        # 3.2). `delayed`: with cheaper blocks this same deposit forwards,
        # and the Pi tries again by itself. `short`: even at the floor rate
        # this pair allows, what settled cannot carry a forward -- under
        # what was quoted -- and no waiting changes that. Decided on the
        # one-input floor at the FLOOR rate, the same arithmetic the vault
        # accepts a deposit by.
        if e.kind in DELAY_KINDS:
            hopeless = picture["settled_sat"] < btx.forward_floor_sat(
                args.op_return_max_bytes, args.feerate_floor,
                args.min_send_sat)
            write_status(args.outfile,
                         STATUS_SHORT if hopeless else STATUS_DELAYED)
        raise

    # 3. the quote, for exactly that amount, to exactly this destination
    oracle = btc_per_xmr_oracle(isolated_proxy(args.tor_proxy,
                                               "forward:oracle"),
                                getter=safe_get)
    inbound, memo, expected = fetch_quote(send_sat, dest_xmr, args.tor_proxy)
    quoted_at = _clock()                   # the clock the broadcast reads
    inbound_spk = validate_inbound(inbound, args.network)
    memo_quoted = validate_memo(memo, dest_xmr)
    expected_xmr, worst_xmr = validate_expected(
        expected, send_sat, min_out, args.max_slippage, oracle)
    memo_text, memo_limit, affiliate_bps, limit_set = enforce_memo_terms(
        memo_quoted, expected_xmr, worst_xmr, args.max_affiliate_bps)
    memo_b = fit_memo(memo_text, dest_xmr, args.op_return_max_bytes)

    # 4. THORNode's word on the inbound, when the operator named a node
    cross_checked, outbound_fee = False, None
    if args.thornode:
        dust, outbound_fee = cross_check_inbound(inbound, args.thornode,
                                                 args.tor_proxy)
        cross_checked = True
        if dust is not None and send_sat < dust:
            if send_sat + _jit >= dust:
                # ONLY THE FEE'S JITTER PUT IT UNDER (self-doubt over the
                # fix pass): the room the jitter was given knew the floor
                # and the fee fraction, not a live dust threshold above
                # the floor, so a send within one bound of it was signed
                # on some draws and refused on others. Deterministic now:
                # the jitter gives back what the threshold needs. The
                # quote stands (it was for a little less; more arrives).
                # ...AND NOT EXACTLY ON THE THRESHOLD: a send equal to
                # THORNode's published dust figure is a value anyone can
                # test for. What the jitter has left over it is drawn.
                _give = dust - send_sat
                _spare = _jit - _give
                _more = (max(0, min(int(FEE_JITTER(_spare + 1)), _spare))
                         if _spare > 0 else 0)
                fee_sat -= _give + _more
                send_sat += _give + _more
            else:
                raise Refused("below_thor_dust",
                              "ThorChain's live dust threshold is above what "
                              "this forward would carry; it would be ignored")
    integrity_log("forward", "quoted")

    # 5-6. build, and sign unless plan-only
    account = None
    if not args.plan_only:
        words, passphrase = take_seed()
        account = account_for(words, passphrase, args.network, xpub,
                              account_no=account_no)
        del words
    # A TRANSACTION THE SIGNER WILL NOT BUILD IS A REFUSAL, NOT A TRACEBACK
    # (the MED pass after the deep read): a server that repeated an
    # outpoint, or named a tip nLockTime reads as a date, reached the signer
    # as an input twice or a locktime out of range, and its own refusal
    # escaped main as an uncaught exception -- exit 1, no kind on the chain,
    # no word for the agent, and the same server leading every retry. The
    # watch side now drops the repeat and refuses the tip; this is the
    # backstop for whatever else the signer declines.
    try:
        tx, txid, vsize, real_rate, signed = build_and_sign(
            chosen, picture["tip"], inbound_spk, send_sat, fee_sat, memo_b,
            account, index, address, args.network, sign=not args.plan_only)
    except btx.BtcTxError as e:
        raise Refused("build_failed",
                      f"the transaction could not be built or signed "
                      f"({e}); nothing moved")
    if signed and real_rate < args.feerate_floor:
        raise Refused("fee_out_of_band", "the signed transaction's real "
                      "rate fell under the floor")
    integrity_log("forward", "signed" if signed else "planned")

    # 7. THE BROADCAST, and only with --broadcast: after every guard above,
    #    from the bytes in memory, never from a file. See the header.
    outcome, sub, seen_r = None, None, None
    if args.broadcast:
        age = _clock() - quoted_at
        if age > args.quote_max_age:
            raise Refused("quote_stale",
                          f"{int(age)} s passed since the quote, over the "
                          f"{args.quote_max_age} s this box allows between "
                          "quoting and sending; nothing was sent")
        # ON DISK BEFORE THE BYTES LEAVE: the one mark that tells this
        # forward, found on the chain with no plan, from a copy of its memo
        # (SIGNED_SCHEMA says why).
        record_signed(args.outfile, txid)
        integrity_log("forward", "sending")
        try:
            sub = bcast_submit(tx.serialize().hex(), txid, address, servers,
                               args.tor_proxy, network=args.network,
                               timeout=args.timeout)
        except watch.PinMismatch:
            raise Refused("pin_mismatch",
                          "a pinned Electrum server presented another "
                          "certificate while sending; nothing was sent")
        except watch.BtcWatchError as e:
            raise Refused("bad_args", str(e))
        outcome = sub["outcome"]
        integrity_log("forward", f"broadcast_{outcome}")
        if sub.get("pin_mismatch"):
            integrity_log("forward", "send_pin_mismatch")
        if sub["mismatched"]:
            integrity_log("forward", "txid_mismatch")
        if outcome == bcast.OUTCOME_REJECTED:
            raise Refused("broadcast_rejected",
                          f"every Electrum server that answered "
                          f"({len(sub['codes'])} of {sub['attempts']}) "
                          f"rejected the transaction (codes {sub['codes']}); "
                          "nothing moved. A node with the standard OP_RETURN "
                          "relay policy refuses a swap memo: the server list "
                          "needs one that relays it (STAGE3_PLAN.md 3.3)")
        if outcome == bcast.OUTCOME_UNREACHABLE:
            print(f"[!] no Electrum server could be reached to send "
                  f"({sub['attempts']} tried); nothing moved")
            raise SystemExit(EXIT_FAILED)
        # ACCEPTED OR AMBIGUOUS: the money may have moved. Look for it.
        try:
            seen_r = bcast_seen(txid, address, servers, args.tor_proxy,
                                network=args.network, timeout=args.timeout,
                                wait_s=args.seen_wait,
                                interval_s=args.seen_interval,
                                avoid=sub["server"])
        except watch.PinMismatch:
            seen_r = {"seen": False, "height": None, "server": None,
                      "cert_sha256": None, "polls": 0, "asked": False,
                      "pin_mismatch": True}
            integrity_log("forward", "seen_pin_mismatch")
        integrity_log("forward",
                      "broadcast_seen" if seen_r["seen"] else "broadcast_unseen")

    # 8. the plan file and the summary
    moved = outcome in bcast.MAYBE_MOVED
    # THE SIGNED BYTES ARE KEPT ONLY WHERE NOTHING ELSE HOLDS THEM: an
    # unsigned plan carries no power; --write-signed-hex is the caller's
    # decision; and a broadcast the network has not shown is kept so the
    # transaction is not lost (stage 5 consumes it). A dry run keeps them
    # nowhere but the job log; a seen broadcast keeps them nowhere at all.
    if not signed:
        hex_reason = "unsigned"
    elif args.write_signed_hex:
        hex_reason = "write_signed_hex"
    elif moved and not seen_r["seen"]:
        hex_reason = "unseen" if outcome == bcast.OUTCOME_ACCEPTED \
            else "ambiguous"
    else:
        hex_reason = None
    plan = {
        "schema": PLAN_SCHEMA,
        "network": args.network,
        "dry_run": not args.broadcast,
        "broadcast": moved,                      # True: the money may have moved
        "broadcast_outcome": outcome,            # the four words, or None
        "broadcast_server": sub["server"] if sub else None,
        "broadcast_codes": sub["codes"] if sub else [],
        "broadcast_attempts": sub["attempts"] if sub else 0,
        "broadcast_mismatched": sub["mismatched"] if sub else 0,
        "seen": bool(seen_r and seen_r["seen"]),
        "seen_height": seen_r["height"] if seen_r else None,
        "seen_server": seen_r["server"] if seen_r else None,
        "seen_asked": bool(seen_r and seen_r["asked"]),
        "seen_polls": seen_r["polls"] if seen_r else 0,
        "signed": signed,
        "index": index,
        "address": address,
        "inputs": [{"tx_hash": u["tx_hash"], "vout": u["vout"],
                    "value": u["value"], "confirmations": u["confirmations"]}
                   for u in chosen],
        "skipped_dust": skipped_dust,
        "unsettled_outputs": unsettled,
        "tip": picture["tip"],
        "inbound": inbound,
        "inbound_cross_checked": cross_checked,
        # WHAT A REFUND OF THIS FORWARD LACKS: ThorChain's outbound fee for
        # BTC from the node's inbound entry, in sat (None without a node or
        # without the field). classify_returns judges FULL on the refund
        # plus this, and the vault scales a partly filled swap's quote by
        # the two together.
        "outbound_fee_sat": outbound_fee,
        "memo": memo_text,                       # as laid out in the OP_RETURN
        "memo_quoted": memo_quoted,              # as the aggregator returned it
        "memo_limit_set": limit_set,             # True: the floor was written in
        "memo_bytes": len(memo_b),
        "op_return_max_bytes": args.op_return_max_bytes,
        "settled_sat": settled_sat,
        "send_sat": send_sat,
        "fee_sat": fee_sat,
        "feerate_target_sat_vb": rate,
        "vsize_bound": vsize_bound,
        "vsize": vsize,
        "feerate_real_sat_vb": real_rate,
        "expected_xmr": str(expected_xmr),
        "worst_case_xmr": str(worst_xmr),
        "memo_limit_base_units": memo_limit,
        "affiliate_bps": affiliate_bps,
        "dest_xmr": dest_xmr,
        "txid": txid,
        "tx_hex": tx.serialize().hex() if hex_reason else None,
        "tx_hex_reason": hex_reason,
        "signed_hex_written": bool(signed and hex_reason),
        "server": picture.get("server"),
        "cert_sha256": picture.get("cert_sha256"),
        "ts": int(time.time()) // 600 * 600,
        # A RECONCILIATION'S FRESH FORWARD says why it exists and what it
        # left out; a first forward says neither.
        "reconcile_reason": why,
        "excluded_outpoints": len(exclude),
        "resends": 0,
        # THE TRANSACTION THIS ONE REPLACES (a bump, stage 6), or None. The
        # pairs rewrite counts a replaced plan and its replacement as ONE
        # swap; the reconciliation marks whichever the network did not
        # take as superseded.
        "replaces": _replaces,
        # HOW MANY OF THIS FORWARD'S INPUTS CAME BACK MEANWHILE (a bump, an
        # evicted or rejected re-sign built while returned money sat
        # settled), for the operator's reading and for a reader of plans
        # from before the field below. None for a first forward and for a
        # plan whose reason already says so.
        "carried_returned": (
            sum(1 for u in chosen
                if (str(u["tx_hash"]).lower(), int(u["vout"]))
                not in _prev_ins)
            if _prev_ins is not None else None),
        # ...AND HOW MANY OF THOSE ARE A ROUND OF RETURNED MONEY (the MED
        # pass after the deep read; round_outpoints): a verified ThorChain
        # refund, or an output the size of one. THIS is what the bound
        # counts (_carried_returned): a `returned` forward of honest
        # top-ups alone carries none and is not a round. None for a first
        # forward.
        "carried_refunds": (
            sum(1 for u in chosen
                if (str(u["tx_hash"]).lower(), int(u["vout"])) in _round_ops
                and (str(u["tx_hash"]).lower(), int(u["vout"]))
                not in (_prev_ins or set()))
            if why else None),
    }
    if why:
        # THE KEPT MARK TRAVELS WITH THE CURRENT PLAN (self-doubt over the
        # fix): a fresh forward AT the bound -- a bump, a re-sign -- leaves
        # the kept money out, and the plan it rotates aside was the only
        # one that named it. The agent reads the word `kept` off the
        # CURRENT plan alone, so the client heard `sent` about money that
        # sat on the address until the next reconciliation marked it
        # again. Carried only when none of it rides in this forward: an
        # output this forward spends is not kept, it is being moved.
        _mk = plan0.get("returned_kept") if isinstance(plan0, dict) else None
        if isinstance(_mk, dict) and _pairs(_mk.get("outpoints")) \
                and not (_pairs(_mk.get("outpoints"))
                         & {(str(u["tx_hash"]).lower(), int(u["vout"]))
                            for u in chosen}):
            plan["returned_kept"] = _mk
        # A RECONCILIATION'S FRESH FORWARD ROTATES THE OLD PLAN ASIDE NOW,
        # with a plan in hand to take its place; the chain is the record of
        # every forward the deposit had, and it never lacks a current one.
        _rotate_plan(args.outfile)
    write_plan(args.outfile, plan)
    if not args.broadcast:
        integrity_log("forward", "not_broadcast")
        print(f"  forward {'SIGNED' if signed else 'PLANNED (unsigned)'}, "
              f"NOT BROADCAST (dry run)")
    else:
        by = f" by {sub['server']}" if sub["server"] else ""
        rej = (f", {len(sub['codes'])} rejection(s) (codes {sub['codes']})"
               if sub["codes"] else "")
        mis = (f", {sub['mismatched']} foreign txid reply(ies)"
               if sub["mismatched"] else "")
        print(f"  forward SIGNED and SENT: {outcome}{by} after "
              f"{sub['attempts']} server(s){rej}{mis}")
        if outcome == bcast.OUTCOME_AMBIGUOUS:
            print("  [!] AMBIGUOUS: the bytes left for a server and no "
                  "acceptance came back. The transaction MAY be in the "
                  "network.")
        if seen_r["seen"]:
            where = ("in the mempool" if seen_r["height"] <= 0
                     else f"in a block at height {seen_r['height']}")
            print(f"  seen: {where}, listed by {seen_r['server']} after "
                  f"{seen_r['polls']} poll(s)")
        elif seen_r["asked"]:
            print(f"  seen: NOT yet listed by any server asked "
                  f"({seen_r['polls']} poll(s) over {args.seen_wait:g} s)")
        else:
            print("  seen: UNKNOWN -- no server could be asked"
                  + (" (a pinned server presented another certificate)"
                     if seen_r.get("pin_mismatch") else ""))
        if hex_reason in ("unseen", "ambiguous"):
            print("  [!] the signed transaction is KEPT in the plan file "
                  f"({hex_reason}): the network has not shown it yet, and "
                  "losing it would lose the forward. It is a bearer "
                  "instrument until it confirms.")
    print(f"  from {scrub_address(address)} index {index}: "
          f"{settled_sat} sat in {n_inputs} spendable output(s)"
          f"{f', {skipped_dust} dust left' if skipped_dust else ''}"
          f"{f', {unsettled} not yet settled' if unsettled else ''}")
    print(f"  to   {scrub_address(inbound)}"
          f"{' (THORNode-verified)' if cross_checked else ''}: "
          f"{send_sat} sat, fee {fee_sat} sat at {rate} sat/vB "
          f"(bound {vsize_bound} vB"
          f"{f', real {vsize} vB at {real_rate} sat/vB' if signed else ''})")
    whose = ("SET by this tool; the quote's was absent, zero or lower"
             if limit_set else "the quote's own")
    print(f"  memo {len(memo_b)} bytes (policy {args.op_return_max_bytes}); "
          f"expected about {expected_xmr} XMR, worst case {worst_xmr}; "
          f"chain limit {memo_limit} base units ({whose}), "
          f"affiliate {affiliate_bps} bps")
    print(f"  txid {txid}")
    if signed and not args.broadcast and not args.write_signed_hex:
        # To the job log, which the agent keeps at 0600 and truncates each
        # boot; not to the plan file. See --write-signed-hex.
        print(f"  signed hex (dry run: NOT broadcast, not persisted): "
              f"{tx.serialize().hex()}")
    print(f"  plan written: {args.outfile}")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
