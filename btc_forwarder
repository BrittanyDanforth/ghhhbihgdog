def _vouchers_not(sub):
    """The server `seen` should not take the word of when another can be
    asked, from a submit's result: the one that accepted (it cannot vouch
    for itself)."""
    h = sub.get("server")
    return [h] if isinstance(h, str) and h else []


def _distrusted(sub, plan=None):
    """The servers `seen` must NEVER take the word of: every one that
    answered a submit with a txid not ours -- this submit's
    (`mismatched_servers`) and every earlier one's this plan recorded
    (`broadcast_distrusted`). Caught out once, such a server is no witness
    for this forward again, even as the only one configured (seen's
    `distrust`). ON THE PLAN, not in memory only (the review of the stage 3
    read): the next run's reconciliation read the address from the first
    server that answered -- the one caught out -- which listed the txid it
    had been handed, and the kept bytes were dropped as proven about a
    transaction the network never had. The plan already names the
    accepting and the listing server; this is a name of the same kind,
    on the vault, and it never reaches the Pi or the chat."""
    out = list((sub or {}).get("mismatched_servers") or ())
    if isinstance(plan, dict):
        out += list(plan.get("broadcast_distrusted") or ())
    return sorted({h for h in out if isinstance(h, str) and h})
