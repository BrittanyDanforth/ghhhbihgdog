def fee_band(rate, floor, ceiling):
    """The fee rate this forward pays, from the server's estimate and the
    operator's band.

    ABOVE THE CEILING IS REFUSED, not clamped: a server saying 5000 sat/vB
    is broken or hostile, and silently paying the ceiling instead would
    still be a decision made for money on a number nobody trusts. (With a
    THORNode named, todays_rate has already bounded the estimate by
    ThorChain's own rate -- a number the run does trust -- so what reaches
    here over the ceiling is ThorChain saying the network is there.)

    BELOW THE FLOOR PAYS THE FLOOR. The floor is the operator's "never
    less than this" (a rate under which their own node will not relay, or
    one they chose so a forward does not sit for hours); an estimate under
    it is a cheap network, the best day to forward. The first version
    refused it as out of band -- and once a fee refusal became `delayed`
    (stage 5), an operator who raised the floor above 1 had every forward
    on a cheap day wait an hour and try again, for as long as the network
    stayed cheap: the floor turned the good days into the days nothing
    moved. Paying MORE than an estimate is never the failure mode that
    strands money; paying less is."""
    if rate is None:
        raise Refused("no_fee_estimate",
                      "the server has no fee estimate for that target; "
                      "give --feerate-sat-vb explicitly or try later")
    if not isinstance(rate, int) or isinstance(rate, bool) or rate < 1:
        raise Refused("bad_fee_estimate", "the fee estimate is not a "
                      "positive whole number of sat/vB")
    if rate > ceiling:
        raise Refused("fee_out_of_band",
                      f"the fee estimate is above the {ceiling} sat/vB "
                      "ceiling this box accepts; raise the ceiling only if "
                      "the network really is there")
    if rate < floor:
        integrity_log("forward", "fee_floor_applied")
        print(f"  fee estimate {rate} sat/vB is under this box's floor; "
              f"paying the floor ({floor} sat/vB)")
        return floor
    return rate


#: What spending one more P2WPKH input adds to a transaction, in vbytes,
#: rounded up.
INPUT_MARGINAL_VB = btx.INPUT_BASE + -(-btx.WITNESS_P2WPKH_MAX // 4)


def dust_line(rate):
    """The value at or under which select_inputs leaves an output (not a
    `must` one) behind at `rate`: twice what spending it costs."""
    return 2 * INPUT_MARGINAL_VB * rate


def dust_from(value):
    """The lowest whole rate at which an output of `value` is dust: from
    there up, select_inputs leaves it behind."""
    return -(-int(value) // dust_line(1))


def select_inputs(utxos, min_conf, rate, exclude=()):
    """The outputs the forward spends, and why the rest are left.

    SETTLED TO min_conf, output by output -- gs_btc_watch.summarize counts
    settled_sat that way, and an input that is mined but shallower would be
    spent while not counted, so its whole value would go to the miner as
    fee. And WORTH SPENDING: each P2WPKH input costs about 69 vB, and an
    output worth less than twice its own cost at this rate is dust someone
    (perhaps deliberately) parked on the address; sweeping two hundred of
    them would make the fee eat the deposit and strand the real payment.
    Dust stays where it is; it is not money this forward can carry.
    NEVER TWICE: an outpoint in `exclude` -- consumed by a forward of ours
    the network lists (--reconcile) -- is not spendable money whatever a
    server says, and is left out before anything else is decided.
    AND ONE MORE RULE (stage 6): an output marked `must` -- one a forward
    of ours in the mempool already spends, that its REPLACEMENT is being
    built over (with_plan_inputs) -- is spent whether or not it is worth
    spending at today's rate. It is committed either way: the stuck
    transaction spends it, and the replacement conflicts with the stuck
    one by spending the same outpoints, so the floor a node takes
    (bump_floor) is sized over the SAME number of inputs; leave one out
    as dust and the replacement pays less than that floor was computed
    for and is refused. Settlement is still required: a `must` output the
    server now shows shallow (a reorg) is not spent.
    Returns (chosen, skipped_dust, unsettled)."""
    floor = dust_line(rate)
    excluded = {(str(t).lower(), int(v)) for t, v in exclude}
    chosen, dust, unsettled = [], 0, 0
    for u in utxos:
        if (str(u["tx_hash"]).lower(), int(u["vout"])) in excluded:
            continue
        if u["confirmations"] < min_conf or u["confirmations"] < 1:
            unsettled += 1
        elif u["value"] <= floor and not u.get("must"):
            dust += 1
        else:
            chosen.append(u)
    return chosen, dust, unsettled


def size_the_fee(n_inputs, op_return_limit, rate):
    """(vsize_upper_bound, fee_sat) for a transaction of `n_inputs` P2WPKH
    inputs, the largest inbound output and the largest OP_RETURN the policy
    allows, at `rate` sat/vB."""
    bound = btx.vsize_upper_bound(
        n_inputs, [INBOUND_SPK_MAX, btx.op_return_script_len(op_return_limit)])
    return bound, btx.fee_for(bound, rate)


#: Bitcoin Core's MAX_STANDARD_TX_WEIGHT: a heavier transaction is refused
#: by every relaying node ("tx-size") whatever it pays or carries. A public
#: relay constant, not a defence -- it only keeps the forward relayable.
STANDARD_TX_WEIGHT = 400_000


def standard_fits(n_inputs, op_return_limit):
    """Whether a forward of `n_inputs` P2WPKH inputs stays standard at its
    worst case (vsize_upper_bound, the bound the fee is sized on)."""
    return btx.vsize_upper_bound(
        n_inputs, [INBOUND_SPK_MAX, btx.op_return_script_len(op_return_limit)]
    ) * 4 <= STANDARD_TX_WEIGHT


def spendable(utxos, min_conf, rate, exclude, op_return_limit,
              min_send_sat):
    """What a forward at `rate` spends: select_inputs' choice, CAPPED to what
    one standard transaction can carry, and CUT to what the fee guards let
    it carry. `min_send_sat` is required, not defaulted: a caller that left
    it out would get the uncut choice without a word, and a status word
    decided on it would disagree with what main() spends (None asks for
    the uncut choice on purpose). Every `must` input (a
    replacement's committed outpoints) is kept whatever happens; of the
    others, the LARGEST first, in the order given.
    Returns (chosen, skipped_dust, unsettled, left_over): left_over counts
    the outputs worth spending that stay on the address, for either cut.

    THE CAP: a dust flood a little over twice each output's input cost (294
    sat relays; about 1,450 of them) made a forward no node would relay:
    the dry run passed, the broadcast was rejected everywhere, every retry
    built the same transaction, and the deposit beside the flood could
    never be sent by this tool. When the `must` inputs alone are over the
    cap, all of them are kept and the caller refuses (standard_fits).

    THE CUT (the fee's share): select_inputs keeps an output worth more
    than TWICE its input cost, and send_refusal lets the fee be at most a
    FIFTH of what is spent -- an input pays its way there only above FIVE
    times its cost. Outputs between the two lines each raised the fee's
    share, and enough of them refused a forward the deposit beside them
    carried alone: `fee_eats_deposit` at today's rate, `delayed`, and the
    forward waited for fees to RISE until the outputs turned to dust --
    a wait anyone who knows the address could buy with a hundred tiny
    payments. So when the capped choice fails send_refusal, the longest
    largest-first prefix that passes is spent instead, and the rest stay
    on the address like dust.
    WHY A PREFIX, AND THE LONGEST: the fee depends only on how many inputs
    there are, so of any n the n largest carry the most; the fifth's slack
    moves by (a fifth of the value) less (the input's cost) per input, a
    step that only shrinks down a largest-first order, so the counts it
    allows are one run; and every input kept is over twice its cost, so
    what is sent only grows with n and the minimum allows every n from
    some count up. The longest prefix that passes is therefore the one
    that sends the most, and scanning down from the capped count finds it.
    When none passes, the capped choice is returned as it was, and the
    caller refuses on it as before -- same kind, and fee_word decides the
    word over every rate.

    The ONE selection main() and forwards_at both use, so the word a
    refusal leaves is decided on what a forward would really spend."""
    chosen, dust, unsettled = select_inputs(utxos, min_conf, rate,
                                            exclude=exclude)
    if not chosen:
        return chosen, dust, unsettled, 0
    must = [u for u in chosen if u.get("must")]
    others = sorted((u for u in chosen if not u.get("must")),
                    key=lambda u: -int(u["value"]))
    k = len(others)
    while k > 0 and not standard_fits(len(must) + k, op_return_limit):
        k -= 1
    if min_send_sat is not None and (must or k):
        _base = sum(int(u["value"]) for u in must)
        _sums = [0]
        for u in others[:k]:
            _sums.append(_sums[-1] + int(u["value"]))
        for j in range(k, -1, -1):
            if not must and j == 0:
                break
            _, _fee = size_the_fee(len(must) + j, op_return_limit, rate)
            if send_refusal(_base + _sums[j], _fee, min_send_sat) is None:
                k = j
                break
    keep = {id(u) for u in must} | {id(u) for u in others[:k]}
    kept = [u for u in chosen if id(u) in keep]
    return kept, dust, unsettled, len(chosen) - len(kept)


def send_refusal(settled_sat, fee_sat, min_send_sat):
    """None when a forward of `settled_sat` paying `fee_sat` passes both
    fee guards, else the (kind, message) amount_to_send refuses it with.
    Pure -- a Refused logs to the chain as it is built -- so it can be
    asked of rates nobody is going to pay (forwards_at)."""
    if fee_sat > settled_sat * MAX_FEE_FRACTION:
        return ("fee_eats_deposit",
                "the network fee would take more than "
                f"{int(MAX_FEE_FRACTION * 100)}% of what settled; wait "
                "for cheaper blocks rather than burn the deposit")
    send = settled_sat - fee_sat
    if send < min_send_sat:
        return ("below_minimum",
                f"after the fee this forward would carry {send} sat "
                f"and the smallest forward that ThorChain does not "
                f"treat as dust is {min_send_sat} sat; at least "
                f"{min_send_sat + fee_sat} sat must settle first")
    return None


def amount_to_send(settled_sat, fee_sat, min_send_sat):
    """What reaches ThorChain: everything settled minus the fee, or a
    refusal that names the number needed."""
    why = send_refusal(settled_sat, fee_sat, min_send_sat)
    if why is not None:
        raise Refused(*why)
    return settled_sat - fee_sat


def forwards_at(utxos, min_conf, rate, exclude, op_return_limit,
                min_send_sat):
    """Whether a forward at `rate` passes every fee-shaped guard main()
    applies: spendable chooses something (cut, as main() cuts it, to what
    the fee guards let it carry), and the fee size_the_fee puts on it
    passes send_refusal. The fee's jitter is left out: main()
    draws it inside the room those two guards leave, so it never turns a
    pass into a refusal."""
    chosen, _, _, _ = spendable(utxos, min_conf, rate, exclude,
                                op_return_limit, min_send_sat)
    if not chosen or not standard_fits(len(chosen), op_return_limit):
        return False
    _, fee = size_the_fee(len(chosen), op_return_limit, rate)
    return send_refusal(sum(u["value"] for u in chosen), fee,
                        min_send_sat) is None


def forwards_in_band(utxos, min_conf, floor, ceiling, exclude,
                     op_return_limit, min_send_sat):
    """Whether ANY whole rate in [floor, ceiling] carries a forward of
    these outputs (forwards_at). THE FLOOR DECIDES IT, and why is the
    whole of this function.

    It used to ask the floor and then every output's dust_from inside the
    band: a higher rate could pass where the floor failed, because at the
    floor a hundred outputs worth a little over twice their input cost
    were all spent and their fee took more than a fifth, while a rate or
    two higher they were dust, left behind, and the payment beside them
    forwarded alone. The same set was refused at the floor itself, and
    the forward waited for fees to rise (`delayed`). spendable now CUTS
    such outputs at any rate, and with the cut no rate above the floor can
    pass where the floor does not:

      - what select_inputs keeps at a higher rate is what it keeps at the
        floor less the SMALLEST non-`must` outputs (an output is dust from
        dust_from(value) up, and dust_from only grows with value), and the
        `must` inputs are kept at every rate -- so any largest-first
        prefix spendable could spend there is one it can spend at the
        floor, the standard cap (a count, not a rate) the same;
      - on the same inputs the floor's fee is no higher, so every guard
        that prefix passes there it passes at the floor: the fifth, the
        minimum after the fee, the standard weight;
      - and spendable at the floor finds a passing prefix whenever one
        exists (the longest; see there).

    So forwards_at(floor) is exact for the band, one ask, bounded by the
    outputs on the address and not by how many distinct values someone
    parked there (each was a rate to ask). A band with no rates in it
    (floor over ceiling -- main() refuses that before anything runs) carries
    nothing."""
    if floor > ceiling:
        return False
    return forwards_at(utxos, min_conf, floor, exclude, op_return_limit,
                       min_send_sat)


def fee_word(utxos, min_conf, floor, ceiling, exclude, op_return_limit,
             min_send_sat, replacing=False):
    """The status word a fee-shaped refusal (DELAY_KINDS) leaves for the Pi.

    `delayed`: some rate this pair allows carries a forward of what has
    settled -- not always a cheaper one (forwards_in_band) -- and the Pi
    tries again by itself. `seen`: nothing settled can, but it could once
    what is still confirming has settled -- money a block or two from
    spendable is on its way, not short, and the Pi asks again (`arriving`).
    `short`: at no rate this pair allows, even with every output on the
    address settled, is there a forward; no waiting changes that, and the
    Pi stops until MORE money settles. Decided over the money a forward
    would spend at each rate -- never the look's settled_sat, which counts
    the outpoints `exclude` names and outputs that are dust.

    A REPLACEMENT (`replacing`) is always `delayed`: the forward it would
    replace stands in the mempool, so there is nothing to be short of --
    the floor was raised to what a node holding the original will take in
    its place, and a refusal there means only "not at today's price", the
    word bump_over_ceiling already says."""
    if replacing:
        return STATUS_DELAYED
    band = (floor, ceiling, exclude, op_return_limit, min_send_sat)
    if forwards_in_band(utxos, min_conf, *band):
        return STATUS_DELAYED
    whole = [dict(u, confirmations=max(int(u["confirmations"]),
                                       int(min_conf), 1)) for u in utxos]
    if forwards_in_band(whole, min_conf, *band):
        return watch.STATE_SEEN
    return STATUS_SHORT


def quote_payload(send_sat, dest_xmr):
    """The SwapKit v3 quote request, pinned to THORCHAIN, for EXACTLY the
    amount that will be sent -- the memo's own limit is derived from it."""
    return {
        "sellAsset": "BTC.BTC",
        "buyAsset": "XMR.XMR",
        "sellAmount": sat_to_btc_text(send_sat),
        "destinationAddress": dest_xmr,
        "providers": ["THORCHAIN"],
        "slippage": int(ARRIVAL_TOLERANCE * 100),
    }


def fetch_quote(send_sat, dest_xmr, proxy_url):
    """(inbound, memo, expected_xmr) from a fresh SwapKit quote on its own
    circuit. Every field is validated by validate_quote; this only fetches."""
    proxies = isolated_proxy(proxy_url, "forward:quote")
    try:
        resp = safe_post(f"{SWAPKIT_API}/v3/quote",
                         quote_payload(send_sat, dest_xmr), proxies)
    except SystemExit:
        # safe_post sys.exits on a 401/403 from a keyed host. That is a
        # BaseException, so the clause below would have let it escape with
        # no kind on the chain and a bare exit 1; named here instead.
        newnym(proxy_url=proxy_url)
        integrity_log("forward", "quote_refused")
        raise Refused("quote_refused",
                      "the aggregator refused the request (an API key may "
                      "be required: GS_SWAPKIT_API_KEY in the agent unit's "
                      "EnvironmentFile)")
    except Exception as e:                                   # noqa: BLE001
        newnym(proxy_url=proxy_url)
        integrity_log("forward", f"quote_fail:{type(e).__name__}")
        raise Refused("quote_failed",
                      f"the quote could not be fetched ({type(e).__name__})")
    routes = resp.get("routes", []) if isinstance(resp, dict) else []
    # A LIST, BEFORE IT IS INDEXED: `routes` is whatever JSON the host that
    # answered chose, and 5, true or {"x": 1} raised TypeError / KeyError
    # here -- a traceback and a bare exit 1 with no kind on the chain.
    if not isinstance(routes, list) or not routes \
            or not isinstance(routes[0], dict):
        raise Refused("no_route", "the aggregator returned no swap route")
    inbound, memo, expected = parse_swap_route(routes[0])
    return inbound, memo, expected


def validate_inbound(inbound, network):
    """The inbound vault address must be a native-segwit address of THIS
    network with a valid checksum. Returns its scriptPubKey."""
    net = btx.network_of(network)
    text = str(inbound or "")
    if not text or not instruction_field_safe(text):
        raise Refused("bad_inbound", "the inbound address is empty or "
                      "carries control characters")
    if not text.lower().startswith(net["bech32"] + "1"):
        raise Refused("inbound_wrong_network",
                      f"the inbound address is not a {net['name']} "
                      "native-segwit address")
    if not bech32_checksum_ok(text):
        raise Refused("bad_inbound", "the inbound address fails its "
                      "checksum")
    try:
        return btx.address_script(text, network)
    except btx.BtcTxError as e:
        raise Refused("bad_inbound", str(e))


def validate_memo(memo, dest_xmr):
    """The quoted memo must be printable and must name OUR destination, on
    its PLAIN form. Returns the memo's text; the size check comes after the
    limit is written in (fit_memo), on the final bytes."""
    text = str(memo or "")
    if not text:
        raise Refused("no_memo", "the quote carried no memo; ThorChain "
                      "routes on it and a payment without it is lost")
    if not instruction_field_safe(text):
        raise Refused("bad_memo", "the memo carries control characters")
    if not memo_binds_destination(text, dest_xmr):
        raise Refused("memo_unbound",
                      "the memo does not name this deposit's own XMR "
                      "destination; the swap would deliver to someone else")
    # THE PLAIN FORM ONLY. memo_binds_destination also accepts a memo that
    # binds once HEX-DECODED (an aggregator convention for a sender's
    # OP_RETURN). This tool lays the OP_RETURN out itself, so embedding the
    # hex TEXT would hand ThorChain a string of hex digits, not a memo, and
    # the deposit would be refunded minus fees or stranded.
    if not _memo_fields_bind(text, dest_xmr):
        raise Refused("memo_hex",
                      "the memo binds only when hex-decoded; this tool "
                      "writes the OP_RETURN itself and will not embed a "
                      "hex string as the memo")
    # ...AND ONLY WHAT THORCHAIN READS AS THIS TOOL READ IT (the stage 2
    # read). The bind check strips each field it reads and takes any asset
    # on the XMR chain; the OP_RETURN carries the memo byte for byte. So a
    # quote whose memo had a space, a no-break space or any other character
    # outside printable ASCII inside a field -- which str.strip() removes
    # here and ThorChain does not -- or named an asset such as XMR.BOGUS,
    # was signed as it came, and ThorChain refunds what it cannot read, less
    # its fees. The aggregator is not trusted to be exact; nothing secret is
    # involved -- the format is public, and this is what makes it exact.
    if any(not 0x21 <= ord(ch) <= 0x7E for ch in text):
        raise Refused("bad_memo",
                      "the memo carries a space or a character outside "
                      "printable ASCII; ThorChain reads each field as "
                      "written, and this tool writes the memo byte for byte")
    if text.split(":")[1].upper() not in ("XMR", "XMR.XMR"):
        raise Refused("bad_memo",
                      "the memo's asset is not XMR.XMR; ThorChain would "
                      "refund a swap to an asset it does not have, less fees")
    return text


#: BOUNDED, both halves. The limit is in 1e8 base units, so no real one needs
#: more than twenty digits or a two-digit exponent -- and an unbounded one was
#: a CPU bomb in 119 bytes: int(Decimal("1e2000000")) takes time quadratic in
#: the exponent (56 s driven), and whoever answers as the aggregator chooses
#: it. The forward was refused in the end, after the job's whole budget.
_LIMIT_RE = re.compile(r"^[0-9]{1,20}(?:[eE][0-9]{1,2})?\Z")
_BPS_RE = re.compile(r"^[0-9]{1,4}\Z")


def enforce_memo_terms(memo_text, expected_xmr, worst_xmr, max_affiliate_bps):
    """The memo's LIMIT and AFFILIATE FEE, the two fields the chain reads
    that the aggregator's expectedBuyAmount says nothing about.

        =:XMR.XMR:<dest>:<limit>/<interval>/<qty>:<affiliate>:<bps>

    THE LIMIT IS SET HERE, NOT TRUSTED. It is the only on-chain slippage
    protection a swap has: the minimum output, in 1e8 base units, under
    which ThorChain refunds instead of executing. Aggregators routinely
    quote it as 0 (THORChain's own example memo is ":0/1/0"), and a zero or
    empty limit executes at ANY price. This tool lays the OP_RETURN out
    itself, so it writes its own floor into the memo -- the expected output
    less a margin drawn per forward (LIMIT_MARGIN_BPS, never over the
    arrival tolerance the watcher gates on) -- whenever the quote's limit
    is absent, zero, or lower. A higher limit the aggregator chose is kept
    as written (stricter is fine) UNLESS it is above the quote's own
    expected output: that swap can only refund, minus the outbound fee, so
    it is refused. A limit field that is not a number is refused too: a
    memo this tool cannot read is not one it should rewrite. `worst_xmr`
    is the watcher's floor, kept in the call so the two gates are read
    side by side; the margin's ceiling is what keeps the limit above it.
    Only the limit is ever touched -- the streaming interval/quantity and
    every other field stay byte for byte -- so the destination binding
    checked before still holds; it is checked AGAIN on the result anyway.
    The affiliate fee, in basis points to a THORName, is a skim of up to
    10%; it is capped by policy, default 0.

    ...WITH ONE EXCEPTION: AFFILIATE FIELDS THAT CARRY NO FEE ARE DROPPED.
    An aggregator decorates its memo ("::0", or its own THORName at 0
    basis points). On the chain a 0-bps affiliate pays nobody and changes
    nothing about the swap; in an OP_RETURN it is bytes, and bytes are what
    the relay policy counts -- so up to thirty characters of somebody's
    name decided whether a forward fit the policy at all (memo_overflow,
    for every quote that carried it, for ever). Dropped when the fee is
    zero and nothing follows the fee field; kept byte for byte when a fee
    the operator allows rides on it, or when fields this tool does not read
    (an aggregator's EVM addresses) follow. The memo's length is then
    bounded by gs_common.SWAP_MEMO_MAX_BYTES plus the streaming fields.
    Returns (memo_text_out, limit_base_units, affiliate_bps, limit_set)."""
    parts = str(memo_text).strip().split(":")
    while len(parts) < 4:
        parts.append("")
    lim_field = parts[3].strip()
    sub = lim_field.split("/")
    lim_text = sub[0].strip()
    if lim_text and not _LIMIT_RE.match(lim_text):
        raise Refused("memo_bad_limit",
                      "the memo's output limit field is not a number; "
                      "refusing to rewrite a memo this tool cannot read")
    # Bounded by _LIMIT_RE, so this converts at once (at most ~1e119).
    quoted = int(Decimal(lim_text)) if lim_text else 0
    # THE FLOOR: the expected output less the margin drawn for this
    # forward, clamped to 0..LIMIT_MARGIN_MAX_BPS (the arrival tolerance,
    # so the limit never sits under what the watcher accepts and a swap
    # that executes is never `short` by the memo's own doing).
    margin = min(max(int(LIMIT_MARGIN_BPS()), 0), int(LIMIT_MARGIN_MAX_BPS))
    floor = int(expected_xmr * Decimal(10 ** 8) * (10000 - margin) / 10000)
    if floor < 1 or worst_xmr <= 0:
        raise Refused("memo_bad_limit",
                      "the worst-case arrival rounds to nothing in base "
                      "units; no floor can be written")
    # ...LESS A LITTLE (LIMIT_JITTER), so the limit written is not the
    # margin times anything either: at most LIMIT_JITTER_MAX base units
    # and 1% of the floor -- AND NEVER UNDER THE WORST ARRIVAL. With the
    # margin drawn at the tolerance the floor already sits at the worst
    # arrival, and the jitter took it up to 5,000 units below: a swap
    # executed in that band, and the watcher read it as `short` by the
    # memo's own doing, which the margin's ceiling was there to prevent.
    # The line is the watcher's own -- expected * (1 - tolerance), exact
    # (receive_watch calls a payment complete once the arrival clears it)
    # -- not the quantized worst, which rounds to a millionth either way:
    # under the line, and at a tiny quote OVER the expected output itself,
    # a limit no swap can meet. Never above the expected output; and the
    # draw is clamped to its cap, for a jitter that ignores its argument.
    worst_units = min(
        int((expected_xmr * (1 - ARRIVAL_TOLERANCE) * Decimal(10 ** 8))
            .to_integral_value(rounding=ROUND_CEILING)),
        int(expected_xmr * Decimal(10 ** 8)))
    floor = max(floor, worst_units)
    _jcap = max(0, min(LIMIT_JITTER_MAX, floor // 100, floor - worst_units))
    floor = max(1, floor - min(max(0, int(LIMIT_JITTER(_jcap))), _jcap))
    ceiling = int(expected_xmr * Decimal(10 ** 8))
    if quoted > ceiling:
        raise Refused("memo_bad_limit",
                      "the quote's own output limit is above its expected "
                      "output; that swap can only refund, minus fees")
    limit_set = quoted < floor
    limit = floor if limit_set else quoted
    if limit_set:
        sub[0] = str(limit)
        parts[3] = "/".join(sub)
    bps = 0
    fee_field = parts[5].strip() if len(parts) > 5 else ""
    if fee_field:
        if not _BPS_RE.match(fee_field):
            raise Refused("memo_affiliate_fee",
                          "the memo's affiliate fee field is not a basis-"
                          "point count")
        bps = int(fee_field)
    if bps > max_affiliate_bps:
        raise Refused("memo_affiliate_fee",
                      f"the memo carries an affiliate fee of {bps} basis "
                      f"points, over the {max_affiliate_bps} this box allows")
    if bps == 0 and not any(p.strip() for p in parts[6:]):
        parts = parts[:4]
    out = ":".join(parts)
    return out, limit, bps, limit_set


def fit_memo(memo_text, dest_xmr, op_return_limit):
    """The FINAL memo -- after the limit was written into it -- must still
    name our destination and must fit the operator's OP_RETURN policy.
    Returns its bytes."""
    if not _memo_fields_bind(memo_text, dest_xmr):
        raise Refused("memo_unbound", "the memo no longer names this "
                      "deposit's destination after its limit was set")
    if memo_will_overflow(memo_text, op_return_limit):
        raise Refused("memo_overflow",
                      f"the memo is {memo_bytes(memo_text)} bytes and this "
                      f"box's OP_RETURN policy is {op_return_limit}; a Monero "
                      "address alone is 95 characters, so no swap memo fits "
                      f"the standard {OP_RETURN_STD_BYTES}. Raise "
                      "--op-return-max-bytes ONLY for a node that will relay "
                      "it (see STAGE2_PLAN.md section 2)")
    return memo_text.encode("utf-8")


def validate_expected(expected, send_sat, min_out_xmr, max_slippage,
                      oracle_rate, pool_rate=None):
    """The quote's Monero: positive, clears the mix floor at the WORST
    arrival the watcher accepts, and sits within `max_slippage` of EVERY
    price reference there is -- the oracle and ThorChain's own pools
    (thornode_pool_rate) -- each when available. Returns
    (expected, worst_case). Whether a run may go on with neither is main's
    call, made before the quote is asked for."""
    exp = finite_decimal(expected)
    if exp is None or exp <= 0:
        raise Refused("expected_unreadable",
                      "the quote's expected Monero is missing or not a "
                      "positive number (a route field name may have changed)")
    # MORE MONERO THAN EXISTS IS NOT A PRICE. Rests on no secret: it stops
    # an aggregator's absurd figure before the arithmetic below -- 1e23
    # overflowed the 28-digit quantize into an uncaught InvalidOperation,
    # a traceback with no kind on the chain -- and before a limit is
    # written from it that no swap could meet (a certain refund).
    if exp > XMR_QUOTE_MAX:
        raise Refused("expected_unreadable",
                      "the quote's expected Monero is more than exists; no "
                      "real route answers that")
    with localcontext() as _ctx:
        _ctx.prec = 80            # finite_decimal bounds the exponent to 30
        worst = (exp * (1 - ARRIVAL_TOLERANCE)).quantize(Decimal("0.000001"))
        needed = None
        if min_out_xmr is not None:
            needed = (min_out_xmr / (1 - ARRIVAL_TOLERANCE)).quantize(
                Decimal("0.000001"))
    if min_out_xmr is not None and worst < min_out_xmr:
        raise Refused("below_mix_minimum",
                      f"this swap would deliver about {exp} XMR and after "
                      f"the {int(ARRIVAL_TOLERANCE * 100)}% slippage the "
                      f"watcher accepts as little as {worst} XMR could land, "
                      f"under the {min_out_xmr} XMR mix floor; a quote of at "
                      f"least {needed} XMR is needed")
    if oracle_rate is None:
        integrity_log("forward", "oracle_unavailable")
        print("  [!] no price oracle reachable: the quote is NOT cross-checked "
              "against it")
    for _rate, _name in ((oracle_rate, "price oracle"),
                         (pool_rate, "ThorChain pool price")):
        if _rate is None:
            continue
        dev = quote_deviation(exp, Decimal(send_sat) / Decimal(10 ** 8),
                              _rate)
        if dev is None:
            integrity_log("forward", "oracle_unusable"
                          if _name == "price oracle" else "pool_unusable")
            print(f"  [!] the {_name} could not be compared to the quote")
        elif dev > max_slippage:
            # THE STOP AS PAIRED, not rounded (the review of the stop
            # becoming pairable): 150 bps read "over the 2%" about 1.8%.
            _stop = format((Decimal(str(max_slippage)) * 100).normalize(),
                           "f")
            raise Refused("quote_deviates",
                          f"the quote sits {dev * 100:.1f}% from the "
                          f"{_name}, over the {_stop}% this box accepts")
        elif dev > Decimal("0.05"):
            print(f"  [!] the quote sits {dev * 100:.1f}% from the {_name}")
    return exp, worst


#: THE SWAP'S OWN PRICE: ThorChain's pools, as the THORNode the operator
#: named reports them. The pools are what a swap executes against, so this
#: is the reference a quote's slippage is honestly measured from.
_THOR_POOLS = ("BTC.BTC", "XMR.XMR")


def thornode_pool_rate(thornode_url, proxy_url):
    """BTC per XMR from ThorChain's own BTC.BTC and XMR.XMR pools, on their
    own circuit to the THORNode the operator named, or None when either
    answer cannot be read (said on the chain). Refuses, `pool_unavailable`,
    when a pool reports a status other than Available: ThorChain does not
    swap through such a pool, and a payment now would come back less fees.

    THE STAGE 2 READ: with CoinGecko out of reach -- common over Tor -- the
    aggregator's own figure was the only price a SENDING forward had. It
    set the memo's output limit, the one on-chain slippage protection, and
    nothing measured it, so whoever answers as the aggregator chose how
    little the swap may deliver. This is the second reference, and it rests
    on the THORNode being who it says (https and the CA system, or an
    .onion's key -- watch.thornode_url_ok) and on ThorChain's own state:
    nothing secret. A lying THORNode can move it; so can one already trusted
    for the inbound address a forward pays."""
    proxies = isolated_proxy(proxy_url, "forward:pools")
    base = thornode_url.rstrip("/")
    per_rune = {}
    for asset in _THOR_POOLS:
        try:
            pool = safe_get(f"{base}/thorchain/pool/{asset}", proxies)
        except Exception as e:                               # noqa: BLE001
            integrity_log("forward", f"pool_fetch_fail:{type(e).__name__}")
            return None
        if not isinstance(pool, dict) \
                or str(pool.get("asset") or "").upper() != asset:
            integrity_log("forward", "pool_unusable")
            return None
        if str(pool.get("status") or "").lower() != "available":
            raise Refused("pool_unavailable",
                          f"ThorChain's {asset} pool is not available for "
                          "swaps; a payment now would come back less fees")
        bal_asset = finite_decimal(pool.get("balance_asset"))
        bal_rune = finite_decimal(pool.get("balance_rune"))
        if bal_asset is None or bal_rune is None or bal_asset <= 0 \
                or bal_rune <= 0:
            integrity_log("forward", "pool_unusable")
            return None
        per_rune[asset] = bal_rune / bal_asset
    return per_rune["XMR.XMR"] / per_rune["BTC.BTC"]


def thornode_btc_height(thornode_url, proxy_url):
    """ThorChain's last observed BTC block height, on its own circuit to the
    THORNode the operator named, or None when it cannot be read.

    THE STAGE 2 READ: the tip a forward writes into nLockTime came from ONE
    server's answer to the look, bounded only under the height nLockTime
    reads as a date. A server that named 499,999,999 made a transaction no
    node accepts until that block, every send was rejected as non-final,
    and the same server leads every retry of that address (the rotation is
    the address's own). The locktime is the lower of the two heights now:
    a THORNode a block or two behind costs a locktime a block or two lower,
    which every node takes. Rests on the THORNode being who it says (https
    or an .onion, watch.thornode_url_ok), not on anything secret."""
    proxies = isolated_proxy(proxy_url, "forward:lastblock")
    try:
        blocks = safe_get(f"{thornode_url.rstrip('/')}/thorchain/lastblock",
                          proxies)
    except Exception as e:                                   # noqa: BLE001
        integrity_log("forward", f"lastblock_fetch_fail:{type(e).__name__}")
        return None
    if not isinstance(blocks, list):
        return None
    btc = [b for b in blocks if isinstance(b, dict)
           and b.get("chain") == _THOR_BTC_CHAIN]
    if len(btc) != 1:
        return None
    h = btc[0].get("last_observed_in")
    # No upper bound: a height past the look's tip never lowers min() (the
    # sweep's mutant of one survived for that reason). A height of 0 or
    # less would -- to nLockTime 0 -- and is no height.
    if isinstance(h, bool) or not isinstance(h, int) or h <= 0:
        return None
    return h


#: HOW FAR OVER THORCHAIN'S OWN BTC GAS RATE a server's fee estimate may
#: go before it is taken as a lie and ThorChain's figure (times this) is paid
#: instead. ThorChain's rate already runs above the network's (it pays its
#: own outbounds generously), so twice it is a busy day, not a quiet one.
#: Public, like every bound here: it limits what one server's word can cost.
GAS_RATE_CAP_X = 2


class _InboundUnread(Exception):
    """THORNode's inbound list could not be read. A fact, not yet a
    refusal: Refused logs and prints the moment it is built, and the fee
    step reads the list before the run knows whether it will pay at all."""


def _fetch_inbound(thornode_url, proxy_url):
    """THORNode's inbound_addresses, on its own circuit: a list, or
    _InboundUnread carrying the refusal's words."""
    proxies = isolated_proxy(proxy_url, "forward:inbound")
    try:
        entries = safe_get(f"{thornode_url.rstrip('/')}/thorchain/"
                           "inbound_addresses", proxies)
    except Exception as e:                                   # noqa: BLE001
        integrity_log("forward", f"inbound_fetch_fail:{type(e).__name__}")
        raise _InboundUnread(f"THORNode's inbound list could not be fetched "
                             f"({type(e).__name__}); refusing to pay an "
                             "address only the aggregator vouched for")
    if not isinstance(entries, list):
        raise _InboundUnread("THORNode's inbound list is not a list")
    return entries


def fetch_inbound_entries(thornode_url, proxy_url):
    """THORNode's inbound_addresses: a list, or a refusal
    (inbound_unverified)."""
    try:
        return _fetch_inbound(thornode_url, proxy_url)
    except _InboundUnread as e:
        raise Refused("inbound_unverified", str(e))


def thorchain_fee_cap(entries, floor, ceiling):
    """The highest fee rate (sat/vB) a server's estimate is taken at, from
    ThorChain's own BTC gas rate in `entries`: GAS_RATE_CAP_X times it,
    never under the operator's floor -- and never over the operator's
    ceiling while ThorChain's own rate is within it (the review of this
    fix: twice a rate of 150 is over a ceiling of 200, and a server naming
    5000 then had the forward `delayed` for as long as it led, with
    ThorChain itself saying the network is inside the band). Over the
    ceiling only when ThorChain's own rate is: then the network is there,
    and fee_band refuses it as it should. None when the entry carries no
    usable rate (the estimate then stands as it always did).

    THE STAGE 2 READ: the fee estimate is ONE server's answer to the look,
    bounded only by the operator's ceiling. A server that named just under
    it had every forward pay that rate -- up to a fifth of the deposit
    (MAX_FEE_FRACTION) burned to miners -- and one that named just over it
    had every forward `delayed`, for as long as it led the rotation. With a
    THORNode named, its figure bounds that word. Rests on the THORNode being
    who it says (https or an .onion), not on anything secret."""
    if not isinstance(entries, list):
        return None
    btc = [e for e in entries if isinstance(e, dict)
           and e.get("chain") == _THOR_BTC_CHAIN]
    if len(btc) != 1:
        return None
    units = btc[0].get("gas_rate_units")
    if units not in (None, "satsperbyte"):
        return None
    rate = finite_decimal(btc[0].get("gas_rate"))
    if rate is None or rate <= 0 or rate > 100000:
        return None
    cap = int((rate * GAS_RATE_CAP_X).to_integral_value(
        rounding=ROUND_CEILING))
    if rate <= int(ceiling):
        cap = min(cap, int(ceiling))
    return max(int(floor), cap)


def _thor_entries_once(args):
    """THORNode's inbound list for this run: fetched at most ONCE, when first
    wanted, and None when the run names no THORNode or it could not be read.
    NOT a refusal here (the review of the fee cap): fetched before the fee
    step and fatal, a THORNode outage turned the fee step's own word --
    `short`, `seen`, `delayed` -- into a wordless inbound_unverified, and
    the Pi into stall retries. The failure is kept, and is the cross-check's
    refusal (_thor_entries_or_refuse) when the run gets that far: the SAME
    read, so a node that failed the fee step and answered a second ask
    never has the fee decided unbounded and the inbound vouched for."""
    if not args.thornode:
        return None
    if "_thor_entries" not in vars(args):
        try:
            args._thor_entries = _fetch_inbound(args.thornode,
                                                args.tor_proxy)
        except _InboundUnread as e:
            args._thor_entries = e
    got = args._thor_entries
    return got if isinstance(got, list) else None


def _thor_entries_or_refuse(args):
    """This run's one THORNode read for the cross-check, or its refusal."""
    got = _thor_entries_once(args)
    if got is None:
        raise Refused("inbound_unverified", str(args._thor_entries))
    return got


def todays_rate(args, picture):
    """THE fee rate this run acts on, decided ONCE for both readers: the
    reconciliation's bump decision and main's fee step (the review of the
    fee cap: the bump read the server's raw estimate and the fee step paid
    the cap, so a forward stuck at the cap was bumped one sat/vB a window,
    for ever -- one state decided twice). The operator's --feerate-sat-vb
    when given; else the server's estimate, bounded by ThorChain's own
    (thorchain_fee_cap) when the run names a THORNode that answers. Said
    once a run when it bounds it."""
    if args.feerate_sat_vb:
        return args.feerate_sat_vb
    est = picture.get("fee_sat_vb")
    cap = thorchain_fee_cap(_thor_entries_once(args), args.feerate_floor,
                            args.feerate_ceiling)
    if cap is not None and isinstance(est, int) \
            and not isinstance(est, bool) and est > cap:
        if not vars(args).get("_fee_bound_said"):
            args._fee_bound_said = True
            integrity_log("forward", "fee_estimate_over_thorchain")
            print(f"  [!] the server's fee estimate ({est} sat/vB) is not "
                  f"credible beside ThorChain's own; today's rate is taken "
                  f"as {cap}")
        return cap
    return est


def cross_check_inbound(inbound, thornode_url, proxy_url, entries=None):
    """THORNode's own inbound_addresses, on a second circuit: the BTC
    entry must exist, must not be halted, and must name the SAME address
    the aggregator gave us. Returns (dust threshold, outbound fee), each
    in sat or None when the entry did not carry a usable one. THE
    OUTBOUND FEE IS WHAT A REFUND LACKS: ThorChain refunds the unfilled
    part of a streaming swap less this fee, and the pairs rewrite on the
    vault scales the forward's quote by what was actually swapped -- the
    refund PLUS the fee -- or a small forward reads `short` for ever (the
    fee is a tenth of a 0.003 BTC forward; the arrival tolerance is a
    tenth). Recorded on the plan from the node the operator named, at the
    moment that node is trusted for the inbound address itself; capped at
    REFUND_FEE_SLACK_SAT, so a lying node can lower what a client is told
    to expect by no more than the slack a FULL refund already rests on.
    `entries`, when given, is the list this run already fetched
    (fetch_inbound_entries); else it is fetched here."""
    if entries is None:
        entries = fetch_inbound_entries(thornode_url, proxy_url)
    btc = [e for e in entries if isinstance(e, dict)
           and e.get("chain") == _THOR_BTC_CHAIN]
    if len(btc) != 1:
        raise Refused("inbound_unverified", "THORNode lists no single BTC "
                      "inbound")
    entry = btc[0]
    if any(entry.get(k) for k in ("halted", "chain_trading_paused",
                                   "global_trading_paused",
                                   "chain_lp_actions_paused")):
        raise Refused("chain_halted", "ThorChain reports BTC trading halted "
                      "or paused; a payment now would sit unswapped")
    if str(entry.get("address") or "").lower() != str(inbound).lower():
        raise Refused("inbound_mismatch",
                      "the aggregator's inbound address is NOT the one "
                      "THORNode publishes; refusing to pay it")
    dust = finite_decimal(entry.get("dust_threshold"))
    fee = finite_decimal(entry.get("outbound_fee"))
    return (int(dust) if dust is not None and dust > 0 else None,
            min(int(fee), int(REFUND_FEE_SLACK_SAT))
            if fee is not None and fee >= 0 else None)


#: A refund is the inbound less ThorChain's outbound fee. It is FULL -- the
#: whole swap undone, so the forward drops out of what the XMR side
#: expects -- only when it carries at least what was sent less this slack
#: (the larger of a twentieth of the amount and REFUND_FEE_SLACK_SAT), and
#: at least half of what was sent (a small forward is under the slack). A
#: streaming swap that filled part of the way refunds only the rest, and
#: that must NOT read as "the swap never happened": the XMR side would
#: then call the payment complete when only part had landed. A refund
#: under the slack is recorded, verified or not, and lowers nothing --
#: the safe direction (the watcher waits for more than will come, which
#: it says as "short", rather than for less). THE RULE LIVES IN gs_btc_tx
#: (refund_is_full): the vault applies it too, to what came back of one
#: forward across several outputs, and two copies of one rule drift.
REFUND_FEE_SLACK_SAT = btx.REFUND_FEE_SLACK_SAT


def classify_returns(paid, plans):
    """Which outputs paying the address are ThorChain REFUNDS of a forward
    of ours, which of those are VERIFIED, and which are FULL (third
    self-doubt pass).

    A refund and a second payment look alike to the look -- money on the
    address that no forward of ours consumed -- and were handled alike.
    They differ in what the record should say: a refunded forward's swap
    never happened, and expecting its output kept the XMR side on
    "partial" for ever about a deposit whose re-forward had fully landed.

    A refund is a CONFIRMED output (a mempool one decides nothing until it
    is in a block: it can be replaced or dropped, and a record that only
    ever upgrades must not be written from it) whose transaction's memo is
    REFUND:<txid> naming a forward in `plans`, carrying LESS than that
    forward sent. It is VERIFIED when any of its inputs was paid from a
    vault a forward of ours PAID -- the `inbound` of any plan in the
    chain, each cross-checked against THORNode when that forward was
    built. No live lookup: a single source asked at reconcile time would
    be one party's word (a lying THORNode could name an attacker's
    address, and an attacker's dust with a REFUND memo would then verify
    -- and lower what the client is told to expect); a refund from a
    vault no forward of ours paid stays a claim, the safe direction. It is
    FULL when it carries at least what was sent less REFUND_FEE_SLACK_SAT
    (see there). Kerckhoffs: the memo is a public convention anyone can put
    in a transaction of their own to the address, and the amount can be
    matched; only the source cannot be forged, since only ThorChain's
    signers spend from ThorChain's vault. Nothing that lowers what a
    client is told to expect may rest on a claim; a claim is recorded as
    one and changes nothing. Everything else on the address is a payment.
    Pure.

    THE OUTBOUND FEE RIDES ON THE RECORD (self-doubt over the partial-
    refund fix): what ThorChain kept of a partly filled swap is the
    refund PLUS the outbound fee it took from the unfilled part, and the
    plan carries that fee from THORNode's inbound entry when the forward
    was built (`outbound_fee_sat`, or None). FULL is judged on the two
    together, and the vault's pairs rewrite scales the quote by the two
    together; a plan from before the field, or a run without --thornode,
    carries None and the vault scales by the refund alone (a touch high,
    the direction that reads `short`, never `complete`).

    Returns [{txid, vout, value, of, verified, full, outbound_fee_sat}],
    one per refund."""
    by_txid = {str(p.get("txid") or "").lower(): p for p in plans or ()
               if isinstance(p, dict) and p.get("txid")}
    vaults = {str(p.get("inbound") or "").strip().lower()
              for p in plans or () if isinstance(p, dict)} - {""}
    out = []
    for f in paid or ():
        if not isinstance(f, dict):
            continue
        memo = f.get("memo")
        if not isinstance(memo, str) \
                or not memo.upper().startswith(bcast.REFUND_MEMO_PREFIX):
            continue
        # The id, and nothing a later convention might append after it.
        of = re.split(r"[^0-9a-fA-F]",
                      memo[len(bcast.REFUND_MEMO_PREFIX):].strip())[0].lower()
        p = by_txid.get(of)
        if p is None:
            continue
        try:
            value = int(f.get("value") or 0)
            sent = int(p.get("send_sat") or 0)
            vout = int(f.get("vout") or 0)
            height = int(f.get("height") or 0)
        except (TypeError, ValueError):
            continue
        if sent <= 0 or value >= sent or height < 1:
            continue
        srcs = f.get("from_addresses")
        if not isinstance(srcs, list):
            srcs = [f.get("from_address")]
        srcs = {str(s or "").strip().lower() for s in srcs} - {""}
        ok = bool(srcs & vaults)
        _fee = p.get("outbound_fee_sat")
        if isinstance(_fee, bool) or not isinstance(_fee, int) or _fee < 0:
            _fee = None
        # FULL: the refund and the fee it lacks together within the slack
        # of what was sent, AND at least half of it (btx.refund_is_full).
        out.append({"txid": str(f.get("txid") or "").lower(), "vout": vout,
                    "value": value, "of": of, "verified": bool(ok),
                    "full": bool(btx.refund_is_full(value + (_fee or 0),
                                                    sent)),
                    "outbound_fee_sat": _fee})
    return out


def take_seed():
    """The mnemonic from the environment, and nothing from anywhere else.
    Removed from this process's environment once read so it is not
    inherited by anything this tool might start (it starts nothing; the
    removal is a habit worth keeping)."""
    if SEED_ENV not in os.environ:
        raise Refused("seed_missing",
                      f"{SEED_ENV} is not in the environment; the seed is "
                      "never taken from argv or a file")
    words = os.environ.pop(SEED_ENV)
    passphrase = os.environ.pop(SEED_PASSPHRASE_ENV, "")
    if not words.strip():
        raise Refused("seed_missing", f"{SEED_ENV} is empty")
    return words, passphrase


def account_for(words, passphrase, network, account_xpub, account_no=0):
    """The private account key m/84'/coin'/<account_no>', proven to be the
    xpub the Pi watches. A wrong account number derives a key the xpub
    does not match and is refused; it can never sign for the address."""
    try:
        account = btx.account_from_mnemonic(words, network, passphrase,
                                            account=account_no)
    except btx.BtcTxError as e:
        raise Refused("seed_invalid", str(e))
    if not btx.account_matches_xpub(account, account_xpub):
        raise Refused("seed_xpub_mismatch",
                      "the seed does not derive the account xpub this "
                      "deposit was watched under; a wrong seed would sign "
                      "for addresses nobody paid")
    return account


def build_and_sign(chosen, tip, inbound_spk, send_sat, fee_sat, memo_b,
                   account, index, address, network, sign):
    """The transaction over the CHOSEN inputs, unsigned when `sign` is
    False. Returns (tx, txid, vsize, real_rate, signed). Refuses unless the
    built transaction's fee is EXACTLY the fee that was sized: inputs minus
    outputs is what the miner keeps, and a stray input would make it more
    than anyone decided."""
    inputs = [{"tx_hash": u["tx_hash"], "vout": u["vout"],
               "value": u["value"]} for u in chosen]
    values = [u["value"] for u in chosen]
    tx = btx.build_unsigned(
        inputs, [(send_sat, inbound_spk), (0, btx.op_return_script(memo_b))],
        locktime=int(tip))
    if btx.fee_of(tx, values) != fee_sat:
        raise Refused("fee_mismatch",
                      "the built transaction's fee is not the fee that was "
                      "sized; refusing to let an input go to the miner")
    if not sign:
        return tx, btx.txid_hex(tx), None, None, False
    try:
        btx.require_native()
    except btx.BtcTxError as e:
        raise Refused("backend_refused", str(e))
    key = btx.key_for(account, 0, index)
    pub = key.get_public_key()
    derived = btx.p2wpkh_script(pub).address(btx.network_of(network))
    if derived != address:
        raise Refused("key_address_mismatch",
                      "the key at this index does not derive the address "
                      "being spent; refusing to sign for money that is not "
                      "at this key")
    try:
        btx.sign_p2wpkh(tx, values, [key] * len(values))
    except btx.BtcTxError as e:
        raise Refused("sign_failed", str(e))
    if not btx.verify_signed(tx, values, [pub] * len(values)):
        raise Refused("sign_failed", "a signature did not verify on "
                      "re-derivation")
    vsize = btx.measure(tx)[0]
    fee = btx.fee_of(tx, values)
    return tx, btx.txid_hex(tx), vsize, fee // vsize, True


def write_plan(path, plan):
    """The plan file, 0600, atomically; nothing else writes here."""
    atomic_write_json(plan, Path(path))


def status_path(outfile):
    """Where the one-word status of a forward that did not send goes:
    beside the plan, under the same wipe pattern."""
    return Path(outfile).with_suffix(".status.json")


#: The forward did not send, and one word says why, for the phone: money
#: not yet there / not yet deep enough (stage 4), or -- stage 5 -- a fee
#: the forward would not pay TODAY (`delayed`: the Pi tries again by
#: itself), or money that can never be sent on at any rate this pair allows
#: (`short`: under what was quoted). Nothing else is ever in the file.
STATUS_DELAYED = "delayed"
STATUS_SHORT = "short"
#: Money came BACK to the address after the forward (a refund, a second
#: payment) and is not yet settled; it is sent on when it is (--reconcile).
STATUS_RETURNED = "returned"
#: Money came back after the forward and NO rate this pair allows can carry
#: it on, settled or not (--reconcile's `short`). Its own word, because the
#: agent answers a moved plan from the plan and dropped `short` there -- a
#: sentence about a deposit that has not gone -- so the Pi heard
#: `forwarded` and started the same refused forward every recheck window.
STATUS_LEFTOVER = "leftover"
STATUS_WORDS = (watch.STATE_NOT_SEEN, watch.STATE_SEEN, STATUS_DELAYED,
                STATUS_SHORT, STATUS_RETURNED, STATUS_LEFTOVER)
#: The refusals that are about TODAY'S FEE, not about the deposit. Each
#: becomes a word (fee_word: `delayed`, `seen` while money is still
#: confirming, or `short` when no rate this pair allows could ever carry
#: it) rather than a refusal with no word, which the Pi read as "did not go
#: through" and stopped trying (STAGE5_PLAN.md 3.2).
DELAY_KINDS = ("no_fee_estimate", "bad_fee_estimate", "fee_out_of_band",
               "fee_eats_deposit", "nothing_economic", "below_minimum")


def write_status(outfile, state):
    """{"state": <one of STATUS_WORDS>} and nothing else -- no amount, no
    depth, no address. Read once by the wake agent and removed. An unknown
    word is written as not_seen: the safe word, "ask again"."""
    if state not in STATUS_WORDS:
        state = watch.STATE_NOT_SEEN
    atomic_write_json({"state": state}, status_path(outfile))


#: EVERY TRANSACTION THIS TOOL SENDS, BY TXID, RECORDED BEFORE ITS BYTES
#: LEAVE THE BOX: btc_forward_<h>.signed.json beside the plan, sealed and
#: wiped with it (btc_forward_*.json). Txids, and the QUOTE each was sent
#: under (signed_quote) -- never the transaction: one is read from a file
#: only from a plan (_plan_file).
#:
#: A spend of the deposit address that no plan named was judged ours by its
#: memo, an OP_RETURN naming this deposit's destination. That memo is on
#: the chain in every forward this tool made, for anyone to read, and
#: whoever holds the seed can write it. Kerckhoffs: a thief with a leaked
#: seed who knew this code paid himself with our memo attached, and the
#: alarm this tool exists to raise ("the seed has leaked") became "forward
#: found on chain" -- a reconstructed plan the agent read as `sent`, or a
#: plan marked superseded by the theft and `forwarded` once it mined. A
#: txid cannot be copied: nobody without our exact bytes makes one we
#: recorded. So a spend no plan names is ours only when this record names
#: it, and the record is on disk before the broadcast, so the case the
#: memo rule was for -- sent, then killed before the plan was written --
#: is still found.
SIGNED_SCHEMA = "gs_btc_signed_v1"
#: The newest this many are kept. The record only matters between a send
#: and its plan; every older txid is in the plan chain too.
SIGNED_KEEP = 64
_TXID_RE = re.compile(r"^[0-9a-f]{64}\Z")


def signed_path(outfile):
    """Where the record of sent txids goes: beside the plan, under the
    same wipe and seal patterns."""
    return Path(outfile).with_suffix(".signed.json")


def _read_signed_doc(outfile):
    """(txids oldest first, {txid: quote}) from the record: each txid 64
    lowercase hex, each quote a dict; the file yields nothing else.
    ([], {}) when there is none; raises (OSError, ValueError) for one that
    is there and unreadable."""
    try:
        with open(signed_path(outfile), encoding="utf-8") as fh:
            doc = json.load(fh)
    except FileNotFoundError:
        return [], {}
    if not isinstance(doc, dict) or doc.get("schema") != SIGNED_SCHEMA \
            or not isinstance(doc.get("txids"), list):
        raise ValueError("not a record of this tool's sent transactions")
    txids = [t for t in doc["txids"] if isinstance(t, str) and _TXID_RE.match(t)]
    quotes = doc.get("quotes")
    quotes = ({t: q for t, q in quotes.items()
               if isinstance(t, str) and t in txids and isinstance(q, dict)}
              if isinstance(quotes, dict) else {})
    return txids, quotes


def _read_signed(outfile):
    """The txids in the record, oldest first (_read_signed_doc)."""
    return _read_signed_doc(outfile)[0]


def signed_txids(outfile):
    """The set of txids this tool recorded before sending. An unreadable
    record is empty, which makes a spend it named FOREIGN -- the safe
    side: an alarm to check, not a theft passed as a forward."""
    try:
        return set(_read_signed(outfile))
    except (OSError, ValueError):
        integrity_log("forward", "signed_record_unreadable")
        return set()


def signed_quote(outfile, txid):
    """The quote `txid` was sent under, as record_signed wrote it before
    the bytes left, or None (none recorded, a record from before the field,
    an unreadable one, or a figure that is not one). A plan REBUILT from the
    chain (reconcile_emptied, an adopted spend) carries it, so the vault's
    pairs rewrite counts that swap: with no quote it counted for nothing,
    and the XMR side called a deposit complete when an earlier swap's
    Monero landed while this one's was still coming. Our own record, on
    the vault's disk, sealed with the plans: the same figure the plan
    would have held."""
    try:
        q = _read_signed_doc(outfile)[1].get(str(txid).lower())
    except (OSError, ValueError):
        return None
    if not isinstance(q, dict):
        return None
    exp = finite_decimal(q.get("expected_xmr"))
    worst = finite_decimal(q.get("worst_case_xmr"))
    if exp is None or exp <= 0 or exp > XMR_QUOTE_MAX \
            or worst is None or worst <= 0 or worst > exp:
        return None
    out = {"expected_xmr": str(exp), "worst_case_xmr": str(worst),
           "memo_limit_base_units": None, "outbound_fee_sat": None}
    for _k in ("memo_limit_base_units", "outbound_fee_sat"):
        _v = q.get(_k)
        if isinstance(_v, int) and not isinstance(_v, bool) and _v >= 0:
            out[_k] = _v
    return out


def record_signed(outfile, txid, quote=None):
    """Add `txid` to the record -- with the `quote` it is sent under, when
    given -- synced to disk, BEFORE its bytes are handed to any server.
    Re-recording a txid keeps the quote it had. Fails closed: a record that
    cannot be written is a refusal, and nothing is sent."""
    txid = str(txid).lower()
    if not _TXID_RE.match(txid):
        raise Refused("signed_record_failed",
                      "the transaction has no txid to record; nothing was "
                      "sent")
    try:
        have, quotes = _read_signed_doc(outfile)
    except (OSError, ValueError):
        # What it held is in the plan chain, save a send that died before
        # its plan -- which then reads as foreign: an alarm to check, the
        # safe side. A fresh record, said on the chain.
        integrity_log("forward", "signed_record_reset")
        have, quotes = [], {}
    keep = [t for t in have if t != txid][-(SIGNED_KEEP - 1):] + [txid]
    quotes = {t: q for t, q in quotes.items() if t in keep}
    if isinstance(quote, dict):
        quotes[txid] = dict(quote)
    path = signed_path(outfile)
    try:
        atomic_write_json({"schema": SIGNED_SCHEMA, "txids": keep,
                           "quotes": quotes}, path)
        # ...and the NAME synced too: the rename is what makes the record
        # exist, and a power cut straight after the broadcast is the case
        # it is for.
        _dfd = os.open(str(path.parent), os.O_RDONLY
                       | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(_dfd)
        finally:
            os.close(_dfd)
    except OSError as e:
        raise Refused("signed_record_failed",
                      f"the record of what this tool sends could not be "
                      f"written ({e.strerror or e}); nothing was sent")


#: The data of an OP_RETURN script laid out as this tool lays one out (one
#: push, direct or OP_PUSHDATA1), or None for any other script: ONE reader,
#: gs_btc_tx's, shared with the history reader (gs_btc_broadcast), so the
#: memo this tool writes, the memo it recognises as its own on an emptied
#: address, and the refund memo it reads cannot disagree about what a memo
#: is.
_op_return_data = btx.op_return_data


def _plan_of_spend(spend, tx, memo, network, index, address, dest_xmr,
                   tip, quote=None):
    """A plan REBUILT FROM A FORWARD OF OURS FOUND ON THE CHAIN whose sending
    run did not live to write one (a power cut, the agent's deadman or job
    budget, a kill in the seen wait): txid, inputs and their values, what
    reached the inbound, the fee and the vsize off the transaction itself,
    the memo. Marked `reconstructed`. The QUOTE is the one record_signed
    kept beside the txid before the bytes left (`quote`, signed_quote), so
    the vault's pairs rewrite counts this swap; a record from before that
    field has none, and then the rewrite lets the plan this one superseded
    stand in for it (gs_wake_agent._reconcile_pairs).

    `spend` is a listing from bcast_spends ({txid, height, hex, inputs,
    server}), `tx` its parsed transaction. THE FEE ONLY WHEN EVERY INPUT IS
    NAMED: the history reader lists the inputs whose funding is in its
    window, so a flood that pushed one off left the sum short -- a fee too
    small, or below zero -- and a forward bumped on that rate paid more out
    of the client's deposit than the market asked. With an input unnamed
    the fee is None, and bump_due never bumps a plan that knows no rate.
    Pure."""
    net = btx.network_of(network)
    paid = [o for o in tx.vout if _op_return_data(o.script_pubkey.data)
            is None]
    send_sat = int(paid[0].value) if paid else 0
    try:
        inbound = paid[0].script_pubkey.address(net) if paid else None
    except Exception:                                        # noqa: BLE001
        inbound = None
    ins = [i for i in (spend.get("inputs") or []) if isinstance(i, dict)]
    in_sat = sum(int(i["value"]) for i in ins)
    _named = {(str(i["tx_hash"]).lower(), int(i["vout"])) for i in ins}
    _all = {(v.txid.hex(), int(v.vout)) for v in tx.vin}
    fee_sat = (in_sat - sum(int(o.value) for o in tx.vout)
               if _all and _named == _all else None)
    if fee_sat is not None and fee_sat < 0:
        fee_sat = None
    vsize = btx.measure(tx)[0]
    q = quote if isinstance(quote, dict) else {}
    return {
        "schema": PLAN_SCHEMA,
        "network": network,
        "dry_run": False,
        "broadcast": True,                       # the network shows it
        "broadcast_outcome": bcast.OUTCOME_ACCEPTED,
        "broadcast_server": None,
        "broadcast_codes": [],
        "broadcast_attempts": 0,
        "broadcast_mismatched": 0,
        "seen": True,
        "seen_height": spend["height"],
        "seen_server": spend["server"],
        "seen_asked": True,
        "seen_polls": 0,
        "signed": True,
        "reconstructed": True,                   # from the chain, not a run
        "index": index,
        "address": address,
        "inputs": [{"tx_hash": i["tx_hash"], "vout": i["vout"],
                    "value": i["value"], "confirmations": None}
                   for i in ins],
        "skipped_dust": 0,
        "left_over": 0,
        "unsettled_outputs": 0,
        "tip": tip,
        "inbound": inbound,
        "inbound_cross_checked": False,
        "outbound_fee_sat": q.get("outbound_fee_sat"),
        "memo": memo,
        "memo_quoted": None,
        "memo_limit_set": None,
        "memo_bytes": len(memo.encode("utf-8")),
        "op_return_max_bytes": None,
        "settled_sat": in_sat,
        "send_sat": send_sat,
        "fee_sat": fee_sat,
        "feerate_target_sat_vb": None,
        "vsize_bound": None,
        "vsize": vsize,
        "feerate_real_sat_vb": (fee_sat // vsize if vsize
                                and fee_sat is not None else None),
        # THE QUOTE, when the record kept it (signed_quote); a crash loses
        # everything else of the run.
        "expected_xmr": q.get("expected_xmr"),
        "worst_case_xmr": q.get("worst_case_xmr"),
        "memo_limit_base_units": q.get("memo_limit_base_units"),
        "affiliate_bps": None,
        "dest_xmr": dest_xmr,
        "txid": spend["txid"],
        "tx_hex": None,
        "tx_hex_reason": None,
        "signed_hex_written": False,
        "server": spend["server"],
        "cert_sha256": None,
        "ts": int(time.time()) // 600 * 600,
    }


def reconcile_emptied(address, index, servers, proxy_url, network, timeout,
                      dest_xmr, outfile, tip):
    """The address holds nothing unspent. Was it ever paid, and where did
    the money go? (STAGE5_PLAN.md section 1, case 1; 3.1.)

    A forward that was broadcast and then died -- power cut, deadman, a
    crash -- before its plan was written leaves the outputs spent and no
    record; the look sees nothing unspent and this tool used to answer
    `nothing_settled` → "not yet", for ever, about a swap that went
    through. So the address's history is read (read-only) and its LAST
    spend examined:

      - its txid is one this tool recorded before sending it
        (record_signed) and its memo names THIS deposit's destination: it
        is our forward. The plan is reconstructed from the transaction
        itself (txid, inputs and their values, what reached the inbound,
        the fee, the memo), marked `reconstructed`, and the run reports
        done -- the agent reads `sent` off it and the ledger catches up;
      - anything else emptied the address: a spend this tool did not
        sign. Nothing is signed; the run FAILS with the kind on the chain,
        and the operator reads the job log at the machine. Only a leaked
        seed does this -- or, once, a build without the record that died
        between sending and writing its plan. OUR MEMO IS NOT ENOUGH: it
        is on the chain in every forward this tool made, and whoever holds
        the seed can copy it onto a theft (SIGNED_SCHEMA).
      - no spend at all (never paid): None, and the caller answers as it
        always did. "Could not ask" is likewise None, with a kind.

    Returns EXIT_OK after writing the plan, None when there is nothing to
    say, and raises SystemExit(EXIT_FAILED) for a foreign spend."""
    try:
        spends = bcast_spends(address, servers, proxy_url, network=network,
                              timeout=timeout,
                              on_truncated=_history_truncated)
    except watch.PinMismatch as e:
        raise Refused("pin_mismatch", str(e))
    except watch.BtcWatchError as e:
        integrity_log("forward", "history_unavailable")
        print(f"  [!] the address's history could not be read ({e}); "
              "answering from what is unspent alone")
        return None
    if not spends:
        return None
    last = spends[-1]
    from embit.transaction import Transaction as _Tx
    tx = _Tx.parse(bytes.fromhex(last["hex"]))
    memo = None
    for o in tx.vout:
        data = _op_return_data(o.script_pubkey.data)
        if data is not None:
            try:
                memo = data.decode("utf-8")
            except UnicodeDecodeError:
                memo = None
            break
    memo_ours = bool(memo) and instruction_field_safe(memo) \
        and _memo_fields_bind(memo, dest_xmr)
    sent_here = str(last["txid"]).lower() in signed_txids(outfile)
    if not (sent_here and memo_ours):
        integrity_log("forward", "foreign_spend")
        why = ("it carries this deposit's own memo, but this box never "
               "recorded sending it -- and that memo is on the chain in "
               "every forward of ours, for whoever holds the seed to copy"
               if memo_ours else
               "its memo does not name this deposit's destination")
        print("[!] the deposit address was EMPTIED by a transaction this "
              f"tool did not sign: {why} (txid {last['txid']}). Nothing is "
              "signed. If no operator moved it by hand, the seed has "
              "leaked.")
        raise SystemExit(EXIT_FAILED)
    plan = _plan_of_spend(last, tx, memo, network, index, address,
                          dest_xmr, tip,
                          quote=signed_quote(outfile, last["txid"]))
    inbound, send_sat = plan["inbound"], plan["send_sat"]
    in_sat, fee_sat, vsize = (plan["settled_sat"], plan["fee_sat"],
                              plan["vsize"])
    write_plan(outfile, plan)
    integrity_log("forward", "reconstructed")
    where = ("in the mempool" if last["height"] <= 0
             else f"in a block at height {last['height']}")
    print(f"  forward FOUND ON CHAIN, {where}: this address was emptied by "
          f"a transaction carrying this deposit's own swap memo, and no plan "
          f"had been written for it (the sending run did not live to write "
          f"one). The plan is reconstructed from the chain.")
    print(f"  from {scrub_address(address)} index {index}: {in_sat} sat in "
          f"{len(last['inputs'])} output(s)")
    print(f"  to   {scrub_address(inbound or '?')}: {send_sat} sat, fee "
          + (f"{fee_sat} sat" if fee_sat is not None else
             "unknown (an input's funding is past the history window)")
          + f", {vsize} vB")
    print(f"  memo {len(memo.encode('utf-8'))} bytes")
    print(f"  txid {last['txid']}")
    print(f"  plan written: {outfile}")
    return EXIT_OK


def _plan_chain(outfile):
    """This handle's plan files, newest first: the current one and the
    rotated predecessors `<stem>.<n>.json` a reconciliation left behind
    when it wrote a fresh forward. Only files that exist."""
    p = Path(outfile)
    stem = p.name[:-len(".json")] if p.name.endswith(".json") else p.name
    rotated = []
    for f in p.parent.glob(f"{stem}.*.json"):
        mid = f.name[len(stem) + 1:-len(".json")]
        if mid.isdigit():
            rotated.append((int(mid), f))
    return ([p] if p.exists() else []) + [f for _n, f in
                                         sorted(rotated, reverse=True)]


def _rotate_plan(outfile):
    """Move the current plan aside as `<stem>.<n>.json` before a fresh one
    is written for the same handle; the chain is the record of every
    forward this deposit had. Returns the new name, or None."""
    p = Path(outfile)
    if not p.exists():
        return None
    stem = p.name[:-len(".json")]
    n = 1 + sum(1 for _ in _plan_chain(outfile)[1:])
    target = p.with_name(f"{stem}.{n}.json")
    # NEVER OVER A PLAN THAT EXISTS. The count assumes the rotated names
    # are 1..n with no gap; a gap (a rotated file removed by hand, a
    # recovery that moved one back while a foreign file kept its number)
    # would put this plan over an earlier one and lose a record the pairs
    # rewrite and the reconciliation both read. The next free number is
    # taken instead, and _plan_chain sorts by number, so order holds.
    while target.exists():
        n += 1
        target = p.with_name(f"{stem}.{n}.json")
    os.replace(p, target)
    return target


def _file_rotated(outfile, plan):
    """Write `plan` into the chain as a ROTATED predecessor
    `<stem>.<n>.json`, the next free number, leaving the current plan
    where it is: a forward of ours the chain lacked (reconcile's adopted
    spend), recorded without changing which plan is current. Never over a
    file that exists (as _rotate_plan). Returns the path."""
    p = Path(outfile)
    stem = p.name[:-len(".json")]
    n = 1 + sum(1 for f in _plan_chain(outfile) if Path(f) != p)
    target = p.with_name(f"{stem}.{n}.json")
    while target.exists():
        n += 1
        target = p.with_name(f"{stem}.{n}.json")
    write_plan(target, plan)
    return target


def _read_plan(path):
    plan = _plan_file(path)
    if plan is None:
        raise Refused("no_plan", "the plan file is not one this tool wrote")
    return plan


def _plan_file(path):
    """THE ONE PLACE A PLAN IS READ FROM DISK: the JSON at `path`, or None
    when it is not a plan this tool wrote (the schema). A missing or
    malformed file raises (OSError, ValueError) as it always did. One read
    site, so the tripwire "a transaction is read from a file only from the
    tool's own plan, schema checked" stays a count of one."""
    with open(path, encoding="utf-8") as fh:
        plan = json.load(fh)
    if not isinstance(plan, dict) or plan.get("schema") != PLAN_SCHEMA:
        return None
    return plan


def _recover_plan(outfile):
    """The plan a reconciliation reads when the CURRENT file is gone: the
    newest rotated predecessor that is one of ours, MOVED BACK to be the
    current plan, or None (stage 6, STAGE6_PLAN.md 3.2).

    The chain could be left without a current plan: the fresh forward a
    verdict called for used to rotate the current plan aside FIRST and then
    refuse (a fee over the ceiling, a quote that failed, a memo that would
    not fit), and the next run answered `no_plan` about a forward whose
    whole record sat one file over, for ever. Rotation now happens when the
    fresh plan is written; this repairs a chain already in that state.
    RESTORED, not copied: a reconciliation brings its plan up to date at
    the outfile, and a copy left at `<stem>.<n>.json` would be the same
    forward counted twice by the pairs rewrite. No Refused is constructed
    for a rotated file that is not ours -- that would put a refusal on the
    chain for a file being skipped."""
    for f in _plan_chain(outfile):
        if Path(f) == Path(outfile):
            continue
        try:
            plan = _plan_file(f)
        except (OSError, ValueError):
            continue
        if plan is not None:
            os.replace(f, outfile)
            return plan
    return None


def bump_due(plan, fee_sat_vb, bump_after_s, now=None):
    """Is a forward LISTED IN THE MEMPOOL worth replacing at today's rate
    (stage 6, STAGE6_PLAN.md 3.1)? Yes when it has sat there at least
    `bump_after_s` seconds (from the plan's own send stamp) AND the
    estimate is above the rate it pays. A plan that knows neither the rate
    it pays nor the rate it aimed at is never bumped: nothing here would
    know what to pay more than. Pure; the clock may be injected.

    A PLAN RECONSTRUCTED FROM THE CHAIN KNOWS ITS RATE (the review of
    stages 2-6): it records the fee and the vsize off the transaction
    itself, and has no target only because no run aimed it. It was never
    bumped for want of the target -- a first forward the sending run did
    not live to record then sat at its rate however far fees rose. Its
    stamp is the reconstruction's, later than the send, so the wait is
    only ever longer than asked.

    "THE RATE IT PAYS" IS fee_sat / vsize, when the plan records both, and
    not the rate it was aimed at. The target sits below the real rate every
    time -- the fee is sized against the vsize BOUND, the jitter only adds,
    and the target is the estimate rounded up -- by up to about 60% at the
    widest OP_RETURN policy. Compared with the target, an estimate one sat
    above it replaced a forward that already paid more than the market:
    a few hundred sat more out of the client's deposit, and one more
    same-outpoints RBF pair on the public chain, the shape the bump
    comment itself calls recognisable. The target stays the fallback for a
    plan from before the real rate was recorded."""
    paid = plan.get("feerate_target_sat_vb")
    ts = plan.get("ts")
    fee, vs = plan.get("fee_sat"), plan.get("vsize")
    _real = all(isinstance(x, int) and not isinstance(x, bool) and x >= 1
                for x in (fee, vs))
    _aimed = isinstance(paid, int) and not isinstance(paid, bool) \
        and paid >= 1
    if not (_real or _aimed):
        return False
    if isinstance(ts, bool) or not isinstance(ts, (int, float)):
        return False
    if isinstance(fee_sat_vb, bool) or not isinstance(fee_sat_vb, int):
        return False
    # THE STAMP IS THE START OF A TEN-MINUTE BUCKET (plans coarsen their
    # time), so the forward may have gone out up to STAMP_BUCKET_S - 1
    # seconds after it: measured from the bucket's start, a replacement
    # could go out that much sooner than the operator asked -- the one
    # bound the window promises. Measured from its END, it never does.
    # 0 is the drill's "at once", and stays so.
    age = (now if now is not None else time.time()) - float(ts)
    if float(bump_after_s) > 0:
        age -= STAMP_BUCKET_S - 1
    above = (fee_sat_vb * vs > fee) if _real else (fee_sat_vb > paid)
    return age >= float(bump_after_s) and above


def _outpoints(items):
    return {(str(i["tx_hash"]).lower(), int(i["vout"])) for i in items or []}


def _pairs(seq):
    """(txid, vout) pairs from a list of two-element entries as the plan
    records them (`returned_kept.outpoints`, `returned_moved`); anything
    that is not such a list, or an entry that is not such a pair, counts
    for nothing. NEVER raises: a plan file is written by this tool, but a
    corrupt or hand-edited one must end in a verdict, not a traceback."""
    out = set()
    if not isinstance(seq, (list, tuple)):
        return out
    for _o in seq:
        try:
            out.add((str(_o[0]).lower(), int(_o[1])))
        except (TypeError, ValueError, IndexError, KeyError):
            continue
    return out


def _chain_plans(outfile):
    """Every plan of ours on the chain at `outfile` (the current file
    included), oldest last as _plan_chain lists them. _plan_file, not
    _read_plan: a rotated file that is not ours is skipped, and skipping
    it must not construct a Refused (which puts a refusal on the chain and
    a line in the log)."""
    chain = []
    for f in _plan_chain(outfile):
        try:
            _p = _plan_file(f)
        except (OSError, ValueError):
            continue
        if _p is not None:
            chain.append(_p)
    return chain


def round_outpoints(utxos, refunds, plans):
    """The outpoints among `utxos` that count as a ROUND of returned money
    toward --returns-max (the MED pass after the deep read): a VERIFIED
    ThorChain refund (`refunds`, classify_returns' records), and any
    output the SIZE of a refund of some forward in `plans` -- less than
    it sent, and within what refund_is_full allows back.

    The bound used to count every return. It exists to stop a route that
    keeps refunding from being paid for again every recheck, and a refund
    is what it must count; but a client who pays a deposit in three
    instalments, or a stranger's dust, burned it too, and the third
    honest payment was KEPT on the address for the operator's hand.
    Nothing a refund has is certain to be there: the memo's shape is
    ThorChain's to change, and the vault that refunds is the one holding
    the money after a churn, which no forward of ours paid -- so a round
    is counted by its source when that verifies, and by its amount
    otherwise. A top-up that happens to be the size of a forward counts;
    the cost of counting one is a kept output the operator moves, the
    cost of missing a refund is the deposit. Pure; junk counts for
    nothing."""
    out = set()
    for r in refunds or ():
        if not isinstance(r, dict) or r.get("verified") is not True:
            continue
        try:
            out.add((str(r.get("txid") or "").lower(), int(r.get("vout"))))
        except (TypeError, ValueError):
            continue
    sent = set()
    for p in plans or ():
        s = p.get("send_sat") if isinstance(p, dict) else None
        if isinstance(s, int) and not isinstance(s, bool) and s > 0:
            sent.add(s)
    for u in utxos or ():
        if not isinstance(u, dict):
            continue
        try:
            o = (str(u.get("tx_hash") or "").lower(), int(u.get("vout")))
            v = int(u.get("value"))
        except (TypeError, ValueError):
            continue
        if isinstance(u.get("value"), bool) or v <= 0:
            continue
        if any(v < s and btx.refund_is_full(v, s) for s in sent):
            out.add(o)
    return out


def _carried_returned(p):
    """Whether plan `p` counts toward --returns-max as a forward of money
    that came back. A plan written since the MED pass says how many of
    its inputs were a ROUND of returned money (`carried_refunds`, from
    round_outpoints: a verified refund, or an output the size of one), and
    counts when any was: a `returned` forward of honest top-ups alone does
    not. An older plan, without the field, counts by the rule it was
    written under: its reason is "returned", or -- a bump, an evicted or
    rejected re-sign built while such money sat settled -- it carried
    inputs the plan it replaced or re-signed did not have
    (`carried_returned`). Without that half a refund that rode in a
    replacement was never counted, and the bound could be over-run by
    rounds it never saw."""
    if not isinstance(p, dict):
        return False
    c = p.get("carried_refunds")
    if isinstance(c, int) and not isinstance(c, bool):
        return c > 0
    if p.get("reconcile_reason") == "returned":
        return True
    c = p.get("carried_returned")
    return isinstance(c, int) and not isinstance(c, bool) and c > 0


def returned_forwards(plans):
    """How many of `plans` are forwards of money that came back to the
    address (_carried_returned), each transaction counted once: the
    current plan is in the chain too, and a recovered one IS a rotated
    file. Anything that is not a plan counts for nothing. Pure."""
    seen, n = set(), 0
    for p in plans or ():
        if not _carried_returned(p):
            continue
        t = str(p.get("txid") or "").lower()
        if t and t in seen:
            continue
        seen.add(t)
        n += 1
    return n


def stuck_forward(candidates, spends, ours, fee_sat_vb, bump_after_s,
                  now=None):
    """(the plan to replace, the plans that conflict with it) or (None, []).

    The plan of ours -- the CURRENT one first, then the chain's rotated
    predecessors -- whose transaction is listed in the mempool and is due
    a bump: today's estimate above the rate IT pays, and the NEWEST forward
    of ours over its outpoints (itself, or a later plan that conflicts with
    it) sent at least `bump_after_s` ago (bump_due).

    Why the whole chain and not the current plan alone (stage 6, self-doubt
    pass): a forward left in the mempool can fall BEHIND a later plan --
    money came back and was forwarded beside it (`returned`), and the
    fresh plan became the current one. Read the current plan only and the
    stuck one is never seen again: it waits at its old rate for ever while
    ThorChain's inbound vault churns under it.

    Why the conflicts come back with it: a chain can hold more than one
    signature over the same outpoints already -- a replacement the server
    asked does not list beside the original it does, an evicted re-sign
    beside an original that came back. Each of those may be alive on some
    node. The replacement is priced to beat EVERY one of them
    (replacement_floor), so any node takes it, and whichever of them mines
    swaps once; and the window is measured from the newest, so a
    replacement sent minutes ago that the server has not seen yet is not
    replaced again at once. Pure; the clock may be injected."""
    listed = {s["txid"]: s for s in spends if s["txid"] in ours}
    for c in candidates:
        t = str(c.get("txid") or "").lower()
        hit = listed.get(t)
        if hit is None or hit["height"] > 0:
            continue
        mine = _outpoints(c.get("inputs"))
        if not mine:
            continue
        conflicts = [p for p in candidates
                     if str(p.get("txid") or "").lower() != t
                     and mine & _outpoints(p.get("inputs"))]
        stamps = [p.get("ts") for p in [c] + conflicts
                  if isinstance(p.get("ts"), (int, float))
                  and not isinstance(p.get("ts"), bool)]
        newest = {"feerate_target_sat_vb": c.get("feerate_target_sat_vb"),
                  "fee_sat": c.get("fee_sat"), "vsize": c.get("vsize"),
                  "ts": max(stamps) if stamps else None}
        if not bump_due(newest, fee_sat_vb, bump_after_s, now=now):
            continue
        return c, conflicts
    return None, []


def bump_floor(plan, op_return_limit, floor, n_inputs=None):
    """The lowest rate a REPLACEMENT of `plan` may pay, so a node holding
    the original takes it (BIP125): more absolute fee than the original by
    at least the incremental relay fee (one sat per vB of the replacement).
    Sized against the replacement's own bound over `n_inputs` inputs (the
    plan's own count when not given): ceil((old fee + bound) / bound), and
    never under the paid rate plus one or the operator's floor. A
    replacement with MORE inputs than that (money that came back rides in
    it) pays more absolute fee still at the same rate, so the count of the
    replaced plan's inputs is a safe lower bound."""
    n = len(plan.get("inputs") or []) if n_inputs is None else int(n_inputs)
    bound = btx.vsize_upper_bound(
        max(1, n), [INBOUND_SPK_MAX, btx.op_return_script_len(op_return_limit)])
    old_fee = int(plan.get("fee_sat") or 0)
    by_fee = -(-(old_fee + bound) // bound)
    paid = plan.get("feerate_target_sat_vb")
    paid = int(paid) if isinstance(paid, int) and not isinstance(paid, bool) \
        else 0
    return max(int(floor), paid + 1, by_fee)


def replacement_floor(stuck, conflicts, op_return_limit, floor):
    """The rate a replacement of `stuck` pays at least: bump_floor over
    the stuck plan AND every plan that conflicts with it, each sized over
    the replacement's own input count, so a node holding any of them takes
    the replacement in its place."""
    n = len(stuck.get("inputs") or [])
    return max([bump_floor(stuck, op_return_limit, floor, n_inputs=n)]
               + [bump_floor(p, op_return_limit, floor, n_inputs=n)
                  for p in conflicts])


def with_plan_inputs(picture, plan, min_conf):
    """The look's picture with the plan's inputs added as settled money:
    an Electrum server's listunspent HIDES an output that a mempool
    transaction spends, so the outputs a stuck forward spends are not in
    the look, and the replacement has to be built from the plan's own
    record of them. Deduplicated by outpoint against what the look did
    return (a server whose mempool never saw our transaction lists them
    still). They were settled to `min_conf` when they were chosen and depth
    only grows, so each carries at least that depth. Each is marked `must`
    (select_inputs): the replacement spends every outpoint the stuck
    transaction spends, dust at today's rate or not. Returns the sat
    added."""
    have = {(str(u["tx_hash"]).lower(), int(u["vout"])): u
            for u in picture["utxos"]}
    added = 0
    for i in plan.get("inputs") or []:
        key = (str(i["tx_hash"]).lower(), int(i["vout"]))
        if key in have:
            have[key]["must"] = True
            continue
        conf = i.get("confirmations")
        conf = (int(conf) if isinstance(conf, int)
                and not isinstance(conf, bool) else 0)
        value = int(i["value"])
        u = {"tx_hash": key[0], "vout": key[1], "value": value,
             "confirmations": max(int(min_conf), conf), "must": True}
        picture["utxos"].append(u)
        have[key] = u
        added += value
    picture["settled_sat"] = int(picture.get("settled_sat") or 0) + added
    picture["confirmed_sat"] = int(picture.get("confirmed_sat") or 0) + added
    if picture["settled_sat"] > 0:
        picture["state"] = watch.STATE_CONFIRMED
    return added


def _memo_is_ours(tx_hex, dest_xmr):
    """(memo_text or None, True iff its OP_RETURN names our destination)."""
    from embit.transaction import Transaction as _Tx
    tx = _Tx.parse(bytes.fromhex(tx_hex))
    memo = None
    for o in tx.vout:
        data = _op_return_data(o.script_pubkey.data)
        if data is not None:
            try:
                memo = data.decode("utf-8")
            except UnicodeDecodeError:
                memo = None
            break
    ours = bool(memo) and instruction_field_safe(memo) \
        and _memo_fields_bind(memo, dest_xmr)
    return memo, ours


#: How many txids that funded kept, hand-moved or leftover outputs the
#: reconciliation's history read fetches beyond its window (reconcile's
#: keep list). Our own forwards and what funded their inputs are always
#: read; these ride on top, and a budgeted read cannot carry hundreds.
KEEP_EXTRA_MAX = 20


def _witnessed(args, plan, spends, address, servers):
    """`spends` as the reconciliation may act on them: the current plan's
    own transaction, while its signed bytes are KEPT (the network has not
    been shown to hold it), stays listed only on the word of a server that
    can be its witness -- the rule the send's own `seen` keeps: never a
    server that answered a submit with a txid not ours
    (`broadcast_distrusted`), and not the one that accepted it while
    another can be asked. Listed by one of those, the address is asked
    once more, of the others. Not listed there, the listing is left out
    ("dropped") and the run goes on as for a transaction that is not
    listed -- the same bytes sent again, which cannot spend anything
    twice. With nobody else to ask, a caught-out server's listing is
    dropped too, and the acceptor's is kept but UNCONFIRMED: the bytes
    stay kept and the plan is not marked seen -- a server that is down
    for a while is not a lie, and failing every run until it is back
    would say "failed" about a forward that may well have gone.
    Returns (spends, "" | "dropped" | "unconfirmed").

    THE REVIEW OF THE STAGE 3 READ: `seen` left the caught-out server out,
    and the next run's history read took it -- the first server that
    answered -- at its word. It listed the txid it had been handed, the
    kept bytes were dropped as proven, and the forward sat "listed" on
    every run after about a transaction the network never had. Rests on
    some other configured server being honest, which is all a second
    opinion is; with none left to ask, the bytes stay kept."""
    txid = str(plan.get("txid") or "").lower()
    if not plan.get("tx_hex") or not txid:
        return spends, ""
    hit = next((x for x in spends if str(x.get("txid")).lower() == txid),
               None)
    if hit is None:
        return spends, ""
    distrust = _distrusted(None, plan)
    acceptor = plan.get("broadcast_server")
    by = hit.get("server")
    if by not in distrust and not (by == acceptor and len(servers) > 1):
        return spends, ""
    try:
        sr = bcast_seen(txid, address, servers, args.tor_proxy,
                        network=args.network, timeout=args.timeout,
                        wait_s=0, interval_s=args.seen_interval,
                        avoid=[acceptor] if isinstance(acceptor, str)
                        and acceptor else [],
                        stop=shutdown_requested, distrust=distrust)
    except watch.PinMismatch as e:
        raise Refused("pin_mismatch", str(e))
    except watch.BtcWatchError:
        sr = {"seen": False, "asked": False}
    if sr["seen"]:
        hit["server"], hit["height"] = sr["server"], sr["height"]
        return spends, ""
    if not sr["asked"] and by not in distrust:
        integrity_log("forward", "listed_unconfirmed")
        print("  reconcile: our transaction is listed by the server that "
              "accepted it, and no other server could be asked to confirm "
              "it; the signed bytes stay kept.")
        return spends, "unconfirmed"
    integrity_log("forward", "listed_unwitnessed")
    print("  reconcile: our transaction is listed only by a server that "
          "cannot vouch for it (the one that accepted it, or one that "
          "answered a transaction not ours), and "
          + ("no other server lists it" if sr["asked"]
             else "no other server could be asked")
          + "; the signed bytes stay kept.")
    return [x for x in spends if x is not hit], "dropped"


def reconcile(args, plan, picture, address, index, servers, dest_xmr):
    """What became of the forward the plan describes, and what to do
    (STAGE5_PLAN.md 3.1). Reads the address's spends (read-only) beside
    the look already taken, and returns one of:

        ("done", EXIT_OK)         our transaction is listed; the plan is
                                  brought up to date (seen, height; an
                                  ambiguous outcome becomes accepted; kept
                                  bytes are dropped). The agent reads `sent`.
        ("resend", tx_hex)        not listed, its inputs still unspent, the
                                  signed bytes kept: hand the SAME bytes to
                                  the network again.
        ("forward", exclude, why) money to send on that no listed forward
                                  of ours consumed: `evicted` (our unlisted
                                  transaction's own inputs, re-signed --
                                  every input opts into RBF), `returned`
                                  (new outputs: a refund, a second payment),
                                  or `bumped` (stage 6: a forward of ours --
                                  the current plan or a rotated predecessor,
                                  handed back as a FOURTH element -- has sat
                                  in the mempool past --bump-after at a rate
                                  under today's estimate; the SAME outpoints,
                                  replaced at today's rate, with whatever
                                  settled since). The caller runs the
                                  ordinary forward with `exclude` left out
                                  and rotates the plan when it writes the
                                  new one.

    A spend of the address that is not in our plan chain is examined: an
    txid this tool recorded before sending it (record_signed) is a forward
    of ours the chain forgot (adopted as ours, and a plan rebuilt for it
    from the chain, filed as a rotated predecessor); anything else FAILS the run
    with the kind on the chain -- nothing is signed. A memo naming this
    destination is not enough: every forward of ours put it on the chain
    for whoever holds the seed to copy (SIGNED_SCHEMA). Money come back but not yet settled is
    the word `returned` and a refusal: sent on when it settles."""
    # OUR OWN TRANSACTIONS ARE READ WHEREVER THEY SIT in a history longer
    # than the window: every forward in the plan chain and what funded its
    # inputs. A dust flood that pushed them off the newest MAX_HISTORY left
    # our forward's inputs neither unspent nor consumed -- the safe
    # history_inconsistent, on every run, for good.
    _chain0 = _chain_plans(args.outfile)
    _keep, _kept_f, _left_f = set(), set(), set()
    for _p0 in [plan] + _chain0:
        if _p0.get("txid"):
            _keep.add(str(_p0["txid"]).lower())
        for _i0 in (_p0.get("inputs") or []):
            if isinstance(_i0, dict) and _i0.get("tx_hash"):
                _keep.add(str(_i0["tx_hash"]).lower())
        # ...AND WHAT FUNDED THE KEPT AND THE HAND-MOVED OUTPUTS: pushed off
        # the window by a flood, a hand move of them was listed with no
        # inputs, matched no kept outpoint, and read as a foreign spend --
        # "the seed has leaked" -- on every run until it left the window.
        _rk0 = _p0.get("returned_kept")
        _rl0 = _p0.get("returned_leftover")
        _kept_f |= {str(_t0).lower() for _t0, _v0 in (
            _pairs((_rk0 or {}).get("outpoints")
                   if isinstance(_rk0, dict) else None)
            | _pairs(_p0.get("returned_moved")))}
        _left_f |= {str(_t0).lower() for _t0, _v0 in _pairs(
            (_rl0 or {}).get("outpoints") if isinstance(_rl0, dict)
            else None)}
    # ...AT MOST KEEP_EXTRA_MAX OF THOSE, kept and moved before leftover
    # (the review of that fix). A `leftover` records whatever came back,
    # and a stranger's flood of separate small payments -- each its own
    # funding transaction -- put hundreds of txids on top of the window,
    # past what the read's budget allows: history_unavailable on every run
    # for good, the jam MAX_HISTORY's window exists to close. The cap is
    # public and rests on nothing secret; it bounds the read. Past it, a
    # hand move whose EVERY input was funded off the window reads as a
    # foreign spend -- FAILED, nothing signed -- until that move leaves
    # the window itself; one with any input funded inside it still reads
    # as the operator's hand.
    _extra = [t for t in sorted(_kept_f) if t not in _keep]
    _extra += [t for t in sorted(_left_f)
               if t not in _keep and t not in _kept_f]
    _keep |= set(_extra[:KEEP_EXTRA_MAX])
    try:
        _res = bcast_spends(address, servers, args.tor_proxy,
                            network=args.network, timeout=args.timeout,
                            with_funding=True,
                            on_truncated=_history_truncated,
                            keep_txids=sorted(_keep))
    except watch.PinMismatch as e:
        raise Refused("pin_mismatch", str(e))
    except watch.BtcWatchError as e:
        integrity_log("forward", "history_unavailable")
        print(f"[!] the address's history could not be read ({e}); a "
              "reconciliation cannot decide without it")
        raise SystemExit(EXIT_FAILED)
    # (spends, what paid the address); a reader that answers the spends
    # alone -- the stage-5 shape -- is taken as knowing of no memo.
    spends, paid = (_res if isinstance(_res, tuple) and len(_res) == 2
                    else (_res, []))
    spends, _witness = _witnessed(args, plan, spends, address, servers)
    chain = _chain0
    ours = {str(p.get("txid") or "").lower() for p in chain
            if p.get("txid")}
    ours.add(str(plan.get("txid") or "").lower())
    # A REFUND OR A PAYMENT? (third self-doubt pass; classify_returns says
    # what is verified, what is full, and why -- against the vaults our
    # own forwards paid, no live lookup.) Recorded on the plan as
    # `refunds` -- the file that is current now, which the chain keeps
    # when it is rotated aside -- for the pairs rewrite on the vault (a
    # verified FULL refund's forward drops out of what the XMR side
    # expects) and for the operator's reading. Recomputed every run from
    # the history, so a run that never writes the plan loses nothing. A
    # claim is logged ONCE a run, whatever its count: a stranger's dust
    # with a REFUND memo must not write a line per output to the chain.
    _refunds = classify_returns(paid, [plan] + chain)
    _refund_ops = {(r["txid"], r["vout"]) for r in _refunds if r["verified"]}
    if _refunds:
        _merged = [r for r in (plan.get("refunds") or [])
                   if isinstance(r, dict)]
        _claimed = False
        for r in _refunds:
            for m in _merged:
                if (m.get("txid"), m.get("vout")) == (r["txid"], r["vout"]):
                    if r["verified"] and m.get("verified") is not True:
                        m["verified"] = True
                    if r["full"] and m.get("full") is not True:
                        m["full"] = True
                    if m.get("outbound_fee_sat") is None \
                            and r.get("outbound_fee_sat") is not None:
                        m["outbound_fee_sat"] = r["outbound_fee_sat"]
                    break
            else:
                _merged.append(dict(r))
                if r["verified"]:
                    integrity_log("forward", "refund_seen")
                else:
                    _claimed = True
                print(f"  reconcile: output {r['txid']}:{r['vout']} "
                      f"({r['value']} sat) is a ThorChain REFUND of our "
                      f"forward {r['of']}"
                      + (" in full" if r["full"] else " in part")
                      + (", from a vault a forward of ours paid (verified)."
                         if r["verified"] else
                         ", NOT from a vault any forward of ours paid: a "
                         "claim only, and nothing rests on it."))
        if _claimed:
            integrity_log("forward", "refund_claimed")
        plan["refunds"] = _merged
    # THE OUTPUTS THE VAULT KEEPS (returned past --returns-max), from every
    # plan in the chain: a spend of exactly those is the operator moving
    # them by hand -- the documented remedy -- and not a leaked seed. AND
    # THE ONES ALREADY MOVED (`returned_moved`, written below the moment a
    # hand move is recognised, never popped): the kept mark is this run's
    # to make and is cleared once the money is gone, so without a record
    # of its own the run AFTER the one that said "the operator's hand"
    # found the same spend, no mark, and cried seed leak -- for ever, and
    # before any forward logic, so a later refund or payment to the
    # address could never be forwarded either.
    # LESS EVERY OUTPOINT A PLAN OF OURS SPENDS (self-doubt over the fix):
    # a mark on a rotated plan outlives the bound it was written under.
    # Re-paired higher, the next bump or re-sign CARRIED the kept output
    # -- this tool signed for it -- while the rotated plan still named it
    # kept, and a spend of exactly that output by a transaction this tool
    # did not sign (a replacement of ours, by a leaked seed) was blessed as
    # the operator's hand. An output this tool signed for is never kept;
    # a foreign spend of it conflicts with our signature and IS the alarm.
    _kept_ops, _signed_ops = set(), set()
    for _p in [plan] + chain:
        if not isinstance(_p, dict):
            continue
        _rk = _p.get("returned_kept")
        _kept_ops |= _pairs((_rk or {}).get("outpoints")
                            if isinstance(_rk, dict) else None)
        # ...AND WHAT A `leftover` ANSWER SAID STAYS THERE (returned_leftover):
        # money no rate carries, which the operator moves by hand the same
        # way. Rests on the seed alone, as the kept mark does.
        _rl = _p.get("returned_leftover")
        _kept_ops |= _pairs((_rl or {}).get("outpoints")
                            if isinstance(_rl, dict) else None)
        _kept_ops |= _pairs(_p.get("returned_moved"))
        _signed_ops |= _pairs([(i.get("tx_hash"), i.get("vout"))
                               for i in (_p.get("inputs") or [])
                               if isinstance(i, dict)])
    _kept_ops -= _signed_ops
    _sent_here = signed_txids(args.outfile)
    listed = {s["txid"]: s for s in spends}
    # WHAT A LISTED HAND MOVE SPENDS is gone, whatever the look says: the
    # look is another session, perhaps another server, and one that has
    # not seen the move still lists the kept outputs unspent. Counted as
    # consumed below with our own forwards' inputs.
    _moved_ins = set()
    _adopted = []
    for s in spends:
        if s["txid"] in ours:
            continue
        _memo, mine = _memo_is_ours(s["hex"], dest_xmr)
        if mine and str(s["txid"]).lower() in _sent_here:
            # A FORWARD OF OURS THE CHAIN FORGOT: a signature this tool
            # made and recorded before sending, whose plan was lost. It is
            # ours; its inputs are gone. A plan is rebuilt for it below,
            # once no spend here is the alarm.
            integrity_log("forward", "adopted_spend")
            ours.add(s["txid"])
            _adopted.append((s, _memo))
            continue
        _ins = {(str(i.get("tx_hash") or "").lower(), int(i.get("vout") or 0))
                for i in (s.get("inputs") or []) if isinstance(i, dict)}
        if _kept_ops and _ins and _ins <= _kept_ops:
            # MONEY THE VAULT KEPT, MOVED BY HAND (the documented remedy
            # for a return past the bound): expected, not an alarm. Only
            # a seed holder can spend from the address, and a leaked seed
            # that took ONLY the kept outputs took what the operator was
            # about to move anyway; one that took more fails below.
            # RECORDED ON THE PLAN AT ONCE, and written: the same spend is
            # in the history on every later run, and the kept mark it
            # matched is cleared below once nothing is left to keep.
            _seen_moved = _pairs(plan.get("returned_moved"))
            _dirty = False
            if not _ins <= _seen_moved:
                plan["returned_moved"] = sorted(
                    [list(o) for o in (_seen_moved | _ins)])
                _dirty = True
            # ...AND TAKEN OFF THE MARK, whatever else this run does: a
            # bump the ceiling refuses leaves the current plan as it is,
            # and a mark that still named outputs `returned_moved` said
            # were gone read as kept money to the operator (self-doubt
            # over the fix). What is left stays marked, recounted; nothing
            # left, no mark.
            _rk = plan.get("returned_kept")
            if isinstance(_rk, dict) and _pairs(_rk.get("outpoints")) & _ins:
                _left = sorted(_pairs(_rk.get("outpoints")) - _ins)
                if _left:
                    _val = {(str(u["tx_hash"]).lower(), int(u["vout"])):
                            int(u["value"]) for u in picture["utxos"]}
                    _rk["outpoints"] = [list(o) for o in _left]
                    _rk["outputs"] = len(_left)
                    _rk["sat"] = sum(_val.get(o, 0) for o in _left)
                    _rk["refunds"] = sum(1 for o in _left if o in _refund_ops)
                else:
                    plan.pop("returned_kept", None)
                _dirty = True
            if _dirty:
                write_plan(args.outfile, plan)
            _moved_ins |= _ins
            integrity_log("forward", "kept_moved")
            print(f"  reconcile: the kept outputs were moved by a spend "
                  f"this tool did not sign (txid {s['txid']}): the "
                  "operator's hand, as documented. Nothing to send.")
            continue
        integrity_log("forward", "foreign_spend")
        _why = ("it carries this deposit's own memo, but this box never "
                "recorded sending it -- and that memo is on the chain in "
                "every forward of ours, for whoever holds the seed to copy"
                if mine else
                "its memo does not name this deposit's destination")
        print("[!] the deposit address was spent by a transaction this "
              f"tool did not sign: {_why} (txid {s['txid']}). Nothing is "
              "signed. If no operator moved it by hand, the seed has "
              "leaked.")
        raise SystemExit(EXIT_FAILED)
    # A PLAN FOR EVERY FORWARD OF OURS ADOPTED ABOVE. A reconciliation's
    # fresh forward (a refund, a second payment, a re-sign, a bump) that
    # was SENT and then killed before its plan -- a power cut, the agent's
    # deadman or job budget, a kill in the seen wait -- was adopted on every
    # later run and recorded nowhere: never a stuck_forward candidate, so a
    # low rate sat in the mempool while ThorChain's vault churned under it;
    # never counted toward --returns-max, so the round it carried did not
    # count, and the next return was sent on where the same run without the
    # kill kept it; and a refund of it matched no plan, so classify_returns
    # could neither see it as one nor verify its source. The record the
    # reconstruction needed before the send (STAGE6_PLAN.md's residual)
    # exists: record_signed, written before the bytes leave. The plan is
    # rebuilt from the transaction as reconcile_emptied rebuilds one, and
    # filed as a ROTATED predecessor: the current plan stays the one it
    # was -- the verdict below, and the agent's word, are still read off it.
    # Its `carried_refunds` are the rounds among its inputs no plan of ours
    # spends (round_outpoints over this run's refunds and the chain), as
    # main() counts a fresh forward's. Its QUOTE is the one the record kept
    # (signed_quote), so the vault's pairs rewrite counts this swap. That
    # was claimed here once with no quote to back it: this comment said
    # leaving `replaces` off avoided "a swap counted neither way", while
    # the plan the replacement superseded was dropped as superseded and
    # the replacement, quote-less, counted nothing -- the XMR side called
    # the deposit complete a swap early. NOT `replaces`: the reconciliation
    # marks the plan it replaced superseded, which is the rewrite's rule for
    # which of the two counts. Written once: next run it is in the chain, so
    # in `ours`, and not adopted again.
    for s, _memo in _adopted:
        from embit.transaction import Transaction as _Tx
        _ap = _plan_of_spend(s, _Tx.parse(bytes.fromhex(s["hex"])), _memo,
                             args.network, index, address, dest_xmr,
                             picture.get("tip"),
                             quote=signed_quote(args.outfile, s["txid"]))
        _new = _outpoints(_ap["inputs"]) - _signed_ops
        _rounds = round_outpoints(_ap["inputs"], plan.get("refunds"),
                                  [plan] + chain)
        _ap["adopted"] = True           # for the operator's reading only
        _ap["reconcile_reason"] = None
        _ap["carried_returned"] = len(_new)
        _ap["carried_refunds"] = len(_new & _rounds)
        chain.append(_ap)
        try:
            _where = _file_rotated(args.outfile, _ap)
        except OSError as e:
            # Counted for THIS run all the same (the chain in memory): the
            # bound and the bump read it below. The next run adopts it
            # again and tries again.
            integrity_log("forward", "adopted_plan_unwritten")
            print(f"  [!] reconcile: the plan rebuilt for our forward "
                  f"{s['txid']} could not be written "
                  f"({e.strerror or e}); counted for this run only")
            continue
        integrity_log("forward", "adopted_planned")
        print(f"  reconcile: our forward {s['txid']} went out and its run "
              f"did not live to write a plan; one is rebuilt from the chain "
              f"({_where.name})")
    # ...AND WHAT A HAND MOVE OF THE KEPT OUTPUTS SPENDS: a run that said
    # kept_moved then signed a forward over the moved output whenever the
    # look still listed it -- a second signature over an outpoint a listed
    # transaction spends: the kept money into the swap if ours won, and
    # if the operator's won, our own forward's input read as foreign ("the
    # seed has leaked") on every run after.
    consumed = {(str(i["tx_hash"]).lower(), int(i["vout"]))
                for s in spends if s["txid"] in ours
                for i in s["inputs"]} | _moved_ins
    unspent = {(str(u["tx_hash"]).lower(), int(u["vout"])): u
               for u in picture["utxos"]}
    # ...AND NOT DUST AT EVERY RATE THIS PAIR PAYS: an output at or under
    # dust_line(the floor) is left behind by select_inputs at every rate in
    # the band, so it is not money that came back -- it is money no forward
    # of this pair can carry. Counted as returned, a stranger's hundred
    # satoshis to a spent address was forwarded (refused, nothing_economic),
    # answered `leftover` -- "some came back ... Check" to the client and a
    # "stopped" line to the operator -- and, at --returns-max, marked KEPT
    # while our own forward sat in the mempool: the phone heard `kept` and
    # the Pi stopped rechecking a forward that had not confirmed. Anyone who
    # knows the address can pay dust to it; this rests on nothing secret,
    # only on the dust line being the pair's own. (A bump's `must` inputs
    # are not asked about here: they are marked after this returns, and
    # they are a listed forward's inputs, so in `consumed` already.)
    # WHAT IT DOES NOT COVER (the review of this fix): at the stock floor of
    # 1 the line is 138 sat, under the smallest output a node relays (294
    # for P2WPKH), so there it filters only what a miner took off-policy. A
    # stranger's RELAYABLE payment is over it, and is money that came back:
    # `leftover` once the forward has mined, which is true of it -- it came
    # back and nothing can carry it. The line is public and anyone can pay
    # just over it; this is about what no forward of this pair can carry,
    # not about who paid. At a floor of 3 (414 sat) it does filter
    # relayable dust.
    _dust_floor = dust_line(int(args.feerate_floor))
    fresh = {k: u for k, u in unspent.items() if k not in consumed
             and int(u.get("value") or 0) > _dust_floor}
    settled_new = [u for u in fresh.values()
                   if u["confirmations"] >= args.min_conf
                   and u["confirmations"] >= 1]
    unsettled_new = [u for u in fresh.values() if u not in settled_new]
    txid = str(plan.get("txid") or "").lower()
    plan_inputs = {(str(i["tx_hash"]).lower(), int(i["vout"]))
                   for i in plan.get("inputs") or []}
    # STAGE 6: A FORWARD OF OURS LISTED IN THE MEMPOOL, AND SITTING THERE.
    # A forward at a rate the network stopped confirming waited for ever
    # ("nothing to send"), while ThorChain's inbound vault churns under it
    # and the memo's limit protects the price of a swap that never happens.
    # Every input opts into RBF: when it has sat for --bump-after and
    # today's estimate is above the rate it pays, it is REPLACED -- a fresh
    # forward over the SAME outpoints at today's rate, quoted afresh for
    # the amount and the current inbound. The caller builds it from that
    # plan's inputs (the look hides outputs a mempool transaction spends)
    # with a floor a node holding the original will take (bump_floor), and
    # the new plan names the replaced one in `replaces`. The exclusion list
    # leaves out every outpoint a LISTED forward of ours consumed except
    # the replaced transaction's own -- so money that came back to the
    # address and settled rides in the replacement, one transaction, one
    # fee, instead of a second forward beside a stuck one. The current
    # plan is the first candidate and the chain's predecessors the rest
    # (stuck_forward says why).
    _est = todays_rate(args, picture)
    # The window is DRAWN, never the flag's exact number (BUMP_WINDOW): a
    # replacement at a fixed offset after the transaction it replaces is
    # this host's signature on a pair of public transactions.
    stuck, conflicts = stuck_forward(
        [plan] + [p for p in chain
                  if str(p.get("txid") or "").lower() != txid],
        spends, ours, _est, BUMP_WINDOW(args.bump_after))

    # MONEY THAT CAME BACK AGAIN IS KEPT (third self-doubt pass). A refund
    # was sent on again at a fresh quote, which is right the first time (a
    # limit the price moved past while the forward confirmed) and ruinous
    # for ever: ThorChain refunds what it will not swap, less its outbound
    # fee, the refund settled by the next recheck, and this returned it
    # into the same swap -- a network fee and that outbound fee per round,
    # a round per recheck, "sent" in the chat each time, until the deposit
    # was gone. Nothing proves ThorChain routes XMR before mainnet does, so
    # the FIRST mainnet deposit could have gone this way. Past --returns-max
    # forwards of returned money in this deposit's record, the next return
    # is written on the plan as `returned_kept`, the run is done (nothing
    # failed), the vault's word is `kept`, and the money waits on the
    # address for the operator -- who moves it by hand, or re-pairs with a
    # higher bound and taps.
    _returned_n = returned_forwards([plan] + chain)
    _at_limit = _returned_n >= int(args.returns_max)
    # THE OUTPUTS THAT CAME BACK, whatever branch follows: everything
    # unspent that is not the current plan's own inputs (an evicted
    # forward's inputs are unspent again and are NOT returned money). At
    # the bound these are left out of EVERY fresh forward -- the evicted
    # re-sign and the rejected re-send's fresh forward included, which
    # used to sweep the kept money back into the swap the bound exists to
    # stop paying for.
    _plan_ins = {(str(i.get("tx_hash") or "").lower(), int(i.get("vout") or 0))
                 for i in (plan.get("inputs") or []) if isinstance(i, dict)}
    _kept_ex = (sorted(set(unspent) - _plan_ins - consumed)
                if _at_limit else [])

    def _kept(outputs, settled):
        """The verdict when money that came back is NOT sent on again
        (--returns-max), or None when it is."""
        if not _at_limit:
            return None
        # ...ONLY MONEY A FORWARD COULD CARRY IS KEPT BY THE BOUND. What no
        # rate in the band forwards -- settled or not (weighed as if it had
        # settled) -- is not held back by --returns-max; it cannot move
        # anyway. Marked kept, it made the phone hear `kept` and the Pi stop
        # rechecking our own forward while it sat in the mempool. Not kept,
        # it goes the ordinary way: a refused forward, `leftover` once ours
        # has mined, `sent` while it has not.
        _as_settled = [dict(u, confirmations=max(int(u["confirmations"]),
                                                 int(args.min_conf), 1))
                       for u in outputs]
        if not forwards_in_band(_as_settled, args.min_conf,
                                int(args.feerate_floor),
                                int(args.feerate_ceiling), (),
                                args.op_return_max_bytes,
                                args.min_send_sat):
            return None
        # WHAT THE MARK NAMES IS WHAT A HAND MOVE TAKES: everything on the
        # address that is not ours in flight (_kept_ex), DUST INCLUDED (the
        # review of the dust fix). `outputs` leaves out what no forward can
        # carry, and the mark named only those -- so the operator's wallet
        # sweep, the documented remedy, spent a stranger's few hundred
        # satoshis beside them, matched no kept outpoint, and read as "the
        # seed has leaked" on every run after, the deposit never forwarded
        # again. Anyone who knows the address can plant that dust.
        _back = [unspent[o] for o in _kept_ex if o in unspent]
        plan["returned_kept"] = {
            "outputs": len(_back),
            "sat": sum(int(u["value"]) for u in _back),
            "settled": bool(settled),
            "forwards_of_returned": _returned_n,
            # ...how many of them are VERIFIED ThorChain refunds; the
            # rest are payments, or claims nothing rests on.
            "refunds": sum(1 for u in _back
                           if (str(u.get("tx_hash") or "").lower(),
                               int(u.get("vout") or 0)) in _refund_ops),
            # ...and WHICH, so a later spend of exactly these reads as the
            # operator's hand (kept_moved) and not a leaked seed.
            "outpoints": [[str(u.get("tx_hash") or "").lower(),
                           int(u.get("vout") or 0)] for u in _back]}
        plan["reconciled_ts"] = int(time.time()) // 600 * 600
        write_plan(args.outfile, plan)
        integrity_log("forward", "returned_kept")
        print(f"  reconcile: money came back to the address AGAIN -- this "
              f"deposit's record already holds {_returned_n} forward(s) of "
              f"returned money (--returns-max {int(args.returns_max)}). It "
              "is KEPT here, not sent on by itself: a route that keeps "
              "refunding costs a network fee and ThorChain's outbound fee "
              "per round. Move it by hand, or re-pair with a higher "
              "--btc-returns-max and ask again.")
        print(f"  plan updated: {args.outfile}")
        return "done", EXIT_OK

    def _bump(stuck):
        integrity_log("forward", "stuck_predecessor" if stuck is not plan
                      else "stuck_current")
        print("  reconcile: a forward of ours has sat in the mempool past "
              "the bump window and today's estimate is above the rate it "
              "pays. Replacing it at today's rate"
              + (", with what settled since" if settled_new else "") + ".")
        _ex = consumed - _outpoints(stuck.get("inputs"))
        if settled_new and _at_limit:
            # ...NOT with money that came back past --returns-max: that
            # does not ride in a replacement either. The next
            # reconciliation writes it kept.
            _ex |= _outpoints(settled_new)
        return "forward", sorted(_ex), "bumped", stuck, conflicts

    def _after_record(stuck):
        """WHAT FOLLOWS ONCE THE RECORD IS FOUND -- our transaction listed,
        or this plan superseded by a forward of ours that is -- decided
        once for both: a stuck forward is replaced; new settled money is
        forwarded (or kept, at the bound); new money not yet settled is
        the word `returned` and a refusal (or kept, at the bound); None
        when there is nothing to do. The superseded branch once had only
        the first two: unsettled money back beside a superseded plan was
        `done` -- the phone hearing `forwarded` where the listed branch
        said `returned`, and a kept mark dropped at the bound."""
        if stuck is not None:
            return _bump(stuck)
        if settled_new:
            _k = _kept(settled_new, True)
            if _k is not None:
                return _k
            integrity_log("forward", "returned_settled")
            _nr = sum(1 for u in settled_new
                      if (str(u.get("tx_hash") or "").lower(),
                          int(u.get("vout") or 0)) in _refund_ops)
            print(f"  reconcile: {len(settled_new)} new settled output(s) on "
                  f"the address that no forward of ours consumed ({_nr} "
                  f"verified ThorChain refund(s), {len(settled_new) - _nr} "
                  "payment(s) or unverified): forwarding them.")
            return "forward", sorted(consumed), "returned"
        if unsettled_new:
            _k = _kept(unsettled_new, False)
            if _k is not None:
                return _k
            integrity_log("forward", "returned_unsettled")
            write_status(args.outfile, STATUS_RETURNED)
            raise Refused("returned_unsettled",
                          f"{len(unsettled_new)} new output(s) came back to "
                          "the address and are not settled yet; they are "
                          "sent on once they are")
        return None

    if txid in listed:
        hit = listed[txid]
        # ...UNCONFIRMED (_witnessed): listed by the acceptor alone, nobody
        # else to ask. Acted on as listed, never taken as proof.
        if _witness != "unconfirmed":
            plan["seen"] = True
            plan["seen_height"] = hit["height"]
            plan["seen_server"] = hit.get("server")
            plan["seen_asked"] = True
            if plan.get("broadcast_outcome") != bcast.OUTCOME_ACCEPTED:
                plan["broadcast_outcome"] = bcast.OUTCOME_ACCEPTED
            plan["broadcast"] = True
            plan["tx_hex"], plan["tx_hex_reason"] = None, None
        plan["reconciled_ts"] = int(time.time()) // 600 * 600
        # THE NETWORK HAS NAMED THIS TRANSACTION AS THE RECORD: a
        # superseded mark from an earlier run -- a lagging server that
        # still listed the original a bump replaced -- is stale now. Left,
        # the plan said both "listed" and "superseded by the original",
        # and the pairs rewrite counted the original, which can never
        # confirm, against the XMR that arrives from this one's quote.
        plan.pop("superseded_by", None)
        plan.pop("superseded_height", None)
        # A KEPT MARK IS THIS RUN'S TO MAKE, not a stale one's: money the
        # operator moved by hand is recorded above (returned_moved), and
        # money still here is written kept again below -- UNLESS this run
        # bumps AT THE BOUND, which never reaches _kept: the mark then
        # stands, since the bump leaves the kept money out (_bump), main
        # carries the mark onto the replacement, and the agent reads the
        # word `kept` off it. Popped before that bump, the client heard
        # `sent` for a window about money that sat on the address. UNDER
        # the bound (re-paired higher) a bump carries the kept money
        # instead, and the mark goes: this tool is moving it.
        if stuck is None or not _at_limit:
            plan.pop("returned_kept", None)
        write_plan(args.outfile, plan)
        integrity_log("forward", "reconciled_listed")
        where = ("in the mempool" if hit["height"] <= 0
                 else f"in a block at height {hit['height']}")
        print(f"  reconcile: our transaction is listed {where}. Nothing to "
              "send.")
        _then = _after_record(stuck)
        if _then is not None:
            return _then
        print(f"  plan updated: {args.outfile}")
        return "done", EXIT_OK
    # NOT LISTED. Where are the inputs it spent?
    if plan_inputs and plan_inputs <= set(unspent):
        if plan.get("tx_hex"):
            integrity_log("forward", "resend")
            print("  reconcile: our transaction is not listed and its inputs "
                  "are still unspent; the signed bytes were kept. Sending "
                  "the same transaction again.")
            # ...and, should every server refuse them, the fresh forward
            # that follows leaves out the kept money AND every outpoint a
            # listed forward of ours already spends (third element) -- the
            # same list the evicted branch below re-signs against. It
            # carried only the kept money: when the look and the history
            # came from different servers (each fails over on its own), an
            # outpoint our listed forward X spends read as unspent, and the
            # rejected re-send's fresh forward signed over it again -- a
            # second spend of an input we had already spent, the thing
            # select_inputs' NEVER TWICE exists to stop.
            return "resend", plan["tx_hex"], sorted(consumed | set(_kept_ex))
        integrity_log("forward", "evicted")
        print("  reconcile: our transaction is not listed and its inputs are "
              "still unspent, and no bytes were kept (it was listed once). "
              "Re-signing a fresh forward of the same money"
              + (", leaving out what came back past the bound" if _kept_ex
                 else "") + ".")
        return "forward", sorted(consumed | set(_kept_ex)), "evicted"
    # THE FORWARDS OF OURS OVER THIS PLAN'S INPUTS: the superseder is one
    # of them, never simply the newest of ours -- a newer forward of
    # returned money over other outpoints, in the mempool, was named, and
    # `forwarded` for this plan waited on an unrelated transaction.
    _over = [s for s in spends if s["txid"] in ours
             and plan_inputs & {(str(i["tx_hash"]).lower(), int(i["vout"]))
                                for i in s["inputs"]}]
    if plan_inputs and _over:
        # Its inputs were consumed by a listed forward of ours under
        # another txid (an earlier reconciliation re-signed). That one is
        # the record; this plan is superseded by it.
        newest = max(_over, key=lambda s: (s["height"] <= 0, s["height"]))
        plan["superseded_by"] = newest["txid"]
        # ...AND WHERE THAT ONE IS (stage 6): its height, so the agent can
        # say `forwarded` once the forward that IS the record is in a
        # block -- this plan's own txid never will be. Rewritten on every
        # run, so a superseder that was in the mempool is caught mined.
        plan["superseded_height"] = int(newest["height"])
        plan["reconciled_ts"] = int(time.time()) // 600 * 600
        if stuck is None or not _at_limit:     # as in the listed branch
            plan.pop("returned_kept", None)
        write_plan(args.outfile, plan)
        integrity_log("forward", "reconciled_superseded")
        print(f"  reconcile: this plan's inputs were spent by our listed "
              f"transaction {newest['txid']}; recorded.")
        _then = _after_record(stuck)
        if _then is not None:
            return _then
        return "done", EXIT_OK
    if _witness == "dropped":
        # ...AND ITS INPUTS READ AS SPENT: only the unwitnessed listing
        # accounts for that, and nobody who can vouch confirms it (one
        # server, caught out at the submit). Not "the server contradicts
        # itself": the operator needs to hear what would settle it.
        integrity_log("forward", "unwitnessed_spent")
        print("[!] reconcile: the plan's inputs read as spent, and the "
              "only transaction that spends them is ours as listed by a "
              "server that cannot vouch for it; no other server confirms "
              "it. Nothing is signed. A server this forward can take the "
              "word of (--electrum) settles it.")
        raise SystemExit(EXIT_FAILED)
    integrity_log("forward", "history_inconsistent")
    print("[!] reconcile: the plan's inputs are neither unspent nor consumed "
          "by any transaction the server lists; the server's history and "
          "unspent set contradict each other. Nothing is signed.")
    raise SystemExit(EXIT_FAILED)


def resend(args, plan, tx_hex, address, servers, kept_exclude=()):
    """Hand the SAME signed bytes to the network again (--reconcile found
    our transaction unlisted with its inputs still unspent). The plan is
    updated with this attempt. Returns ("done", exit_code) after an
    accepted or ambiguous outcome (the money may have moved; seen is
    polled as after a first send), raises SystemExit(EXIT_FAILED) when no
    server could be reached, and returns ("forward", [], "rejected") when
    every server that answered refused the bytes -- the transaction is
    stale (a policy or a fee the network no longer takes) and its inputs
    are still ours, so a fresh forward at today's fee follows."""
    txid = str(plan.get("txid") or "").lower()
    stop_before_send("re-sending")
    record_signed(args.outfile, txid)
    integrity_log("forward", "resending")
    try:
        sub = bcast_submit(tx_hex, txid, address, servers, args.tor_proxy,
                           network=args.network, timeout=args.timeout,
                           stop=shutdown_requested)
    except watch.PinMismatch:
        raise Refused("pin_mismatch",
                      "a pinned Electrum server presented another "
                      "certificate while re-sending; nothing was sent")
    except watch.BtcWatchError as e:
        raise Refused("bad_args", str(e))
    outcome = sub["outcome"]
    if sub.get("stopped") and outcome not in bcast.MAYBE_MOVED:
        # A STOP CUT THE LIST SHORT and nothing left: what the servers
        # reached said is not the network's word (submit's `stopped`).
        # Written as `rejected`, the plan's `accepted` became "never went
        # out" and a fresh forward was quoted and signed under the stop.
        # The plan is left as it was; the next run sends the same bytes.
        integrity_log("forward", "stopped_during_send")
        print(f"[!] a stop was asked while re-sending; nothing moved "
              f"({sub['attempts']} of {len(servers)} server(s) tried)")
        raise SystemExit(EXIT_FAILED)
    integrity_log("forward", f"broadcast_{outcome}")
    plan["resends"] = int(plan.get("resends") or 0) + 1
    plan["resend_outcome"] = outcome
    plan["reconciled_ts"] = int(time.time()) // 600 * 600
    plan["broadcast_distrusted"] = _distrusted(sub, plan)
    if outcome == bcast.OUTCOME_UNREACHABLE:
        # NOTHING WAS SENT THIS TIME, so the earlier send's outcome stands:
        # this attempt is recorded beside it (resend_outcome), never over
        # it. Written over, `accepted` became `unreachable` and the plan
        # read as a forward that never went out -- to the agent (no word
        # when it confirmed, the next wake a plain --broadcast) and to the
        # pairs rewrite -- about money the network had accepted.
        write_plan(args.outfile, plan)
        print(f"[!] re-send: no Electrum server could be reached "
              f"({sub['attempts']} tried); nothing moved")
        raise SystemExit(EXIT_FAILED)
    plan["broadcast_outcome"] = outcome
    plan["broadcast_server"] = sub["server"]
    plan["broadcast_codes"] = sub["codes"]
    plan["broadcast_attempts"] = sub["attempts"]
    plan["broadcast_mismatched"] = sub["mismatched"]
    if outcome == bcast.OUTCOME_REJECTED:
        # STALE BYTES, LIVE MONEY: every server that answered refused the
        # transaction the network once listed. Its inputs are still ours;
        # a fresh forward at today's fee is the way on, not a refusal.
        plan["broadcast"] = False
        write_plan(args.outfile, plan)
        integrity_log("forward", "resend_rejected")
        print(f"  re-send: every server that answered ({len(sub['codes'])} "
              f"of {sub['attempts']}) rejected the kept transaction (codes "
              f"{sub['codes']}); re-signing a fresh forward of the same "
              "money.")
        # ...leaving out what came back past --returns-max and what our
        # listed forwards already spend (the reconciliation handed the
        # list over with the bytes).
        return "forward", sorted(tuple(x) for x in (kept_exclude or ())), \
            "rejected"
    try:
        seen_r = bcast_seen(txid, address, servers, args.tor_proxy,
                            network=args.network, timeout=args.timeout,
                            wait_s=args.seen_wait,
                            interval_s=args.seen_interval,
                            avoid=_vouchers_not(sub), stop=shutdown_requested,
                            distrust=plan["broadcast_distrusted"])
    except watch.PinMismatch:
        seen_r = {"seen": False, "height": None, "server": None,
                  "cert_sha256": None, "polls": 0, "asked": False,
                  "pin_mismatch": True}
        integrity_log("forward", "seen_pin_mismatch")
    integrity_log("forward",
                  "broadcast_seen" if seen_r["seen"] else "broadcast_unseen")
    plan["broadcast"] = True
    plan["seen"] = bool(seen_r["seen"])
    plan["seen_height"] = seen_r["height"]
    plan["seen_server"] = seen_r["server"]
    plan["seen_asked"] = bool(seen_r["asked"])
    plan["seen_polls"] = seen_r["polls"]
    if seen_r["seen"]:
        plan["tx_hex"], plan["tx_hex_reason"] = None, None
    else:
        plan["tx_hex"] = tx_hex
        plan["tx_hex_reason"] = ("unseen" if outcome == bcast.OUTCOME_ACCEPTED
                                 else "ambiguous")
    write_plan(args.outfile, plan)
    by = f" by {sub['server']}" if sub["server"] else ""
    print(f"  re-sent: {outcome}{by} after {sub['attempts']} server(s); "
          f"attempt {plan['resends']}")
    if seen_r["seen"]:
        where = ("in the mempool" if seen_r["height"] <= 0
                 else f"in a block at height {seen_r['height']}")
        print(f"  seen: {where}, listed by {seen_r['server']}")
    else:
        print("  seen: NOT yet listed; the signed transaction is kept in "
              "the plan file")
    print(f"  plan updated: {args.outfile}")
    return "done", EXIT_OK


def build_cli():
    ap = argparse.ArgumentParser(
        description="Forward a settled BTC deposit into the ThorChain swap: "
                    "build, sign, and either print (--dry-run) or send "
                    "(--broadcast). Exactly one of the two is required.")
    ap.add_argument("--dry-run", action="store_true",
                    help="build, sign, print, write the plan; send NOTHING. "
                         "One of --dry-run / --broadcast is required so no "
                         "mode is reached by omission.")
    ap.add_argument("--broadcast", action="store_true",
                    help="after signing, hand the transaction to the "
                         "configured Electrum servers over Tor and wait to "
                         "see it listed. Money moves.")
    ap.add_argument("--reconcile", action="store_true",
                    help="a forward already went out (the plan at --outfile "
                         "says so): ask the network what became of it and "
                         "act -- confirm it is listed, re-send kept bytes, "
                         "re-sign an evicted one, forward money that came "
                         "back, or fail on a spend that is not ours. Sends "
                         "when it must; the third of three exclusive modes.")
    ap.add_argument("--quote-max-age", type=int,
                    default=DEFAULT_QUOTE_MAX_AGE_S, metavar="S",
                    help="refuse to send if this many seconds passed since "
                         f"the quote (default {DEFAULT_QUOTE_MAX_AGE_S})")
    ap.add_argument("--seen-wait", type=float,
                    default=bcast.DEFAULT_SEEN_WAIT_S, metavar="S",
                    help="after sending, how long to wait for a server to "
                         "list the transaction (default "
                         f"{bcast.DEFAULT_SEEN_WAIT_S:g})")
    ap.add_argument("--seen-interval", type=float,
                    default=bcast.DEFAULT_SEEN_INTERVAL_S, metavar="S",
                    help="how often to ask while waiting (default "
                         f"{bcast.DEFAULT_SEEN_INTERVAL_S:g})")
    ap.add_argument("--bump-after", type=int, default=DEFAULT_BUMP_AFTER_S,
                    metavar="S",
                    help="under --reconcile: a forward listed in the mempool "
                         "for at least this many seconds, at a rate under "
                         "today's estimate, is REPLACED at today's rate "
                         f"(RBF; default {DEFAULT_BUMP_AFTER_S})")
    ap.add_argument("--returns-max", type=int, default=DEFAULT_RETURNS_MAX,
                    metavar="N",
                    help="under --reconcile: how many forwards of money that "
                         "came back to the address (a refund, a second "
                         "payment) this deposit's record may hold before "
                         "the next return is NOT sent on by itself -- it "
                         "is kept on the address for the operator "
                         f"(default {DEFAULT_RETURNS_MAX}; 0 keeps the "
                         "first return)")
    ap.add_argument("--plan-only", action="store_true",
                    help="stop before signing: no seed needed. The plan "
                         "file carries the unsigned transaction. Dry run "
                         "only.")
    ap.add_argument("--tor-proxy", required=True, help="socks5h:// proxy")
    ap.add_argument("--electrum", action="append", default=[],
                    metavar="HOST[:PORT][,PIN]", required=True,
                    help="Electrum server; repeatable")
    ap.add_argument("--network", default="main")
    ap.add_argument("--xpub", default=None,
                    help="the ACCOUNT xpub the Pi watches (public). Prefer "
                         "GS_BTC_XPUB in the environment: the xpub is the "
                         "generator of EVERY deposit address this host has "
                         "minted, and /proc/<pid>/cmdline is world-readable.")
    ap.add_argument("--index", type=int, default=None,
                    help="the deposit address's index under the xpub. Prefer "
                         "GS_BTC_INDEX in the environment, for the reason "
                         "above.")
    ap.add_argument("--account", type=int, default=None, metavar="N",
                    help="which account of the seed the xpub is "
                         "(m/84'/coin'/N'; default 0). Prefer GS_BTC_ACCOUNT "
                         "in the environment. The derived account is proven "
                         "against the xpub either way.")
    ap.add_argument("--max-affiliate-bps", type=int, default=0,
                    help="the largest affiliate fee (basis points, to a "
                         "THORName) a quoted memo may carry (default 0: none)")
    ap.add_argument("--write-signed-hex", action="store_true",
                    help="also write the SIGNED transaction into the plan "
                         "file. Off by default: a signed forward is a bearer "
                         "instrument. Without it a dry run prints the hex "
                         "to stdout (the job log) and a broadcast keeps it "
                         "only while no server has listed the transaction.")
    ap.add_argument("--dest-from-receive-wallet", required=True,
                    metavar="BUNDLE",
                    help="the gs_receive_wallet_v1 bundle this deposit was "
                         "minted for: its XMR subaddress is the swap's "
                         "destination")
    ap.add_argument("--min-conf", type=int, default=2)
    ap.add_argument("--fee-target-blocks", type=int, default=3)
    ap.add_argument("--feerate-sat-vb", type=int, default=None,
                    help="use this rate instead of the server's estimate "
                         "(still subject to the band)")
    ap.add_argument("--feerate-floor", type=int, default=1)
    ap.add_argument("--feerate-ceiling", type=int, default=200)
    ap.add_argument("--op-return-max-bytes", type=int,
                    default=OP_RETURN_STD_BYTES,
                    help="this box's OP_RETURN relay policy in data bytes "
                         f"(default {OP_RETURN_STD_BYTES}, the standard)")
    ap.add_argument("--min-send-sat", type=int, default=FORWARD_MIN_SAT)
    ap.add_argument("--min-out-xmr", default="", metavar="XMR",
                    help="refuse a quote whose worst-case arrival is under "
                         "this (the mix floor); absent means no gate")
    ap.add_argument("--max-slippage", type=decimal_arg,
                    default=Decimal("0.25"))
    ap.add_argument("--thornode", default="",
                    help="THORNode base URL to cross-check the inbound "
                         "address and halt status against, over Tor")
    ap.add_argument("--timeout", type=float, default=30.0)
    ap.add_argument("--outfile", required=True)
    return ap


def main(argv=None):
    install_signal_handlers()
    args = build_cli().parse_args(argv)
    # EXACTLY ONE MODE. None is the stage-2 refusal (kept by name: an old
    # caller that passes nothing still gets it); two is a contradiction. A
    # reconciliation SENDS when it must, so it is held to the broadcast's
    # own requirements below.
    if sum(1 for m in (args.dry_run, args.broadcast, args.reconcile) if m) \
            != 1:
        raise Refused("not_dry_run", "exactly one of --dry-run, --broadcast "
                      "and --reconcile is required: no mode is reached by "
                      "omission, and a dry run cannot also send")
    if (args.broadcast or args.reconcile) and args.plan_only:
        raise Refused("bad_args", "--plan-only writes an unsigned plan; "
                      "there is nothing to broadcast or reconcile")
    if args.reconcile:
        # THE SENDING MODE'S RULES, because a reconciliation may send.
        args.broadcast = True
    if args.broadcast and (args.quote_max_age < 1 or args.seen_wait < 0
                           or args.seen_interval <= 0):
        raise Refused("bad_args", "--quote-max-age must be >= 1, "
                      "--seen-wait >= 0, --seen-interval > 0")
    # FINITE, AND IN RANGE, BEFORE ANYTHING RUNS: NaN passed every `< 0`
    # and `<= 0` above -- --seen-interval nan reached time.sleep AFTER the
    # transaction was sent (a traceback, no plan written, the bytes lost),
    # --seen-wait inf polled for ever after the send -- and a timeout of
    # 1e10 escaped the socket layer as an OverflowError.
    if not (math.isfinite(args.seen_wait) and 0 <= args.seen_wait <= 3600
            and math.isfinite(args.seen_interval)
            and 0 < args.seen_interval <= 3600):
        raise Refused("bad_args", "--seen-wait must be 0..3600 and "
                      "--seen-interval above 0, at most 3600, both finite")
    if not (math.isfinite(args.timeout)
            and 0 < args.timeout <= watch.MAX_TIMEOUT):
        raise Refused("bad_args", f"--timeout must be above 0 and at most "
                      f"{watch.MAX_TIMEOUT:g} seconds")
    # AN EXPLICIT RATE IS A RATE: 0 was read as "none given" and the
    # server's estimate paid without a word; a negative one was refused as
    # a bad ESTIMATE, blamed on the server, and written `delayed`.
    if args.feerate_sat_vb is not None and args.feerate_sat_vb < 1:
        raise Refused("bad_args", "--feerate-sat-vb must be at least 1")
    # A PLAN NAMED <stem>.json: the rotation, the chain, the status word and
    # the signed record are all named from that stem, and a name without
    # it rotated plans out of the chain -- our own forward then read as a
    # stranger's spend.
    if not str(args.outfile).endswith(".json") \
            or str(args.outfile).endswith(("/.json", ".status.json",
                                           ".signed.json")) \
            or str(args.outfile) == ".json":
        raise Refused("bad_args", "--outfile must be a <name>.json file")
    if args.bump_after < 0:
        raise Refused("bad_args", "--bump-after cannot be negative")
    if args.returns_max < 0:
        raise Refused("bad_args", "--returns-max cannot be negative")
    # MONEY DOES NOT MOVE ON THE AGGREGATOR'S WORD ALONE (STAGE5_PLAN.md
    # 3.5). The THORNode cross-check of the inbound address was optional,
    # so a sending forward could pay whatever address a compromised
    # aggregator named with the one check against that never running. A
    # rehearsal may still run without it; a broadcast may not.
    if args.thornode and not watch.thornode_url_ok(args.thornode):
        raise Refused("bad_args", "--thornode must be https://, or http:// "
                      "to a .onion: over plain http any Tor exit could answer "
                      "for THORNode, and its inbound list is the one check "
                      "against an aggregator naming its own address. Re-pair "
                      "with --thornode https://... (gs_wake_keys).")
    # (A reconciliation is held to this too: it set args.broadcast above.)
    if args.broadcast and not args.thornode:
        raise Refused("bad_args", "a run that sends (--broadcast, or "
                      "--reconcile) needs --thornode: a forward that sends "
                      "pays the inbound address the aggregator names, and "
                      "THORNode's own inbound list is the one check against "
                      "an aggregator naming its own. Pair --thornode "
                      "(gs_wake_keys) or rehearse with --dry-run.")
    # WHICH ACCOUNT OF THE SEED THE XPUB IS (STAGE5_PLAN.md 3.5): 0 unless
    # the pair was retired to a fresh chain. From the environment like the
    # xpub; absent means 0, which every pair before the field was.
    account_no = env_or_argv("GS_BTC_ACCOUNT",
                             None if args.account is None else
                             str(args.account), "the account number")
    try:
        account_no = int(str(account_no)) if account_no not in (None, "") \
            else 0
    except ValueError:
        raise Refused("bad_args", "the account number is not a whole number")
    if account_no < 0 or account_no > btx.MAX_ACCOUNT:
        raise Refused("bad_args", f"the account number must be in "
                      f"0..{btx.MAX_ACCOUNT}")
    # THE XPUB AND THE INDEX, from the environment by preference (the wake
    # agent puts them there); argv still works for a hand run, with the
    # warning env_or_argv prints. Neither present is a refusal.
    xpub = env_or_argv("GS_BTC_XPUB", args.xpub, "the account xpub")
    index = env_or_argv("GS_BTC_INDEX",
                        None if args.index is None else str(args.index),
                        "the deposit index")
    if not xpub or index is None or index == "":
        raise Refused("bad_args", "the account xpub and the deposit index "
                      "are required (GS_BTC_XPUB / GS_BTC_INDEX, or --xpub "
                      "/ --index)")
    try:
        index = int(str(index))
    except ValueError:
        raise Refused("bad_args", "the deposit index is not a whole number")
    if index < 0 or args.min_conf < 1 or args.fee_target_blocks < 1:
        raise Refused("bad_args", "index, min-conf and fee target must be "
                      "sensible")
    if not 0 <= args.max_affiliate_bps <= 1000:
        raise Refused("bad_args", "--max-affiliate-bps must be 0..1000")
    if not 1 <= args.feerate_floor <= args.feerate_ceiling:
        raise Refused("bad_args", "the fee band must be 1 <= floor <= ceiling")
    if not 1 <= args.op_return_max_bytes <= btx.MAX_OP_RETURN_DATA:
        raise Refused("bad_args", "--op-return-max-bytes must be 1..255")
    if args.min_send_sat < FORWARD_MIN_SAT:
        raise Refused("bad_args", f"--min-send-sat cannot be under "
                      f"{FORWARD_MIN_SAT} (ThorChain's BTC dust threshold)")
    min_out = None
    if args.min_out_xmr:
        min_out = finite_decimal(args.min_out_xmr)
        if min_out is None or min_out <= 0:
            raise Refused("bad_args", "--min-out-xmr is not a positive number")
    try:
        servers = [parse_server(s) for s in args.electrum]
        address = derive_receive_address(xpub, index, args.network)
    except watch.BtcWatchError as e:
        raise Refused("bad_args", str(e))
    # MONEY MOVES ONLY ON A SERVER THAT IS WHO IT SAYS (the review of
    # stages 2-6): a .onion or a pinned certificate. Over an unpinned
    # clearnet server any Tor exit can answer the fee estimate (up to the
    # ceiling, burned to miners) or forge the history that proves a
    # broadcast seen. A rehearsal may still look where it likes.
    if (args.broadcast or args.reconcile) and not all(
            watch.server_authenticated(s) for s in servers):
        raise Refused("bad_args", "a forward that sends needs every "
                      "--electrum server to be a .onion or pinned "
                      "(host:port,<sha256 of its certificate>): over an "
                      "unpinned clearnet server any Tor exit can forge the "
                      "fee estimate or the history. Re-pair (gs_wake_keys "
                      "--btc-electrum) with an onion or a pin.")
    try:
        dest_xmr = load_receive_bundle(args.dest_from_receive_wallet)["address"]
    except (ValueError, OSError) as e:
        raise Refused("bad_bundle", f"{type(e).__name__}: {e}")
    proxy = validate_proxy(args.tor_proxy)
    # On its own circuit, not the bare proxy's default one (the
    # host-privacy pass): the Tor check is the first request of every
    # forward, and it shared Tor's default circuit with any other
    # uncredentialed stream on the box.
    # THE CONSTANT-TIME BACKEND, BEFORE ANYTHING: a run that will sign
    # asks first, not in build_and_sign after the look, the quote and a
    # derivation from the seed on the variable-time curve -- the timing
    # channel the refusal exists to avoid, taken on the way to it. NOT a
    # reconciliation here: most end `done` (listed, superseded, the kept
    # bytes re-sent) and touch no seed, and refusing them left a mined
    # forward unrecorded -- the Pi asking again every window. One whose
    # verdict signs asks below, before the quote and the seed.
    if not args.plan_only and not args.reconcile:
        try:
            btx.require_native()
        except btx.BtcTxError as e:
            raise Refused("backend_refused", str(e))
    verify_tor(isolated_proxy(args.tor_proxy, "forward:verify"))
    integrity_log("forward", "start")

    # 1. what settled, and the server's fee estimate, in one session
    try:
        picture = look(address, servers, args.tor_proxy, min_conf=args.min_conf,
                       network=args.network, timeout=args.timeout,
                       fee_blocks=None if args.feerate_sat_vb else
                       args.fee_target_blocks)
    except watch.PinMismatch as e:
        raise Refused("pin_mismatch", str(e))
    except watch.BtcWatchError as e:
        integrity_log("forward", "look_failed")
        print(f"[!] could not look at the deposit address: {e}")
        raise SystemExit(EXIT_FAILED)
    if shutdown_requested():
        raise SystemExit(EXIT_FAILED)
    # THE RECONCILIATION (STAGE5_PLAN.md 3.1): a forward already went out.
    # What became of it decides everything after this point; a fresh
    # forward, when one follows, leaves out every outpoint a listed forward
    # of ours consumed and does not overwrite the earlier plan.
    exclude, why, _replaces, _prev_ins = (), None, None, None
    _round_ops = set()
    if args.reconcile:
        try:
            plan0 = _read_plan(args.outfile)
        except (OSError, ValueError):
            # NO CURRENT PLAN. A chain whose current plan was rotated aside
            # by a fresh forward that then refused (stage 5's ordering) is
            # read from its newest predecessor rather than refused for
            # ever (STAGE6_PLAN.md 1(b), 3.2); only a chain with no plan
            # anywhere is `no_plan`.
            plan0 = _recover_plan(args.outfile)
            if plan0 is None:
                raise Refused("no_plan", "--reconcile needs the plan of the "
                              "forward that went out, at --outfile")
            integrity_log("forward", "plan_recovered")
            print("  [!] no current plan at the outfile; reading the newest "
                  "rotated one (a fresh forward was refused after the "
                  "rotation)")
        verdict = reconcile(args, plan0, picture, address, index, servers,
                            dest_xmr)
        if verdict[0] == "resend":
            verdict = resend(args, plan0, verdict[1], address, servers,
                             kept_exclude=(verdict[2] if len(verdict) > 2
                                           else ()))
        if verdict[0] == "done":
            return verdict[1]
        # THIS RECONCILIATION SIGNS: the backend now, before the quote and
        # before the seed is taken (see the gate above).
        try:
            btx.require_native()
        except btx.BtcTxError as e:
            raise Refused("backend_refused", str(e))
        _, exclude, why = verdict[:3]
        exclude = [tuple(x) for x in exclude]
        integrity_log("forward", f"reconcile_{why}")
        # WHICH OUTPUTS ON THE ADDRESS ARE A ROUND OF RETURNED MONEY, for
        # the bound (round_outpoints): the refunds the reconciliation
        # recorded on the plan this run (in memory, whether or not it
        # wrote it) and the sizes of every forward on the chain. Counted
        # into the new plan below (carried_refunds).
        _round_ops = round_outpoints(picture.get("utxos"),
                                     plan0.get("refunds"),
                                     [plan0] + _chain_plans(args.outfile))
        if why in ("evicted", "rejected"):
            # THE INPUTS THE RE-SIGN IS FOR: anything else it carries came
            # back meanwhile (carried_returned), and the bound counts the
            # rounds among it (carried_refunds).
            _prev_ins = _outpoints(plan0.get("inputs"))
        if why == "bumped":
            # THE REPLACEMENT SPENDS WHAT THE STUCK TRANSACTION SPENDS
            # (stage 6, STAGE6_PLAN.md 3.1): that plan's inputs join the
            # picture as settled money that MUST be spent, and the run's
            # floor rises to what a node holding the original will take
            # in its place -- and any node holding another forward of ours
            # over the same outpoints (replacement_floor). The stuck plan
            # is the current one or a rotated predecessor (stuck_forward);
            # either way the new plan names it in `replaces` and the
            # current plan is rotated aside when the new one is written.
            plan_b, _conflicts = verdict[3], verdict[4]
            _replaces = str(plan_b.get("txid") or "").lower()
            _prev_ins = _outpoints(plan_b.get("inputs"))
            with_plan_inputs(picture, plan_b, args.min_conf)
            args.feerate_floor = replacement_floor(
                plan_b, _conflicts, args.op_return_max_bytes,
                args.feerate_floor)
            if args.feerate_floor > args.feerate_ceiling:
                # The original already pays what this box allows; more
                # would be over the ceiling. It stands, and the Pi asks
                # again after the fee window.
                write_status(args.outfile, STATUS_DELAYED)
                raise Refused("bump_over_ceiling",
                              "replacing the forward would have to pay "
                              f"over the {args.feerate_ceiling} sat/vB "
                              "ceiling this box accepts; the original "
                              "stands")
        # THE OLD PLAN IS NOT ROTATED HERE. It stays the current plan until
        # the fresh forward below has a plan to write (see write_plan at
        # the end): every refusal between here and there -- a fee over the
        # ceiling (`delayed`), a quote that fails, a memo that will not fit
        # -- used to leave the chain with no current plan, and the next
        # run refused `no_plan` about a forward whose record sat one file
        # over (STAGE6_PLAN.md 1(b)).
    if picture["settled_sat"] <= 0:
        # NOTHING UNSPENT AT ALL: was it ever paid, and where did it go? A
        # forward that went out and died before its plan was written is
        # found here and reconstructed (stage 5); a spend this tool did
        # not sign fails the run; a never-paid address falls through.
        if picture["state"] == watch.STATE_NOT_SEEN:
            found = reconcile_emptied(address, index, servers, args.tor_proxy,
                                      args.network, args.timeout, dest_xmr,
                                      args.outfile, picture["tip"])
            if found is not None:
                return found
        # WHAT WAS SEEN, FOR THE PHONE. A forward that found nothing settled
        # is not a failed machine; it is "not yet" or "still confirming",
        # and the wake agent maps this one word onto the phase vocabulary
        # (STAGE4_PLAN.md 3.6). One word, no amount, no depth.
        write_status(args.outfile, picture["state"])
        raise Refused("nothing_settled",
                      f"nothing is settled at this address to {args.min_conf} "
                      "confirmations; ask again later")

    # 2. the fee, sized against the largest transaction the policy allows,
    #    over the inputs worth spending at that rate -- TODAY'S RATE as this
    #    run decided it (todays_rate), the same number the bump read.
    try:
        rate = fee_band(todays_rate(args, picture), args.feerate_floor,
                        args.feerate_ceiling)
        chosen, skipped_dust, unsettled, left_over = spendable(
            picture["utxos"], args.min_conf, rate, exclude,
            args.op_return_max_bytes, args.min_send_sat)
        if chosen and not standard_fits(len(chosen),
                                        args.op_return_max_bytes):
            raise Refused("forward_too_large",
                          "the forward being replaced spends more outputs "
                          "than one standard transaction can carry")
        if not chosen:
            raise Refused("nothing_economic",
                          "what is settled here is all dust at this fee "
                          "rate: each output would cost more to spend than "
                          "it carries")
        settled_sat = sum(u["value"] for u in chosen)
        n_inputs = len(chosen)
        vsize_bound, fee_sat = size_the_fee(n_inputs,
                                            args.op_return_max_bytes, rate)
        # ...PLUS 0..bound-1 sat (FEE_JITTER), so the fee is not the bound
        # times anything -- and never a satoshi the deposit cannot bear:
        # capped by the room above the smallest forward and under the
        # fee fraction, so at the exact floor there is no jitter rather
        # than a refusal the floor said could not happen.
        _room = min(settled_sat - fee_sat - int(args.min_send_sat),
                    int(settled_sat * MAX_FEE_FRACTION) - fee_sat)
        # DRAWN OVER THE ROOM THERE IS, not drawn over the bound and then
        # clamped (the review of stages 2-6): with less room than a bound,
        # every draw past it landed ON the cap -- the fee exactly
        # bound x rate, or exactly a fifth of the inputs, or the send
        # exactly the minimum, on most runs near the floor. Uniform over
        # what is allowed, the cap is one value among the rest. The clamp
        # stays for a jitter that ignores its argument.
        _w = max(1, min(int(vsize_bound), int(_room) + 1))
        _jit = max(0, min(int(FEE_JITTER(_w)), _room))
        fee_sat += _jit
        send_sat = amount_to_send(settled_sat, fee_sat, args.min_send_sat)
    except Refused as e:
        # A REFUSAL ABOUT TODAY'S FEE IS A WORD, NOT A DEAD END (STAGE5_PLAN.md
        # 3.2): `delayed`, `seen` or `short`, decided by fee_word over every
        # rate this pair allows and over the money a forward at each rate
        # would spend. Three earlier forms of this line were each wrong in
        # a way a real address reaches: the look's settled_sat counted
        # dust and the outpoints a listed forward of ours already spent
        # (`delayed` for money no forward carries); the chosen sum against
        # the ONE-INPUT floor let a hundred small outputs read `delayed`
        # while their hundred-input fee ate more than a fifth at every
        # rate; and both said `short` -- "stopped growing", after which
        # the Pi never starts it again by itself -- about a whole payment
        # one confirmation short of min_conf.
        if e.kind in DELAY_KINDS:
            _word = fee_word(
                picture["utxos"], args.min_conf, args.feerate_floor,
                args.feerate_ceiling, exclude, args.op_return_max_bytes,
                args.min_send_sat, replacing=(why == "bumped"))
            # MONEY BACK AND STILL CONFIRMING, beside settled money too
            # small to forward on its own: the state returned_unsettled
            # names, so the same word. `seen` there was dropped by the
            # agent over the moved plan, and the phone heard "the forward
            # has confirmed. Nothing more to check" -- whether a stranger's
            # dust had also settled on the spent address decided between
            # that and `returned`.
            if _word == watch.STATE_SEEN and why == "returned":
                _word = STATUS_RETURNED
            # ...AND RETURNED MONEY NO RATE CAN CARRY is `leftover`, not the
            # fresh deposit's `short`: the forward went out, and what came
            # back since is what stays.
            elif _word == STATUS_SHORT and why == "returned":
                _word = STATUS_LEFTOVER
                # ...AND WHICH OUTPUTS STAY, recorded on the current plan as
                # a kept return's are: the client heard "it stays there.
                # Check.", and the operator who then moved them by hand was
                # read as a leaked seed -- `foreign_spend` on every later
                # run, so no refund or payment to the deposit ever went
                # through again. Everything unspent that no forward of ours
                # spends, dust included (a hand move takes what is there).
                _left = sorted({(str(u["tx_hash"]).lower(), int(u["vout"]))
                                for u in picture["utxos"]}
                               - {(str(t).lower(), int(v))
                                  for t, v in exclude})
                if _left and isinstance(plan0, dict):
                    plan0["returned_leftover"] = {
                        "outpoints": [list(o) for o in _left]}
                    # NOT IN PLACE OF THE WORD: a plan that cannot be
                    # written must not turn this refusal into a crash with
                    # no status. The next run answers `leftover` again and
                    # writes it then.
                    try:
                        write_plan(args.outfile, plan0)
                    except OSError:
                        integrity_log("forward", "leftover_unrecorded")
            write_status(args.outfile, _word)
        raise

    # 3. the quote, for exactly that amount, to exactly this destination
    oracle = btc_per_xmr_oracle(isolated_proxy(args.tor_proxy,
                                               "forward:oracle"),
                                getter=safe_get)
    # ...MEASURED AGAINST A PRICE THAT IS NOT THE AGGREGATOR'S (the stage 2
    # read). A run that may SEND takes one or waits: with the oracle out of
    # reach the aggregator's figure alone set the memo's output limit, so
    # whoever answers as the aggregator chose how little the swap may
    # deliver. ThorChain's own pools, on the THORNode a sending run must
    # name, are the second reference (thornode_pool_rate); with neither,
    # nothing is quoted or signed, and the Pi tries again later (`delayed`).
    # A rehearsal still runs and says it was not cross-checked.
    pool_rate = None
    try:
        if args.thornode:
            pool_rate = thornode_pool_rate(args.thornode, args.tor_proxy)
    except Refused:
        write_status(args.outfile, STATUS_DELAYED)
        raise
    if (args.broadcast or args.reconcile) and oracle is None \
            and pool_rate is None:
        integrity_log("forward", "no_price_reference")
        write_status(args.outfile, STATUS_DELAYED)
        raise Refused("no_price_reference",
                      "neither the price oracle nor ThorChain's own pools "
                      "could be read, so the quote could not be measured "
                      "against any price but its own; nothing was quoted or "
                      "signed, and it is tried again later")
    inbound, memo, expected = fetch_quote(send_sat, dest_xmr, args.tor_proxy)
    quoted_at = _clock()                   # the clock the broadcast reads
    inbound_spk = validate_inbound(inbound, args.network)
    memo_quoted = validate_memo(memo, dest_xmr)
    expected_xmr, worst_xmr = validate_expected(
        expected, send_sat, min_out, args.max_slippage, oracle,
        pool_rate=pool_rate)
    memo_text, memo_limit, affiliate_bps, limit_set = enforce_memo_terms(
        memo_quoted, expected_xmr, worst_xmr, args.max_affiliate_bps)
    memo_b = fit_memo(memo_text, dest_xmr, args.op_return_max_bytes)

    # 4. THORNode's word on the inbound, when the operator named a node
    cross_checked, outbound_fee = False, None
    lock_tip = picture["tip"]
    if args.thornode:
        dust, outbound_fee = cross_check_inbound(
            inbound, args.thornode, args.tor_proxy,
            entries=_thor_entries_or_refuse(args))
        cross_checked = True
        # ...AND ON THE HEIGHT nLockTime CARRIES (thornode_btc_height): the
        # lower of the look's tip and ThorChain's last observed block.
        _th = thornode_btc_height(args.thornode, args.tor_proxy)
        if _th is not None and _th < lock_tip:
            if lock_tip - _th > 6:
                integrity_log("forward", "tip_ahead_of_thornode")
            lock_tip = _th
        if dust is not None and send_sat < dust:
            if send_sat + _jit >= dust:
                # ONLY THE FEE'S JITTER PUT IT UNDER (self-doubt over the
                # fix pass): the room the jitter was given knew the floor
                # and the fee fraction, not a live dust threshold above
                # the floor, so a send within one bound of it was signed
                # on some draws and refused on others. Deterministic now:
                # the jitter gives back what the threshold needs. The
                # quote stands (it was for a little less; more arrives).
                # ...AND NOT EXACTLY ON THE THRESHOLD: a send equal to
                # THORNode's published dust figure is a value anyone can
                # test for. What the jitter has left over it is drawn.
                _give = dust - send_sat
                _spare = _jit - _give
                _more = (max(0, min(int(FEE_JITTER(_spare + 1)), _spare))
                         if _spare > 0 else 0)
                fee_sat -= _give + _more
                send_sat += _give + _more
            else:
                raise Refused("below_thor_dust",
                              "ThorChain's live dust threshold is above what "
                              "this forward would carry; it would be ignored")
    integrity_log("forward", "quoted")

    # 5-6. build, and sign unless plan-only
    account = None
    if not args.plan_only:
        words, passphrase = take_seed()
        account = account_for(words, passphrase, args.network, xpub,
                              account_no=account_no)
        del words
    # A TRANSACTION THE SIGNER WILL NOT BUILD IS A REFUSAL, NOT A TRACEBACK
    # (the MED pass after the deep read): a server that repeated an
    # outpoint, or named a tip nLockTime reads as a date, reached the signer
    # as an input twice or a locktime out of range, and its own refusal
    # escaped main as an uncaught exception -- exit 1, no kind on the chain,
    # no word for the agent, and the same server leading every retry. The
    # watch side now drops the repeat and refuses the tip; this is the
    # backstop for whatever else the signer declines.
    try:
        tx, txid, vsize, real_rate, signed = build_and_sign(
            chosen, lock_tip, inbound_spk, send_sat, fee_sat, memo_b,
            account, index, address, args.network, sign=not args.plan_only)
    except btx.BtcTxError as e:
        raise Refused("build_failed",
                      f"the transaction could not be built or signed "
                      f"({e}); nothing moved")
    if signed and real_rate < args.feerate_floor:
        raise Refused("fee_out_of_band", "the signed transaction's real "
                      "rate fell under the floor")
    integrity_log("forward", "signed" if signed else "planned")

    # 7. THE BROADCAST, and only with --broadcast: after every guard above,
    #    from the bytes in memory, never from a file. See the header.
    outcome, sub, seen_r = None, None, None
    if args.broadcast:
        age = _clock() - quoted_at
        if age > args.quote_max_age:
            raise Refused("quote_stale",
                          f"{int(age)} s passed since the quote, over the "
                          f"{args.quote_max_age} s this box allows between "
                          "quoting and sending; nothing was sent")
        stop_before_send("sending")
        # ON DISK BEFORE THE BYTES LEAVE: the one mark that tells this
        # forward, found on the chain with no plan, from a copy of its memo
        # (SIGNED_SCHEMA says why).
        record_signed(args.outfile, txid, quote={
            "expected_xmr": str(expected_xmr),
            "worst_case_xmr": str(worst_xmr),
            "memo_limit_base_units": memo_limit,
            "outbound_fee_sat": outbound_fee})
        integrity_log("forward", "sending")
        try:
            sub = bcast_submit(tx.serialize().hex(), txid, address, servers,
                               args.tor_proxy, network=args.network,
                               timeout=args.timeout, stop=shutdown_requested)
        except watch.PinMismatch:
            raise Refused("pin_mismatch",
                          "a pinned Electrum server presented another "
                          "certificate while sending; nothing was sent")
        except watch.BtcWatchError as e:
            raise Refused("bad_args", str(e))
        outcome = sub["outcome"]
        if sub.get("stopped") and outcome not in bcast.MAYBE_MOVED:
            # A STOP CUT THE LIST SHORT and nothing left (submit's
            # `stopped`): one relay-policy "no" and the stop read "every
            # server that answered rejected it ... the server list needs
            # one that relays it", with servers never tried; a stop before
            # the first read "no Electrum server could be reached (0
            # tried)". Neither is the network's word. Nothing was sent, as
            # when the stop lands a moment earlier (stop_before_send).
            integrity_log("forward", "stopped_during_send")
            _cd = f"; codes {sub['codes']}" if sub["codes"] else ""
            print(f"[!] a stop was asked while sending; nothing moved "
                  f"({sub['attempts']} of {len(servers)} server(s) "
                  f"tried{_cd})")
            raise SystemExit(EXIT_FAILED)
        integrity_log("forward", f"broadcast_{outcome}")
        if sub.get("pin_mismatch"):
            integrity_log("forward", "send_pin_mismatch")
        if sub["mismatched"]:
            integrity_log("forward", "txid_mismatch")
        if outcome == bcast.OUTCOME_REJECTED:
            raise Refused("broadcast_rejected",
                          f"every Electrum server that answered "
                          f"({len(sub['codes'])} of {sub['attempts']}) "
                          f"rejected the transaction (codes {sub['codes']}); "
                          "nothing moved. The common cause: a node with the "
                          "standard OP_RETURN relay policy refuses a swap "
                          "memo, and the server list needs one that relays "
                          "it (STAGE3_PLAN.md 3.3); the codes say which")
        if outcome == bcast.OUTCOME_UNREACHABLE:
            print(f"[!] no Electrum server could be reached to send "
                  f"({sub['attempts']} tried); nothing moved")
            raise SystemExit(EXIT_FAILED)
        # ACCEPTED OR AMBIGUOUS: the money may have moved. Look for it.
        try:
            # A STOP ENDS THE WAIT, not the run: what the polls learned so
            # far is kept, and the plan below -- with the bytes kept as
            # unseen -- is written instead of the child being killed
            # mid-wait with nothing on disk. Best effort, not a bound: a
            # connection already in flight when the stop lands can take up
            # to --timeout, longer than the agent's ten-second grace.
            seen_r = bcast_seen(txid, address, servers, args.tor_proxy,
                                network=args.network, timeout=args.timeout,
                                wait_s=args.seen_wait,
                                interval_s=args.seen_interval,
                                avoid=_vouchers_not(sub), stop=shutdown_requested,
                                distrust=_distrusted(sub))
        except watch.PinMismatch:
            seen_r = {"seen": False, "height": None, "server": None,
                      "cert_sha256": None, "polls": 0, "asked": False,
                      "pin_mismatch": True}
            integrity_log("forward", "seen_pin_mismatch")
        integrity_log("forward",
                      "broadcast_seen" if seen_r["seen"] else "broadcast_unseen")

    # 8. the plan file and the summary
    moved = outcome in bcast.MAYBE_MOVED
    # THE SIGNED BYTES ARE KEPT ONLY WHERE NOTHING ELSE HOLDS THEM: an
    # unsigned plan carries no power; --write-signed-hex is the caller's
    # decision; and a broadcast the network has not shown is kept so the
    # transaction is not lost (stage 5 consumes it). A dry run keeps them
    # nowhere but the job log; a seen broadcast keeps them nowhere at all.
    if not signed:
        hex_reason = "unsigned"
    elif args.write_signed_hex:
        hex_reason = "write_signed_hex"
    elif moved and not seen_r["seen"]:
        hex_reason = "unseen" if outcome == bcast.OUTCOME_ACCEPTED \
            else "ambiguous"
    else:
        hex_reason = None
    plan = {
        "schema": PLAN_SCHEMA,
        "network": args.network,
        "dry_run": not args.broadcast,
        "broadcast": moved,                      # True: the money may have moved
        "broadcast_outcome": outcome,            # the four words, or None
        "broadcast_server": sub["server"] if sub else None,
        "broadcast_codes": sub["codes"] if sub else [],
        "broadcast_attempts": sub["attempts"] if sub else 0,
        "broadcast_mismatched": sub["mismatched"] if sub else 0,
        # WHO IS NO WITNESS FOR THIS FORWARD (_distrusted): read by the
        # next run's reconciliation before it drops kept bytes.
        "broadcast_distrusted": _distrusted(sub),
        "seen": bool(seen_r and seen_r["seen"]),
        "seen_height": seen_r["height"] if seen_r else None,
        "seen_server": seen_r["server"] if seen_r else None,
        "seen_asked": bool(seen_r and seen_r["asked"]),
        "seen_polls": seen_r["polls"] if seen_r else 0,
        "signed": signed,
        "index": index,
        "address": address,
        "inputs": [{"tx_hash": u["tx_hash"], "vout": u["vout"],
                    "value": u["value"], "confirmations": u["confirmations"]}
                   for u in chosen],
        "skipped_dust": skipped_dust,
        "left_over": left_over,
        "unsettled_outputs": unsettled,
        "tip": picture["tip"],
        "inbound": inbound,
        "inbound_cross_checked": cross_checked,
        # WHAT A REFUND OF THIS FORWARD LACKS: ThorChain's outbound fee for
        # BTC from the node's inbound entry, in sat (None without a node or
        # without the field). classify_returns judges FULL on the refund
        # plus this, and the vault scales a partly filled swap's quote by
        # the two together.
        "outbound_fee_sat": outbound_fee,
        "memo": memo_text,                       # as laid out in the OP_RETURN
        "memo_quoted": memo_quoted,              # as the aggregator returned it
        "memo_limit_set": limit_set,             # True: the floor was written in
        "memo_bytes": len(memo_b),
        "op_return_max_bytes": args.op_return_max_bytes,
        "settled_sat": settled_sat,
        "send_sat": send_sat,
        "fee_sat": fee_sat,
        "feerate_target_sat_vb": rate,
        "vsize_bound": vsize_bound,
        "vsize": vsize,
        "feerate_real_sat_vb": real_rate,
        "expected_xmr": str(expected_xmr),
        "worst_case_xmr": str(worst_xmr),
        "memo_limit_base_units": memo_limit,
        "affiliate_bps": affiliate_bps,
        "dest_xmr": dest_xmr,
        "txid": txid,
        "tx_hex": tx.serialize().hex() if hex_reason else None,
        "tx_hex_reason": hex_reason,
        "signed_hex_written": bool(signed and hex_reason),
        "server": picture.get("server"),
        "cert_sha256": picture.get("cert_sha256"),
        "ts": int(time.time()) // 600 * 600,
        # A RECONCILIATION'S FRESH FORWARD says why it exists and what it
        # left out; a first forward says neither.
        "reconcile_reason": why,
        "excluded_outpoints": len(exclude),
        "resends": 0,
        # THE TRANSACTION THIS ONE REPLACES (a bump, stage 6), or None. The
        # pairs rewrite counts a replaced plan and its replacement as ONE
        # swap; the reconciliation marks whichever the network did not
        # take as superseded.
        "replaces": _replaces,
        # HOW MANY OF THIS FORWARD'S INPUTS CAME BACK MEANWHILE (a bump, an
        # evicted or rejected re-sign built while returned money sat
        # settled), for the operator's reading and for a reader of plans
        # from before the field below. None for a first forward and for a
        # plan whose reason already says so.
        "carried_returned": (
            sum(1 for u in chosen
                if (str(u["tx_hash"]).lower(), int(u["vout"]))
                not in _prev_ins)
            if _prev_ins is not None else None),
        # ...AND HOW MANY OF THOSE ARE A ROUND OF RETURNED MONEY (the MED
        # pass after the deep read; round_outpoints): a verified ThorChain
        # refund, or an output the size of one. THIS is what the bound
        # counts (_carried_returned): a `returned` forward of honest
        # top-ups alone carries none and is not a round. None for a first
        # forward.
        "carried_refunds": (
            sum(1 for u in chosen
                if (str(u["tx_hash"]).lower(), int(u["vout"])) in _round_ops
                and (str(u["tx_hash"]).lower(), int(u["vout"]))
                not in (_prev_ins or set()))
            if why else None),
    }
    if why:
        # THE KEPT MARK TRAVELS WITH THE CURRENT PLAN (self-doubt over the
        # fix): a fresh forward AT the bound -- a bump, a re-sign -- leaves
        # the kept money out, and the plan it rotates aside was the only
        # one that named it. The agent reads the word `kept` off the
        # CURRENT plan alone, so the client heard `sent` about money that
        # sat on the address until the next reconciliation marked it
        # again. Carried only when none of it rides in this forward: an
        # output this forward spends is not kept, it is being moved.
        _mk = plan0.get("returned_kept") if isinstance(plan0, dict) else None
        if isinstance(_mk, dict) and _pairs(_mk.get("outpoints")) \
                and not (_pairs(_mk.get("outpoints"))
                         & {(str(u["tx_hash"]).lower(), int(u["vout"]))
                            for u in chosen}):
            plan["returned_kept"] = _mk
        # A RECONCILIATION'S FRESH FORWARD ROTATES THE OLD PLAN ASIDE NOW,
        # with a plan in hand to take its place; the chain is the record of
        # every forward the deposit had, and it never lacks a current one.
        _rotate_plan(args.outfile)
    write_plan(args.outfile, plan)
    if not args.broadcast:
        integrity_log("forward", "not_broadcast")
        print(f"  forward {'SIGNED' if signed else 'PLANNED (unsigned)'}, "
              f"NOT BROADCAST (dry run)")
    else:
        by = f" by {sub['server']}" if sub["server"] else ""
        rej = (f", {len(sub['codes'])} rejection(s) (codes {sub['codes']})"
               if sub["codes"] else "")
        mis = (f", {sub['mismatched']} foreign txid reply(ies)"
               if sub["mismatched"] else "")
        print(f"  forward SIGNED and SENT: {outcome}{by} after "
              f"{sub['attempts']} server(s){rej}{mis}")
        if outcome == bcast.OUTCOME_AMBIGUOUS:
            print("  [!] AMBIGUOUS: the bytes left for a server and no "
                  "acceptance came back. The transaction MAY be in the "
                  "network.")
        if seen_r["seen"]:
            where = ("in the mempool" if seen_r["height"] <= 0
                     else f"in a block at height {seen_r['height']}")
            print(f"  seen: {where}, listed by {seen_r['server']} after "
                  f"{seen_r['polls']} poll(s)")
        elif seen_r["asked"]:
            print(f"  seen: NOT yet listed by any server asked "
                  f"({seen_r['polls']} poll(s) over {args.seen_wait:g} s)")
        else:
            print("  seen: UNKNOWN -- no server could be asked"
                  + (" (a pinned server presented another certificate)"
                     if seen_r.get("pin_mismatch") else ""))
        if hex_reason in ("unseen", "ambiguous"):
            print("  [!] the signed transaction is KEPT in the plan file "
                  f"({hex_reason}): the network has not shown it yet, and "
                  "losing it would lose the forward. It is a bearer "
                  "instrument until it confirms.")
    _left = (f", {left_over} left on the address (past a standard size, "
             f"or not worth the fee's share)" if left_over else "")
    print(f"  from {scrub_address(address)} index {index}: "
          f"{settled_sat} sat in {n_inputs} spendable output(s)"
          f"{f', {skipped_dust} dust left' if skipped_dust else ''}"
          f"{_left}"
          f"{f', {unsettled} not yet settled' if unsettled else ''}")
    print(f"  to   {scrub_address(inbound)}"
          f"{' (THORNode-verified)' if cross_checked else ''}: "
          f"{send_sat} sat, fee {fee_sat} sat at {rate} sat/vB "
          f"(bound {vsize_bound} vB"
          f"{f', real {vsize} vB at {real_rate} sat/vB' if signed else ''})")
    whose = ("SET by this tool; the quote's was absent, zero or lower"
             if limit_set else "the quote's own")
    print(f"  memo {len(memo_b)} bytes (policy {args.op_return_max_bytes}); "
          f"expected about {expected_xmr} XMR, worst case {worst_xmr}; "
          f"chain limit {memo_limit} base units ({whose}), "
          f"affiliate {affiliate_bps} bps")
    print(f"  txid {txid}")
    if signed and not args.broadcast and not args.write_signed_hex:
        # To the job log, which the agent keeps at 0600 and truncates each
        # boot; not to the plan file. See --write-signed-hex.
        print(f"  signed hex (dry run: NOT broadcast, not persisted): "
              f"{tx.serialize().hex()}")
    print(f"  plan written: {args.outfile}")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
