detectTor(true).then(found=>{ if(!found) runPreflight(); });
$('#rpc_daemon').addEventListener('change',loadFees);
</script></body></html>"""


def main():
    ap = argparse.ArgumentParser(description="GhostSpiral operator console")
    ap.add_argument("--port", type=int, default=8765)
    ap.add_argument("--job-timeout", type=int, default=JOB_TIMEOUT_FLOOR_S,
                    metavar="SECONDS",
                    help=f"kill a job after this long (default {JOB_TIMEOUT_FLOOR_S}s "
                         f"= the swap-arrival wait + fan-out confirm + one maximum "
                         f"--hop-delay). Raise it if you schedule several hops at "
                         f"multi-day delays; a job that is still running is usually "
                         f"one that is waiting on money, and stopping it strands funds.")
    a = ap.parse_args()
    global JOB_TIMEOUT_S
    JOB_TIMEOUT_S = max(1, int(a.job_timeout))
    if JOB_TIMEOUT_S < JOB_TIMEOUT_FLOOR_S:
        # Not refused -- an operator running short jobs may genuinely want a
        # tighter bound -- but never silent, because the number that used to be
        # here killed live runs at four hours.
        print(f"  [!] --job-timeout {JOB_TIMEOUT_S}s is BELOW the "
              f"{JOB_TIMEOUT_FLOOR_S}s a full pipeline can legitimately take "
              f"(swap arrival + fan-out confirm + one max hop delay).")
        print( "      A run stopped part-way leaves funds mid-pipeline. The stop "
               "button is always available.")
    srv = ThreadingHTTPServer(("127.0.0.1", a.port), H)      # loopback ONLY
    print(f"  GhostSpiral console → http://127.0.0.1:{a.port}/?t={TOKEN}")
    print( "  ^ open THIS url — the token is required, and it changes every run")
    print(f"  {len(ACTIONS)} actions · funds require the arm phrase '{ARM_PHRASE}'")
    print(f"  wallet password: {'from GS_WALLET_PASSWORD' if os.environ.get('GS_WALLET_PASSWORD') else 'not set'}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n  stopped")


if __name__ == "__main__":
    main()
