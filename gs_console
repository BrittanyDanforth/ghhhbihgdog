.act.spends{border-color:var(--err);grid-column:1/-1}
.act.spends .go{background:var(--errs);color:var(--err)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--line2);flex:none}
.dot.run{background:var(--warn);box-shadow:0 0 0 3px var(--warns);animation:p 1s infinite}
.dot.ok{background:var(--ok);box-shadow:0 0 0 3px var(--oks)}
.dot.err{background:var(--err);box-shadow:0 0 0 3px var(--errs)}
@keyframes p{50%{opacity:.35}}
@media(prefers-reduced-motion:reduce){.dot.run{animation:none}}
pre.prev{margin:0;background:var(--term);color:var(--ti);padding:11px 13px;border-radius:8px;
font-family:ui-monospace,Menlo,monospace;font-size:11.5px;line-height:1.6;white-space:pre-wrap;word-break:break-all;max-height:150px;overflow:auto}
.probs{margin:9px 0 0;padding:0;list-style:none}
.probs li{font-size:12px;color:var(--err);background:var(--errs);padding:6px 9px;border-radius:6px;margin-bottom:4px}
.pfbox{margin-top:11px;border:1px solid var(--line);border-radius:9px;overflow:hidden;font-size:12px}
.pfhead{padding:8px 11px;font-weight:600;font-size:12px}
.pfhead.ok{background:var(--oks);color:var(--ok)}
.pfhead.bad{background:var(--errs);color:var(--err)}
.pfhead.run{background:var(--warns);color:var(--warn)}
.pfrow{display:flex;justify-content:space-between;gap:10px;padding:6px 11px;border-top:1px solid var(--line);align-items:baseline}
.pfrow.ok span:first-child{color:var(--ok)}
.pfrow.bad span:first-child{color:var(--err);font-weight:600}
.pfrow .pfd{color:var(--mut);font-size:11px;font-family:ui-monospace,Menlo,monospace;text-align:right;max-width:62%;word-break:break-word}
.pfbtns{display:flex;gap:14px;margin-top:8px}
.pfre{font-size:11.5px;color:var(--acc);background:none;border:0;cursor:pointer;padding:0;font:inherit;text-decoration:underline}
.pfre:disabled{color:var(--mut);cursor:default;text-decoration:none}
.arm{margin-top:11px;padding:11px;border:1px dashed var(--err);border-radius:9px;background:var(--errs)}
