      preflight (step 4) must pass — it is re-verified on the server when you run, so it cannot be
      skipped. Type <strong id="armword"></strong> to arm.</p>
      <input id="arm" placeholder="type to arm" autocomplete="off">
    </div>
    <div class="stepacts" data-acts="run_pipeline" style="margin-top:12px"></div>
    <details class="adv"><summary>Developer tools (tests &amp; wipe preview)</summary>
      <div class="stepacts" data-acts="units,integration,ipleak,leakaudit,compile" style="margin-top:10px"></div>
    </details>
    <div class="stepnav"><button class="bk" data-go="4">← Back</button><span></span></div>
  </section>
</main>
<div class="rightcol">
  <div class="panel">
    <div class="pbar"><span class="pt" id="pt">Nothing running</span>
      <span class="pill" id="ppill" style="display:none"></span><span class="pm" id="pm"></span>
      <span class="pacts"><button id="stop" class="stop">Stop</button><button id="copy">Copy</button></span></div>
    <div id="out"><div class="idle">Live fire output. Weapons stay holstered until you arm.</div></div>
  </div>
</div>
</div><script>
const A=__ACTIONS__, ARM=__ARM__, PWSET=__PWSET__, TOK=__TOKEN__;
const HDR={'Content-Type':'application/json','X-GS-Token':TOK};
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
let cur=null,timer=null,mode='send',preset='balanced',armed=false;

const PRESETS={
 paranoid:{wallets:10,deep:2,dag_mixing:true,peel:true,fee_priority:3,clearnet:false,
      note:'MAXIMUM SAFETY — the two strongest layers COMBINED. First a PEELING CHAIN: ~10 destinations plus a few decoys are each sent as their OWN transaction, spending the previous change, so nothing is ever co-created in a fan-out an analyst could cluster. THEN a DAG hop round mixes those outputs a second time. Clearnet relay forced OFF, highest priority. By far the SLOWEST — every peel AND every hop waits ~10 blocks, so many hours. Use for high-value sends where time is no object.'},
 peel:{wallets:8,deep:1,dag_mixing:false,peel:true,fee_priority:2,clearnet:false,
      note:'PEELING CHAIN ONLY (no second DAG round). ~8 destinations plus decoys are sent ONE TRANSACTION AT A TIME, each spending the previous change — no co-created fan-out. Strong graph unlinkability and faster than Maximum safe (one round, not two), but without the extra hop layer. Every peel waits ~10 blocks (~hours).'},
 churn:{wallets:20,deep:6,dag_mixing:true,fee_priority:2,clearnet:false,
      note:'DEEP CHURN. 20 subaddresses at maximum depth 6 — the longest hop chains, so the funds cross the most intermediate outputs before they settle. Emphasises trail length over breadth; slowest to finish.'},
 max:{wallets:25,deep:3,dag_mixing:true,fee_priority:3,clearnet:false,
      note:'25 subaddresses, depth 3, DAG hops on, priority 3, clearnet relay off. Wide anonymity set.'},
 balanced:{wallets:12,deep:2,dag_mixing:true,fee_priority:2,clearnet:false,
      note:'12 subaddresses, depth 2, DAG hops on, priority 2, clearnet relay off. Sensible default for most amounts.'},
 lowfee:{wallets:8,deep:2,dag_mixing:true,fee_priority:1,clearnet:false,
      note:'8 subaddresses, depth 2, DAG hops on, priority 1 (cheapest fees). Real mixing on a budget — fewer hops means lower total fees, worth it for smaller amounts where fees would otherwise eat the balance.'},
 fast:{wallets:3,deep:1,dag_mixing:false,fee_priority:1,clearnet:false,
      note:'3 subaddresses, depth 1, no DAG round, priority 1. Fan-out only — least mixing, cheapest, no confirmation wait. Weakest privacy.'}};

function applyPreset(p){
 preset=p; const c=PRESETS[p];
 $('#wallets').value=c.wallets; $('#deep').value=c.deep;
 $('#dag_mixing').checked=c.dag_mixing; setFee(c.fee_priority);
 // peel defaults OFF unless the preset asks for it, so switching away from the
 // peel preset clears it rather than silently leaving the slow mode on.
 $('#peel').checked=!!c.peel;
 // Every preset leaves clearnet relay OFF — a preset should never quietly
 // widen the IP exposure, and turning it on is a deliberate per-run override.
 if('clearnet' in c) $('#allow_clearnet_relay').checked=c.clearnet;
 $('#preset-note').textContent=c.note;
 $$('#presets button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.p===p)));
 sync();
}
$$('#presets button').forEach(b=>b.addEventListener('click',()=>applyPreset(b.dataset.p)));

let feePriority=2, feeData=null;
function renderFees(){
 const names=['1 · default','2 · elevated','3 · priority','4 · flash'];
 // feeData.xmr is null whenever the daemon could not supply an estimate --
 // the console shows no number rather than a made-up one, so this must not
 // assume an array. Indexing it blindly used to throw and kill the panel.
 const vals=(feeData && Array.isArray(feeData.xmr))?feeData.xmr:null;
 const imp=!!(feeData&&feeData.implausible);
 $('#fees').innerHTML=names.map((n,i)=>`<button class="fee${imp?' imp':''}" data-p="${i+1}" aria-pressed="${feePriority===i+1}">
   <div class="p">${esc(n)}</div><div class="v">${vals?esc(vals[i])+' XMR':'<span class="noest">no estimate</span>'}</div></button>`).join('');
 $$('.fee').forEach(b=>b.addEventListener('click',()=>{setFee(+b.dataset.p);sync();}));
 if(!feeData){$('#fsrc').textContent='loading…';return;}
 $('#fsrc').innerHTML=(vals?'estimate per ~2 kB tx · ':'')+esc(feeData.source)
   +(feeData.warning?`<div class="warnbox" style="margin-top:7px">${esc(feeData.warning)}</div>`:'')
   +(vals?'':`<div style="margin-top:7px"><button id="dfind" class="pfre" type="button">Find my daemon</button></div>`);
 const df=$('#dfind'); if(df) df.addEventListener('click',detectDaemon);
}
// "No estimate" almost always means the daemon field points somewhere nothing
// is listening. Probe the usual loopback ports instead of making the operator
// guess which one their node uses.
async function detectDaemon(){
 const b=$('#dfind'); if(b){b.disabled=true;b.textContent='looking…';}
 let r=null;
 try{ r=await fetch('/api/detect-daemon',{method:'POST',headers:HDR,
   body:JSON.stringify({params:collect()})}).then(x=>x.json()); }
 catch(e){ r={ok:false,detail:'lookup failed: '+e}; }
 if(r&&r.ok&&r.daemon){ $('#rpc_daemon').value=r.daemon; await loadFees(); return; }
 if(b){b.disabled=false;b.textContent='Find my daemon';}
 $('#fsrc').innerHTML=esc((r&&r.detail)||'no daemon found');
}
function setFee(p){feePriority=p;renderFees();}
async function loadFees(){
 feeData=await fetch('/api/fees',{method:'POST',headers:HDR,
   body:JSON.stringify({params:collect()})}).then(r=>r.json()).catch(()=>null);
 renderFees();
}

function setMode(m){
 mode=m;
 $$('#mode button').forEach(o=>o.setAttribute('aria-pressed',String(o.dataset.m===m)));
 $('#send-fields').hidden = mode!=='send';
 $('#recv-fields').hidden = mode!=='receive';
 $('#lbl2').textContent = mode==='send' ? 'Payment' : 'Receive';
 $('#h2-2').textContent = mode==='send' ? 'Step 2 · Payment' : 'Step 2 · Receive';
 sync();
}
$$('#mode button').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.m)));

function collect(){
 const v=id=>$('#'+id)?.value.trim()||'';
 const c=id=>!!$('#'+id)?.checked;
 return {mode, btc_entry:v('btc_entry'), btc_amount:v('btc_amount'),
  receive_wallet:v('receive_wallet'), pairs_file:v('pairs_file'),
  swap_btc:v('swap_btc'), split:+v('split')||1,
  wallets:+v('wallets')||10, deep:+v('deep')||2, fee_priority:feePriority,
  dag_mixing:c('dag_mixing'), peel:c('peel'), joinmarket:c('joinmarket'),
  allow_clearnet_relay:c('allow_clearnet_relay'), tor_proxy:v('tor_proxy'),
  rpc_primary:v('rpc_primary'), rpc_daemon:v('rpc_daemon'),
  wallet_file:v('wallet_file'), label:'GhostSpiral_entry'};
}

// ── NON-NEGOTIABLE OPSEC preflight ─────────────────────────────────────────
// Auto-runs on load and whenever the network config changes; the spend button
// is disabled until it passes, and the SERVER re-verifies it on run so a
// crafted request cannot skip it. Tor exit + relay egress are the leak-critical
// facts, verified live rather than trusted.
let preflightOk=false, pfBusy=false, pfSeq=0;
function renderPreflight(r){
 const c=(r&&r.checks)||{};
 const head=r&&r.ok
  ? `<div class="pfhead ok">✓ OPSEC preflight passed — spend permitted</div>`
  : `<div class="pfhead bad">✕ OPSEC preflight FAILED — spend blocked until fixed</div>`;
 const row=(k,label)=>{const v=c[k]; if(!v) return '';
  return `<div class="pfrow ${v.ok?'ok':'bad'}"><span>${v.ok?'✓':'✕'} ${esc(label)}</span>`
    +`<span class="pfd">${esc(v.detail||'')}</span></div>`;};
 $('#pfstatus').innerHTML=head+row('tor','Traffic exits via Tor')+row('egress','Relay egress not clearnet');
}
async function runPreflight(){
 if(pfBusy) return; pfBusy=true; const seq=++pfSeq;
 $('#pfstatus').innerHTML='<div class="pfhead run">⟳ running OPSEC preflight (verifying Tor + relay egress)…</div>';
 let r=null;
 try{ r=await fetch('/api/preflight',{method:'POST',headers:HDR,
      body:JSON.stringify({params:collect()})}).then(x=>x.json()); }
 catch(e){ r={ok:false,checks:{tor:{ok:false,detail:'preflight request failed: '+e}}}; }
 pfBusy=false;
 if(seq!==pfSeq) return;            // a newer preflight superseded this one
 preflightOk=!!(r&&r.ok); renderPreflight(r); sync();
}
// Find the Tor SOCKS port automatically (9050 tor.exe / 9150 Tor Browser) and
// fill it in, so the operator never has to know which one their Tor uses.
let detectBusy=false;
async function detectTor(silent){
 if(detectBusy) return; detectBusy=true;
 const btn=$('#pfdetect'); if(btn){btn.disabled=true;btn.textContent='Detecting Tor…';}
 if(!silent) $('#pfstatus').innerHTML='<div class="pfhead run">⟳ probing Tor ports (9050, 9150)…</div>';
 let r=null;
 try{ r=await fetch('/api/detect-tor',{method:'POST',headers:HDR,
      body:JSON.stringify({params:collect()})}).then(x=>x.json()); }
 catch(e){ r={ok:false,detail:'detect request failed: '+e}; }
 if(btn){btn.disabled=false;btn.textContent='Detect Tor port';}
 detectBusy=false;
 if(r&&r.ok&&r.proxy){
  $('#tor_proxy').value=r.proxy;      // fill the working proxy
  await runPreflight();               // and re-verify with it
  return true;
 }
 if(!silent) $('#pfstatus').innerHTML=
   `<div class="pfhead bad">✕ ${esc((r&&r.detail)||'no Tor proxy found')}</div>`;
 return false;
}
// Start an INSTALLED Tor daemon (never downloads). Blocks while tor bootstraps.
let startBusy=false;
async function startTor(){
 if(startBusy) return; startBusy=true;
 const btn=$('#pfstart'); if(btn){btn.disabled=true;btn.textContent='Starting Tor…';}
 $('#pfstatus').innerHTML='<div class="pfhead run">⟳ starting Tor (this can take up to a minute while it bootstraps)…</div>';
 let r=null;
 try{ r=await fetch('/api/start-tor',{method:'POST',headers:HDR,body:'{}'}).then(x=>x.json()); }
 catch(e){ r={ok:false,detail:'start request failed: '+e}; }
 if(btn){btn.disabled=false;btn.textContent='Start Tor';}
 startBusy=false;
 if(r&&r.ok&&r.proxy){ $('#tor_proxy').value=r.proxy; await runPreflight(); return; }
 $('#pfstatus').innerHTML=`<div class="pfhead bad">✕ ${esc((r&&r.detail)||'could not start Tor')}</div>`;
}
// Debounce so editing a network field doesn't fire a Tor check per keystroke.
let pfTimer=null;
function schedulePreflight(){ preflightOk=false; sync();
 clearTimeout(pfTimer); pfTimer=setTimeout(runPreflight,600); }

async function sync(){
 const r=await fetch('/api/preview',{method:'POST',headers:HDR,
   body:JSON.stringify({params:collect()})}).then(r=>r.json());
 $('#prev').textContent=r.pretty;
 $('#probs').innerHTML=r.problems.map(p=>`<li>${esc(p)}</li>`).join('');
 const ok=!r.problems.length;
 $('#armbox').style.display=ok?'':'none';
 const btn=document.querySelector('.act[data-id="run_pipeline"]');
 // Spend requires: valid params, armed, AND a passing preflight. Any one
 // missing keeps it disabled. The server enforces the preflight again on run.
 if(btn) btn.disabled=!(ok&&armed&&preflightOk)||!!cur;
}
// Network/OPSEC fields re-trigger the preflight; everything else just re-syncs.
const PF_FIELDS=new Set(['tor_proxy','rpc_daemon','rpc_primary','allow_clearnet_relay']);
$$('input,select').forEach(el=>el.addEventListener('input',()=>{
 if(el.id==='arm') return;
 if(PF_FIELDS.has(el.id)) schedulePreflight(); else sync();
}));
$('#pfre').addEventListener('click',runPreflight);
$('#pfdetect').addEventListener('click',()=>detectTor(false));
$('#pfstart').addEventListener('click',startTor);
$('#arm').addEventListener('input',e=>{armed=e.target.value.trim()===ARM;sync();});
$('#armword').textContent=ARM;
$('#pwnote').innerHTML=PWSET
 ? 'Wallet password found in <code>GS_WALLET_PASSWORD</code> — forwarded only to the signing child, never shown here.'
 : 'No <code>GS_WALLET_PASSWORD</code> set. If your wallet has a password, restart the console with it exported — it is never accepted through this page.';

// One grouped GRID, not a card per group. Group order is fixed so the board
// reads Preflight -> Receive -> Pipeline -> Verify regardless of dict order.
// Render each action into the wizard step that declares it via data-acts, so
// buttons live in context (make receive in step 2, checks in step 4, run in
// step 5) instead of one long grid. Server-composed argv + gates are unchanged.
function actButton(id){
 const a=A[id]; if(!a) return '';
 return `<button class="act ${a.risk}" data-id="${id}" ${a.risk==='spends'?'disabled':''}>
   <span class="top"><span class="dot" id="dot-${id}"></span><span class="nm">${esc(a.label)}</span>
    <span class="go">${a.risk==='spends'?'Spends':'Run'}</span></span>
   <span class="ds">${esc(a.desc)}</span></button>`;
}
$$('.stepacts').forEach(box=>{
 box.classList.add('ops');
 const ids=(box.dataset.acts||'').split(',').map(s=>s.trim()).filter(Boolean);
 box.innerHTML=ids.map(actButton).join('');
});
$$('.act').forEach(b=>b.addEventListener('click',()=>run(b.dataset.id)));

// ── step navigation ────────────────────────────────────────────────────────
let step=1;
function showStep(n){
 step=Math.max(1,Math.min(5,n));
 $$('.step').forEach(s=>{s.hidden = +s.dataset.step!==step;});
 $$('#stepbar li').forEach(li=>{
  const s=+li.dataset.s;
  li.classList.toggle('on', s===step);
  li.classList.toggle('done', s<step);
 });
 window.scrollTo({top:0,behavior:'smooth'});
}
$$('.nx,.bk').forEach(b=>b.addEventListener('click',()=>showStep(+b.dataset.go)));
$$('#stepbar li').forEach(li=>li.addEventListener('click',()=>showStep(+li.dataset.s)));

function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
function colour(l){
 const e=esc(l);
 if(/FAIL|LEAK |\bERROR\b|Traceback|CLEARNET|\[!\].*(?:leak|refus|abort)/i.test(l)) return `<span class="r">${e}</span>`;
 if(/RESULT:|ALL GREEN|SUCCESS|NO LEAKS|\[\+\]/.test(l)) return `<span class="g">${e}</span>`;
 if(/\[!\]|WARN|SKIP/.test(l)) return `<span class="y">${e}</span>`;
 if(/^\s*\[\*\]|^===/.test(l)) return `<span class="d">${e}</span>`;
 return e;
}
async function run(id){
 if(cur) return;
 $$('.act').forEach(b=>b.disabled=true);
 $('#dot-'+id).className='dot run';
 $('#pt').textContent=A[id].label;
 $('#ppill').style.display='';$('#ppill').className='pill run';$('#ppill').textContent='running';
 $('#out').innerHTML='<pre class="out" id="pre"></pre>';
 const res=await fetch('/run/'+id,{method:'POST',headers:HDR,
   body:JSON.stringify({params:collect(),arm:armed?ARM:''})}).then(r=>r.json());
 if(res.error){
   $('#pre').innerHTML=`<span class="r">${esc(res.error)}</span>`;
   $('#ppill').className='pill err';$('#ppill').textContent='refused';
   $('#dot-'+id).className='dot err';
   $$('.act').forEach(b=>b.disabled=false); sync(); return;
 }
 cur={jid:res.jid,id}; timer=setInterval(poll,400); poll();
}
async function poll(){
 if(!cur) return;
 const j=await fetch('/job/'+cur.jid,{headers:{'X-GS-Token':TOK}}).then(r=>r.json());
 const pre=$('#pre');
 if(pre){const stick=pre.scrollTop+pre.clientHeight>=pre.scrollHeight-40;
  pre.innerHTML=j.lines.map(colour).join('\n'); if(stick)pre.scrollTop=pre.scrollHeight;}
 $('#pm').textContent=j.lines.length+' lines'+(j.elapsed?' · '+j.elapsed+'s':'');
 if(j.done){clearInterval(timer);timer=null;
  const ok=j.rc===0;
  $('#ppill').className='pill '+(ok?'ok':'err');
  $('#ppill').textContent=ok?'ok':'exit '+j.rc;
  $('#dot-'+cur.id).className='dot '+(ok?'ok':'err');
  cur=null; $$('.act').forEach(b=>b.disabled=false); sync();}
}
$('#stop').addEventListener('click',()=>{if(cur)fetch('/stop/'+cur.jid,{method:'POST',headers:HDR,body:'{}'});});
$('#copy').addEventListener('click',()=>{const p=$('#pre');if(p)navigator.clipboard?.writeText(p.innerText);});

setMode('send'); showStep(1); applyPreset('balanced'); loadFees(); sync();
// On load, auto-detect the Tor port (silent); detectTor re-runs preflight when
// it finds one, otherwise fall through to a normal preflight on the default.
detectTor(true).then(found=>{ if(!found) runPreflight(); });
$('#rpc_daemon').addEventListener('change',loadFees);
</script></body></html>"""


def main():
    ap = argparse.ArgumentParser(description="GhostSpiral operator console")
    ap.add_argument("--port", type=int, default=8765)
    a = ap.parse_args()
    srv = ThreadingHTTPServer(("127.0.0.1", a.port), H)      # loopback ONLY
    print(f"  GhostSpiral console → http://127.0.0.1:{a.port}/?t={TOKEN}")
    print( "  ^ open THIS url — the token is required, and it changes every run")
    print(f"  {len(ACTIONS)} actions · funds require the arm phrase '{ARM_PHRASE}'")
    print(f"  wallet password: {'from GS_WALLET_PASSWORD' if os.environ.get('GS_WALLET_PASSWORD') else 'not set'}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n  stopped")


if __name__ == "__main__":
    main()
