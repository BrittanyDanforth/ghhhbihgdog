// SAY WHAT THE EXIT FIELD WILL DO, as it is typed. Whether the run ends with
// the money withdrawn or sitting on the wallet is the single most consequential
// thing on this page, and leaving it empty is a legitimate choice -- so it must
// read as a stated outcome rather than an unnoticed default.
function syncExitNote(){
 const box=$('#exitnote'); if(!box) return;
 const raw=($('#exit_to')?.value||'').split(/[\s,]+/).filter(Boolean);
 const uniq=[...new Set(raw)];
 // __XMR_RE__ is substituted from the SAME pattern the server validates with.
 // It used to be a hand-written copy, /^[48][0-9AB][1-9A-HJ-NP-Za-km-z]{93}$/,
 // and it was the OLD pattern -- the one SCHEMA's own comment records as wrong
 // about mainnet and fixed on the Python side. The copy in the page was not.
 // Measured against 841 real addresses from monero-wallet-rpc: 16 of them
 // (1.9%, every one starting "8C") were called invalid here while the server
 // accepts them, and EVERY integrated address (the 106-character "4..." form,
 // which is what an exchange deposit often is) was rejected outright.
 // The box then told the operator "the run will refuse them before it starts",
 // which is false -- so they delete good destinations and end up sending
 // everything to one address, which is the exact concentration the note
 // directly below is warning them about.
 const bad=uniq.filter(a=>!__XMR_RE__.test(a));
 box.hidden=false;
 if(!raw.length){
  box.innerHTML='<b>No exit set.</b> The mix will run and the funds will stay on '
   +'this wallet, spread across the run\'s accounts. Nothing is withdrawn. '
   +'Spend them one account at a time if you move them by hand.';
 } else if(bad.length){
  box.innerHTML='<b>'+bad.length+' address(es) are not a valid Monero format.</b> '
   +'The run will refuse them before it starts: '+esc(bad[0].slice(0,16))+'…';
 } else if(uniq.length<raw.length){
  box.innerHTML='<b>A destination is repeated.</b> Repeating spreads the '
   +'withdrawal, it does not send more to one place — the run will refuse it.';
 } else if(uniq.length===1){
  box.innerHTML='<b>All outputs go to ONE address.</b> Each still leaves in its '
   +'own transaction, but a single destination re-joins them off-chain. Add more '
   +'addresses to spread the withdrawal.';
 } else {
  box.innerHTML='<b>Exit armed: '+uniq.length+' destinations.</b> Every output '
   +'is withdrawn in its own transaction, spread across them.';
 }
}
$('#exit_to')?.addEventListener('input',syncExitNote);
syncExitNote();

