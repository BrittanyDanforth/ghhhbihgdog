JOBS: dict[str, dict] = {}
LOCK = threading.Lock()


#: Actions allowed to see GS_WALLET_PASSWORD. Only the pipeline needs it (it
#: forwards the password to the signer); every other action is a check, a test
#: suite or a third-party script that has no business holding the spend
#: password of a funded wallet.
PASSWORD_ACTIONS = {"run_pipeline"}

#: Which GS_ secrets each action is allowed to see. DEFAULT-DENY: an action
#: absent from this map gets none of them.
#:
#: secret_env's whole argument is that these are the values that tie a run to
#: an identity -- the operator's Bitcoin address, the sum being moved, and "THE
#: EXIT DESTINATION ... the value with the most to lose" -- and its answer was
#: to move them off argv and into the environment. They were then handed to
#: EVERY child: `env.update(extra_env or {})` in start() runs for the unit
#: suites, py_compile, paranoia_mode, receive_watch and the disk-leak audit,
#: none of which read a GS_ variable.
#:
#: That is the same defect _child_env below was written to fix for the wallet
#: password, on the same call path, left standing for the other four. And
#: GhostSpiral already reached this conclusion for its OWN children:
#: _child_env there is `{k: v for k, v in os.environ.items() if not
#: k.startswith("GS_")}`, with the note "Default-deny is free here: nothing
#: GhostSpiral spawns reads a GS_ variable except the SIGN phase".
#:
#: GS_EXIT_TO for swap_quote is DELIBERATE, not an oversight: thor_swap_preparer
#: reads it to refuse a swap whose destination is also the exit destination --
#: which would publish the final address in a Bitcoin OP_RETURN. That check is
#: the reason the variable reaches that child at all.
ACTION_SECRETS = {
    "run_pipeline": {"GS_BTC_ENTRY", "GS_BTC_AMOUNT", "GS_EXIT_TO",
                     "GS_EXPECT_TOTAL_XMR"},
    "swap_quote": {"GS_SWAP_AMOUNTS", "GS_EXIT_TO"},
}
_JOB_SEQ = [0]


def secret_env(params: dict) -> dict:
    """Values passed to a child through the ENVIRONMENT, never on its argv.

    /proc/<pid>/cmdline is mode 0444 -- every account on the host can read a
    child's command line for as long as it runs -- while /proc/<pid>/environ is
    0400, owner only. Both measured on Linux.

    The console used to spawn `GhostSpiral --btc-entry bc1... --btc-amount 0.42`
    and `thor_swap_preparer --amounts 0.42`, so the operator's own Bitcoin
    address and the sum being moved were readable by any local user via ps.
    Those are the two values that tie a run to a Bitcoin identity, and this
    toolchain already keeps both out of the integrity chain for that reason.

    Keeping them out of argv also keeps them out of the command PREVIEW the
    page renders, which is the same rule the wallet password already follows:
    the preview shows the real argv, and the real argv has no secrets on it.

    THE EXIT DESTINATION WAS THE EXCEPTION, and it is the value with the most
    to lose. pipeline_argv composed `--exit-to <address>` onto the command line
    while everything above went by environment, so the operator's FINAL
    address -- the one the entire pipeline exists to keep unlinkable from the
    public ThorChain memo -- was in `ps` output and in the preview this
    docstring says has no secrets on it. OPSEC_SETUP.md repeated the claim.
    Even thor_swap_preparer's swap destinations, which the swap provider is
    told anyway, already had GS_SWAP_DESTS.

    Space-separated, because --exit-to is repeatable; GhostSpiral splits on
    whitespace or commas.
    """
    env = {}
    if params.get("btc_entry"):
        env["GS_BTC_ENTRY"] = params["btc_entry"]
    if params.get("btc_amount"):
        env["GS_BTC_AMOUNT"] = str(params["btc_amount"])
    if params.get("swap_btc"):
        env["GS_SWAP_AMOUNTS"] = str(params["swap_btc"])
    # HOW MUCH XMR THIS RUN IS WAITING FOR. Same class as GS_BTC_AMOUNT above,
    # and GhostSpiral's own help for the flag says to prefer the variable
    # because the argv form is world-readable for the life of the run.
    if params.get("expect_total_xmr"):
        env["GS_EXPECT_TOTAL_XMR"] = str(params["expect_total_xmr"])
    if params.get("exit_to"):
        env["GS_EXIT_TO"] = " ".join(params["exit_to"])
    return env


def _child_env(action_id):
    """Environment for a child process.

    The module header promises the wallet password is "forwarded ONLY to the
    pipeline child". It was not: every action inherited os.environ verbatim, so
    a funded wallet's spend password was handed to the unit suites, to
    paranoia_mode, to py_compile and to anything else a click could start.
    Verified by running a non-pipeline child and printing the variable.
    """
    env = dict(os.environ)
    if action_id not in PASSWORD_ACTIONS:
        env.pop("GS_WALLET_PASSWORD", None)
    # EVERY OTHER GS_ VARIABLE TOO, by the same argument. The console may have
    # been started from a shell that already exports GS_EXIT_TO or
    # GS_BTC_ENTRY -- OPSEC_SETUP.md tells the operator to do exactly that --
    # and those were inherited verbatim by every action. Stripped here and
    # re-added per action from ACTION_SECRETS, so the allow-list is the only
    # way in, whether the value came from the page or from the shell.
    for _k in [k for k in env if k.startswith("GS_")]:
        if _k not in ACTION_SECRETS.get(action_id, ()):
            env.pop(_k, None)
    if action_id in PASSWORD_ACTIONS and os.environ.get("GS_WALLET_PASSWORD") is not None:
        env["GS_WALLET_PASSWORD"] = os.environ["GS_WALLET_PASSWORD"]
    return env


def job_timeout_for(params):
    """How long THIS job may legitimately take, from its own settings.

    A single console-wide constant cannot answer this. The dominant term is the
    planned inter-transaction delay, and the DAG round relays one transaction
    per funded mix output in ONE child process with the delays CUMULATIVE -- so
    the run length scales as wallets x hop-delay, and the page lets an operator
    pick 60 wallets and a 1-3 day delay window from two dropdowns that say
    nothing about each other.

    Worked from the same numbers GhostSpiral uses: the swap-arrival wait, the
    fan-out confirm, and then the actual delay budget rather than a single
    maximum hop delay. At 60 wallets x 259200s that is 180 days; the floor
    below is what applies when the operator leaves the defaults alone.

    Deliberately generous, for the reason JOB_TIMEOUT_FLOOR_S already gives:
    killing a live run strands funds and leaves secrets on disk, while a hung
    job that lives too long is a stale row the stop button clears.
    """
    try:
        w = max(1, int(params.get("wallets") or 10))
    except (TypeError, ValueError):
        w = 10
    hi = 720
    hd = str(params.get("hop_delay") or "").strip()
    if hd:
        try:
            parts = hd.split("-", 1)
            hi = max(int(parts[0]), int(parts[-1]))
        except ValueError:
            hi = 720
    # x2: the DAG round is the widest, and a run has other rounds after it.
    return max(JOB_TIMEOUT_FLOOR_S, 86400 + 3600 + w * hi * 2)


def start(argv, label, action_id=None, extra_env=None, timeout_s=None):
    with LOCK:
        _JOB_SEQ[0] += 1
        seq = _JOB_SEQ[0]
    # Sequence-suffixed: two jobs started inside the same millisecond used to
    # get the same id, so one silently replaced the other in JOBS and the UI
    # polled the wrong process's output.
    jid = f"j{int(time.time()*1000)}_{seq}"
    # Per job, not per console: see job_timeout_for.
    _job_timeout = int(timeout_s or JOB_TIMEOUT_S)
    job = {"id": jid, "label": label, "lines": [], "done": False, "rc": None,
           "started": time.time(), "proc": None, "argv": argv}
    with LOCK:
        JOBS[jid] = job
        if len(JOBS) > MAX_JOBS:          # bound memory; drop oldest finished
            for k in [k for k, v in sorted(JOBS.items(), key=lambda kv: kv[1]["started"])
                      if v["done"]][:len(JOBS) - MAX_JOBS]:
                JOBS.pop(k, None)

    def run():
        try:
            env = _child_env(action_id)     # password only for PASSWORD_ACTIONS
            # The BTC address and amounts ride here, not on argv -- but only
            # for the actions ACTION_SECRETS names. This was an unconditional
            # update(), so a click on "Unit suite" or "Compile all" handed
            # py_compile the operator's exit destination.
            _allowed = ACTION_SECRETS.get(action_id, ())
            for _k, _v in (extra_env or {}).items():
                if _k in _allowed:
                    env[_k] = _v
            # stdin=DEVNULL: a job must never be able to WAIT FOR A HUMAN.
            # Children inherited the console's fd 0, so receive_watch's
            # `if pick is None and sys.stdin.isatty()` was True for a job
            # nobody can type into: the moment a payment landed, the job
            # blocked on input() forever. Nothing could clear it -- see the
            # watchdog below for why the job timeout could not either.
            #
            # PYTHONUNBUFFERED: stdout here is a PIPE, so CPython block-buffers
            # at 8192 bytes. bufsize=1 is the PARENT's read side and does not
            # change the child's buffering, so the live-output pane stayed
            # empty for hours on a slow-ticking job like receive_watch (41-byte
            # progress lines at a 45-90s cadence -- roughly 188 ticks, over
            # three hours, before the first flush). Set it for every child
            # rather than adding flush=True to one tool's prints, so the next
            # tool cannot half-apply the fix.
            env.setdefault("PYTHONUNBUFFERED", "1")
            p = subprocess.Popen(argv, cwd=REPO, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, bufsize=1,
                                 start_new_session=True, env=env,
                                 stdin=subprocess.DEVNULL)   # shell=False
            job["proc"] = p
            # WATCHDOG, because p.wait(timeout=...) below can never fire.
            #
            # The drain loop `for line in p.stdout` ends only when the child
            # closes stdout, i.e. when it exits -- so by the time the timeout
            # was armed the process was already gone. JOB_TIMEOUT_S was dead
            # code, and a child that hung while holding stdout open (the
            # input() hang above, an RPC read with no timeout) pinned this
            # thread forever with the UI still showing "running".
            #
            # A timer that kills the process GROUP does fire during the drain.
            # start_new_session=True above gives each job its own group, so
            # this cannot reach anything else.
            def _watchdog():
                # SIGTERM FIRST. This sent SIGKILL, which cannot be caught, so
                # none of the child's `finally` blocks ran -- and those are what
                # erase the wallet password, the exit plan carrying --exit-to,
                # the peel and change-sweep plans, and the staging trees of
                # signed blobs. A timed-out run left all of it on disk.
                #
                # Every tool installs a SIGTERM handler
                # (gs_common.install_signal_handlers) and stops at its next
                # checkpoint, which is exactly what the manual stop button has
                # always relied on. The watchdog is the one path that never
                # used it, and the only one that fires with nobody watching.
                with LOCK:
                    job["lines"].append(
                        f"[console] job exceeded {_job_timeout}s — asking it "
                        f"to stop (SIGTERM) so it can erase its plans and the "
                        f"wallet password.")
                try:
                    _pg = os.getpgid(p.pid)
                except OSError:
                    return
                try:
                    os.killpg(_pg, signal.SIGTERM)
                except OSError:
                    return
                # Then SIGKILL only if it is genuinely wedged. p.wait() is the
                # drain thread's job, so poll rather than wait here.
                _deadline = time.time() + JOB_TERM_GRACE_S
                while time.time() < _deadline:
                    if p.poll() is not None:
                        with LOCK:
                            job["lines"].append(
                                "[console] job stopped cleanly after SIGTERM.")
                        return
                    time.sleep(0.5)
                with LOCK:
                    job["lines"].append(
                        f"[console] still running {JOB_TERM_GRACE_S}s after "
                        f"SIGTERM — SIGKILL. Its plans and any wallet-password "
                        f"scratch file may still be on disk; run paranoia_mode.")
                try:
                    os.killpg(_pg, signal.SIGKILL)
                except OSError:
                    pass
            _wd = threading.Timer(_job_timeout, _watchdog)
            _wd.daemon = True
            _wd.start()
            try:
                for line in p.stdout:
                    with LOCK:
                        job["lines"].append(line.rstrip("\n"))
                        if len(job["lines"]) > 5000:
                            del job["lines"][:1500]
            finally:
                _wd.cancel()
            try:
                # Short, because stdout is already closed: the drain loop above
                # only ends when the child exits or the watchdog killed it, so
                # this is a reap, not a wait. It used to be JOB_TIMEOUT_S, which
                # meant a child that closed stdout but did not exit held this
                # thread for the whole timeout a second time.
                p.wait(timeout=JOB_TERM_GRACE_S)
            except subprocess.TimeoutExpired:
                # Same escalation as the watchdog, and for the same reason:
                # SIGKILL skips every `finally`, including the ones that erase
                # the wallet password and the exit plan.
                try:
                    _pg2 = os.getpgid(p.pid)
                    os.killpg(_pg2, signal.SIGTERM)
                    job["lines"].append(
                        "[console] output ended but the process is still alive "
                        "— SIGTERM sent so it can clean up.")
                    try:
                        p.wait(timeout=JOB_TERM_GRACE_S)
                    except subprocess.TimeoutExpired:
                        os.killpg(_pg2, signal.SIGKILL)
                        job["lines"].append(
                            "[console] SIGKILL after grace period; plans and "
                            "any wallet-password scratch file may remain on "
                            "disk — run paranoia_mode.")
                        p.wait()
                except OSError:
                    pass
            job["rc"] = p.returncode
        except FileNotFoundError as e:
            job["lines"].append(f"[console] not found: {e}"); job["rc"] = 127
        except Exception as e:                                  # noqa: BLE001
            job["lines"].append(f"[console] error: {e}"); job["rc"] = 1
        finally:
            job["done"] = True
            job["elapsed"] = round(time.time() - job["started"], 1)

    threading.Thread(target=run, daemon=True).start()
    return jid


def stop(jid):
    j = JOBS.get(jid)
    if not j or j["done"] or not j["proc"]:
        return False
    try:
        os.killpg(os.getpgid(j["proc"].pid), signal.SIGTERM)
        j["lines"].append("[console] SIGTERM sent to process group")
        return True
    except (ProcessLookupError, PermissionError):
        return False


#: The ceiling above which a daemon's fee is not believable.
#:
#: THIS WAS 0.1 AND IT FLAGGED HEALTHY DAEMONS. _flag_fees compares
#: max(res["xmr"]) -- which is always the PRIORITY 4 figure -- against this, so
#: the number being tested is the flash-priority fee while the ceiling was
#: chosen for priority 1. A real monerod 0.18.3.1 returns
#: fees = [1200000, 4700000, 19000000, 240000000] piconero/byte, i.e. 0.0024 /
#: 0.0094 / 0.038 / 0.48 XMR per ~2 kB transaction. 0.48 > 0.1, so the console
#: told the operator "far above a real mainnet fee ... the daemon is on a fresh
#: or offline chain. Do NOT treat these as real costs" about the correct
#: numbers from a correctly working node. Reproduced against a real local
#: daemon, which is the only reason it was noticed.
#:
#: Worse, GhostSpiral -- the tool that actually SPENDS -- accepts those same
#: numbers: its FEE_IMPLAUSIBLE_XMR is 1.0, deliberately "set FAR above any
#: real fee (even an extreme-congestion priority-4 mainnet fee is a fraction of
#: an XMR) and far below the fresh-chain value". So the console warned about a
#: fee the pipeline would happily spend against, which trains the operator to
#: ignore the panel exactly when it is right.
#:
#: One number now, read from the orchestrator, with tests/test_console.py
#: enforcing they agree -- the same fix the --split ceiling and the job timeout
#: each needed after drifting.
#: A fresh/offline daemon still trips it: it reports ~2e9 piconero/byte, which
#: is ~4 XMR at priority 1, well above 1.0.
FEE_PLAUSIBLE_MAX_XMR = 1.0


def _flag_fees(res):
    """Attach a warning when the daemon's numbers are not believable, or when
    they are believable but belong to a chain nobody else can see."""
    _nt = str(res.get("nettype") or "")
    if _nt and _nt != "mainnet":
        # NOT an implausibility -- regtest's fees are real numbers -- so this
        # is its own line rather than a hijack of the fee warning. GhostSpiral
        # refuses this chain at stage 0 unless --allow-test-chain is given; the
        # point of saying it here is that the operator finds out BEFORE filling
        # in an exit address and clicking Run.
        res["nettype_warning"] = (
            f"This daemon is on {_nt.upper()}, not mainnet. Nothing here would "
            f"touch real funds, and the pipeline will refuse to run against it "
            f"unless you pass --allow-test-chain. Note that `monerod --regtest` "
            f"binds the MAINNET port 18081 by default, so this can be the "
            f"daemon you get without changing the address.")
    top = max(res.get("xmr") or [0])
    lo = min(res.get("xmr") or [0])
    if top > FEE_PLAUSIBLE_MAX_XMR:
        res["implausible"] = True
        res["warning"] = (f"Daemon reports up to {top} XMR per ~2 kB transaction — "
                          f"far above a real mainnet fee. This usually means the daemon "
                          f"is on a fresh or offline chain. Do NOT treat these as real "
                          f"costs.")
    elif lo <= 0:
        res["implausible"] = True
        res["warning"] = "Daemon returned a zero fee — the estimate is not usable."
    else:
        res["implausible"] = False
    return res


_GS_MOD = None
_GS_LOCK = threading.Lock()


def _gs_common():
    """Load gs_common.py once and cache it.

    live_fees() used to re-exec the whole module on every poll AND push another
    copy of REPO onto sys.path each time, so an open console grew sys.path
    without bound and re-ran gs_common's import-time work on a timer.
    """
    global _GS_MOD
    with _GS_LOCK:
        if _GS_MOD is None:
            import importlib.machinery, importlib.util
            l = importlib.machinery.SourceFileLoader(
                "gs_common_console", os.path.join(REPO, "gs_common.py"))
            s = importlib.util.spec_from_loader(l.name, l)
            m = importlib.util.module_from_spec(s)
            l.exec_module(m)
            _GS_MOD = m
    return _GS_MOD


_GHOST = [None]


def _ghost():
    """Lazily load GhostSpiral for its PURE fee arithmetic.

    Same lazy pattern as _gs_common: nothing is imported at console start-up,
    so the page still serves on a machine where the orchestrator's own
    dependencies are missing. The console already spawns GhostSpiral as its
    main job, so this is not a new dependency -- and compute_fee_budget is
    documented PURE (no RPC, no logging, no exit), which is why it is safe to
    call inside a request handler.

    Imported rather than reimplemented. Copying the rounds formula here is the
    single-source-of-truth mistake this repo has already paid for twice: the
    --split ceiling drifting from gs_common.MAX_SPLIT, and the job timeout
    drifting 6x from the pipeline's own waits.
    """
    if _GHOST[0] is None:
        import importlib.machinery as _im, importlib.util as _iu
        _ld = _im.SourceFileLoader("gs_console_ghost", os.path.join(REPO, "GhostSpiral"))
        _m = _iu.module_from_spec(_iu.spec_from_loader(_ld.name, _ld))
        _ld.exec_module(_m)
        _GHOST[0] = _m
    return _GHOST[0]


def _run_totals(per_tx_xmr, wallets, deep, shape=None):
    """What the WHOLE run reserves at each priority, not one transaction.

    THE PANEL SHOWED A PER-TRANSACTION FEE while the operator was choosing the
    two settings that decide HOW MANY TRANSACTIONS there are. live_fees took
    only (daemon_url, tor_proxy), so the number could not move when --wallets
    or --deep changed -- and it did not, which is exactly what an operator
    reported: "the fee doesn't change even if I up the wallets or depth".

    It is not a small difference. At the real priority-1 fee of 0.0024 XMR/tx:

        3 wallets  · depth 1     6 rounds     0.0216 XMR reserved
        20 wallets · depth 2    80 rounds     0.288  XMR
        60 wallets · depth 6   720 rounds     2.592  XMR

    a 120x span, on settings the operator picks by clicking a preset. At
    60/6 that is a quarter of a 10 XMR balance held back, with the panel
    still reading 0.0024.

    Returns (rounds, [total per priority]) or (None, None) when wallets/deep
    are not both usable -- in which case the panel keeps saying per-tx, rather
    than inventing a total.
    """
    try:
        w, d = int(wallets), int(deep)
    except (TypeError, ValueError):
        return None, None
    if w < 1 or d < 1 or not per_tx_xmr:
        return None, None
    try:
        g = _ghost()
        from decimal import Decimal as _D
        # THE SHAPE, because the reserve is now one fee per transaction the run
        # will actually make and a peel chain makes several times a fan-out's.
        # Passed explicitly and REQUIRED by the shipped function -- a caller
        # that forgets --peel would price a fan-out and show a total the run
        # then exceeds, which is the direction that fails mid-chain.
        _sh = shape or {}
        totals = []
        rounds = None
        for f in per_tx_xmr:
            # A nominal balance: total_fees is hop_fee_reserve(fee) x
            # transactions and does not depend on it. The SHIPPED function
            # computes both, so the panel and the run cannot disagree.
            _usable, _fees, _rounds = g.compute_fee_budget(
                _D("1000"), _D(str(f)), w,
                peel=bool(_sh.get("peel")),
                dag_mixing=bool(_sh.get("dag_mixing")),
                exit_set=bool(_sh.get("exit_to")),
                chunks=max(1, int(_sh.get("split") or 1)))
            rounds = _rounds
            totals.append(round(float(_fees), 6))
        return rounds, totals
    except Exception:                                        # noqa: BLE001
        return None, None


def run_notes(p: dict) -> list:
    """Non-blocking advisories about what THIS run will and will not do.

    pipeline_argv's `problems` stop a spend, so it can only carry things that
    are wrong. It cannot carry "this is legal and probably not what you meant",
    and the page therefore had no way to say the most consequential of those:
    that a receive run with no target does not wait.

    GhostSpiral supports a targetless receive run -- it prints "this run does
    NOT wait" and plans against whatever is on ENTRY -- so refusing it here
    would be wrong. Saying nothing was worse: the page showed an empty problem
    list, which reads as "everything is set".
    """
    notes = []
    if p.get("mode") == "receive":
        if not p.get("expect_total_xmr"):
            _pf = p.get("pairs_file") or DEFAULT_PAIRS_FILE
            _have = False
            try:
                _have = os.path.isfile(os.path.join(REPO, _pf))
            except Exception:                                # noqa: BLE001
                _have = False
            if _have:
                notes.append(
                    f"The arrival target comes from {_pf}: the run sums the "
                    f"swaps routed to this receive address and waits for all "
                    f"of them. Set 'Expected total XMR' only to override that.")
            else:
                notes.append(
                    f"NO ARRIVAL TARGET. {_pf} is not in the repo directory "
                    f"and 'Expected total XMR' is empty, so this run will NOT "
                    f"WAIT — it mixes whatever is on the receive address the "
                    f"moment it starts. Paid by more than one swap, the later "
                    f"ones land on an address the run has already finished "
                    f"with, unmixed, on the address the swap memo names in "
                    f"public. Run 'Get the BTC deposit address' first, or type "
                    f"the total you are expecting.")
    if p.get("exit_to"):
        _n = len(p["exit_to"])
        if _n == 1:
            notes.append(
                "ONE exit destination: every withdrawal arrives at the same "
                "address, so whoever watches it sees them as one group. "
                "Repeat the address box for more.")
    else:
        notes.append(
            "No exit destination, so nothing is withdrawn: the mixed funds "
            "stay spread across this wallet's accounts and the run says which "
            "ones at the end.")
    return notes


def run_eta(p: dict) -> str:
    """How long THIS run will take, from the shipped estimator. "" if unknown.

    THE DELAY DROPDOWN WAS LABELLED WITH RUN LENGTHS THAT WERE NOT RUN LENGTHS.
    Its options said things like "6 - 24 h · days (recommended for ring-age)",
    but --hop-delay is PER TRANSACTION and a run is dozens of them: at the
    console's own default preset (10 wallets, peel + DAG, an exit set) that
    option is 36 transactions x ~15 h, which is about a month, not "days".

    That mattered in the direction that costs money. GhostSpiral's own
    estimate_runtime docstring says an operator who is told twenty minutes and
    sees two hours of silence "concludes the run has hung and interrupts it --
    and an interrupt mid-round is the one failure this pipeline has no
    automatic recovery from". A label out by 20x is that, with the wrong number
    coming from the page rather than from a misunderstanding.

    Computed by calling the SHIPPED estimate_runtime, exactly as _run_totals
    calls the shipped compute_fee_budget: the page and the run must not be able
    to disagree about how long the run is. Returns "" rather than a guess when
    GhostSpiral cannot be loaded -- the same rule live_fees applies to a fee it
    cannot obtain.
    """
    try:
        g = _ghost()
        w = max(1, int(p.get("wallets") or 10))
        # The estimator's mix_outputs is the FUNDED output count: --wallets
        # plus the decoys the run adds, drawn at random in
        # DECOY_MIN..DECOY_MAX. Use the HIGH end.
        #
        # Understating is the dangerous direction here, and it is the same
        # direction the old estimator failed in. GhostSpiral's own
        # estimate_runtime docstring: an operator told twenty minutes who then
        # waits two hours "concludes the run has hung and interrupts it -- and
        # an interrupt mid-round is the one failure this pipeline has no
        # automatic recovery from". compute_fee_budget assumes DECOY_MAX for
        # the same reason, so the two agree about the run's size.
        outs = w + int(getattr(g, "DECOY_MAX", 7))
        window = g.parse_hop_delay(p.get("hop_delay") or None)

        class _A:
            peel = bool(p.get("peel"))
            dag_mixing = bool(p.get("dag_mixing"))
            exit_to = list(p.get("exit_to") or [])
        from decimal import Decimal as _D
        _mean = (_D(window[0]) + _D(window[1])) / 2
        _txs = g._runtime_terms(_A, max(1, int(p.get("split") or 1)), outs,
                                _mean, _D(g.FANOUT_CONFIRM_POLL_ESTIMATE))[1]
        _eta = g.estimate_runtime(_A, max(1, int(p.get("split") or 1)), outs,
                                  window)
        _tail = ("" if _A.exit_to else
                 " (no exit destination set, so no withdrawals are counted)")
        return (f"About {_txs} broadcast transactions at this delay: {_eta} "
                f"end to end, most of it deliberate waiting.{_tail}")
    except Exception:                                        # noqa: BLE001
        return ""


def live_fees(daemon_url, tor_proxy="", wallets=None, deep=None, shape=None):
    """Real per-priority fees from the operator's own daemon, or none at all.

    THERE IS NO FALLBACK TABLE. This used to answer an unreachable daemon with
    a hard-coded 0.00005-XMR-per-priority ladder, labelled "built-in fallback"
    in a `source` string most of the page never showed, and -- because
    _flag_fees was not applied to that branch -- with the implausibility
    warning suppressed. The operator was then choosing a fee priority against
    invented numbers.

    That is the same defect this repo already removed twice: from
    exit_strategy_simulator, which now aborts rather than serve a made-up
    price, and from thor_swap_preparer's _btc_per_xmr, which returned a
    hard-coded 0.003 that the slippage check then compared real quotes
    against. A fee estimate is a number about the operator's own money; if the
    daemon cannot supply it, the honest answer is that there is no estimate.

    A REMOTE daemon is queried through the Tor proxy, exactly like the two
    preflight checks: without it, gs.daemon_fee_estimate refuses a non-loopback
    daemon (it will not open a clearnet connection to it) and returns nothing,
    so an operator with a remote daemon behind Tor silently saw "no estimate".
    A loopback daemon is queried directly (Tor cannot route to loopback).
    """
    try:
        gs = _gs_common()
        from urllib.parse import urlparse as _up
        host = (_up(daemon_url).hostname or "").lower()
        proxies = None
        if host not in gs._LOCALHOST_NAMES and tor_proxy:
            proxies = gs.validate_proxy(tor_proxy)
        # WHICH CHAIN, on the panel, not only when the run refuses.
        #
        # check_daemon_relay_egress already returns nettype and GhostSpiral now
        # refuses a non-mainnet one at stage 0 -- but the operator only found
        # out after clicking Run. And it is easy to land on by accident:
        # `monerod --regtest` with no port flag BINDS THE MAINNET PORT (its own
        # log says "Binding on 127.0.0.1 (IPv4):18081"), so detect-daemon finds
        # a fakechain at exactly the address the field already contains, and
        # the fee numbers it returns are ordinary-looking.
        #
        # Driven against real daemons on separate ports:
        #   regtest  -> nettype=fakechain, fees [0.0024 .. 0.48], implausible False
        #   testnet  -> nettype=testnet,   fees [4.0 .. 664.0],   implausible True
        #   stagenet -> nettype=stagenet,  fees [4.0 .. 664.0],   implausible True
        # so the fee heuristic catches a FRESH testnet/stagenet by accident,
        # and cannot see regtest at all -- regtest's fees are real.
        _net = ""
        try:
            _net = str((gs.check_daemon_relay_egress(daemon_url, proxies)
                        or {}).get("nettype") or "")
        except Exception:                                    # noqa: BLE001
            _net = ""
        est = gs.daemon_fee_estimate(daemon_url, proxies)
        fees = est.get("fees")
        if isinstance(fees, list) and fees:
            _per = [round(int(f) * 2000 / 1e12, 6) for f in fees[:4]]
            _rounds, _totals = _run_totals(_per, wallets, deep, shape)
            return _flag_fees({"ok": True, "source": "daemon fees[] per priority",
                               "xmr": _per, "rounds": _rounds,
                               "total_xmr": _totals, "nettype": _net})
        base = est.get("fee")
        if base:
            mult = [1, 4, 20, 166]
            _per = [round(int(base) * 2000 * m / 1e12, 6) for m in mult]
            _rounds, _totals = _run_totals(_per, wallets, deep, shape)
            return _flag_fees({"ok": True, "source": "daemon base fee x multiplier",
                               "xmr": _per, "rounds": _rounds,
                               "total_xmr": _totals, "nettype": _net})
        return {"ok": False, "xmr": None, "implausible": False,
                "source": "no estimate — the daemon returned no fee data",
                "warning": ("Could not reach a daemon at "
                            f"{daemon_url} for a fee estimate. No numbers are shown "
                            "because inventing them would be worse than showing none: "
                            "point --rpc-daemon at your monerod (usually "
                            "http://127.0.0.1:18081). Priority still applies — the "
                            "wallet computes the real fee at signing time.")}
    except Exception as e:
        return {"ok": False, "xmr": None, "implausible": False,
                "source": f"no estimate — {str(e)[:60]}",
                "warning": ("The fee estimate could not be produced, so none is "
                            "shown. Priority still applies; the wallet computes the "
                            "real fee at signing time.")}


#: Where monerod's RPC commonly listens. 18081 is the mainnet default; 18089 is
#: the conventional "restricted/public" port that remote-node operators expose
#: and that many wallets are pointed at; 28081/38081 are testnet/stagenet. An
#: operator whose node is on any of these should not have to discover that the
#: fee panel wanted a different number.
DAEMON_PORTS = (18081, 18089, 28081, 38081)


def detect_daemon(preferred: str = "", tor_proxy: str = "") -> dict:
    """Find a monerod that will actually answer a fee estimate.

    "Cannot get estimates" is almost never a broken console -- it is that no
    daemon is listening where the field points. Rather than leaving the
    operator to guess the port, probe the likely ones and keep whichever really
    returns fee data, the same way the Tor proxy is detected.

    Only the CONFIGURED endpoint may be remote (queried through Tor, exactly as
    live_fees does). The probe list is loopback-only on purpose: sweeping ports
    on anything but this machine would be scanning someone else's host.
    """
    try:
        _gs_common()
    except Exception as e:                            # noqa: BLE001
        return {"ok": False, "daemon": None,
                "detail": f"cannot load dependencies — {str(e)[:100]}"}
    cands = []
    p = (preferred or "").strip()
    if p:
        cands.append(p)
    for port in DAEMON_PORTS:
        u = f"http://127.0.0.1:{port}"
        if u not in cands:
            cands.append(u)
    tried = []
    doubtful = None
    for url in cands:
        try:
            r = live_fees(url, tor_proxy)
        except Exception:                             # noqa: BLE001
            tried.append(url); continue
        if r.get("ok") and r.get("xmr"):
            # A daemon that answers is not automatically the right one. A fresh
            # or offline chain quotes fees orders of magnitude above mainnet, and
            # picking it just because it replied first would hand the operator
            # invented-looking costs while a real node sat on the next port.
            # Prefer a believable one; keep an implausible one only as a
            # last resort, and say so rather than presenting it as found.
            if not r.get("implausible"):
                return {"ok": True, "daemon": url,
                        "detail": f"monerod answering fee estimates at {url}"}
            if doubtful is None:
                doubtful = (url, max(r.get("xmr") or [0]))
        tried.append(url)
    if doubtful:
        url, top = doubtful
        return {"ok": True, "daemon": url,
                "detail": (f"Only {url} answered, and it quotes up to {top} XMR per "
                           f"~2 kB transaction — far above a real mainnet fee, so it "
                           f"is almost certainly a fresh, offline or test chain. "
                           f"Selected it because nothing else replied; do NOT treat "
                           f"these numbers as real costs.")}
    return {"ok": False, "daemon": None,
            "detail": ("No monerod answered a fee estimate on " + ", ".join(tried) +
                       ". Start your node (monerod), or point the daemon field at the "
                       "remote node your wallet already uses — a remote one is queried "
                       "through Tor, not clearnet. Fees are still charged correctly "
                       "without an estimate; the wallet computes the real fee when it "
                       "signs, so this only costs you the preview.")}


#: Where Tor's SOCKS proxy commonly listens: 9050 = the standalone tor daemon /
#: Tor Expert Bundle / most Linux packages; 9150 = the Tor Browser bundle. The
#: operator should not have to know which — we probe both and keep whichever
#: ACTUALLY exits via Tor.
TOR_SOCKS_PORTS = (9050, 9150)


def detect_tor_proxy(preferred: str = "") -> dict:
    """Find a working Tor SOCKS proxy on localhost by REAL verification.

    A port being open is not enough (a random SOCKS proxy is not Tor), so each
    candidate is checked with the same tor_recheck used everywhere else: it must
    confirm the exit is Tor. Tries the operator's current value first, then the
    well-known ports. Returns {"ok", "proxy", "detail"}. Never raises.
    """
    try:
        gs = _gs_common()
    except Exception as e:                            # noqa: BLE001
        return {"ok": False, "proxy": None,
                "detail": f"cannot load dependencies — {str(e)[:100]}"}
    cands = []
    p = (preferred or "").strip()
    if p:
        cands.append(p)
    for port in TOR_SOCKS_PORTS:
        u = f"socks5h://127.0.0.1:{port}"
        if u not in cands:
            cands.append(u)
    tried = []
    for u in cands:
        try:
            proxy = gs.validate_proxy(u)
            gs.tor_recheck(proxy, "console_detect")   # single-shot; exits/raises on fail
            return {"ok": True, "proxy": u, "detail": f"verified Tor exit via {u}"}
        except SystemExit:
            tried.append(u.rsplit(":", 1)[-1])
        except Exception:
            tried.append(u.rsplit(":", 1)[-1])
    return {"ok": False, "proxy": None,
            "detail": ("no working Tor proxy on ports " + ", ".join(tried) +
                       ". Start Tor Browser (9150) or tor.exe (9050) and retry.")}


_TOR_PROC = None
_TOR_LOCK = threading.Lock()


def _find_tor_binary():
    """Locate an ALREADY-INSTALLED tor daemon. Never downloads anything —
    launching a fetched binary would be a supply-chain risk the operator did
    not consent to. PATH first, then a few well-known install locations."""
    b = shutil.which("tor")
    if b:
        return b
    home = os.path.expanduser("~")
    cands = []
    if sys.platform == "win32":
        tb = os.path.join("Tor Browser", "Browser", "TorBrowser", "Tor", "tor.exe")
        cands += [os.path.join(home, "Desktop", tb),
                  os.path.join(home, "OneDrive", "Desktop", tb),
                  os.path.join(home, "Downloads", tb),
                  os.path.join(os.environ.get("PROGRAMFILES", "C:/Program Files"), "Tor", "tor.exe"),
                  os.path.join(home, "tor", "tor.exe")]
    else:
        cands += ["/usr/bin/tor", "/usr/local/bin/tor", "/opt/homebrew/bin/tor",
                  os.path.join(home, ".local", "bin", "tor")]
    for c in cands:
        if c and os.path.isfile(c):
            return c
    return None


def start_tor():
    """Start an installed Tor daemon and return the verified SOCKS proxy.

    Order: (1) if a Tor proxy is already working, use it — never launch a
    duplicate; (2) if we launched one earlier and it's alive, re-verify it;
    (3) otherwise find an installed tor binary and launch it (default config =
    SOCKS on 127.0.0.1:9050), then poll until it bootstraps and verifies as
    Tor. Only ever runs a binary already on the machine. Never raises.
    """
    global _TOR_PROC
    d = detect_tor_proxy("")
    if d.get("ok"):
        return {"ok": True, "proxy": d["proxy"], "started": False,
                "detail": "Tor was already running: " + d["proxy"]}
    with _TOR_LOCK:
        if _TOR_PROC is not None and _TOR_PROC.poll() is None:
            d = detect_tor_proxy("socks5h://127.0.0.1:9050")
            if d.get("ok"):
                return {"ok": True, "proxy": d["proxy"], "started": True,
                        "detail": "Tor (started here) is up: " + d["proxy"]}
            return {"ok": False, "proxy": None, "started": True,
                    "detail": "Tor was launched but has not finished bootstrapping "
                              "yet — wait a moment and click 'Detect Tor port'."}
        tor_bin = _find_tor_binary()
        if not tor_bin:
            hint = ("Open Tor Browser (then click 'Detect Tor port'), or install "
                    "the Tor Expert Bundle from torproject.org."
                    if sys.platform == "win32" else
                    "Install it: 'sudo apt install tor' / 'brew install tor', or "
                    "open Tor Browser and click 'Detect Tor port'.")
            return {"ok": False, "proxy": None, "started": False,
                    "detail": "No installed 'tor' binary found. " + hint}
        try:
            _TOR_PROC = subprocess.Popen(
                [tor_bin], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL, cwd=os.path.dirname(tor_bin) or None)
        except Exception as e:                        # noqa: BLE001
            return {"ok": False, "proxy": None, "started": False,
                    "detail": f"found tor at {tor_bin} but could not launch it: {str(e)[:100]}"}
    # Poll (outside the lock) until tor bootstraps and a real Tor check passes.
    for _ in range(60):
        time.sleep(1)
        if _TOR_PROC.poll() is not None:
            return {"ok": False, "proxy": None, "started": False,
                    "detail": f"tor exited immediately (code {_TOR_PROC.returncode}); "
                              "it may already be running or its data dir is not writable."}
        d = detect_tor_proxy("socks5h://127.0.0.1:9050")
        if d.get("ok"):
            return {"ok": True, "proxy": d["proxy"], "started": True,
                    "detail": "Launched Tor and verified the exit: " + d["proxy"]}
    return {"ok": False, "proxy": None, "started": True,
            "detail": "Launched tor but it did not verify within 60s (still "
                      "bootstrapping on a slow link?). Click 'Detect Tor port' shortly."}


def mandatory_preflight(params: dict) -> dict:
    """The NON-NEGOTIABLE OPSEC gate the pipeline cannot spend without.

    Two leak-critical facts, verified live against the operator's own
    machine every time, not offered as optional buttons:
      * traffic really exits through Tor (verify against check.torproject.org),
      * the daemon would not relay the transaction to raw-IP peers.

    Returns {"ok": bool, "checks": {name: {ok, detail, ...}}}. Never raises:
    validate_proxy / tor_recheck abort via SystemExit, which is caught here so
    a FAILED check BLOCKS the spend rather than killing the console. A spend
    is allowed only when every check is ok; the caller refuses otherwise.

    This runs at BOTH /api/preflight (so the page can show status and gate its
    own button) AND inside /run/run_pipeline (so a crafted request that skips
    the page still cannot spend without passing). GhostSpiral re-checks the
    same things at its own Stage 0 — this is a deliberate second, independent
    gate at the console layer, not a replacement for it.
    """
    try:
        gs = _gs_common()
    except Exception as e:                              # noqa: BLE001
        # gs_common pulls in tenacity / stem / requests / PySocks. If a
        # dependency is not installed, say so clearly and BLOCK the spend
        # (ok=False) rather than throw a raw 500 the operator cannot read.
        missing = str(e)
        hint = ("install the requirements: pip install -r requirements.txt"
                if "No module named" in missing else missing[:120])
        return {"ok": False, "checks": {"deps": {
            "ok": False,
            "detail": f"console cannot load its dependencies — {hint}"}}}
    checks: dict = {}
    tor = (params.get("tor_proxy") or "").strip()
    if not tor:
        checks["tor"] = {"ok": False, "detail": "no Tor proxy configured"}
        return {"ok": False, "checks": checks}
    try:
        proxy = gs.validate_proxy(tor)
        gs.tor_recheck(proxy, "console_preflight")   # single-shot; SystemExit on fail
        checks["tor"] = {"ok": True, "state": "ok", "label": "Traffic exits via Tor",
                         "detail": "traffic verified exiting via Tor"}
    except SystemExit as e:
        _d = (str(e).strip().splitlines() or ["Tor check failed"])[0][:150]
        checks["tor"] = {"ok": False, "detail": _d + " — is Tor running? Click "
                         "'Detect Tor port', or start Tor Browser (port 9150) or "
                         "tor.exe (port 9050)."}
        return {"ok": False, "checks": checks}
    except Exception as e:                            # noqa: BLE001
        checks["tor"] = {"ok": False, "detail": f"Tor check error: {str(e)[:120]} — is "
                         "Tor running? Click 'Detect Tor port'."}
        return {"ok": False, "checks": checks}

    from urllib.parse import urlparse as _up
    daemon = (params.get("rpc_daemon") or "http://127.0.0.1:18081")
    host = (_up(daemon).hostname or "").lower()
    proxies = proxy if host not in gs._LOCALHOST_NAMES else None
    allow_clear = bool(params.get("allow_clearnet_relay"))
    try:
        eg = gs.check_daemon_relay_egress(daemon, proxies)
    except Exception as e:                            # noqa: BLE001
        eg = {"verdict": "unknown", "detail": f"egress probe error: {str(e)[:100]}"}
    verdict = eg.get("verdict", "unknown")
    # THREE STATES, NOT TWO. `ok` decides whether the spend is permitted;
    # `state` decides what the operator is TOLD. Collapsing them made the page
    # assert things that were not true:
    #
    #   * verdict "unknown" rendered as "✓ Relay egress not clearnet" -- and
    #     unknown is the DEFAULT for a freshly started daemon ("no peer
    #     connections yet"), a restricted RPC, or any probe error. The page
    #     claimed a fact it had explicitly failed to establish.
    #   * verdict "clearnet" WITH --allow-clearnet-relay also rendered as
    #     "✓ Relay egress not clearnet", i.e. the exact opposite of the
    #     measurement. Overriding is the operator's call; being told the
    #     egress is clean while overriding it is not.
    #
    # GhostSpiral's Stage 0 proceeds on unknown with a printed warning, so the
    # spend stays PERMITTED here for the same verdicts it permits -- diverging
    # would push operators toward --allow-clearnet-relay, which switches the
    # check off for the case it exists to catch. Only the honesty changes.
    if verdict == "clearnet":
        eok = allow_clear
        state = "warn" if allow_clear else "fail"
        label = "Relay egress IS CLEARNET"
        detail = eg.get("detail", "relays to raw-IP peers")
        if allow_clear:
            detail += " — you overrode this with 'Allow clearnet relay'"
    elif verdict == "offline":
        eok, state = False, "fail"
        label = "Daemon is offline"
        detail = eg.get("detail", "daemon is --offline; the broadcast would go nowhere")
    elif verdict == "tor":
        eok, state = True, "ok"
        label = "Relay egress not clearnet"
        detail = eg.get("detail", verdict)
    else:
        eok, state = True, "warn"
        label = "Relay egress NOT VERIFIED"
        detail = (eg.get("detail", "could not observe where this daemon relays")
                  + " — treat the broadcast as clearnet unless you set "
                    "monerod --tx-proxy")
    checks["egress"] = {"ok": eok, "state": state, "verdict": verdict,
                        "label": label, "detail": detail}

    return {"ok": all(c["ok"] for c in checks.values()),
            "warn": any(c.get("state") == "warn" for c in checks.values()),
            "checks": checks}


class H(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json"):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code); self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        # Defense in depth for the token, which rides in the page URL (?t=...):
        #  * no-referrer   -> the tokened URL is never sent as a Referer, so
        #                     even a future edit that pulls in an external
        #                     resource cannot leak the token off-box.
        #  * CSP default-src 'self' + connect-src 'self' -> the page can only
        #    ever talk back to this loopback origin; no script it might acquire
        #    can exfiltrate output, tokens, or the composed argv to a remote host.
        #  * frame-ancestors 'none' -> cannot be framed (clickjacking / rebinding
        #    dressed up as an iframe).
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; script-src 'unsafe-inline' 'self'; "
                         "style-src 'unsafe-inline' 'self'; connect-src 'self'; "
                         "img-src 'self' data:; base-uri 'none'; form-action 'none'; "
                         "frame-ancestors 'none'")
        self.end_headers()
        self.wfile.write(b)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 64 * 1024:                       # nothing legitimate is larger
            return {}
        try:
            return json.loads(self.rfile.read(n) or b"{}")
        except json.JSONDecodeError:
            return {}

    # ── gates. Any one failing rejects the request. ────────────────────────
    def _host_ok(self):
        """Host must name loopback. Blocks DNS rebinding: an attacker domain
        that resolves to 127.0.0.1 still sends its own name here."""
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip()
        return host in ALLOWED_HOSTS

    def _origin_ok(self):
        """Reject any cross-origin request. A same-origin fetch from our own
        page sends either no Origin or our own; a hostile page cannot forge it."""
        o = self.headers.get("Origin")
        if not o:
            return True                          # same-origin fetch / curl
        return o.rsplit(":", 1)[0].removeprefix("http://").removeprefix("https://") \
            in ALLOWED_HOSTS

    def _token_ok(self):
        """Constant-time token check. The token rides in a CUSTOM header, which
        a cross-origin <form> cannot set -- so this alone defeats the CSRF path
        even before the content-type gate."""
        t = self.headers.get("X-GS-Token") or ""
        if not t:                                # allow ?t= for the initial GET
            from urllib.parse import urlparse, parse_qs
            t = (parse_qs(urlparse(self.path).query).get("t") or [""])[0]
        return hmac.compare_digest(t, TOKEN)

    def _json_ct_ok(self):
        """POST must be application/json. That content type is NOT CORS-simple,
        so a cross-origin attempt needs a preflight, which we never answer."""
        ct = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        return ct == "application/json"

    def _guard(self, need_json):
        if not self._host_ok():
            self._send(403, json.dumps({"error": "host not loopback"})); return False
        if not self._origin_ok():
            self._send(403, json.dumps({"error": "cross-origin request refused"})); return False
        if need_json and not self._json_ct_ok():
            self._send(415, json.dumps({"error": "Content-Type must be application/json"})); return False
        if not self._token_ok():
            self._send(401, json.dumps({"error": "missing or bad console token"})); return False
        return True

    def do_GET(self):
        base = self.path.split("?")[0]
        if base == "/favicon.ico":
            # The browser probes this automatically with no token; answering
            # 204 keeps a legitimate load from logging a spurious 401.
            return self._send(204, b"", "image/x-icon")
        if not self._guard(need_json=False):
            return
        if base in ("/", "/index.html"):
            meta = {k: {"label": v["label"], "desc": v["desc"],
                        "group": v["group"], "risk": v["risk"]}
                    for k, v in ACTIONS.items()}
            page = PAGE.replace("__ACTIONS__", json.dumps(meta)) \
                       .replace("__ARM__", json.dumps(ARM_PHRASE)) \
                       .replace("__TOKEN__", json.dumps(TOKEN)) \
                       .replace("__PWSET__", json.dumps(bool(os.environ.get("GS_WALLET_PASSWORD")))) \
                       .replace("__XMR_RE__", _js_xmr_re())
            self._send(200, page, "text/html; charset=utf-8")
        elif base.startswith("/job/"):
            j = JOBS.get(base[5:])
            if not j:
                return self._send(404, json.dumps({"error": "no such job"}))
            with LOCK:
                self._send(200, json.dumps({
                    "lines": j["lines"], "done": j["done"], "rc": j["rc"],
                    "label": j["label"],
                    "elapsed": j.get("elapsed", round(time.time() - j["started"], 1))}))
        else:
            self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        if not self._guard(need_json=True):
            return
        if self.path == "/api/preview":
            c = clean(self._body().get("params"))
            argv, why = pipeline_argv(c["params"])
            return self._send(200, json.dumps({
                "argv": argv, "pretty": " ".join(shlex.quote(x) for x in argv),
                "problems": c["errors"] + why,
                "notes": run_notes(c["params"]),
                "eta": run_eta(c["params"])}))
        if self.path == "/api/fees":
            c = clean(self._body().get("params"))
            return self._send(200, json.dumps(
                live_fees(c["params"].get("rpc_daemon", "http://127.0.0.1:18081"),
                          c["params"].get("tor_proxy", ""),
                          c["params"].get("wallets"),
                          c["params"].get("deep"),
                          c["params"])))
        if self.path == "/api/preflight":
            c = clean(self._body().get("params"))
            return self._send(200, json.dumps(mandatory_preflight(c["params"])))
        if self.path == "/api/detect-tor":
            c = clean(self._body().get("params"))
            return self._send(200, json.dumps(
                detect_tor_proxy(c["params"].get("tor_proxy", ""))))
        if self.path == "/api/start-tor":
            return self._send(200, json.dumps(start_tor()))
        if self.path == "/api/detect-daemon":
            c = clean(self._body().get("params"))
            return self._send(200, json.dumps(detect_daemon(
                c["params"].get("rpc_daemon", ""), c["params"].get("tor_proxy", ""))))
        if self.path.startswith("/run/"):
            aid = self.path[5:]
            act = ACTIONS.get(aid)
            if not act:
                return self._send(400, json.dumps({"error": "unknown action"}))
            body = self._body()
            c = clean(body.get("params"))
            if act["risk"] == "spends":
                if body.get("arm") != ARM_PHRASE:
                    return self._send(403, json.dumps(
                        {"error": f"this action moves funds; it requires the arm phrase "
                                  f"'{ARM_PHRASE}'"}))
                argv, why = pipeline_argv(c["params"])
                if c["errors"] or why:
                    return self._send(400, json.dumps({"error": "; ".join(c["errors"] + why)}))
                # NON-NEGOTIABLE: run the OPSEC preflight server-side and refuse
                # to launch if Tor is not verified or the daemon would relay to
                # clearnet. This is enforced HERE, not just in the page, so a
                # request that bypasses the UI still cannot spend without it.
                pf = mandatory_preflight(c["params"])
                if not pf["ok"]:
                    bad = "; ".join(f"{k}: {v.get('detail', 'failed')}"
                                    for k, v in pf["checks"].items() if not v["ok"])
                    try:
                        _gs_common().integrity_log("console", "run_pipeline_BLOCKED_preflight")
                    except Exception:
                        pass
                    return self._send(403, json.dumps(
                        {"error": f"Preflight FAILED — refusing to spend. {bad}",
                         "preflight": pf}))
            else:
                # Validation errors were previously ignored for `safe` actions.
                # clean() DROPS a parameter it cannot validate, so a malformed
                # Tor proxy or RPC URL silently became an empty argument and
                # the action ran with different settings than the page showed.
                # Refuse instead, and say which field is wrong.
                if c["errors"]:
                    return self._send(400, json.dumps({"error": "; ".join(c["errors"])}))
                argv = act["build"](c["params"])
            return self._send(200, json.dumps(
                {"jid": start(argv, act["label"], action_id=aid,
                              extra_env=secret_env(c["params"]),
                              timeout_s=job_timeout_for(c["params"]))}))
        if self.path.startswith("/stop/"):
            return self._send(200, json.dumps({"stopped": stop(self.path[6:])}))
        self._send(404, json.dumps({"error": "not found"}))

    def log_message(self, *a):
        pass


