.rstep>div{flex:1;min-width:0}
.rn{flex:0 0 26px;height:26px;border-radius:50%;background:#1E2A36;color:#8FA6BC;
    display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600}
