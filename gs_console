# ── request authentication ─────────────────────────────────────────────────
# A localhost server that can spend money is reachable by EVERY page the
# operator's browser loads. Verified against an earlier build of this file:
#   * a cross-origin POST with Content-Type: text/plain started a job. That
#     content type is "simple" per CORS, so an attacker's <form> reaches us
#     with no preflight and no consent.
#   * a spoofed Host header was accepted, so a hostile domain resolving to
#     127.0.0.1 (DNS rebinding) could drive the console.
#   * nothing required credentials at all.
# Four independent gates now close that, checked on every request:
TOKEN = secrets.token_urlsafe(24)          # per-run, printed once at startup
ALLOWED_HOSTS = {"127.0.0.1", "localhost", "[::1]"}
MAX_JOBS = 200                             # bound the in-memory job table

# HOW LONG A JOB MAY RUN, and this number used to be 4 * 3600 with the comment
# "nothing legitimate runs longer". The pipeline this console exists to drive
# says otherwise, in its own constants:
#
#   GhostSpiral.XMR_ARRIVAL_TIMEOUT   = 86400   (24h) the swap-arrival wait ALONE
#   GhostSpiral.FANOUT_CONFIRM_TIMEOUT = 3600   (1h)  waiting for the fan-out to unlock
#   GhostSpiral.HOP_DELAY_MAX = 7 * 24 * 3600  (7 days) per --hop-delay, PER HOP
#
# A cross-chain BTC->XMR swap settling in under four hours is the lucky case,
# not the ceiling, and --hop-delay exists precisely so an operator can spread
# the hops over days. So the console was killing correct, in-progress runs --
# and killing them at the single worst moment, because a run that is still
# going at four hours is one that is waiting on money.
#
# WORSE THAN LOSING THE RUN: the kill was SIGKILL, which cannot be caught, so
# NO `finally` BLOCK RUNS. Those finally blocks are what erase
#   * the WALLET SPEND-KEY PASSWORD  (airgap_tx_signer, four sites)
#   * the EXIT PLAN carrying --exit-to (GhostSpiral._run_exit_withdrawals)
#   * the peel and change-sweep plans (destinations and amounts)
#   * every staging directory of signed transaction blobs
# so a timed-out run left the wallet password and the operator's final
# destination sitting on disk in plaintext. The tools all install SIGTERM
# handlers (gs_common.install_signal_handlers) and shut down cleanly on it --
# the manual stop button has always sent SIGTERM. Only the watchdog reached for
# SIGKILL, and only the watchdog fired unattended.
#
# The floor below is the sum of the three constants above: the arrival wait,
# the fan-out confirm, and one maximum hop delay. It is deliberately generous,
# because the cost of killing a live run is stranded funds plus secrets on
# disk, while the cost of a hung job living too long is a stale row in a table
# the operator can clear with the stop button. tests/test_console.py ENFORCES
# that it stays at or above what GhostSpiral's own constants imply -- a comment
# asking two numbers to stay in sync is a hope, not a guarantee.
JOB_TIMEOUT_FLOOR_S = 86400 + 3600 + 7 * 24 * 3600
JOB_TIMEOUT_S = JOB_TIMEOUT_FLOOR_S        # overridable with --job-timeout

# Grace period between SIGTERM and SIGKILL. The tools catch SIGTERM, stop at
# their next checkpoint and run their cleanup; secure_delete overwrites before
# unlinking, and a peel/exit round may have several plans and a staging tree to
# erase. Long enough for that to finish, short enough that a truly wedged
# process still goes away.
JOB_TERM_GRACE_S = 30

# ── parameter schema. Anything not here cannot reach an argv. ───────────────
#: socks5h://[user:pass@]host:port -- the userinfo is Tor stream isolation
#: (IsolateSOCKSAuth), not decoration. gs_common.SOCKS_RE accepts it and the
#: console must not be the component that forbids it.
SOCKS_RE = re.compile(r"^socks5h://([A-Za-z0-9._-]+:[A-Za-z0-9._-]*@)?[A-Za-z0-9._-]+:\d{1,5}$")
URL_RE = re.compile(r"^https?://[A-Za-z0-9._\-]+(:\d{1,5})?$")
BTC_RE = re.compile(r"^(bc1|tb1)[ac-hj-np-z02-9]{25,59}$", re.I)
PATH_RE = re.compile(r"^[A-Za-z0-9._/\-]{1,200}$")
DEC_RE = re.compile(r"^\d{1,10}(\.\d{1,12})?$")
#: --hop-delay, as GhostSpiral.parse_hop_delay accepts it: "SECONDS" or
#: "MIN-MAX" seconds. Bounds are re-checked by parse_hop_delay itself (negative,
#: backwards, and > HOP_DELAY_MAX all raise there); this only has to keep
#: anything that is not that shape off the argv.
HOPDELAY_RE = re.compile(r"^\d{1,7}(-\d{1,7})?$")
#: Monero address: 95 chars, base58 (no 0OIl), 4/8 prefix. Standard AND
#: subaddress forms both start 4/8 and both are legitimate exit destinations --
#: an exchange deposit address is normally a subaddress. This is a FORMAT check
#: only; the CHECKSUM is verified by GhostSpiral's resolve_exit_destinations
#: before anything moves, because a stdlib-only console cannot compute Monero's
#: keccak variant and inventing a weaker check here would be worse than none.
#: Same shape gs_common.XMR_ADDR_RE accepts, and it must stay that way: the
#: console is a FORMAT gate in front of the checksum check GhostSpiral runs, so
#: anything it refuses here the operator can never submit at all.
#:
#: The old class [0-9AB] for the second character was wrong about MAINNET. It
#: included '0', which base58 does not contain, and excluded real ones: a
#: mainnet subaddress beginning "8C" (1.586% of the subaddress keyspace, ~1 in
#: 63) was rejected by the form, as was every integrated address -- both by the
#: character class and by the 95-only length. tests/test_console.py enforces
#: that this and gs_common.XMR_ADDR_RE accept exactly the same strings.
_B58_C = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
XMR_RE = re.compile(f"^[48][{_B58_C}]{{94}}$|^4[{_B58_C}]{{105}}$")


def _js_xmr_re() -> str:
    """XMR_RE as a JavaScript literal, so the page cannot drift from the server.

    The page hand-copied this pattern and the copy went stale: it was still the
    pre-fix `[48][0-9AB]...{93}` while the Python side had been corrected. The
    page is where an operator's exit addresses are judged, and the box tells
    them a rejected one "will be refused before it starts" -- a claim about the
    server, made by a regex the server does not use.

    Derived rather than duplicated. The character class is written as a range
    set because a 58-character literal class in a JS regex is legal but
    unreadable; it is asserted equal to _B58_C in tests/test_console.py, which
    already pins XMR_RE against gs_common.XMR_ADDR_RE for the same reason.
    """
    cls = "[1-9A-HJ-NP-Za-km-z]"
    return f"/^[48]{cls}{{94}}$|^4{cls}{{105}}$/"


