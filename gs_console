    "btc_entry":    ("re", BTC_RE),
    "receive_wallet": ("re", PATH_RE),
    "pairs_file":   ("re", PATH_RE),
    "swap_btc":     ("re", DEC_RE),
    "btc_amount":   ("re", DEC_RE),
