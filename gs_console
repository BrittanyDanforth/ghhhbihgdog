#!/usr/bin/env python3
"""GhostSpiral operator console — one surface for the whole pipeline.

    python3 gs_console              # http://127.0.0.1:8765
    python3 gs_console --port 9000

Send or receive, fee selection with LIVE per-priority estimates pulled from
your own daemon, safety presets, preflight checks, the exact command preview,
and live output — in one page.

SAFETY MODEL, because this can spend money:

  * Binds 127.0.0.1 ONLY. Never all interfaces.
  * The browser NEVER supplies a command. It posts an action id plus typed
    parameters; this file validates every one against its own schema and
    COMPOSES the argv. There is no path from a request string to a shell.
  * Actions are graded. `safe` actions (checks, dry-runs, tests) run on click.
    `spends` actions (the pipeline itself) refuse unless the request carries
    the exact arm phrase, which the UI only sends after you type it.
  * shell=False everywhere. No shell metacharacter can matter.
  * The wallet password is taken from the GS_WALLET_PASSWORD environment of
    the console process and forwarded ONLY to the pipeline child. It is never
    accepted over HTTP, never rendered, and never written to the command
    preview — the preview shows the real argv, which by design has no
    password on it.

Stdlib only, so it runs on the air-gapped machine too.
"""
from __future__ import annotations
import argparse, hmac, json, os, re, secrets, shlex, signal, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

REPO = os.path.dirname(os.path.abspath(__file__))
PY = sys.executable
VENV_PY = os.environ.get("GS_VENV_PY", PY)
ARM_PHRASE = "SPEND"

# ── request authentication ─────────────────────────────────────────────────
# A localhost server that can spend money is reachable by EVERY page the
# operator's browser loads. Verified against an earlier build of this file:
#   * a cross-origin POST with Content-Type: text/plain started a job. That
#     content type is "simple" per CORS, so an attacker's <form> reaches us
#     with no preflight and no consent.
#   * a spoofed Host header was accepted, so a hostile domain resolving to
#     127.0.0.1 (DNS rebinding) could drive the console.
#   * nothing required credentials at all.
# Four independent gates now close that, checked on every request:
TOKEN = secrets.token_urlsafe(24)          # per-run, printed once at startup
ALLOWED_HOSTS = {"127.0.0.1", "localhost", "[::1]"}
MAX_JOBS = 200                             # bound the in-memory job table
JOB_TIMEOUT_S = 4 * 3600                   # nothing legitimate runs longer

# ── parameter schema. Anything not here cannot reach an argv. ───────────────
SOCKS_RE = re.compile(r"^socks5h://[A-Za-z0-9._-]+:\d{1,5}$")
URL_RE = re.compile(r"^https?://[A-Za-z0-9._\-]+(:\d{1,5})?$")
BTC_RE = re.compile(r"^(bc1|tb1)[ac-hj-np-z02-9]{25,59}$", re.I)
PATH_RE = re.compile(r"^[A-Za-z0-9._/\-]{1,200}$")
DEC_RE = re.compile(r"^\d{1,10}(\.\d{1,12})?$")

SCHEMA = {
    "mode":         ("choice", ["send", "receive"]),
    "btc_entry":    ("re", BTC_RE),
    "receive_wallet": ("re", PATH_RE),
    "btc_amount":   ("re", DEC_RE),
    "split":        ("int", (1, 20)),
    "wallets":      ("int", (3, 60)),
    "deep":         ("int", (1, 6)),
    "fee_priority": ("int", (1, 4)),
    "dag_mixing":   ("bool", None),
    "joinmarket":   ("bool", None),
    "allow_clearnet_relay": ("bool", None),
    "tor_proxy":    ("re", SOCKS_RE),
    "rpc_primary":  ("re", URL_RE),
    "rpc_daemon":   ("re", URL_RE),
    "wallet_file":  ("re", PATH_RE),
    "output":       ("re", PATH_RE),
    "label":        ("re", re.compile(r"^[A-Za-z0-9 ._-]{1,40}$")),
}


def clean(params: dict) -> dict:
    """Validate every parameter against SCHEMA. Unknown keys are dropped."""
    out, errs = {}, []
    for k, v in (params or {}).items():
        if k not in SCHEMA:
            continue
        kind, spec = SCHEMA[k]
        try:
            if kind == "bool":
                out[k] = bool(v)
            elif kind == "int":
                n = int(v)
                if not (spec[0] <= n <= spec[1]):
                    errs.append(f"{k} must be {spec[0]}–{spec[1]} (got {n})")
                else:
                    out[k] = n
            elif kind == "choice":
                if v not in spec:
                    errs.append(f"{k} must be one of {spec}")
                else:
                    out[k] = v
            elif kind == "re":
                s = str(v).strip()
                if s and not spec.match(s):
                    errs.append(f"{k} is not a valid {k.replace('_',' ')}: {s[:48]}")
                elif s:
                    out[k] = s
        except (TypeError, ValueError):
            errs.append(f"{k} is not readable")
    return {"params": out, "errors": errs}


def pipeline_argv(p: dict) -> tuple[list, list]:
    """Compose the GhostSpiral argv from validated params. Returns (argv, problems)."""
    a, why = [PY, "GhostSpiral"], []
    if p.get("mode") == "receive":
        if not p.get("receive_wallet"):
            why.append("Receive mode needs the wallet JSON from create_receive_wallet.")
        else:
            a += ["--receive-wallet", p["receive_wallet"]]
    else:
        if not p.get("btc_entry"):
            why.append("Send mode needs a BTC entry address (bech32).")
        else:
            a += ["--btc-entry", p["btc_entry"]]
        if p.get("btc_amount"):
            a += ["--btc-amount", p["btc_amount"]]
        else:
            why.append("Send mode needs a BTC amount.")
        if p.get("split", 1) > 1:
            a += ["--split", str(p["split"])]
        if p.get("joinmarket"):
            a.append("--joinmarket")
    if not p.get("tor_proxy"):
        why.append("A socks5h:// Tor proxy is required — the pipeline refuses to run without one.")
    else:
        a += ["--tor-proxy", p["tor_proxy"]]
    a += ["--wallets", str(p.get("wallets", 10)),
          "--deep", str(p.get("deep", 2)),
          "--fee-priority", str(p.get("fee_priority", 1))]
    if p.get("dag_mixing"):
        a.append("--dag-mixing")
    for flag, key in (("--rpc-primary", "rpc_primary"), ("--rpc-daemon", "rpc_daemon"),
                      ("--wallet-file", "wallet_file"), ("--output", "output")):
        if p.get(key):
            a += [flag, p[key]]
    if p.get("allow_clearnet_relay"):
        a.append("--allow-clearnet-relay")
    return a, why


