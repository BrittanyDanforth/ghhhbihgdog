/* Operations as a compact GRID of tiles instead of stacked full-width rows,
   so the four groups read as one dense board rather than list-after-list. */
.ops{display:grid;grid-template-columns:repeat(auto-fill,minmax(172px,1fr));gap:8px}
.opgroup{grid-column:1/-1;font-family:ui-monospace,Menlo,monospace;font-size:10px;letter-spacing:.14em;
