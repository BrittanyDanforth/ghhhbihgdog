// ── NON-NEGOTIABLE OPSEC preflight ─────────────────────────────────────────
// Auto-runs on load and whenever the network config changes; the spend button
// is disabled until it passes, and the SERVER re-verifies it on run so a
// crafted request cannot skip it. Tor exit + relay egress are the leak-critical
// facts, verified live rather than trusted.
let preflightOk=false, pfBusy=false, pfSeq=0;
function renderPreflight(r){
 const c=(r&&r.checks)||{};
 // THREE states. A check that passed the SPEND GATE is not necessarily a check
 // that VERIFIED anything: an unknown relay egress permits the spend (matching
 // the pipeline) but has established nothing, and an overridden clearnet egress
 // permits it while the measurement says the opposite. Both used to render as a
 // green tick reading "Relay egress not clearnet".
 const head=!r||!r.ok
  ? `<div class="pfhead bad">✕ OPSEC preflight FAILED — spend blocked until fixed</div>`
  : (r.warn
     ? `<div class="pfhead warn">! OPSEC preflight passed WITH WARNINGS — read them before spending</div>`
     : `<div class="pfhead ok">✓ OPSEC preflight passed — spend permitted</div>`);
 // The label comes from the SERVER, per verdict, so the page cannot assert a
 // fact the check did not establish.
 const row=k=>{const v=c[k]; if(!v) return '';
  const st=v.state||(v.ok?'ok':'fail');
  const mark=st==='ok'?'✓':(st==='warn'?'!':'✕');
  return `<div class="pfrow ${st}"><span>${mark} ${esc(v.label||k)}</span>`
    +`<span class="pfd">${esc(v.detail||'')}</span></div>`;};
 $('#pfstatus').innerHTML=head+row('tor')+row('egress')+row('deps');
}
async function runPreflight(){
 if(pfBusy) return; pfBusy=true; const seq=++pfSeq;
 $('#pfstatus').innerHTML='<div class="pfhead run">⟳ running OPSEC preflight (verifying Tor + relay egress)…</div>';
 let r=null;
 try{ r=await fetch('/api/preflight',{method:'POST',headers:HDR,
      body:JSON.stringify({params:collect()})}).then(x=>x.json()); }
 catch(e){ r={ok:false,checks:{tor:{ok:false,detail:'preflight request failed: '+e}}}; }
 pfBusy=false;
 if(seq!==pfSeq) return;            // a newer preflight superseded this one
 preflightOk=!!(r&&r.ok); renderPreflight(r); sync();
}
// Find the Tor SOCKS port automatically (9050 tor.exe / 9150 Tor Browser) and
// fill it in, so the operator never has to know which one their Tor uses.
let detectBusy=false;
async function detectTor(silent){
 if(detectBusy) return; detectBusy=true;
 const btn=$('#pfdetect'); if(btn){btn.disabled=true;btn.textContent='Detecting Tor…';}
 if(!silent) $('#pfstatus').innerHTML='<div class="pfhead run">⟳ probing Tor ports (9050, 9150)…</div>';
 let r=null;
 try{ r=await fetch('/api/detect-tor',{method:'POST',headers:HDR,
      body:JSON.stringify({params:collect()})}).then(x=>x.json()); }
 catch(e){ r={ok:false,detail:'detect request failed: '+e}; }
 if(btn){btn.disabled=false;btn.textContent='Detect Tor port';}
 detectBusy=false;
 if(r&&r.ok&&r.proxy){
  $('#tor_proxy').value=r.proxy;      // fill the working proxy
  await runPreflight();               // and re-verify with it
  return true;
 }
 if(!silent) $('#pfstatus').innerHTML=
   `<div class="pfhead bad">✕ ${esc((r&&r.detail)||'no Tor proxy found')}</div>`;
 return false;
}
