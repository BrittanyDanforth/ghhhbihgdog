header{display:flex;gap:13px;align-items:baseline;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:18px}
h1{margin:0;font-size:21px;font-weight:650;letter-spacing:-.02em}
.eb{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--acc)}
.hint{color:var(--mut);font-size:12px;margin-left:auto;font-family:ui-monospace,Menlo,monospace}
.cols{display:grid;grid-template-columns:minmax(320px,410px) 1fr;gap:20px;align-items:start}
@media(max-width:1000px){.cols{grid-template-columns:1fr}}
.card{background:var(--sf);border:1px solid var(--line);border-radius:11px;padding:15px 16px;margin-bottom:14px}
h2{font-family:ui-monospace,Menlo,monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;
color:var(--mut);font-weight:600;margin:0 0 12px}
.seg{display:flex;gap:0;border:1px solid var(--line2);border-radius:9px;overflow:hidden;margin-bottom:13px}
.seg button{flex:1;font:inherit;font-size:13px;padding:9px;border:0;background:var(--sf);color:var(--ink2);cursor:pointer}
.seg button[aria-pressed=true]{background:var(--ink);color:var(--bg);font-weight:600}
.f{display:grid;grid-template-columns:112px 1fr;gap:8px 11px;align-items:center;margin-bottom:9px}
.f label{font-size:12px;color:var(--mut)}
.f input,.f select{font:inherit;font-size:12.5px;padding:6px 9px;border-radius:7px;width:100%;
border:1px solid var(--line2);background:var(--bg);color:var(--ink);font-family:ui-monospace,Menlo,monospace}
.f input:invalid{border-color:var(--err)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.chk{display:flex;gap:8px;align-items:flex-start;margin-bottom:8px;cursor:pointer;font-size:12.5px}
.chk input{margin-top:2px}
.chk .d{color:var(--mut);font-size:11.5px;display:block;line-height:1.35}
.presets{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:4px}
.presets button{font:inherit;font-size:12px;padding:6px 11px;border-radius:99px;cursor:pointer;
border:1px solid var(--line2);background:var(--bg);color:var(--ink2)}
.presets button:hover{border-color:var(--acc);color:var(--ink)}
.presets button[aria-pressed=true]{background:var(--accs);border-color:var(--acc);color:var(--acc);font-weight:600}
.fees{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:9px}
.fee{border:1px solid var(--line2);border-radius:8px;padding:7px 6px;text-align:center;cursor:pointer;background:var(--bg)}
.fee[aria-pressed=true]{border-color:var(--acc);background:var(--accs)}
.fee .p{font-size:10px;font-family:ui-monospace,Menlo,monospace;color:var(--mut);letter-spacing:.06em}
.fee .v{font-size:12px;font-weight:650;margin-top:3px;font-variant-numeric:tabular-nums}
.fee[aria-pressed=true] .v{color:var(--acc)}
.fsrc{font-size:11px;color:var(--mut);margin-top:7px;font-family:ui-monospace,Menlo,monospace}
.act{display:flex;gap:9px;align-items:center;width:100%;text-align:left;cursor:pointer;background:var(--bg);
border:1px solid var(--line);border-radius:9px;padding:9px 11px;margin-bottom:6px;color:var(--ink);font:inherit}
.act:hover{border-color:var(--acc)}
.act:disabled{opacity:.5;cursor:not-allowed}
.act .nm{font-size:13px;font-weight:600}
.act .ds{font-size:11.5px;color:var(--mut);margin-top:2px;line-height:1.35}
.act .go{margin-left:auto;font-family:ui-monospace,Menlo,monospace;font-size:9.5px;letter-spacing:.09em;
text-transform:uppercase;padding:4px 8px;border-radius:5px;white-space:nowrap;background:var(--accs);color:var(--acc)}
.act.spends .go{background:var(--errs);color:var(--err)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--line2);flex:none}
.dot.run{background:var(--warn);box-shadow:0 0 0 3px var(--warns);animation:p 1s infinite}
.dot.ok{background:var(--ok);box-shadow:0 0 0 3px var(--oks)}
.dot.err{background:var(--err);box-shadow:0 0 0 3px var(--errs)}
@keyframes p{50%{opacity:.35}}
@media(prefers-reduced-motion:reduce){.dot.run{animation:none}}
pre.prev{margin:0;background:var(--term);color:var(--ti);padding:11px 13px;border-radius:8px;
font-family:ui-monospace,Menlo,monospace;font-size:11.5px;line-height:1.6;white-space:pre-wrap;word-break:break-all;max-height:150px;overflow:auto}
.probs{margin:9px 0 0;padding:0;list-style:none}
.probs li{font-size:12px;color:var(--err);background:var(--errs);padding:6px 9px;border-radius:6px;margin-bottom:4px}
.arm{margin-top:11px;padding:11px;border:1px dashed var(--err);border-radius:9px;background:var(--errs)}
.arm p{margin:0 0 8px;font-size:12px;color:var(--err);line-height:1.45}
.arm input{font-family:ui-monospace,Menlo,monospace;font-size:12.5px;padding:6px 9px;border-radius:7px;
border:1px solid var(--err);background:var(--bg);color:var(--ink);width:100%}
.panel{background:var(--sf);border:1px solid var(--line);border-radius:11px;overflow:hidden;position:sticky;top:16px}
.pbar{display:flex;gap:11px;align-items:center;padding:10px 13px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.pt{font-size:13px;font-weight:650}
.pm{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:var(--mut)}
.pill{font-family:ui-monospace,Menlo,monospace;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;
padding:3px 8px;border-radius:5px;font-weight:600}
.pill.run{background:var(--warns);color:var(--warn)}.pill.ok{background:var(--oks);color:var(--ok)}
.pill.err{background:var(--errs);color:var(--err)}
.pacts{margin-left:auto;display:flex;gap:6px}
.pacts button{font:inherit;font-size:11.5px;padding:5px 10px;border-radius:7px;cursor:pointer;
background:transparent;border:1px solid var(--line2);color:var(--ink2)}
.pacts button:hover{border-color:var(--acc);color:var(--ink)}
.pacts button.stop{color:var(--err);border-color:var(--err)}
pre.out{margin:0;background:var(--term);color:var(--ti);padding:13px 15px;overflow:auto;
max-height:min(70vh,760px);font-family:ui-monospace,Menlo,monospace;font-size:12.5px;line-height:1.55;white-space:pre-wrap;word-break:break-word}
pre.out .g{color:#5FD3A6}pre.out .r{color:#F58C82}pre.out .y{color:#E6BC6A}pre.out .d{color:#6B7A88}
.idle{padding:44px 20px;text-align:center;color:var(--mut);font-size:13px}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.warnbox{font-size:11.5px;color:var(--warn);background:var(--warns);padding:8px 10px;border-radius:7px;margin-top:9px;line-height:1.45}
</style></head><body><div class="wrap">
<header><span class="eb">Console</span><h1>GhostSpiral</h1>
<span class="hint">127.0.0.1 · argv composed server-side · funds need arming</span></header>
<div class="cols">
<div>
  <div class="card"><h2>Direction</h2>
    <div class="seg" id="mode">
      <button data-m="send" aria-pressed="true">Send · BTC → XMR</button>
      <button data-m="receive" aria-pressed="false">Receive · XMR in</button>
    </div>
    <div id="send-fields">
      <div class="f"><label for="btc_entry">BTC entry</label><input id="btc_entry" placeholder="bc1q…"></div>
      <div class="f"><label for="btc_amount">BTC amount</label><input id="btc_amount" placeholder="0.05"></div>
      <div class="f"><label for="split">Split into</label><input id="split" type="number" min="1" max="20" value="1"></div>
      <label class="chk"><input type="checkbox" id="joinmarket">
        <span>JoinMarket tumble first<span class="d">extra BTC-side mixing before the swap</span></span></label>
    </div>
    <div id="recv-fields" style="display:none">
      <div class="f"><label for="receive_wallet">Wallet JSON</label><input id="receive_wallet" placeholder="wallet_ab12cd34.json"></div>
      <p style="font-size:12px;color:var(--mut);margin:4px 0 0;line-height:1.5">
        Produced by <strong>Create receive address</strong> below. Hand the address to the sender.</p>
    </div>
  </div>

  <div class="card"><h2>Safety preset</h2>
    <div class="presets" id="presets">
      <button data-p="max" aria-pressed="false">Maximum privacy</button>
      <button data-p="balanced" aria-pressed="true">Balanced</button>
      <button data-p="fast" aria-pressed="false">Fast</button>
    </div>
    <div id="preset-note" class="warnbox"></div>
    <div class="row2" style="margin-top:12px">
      <div class="f" style="grid-template-columns:76px 1fr"><label for="wallets">Wallets</label><input id="wallets" type="number" min="3" max="60" value="10"></div>
      <div class="f" style="grid-template-columns:56px 1fr"><label for="deep">Depth</label><input id="deep" type="number" min="1" max="6" value="2"></div>
    </div>
    <label class="chk"><input type="checkbox" id="dag_mixing" checked>
      <span>DAG hop-mixing<span class="d">second round of per-subaddress hops; waits for on-chain confirmation (~20 min longer)</span></span></label>
    <label class="chk"><input type="checkbox" id="allow_clearnet_relay">
      <span style="color:var(--err)">Allow clearnet relay<span class="d">proceed even when monerod would broadcast to raw-IP peers — reveals your IP</span></span></label>
  </div>

  <div class="card"><h2>Fee priority · live from your daemon</h2>
    <div class="fees" id="fees"></div>
    <div class="fsrc" id="fsrc">loading…</div>
  </div>

  <div class="card"><h2>Network</h2>
    <div class="f"><label for="tor_proxy">Tor proxy</label><input id="tor_proxy" value="socks5h://127.0.0.1:9050"></div>
    <div class="f"><label for="rpc_primary">Wallet RPC</label><input id="rpc_primary" value="http://127.0.0.1:18083"></div>
    <div class="f"><label for="rpc_daemon">Daemon RPC</label><input id="rpc_daemon" value="http://127.0.0.1:18081"></div>
    <div class="f"><label for="wallet_file">Wallet file</label><input id="wallet_file" value="offline.wallet"></div>
    <div id="pwnote" class="warnbox"></div>
  </div>

  <div class="card"><h2>Command that will run</h2>
    <pre class="prev" id="prev">…</pre>
    <ul class="probs" id="probs"></ul>
    <div class="arm" id="armbox" style="display:none">
      <p><strong>This moves funds.</strong> It fans out, signs and broadcasts real transactions.
      Type <strong id="armword"></strong> to unlock the run button.</p>
      <input id="arm" placeholder="type to arm" autocomplete="off">
    </div>
  </div>

  <div id="actions"></div>
</div>

<div class="panel">
  <div class="pbar"><span class="pt" id="pt">Nothing running</span>
    <span class="pill" id="ppill" style="display:none"></span><span class="pm" id="pm"></span>
    <span class="pacts"><button id="stop" class="stop">Stop</button><button id="copy">Copy</button></span></div>
  <div id="out"><div class="idle">Run a preflight check first — Tor exit, relay egress, then wallet balance.</div></div>
</div>
</div></div><script>
const A=__ACTIONS__, ARM=__ARM__, PWSET=__PWSET__, TOK=__TOKEN__;
const HDR={'Content-Type':'application/json','X-GS-Token':TOK};
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
let cur=null,timer=null,mode='send',preset='balanced',armed=false;

const PRESETS={
 max:{wallets:25,deep:3,dag_mixing:true,fee_priority:3,
      note:'25 subaddresses, depth 3, DAG hops on, priority 3. Widest anonymity set — slowest and highest fees.'},
 balanced:{wallets:10,deep:2,dag_mixing:true,fee_priority:2,
      note:'10 subaddresses, depth 2, DAG hops on, priority 2. Sensible default for most amounts.'},
 fast:{wallets:3,deep:1,dag_mixing:false,fee_priority:1,
      note:'3 subaddresses, depth 1, no DAG round, priority 1. Fan-out only — least mixing, cheapest, no confirmation wait.'}};

function applyPreset(p){
 preset=p; const c=PRESETS[p];
 $('#wallets').value=c.wallets; $('#deep').value=c.deep;
 $('#dag_mixing').checked=c.dag_mixing; setFee(c.fee_priority);
 $('#preset-note').textContent=c.note;
 $$('#presets button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.p===p)));
 sync();
}
$$('#presets button').forEach(b=>b.addEventListener('click',()=>applyPreset(b.dataset.p)));

let feePriority=2, feeData=null;
function renderFees(){
 const names=['1 · default','2 · elevated','3 · priority','4 · flash'];
 $('#fees').innerHTML=names.map((n,i)=>`<button class="fee" data-p="${i+1}" aria-pressed="${feePriority===i+1}">
   <div class="p">${n}</div><div class="v">${feeData?feeData.xmr[i]+' XMR':'—'}</div></button>`).join('');
 $$('.fee').forEach(b=>b.addEventListener('click',()=>{setFee(+b.dataset.p);sync();}));
 $('#fsrc').innerHTML=feeData
   ?('estimate per ~2 kB tx · '+feeData.source)
    +(feeData.warning?`<div class="warnbox" style="margin-top:7px">${feeData.warning}</div>`:'')
   :'loading…';
}
function setFee(p){feePriority=p;renderFees();}
async function loadFees(){
 feeData=await fetch('/api/fees',{method:'POST',headers:HDR,
   body:JSON.stringify({params:collect()})}).then(r=>r.json()).catch(()=>null);
 renderFees();
}

$$('#mode button').forEach(b=>b.addEventListener('click',()=>{
 mode=b.dataset.m;
 $$('#mode button').forEach(o=>o.setAttribute('aria-pressed',String(o===b)));
 $('#send-fields').style.display=mode==='send'?'':'none';
 $('#recv-fields').style.display=mode==='receive'?'':'none';
 sync();
}));

function collect(){
 const v=id=>$('#'+id)?.value.trim()||'';
 const c=id=>!!$('#'+id)?.checked;
 return {mode, btc_entry:v('btc_entry'), btc_amount:v('btc_amount'),
  receive_wallet:v('receive_wallet'), split:+v('split')||1,
  wallets:+v('wallets')||10, deep:+v('deep')||2, fee_priority:feePriority,
  dag_mixing:c('dag_mixing'), joinmarket:c('joinmarket'),
  allow_clearnet_relay:c('allow_clearnet_relay'), tor_proxy:v('tor_proxy'),
  rpc_primary:v('rpc_primary'), rpc_daemon:v('rpc_daemon'),
  wallet_file:v('wallet_file'), label:'GhostSpiral_entry'};
}

async function sync(){
 const r=await fetch('/api/preview',{method:'POST',headers:HDR,
   body:JSON.stringify({params:collect()})}).then(r=>r.json());
 $('#prev').textContent=r.pretty;
 $('#probs').innerHTML=r.problems.map(p=>`<li>${p.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</li>`).join('');
 const ok=!r.problems.length;
 $('#armbox').style.display=ok?'':'none';
 const btn=document.querySelector('.act[data-id="run_pipeline"]');
 if(btn) btn.disabled=!(ok&&armed)||!!cur;
}
$$('input,select').forEach(el=>el.addEventListener('input',()=>{ if(el.id!=='arm') sync(); }));
$('#arm').addEventListener('input',e=>{armed=e.target.value.trim()===ARM;sync();});
$('#armword').textContent=ARM;
$('#pwnote').innerHTML=PWSET
 ? 'Wallet password found in <code>GS_WALLET_PASSWORD</code> — forwarded only to the signing child, never shown here.'
 : 'No <code>GS_WALLET_PASSWORD</code> set. If your wallet has a password, restart the console with it exported — it is never accepted through this page.';

const groups={};
for(const [id,a] of Object.entries(A)) (groups[a.group] ||= []).push([id,a]);
$('#actions').innerHTML=Object.entries(groups).map(([g,items])=>
 `<div class="card"><h2>${g}</h2>`+items.map(([id,a])=>
  `<button class="act ${a.risk}" data-id="${id}" ${a.risk==='spends'?'disabled':''}>
    <span class="dot" id="dot-${id}"></span>
    <span><span class="nm">${a.label}</span><div class="ds">${a.desc}</div></span>
    <span class="go">${a.risk==='spends'?'Spends':'Run'}</span></button>`).join('')+`</div>`).join('');
$$('.act').forEach(b=>b.addEventListener('click',()=>run(b.dataset.id)));

function colour(l){
 const e=l.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
 if(/FAIL|LEAK |\bERROR\b|Traceback|CLEARNET|\[!\].*(?:leak|refus|abort)/i.test(l)) return `<span class="r">${e}</span>`;
 if(/RESULT:|ALL GREEN|SUCCESS|NO LEAKS|\[\+\]/.test(l)) return `<span class="g">${e}</span>`;
 if(/\[!\]|WARN|SKIP/.test(l)) return `<span class="y">${e}</span>`;
 if(/^\s*\[\*\]|^===/.test(l)) return `<span class="d">${e}</span>`;
 return e;
}
async function run(id){
 if(cur) return;
 $$('.act').forEach(b=>b.disabled=true);
 $('#dot-'+id).className='dot run';
 $('#pt').textContent=A[id].label;
 $('#ppill').style.display='';$('#ppill').className='pill run';$('#ppill').textContent='running';
 $('#out').innerHTML='<pre class="out" id="pre"></pre>';
 const res=await fetch('/run/'+id,{method:'POST',headers:HDR,
   body:JSON.stringify({params:collect(),arm:armed?ARM:''})}).then(r=>r.json());
 if(res.error){
   $('#pre').innerHTML=`<span class="r">${res.error}</span>`;
   $('#ppill').className='pill err';$('#ppill').textContent='refused';
   $('#dot-'+id).className='dot err';
   $$('.act').forEach(b=>b.disabled=false); sync(); return;
 }
 cur={jid:res.jid,id}; timer=setInterval(poll,400); poll();
}
async function poll(){
 if(!cur) return;
 const j=await fetch('/job/'+cur.jid,{headers:{'X-GS-Token':TOK}}).then(r=>r.json());
 const pre=$('#pre');
 if(pre){const stick=pre.scrollTop+pre.clientHeight>=pre.scrollHeight-40;
  pre.innerHTML=j.lines.map(colour).join('\n'); if(stick)pre.scrollTop=pre.scrollHeight;}
 $('#pm').textContent=j.lines.length+' lines'+(j.elapsed?' · '+j.elapsed+'s':'');
 if(j.done){clearInterval(timer);timer=null;
  const ok=j.rc===0;
  $('#ppill').className='pill '+(ok?'ok':'err');
  $('#ppill').textContent=ok?'ok':'exit '+j.rc;
  $('#dot-'+cur.id).className='dot '+(ok?'ok':'err');
  cur=null; $$('.act').forEach(b=>b.disabled=false); sync();}
}
$('#stop').addEventListener('click',()=>{if(cur)fetch('/stop/'+cur.jid,{method:'POST',headers:HDR,body:'{}'});});
$('#copy').addEventListener('click',()=>{const p=$('#pre');if(p)navigator.clipboard?.writeText(p.innerText);});

applyPreset('balanced'); loadFees(); sync();
$('#rpc_daemon').addEventListener('change',loadFees);
</script></body></html>"""


def main():
    ap = argparse.ArgumentParser(description="GhostSpiral operator console")
    ap.add_argument("--port", type=int, default=8765)
    a = ap.parse_args()
    srv = ThreadingHTTPServer(("127.0.0.1", a.port), H)      # loopback ONLY
    print(f"  GhostSpiral console → http://127.0.0.1:{a.port}/?t={TOKEN}")
    print( "  ^ open THIS url — the token is required, and it changes every run")
    print(f"  {len(ACTIONS)} actions · funds require the arm phrase '{ARM_PHRASE}'")
    print(f"  wallet password: {'from GS_WALLET_PASSWORD' if os.environ.get('GS_WALLET_PASSWORD') else 'not set'}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n  stopped")


if __name__ == "__main__":
    main()
