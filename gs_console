    "hop_delay":    ("re", HOPDELAY_RE),
    "dag_mixing":   ("bool", None),
    "peel":         ("bool", None),
    "joinmarket":   ("bool", None),
    "allow_clearnet_relay": ("bool", None),
    "tor_proxy":    ("re", SOCKS_RE),
    "rpc_primary":  ("re", URL_RE),
    "rpc_daemon":   ("re", URL_RE),
    "wallet_file":  ("re", PATH_RE),
    "output":       ("re", PATH_RE),
    "label":        ("re", re.compile(r"^[A-Za-z0-9 ._-]{1,40}$")),
    #: THE EXIT DESTINATIONS. A list, because --exit-to is repeatable and
    #: spreading the withdrawal is the point: one address re-joins off-chain
    #: everything the run separated on-chain.
    "exit_to":      ("list_re", XMR_RE),
}

#: Most destinations anyone can sensibly hand-manage, and a hard bound on how
#: much a single request can make this compose.
MAX_EXIT_DESTS = 16

#: Where the quote bundle lives when the operator leaves the field blank.
#:
#: THREE ACTIONS READ THIS FIELD AND ONLY TWO DEFAULTED IT. swap_quote writes
#: the quotes to thor_pairs.json when the box is empty, watch_receive waits
#: against thor_pairs.json when the box is empty -- and pipeline_argv passed
#: --swap-pairs only when the box was NOT empty. So the default dashboard
#: receive flow (click all three, type nothing) produced a quote file, waited
#: on it, and then ran the mix with NO target at all: GhostSpiral's receiver
#: branch reads `args.expect_total_xmr is None` as "nothing to check", prints
#: "this run does NOT wait", and plans against whatever happens to be on ENTRY
#: at that instant. Paid by four swaps, it starts mixing on the first one to
#: land and the other three arrive on an address the run has finished with --
#: unmixed, on the address the swap memo names in public.
#:
#: That is the exact failure the expect_total_xmr SCHEMA entry was added to
#: prevent. Adding the field made the gate REACHABLE; it did not arm it, and
#: the page reported no problem, because as far as pipeline_argv was concerned
#: nothing was missing.
#:
#: A constant, because a default that lives in three string literals is how
#: two of them agreed and the third did not. Passing it when the file is absent
#: costs nothing: _receive_pairs_for is explicitly "NEVER FATAL" -- it warns and
#: leaves the run exactly as it was.
DEFAULT_PAIRS_FILE = "thor_pairs.json"


def clean(params: dict) -> dict:
    """Validate every parameter against SCHEMA. Unknown keys are dropped."""
    out, errs = {}, []
    for k, v in (params or {}).items():
        if k not in SCHEMA:
            continue
        kind, spec = SCHEMA[k]
        try:
            if kind == "bool":
                out[k] = bool(v)
            elif kind == "int":
                n = int(v)
                if not (spec[0] <= n <= spec[1]):
                    errs.append(f"{k} must be {spec[0]}–{spec[1]} (got {n})")
                else:
                    out[k] = n
            elif kind == "choice":
                if v not in spec:
                    errs.append(f"{k} must be one of {spec}")
                else:
                    out[k] = v
            elif kind == "re":
                s = str(v).strip()
                if s and not spec.match(s):
                    errs.append(f"{k} is not a valid {k.replace('_',' ')}: {s[:48]}")
                elif s:
                    out[k] = s
            elif kind == "list_re":
                # Accept a JSON array or a newline/comma separated string, so
                # the field works whether the page sends a list or raw text.
                raw = v if isinstance(v, list) else re.split(r"[\s,]+", str(v))
                items, seen = [], set()
                for it in raw:
                    t = str(it).strip()
                    if not t:
                        continue
                    if not spec.match(t):
                        errs.append(f"{k}: not a valid Monero address: {t[:16]}…")
                        continue
                    if t in seen:
                        # Same reasoning as GhostSpiral.resolve_exit_destinations:
                        # repeating an address looks like spreading while
                        # actually concentrating the withdrawal.
                        errs.append(f"{k}: {t[:12]}… is listed more than once — "
                                    f"repeating spreads the withdrawal, it does "
                                    f"not send more to one place")
                        continue
                    seen.add(t)
                    items.append(t)
                if len(items) > MAX_EXIT_DESTS:
                    errs.append(f"{k}: at most {MAX_EXIT_DESTS} destinations")
                elif items:
                    out[k] = items
        except (TypeError, ValueError):
            errs.append(f"{k} is not readable")
    return {"params": out, "errors": errs}


def pipeline_argv(p: dict) -> tuple[list, list]:
    """Compose the GhostSpiral argv from validated params. Returns (argv, problems)."""
    a, why = [PY, "GhostSpiral"], []
    if p.get("mode") == "receive":
        if not p.get("receive_wallet"):
            why.append("Receive mode needs the wallet JSON from create_receive_wallet.")
        else:
            a += ["--receive-wallet", p["receive_wallet"]]
        # --split is NOT dead in receive mode, whatever the old wording said:
        # stage4 computes n_chunks as `len(swap_deposits) or max(args.split, 1)`
        # and receive mode has no deposits, so this IS the chunk count the
        # arrival gate uses. Several swaps can be routed to one receive address
        # -- receive_watch's pairs_for_dest exists to collect them -- so the
        # number is real, and it tightens the gate when the implied per-chunk
        # size is smaller than the tolerance.
        if p.get("split", 1) > 1:
            a += ["--split", str(p["split"])]
        # THE QUOTES, so the operator does not retype the total.
        #
        # The page already collects pairs_file for the watch step, and it is
        # the same bundle. Passed here, GhostSpiral sums the swaps routed to
        # this receive address itself -- and gets the PER-SWAP breakdown,
        # which a hand-typed total cannot carry: on 0.50/0.30/0.15/0.05 the
        # gate tightens to 0.95 XMR with the breakdown and only reaches 0.90
        # without it, and at 0.90 the 0.05 swap can be missing entirely while
        # the run starts mixing.
        # DEFAULTED, like the two actions above. See DEFAULT_PAIRS_FILE: this
        # was the one of the three that did not, which left the standard GUI
        # receive flow running with no arrival gate at all.
        a += ["--swap-pairs", p.get("pairs_file") or DEFAULT_PAIRS_FILE]
    else:
        if not p.get("btc_entry"):
            why.append("Send mode needs a BTC entry address (bech32).")
        else:
            pass   # the address goes in GS_BTC_ENTRY -- see secret_env()
        if p.get("btc_amount"):
            pass   # the amount goes in GS_BTC_AMOUNT -- see secret_env()
        else:
            why.append("Send mode needs a BTC amount.")
        if p.get("split", 1) > 1:
            a += ["--split", str(p["split"])]
        if p.get("joinmarket"):
            a.append("--joinmarket")
    # Both modes: in receive mode it is the only way to get a target at all,
    # and in send mode it is the fallback for when a quote is unreadable and
    # the summed-from-quotes target would silently be built from fewer chunks
    # than the operator actually paid for.
    # THE TOTAL GOES IN GS_EXPECT_TOTAL_XMR -- see secret_env. It was composed
    # onto argv here, which is the same mistake --exit-to made two fields
    # along: GhostSpiral's own --expect-total-xmr help says "an argv amount is
    # world-readable via ps and /proc/<pid>/cmdline (mode 444) for the whole
    # run", and prefers the variable. The console had just been taught to send
    # this value at all (it was not in SCHEMA), and sent it the exposed way.
    if not p.get("tor_proxy"):
        why.append("A socks5h:// Tor proxy is required — the pipeline refuses to run without one.")
    else:
        a += ["--tor-proxy", p["tor_proxy"]]
    a += ["--wallets", str(p.get("wallets", 10)),
          "--deep", str(p.get("deep", 2)),
          "--fee-priority", str(p.get("fee_priority", 1))]
    # Only when the operator set one: omitting the flag lets GhostSpiral apply
    # its own DEFAULT_HOP_DELAY, so the default lives in ONE place instead of
    # being re-declared here and drifting -- the mistake the --split ceiling
    # and the job timeout both made.
    if p.get("hop_delay"):
        a += ["--hop-delay", str(p["hop_delay"])]
    if p.get("dag_mixing"):
        a.append("--dag-mixing")
    if p.get("peel"):
        a.append("--peel")
    for flag, key in (("--rpc-primary", "rpc_primary"), ("--rpc-daemon", "rpc_daemon"),
                      ("--wallet-file", "wallet_file"), ("--output", "output")):
        if p.get(key):
            a += [flag, p[key]]
    if p.get("allow_clearnet_relay"):
        a.append("--allow-clearnet-relay")
    # THE EXIT goes in GS_EXIT_TO -- see secret_env(). It is NOT put on argv:
    # /proc/<pid>/cmdline is world-readable for the life of the run, and this
    # is the operator's final destination, the one address the whole pipeline
    # exists to keep unlinked from the public swap memo. It used to be composed
    # here, which put it in `ps` and in the command preview the page shows.
    # Absent, nothing is withdrawn and the run says so -- the console must not
    # imply otherwise, so there is still no default.
    return a, why


# ── actions. `spends` ones need the arm phrase. ────────────────────────────
