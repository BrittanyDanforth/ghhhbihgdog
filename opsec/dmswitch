            except:
                pass

class CryptoEngine:
    """Military-grade cryptographic operations"""
    
    def __init__(self):
        self.secure_mem = SecureMemory()
    
    def generate_secure_token(self, length: int = 32) -> str:
        """Generate cryptographically secure token"""
        return secrets.token_hex(length)
    
    def derive_keys(self, token: str, salt: bytes) -> Tuple[bytes, bytes]:
        """Derive AES and ChaCha20 keys from token using PBKDF2"""
        master_key = PBKDF2(
            token.encode(),
            salt,
            dkLen=AES_KEY_SIZE + CHACHA_KEY_SIZE,
            count=PBKDF2_ITERATIONS,
            hmac_hash_module=SHA3_256
        )
        aes_key = master_key[:AES_KEY_SIZE]
        chacha_key = master_key[AES_KEY_SIZE:]
        return aes_key, chacha_key
    
    def double_encrypt(self, data: bytes, token: str) -> bytes:
        """Double encryption: AES-256-GCM + ChaCha20-Poly1305"""
        salt = get_random_bytes(SALT_SIZE)
        aes_key, chacha_key = self.derive_keys(token, salt)
        
        # First layer: AES-256-GCM
        aes_nonce = get_random_bytes(NONCE_SIZE)
        aes_cipher = AES.new(aes_key, AES.MODE_GCM, nonce=aes_nonce)
        aes_ciphertext, aes_tag = aes_cipher.encrypt_and_digest(data)
        
        # Second layer: ChaCha20-Poly1305
        chacha_nonce = get_random_bytes(NONCE_SIZE)
        chacha_cipher = ChaCha20_Poly1305.new(key=chacha_key, nonce=chacha_nonce)
        chacha_ciphertext = chacha_cipher.encrypt(aes_nonce + aes_tag + aes_ciphertext)
        chacha_tag = chacha_cipher.digest()
        
        # Format: salt + chacha_nonce + chacha_tag + chacha_ciphertext
        return salt + chacha_nonce + chacha_tag + chacha_ciphertext
    
    def double_decrypt(self, encrypted_data: bytes, token: str) -> bytes:
        """Double decryption: ChaCha20-Poly1305 + AES-256-GCM"""
        # Parse encrypted data
        salt = encrypted_data[:SALT_SIZE]
        chacha_nonce = encrypted_data[SALT_SIZE:SALT_SIZE + NONCE_SIZE]
        chacha_tag = encrypted_data[SALT_SIZE + NONCE_SIZE:SALT_SIZE + NONCE_SIZE + TAG_SIZE]
        chacha_ciphertext = encrypted_data[SALT_SIZE + NONCE_SIZE + TAG_SIZE:]
        
        # Derive keys
        aes_key, chacha_key = self.derive_keys(token, salt)
        
        # First layer: ChaCha20-Poly1305 decryption
        chacha_cipher = ChaCha20_Poly1305.new(key=chacha_key, nonce=chacha_nonce)
        aes_layer = chacha_cipher.decrypt_and_verify(chacha_ciphertext, chacha_tag)
        
        # Parse AES layer
        aes_nonce = aes_layer[:NONCE_SIZE]
        aes_tag = aes_layer[NONCE_SIZE:NONCE_SIZE + TAG_SIZE]
        aes_ciphertext = aes_layer[NONCE_SIZE + TAG_SIZE:]
        
        # Second layer: AES-256-GCM decryption
        aes_cipher = AES.new(aes_key, AES.MODE_GCM, nonce=aes_nonce)
        plaintext = aes_cipher.decrypt_and_verify(aes_ciphertext, aes_tag)
        
        return plaintext

class QRManager:
    """Secure QR code generation and management"""
    
    def __init__(self):
        self.qr_files = []
    
    def generate_qr_image(self, data: str, output_path: Path, steganography: bool = False) -> bool:
        """Generate QR code as encrypted image file"""
        if not QR_AVAILABLE:
            print("[!] QR code generation not available")
            return False
        
        try:
            # Create QR code
            qr = qrcode.QRCode(
                version=1,
                error_correction=qrcode.constants.ERROR_CORRECT_H,  # High error correction
                box_size=10,
                border=4,
            )
            qr.add_data(data)
            qr.make(fit=True)
            
            # Create QR image
            qr_img = qr.make_image(fill_color="black", back_color="white")
            
            if steganography:
                # Hide QR in a larger innocent-looking image
                qr_img = self._apply_steganography(qr_img)
            
            # Save encrypted
            qr_img.save(output_path)
            self.qr_files.append(output_path)
            
            print(f"[+] QR code saved to: {output_path}")
            return True
            
        except Exception as e:
            print(f"[!] QR generation failed: {e}")
            return False
    
    def _apply_steganography(self, qr_img):
        """Apply steganographic techniques to hide QR code"""
        # Create larger canvas that looks like a document
        width, height = qr_img.size
        canvas_width = width + 200
        canvas_height = height + 200
        
        canvas = Image.new('RGB', (canvas_width, canvas_height), 'white')
        
        # Add fake text/document appearance
        draw = ImageDraw.Draw(canvas)
        try:
            # Try to use a system font
            font = ImageFont.load_default()
        except:
            font = None
        
        # Add fake document header
        if font:
            draw.text((20, 20), "System Configuration Backup", fill='black', font=font)
            draw.text((20, 40), f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}", fill='gray', font=font)
            draw.text((20, 60), "Checksum verification required", fill='gray', font=font)
        
        # Embed QR code
        qr_x = (canvas_width - width) // 2
        qr_y = 100
        canvas.paste(qr_img, (qr_x, qr_y))
        
        # Add fake footer
        if font:
            draw.text((20, canvas_height - 40), "Internal Use Only - Confidential", fill='red', font=font)
        
        return canvas
    
    def display_terminal_qr(self, data: str, auto_clear: bool = True) -> bool:
        """Display QR in terminal with optional auto-clear"""
        if not QR_AVAILABLE:
            print("[!] QR display not available")
            return False
        
        try:
            qr = qrcode.QRCode(border=1)
            qr.add_data(data)
            qr.make(fit=True)
            
            print("\n" + "="*60)
            print("SCAN THIS QR CODE IMMEDIATELY - AUTO-CLEARING IN 30s")
            print("="*60)
            qr.print_ascii(invert=True)
            print("="*60)
            
            if auto_clear:
                time.sleep(30)
                # Clear terminal
                os.system('clear' if os.name == 'posix' else 'cls')
                print("[+] QR code cleared from terminal")
            
            return True
            
        except Exception as e:
            print(f"[!] QR display failed: {e}")
            return False
    
    def cleanup_qr_files(self):
        """Securely delete all generated QR files"""
        for qr_file in self.qr_files:
            AntiForensics.secure_delete_file(qr_file)
        self.qr_files.clear()

class DeadManSwitch:
    """Enhanced dead man's switch with advanced security"""
    
    def __init__(self):
        self.crypto = CryptoEngine()
        self.qr_manager = QRManager()
        self.running = False
        self._emergency_destruct_enabled = False
        
        # Setup secure directories
        SECURE_DIR.mkdir(exist_ok=True, mode=0o700)
        QR_OUTPUT_DIR.mkdir(exist_ok=True, parents=True, mode=0o700)
        
        # Setup signal handlers for emergency situations
        signal.signal(signal.SIGTERM, self._emergency_handler)
        signal.signal(signal.SIGINT, self._emergency_handler)
    
    def _emergency_handler(self, signum, frame):
        """Emergency cleanup handler"""
        print("\n[!] EMERGENCY SIGNAL RECEIVED - INITIATING SECURE CLEANUP")
        self._emergency_destruct_enabled = True
        self._secure_cleanup()
        sys.exit(1)
    
    def _secure_cleanup(self):
        """Comprehensive secure cleanup"""
        try:
            # Cleanup QR files
            self.qr_manager.cleanup_qr_files()
            
            # Cleanup decoys
            AntiForensics.cleanup_decoys()
            
            # Secure delete main files
            AntiForensics.secure_delete_file(LOCKED_BUNDLE)
            AntiForensics.secure_delete_file(LOCK_METADATA)
            
            # Cleanup secure memory
            self.crypto.secure_mem.cleanup_all()
            
            # Remove secure directory if empty
            try:
                if SECURE_DIR.exists() and not any(SECURE_DIR.iterdir()):
                    SECURE_DIR.rmdir()
            except:
                pass
                
            print("[+] Secure cleanup completed")
            
        except Exception as e:
            print(f"[!] Cleanup error: {e}")
    
    def lock_entropy_seed(self, ttl: int, show_qr: bool = False, qr_image: bool = False, 
                         steganography: bool = False, auto_clear: bool = True) -> bool:
        """Lock the entropy seed with advanced security"""
        
        if not SEED_FILE.exists():
            print("[!] CRITICAL: entropy_seed.json not found")
            return False
        
        try:
            # Create decoy files for OPSEC
            AntiForensics.create_decoy_files()
            
            # Generate secure token
            token = self.crypto.generate_secure_token(64)  # 512-bit token
            
            # Read and encrypt seed data
            seed_data = SEED_FILE.read_bytes()
            encrypted_data = self.crypto.double_encrypt(seed_data, token)
            
            # Create metadata with integrity checks
            metadata = {
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "ttl_seconds": ttl,
                "expires_at": (datetime.now(timezone.utc) + timedelta(seconds=ttl)).isoformat(),
                "data_hash": hashlib.sha3_256(seed_data).hexdigest(),
                "encrypted_size": len(encrypted_data),
                "version": "2.0",
                "integrity_token": secrets.token_hex(32)
            }
            
            # Write encrypted bundle and metadata
            LOCKED_BUNDLE.write_bytes(encrypted_data)
            LOCK_METADATA.write_text(json.dumps(metadata, indent=2))
            
            # Secure delete original
            AntiForensics.secure_delete_file(SEED_FILE)
            
            # Handle QR code generation / token delivery BEFORE announcing success
            if qr_image and QR_AVAILABLE:
                qr_filename = f"unlock_qr_{secrets.token_hex(4)}.png"
                qr_path = QR_OUTPUT_DIR / qr_filename
                if self.qr_manager.generate_qr_image(token, qr_path, steganography):
                    print(f"[+] QR code image: {qr_path}")
            elif show_qr and QR_AVAILABLE:
                self.qr_manager.display_terminal_qr(token, auto_clear)
            else:
                print(f"\n[+] UNLOCK TOKEN (keep secure):")
                print(f"    {token[:8]}...{token[-8:]}")
                print(f"    Full token written to: /dev/shm/gs_unlock_token")
                print(f"\n[!] Token will be needed within {ttl} seconds")
                _tk_path = Path("/dev/shm/gs_unlock_token")
                _tk_path.write_text(token)
                os.chmod(_tk_path, 0o600)
            
            # Start TTL countdown in background
            self._start_ttl_countdown(ttl)

            print(f"[+] Entropy seed locked successfully")
            print(f"[+] TTL: {ttl} seconds ({ttl//60}m {ttl%60}s)")
            print(f"[+] Expires: {metadata['expires_at']}")

            return True
            
        except Exception as e:
            print(f"[!] Lock operation failed: {e}")
            self._secure_cleanup()
            return False
    
    def _start_ttl_countdown(self, ttl: int):
        """Start TTL countdown as a separate process (survives parent exit)."""
        import signal as _sig
        _sig.signal(_sig.SIGCHLD, _sig.SIG_IGN)  # Auto-reap
        pid = os.fork()
        if pid == 0:
            # Child process
            _sig.signal(_sig.SIGTERM, lambda *_: sys.exit(0))
            time.sleep(ttl)
            if LOCKED_BUNDLE.exists():
                print("\n[!] TTL EXPIRED - INITIATING SELF-DESTRUCT")
                AntiForensics.secure_delete_file(LOCKED_BUNDLE)
                AntiForensics.secure_delete_file(LOCK_METADATA)
                AntiForensics.cleanup_decoys()
            sys.exit(0)
        else:
            print(f"  [·] TTL wiper started (PID {pid})")
    
    def unlock_entropy_seed(self, token: str) -> bool:
        """Unlock the entropy seed with verification"""
        
        if not LOCKED_BUNDLE.exists() or not LOCK_METADATA.exists():
            print("[!] No locked entropy bundle found")
            return False
        
        try:
            # Load and verify metadata
            metadata = json.loads(LOCK_METADATA.read_text())
            for required_key in ("expires_at", "encrypted_size", "data_hash"):
                if required_key not in metadata:
                    print(f"[!] Lock metadata missing required field: {required_key}")
                    print("[!] Bundle preserved — metadata may be corrupt. Check manually.")
                    return False

            expires_at = datetime.fromisoformat(metadata["expires_at"].replace('Z', '+00:00'))

            if datetime.now(timezone.utc) > expires_at:
                print("[!] Unlock token expired - initiating self-destruct")
                self._secure_cleanup()
                return False

            # Attempt decryption
            encrypted_data = LOCKED_BUNDLE.read_bytes()

            if len(encrypted_data) != metadata["encrypted_size"]:
                print("[!] Data integrity check failed - possible tampering")
                self._secure_cleanup()
                return False
            
            # Decrypt with provided token
            decrypted_data = self.crypto.double_decrypt(encrypted_data, token)
            
            # Verify integrity
            data_hash = hashlib.sha3_256(decrypted_data).hexdigest()
            if data_hash != metadata["data_hash"]:
                print("[!] Decrypted data integrity check failed")
                print("[!] Locked bundle is PRESERVED — you can retry with the correct token.")
                return False

            # Restore entropy seed
            SEED_FILE.write_bytes(decrypted_data)

            # Only now that restore succeeded, clean up the encrypted copies
            self._secure_cleanup()

            print("[+] Entropy seed successfully unlocked and restored")
            print(f"[+] File restored: {SEED_FILE}")

            return True

        except Exception as e:
            print(f"[!] Unlock failed: {e}")
            print("[!] Locked bundle is PRESERVED — retry with the correct token.")
            print("[!] Use --emergency-destruct if you want to destroy everything.")
            return False
    
    def emergency_destruct(self) -> bool:
        """Emergency destruction of all sensitive data"""
        print("[!] EMERGENCY DESTRUCT INITIATED")
        
        # Secure cleanup
        self._secure_cleanup()
        
        # Also try to clean original seed if it exists
        if SEED_FILE.exists():
            AntiForensics.secure_delete_file(SEED_FILE)
        
        print("[+] Emergency destruct completed")
        return True

