class SecureMemory:
    """Secure memory management with automatic cleanup"""
    
    def __init__(self):
        self._allocations = []
    
    @contextmanager
    def secure_bytes(self, size: int):
        """Allocate secure memory that gets wiped on exit"""
        mm = None
        try:
            mm = mmap.mmap(-1, size, access=mmap.ACCESS_WRITE)
            self._allocations.append(mm)
            yield mm
        finally:
            if mm is not None:
                # Secure wipe
                for _ in range(SECURE_WIPE_PASSES):
                    mm.seek(0)
                    mm.write(secrets.token_bytes(size))
                    mm.flush()
                mm.close()
                if mm in self._allocations:
                    self._allocations.remove(mm)
    
    def cleanup_all(self):
        """Emergency cleanup of all allocations"""
        for mm in self._allocations[:]:
            try:
                size = mm.size()
                for _ in range(SECURE_WIPE_PASSES):
                    mm.seek(0)
                    mm.write(secrets.token_bytes(size))
                    mm.flush()
                mm.close()
            except:
                pass
        self._allocations.clear()

class AntiForensics:
    """Advanced anti-forensics and secure deletion"""
    
    @staticmethod
    def secure_delete_file(filepath: Path) -> bool:
        """DOD 5220.22-M standard file wiping.

        WARNING: Multi-pass overwrite is ineffective on:
        - SSD/NVMe: firmware wear-levelling remaps blocks; original data may
          persist on unmapped pages. Use full-disk encryption (LUKS) or
          blkdiscard --secure instead.
        - CoW filesystems (btrfs/ZFS): overwrite allocates new blocks; old
          data remains in snapshots/CoW until garbage collected.
        - Journaling (ext4 default): journal may retain original data.
        Only full-disk encryption guarantees erasure on modern hardware.
        """
        if not filepath.exists():
            return True
        
        try:
            file_size = filepath.stat().st_size
            
            try:
                dev = os.stat(filepath).st_dev
                dev_path = Path(f"/sys/dev/block/{os.major(dev)}:{os.minor(dev)}")
                rotational = (dev_path / "queue" / "rotational").resolve()
                if not rotational.exists():
                    parent = dev_path.resolve()
                    rotational = parent.parent / "queue" / "rotational"
                if rotational.exists() and rotational.read_text().strip() == "0":
                    print(f"[!] WARNING: {filepath} is on SSD/NVMe — overwrite may not erase "
                          f"original blocks. Use full-disk encryption (LUKS) or "
                          f"blkdiscard --secure for reliable erasure.")
            except (OSError, ValueError):
                pass

            # Multiple pass overwriting
            patterns = [
                b'\x00' * 1024,  # Zeros
                b'\xFF' * 1024,  # Ones
                secrets.token_bytes(1024),  # Random
                b'\xAA' * 1024,  # Alternating
                b'\x55' * 1024,  # Alternating inverse
                secrets.token_bytes(1024),  # Random again
                b'\x00' * 1024   # Final zeros
            ]
            
            with open(filepath, 'r+b') as f:
                for pattern in patterns:
                    f.seek(0)
                    remaining = file_size
                    while remaining > 0:
                        chunk_size = min(len(pattern), remaining)
                        f.write(pattern[:chunk_size])
                        remaining -= chunk_size
                    f.flush()
                    os.fsync(f.fileno())
            
            # Remove file
            filepath.unlink()
            return True
            
        except Exception as e:
            print(f"[!] Secure deletion failed for {filepath}: {e}")
            return False
    
    @staticmethod
    def create_decoy_files(count: int = 5):
        """Create decoy files to mask real operations"""
        DECOY_DIR.mkdir(exist_ok=True, parents=True)
        
        for i in range(count):
            decoy_path = DECOY_DIR / f"backup_{secrets.token_hex(4)}.json"
            decoy_data = {
                "timestamp": datetime.now().isoformat(),
                "data": secrets.token_hex(64),
                "checksum": secrets.token_hex(32)
            }
            decoy_path.write_text(json.dumps(decoy_data, indent=2))
    
    @staticmethod
    def cleanup_decoys():
        """Securely remove all decoy files"""
        if DECOY_DIR.exists():
            for decoy_file in DECOY_DIR.iterdir():
                AntiForensics.secure_delete_file(decoy_file)
            try:
