    return parser

def main():
    """Enhanced main function with comprehensive error handling"""
    parser = setup_argument_parser()
    args = parser.parse_args()
    
    # Initialize dead man's switch
    switch = DeadManSwitch()
    
    try:
        if args.emergency_destruct:
            # Emergency destruction
            switch.emergency_destruct()
            
        elif args.lock:
            # Lock operation
            success = switch.lock_entropy_seed(
                ttl=args.ttl,
                show_qr=args.show_qr,
                qr_image=args.qr_image,
                steganography=args.steganography,
                auto_clear=not args.no_auto_clear
            )
            sys.exit(0 if success else 1)
            
        elif args.unlock_token:
            # Unlock operation
            success = switch.unlock_entropy_seed(args.unlock_token.strip())
            sys.exit(0 if success else 1)
            
        else:
            parser.print_help()
            sys.exit(1)
            
    except KeyboardInterrupt:
        print("\n[!] Operation interrupted - initiating secure cleanup")
        switch._secure_cleanup()
        sys.exit(1)
    except Exception as e:
        print(f"[!] CRITICAL ERROR: {e}")
        switch._secure_cleanup()
        sys.exit(1)

