#!/usr/bin/env python3
"""
paranoia_mode v10.0 - Post-Op Host Sanitiser
=============================================
Focus: footprint erasure + network-fingerprint randomisation.

OPSEC hardening:
  - Wipes bash/zsh history, Python __pycache__, .pyc files
  - Wipes common temp directories (/tmp, /var/tmp user files)
  - Truncates system logs older than N days
  - Flushes DNS cache
  - Spoofs MAC with locally-administered unicast address
  - Clears systemd journal (if present)
  - Overwrites swap + shared memory
  - DNS leak check post-spoof
  - Integrity log for every action (even in dry-run)
  - Resource sentinel
  - All actions idempotent and safe to re-run
"""
from __future__ import annotations
import argparse, glob, os, random, shutil, subprocess, sys, time
from pathlib import Path

# Add core/ to path so shared utilities can be found regardless of working directory
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "core"))

from gs_common import (
    integrity_log, require_resources, install_signal_handlers,
    shutdown_requested,
)

# Paths to wipe
SHELL_HISTORIES = [
    Path.home() / ".bash_history",
    Path.home() / ".zsh_history",
    Path.home() / ".python_history",
    Path.home() / ".lesshst",
    Path.home() / ".wget-hsts",
    Path.home() / ".viminfo",
]

PYCACHE_GLOBS = [
    str(Path.home() / "**/__pycache__"),
    "/tmp/**/__pycache__",
]


def connectivity_check(iface: str) -> None:
    """Verify basic network connectivity after MAC spoof.

    BUG 52 FIX: ANY clearnet DNS resolution immediately after MAC spoof
    creates a timing correlation between the new MAC and network activity.
    Instead of DNS resolution, just check that the network interface is up
    and has an IP address. This proves connectivity without generating any
    traffic that could be logged by the ISP or network observer.
    """
    try:
        result = subprocess.run(
            ["ip", "addr", "show", iface],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0:
            integrity_log("paranoia", "connectivity_check_fail:iface_down")
            print(f"  [!] Interface {iface} appears to be down after MAC spoof")
            return
        if "inet " in result.stdout:
            integrity_log("paranoia", "connectivity_check_ok")
        else:
            integrity_log("paranoia", "connectivity_check_warn:no_ip")
            print(f"  [!] Interface {iface} has no IP address (DHCP may need renewal)")
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        integrity_log("paranoia", f"connectivity_check_fail:{e}")
        print(f"  [!] Connectivity check failed: {e}")


def rand_mac() -> str:
    """Generate locally-administered unicast MAC."""
    octets = [random.SystemRandom().randint(0, 255) for _ in range(6)]
    octets[0] = (octets[0] | 0x02) & 0xFE  # locally administered + unicast
    return ":".join(f"{o:02x}" for o in octets)


def spoof_mac(iface: str, dry: bool):
    if not dry and os.geteuid() != 0:
        print("  [!] WARNING: MAC spoof requires root — skipping (run with sudo for full wipe)")
        integrity_log("paranoia", f"mac_skip:not_root")
        return
    new_mac = rand_mac()
    if dry:
        print(f"  [dry] MAC {iface} -> {new_mac}")
        integrity_log("paranoia", f"mac_dry:{iface}->{new_mac}")
        return
    try:
        subprocess.run(["ip", "link", "set", iface, "down"], check=True,
                       capture_output=True, timeout=10)
        subprocess.run(["ip", "link", "set", iface, "address", new_mac],
                       check=True, capture_output=True, timeout=10)
        subprocess.run(["ip", "link", "set", iface, "up"], check=True,
                       capture_output=True, timeout=10)

        # Verify the MAC was actually applied. Some wireless drivers
        # (Intel AX200/AX201, some Realtek) accept the command but
        # silently revert to the hardware MAC.
        verify = subprocess.run(
            ["ip", "link", "show", iface],
            capture_output=True, text=True, timeout=5,
        )
        if verify.returncode == 0:
            import re as _re
            mac_match = _re.search(
                r"link/ether\s+([0-9a-f:]{17})", verify.stdout
            )
            if mac_match:
                actual_mac = mac_match.group(1).lower()
                if actual_mac != new_mac.lower():
                    integrity_log("paranoia",
                                  f"mac_verify_FAIL:{iface}:wanted={new_mac}:got={actual_mac}")
                    print(f"  [!] MAC spoof FAILED verification!")
                    print(f"      Requested: {new_mac}")
                    print(f"      Actual:    {actual_mac}")
                    print(f"      Your wireless driver may reject programmatic MAC changes.")
                    print(f"      Try: macchanger -r {iface}")
                    return

        print(f"  [+] MAC {iface} -> {new_mac} (verified)")
        integrity_log("paranoia", f"mac_spoof_verified:{iface}->{new_mac}")
    except subprocess.CalledProcessError as e:
        integrity_log("paranoia", f"mac_fail:{iface}:{e}")
        print(f"  [!] MAC spoof failed: {e}")
    except FileNotFoundError:
        integrity_log("paranoia", "mac_fail:ip_not_found")
        print("  [!] 'ip' command not found - cannot spoof MAC")


def wipe_shell_histories(dry: bool):
    count = 0
    for hist in SHELL_HISTORIES:
        if hist.exists():
            if dry:
                print(f"  [dry] would wipe {hist}")
            else:
                try:
                    hist.write_bytes(b"")
                    count += 1
                except (PermissionError, OSError):
                    pass
    integrity_log("paranoia", f"histories_wiped:{count}" if not dry else f"histories_dry:{count}")


def wipe_pycache(dry: bool):
    count = 0
    for pattern in PYCACHE_GLOBS:
        for d in glob.glob(pattern, recursive=True):
            if dry:
                print(f"  [dry] would remove {d}")
            else:
                try:
                    shutil.rmtree(d)
                    count += 1
                except (PermissionError, OSError):
                    pass
    # Also .pyc in home
    for pyc in Path.home().rglob("*.pyc"):
        if dry:
            print(f"  [dry] would remove {pyc}")
        else:
            try:
                pyc.unlink()
                count += 1
            except (PermissionError, OSError):
                pass
    integrity_log("paranoia", f"pycache_wiped:{count}" if not dry else f"pycache_dry")


def wipe_system_logs(days: int, dry: bool):
    if not dry and os.geteuid() != 0:
        print("  [!] WARNING: wipe_system_logs requires root — skipping (run with sudo for full wipe)")
        integrity_log("paranoia", "logs_skip:not_root")
        return
    cutoff = time.time() - days * 86400
    count = 0
    for f in glob.glob("/var/log/**/*.log", recursive=True):
        try:
            if os.path.getmtime(f) < cutoff:
                if dry:
                    print(f"  [dry] would truncate {f}")
                else:
                    with open(f, "w"):
                        pass
                count += 1
        except (PermissionError, OSError):
            pass
    integrity_log("paranoia", f"logs_wiped:{count}" if not dry else f"logs_dry:{count}")
    print(f"  [+] {'Would truncate' if dry else 'Truncated'} {count} log(s)")


def clear_journal(dry: bool):
    """Clear systemd journal if journalctl is available."""
    if not dry and os.geteuid() != 0:
        print("  [!] WARNING: clear_journal requires root — skipping (run with sudo for full wipe)")
        integrity_log("paranoia", "journal_skip:not_root")
        return
    if dry:
        print("  [dry] would run journalctl --vacuum-time=1s")
        integrity_log("paranoia", "journal_dry")
        return
    try:
        subprocess.run(["journalctl", "--vacuum-time=1s"],
                       check=True, capture_output=True, timeout=30)
        integrity_log("paranoia", "journal_cleared")
        print("  [+] Journal cleared")
    except (FileNotFoundError, subprocess.CalledProcessError):
        pass


def flush_dns_cache(dry: bool):
    """Flush DNS resolver cache."""
    if dry:
        print("  [dry] would flush DNS cache")
        return
    for cmd in [
        ["resolvectl", "flush-caches"],
        ["systemd-resolve", "--flush-caches"],
    ]:
        try:
            subprocess.run(cmd, check=True, capture_output=True, timeout=10)
            integrity_log("paranoia", "dns_cache_flushed")
            print("  [+] DNS cache flushed")
            return
        except (FileNotFoundError, subprocess.CalledProcessError):
            continue
    integrity_log("paranoia", "dns_cache_skip:no_resolver")


def wipe_swap_ram(dry: bool):
    if not dry and os.geteuid() != 0:
        print("  [!] WARNING: wipe_swap_ram requires root — skipping (run with sudo for full wipe)")
        integrity_log("paranoia", "ram_skip:not_root")
        return
    if dry:
        print("  [dry] would wipe swap+shm")
        integrity_log("paranoia", "ram_dry")
        return

    try:
        subprocess.run(["swapoff", "-a"], check=True, capture_output=True,
                       timeout=30)
    except (FileNotFoundError, subprocess.CalledProcessError) as e:
        integrity_log("paranoia", f"swapoff_fail:{e}")

    wipe_file = "/dev/shm/gs_paranoia_wipe"
    try:
        subprocess.run(
            ["dd", "if=/dev/zero", f"of={wipe_file}", "bs=1M", "count=128"],
            check=True, capture_output=True, timeout=60,
        )
        if os.path.exists(wipe_file):
            os.unlink(wipe_file)
        subprocess.run(["sync"], check=True, capture_output=True, timeout=10)
        integrity_log("paranoia", "ram_wipe_ok")
        print("  [+] Swap/SHM wipe complete")
    except (FileNotFoundError, subprocess.CalledProcessError) as e:
        integrity_log("paranoia", f"ram_wipe_fail:{e}")
        print(f"  [!] RAM wipe failed: {e}")


def _secure_delete_file(path: Path):
    """Overwrite file content with nulls before unlinking.

    BUG 53 FIX: The old code only overwrote the first 64KB. Now overwrites
    the full file size in 64KB chunks.

    Limitations acknowledged and warned about:
    - Hardlinks: if nlink > 1, data persists via other links. We warn.
    - CoW filesystems (btrfs/ZFS): overwrite allocates new blocks; old
      data remains until GC. We warn and suggest shred.
    - Journaling (ext4): journal may contain original data for recent
      writes. fsync + overwrite helps but doesn't guarantee journal purge.
    - SSD/NVMe: firmware wear-levelling remaps blocks, so overwritten
      data may persist on unmapped pages. Only ATA Secure Erase,
      blkdiscard --secure, or full-disk encryption (LUKS) guarantees
      erasure on flash storage.
    """
    try:
        stat = path.stat()
        size = stat.st_size
        if stat.st_nlink > 1:
            print(f"  [!] WARNING: {path} has {stat.st_nlink} hardlinks — "
                  f"data persists via other links after deletion")
            integrity_log("paranoia", f"hardlink_warn:{path.name}:nlinks={stat.st_nlink}")
        try:
            dev = os.stat(path).st_dev
            dev_path = Path(f"/sys/dev/block/{os.major(dev)}:{os.minor(dev)}")
            rotational = (dev_path / "queue" / "rotational").resolve()
            if not rotational.exists():
                parent = dev_path.resolve()
                rotational = parent.parent / "queue" / "rotational"
            if rotational.exists() and rotational.read_text().strip() == "0":
                print(f"  [!] WARNING: {path} is on SSD/NVMe — overwrite may not erase "
                      f"original blocks due to wear-levelling. Use full-disk encryption "
                      f"(LUKS) or blkdiscard --secure for reliable erasure.")
                integrity_log("paranoia", f"ssd_warn:{path.name}")
        except (OSError, ValueError):
            pass
        with open(path, "r+b") as f:
            remaining = size
            chunk_size = 65536
            while remaining > 0:
                write_size = min(remaining, chunk_size)
                f.write(b"\x00" * write_size)
                remaining -= write_size
            f.flush()
            os.fsync(f.fileno())
        path.unlink()
    except (PermissionError, OSError) as e:
        integrity_log("paranoia", f"secure_delete_fail:{path.name}:{e}")
        print(f"  [!] Secure delete failed for {path}: {e}")


def _secure_delete_dir(path: Path):
    """Overwrite all files in a directory tree then remove it."""
    if not path.is_dir():
        return
    for f in path.rglob("*"):
        if f.is_file():
            _secure_delete_file(f)
    shutil.rmtree(path, ignore_errors=True)


def wipe_artifacts(dry: bool, extra_dirs: list = None):
    """Wipe ALL toolkit output files. Searches cwd, home dir,
    common subdirectories, and any --search-dir paths provided."""
    file_patterns = [
        # Core pipeline
        "unsigned_*.json", "signer_progress.json",
        "broadcast_progress.json", "stage5_progress.json",
        "wallet_*.json", "thor_pairs_*.json",
        "thor_pairs_*.json.gpg", "thor_pairs_batch.json",
        "exitplan_*.json", "exitplan_v1.json",
        "plan_output.json",
        "integrity_chain.log", "integrity.log",
        "integrity_chain.log.lock",
        "*.blob", "*.signed", "*.unsigned",
        "signed_manifest_v1.json", "unsigned_manifest.json",
        ".ghostspiral.lock", ".mixer.lock",
        # Stale .tmp files from atomic_write_json/atomic_write_text crash.
        # If the process is killed between tmp write and os.replace(), the
        # .tmp file persists with the SAME sensitive data as the final file.
        "unsigned_*.json.tmp", "signer_progress.json.tmp",
        "stage5_progress.json.tmp", "broadcast_progress.json.tmp",
        "wallet_*.json.tmp", "exitplan_*.json.tmp",
        "plan_output.json.tmp",
        "integrity_chain.log.tmp",
        "unsigned_manifest.json.tmp", "signed_manifest_v1.json.tmp",
        "swap_progress_secure.json.tmp",
        # Entropy + chaos pipeline
        "entropy_seed.json", "entropy_seed.json.tmp",
        "dag_structure.json", "dag_structure.json.tmp",
        "dag_augmented.json", "dag_augmented.json.tmp",
        "label_map.json", "label_map.json.tmp",
        "label_map_poisoned.json", "label_map_poisoned.json.tmp",
        "decoy_noise.json", "decoy_noise.json.tmp",
        "swap_integrity_v2.log", "swap_progress_secure.json",
        "tor_operations.log", "tor_operations.log.tmp",
        "operational_endpoints.json", "operational_endpoints.json.tmp",
        # Mutator output + manifests (smoking gun if left on disk)
        "*.manifest.json", "*.manifest.json.tmp",
        "wallet_mutation_manifest_v1.json",
        "fake_leaf_manifest_v1.json",
        "mutated_wallet.json", "mutated_wallet.json.tmp",
        # Fake/decoy logs
        "mirror_exec.log", "mirror_exec.log.tmp",
        "fake_errors.log",
        "fake_integrity_chain.log",
        "integrity_fake.log", "integrity_fake.log.tmp",
        # Catch-all for any remaining .tmp from atomic writes
        "thor_pairs_batch.json.tmp",
    ]
    dir_patterns = [
        "signed_blobs", "unsigned", "tx_staging", "runtime",
    ]

    search_roots = list(set([
        Path("."),
        Path.home(),
        Path.home() / "ghostspiral",
        Path.home() / "GhostSpiral",
        Path.home() / "toolkit",
        Path.home() / "ops",
        Path.home() / "Desktop",
        Path.home() / "Downloads",
        Path("/media"),
        Path("/mnt"),
        Path("/run/media"),
    ] + [Path(d) for d in (extra_dirs or [])]))

    count = 0

    # Wipe toolkit files in /dev/shm (RAM-only storage)
    shm = Path("/dev/shm")
    if shm.is_dir():
        shm_patterns = [
            ".gs_seed_active", ".gs_seed_active.tmp",
            ".gs_seed_lock",
            "gs_*", "vm_timing.json", "vm_timing.tmp",
            "swap_progress_secure.json", "swap_progress_secure.tmp",
            "circuit_burn.log", "gs_unlock_token", "gs_paranoia_wipe",
            ".gs_locked_bundle", ".gs_lock_meta",
            ".tk_*",
            "fake_errors.log",
        ]
        shm_dir_patterns = [
            "qr_codes",
            "decoys",
        ]
        for pat in shm_patterns:
            for f in shm.glob(pat):
                if dry:
                    print(f"  [dry] would securely delete {f}")
                else:
                    _secure_delete_file(f)
                count += 1
        for dirname in shm_dir_patterns:
            d = shm / dirname
            if d.is_dir():
                if dry:
                    print(f"  [dry] would securely delete dir {d}")
                else:
                    _secure_delete_dir(d)
                count += 1
    for root in search_roots:
        if not root.is_dir():
            continue

        # Use recursive glob (**/) to find artifacts at any depth.
        # The old code only searched one level deep, missing artifacts
        # in nested directories (e.g. ~/projects/toolkit/run3/unsigned/).
        # Limit depth to 4 levels to avoid scanning huge trees like /mnt.
        depth_patterns = [
            "",          # root itself
            "*/",        # 1 level
            "*/*/",      # 2 levels
            "*/*/*/",    # 3 levels
        ]

        for pattern in file_patterns:
            for depth in depth_patterns:
                for f in root.glob(f"{depth}{pattern}"):
                    if dry:
                        print(f"  [dry] would securely delete {f}")
                    else:
                        _secure_delete_file(f)
                    count += 1

        for dirname in dir_patterns:
            for depth in depth_patterns:
                for d in root.glob(f"{depth}{dirname}"):
                    if d.is_dir():
                        if dry:
                            print(f"  [dry] would securely delete dir {d}")
                        else:
                            _secure_delete_dir(d)
                        count += 1

    print(f"  [+] {'Would delete' if dry else 'Deleted'} {count} artifact(s)")
    integrity_log("paranoia", f"artifacts:{'dry' if dry else 'wiped'}:{count}")


def wipe_tmp_files(dry: bool):
    """Remove user-owned files from temp directories."""
    uid = os.getuid()
    count = 0
    for tmpdir in ["/tmp", "/var/tmp"]:
        if not os.path.isdir(tmpdir):
            continue
        for entry in os.scandir(tmpdir):
            try:
                if entry.stat().st_uid == uid:
                    if dry:
                        print(f"  [dry] would remove {entry.path}")
                    else:
                        if entry.is_dir(follow_symlinks=False):
                            shutil.rmtree(entry.path, ignore_errors=True)
                        else:
                            os.unlink(entry.path)
                    count += 1
            except (PermissionError, OSError):
                pass
    integrity_log("paranoia", f"tmp_wiped:{count}" if not dry else f"tmp_dry:{count}")


def wipe_clipboard(dry: bool):
    """Clear clipboard contents from all common clipboard managers."""
    count = 0
    for cmd in [
        ["xclip", "-selection", "clipboard", "-i", "/dev/null"],
        ["xclip", "-selection", "primary", "-i", "/dev/null"],
        ["xsel", "--clipboard", "--clear"],
        ["xsel", "--primary", "--clear"],
        ["wl-copy", "--clear"],
    ]:
        if dry:
            print(f"  [dry] would run {' '.join(cmd)}")
            count += 1
            continue
        try:
            subprocess.run(cmd, check=True, capture_output=True, timeout=5)
            count += 1
        except (FileNotFoundError, subprocess.CalledProcessError):
            pass
    integrity_log("paranoia", f"clipboard:{'dry' if dry else 'wiped'}:{count}")


def wipe_xdg_traces(dry: bool):
    """Wipe XDG recently-used files, thumbnail caches, Trash, and bookmarks.

    These are high-value forensic targets: recently-used.xbel records every
    file opened by GUI apps (with timestamps), thumbnails cache previews of
    files (including JSON plans), Trash retains 'deleted' files, and
    bookmarks may reference working directories.
    """
    targets = [
        Path.home() / ".local/share/recently-used.xbel",
        Path.home() / ".local/share/recently-used.xbel.bak",
        Path.home() / ".config/gtk-3.0/bookmarks",
        Path.home() / ".local/share/tracker/data/tracker-store.journal",
    ]
    dir_targets = [
        Path.home() / ".cache/thumbnails",
        Path.home() / ".thumbnails",
        Path.home() / ".local/share/Trash",
        Path.home() / ".local/share/tracker",
    ]
    count = 0
    for f in targets:
        if f.exists():
            if dry:
                print(f"  [dry] would wipe {f}")
            else:
                _secure_delete_file(f)
            count += 1
    for d in dir_targets:
        if d.is_dir():
            if dry:
                print(f"  [dry] would wipe dir {d}")
            else:
                _secure_delete_dir(d)
            count += 1
    integrity_log("paranoia", f"xdg_traces:{'dry' if dry else 'wiped'}:{count}")


def scrub_env_vars(dry: bool):
    """Remove sensitive environment variables from the current process.

    /proc/self/environ is immutable on Linux, so we can only clear the
    variables in the current process. The parent shell's env persists until
    the terminal is closed.
    """
    sensitive_prefixes = [
        "GPT_KEYS", "MASTER_ENTROPY", "WG_CONF", "TOR_PROXY",
        "MONERO_RPC", "XMR_", "BTC_", "GHOSTSPIRAL", "GS_",
    ]
    count = 0
    for key in list(os.environ.keys()):
        if any(key.upper().startswith(p) for p in sensitive_prefixes):
            if dry:
                print(f"  [dry] would unset env {key}")
            else:
                del os.environ[key]
            count += 1
    integrity_log("paranoia", f"env_vars:{'dry' if dry else 'scrubbed'}:{count}")


def _detect_active_interface() -> str:
    """Detect the active network interface (the one with a default route).
    Falls back to first non-loopback interface, then 'eth0'."""
    try:
        result = subprocess.run(
            ["ip", "route", "show", "default"],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode == 0 and "dev " in result.stdout:
            import re as _re
            m = _re.search(r"dev\s+(\S+)", result.stdout)
            if m:
                return m.group(1)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    try:
        result = subprocess.run(
            ["ip", "-o", "link", "show", "up"],
            capture_output=True, text=True, timeout=5,
        )
        for line in result.stdout.splitlines():
            parts = line.split(":")
            if len(parts) >= 2:
                iface = parts[1].strip()
                if iface != "lo":
                    return iface
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return "eth0"


def main():
    install_signal_handlers()

    default_iface = _detect_active_interface()

    ap = argparse.ArgumentParser(
        "paranoia_mode v10.0",
        description="Post-operation host sanitisation",
    )
    ap.add_argument("--wipe-days", type=int, default=7,
                    help="truncate logs older than N days")
    ap.add_argument("--iface", default=default_iface,
                    help=f"network interface to spoof (detected: {default_iface})")
    ap.add_argument("--dry-run", action="store_true",
                    help="print actions without executing")
    ap.add_argument("--search-dir", action="append", default=[],
                    help="additional directories to search for toolkit artifacts "
                         "(can be specified multiple times)")
    args = ap.parse_args()

    require_resources(min_disk_gb=1.0)
    integrity_log("paranoia", f"start:dry={args.dry_run}")

    if os.geteuid() != 0:
        print("  [!] WARNING: Not running as root. Some operations will silently fail:")
        print("  [!]   MAC spoof, system log wipe, journal clear, swap wipe")
        print("  [!]   Run with: sudo python3 paranoia_mode ...")
        print()

    print("  [*] Phase 1: MAC spoof")
    spoof_mac(args.iface, args.dry_run)

    print("  [*] Phase 2: Connectivity check (no DNS — avoids MAC-to-activity correlation)")
    if args.dry_run:
        print("  [dry] would check interface connectivity")
    else:
        connectivity_check(args.iface)

    print("  [*] Phase 3: DNS cache flush")
    flush_dns_cache(args.dry_run)

    print("  [*] Phase 4: Shell histories")
    wipe_shell_histories(args.dry_run)

    print("  [*] Phase 5: Python cache")
    wipe_pycache(args.dry_run)

    print("  [*] Phase 6: Temp files")
    wipe_tmp_files(args.dry_run)

    print("  [*] Phase 7: System logs")
    wipe_system_logs(args.wipe_days, args.dry_run)

    print("  [*] Phase 8: Journal")
    clear_journal(args.dry_run)

    print("  [*] Phase 9: Swap/RAM")
    wipe_swap_ram(args.dry_run)

    print("  [*] Phase 10: Clipboard")
    wipe_clipboard(args.dry_run)

    print("  [*] Phase 11: XDG traces (recently-used, thumbnails, Trash, bookmarks)")
    wipe_xdg_traces(args.dry_run)

    print("  [*] Phase 12: Environment variables")
    scrub_env_vars(args.dry_run)
    print("  [!] NOTE: env var scrubbing only affects THIS process. Your parent")
