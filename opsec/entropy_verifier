#!/usr/bin/env python3
"""
entropy_verifier — Verify GhostSpiral entropy seed integrity
=============================================================
Validates that an entropy_seed.json bundle:
  1. Exists and is valid JSON
  2. Has required fields (seed_hex, sha256, timestamp)
  3. sha256 matches the actual seed_hex content
  4. Seed has sufficient entropy (min 256 bits)
  5. Seed is not all zeros or a known weak pattern
  6. File permissions are 0600 (owner-only)
  7. Optionally verify against a GPG signature

Usage:
    python3 entropy_verifier entropy_seed.json
    python3 entropy_verifier entropy_seed.json --strict
"""
import argparse, hashlib, json, math, os, sys, stat
from pathlib import Path
from collections import Counter


def check_entropy_bits(hex_string: str) -> float:
    """Calculate Shannon entropy of hex string in bits."""
    if not hex_string:
        return 0.0
    data = bytes.fromhex(hex_string)
    if not data:
        return 0.0
    counts = Counter(data)
    total = len(data)
    entropy = 0.0
    for count in counts.values():
        if count > 0:
            prob = count / total
            entropy -= prob * math.log2(prob)
    return entropy * total


def check_weak_patterns(seed_hex: str) -> list:
    """Check for known weak entropy patterns."""
    warnings = []
    data = bytes.fromhex(seed_hex)

    if all(b == 0 for b in data):
        warnings.append("CRITICAL: Seed is all zeros")
    if all(b == 0xFF for b in data):
        warnings.append("CRITICAL: Seed is all 0xFF")
    if len(set(data)) == 1:
        warnings.append("CRITICAL: Seed is single repeated byte")
    if len(set(data)) < 16:
        warnings.append("WARNING: Seed has very low byte diversity (<16 unique values)")

    for i in range(len(data) - 1):
        if data[i + 1] != (data[i] + 1) % 256:
            break
    else:
        if len(data) > 4:
            warnings.append("CRITICAL: Seed is sequential bytes")

    return warnings


def main():
    ap = argparse.ArgumentParser(
        description="Verify GhostSpiral entropy seed integrity",
    )
    ap.add_argument("seed_file", help="Path to entropy_seed.json")
    ap.add_argument("--strict", action="store_true",
                    help="Fail on any warning (not just critical)")
    ap.add_argument("--min-bits", type=int, default=256,
                    help="Minimum entropy bits required (default: 256)")
    args = ap.parse_args()

    seed_path = Path(args.seed_file)
    errors = []
    warnings = []

    # Check file exists
    if not seed_path.exists():
        print(f"  [!] File not found: {seed_path}")
        sys.exit(1)

    # Check permissions
    st = seed_path.stat()
    mode = stat.S_IMODE(st.st_mode)
    if mode & 0o077:
        warnings.append(f"File permissions {oct(mode)} — should be 0600 (owner-only)")
        print(f"  [!] WARNING: {seed_path} is readable by group/others ({oct(mode)})")
        print(f"      Fix: chmod 600 {seed_path}")

    # Parse JSON
    try:
        with open(seed_path) as f:
            data = json.load(f)
    except json.JSONDecodeError as e:
        print(f"  [!] Invalid JSON: {e}")
        sys.exit(1)

    print(f"  [·] Checking: {seed_path}")

    # Support both formats:
    #   Format A (SML/manual): {"seed_hex": "abcd...", "sha256": "...", "timestamp": N}
    #   Format B (en_seeder):  {"sha256": "...", "created_utc": "...", "sources": {...}}
    # Detect format by checking which fields exist.

    seed_hex = data.get("seed_hex", "")
    claimed_hash = data.get("sha256", "")

    if not seed_hex and "sources" in data:
        # en_seeder format: hash covers the whole bundle, no separate seed_hex
        print(f"  [·] Detected en_seeder format (bundle hash)")
        bundle_for_hash = json.dumps(
            {k: v for k, v in data.items() if k != "sha256"},
            sort_keys=True,
        ).encode()
        actual_hash = hashlib.sha256(bundle_for_hash).hexdigest()
        if actual_hash == claimed_hash:
            print(f"  [✓] Bundle SHA-256 hash matches")
        else:
            print(f"  [✗] Bundle SHA-256 MISMATCH!")
            print(f"      Claimed: {claimed_hash}")
            print(f"      Actual:  {actual_hash}")
            errors.append("Hash mismatch — seed file may be tampered")
        # Estimate entropy from all source hashes combined
        source_data = json.dumps(data.get("sources", {})).encode()
        seed_bytes = len(source_data)
        entropy_bits = check_entropy_bits(source_data.hex())
    elif seed_hex:
        # SML / manual format
        try:
            seed_raw = bytes.fromhex(seed_hex)
        except ValueError:
            errors.append("seed_hex is not valid hexadecimal")
            seed_raw = b""
        if seed_raw and claimed_hash:
            actual_hash = hashlib.sha256(seed_raw).hexdigest()
            if actual_hash == claimed_hash:
                print(f"  [✓] SHA-256 hash matches")
            else:
                print(f"  [✗] SHA-256 MISMATCH!")
                print(f"      Claimed: {claimed_hash}")
                print(f"      Actual:  {actual_hash}")
                errors.append("Hash mismatch — seed file may be tampered")
        seed_bytes = len(seed_hex) // 2
        if seed_raw:
            entropy_bits = check_entropy_bits(seed_hex)
        else:
            entropy_bits = 0.0
    else:
        errors.append("No seed_hex and no sources — unrecognized format")
        seed_bytes = 0
        entropy_bits = 0.0

    print(f"  [·] Seed size: {seed_bytes} bytes")
    if seed_bytes * 8 < args.min_bits and seed_bytes > 0:
        warnings.append(f"Seed data below {args.min_bits} bits")

    print(f"  [·] Shannon entropy: {entropy_bits:.1f} bits")

    # Check weak patterns (only for seed_hex format)
    weak = check_weak_patterns(seed_hex) if seed_hex else []
    for w in weak:
        if w.startswith("CRITICAL"):
            errors.append(w)
            print(f"  [✗] {w}")
        else:
            warnings.append(w)
            print(f"  [!] {w}")

    # Check timestamp (both formats)
    ts = data.get("timestamp", 0)
    created_utc = data.get("created_utc", "")
    import time as _time
    if isinstance(ts, (int, float)) and ts > 0:
        age_hours = (_time.time() - ts) / 3600
        if age_hours > 24:
            warnings.append(f"Seed is {age_hours:.0f} hours old — consider regenerating")
        print(f"  [·] Age: {age_hours:.1f} hours")
    elif created_utc:
        print(f"  [·] Created: {created_utc}")

    # Check extra fields
    sources = data.get("sources", [])
    if sources:
        print(f"  [·] Entropy sources: {len(sources)}")

    # Summary
    print()
    if errors:
        for e in errors:
            print(f"  [✗] ERROR: {e}")
        print(f"\n  [!] Seed FAILED verification — DO NOT USE")
        sys.exit(1)
    elif warnings and args.strict:
        for w in warnings:
            print(f"  [!] WARNING: {w}")
        print(f"\n  [!] Seed has warnings (--strict mode) — review before use")
        sys.exit(1)
    else:
        if warnings:
            for w in warnings:
                print(f"  [!] {w}")
        print(f"  [✓] Seed verification PASSED")
        print(f"      {seed_bytes} bytes, {entropy_bits:.0f} bits entropy, hash verified")


if __name__ == "__main__":
    main()
