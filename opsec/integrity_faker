class CryptoSecureRNG:
    """Production-grade cryptographically secure RNG for OPSEC operations"""
    
    def __init__(self, seed_file: Path, source_file: Optional[Path] = None):
        self.seed_file = seed_file
        self.source_file = source_file
        self._ensure_entropy()
        self._init_rng()
    
    def _ensure_entropy(self):
        """Generate or load high-entropy seed for deterministic chaos"""
        if not self.seed_file.exists():
            seed_hex = secrets.token_hex(32)
            entropy_data = {
                "seed_hex": seed_hex,
                "sha256": hashlib.sha256(bytes.fromhex(seed_hex)).hexdigest(),
                "timestamp": int(time.time()),
                "sources": {"auto_generated": True}
            }
            
            # Write atomically with secure permissions
            temp_file = self.seed_file.with_suffix('.tmp')
            with open(temp_file, 'w') as f:
                json.dump(entropy_data, f, indent=2)
                f.flush()
                os.fsync(f.fileno())
            os.chmod(temp_file, 0o600)
            temp_file.replace(self.seed_file)
            os.chmod(self.seed_file, 0o600)
            
            print(f"[+] Generated cryptographic entropy seed: {self.seed_file}")
    
    def _init_rng(self):
        """Initialize deterministic RNG from entropy sources"""
        # Load primary entropy
        with open(self.seed_file, 'r') as f:
            entropy_data = json.load(f)
        
        primary_seed = (entropy_data.get("seed_hex")
                        or entropy_data.get("sha256")
                        or entropy_data.get("primary_seed")
                        or hashlib.sha256(json.dumps(entropy_data, sort_keys=True).encode()).hexdigest())
        
        # Combine with source file hash if available
        source_hash = "0" * 128
        if self.source_file and self.source_file.exists():
            source_content = self.source_file.read_bytes()
            source_hash = hashlib.sha512(source_content).hexdigest()
        
        # Create deterministic but cryptographically strong seed
        combined_entropy = primary_seed + source_hash
        seed_hash = hashlib.sha512(combined_entropy.encode()).hexdigest()
        
        # Use first 32 hex chars as integer seed for determinism
        seed_int = int(seed_hash[:32], 16)
        self.rng = random.Random(seed_int)
        
        print(f"[+] Initialized deterministic RNG (source: {self.source_file or 'none'})")

def sha256_hex(data: bytes) -> str:
    """Compute SHA256 hash and return as hex string"""
    return hashlib.sha256(data).hexdigest()

def sha512_hex(data: bytes) -> str:
    """Compute SHA512 hash for enhanced security"""
    return hashlib.sha512(data).hexdigest()

class IntegrityChainFaker:
    """Production-grade integrity chain faker for forensic evasion"""
    
    def __init__(self, rng: random.Random):
        self.rng = rng
        self.chain_data = []
        
    def _generate_realistic_detail(self, tag: str) -> str:
        """Generate realistic detail strings based on tag type"""
        templates = DETAIL_TEMPLATES.get(tag, ["trace={trace}"])
        template = self.rng.choice(templates)
        
        # Generate realistic values
        values = {
            "pid": self.rng.randint(1000, 65535),
            "version": f"{self.rng.randint(1,3)}.{self.rng.randint(0,9)}.{self.rng.randint(0,20)}",
            "hash8": self._random_hex(8),
            "endpoint": f"node{self.rng.randint(1,999)}",
            "latency": self.rng.randint(50, 2000),
            "block": self.rng.randint(1000000, 9999999),
            "error": self.rng.randint(1001, 9999),
            "retry": self.rng.randint(0, 5),
            "key_id": self._random_hex(16),
            "sig_len": self.rng.choice([64, 96, 128]),
            "algo": self.rng.choice(["ed25519", "secp256k1", "rsa2048"]),
            "iface": self.rng.choice(["eth0", "wlan0", "tun0"]),
            "ip": f"{self.rng.randint(10,192)}.{self.rng.randint(0,255)}.{self.rng.randint(0,255)}.{self.rng.randint(1,254)}",
            "mtu": self.rng.choice([1500, 1280, 9000]),
            "error_code": self.rng.randint(100, 999),
            "module": self.rng.choice(["crypto", "network", "rpc", "core"]),
            "line": self.rng.randint(1, 9999),
            "duration": self.rng.randint(1, 3600),
            "status": self.rng.choice(["OK", "WARN", "ERROR"]),
            "trace": self.rng.randint(10000, 99999)
        }
        
        return template.format(**values)
    
    def _random_hex(self, length: int) -> str:
        """Generate random hex string of specified length"""
        return ''.join(self.rng.choices('0123456789abcdef', k=length))
    
    def _generate_timestamp_sequence(self, count: int, base_time: Optional[int] = None) -> List[int]:
        """Generate realistic timestamp sequence with natural variance"""
        if base_time is None:
            # Start from a random time in the past (1-30 days ago)
            base_time = int(time.time()) - self.rng.randint(86400, 2592000)
        
        timestamps = []
        current_time = base_time
        
        for i in range(count):
            # Add realistic time intervals (30 seconds to 10 minutes)
            interval = self.rng.randint(30, 600)
            
            # Occasionally add longer gaps (maintenance windows, etc.)
            if self.rng.random() < 0.05:  # 5% chance
                interval += self.rng.randint(3600, 86400)  # 1-24 hours
            
            current_time += interval
            timestamps.append(current_time // 600 * 600)
        
        return timestamps
    
    def build_fake_chain(self, line_count: int, source_analysis: Optional[Dict] = None) -> List[str]:
        """Build a sophisticated fake integrity chain"""
        print(f"[+] Building fake integrity chain ({line_count} entries)...")
        
        # Initialize chain with genesis hash
        previous_hash = "0" * 64
        chain_entries = []
        
        # Generate realistic timestamp sequence
        timestamps = self._generate_timestamp_sequence(line_count)
        
        # Create weighted tag selection for realism
        tag_weights = self._calculate_tag_weights(source_analysis)
        
        for i, timestamp in enumerate(timestamps):
            # Select tag based on weights and position in chain
            tag = self._select_weighted_tag(tag_weights, i, line_count)
            
            # Generate realistic detail
            detail = self._generate_realistic_detail(tag)
            
            # Match gs_common.integrity_log format: ts|stage|msg
            entry_data = f"{timestamp}|{tag}|{detail}"
            
            # Compute chain hash (previous hash + current data)
            hash_input = (previous_hash + entry_data).encode()
            current_hash = sha256_hex(hash_input)
            
            # Format entry
            chain_entry = f"{current_hash} | {entry_data}"
            chain_entries.append(chain_entry)
            
            # Store for chain verification
            self.chain_data.append({
                "hash": current_hash,
                "timestamp": timestamp,
                "tag": tag,
                "detail": detail,
                "previous_hash": previous_hash
            })
            
            previous_hash = current_hash
            
            # Progress indicator
            if (i + 1) % 50 == 0:
                print(f"[+] Generated {i + 1}/{line_count} entries...")
        
        print(f"[+] Fake chain complete: {len(chain_entries)} entries")
        return chain_entries
    
    def _calculate_tag_weights(self, source_analysis: Optional[Dict]) -> Dict[str, float]:
        """Calculate realistic tag distribution weights"""
        # Default weights based on typical system behavior
        base_weights = {
            "RPC_OK": 0.4,      # Most operations succeed
            "RPC_FAIL": 0.1,    # Some failures expected
            "SIGN_OK": 0.15,    # Regular crypto operations
            "NET_UP": 0.05,     # Occasional network events
            "STAGE1": 0.08,     # Process stages
            "STAGE2": 0.08,
            "COMPLETE": 0.06,
            "ERROR": 0.04,      # Occasional errors
            "INIT": 0.02,       # Rare init events
            "INFO": 0.02        # Misc info
        }
        
        # Adjust based on source analysis if available
        if source_analysis and "tag_distribution" in source_analysis:
            # Blend source distribution with base weights
            source_dist = source_analysis["tag_distribution"]
            for tag, weight in source_dist.items():
                if tag in base_weights:
                    base_weights[tag] = 0.7 * base_weights[tag] + 0.3 * weight
        
        return base_weights
    
    def _select_weighted_tag(self, weights: Dict[str, float], position: int, total: int) -> str:
        """Select tag based on weights and chain position"""
        adjusted_weights = weights.copy()

        if total > 0 and position < total * 0.1:
            adjusted_weights["INIT"] = adjusted_weights.get("INIT", 0.01) * 3
            adjusted_weights["BOOT"] = adjusted_weights.get("BOOT", 0.01) * 5

        if total > 0 and position > total * 0.8:
            adjusted_weights["COMPLETE"] = adjusted_weights.get("COMPLETE", 0.01) * 2
            adjusted_weights["SHUTDOWN"] = adjusted_weights.get("SHUTDOWN", 0.01) * 3

        # Filter out zero/negative weights to avoid random.choices ValueError
        tags = [t for t, w in adjusted_weights.items() if w > 0]
        tag_weights = [adjusted_weights[t] for t in tags]

        if not tags:
            return "INFO"

        return self.rng.choices(tags, weights=tag_weights, k=1)[0]
    
    def verify_chain_integrity(self) -> bool:
        """Verify the fake chain maintains proper hash continuity"""
        print("[+] Verifying fake chain integrity...")
        
        previous_hash = "0" * 64
        for entry in self.chain_data:
            # Reconstruct hash
            entry_data = f"{entry['timestamp']}|{entry['tag']}|{entry['detail']}"
            expected_hash = sha256_hex((previous_hash + entry_data).encode())
            
            if expected_hash != entry['hash']:
                print(f"[!] Chain integrity failure at {entry['timestamp']}")
                return False
            
            previous_hash = entry['hash']
        
        print("[+] Chain integrity verified")
        return True

def analyze_source_file(source_path: Path) -> Optional[Dict]:
    """Analyze source integrity file to mimic its patterns"""
    if not source_path.exists():
        return None
    
    print(f"[+] Analyzing source file: {source_path}")
    
    try:
        with open(source_path, 'r') as f:
            lines = f.readlines()
        
        # Extract patterns
        tag_counts = {}
        timestamps = []
        
        for line in lines:
            line = line.strip()
            if '|' in line:
                try:
                    # Parse: hash | timestamp|tag|detail
                    parts = line.split(' | ', 1)
                    if len(parts) == 2:
                        data_part = parts[1]
                        data_fields = data_part.split('|')
                        if len(data_fields) >= 2:
                            timestamp = int(data_fields[0])
                            tag = data_fields[1]
                            
                            timestamps.append(timestamp)
                            tag_counts[tag] = tag_counts.get(tag, 0) + 1
                except (ValueError, IndexError):
                    continue
        
        # Calculate distributions
        total_tags = sum(tag_counts.values())
        tag_distribution = {tag: count/total_tags for tag, count in tag_counts.items()}
        
        analysis = {
            "total_lines": len(lines),
            "valid_entries": len(timestamps),
            "tag_distribution": tag_distribution,
            "time_span": max(timestamps) - min(timestamps) if timestamps else 0,
            "avg_interval": (max(timestamps) - min(timestamps)) / len(timestamps) if len(timestamps) > 1 else 0
        }
        
        print(f"[+] Source analysis complete: {analysis['valid_entries']} entries, {len(tag_distribution)} unique tags")
        return analysis
        
    except Exception as e:
        print(f"[!] Source analysis failed: {e}")
        return None

