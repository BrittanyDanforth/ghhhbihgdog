            print("\n=== FAKE INTEGRITY CHAIN ===")
            for entry in fake_chain:
                print(entry)
            return
        
        # Determine output path
        output_path = args.out
        if args.overwrite and args.source:
            output_path = args.source
            print(f"[!] WARNING: Overwriting source file {args.source}")
        
        # Write fake chain atomically
        temp_path = output_path.with_suffix('.tmp')
        with open(temp_path, 'w') as f:
            f.write('\n'.join(fake_chain) + '\n')
        
        temp_path.replace(output_path)
        os.chmod(output_path, 0o600)
        
        print(f"[+] Fake integrity chain written → {output_path}")
        print(f"[+] Entries: {len(fake_chain)}")
        print(f"[+] File size: {output_path.stat().st_size} bytes")
        
        # Security reminder
