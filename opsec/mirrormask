        all_lines = []
        for source in valid_sources:
            try:
                if source.suffix in ['.aes', '.enc', '.gpg']:
                    # Handle encrypted files - generate realistic placeholders
                    lines = self._generate_encrypted_placeholders(source, rng)
                else:
                    content = source.read_text(encoding='utf-8', errors='ignore')
                    lines = content.splitlines()
                
                all_lines.extend(lines)
                
            except Exception as e:
                print(f"[!] Warning: Could not process {source}: {e}")
                continue
        
        if not all_lines:
            raise ValueError("No content extracted from sources")
        
        # Statistical analysis
        authenticator = StatisticalAuthenticator(all_lines)
        
        # Generate mirror log
        target_count = max(int(len(all_lines) * multiplier), 100)
        mirror_lines = []
        
        # Extract and manipulate timestamps
        timestamps = self._extract_all_timestamps(all_lines)
        if not timestamps:
            base_time = int(time.time()) - 86400
            timestamps = [base_time + i * 300 for i in range(100)]
        
        # Generate authentic timestamp sequence (using crypto RNG for reproducibility)
        auth_timestamps = authenticator.generate_authentic_timestamps(
            target_count, min(timestamps) if timestamps else int(time.time()) - 86400,
            rng=rng
        )
        
        # Create mirror entries
        for i in range(target_count):
            # Select base line
            if all_lines:
                base_line = rng.choice(all_lines)
            else:
                base_line = f"{int(time.time())}|INFO|System maintenance"
            
            # Apply timestamp
            new_timestamp = auth_timestamps[i] if i < len(auth_timestamps) else int(time.time())
            
            # Replace timestamp in line
            mutated_line = re.sub(r'\b\d{10}\b', str(new_timestamp), base_line, count=1)
            
            # Apply mutations
            mutated_line = mutator.mutate_line(mutated_line)
            
            mirror_lines.append(mutated_line)
        
        # Sort chronologically for authenticity
        mirror_lines.sort(key=lambda x: self._extract_timestamp(x))
        
        return mirror_lines
    
    def _generate_encrypted_placeholders(self, encrypted_file: Path, rng: CryptoSecureRNG) -> List[str]:
        """Generate realistic placeholders for encrypted files"""
        file_size = encrypted_file.stat().st_size
        estimated_lines = max(file_size // 80, 10)  # Estimate based on file size
        
        placeholders = []
        base_time = int(encrypted_file.stat().st_mtime)
        
        for i in range(estimated_lines):
            timestamp = base_time + i * rng.randint(10, 300)
            operation = rng.choice(['ENC', 'DEC', 'HASH', 'SIGN', 'VERIFY'])
            hex_id = secrets.token_hex(12)
            
            line = f"{timestamp}|{operation}|{hex_id}|ENCRYPTED_PAYLOAD"
            placeholders.append(line)
        
        return placeholders
    
    def _extract_all_timestamps(self, lines: List[str]) -> List[int]:
        """Extract all timestamps from lines"""
        timestamps = []
        for line in lines:
            ts = self._extract_timestamp(line)
            if ts:
                timestamps.append(ts)
        return sorted(timestamps)
    
    def _extract_timestamp(self, line: str) -> Optional[int]:
        """Extract timestamp from a single line"""
        match = re.search(r'\b(\d{10})\b', line)
        return int(match.group(1)) if match else None
    
    def write_output(self, mirror_lines: List[str], output_path: Path, overwrite_source: bool = False):
        """Write output with secure atomic file operations"""
        if not mirror_lines:
            raise ValueError("No mirror lines to write")
        
        output_path.parent.mkdir(parents=True, exist_ok=True)
        atomic_write_text('\n'.join(mirror_lines), output_path, perms=0o600)
        print(f"[+] Mirror log written: {output_path} ({len(mirror_lines)} lines)")

