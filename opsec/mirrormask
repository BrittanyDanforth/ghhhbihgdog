        # Output handling
        if args.print_only:
            print('\n'.join(mirror_lines))
        else:
            output_path = source_paths[0] if args.overwrite else args.output
            mirrormask.write_output(mirror_lines, output_path, args.overwrite)
        
        # Success message
        print(f"[+] Mirrormask operation completed successfully")
        
    except KeyboardInterrupt:
        print("\n[!] Operation cancelled by user")
        sys.exit(1)
    except Exception as e:
        print(f"[!] Error: {e}")
        sys.exit(1)
    finally:
        try:
            # Only clean up our own temp files — namespace by _RUN_TAG
            # so we don't stomp on unrelated files on a shared /tmp.
            for temp_file in TEMP_DIR.glob("mirror_exec*.tmp"):
                temp_file.unlink(missing_ok=True)
            for temp_file in TEMP_DIR.glob(f"decoy_{_RUN_TAG}_*.log"):
                temp_file.unlink(missing_ok=True)
            for proc_name in DECOY_PROCESSES:
                for temp_file in TEMP_DIR.glob(f".{proc_name}_{_RUN_TAG}_*"):
                    temp_file.unlink(missing_ok=True)
        except OSError as e:
            integrity_log("mirrormask", f"finally_cleanup_fail:{type(e).__name__}")

if __name__ == "__main__":
    main()
