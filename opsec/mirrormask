class SystemFingerprint:
    """Generate unique system fingerprints for environment-specific seeding"""
    
    @staticmethod
    def get_hardware_id() -> str:
        """Generate hardware-based identifier"""
        try:
            # CPU info
            with open('/proc/cpuinfo', 'r') as f:
                cpu_info = f.read()
            cpu_hash = hashlib.sha256(cpu_info.encode()).hexdigest()[:16]
        except Exception:
            cpu_hash = platform.processor()
        
        # System info
        system_info = f"{platform.system()}-{platform.release()}-{platform.machine()}"
        
        # Network interfaces (MAC addresses)
        try:
            import subprocess
            result = subprocess.run(
                ['ip', 'link', 'show'], capture_output=True, text=True, timeout=10)
            network_hash = hashlib.sha256(result.stdout.encode()).hexdigest()[:16]
        except Exception:
            network_hash = str(uuid.getnode())
        
        combined = f"{cpu_hash}-{system_info}-{network_hash}"
        return hashlib.sha256(combined.encode()).hexdigest()
    
    @staticmethod
    def get_runtime_entropy() -> str:
        """Generate runtime-specific entropy"""
        entropy_sources = [
            str(os.getpid()),
            str(time.time()),
            str(os.urandom(16).hex()),
            str(threading.current_thread().ident),
            platform.node(),
            str(os.getcwd()),
            str(os.environ.get('USER', 'unknown'))
        ]
        
        combined = ''.join(entropy_sources)
        return hashlib.sha256(combined.encode()).hexdigest()

