class CryptoSecureRNG:
    """Cryptographically secure random number generator with environmental seeding"""
    
    def __init__(self, seed_file: Path, sources: List[Path]):
        self.seed_file = seed_file
        self.sources = sources
        self.rng = self._initialize_rng()
    
    def _initialize_rng(self) -> random.Random:
        """Initialize with maximum entropy from multiple sources"""
        entropy_components = []
        
        # Primary seed file. mirrormask is downstream of en_seeder in the
        # ghost_unifier pipeline — if the toolkit-wide seed is missing,
        # that means the pipeline was skipped or the seed was wiped. In
        # either case, silently generating a new one here would break
        # every other module's "same seed this session" contract AND
        # write the file in a schema that differs from en_seeder's
        # (primary_seed vs seed_hex). Fail loudly instead.
        if self.seed_file.exists():
            entropy_components.append(self.seed_file.read_bytes())
        else:
            raise FileNotFoundError(
                f"entropy seed file not found: {self.seed_file}\n"
                f"    Run `python3 modules/en_seeder` first (or the full "
                f"ghost_unifier pipeline) so every module shares the same "
                f"deterministic seed."
            )
        
        # Source file hashes
        for source in self.sources:
            if source.exists():
                entropy_components.append(source.read_bytes())
        
        # System-specific entropy
        entropy_components.append(SystemFingerprint.get_hardware_id().encode())
        entropy_components.append(SystemFingerprint.get_runtime_entropy().encode())
        entropy_components.append(secrets.token_bytes(32))
        
        # Combine all entropy sources
        combined_entropy = b''.join(entropy_components)
        final_seed = hashlib.sha512(combined_entropy).digest()
        
        # Use first 8 bytes as integer seed
        seed_int = int.from_bytes(final_seed[:8], byteorder='big')
        return random.Random(seed_int)
    
    def choice(self, sequence):
        return self.rng.choice(sequence)
    
    def randint(self, a, b):
        return self.rng.randint(a, b)
    
    def random(self):
        return self.rng.random()
    
    def shuffle(self, sequence):
        self.rng.shuffle(sequence)
    
    def sample(self, population, k):
        return self.rng.sample(population, k)

class AdvancedLogMutator:
    """Sophisticated log mutation with statistical authenticity"""
    
    def __init__(self, rng: CryptoSecureRNG):
        self.rng = rng
        self.mutation_patterns = self._load_mutation_patterns()
    
    def _load_mutation_patterns(self) -> Dict:
        """Load context-aware mutation patterns"""
        return CONTEXT_AWARE_MUTATIONS
    
    def detect_log_context(self, line: str) -> str:
        """Detect the context/category of a log line"""
        line_lower = line.lower()
        
        if any(keyword in line_lower for keyword in ['peer', 'network', 'connect', 'socket']):
            return 'network'
        elif any(keyword in line_lower for keyword in ['auth', 'sign', 'verify', 'encrypt', 'decrypt']):
            return 'security'
        else:
            return 'system'
    
    def mutate_line(self, line: str) -> str:
        """Apply sophisticated mutations while preserving authenticity"""
        if not line.strip():
            return line
        
        context = self.detect_log_context(line)
        mutations = self.mutation_patterns.get(context, self.mutation_patterns['system'])
        
        # Apply tag mutations
        for original, replacements in mutations.items():
            if original in line:
                replacement = self.rng.choice(replacements)
                line = line.replace(original, replacement)
        
        # Mutate hexadecimal identifiers
        line = re.sub(
            r'\b[0-9a-f]{8,64}\b',
            lambda m: self._generate_realistic_hex(len(m.group(0))),
            line
        )
        
        # Mutate numeric IDs
        line = re.sub(
            r'\b\d{4,12}\b',
            lambda m: str(self.rng.randint(1000, 999999999)),
            line
        )
        
        # Mutate IP addresses
        line = re.sub(
            r'\b(?:\d{1,3}\.){3}\d{1,3}\b',
            lambda m: self._generate_realistic_ip(),
            line
        )
        
        return line
    
    def _generate_realistic_hex(self, length: int) -> str:
        """Generate realistic hexadecimal strings"""
        return secrets.token_hex(length // 2)[:length]
    
    def _generate_realistic_ip(self) -> str:
        """Generate realistic IP addresses"""
        # Use common private ranges
        ranges = [
            (192, 168),
            (172, 16),
            (10, 0)
        ]
        
        range_choice = self.rng.choice(ranges)
        return f"{range_choice[0]}.{range_choice[1]}.{self.rng.randint(1, 254)}.{self.rng.randint(1, 254)}"

class StatisticalAuthenticator:
    """Ensure statistical authenticity of generated logs"""
    
    def __init__(self, original_logs: List[str]):
        self.original_logs = original_logs
        self.patterns = self._analyze_patterns()
    
    def _analyze_patterns(self) -> Dict:
        """Analyze patterns in original logs"""
        patterns = {
            'avg_line_length': 0,
            'timestamp_intervals': [],
            'common_prefixes': defaultdict(int),
            'log_levels': defaultdict(int)
        }
        
        if not self.original_logs:
            return patterns
        
        # Line length analysis
        lengths = [len(line) for line in self.original_logs]
        patterns['avg_line_length'] = sum(lengths) / len(lengths)
        
        # Timestamp interval analysis
        timestamps = self._extract_timestamps(self.original_logs)
        if len(timestamps) > 1:
            intervals = [timestamps[i] - timestamps[i-1] for i in range(1, len(timestamps))]
            patterns['timestamp_intervals'] = intervals
        
        # Prefix analysis
        for line in self.original_logs:
            if len(line) > 10:
                prefix = line[:10]
                patterns['common_prefixes'][prefix] += 1
        
        return patterns
    
    def _extract_timestamps(self, lines: List[str]) -> List[int]:
        """Extract timestamps from log lines"""
        timestamps = []
        for line in lines:
            # Look for Unix timestamps
            match = re.search(r'\b(\d{10})\b', line)
            if match:
                timestamps.append(int(match.group(1)))
        return sorted(timestamps)
    
    def generate_authentic_timestamps(self, count: int, base_time: int,
                                       rng: Optional[CryptoSecureRNG] = None) -> List[int]:
        """Generate statistically authentic timestamps.
        Uses provided CryptoSecureRNG for deterministic reproducibility;
        falls back to secrets-based choices if no RNG given.
        """
        if not self.patterns['timestamp_intervals']:
            intervals = [30, 60, 120, 300, 600]
        else:
            intervals = self.patterns['timestamp_intervals']

        _choice = rng.choice if rng else (lambda seq: secrets.choice(seq))
        _randint = rng.randint if rng else (lambda a, b: secrets.randbelow(b - a + 1) + a)

        timestamps = [base_time]
        for _ in range(count - 1):
            interval = _choice(intervals)
            jitter = _randint(-interval // 4, interval // 4) if interval > 0 else 0
            timestamps.append(timestamps[-1] + interval + jitter)

        return timestamps

