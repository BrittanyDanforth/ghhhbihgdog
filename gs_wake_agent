def _tool(name: str) -> str:
    return str(Path(__file__).resolve().parent / name)


_GHOST = [None]


def _ghost():
    """GhostSpiral as a module, loaded the way gs_console loads it. Lazy."""
    if _GHOST[0] is None:
        _l = importlib.machinery.SourceFileLoader("GhostSpiral", _tool("GhostSpiral"))
        _s = importlib.util.spec_from_loader("GhostSpiral", _l)
        _m = importlib.util.module_from_spec(_s)
        _l.exec_module(_m)
        _GHOST[0] = _m
    return _GHOST[0]


#: The shallowest depth's wallet count: the floor is "the smallest minimum of
#: any depth", because the depth is chosen later, on another surface. READ
#: FROM THE PROTOCOL'S OWN TABLE, not typed: this was a literal 3 beside
#: WITHDRAW_DEPTHS[1] = (3, ...), and it feeds the deposit gate, the
#: below-minimum refusal and the "more left" floor -- three places that
#: would have gone on using a stale count if the table ever changed.
_MIN_OUT_WALLETS = proto.WITHDRAW_DEPTHS[min(proto.WITHDRAW_DEPTHS)][0]


def live_floor_xmr(key: dict, wallets: int) -> str:
    """The mix floor at TODAY'S fee for `wallets` mix outputs, from the
    daemon this keyfile names. live_min_out_xmr is this at the shallowest
    depth; the fee sweep asks for its own depth.

    THE MIRROR WAS A SNAPSHOT AT A FEE SIXTY TIMES TODAY'S. Every site that
    needed the floor read gs_wake_proto's MIX_MINIMUM_XMR_MIRROR, a string
    computed once at a fallback fee of 0.0024 XMR per transaction; mainnet
    charges about 0.00004. So the deposit gate refused every quote under
    roughly 0.18 XMR, and the withdraw chain answered "" -- nothing more here
    -- for every leftover under it: money left unmixed on the entry address
    and reported as absent. The daemon is on this machine and answers in
    milliseconds. It is asked; the mirror is the answer only when it cannot
    be, and the chain records that it fell back.

    A string, because that is what travels to an argv and what the callers
    parse -- the mirror's own rule.
    """
    try:
        daemon = str(key.get("rpc_daemon") or "http://127.0.0.1:18081")
        proxies = None
        if key.get("tor_proxy"):
            proxies = isolated_proxy(str(key["tor_proxy"]), "min_out")
        fee_xmr, _src = fee_estimate_per_tx(daemon_fee_estimate(daemon, proxies), 1)
        # The same plausibility bound GhostSpiral's own fee path applies: a
        # fresh or offline daemon reports a fee that would put the floor at
        # hundreds of XMR, and that must not become the gate either.
        if fee_xmr is None or not (Decimal(0) < fee_xmr < Decimal("1.0")):
            raise ValueError("no plausible fee estimate")
        floor = _ghost().mix_minimum_xmr(fee_xmr, int(wallets),
                                         dag_mixing=True, exit_set=True, chunks=1)
        if not (Decimal(0) < floor < Decimal(100)):
            raise ValueError("implausible floor")
        return str(floor)
    except Exception:                                        # noqa: BLE001
        integrity_log("wake", "min_out:mirror_fallback")
        return proto.deposit_min_out_xmr()


def live_min_out_xmr(key: dict) -> str:
    """The deposit gate's floor: the live floor at the shallowest depth."""
    return live_floor_xmr(key, _MIN_OUT_WALLETS)



#: The fee wallet's sweep: how much must have gathered, unlocked, on the fee
#: address before a sweep runs when the keyfile names no figure, and the
#: bundle the sweep hands GhostSpiral as its entry.
FEE_SWEEP_MIN_XMR_DEFAULT = Decimal("0.5")
FEE_SWEEP_BUNDLE = "wallet_feesweep.json"
#: A sweep CHAINS like a withdrawal does: leg after leg while the largest
#: unlocked output still clears the floor, so what one leg leaves behind
#: (change, a remainder) is picked up by the next. Bounded twice: by legs, and
#: by the boot's wall clock -- the unit stops the agent at 17 h, and a leg
#: must have its whole budget left to start. At depths 2 and 3 that is one leg
#: per boot; the rest is the NEXT boot's, which asks the same question again.
#:
#: THE WALL IS A WITHDRAWAL'S BUDGET AND TEN MINUTES, so the deepest leg --
#: which now carries the same margin a withdrawal does -- still fits once,
#: and the deadman armed for it (the wall and ten more) stays inside the
#: unit's TimeoutStartSec.
FEE_SWEEP_MAX_LEGS = 3
FEE_SWEEP_WALL_S = proto.JOBS["withdraw"]["budget_s"] + 600


def fee_sweep_config(key: dict):
    """The fee wallet's settings from the keyfile: complete, or None.

    ALL OR NOTHING. fee_rpc (the fee wallet's view-only wallet-rpc),
    fee_wallet_file (the full fee wallet the sweep signs with) and
    fee_sweep_to (where a sweep lands) are one setting; a keyfile carrying
    some of them is a pairing that went wrong, and a sweep started on it
    would relay a fan-out and fail at the signing step. Refused, not guessed.
    None means no fee wallet was paired, which is the ordinary case.
    """
    bits = {k: key.get(k) for k in ("fee_rpc", "fee_wallet_file",
                                    "fee_sweep_to")}
    if not any(bits.values()):
        return None
    if not all(bits.values()):
        raise Refused("fee_sweep_misconfigured",
                      "this keyfile names part of a fee wallet -- some of "
                      "fee_rpc, fee_wallet_file and fee_sweep_to but not all "
                      "three. Pair again with all of them, or none.")
    dests = bits["fee_sweep_to"]
    if not isinstance(dests, list) or not dests \
            or not all(isinstance(a, str) and a.strip() for a in dests):
        raise Refused("fee_sweep_misconfigured",
                      "fee_sweep_to in this keyfile is not a list of "
                      "addresses.")
    depth = key.get("fee_sweep_depth", 2)
    # NOT A BOOL: True == 1 and hashes as 1, so `true` read as depth 1.
    if isinstance(depth, bool) or depth not in proto.WITHDRAW_DEPTHS:
        raise Refused("fee_sweep_misconfigured",
                      f"fee_sweep_depth {depth!r} is not a depth this "
                      f"protocol has.")
    try:
        min_xmr = Decimal(str(key.get("fee_sweep_min_xmr")
                              or FEE_SWEEP_MIN_XMR_DEFAULT))
        if not min_xmr.is_finite() or min_xmr <= 0:
            raise ValueError
    except (ValueError, ArithmeticError):
        raise Refused("fee_sweep_misconfigured",
                      "fee_sweep_min_xmr in this keyfile is not a positive "
                      "amount.")
    addr = str(key.get("fee_address") or "").strip()
    if not addr:
        raise Refused("fee_sweep_misconfigured",
                      "this keyfile names a fee wallet but no fee address; "
                      "pairing mints one, so pair again.")
    if addr in [a.strip() for a in dests]:
        raise Refused("fee_sweep_misconfigured",
                      "fee_sweep_to names the fee address itself, so a sweep "
                      "would go round in a circle. Pair again.")
    return {"rpc": str(bits["fee_rpc"]).strip(),
            "wallet_file": str(bits["fee_wallet_file"]).strip(),
            "dests": [a.strip() for a in dests],
            "depth": int(depth), "min_xmr": min_xmr, "address": addr,
            # A SWITCH THAT MOVES MONEY IS A BOOLEAN, NEVER COERCED (the
            # vault review: 3f9b060 made the spending switches so and left
            # this one): bool("false") and bool("no") are True, and a hand
            # edit meant as "off" ran the fee wallet's mix on every boot
            # the doorbell did not answer -- a stranger's magic packet
            # among them.
            "on_idle_boot": _key_switch(key, "fee_sweep_on_idle_boot",
                                        "fee_sweep_misconfigured")}


def fee_wallet_entry(key: dict, cfg: dict, injected=None):
    """(account, subaddress, address, unlocked_atomic): the largest unlocked
    output anywhere on the FEE wallet, or None.

    ANYTHING ON THE FEE WALLET IS THE HOST'S. The cuts land on the one fee
    address pairing minted, but a sweep is a mix, and a mix leaves things
    behind on other subaddresses of the wallet it ran from -- the fan-out's
    change, a held remainder. The first version read the fee address alone,
    so everything a sweep left behind was money no sweep would ever look at
    again. This asks the same question the client's withdrawal asks of the
    mixing wallet -- the largest unlocked output, anywhere -- so a later
    sweep picks up what an earlier one left, and "the fees always get mixed
    out eventually" is true of all of them and not of the first output only.

    WHICH IS ONLY TRUE OF THE FEE WALLET: see fee_wallet_mismatch, which
    run_fee_sweep asks first.
    """
    return _funded_entry(key, injected=injected, rpc_url=cfg["rpc"])


def _wallet_owns(key: dict, url, address: str, connect=None):
    """gs_common.wallet_rpc_owns -- True, False (foreign) or None (no
    answer) -- over the keyfile's Tor proxy, with connect_rpc's exit on a
    URL it will not speak to read as no answer: a question does not end
    the agent."""
    from gs_common import wallet_rpc_owns
    try:
        return wallet_rpc_owns(url, address,
                               proxy_url=key.get("tor_proxy", ""),
                               connect=connect)
    except SystemExit:
        return None


def _wallet_primary(key: dict, url, connect=None):
    """gs_common.wallet_rpc_primary, on the same terms as _wallet_owns."""
    from gs_common import wallet_rpc_primary
    try:
        return wallet_rpc_primary(url, proxy_url=key.get("tor_proxy", ""),
                                  connect=connect)
    except SystemExit:
        return None


def fee_wallet_mismatch(key: dict, cfg: dict, connect=None) -> str:
    """"" when the fee wallet-rpc is serving the fee wallet and not the
    mixing wallet; otherwise the reason, as a fee_sweep code. Asked before a
    sweep reads a balance.

    THE PAIRING ASKED THIS ONCE, AND NOTHING ASKED IT AGAIN. gs_wake_keys
    refuses a --fee-rpc equal to --rpc, a fee wallet file that is the
    mixing wallet's, and a fee address the mixing wallet owns. Each of those
    is true at the moment of pairing. None of them binds what is listening
    on the fee port months later. fee_wallet_entry takes the largest
    unlocked output on WHATEVER wallet answers there, as the host's. So a
    fee wallet-rpc restarted on the mixing wallet, or on a copy of it, or a
    keyfile edited by hand before the settings were sealed, swept a
    client's deposit to the operator's own addresses. It ran as an ordinary
    successful sweep, and nothing said anything.

    WHAT IT RESTS ON, stated. Two wallet-rpcs whose wallets have the same
    primary address hold the same keys -- a primary address IS the public
    spend and view keys -- so the fee wallet-rpc and the mixing wallet-rpc
    must each name theirs, and the two must differ: that is the question
    that tells a COPY of the mixing wallet from the fee wallet, however the
    files are named and however deep either has minted. Then the fee
    address: a wallet can place it in its subaddress table only if it holds
    the fee wallet's view key and public spend key, so the fee wallet-rpc
    must answer an index for it (it is serving the wallet the cuts land
    on), and the mixing wallet-rpc must answer "foreign" (-2). A subaddress
    answer alone was not enough: wallet2's table ends 200 past the deepest
    subaddress handed out in an account, so a same-keys wallet answers
    "foreign" for one minted deeper than that. EVERY answer is required:
    a wallet-rpc down, locked or with no wallet open has said nothing, and
    the sweep waits (the review of this check: read as "foreign", the one
    case the check exists for went through).

    All of it rests on the processes on those two loopback ports being
    honest wallet-rpcs, which is to say on this machine not being someone
    else's: a process that answers anything on loopback beats every check
    here, and the keys on this disk with it. The endpoint and signing-file
    comparisons in front are the cheap half: they catch the plain mistakes
    without a wallet call, and nothing rests on a port or a path being
    unguessable. The files compared are the ones GhostSpiral SIGNS with
    (gs_common.signing_files: `<base>.keys`, symlinks followed), not the
    paths as typed -- `mix.keys`, or `fee.keys` linked to `mix.keys`, is the
    mixing wallet's spend key whatever the string says.

    run_fee_sweep asks it before every leg, so a wallet-rpc restarted on
    another wallet in the hours a leg runs stops the next one. What a
    running leg does is GhostSpiral's, against the wallet-rpc it was given.
    `connect` stands in for connect_rpc in the suites.
    """
    from gs_common import rpc_endpoint as _endpoint, \
        signing_files as _signing_files
    if _endpoint(cfg["rpc"]) is not None \
            and _endpoint(cfg["rpc"]) == _endpoint(key.get("rpc_primary")):
        return "wallet_is_mixing"
    if _signing_files(key.get("wallet_file")) \
            & _signing_files(cfg["wallet_file"]):
        return "wallet_is_mixing"
    _p_mix = _wallet_primary(key, key.get("rpc_primary"), connect)
    _p_fee = _wallet_primary(key, cfg["rpc"], connect)
    if _p_mix is None or _p_fee is None:
        return "wallet_unverified"
    if _p_mix == _p_fee:
        return "wallet_is_mixing"
    _mix = _wallet_owns(key, key.get("rpc_primary"), cfg["address"], connect)
    if _mix is True:
        return "wallet_is_mixing"
    if _mix is None:
        return "wallet_unverified"
    if _wallet_owns(key, cfg["rpc"], cfg["address"], connect) is not True:
        return "wallet_unverified"
    return ""


def fee_sweep_decision(unlocked_xmr, min_xmr, floor_xmr) -> tuple:
    """(go, why). A sweep runs when what is unlocked clears BOTH the figure
    the operator set and the live mix floor for the sweep's depth -- the
    floor is what the mix needs to plan at all, the figure is how much the
    operator wants gathered before one runs."""
    u, m, f = Decimal(unlocked_xmr), Decimal(min_xmr), Decimal(floor_xmr)
    if u < m:
        return False, "below_threshold"
    if u < f:
        return False, "below_floor"
    return True, "ok"


def build_fee_sweep_argv(key: dict, cfg: dict, bundle: str,
                         artifact_dir: Path) -> tuple:
    """(argv, env_extra) for the sweep: GhostSpiral's withdraw shape, aimed at
    the FEE wallet and the operator's own destinations.

    THE SAME SHAPE AS A WITHDRAWAL, on purpose: view-only rpc, offline
    signing with the fee wallet's file, DAG mixing at the chosen depth, exit
    to fee_sweep_to. No --usage-fee -- a fee on the fee would send a slice of
    it straight back to the fee address. The password reaches the child as
    GS_WALLET_PASSWORD, because that is the name GhostSpiral reads; it comes
    from GS_FEE_WALLET_PASSWORD here so the two wallets' passwords are never
    one setting. run_child scrubs every other GS_* variable from the child.
    """
    if not has_secret("GS_FEE_WALLET_PASSWORD"):
        integrity_log("wake", "fee_sweep:password_unset")
        raise Refused(
            "fee_wallet_password_unset",
            "the machine has no fee-wallet password configured, so the fee "
            "wallet cannot be opened to sign. Nothing was spent. Set "
            "GS_FEE_WALLET_PASSWORD at the machine -- to an empty value if "
            "the wallet genuinely has none, so that choice is on the record."
            + _reseal_hint("GS_FEE_WALLET_PASSWORD"))
    argv = [sys.executable, _tool("GhostSpiral"),
            "--tor-proxy", str(key.get("tor_proxy") or ""),
            "--rpc-primary", cfg["rpc"],
            "--rpc-daemon", str(key.get("rpc_daemon")
                                or "http://127.0.0.1:18081"),
            "--receive-wallet", str(bundle),
            "--wallet-file", cfg["wallet_file"],
            "--dag-mixing",
            "--wallets", str(withdraw_wallets(cfg["depth"])),
            "--output", str(artifact_dir)]
    env = {"GS_EXIT_TO": " ".join(cfg["dests"]),
           "GS_WALLET_PASSWORD": secret_of("GS_FEE_WALLET_PASSWORD")}
    return argv, env


def run_fee_sweep(key: dict, artifact_dir: Path, deps: dict = None,
                  dry_run: bool = False) -> str:
    """Mix what has gathered on the fee address to the operator's own
    addresses, if it clears the threshold and the floor. Returns a code.

    NOTHING HERE REACHES THE PHONE. The sweep is the operator's own money
    moving between the operator's own wallets; the chat is the surface a
    stranger reads, and a "fee sweep" on it would name the arrangement.
    The outcome is on this machine's terminal or job log, and in the
    integrity chain as fee_sweep:<code> -- no amount, no address.
    """
    d = deps or {}
    _clock = d.get("clock", time.monotonic)
    cfg = fee_sweep_config(key)
    if cfg is None:
        return "not_configured"
    wallets = withdraw_wallets(cfg["depth"])
    floor = Decimal(d.get("live_floor", live_floor_xmr)(key, wallets))
    # THE SAME MARGIN A WITHDRAWAL GETS (see proto.WITHDRAW_BUDGET_MARGIN):
    # this is a kill budget, and the bare depth figure leaves nothing for a
    # slow chain's confirmations.
    leg_budget = int(proto.WITHDRAW_DEPTHS[cfg["depth"]][1]
                     * proto.WITHDRAW_BUDGET_MARGIN)
    _jl = artifact_dir / JOB_LOG
    try:
        _watched = sys.stdout.isatty()
    except Exception:                                        # noqa: BLE001
        _watched = False
    t0 = _clock()
    legs = 0
    _armed = False
    while True:
        # THE FEE WALLET HAS TO BE THE FEE WALLET, asked of the wallets
        # themselves before every balance is read (fee_wallet_mismatch) --
        # before EVERY leg, not once: a leg is hours, and what answers on
        # the fee port after one is whatever was started there since.
        _mis = fee_wallet_mismatch(key, cfg, connect=d.get("wallet_rpc"))
        if _mis:
            integrity_log("wake", f"fee_sweep:{_mis}")
            agent_say("  [!] Fee sweep: "
                      + ("the wallet-rpc named as the fee wallet is serving "
                         "the MIXING wallet, whose money is the clients'. "
                         if _mis == "wallet_is_mixing" else
                         "it cannot be shown that the fee wallet is not the "
                         "mixing wallet: each wallet-rpc has to name its own "
                         "wallet, the two have to differ, the fee wallet-rpc "
                         "has to own the fee address and the mixing one has "
                         "to say it does not -- and one of those answers "
                         "did not come. ")
                      + ("Nothing was read or spent. " if legs == 0 else
                         f"{legs} leg(s) ran before this and moved what "
                         f"they moved; no further leg was started. ")
                      + "Check which wallet each wallet-rpc on this machine "
                        "has open.")
            if legs:
                _retire_fee_bundle(artifact_dir)
            return _mis
        found = fee_wallet_entry(key, cfg, injected=d.get("fee_entry"))
        if not found:
            if legs == 0:
                integrity_log("wake", "fee_sweep:nothing")
                agent_say("  [*] Fee sweep: nothing unlocked on the fee "
                          "wallet.")
                return "nothing"
            break
        acct, sub, addr, atomic = found
        unlocked = Decimal(str(atomic)) / Decimal(10 ** 12)
        # THE THRESHOLD IS THE TRIGGER, THE FLOOR IS THE LAW. The operator's
        # figure decides whether a sweep STARTS; once one has run, every
        # later leg needs only what the mix needs to plan, so what a leg
        # leaves behind is taken while the machine is already on and open.
        go, why = fee_sweep_decision(
            unlocked, cfg["min_xmr"] if legs == 0 else Decimal(0), floor)
        if not go:
            if legs == 0:
                integrity_log("wake", f"fee_sweep:{why}")
                agent_say(f"  [*] Fee sweep: {unlocked} XMR is the most on "
                          f"one output of the fee wallet; a sweep needs "
                          f"{max(cfg['min_xmr'], floor)} "
                          f"({why.replace('_', ' ')}). Nothing spent.")
                return why
            integrity_log("wake", "fee_sweep:rest_under_floor")
            agent_say(f"  [*] Fee sweep: what remains ({unlocked} XMR on the "
                      f"largest output) is under the floor ({floor}); it "
                      f"stays until more gathers.")
            break
        if dry_run:
            agent_say(f"  [+] Fee sweep (dry run): {unlocked} XMR unlocked on "
                      f"the fee wallet clears the threshold; a real run would "
                      f"mix it at depth {cfg['depth']} to "
                      f"{len(cfg['dests'])} address(es), leg after leg. "
                      f"Nothing spent.")
            return "dry_run"
        if legs >= FEE_SWEEP_MAX_LEGS \
                or (_clock() - t0) + leg_budget > FEE_SWEEP_WALL_S:
            integrity_log("wake", "fee_sweep:more_left")
            agent_say(f"  [*] Fee sweep: more remains ({unlocked} XMR on the "
                      f"largest output) but this boot cannot fit "
                      f"{'another' if legs else 'a'} leg. The next sweep "
                      f"picks it up.")
            if legs == 0:
                return "more_left"
            break
        # THE BACKSTOP MUST OUTLAST THE SWEEP, AND NOTHING HERE ARMED ONE.
        # The shipped deadman is 9300 s, sized for the largest non-spending
        # job; a leg at depth 2 or 3 runs far past it. So an idle-boot
        # sweep was a mix the vault powers off in the middle of -- the one
        # failure GhostSpiral cannot recover from on its own -- with the
        # fee wallet's money half-moved, on the path built so that money is
        # never left half-moved. A withdrawal arms a longer one at
        # _run_validated; the sweep spends the same way and gets the same
        # rule, applied once for the whole wall the loop is allowed, before
        # anything spends. A refusal here has spent nothing.
        if not _armed:
            if not d.get("extend_deadman", extend_deadman)(
                    int(FEE_SWEEP_WALL_S) + 600):
                integrity_log("wake", "fee_sweep:deadman_too_short")
                agent_say("  [!] Fee sweep: could not arm a backstop long "
                          "enough for a mix, so nothing was started. The "
                          "short one is still armed and this machine will "
                          "still power itself off.")
                return "deadman_too_short"
            _armed = True
        bundle = artifact_dir / FEE_SWEEP_BUNDLE
        atomic_write_json({"schema": "gs_receive_wallet_v1",
                           "address": addr,
                           "account_index": int(acct),
                           "subaddress_index": int(sub),
                           "rpc_endpoint": cfg["rpc"]},
                          bundle, perms=0o600)
        argv, env_extra = build_fee_sweep_argv(key, cfg, str(bundle),
                                               artifact_dir)
        agent_say(f"  [*] Fee sweep leg {legs + 1}: {unlocked} XMR unlocked "
                  f"on the fee wallet. Mixing it at depth {cfg['depth']} to "
                  f"{len(cfg['dests'])} address(es); output "
                  f"{'follows on this terminal' if _watched else '-> ' + str(_jl)}.")
        if legs == 0:
            integrity_log("wake", "fee_sweep:start")
        # A CHILD IS ABOUT TO SPEND. The flag run_once's handler reads to
        # choose between "refused before it started" and "failed" was set
        # only by _dispatch; a sweep's GhostSpiral is the one tool that
        # spends and it went unmarked.
        _CHILD_STARTED[0] = True
        # A STOP BETWEEN LEGS LEAVES NOTHING BEHIND. The bundle for this leg
        # is already written, and run_child refuses to spawn once a stop is
        # asked -- so a stop that landed during the previous leg, which
        # then exited cleanly, raised past both _retire_fee_bundle calls
        # below and left the fee wallet's account, subaddress and address
        # in plaintext, outside the seal (FEE_SWEEP_BUNDLE is not a member)
        # and outside anything else that removes it. And the operator never
        # saw the "may already have moved" warning the failure path prints.
        # A stop noticed DURING a leg that then exits 0 is checked for here
        # too, so the next leg's wallet queries are not spent on it.
        _stopped = None
        try:
            rc, killed = run_child(argv, env_extra, leg_budget,
                                   runner=d.get("run_child"),
                                   log_path=None if _watched else _jl)
        except Stopping as _st:
            rc, killed, _stopped = None, False, _st
        if rc is not None:
            legs += 1
        if rc == 0:
            try:
                _stop_if_asked()
            except Stopping as _st:
                _stopped = _st
        if _stopped is not None:
            _retire_fee_bundle(artifact_dir)
            integrity_log("wake", "fee_sweep:stopped")
            agent_say(f"  [!] Fee sweep stopped after {legs} leg(s)."
                      + (" Some of it may already have moved: check the "
                         "fee wallet's balances and the job log before "
                         "running another." if legs else
                         " Nothing was spent."))
            raise _stopped
        if rc != 0:
            code = "killed" if killed else "failed"
            integrity_log("wake", f"fee_sweep:{code}")
            agent_say(f"  [!] Fee sweep {code} on leg {legs} (exit {rc}). "
                      f"Some of it may already have moved: check the fee "
                      f"wallet's balances and the job log before running "
                      f"another.")
            _retire_fee_bundle(artifact_dir)
            return code
    integrity_log("wake", "fee_sweep:done")
    _retire_fee_bundle(artifact_dir)
    agent_say(f"  [+] Fee sweep finished: {legs} leg(s).")
    return "done"


def _retire_fee_bundle(artifact_dir: Path) -> None:
    """THE ENTRY BUNDLE NAMED THE FEE WALLET'S OUTPUT. Gone with the sweep,
    finished or not: it said only where the sweep started from, on a disk
    that auto-unlocks, and the wallet still knows that for itself."""
    try:
        if (artifact_dir / FEE_SWEEP_BUNDLE).is_file():
            secure_delete_or_warn(artifact_dir / FEE_SWEEP_BUNDLE,
                                  "the fee sweep's entry bundle")
    except Exception:                                        # noqa: BLE001
        integrity_log("wake", "retire_failed:fee_bundle")


def _half_bytes(half_hex: str):
    """The Pi's half from a hex string an operator typed, or None. One
    parser, so `--unseal-state`, `--unseal-key` and `--seal-secrets` cannot
    disagree about what a half looks like."""
    try:
        raw = bytes.fromhex(str(half_hex or "").strip())
    except ValueError:
        return None
    return raw if len(raw) == proto.STATE_HALF_BYTES else None


def _by_hand(key: dict, half_hex: str, what: str,
             flag: str = "--unseal-state") -> dict:
    """Open a sealed keyfile with a half the operator typed, or refuse.

    The two boots that have no wake note -- `--fee-sweep` and the recovery
    CLI -- both need this and both have somebody standing at the machine.
    An unsealed keyfile falls straight through, so nothing about a pairing
    from before stage 8 changes.

    `flag` IS THE ONE THEY TYPED, and each refusal says which of three
    things went wrong. It said "brings no half ... pass it here as
    `--unseal-state <hex>`" for all of them: to an operator who HAD passed
    a half to --unseal-key, one character short, it named a different
    command -- the one that writes every sealed record out in the clear --
    and a well-formed wrong half was blamed on a re-pairing, when at the
    keyboard a typo is the likeliest cause by far.
    """
    if key.get(KEYFILE_SEALED) is None:
        return key
    vault, _ = state_halves(key)
    _typed = str(half_hex or "").strip()
    try:
        pi = bytes.fromhex(_typed)
    except ValueError:
        pi = b""
    _get = (f"Print it on the Pi with `gs_doorbell state-key` -- or take "
            f"the copy inside the LUKS USB -- and run `{flag} "
            f"{_key_flag()}`, which asks for it without echo.")
    if vault is None:
        raise Refused(
            "keyfile_half_needed",
            "this machine's keyfile has a sealed section and no half of its "
            "own to open it with, so it has been altered. Re-pair rather "
            "than run on half a keyfile.", power=False)
    if not _typed:
        raise Refused(
            "keyfile_half_needed",
            f"this machine's settings are sealed to the pair, and {what} "
            f"brings no half of the key. {_get}", power=False)
    if len(pi) != proto.STATE_HALF_BYTES:
        raise Refused(
            "keyfile_half_needed",
            f"what was passed to `{flag}` is not a half of the key: that is "
            f"{proto.STATE_HALF_BYTES * 2} hex characters, and this was "
            f"{len(_typed)} character(s)"
            f"{'' if all(c in '0123456789abcdefABCDEF' for c in _typed) else ', not all of them hex'}. "
            f"{_get}", power=False)
    try:
        return open_keyfile(key, vault, pi)
    except Refused as e:
        if e.code == "keyfile_unreadable":
            e.msg = (f"the half passed to `{flag}` does not open this "
                     f"machine's sealed settings. At the keyboard the "
                     f"likeliest reason is a typo: print it again with "
                     f"`gs_doorbell state-key` on the Pi and compare. If it "
                     f"is right, then: " + e.msg)
        e.power = False
        raise


def run_fee_sweep_cli(args, deps: dict = None) -> str:
    """`gs_wake_agent --fee-sweep`: the sweep by hand, with the same preflight
    a wake gets and without asking the doorbell for anything."""
    d = deps or {}
    key = load_key(Path(args.key))
    # THE SWEEP RUNS ON A BOOT WITH NO NOTE, so if this keyfile is sealed
    # (STAGE8_PLAN.md §4) the fee wallet's settings are behind a half that
    # nothing here has. The operator is standing at the machine -- that is
    # the whole premise of this flag -- so they can hand it over, from the
    # copy inside the LUKS USB that OPSEC_SETUP.md section 1 tells them to
    # keep. Refuse loudly rather than report "this keyfile names no fee
    # wallet", which would be a true sentence about the wrong thing.
    _hex = getattr(args, "unseal_state", "")
    _sp = _secrets_path(args)
    # Whether the typed half has been PROVEN by the time the secrets are
    # opened: a sealed keyfile opening under it is proof, and then a
    # secrets file that will not open is not a typo.
    _proven = key.get(KEYFILE_SEALED) is not None
    try:
        key = _by_hand(key, _hex, "a fee sweep on a box nothing woke")
        # THE FEE WALLET'S PASSWORD IS A SEALED SECRET TOO. Opened only
        # when a sealed file is THERE, and refused rather than skipped when
        # it is there and cannot be opened. It was skipped: with no half on
        # the argv (or one that did not parse) the sweep fell through to
        # the environment -- the fallback open_secrets refuses on a woken
        # boot -- and, the plaintext shredded as --seal-secrets tells the
        # operator to, refused fee_wallet_password_unset with an
        # instruction to put the password back in the EnvironmentFile. A
        # true sentence about the wrong thing, and one that undoes the seal
        # if it is followed.
        if _sp.is_file():
            _fv, _ = state_halves(key)
            _fh = _half_bytes(_hex)
            if _fv is None:
                raise Refused(
                    "secrets_unreadable",
                    f"this machine has sealed spend secrets at {_sp}, and "
                    f"its keyfile carries no half of the key they were "
                    f"sealed under -- so they are from another pairing, or "
                    f"the keyfile has been altered. Nothing is signed with "
                    f"secrets this machine cannot read, and it will not "
                    f"fall back to the environment.")
            if _fh is None:
                raise Refused(
                    "secrets_half_needed",
                    f"this machine's spend secrets are sealed to the pair "
                    f"({_sp}), and a fee sweep on a box nothing woke brings "
                    f"no half of the key. Print it on the Pi with "
                    f"`gs_doorbell state-key` -- or take the copy inside "
                    f"the LUKS USB -- and run this with `--unseal-state`, "
                    f"which asks for it.")
            try:
                open_secrets(_sp, _fv, _fh)
            except Refused as _oe:
                # A HALF TYPED AT THE KEYBOARD is likelier mistyped than
                # from another pairing, and the advice below it -- re-seal
                # -- needs the plaintext the operator was told to shred.
                if not _proven:
                    _oe.msg = ("the half passed to `--unseal-state` does not "
                               "open the sealed spend secrets. At the "
                               "keyboard the likeliest reason is a typo: "
                               "print it again with `gs_doorbell state-key` "
                               "on the Pi and compare. If it is right, "
                               "then: " + _oe.msg)
                raise
    except Refused as e:
        # THE OPERATOR IS STANDING HERE, and every refusal in this block is
        # about a half they typed or a file they can look at: a missing
        # half, a wrong one, a malformed keyfile half, a seal that will not
        # open. keyfile_half_needed already kept the box on; its siblings
        # powered it off under them. None of these moved anything.
        e.power = False
        raise
    artifact_dir = Path(key.get("artifact_dir") or ".").resolve()
    secure_mkdir(artifact_dir, narrow_existing=False)
    _AGENT_LOG[0] = artifact_dir / JOB_LOG
    preflight(key, artifact_dir, bool(getattr(args, "dry_run", False)),
              probes=d)
    if fee_sweep_config(key) is None:
        raise Refused("fee_sweep_not_configured",
                      "this keyfile names no fee wallet. Pair with --fee-rpc, "
                      "--fee-wallet-file and --fee-sweep-to to have one.",
                      power=False)
    return run_fee_sweep(key, artifact_dir, d,
                         bool(getattr(args, "dry_run", False)))


def _idle_boot_sweep(key: dict, artifact_dir: Path, d: dict,
                     secrets_path=SECRETS_FILE) -> bool:
    """A boot with no job is the fee sweep's moment, if the keyfile says so.

    Returns whether the keyfile asked for it. A misconfigured keyfile is said
    and logged, and counts as "no": the boot goes on to power off as it would
    have.

    CALLED FROM TWO PLACES, AND THE SECOND IS THE ONE THAT HAPPENS. This hook
    was hung on the doorbell's "no job for you" answer alone -- which needs a
    doorbell that answers. The doorbell listens only during a pager wake, so
    a HAND POWER-ON, the way the host actually boots this machine when no
    client has asked for anything, finds no doorbell at all and ends at
    doorbell_unreachable, one branch earlier. The sweep "on an idle boot" ran
    on a stranger's magic packet and never on the boot it was written for.
    Both boots have no job, the machine is on and preflight passed; both get
    the hook.
    """
    # A SEALED KEYFILE HAS NO FEE WALLET TO SEE FROM HERE (STAGE8_PLAN.md
    # section 4). This boot has no note, so it has no half, so the settings
    # are not readable -- and the sweep would otherwise report "this keyfile
    # names no fee wallet", a true sentence about the wrong thing. The
    # pairing refuses the two together, so reaching this means a keyfile
    # somebody edited: say which it is, once, rather than nothing.
    #
    # AND IT SAYS SO ONLY WHEN THERE IS SOMETHING TO SAY (the review of the
    # uncovered dimensions). This is reached by EVERY idle boot of a sealed
    # keyfile -- whether it has a fee wallet cannot be read from here, and
    # the pairing refuses --fee-sweep-on-idle-boot with a seal -- so the
    # warning and its chain line landed on every hand power-on of every such
    # box, fee wallet or none: a line nobody could act on, in the one log
    # read to find out what went wrong. Nothing here can have been asked
    # for; the hand command is where a sweep of a sealed box lives.
    if key.get(KEYFILE_SEALED) is not None:
        return False
    try:
        _fcfg = fee_sweep_config(key)
    except Refused as _fe:
        agent_say(f"  [!] {_fe.msg}")
        integrity_log("wake", "fee_sweep:misconfigured")
        return False
    if not (_fcfg and _fcfg["on_idle_boot"]):
        return False
    # ...AND THE SAME IS TRUE OF A SEALED FEE PASSWORD (STAGE9_PLAN.md).
    # The pairing refuses this flag for a sealed keyfile, but --seal-secrets
    # runs after pairing and a stage-7 keyfile's settings are readable, so
    # this boot can find the sweep asked for and its password out of reach.
    # It used to run anyway, fall through to the environment, and refuse
    # fee_wallet_password_unset -- telling the operator to put back in the
    # clear the password they had just sealed. Say which it is and stand
    # down; the hand command has the half.
    if Path(secrets_path).is_file():
        agent_say("  [!] This machine's spend secrets are sealed to the "
                  "pair and nothing woke this boot, so the fee wallet's "
                  "password cannot be read from here. Run `gs_wake_agent "
                  "--fee-sweep --unseal-state` at the machine "
                  "instead.")
        integrity_log("wake", "fee_sweep:secrets_sealed")
        return False
    run_fee_sweep(key, artifact_dir, d, False)
    return True


def _key_switch(key: dict, name: str, code: str) -> bool:
    """A keyfile switch, as a boolean: ABSENT is off (every keyfile from
    before the switch existed), True is on, and a value present and not a
    boolean is REFUSED `code`, never coerced. The spending gate read
    `if not key.get(...)`, so the string "false" -- what an operator
    hand-editing the keyfile to turn a switch OFF would write -- was a
    non-empty string, truthy, and turned it ON; 0 and "" read as off by the
    same accident. A switch that moves money is not a value to guess at.
    Rests on nothing secret: it only refuses to misread the file."""
    v = key.get(name, False)
    if not isinstance(v, bool):
        raise Refused(code, f"this machine's keyfile carries an {name} that "
                            f"is not a boolean; re-pair.")
    return v


def _btc_broadcast_on(key: dict) -> bool:
    """Does this keyfile let a forward SEND? Both switches, as booleans:
    `allow_btc_forward` (the forward may sign) and `allow_btc_broadcast`
    (it may hand the result to the network). Absent means no -- every
    keyfile from before the field existed is a rehearsal-only keyfile --
    and a value present and not a boolean is refused, never coerced
    (_key_switch: the forward's switch was coerced, the docstring said
    both were not)."""
    _bc = _key_switch(key, "allow_btc_broadcast", "btc_config_malformed")
    return _key_switch(key, "allow_btc_forward",
                       "btc_config_malformed") and _bc


def btc_mode(key: dict) -> bool:
    """Is this pair on the BTC intake (a unique host-owned deposit address
    per deposit, no note)? A property of the vault's keyfile: the account
    xpub paired with --btc-xpub. STAGE4_PLAN.md."""
    return bool(key.get("btc_account_xpub"))


def btc_deposit_min_sat(key: dict) -> int:
    """The smallest deposit this pair can FORWARD at its own fee ceiling,
    under every guard the forwarder applies: the dust floor after the fee
    AND the cap on the fee's share of the deposit
    (gs_btc_tx.forward_floor_sat). STAGE2_PLAN.md found the wire floor
    alone can never be forwarded (a deposit of exactly it is fee minus
    nothing); STAGE5_PLAN.md 3.3 found the first fix stopped at the first
    guard, and a deposit at that floor was refused by the second whenever
    fees were at the ceiling. The keyfile's ceiling and policy decide the
    number; both are validated, never coerced."""
    import gs_btc_tx as _btx
    op_max = _btc_setting(key, "op_return_max_bytes", 80, 1, 255)
    ceiling = _btc_setting(key, "feerate_ceiling_sat_vb", 200, 1, 100000)
    return int(_btx.forward_floor_sat(op_max, ceiling,
                                      int(proto.DEPOSIT_MIN_SAT)))


def _btc_address(key: dict, index: int) -> str:
    """The deposit address at `index` under this pair's account xpub, by
    the same public derivation the watch side uses."""
    import gs_btc_watch as _w
    return _w.derive_receive_address(str(key["btc_account_xpub"]), int(index),
                                     str(key.get("btc_network") or "main"))


def _btc_unused_live(key: dict, address: str) -> bool:
    """Ask the network, over Tor on the address's own circuit, whether this
    address has ever been used. Raises when nobody answered."""
    import gs_btc_broadcast as _b
    import gs_btc_watch as _w
    servers = [_w.parse_server(s) for s in (key.get("btc_electrum") or [])]
    return _b.unused(address, servers, key["tor_proxy"],
                     network=str(key.get("btc_network") or "main"))


def _check_btc_policy(key: dict) -> None:
    """The keyfile's OP_RETURN policy can carry the swap memo the forward
    writes -- checked BEFORE a deposit address is issued and before a
    forward is composed, never after a client's money is on the address.

    The memo grows with the deposit (its output limit is written in 1e8
    base units), so a policy under gs_common.SWAP_MEMO_MAX_BYTES forwards
    a drill's crumbs and refuses the first real deposit with memo_overflow
    -- for ever, since every retry quotes the same memo. A keyfile from
    before the pairing refused this (its default was the 80-byte standard,
    which no swap memo fits) is exactly the case. Present-and-wrong values
    are refused by _btc_setting as everywhere."""
    _op = _btc_setting(key, "op_return_max_bytes", 80, 1, 255)
    if _op < SWAP_MEMO_MAX_BYTES:
        integrity_log("wake", "op_return_too_small")
        raise Refused(
            "op_return_too_small",
            f"this machine's OP_RETURN policy ({_op} bytes) cannot carry "
            f"the swap memo a forward writes (at least "
            f"{SWAP_MEMO_MAX_BYTES}), so no deposit could be sent on. "
            f"Nothing was minted or spent. Re-pair with "
            f"--op-return-max-bytes {SWAP_MEMO_POLICY_BYTES} on a node "
            f"whose relay policy carries it.")


class _NoNativeBackend(Exception):
    """The constant-time libsecp256k1 is not the live backend (seal-time
    proof: nothing is derived from the seed without it)."""


def _prove_btc_seed(key: dict) -> None:
    """The seed in this machine's environment DERIVES the account xpub the
    Pi watches -- proven before a deposit address is issued, never after a
    client's money is on it.

    An xpub's version bytes do not say which purpose it was derived under:
    a BIP44 or BIP49 account key carries the same prefix, derives P2WPKH
    addresses here just as well, and the seed's m/84' account never
    matches it. Every check before this one ran on the xpub ALONE -- the
    pairing derives address 0 from it, the Pi watches under it, this file
    allocates indexes under it -- so a wrong-purpose xpub passed them all
    and the first client's payment settled on an address the forward
    refuses to sign for (btc_forwarder: seed_xpub_mismatch), to be
    recovered by hand with the right path. The forwarder's proof is the
    last line and stays; this is the FIRST, on the one machine that holds
    both halves, at the one moment before which nothing is published. The
    account key is derived and dropped; nothing is signed, logged or
    written. An absent seed refuses the deposit for the reason the forward
    refuses it (btc_seed_unset): an address for money this machine cannot
    sign for is not an address to hand a client."""
    import gs_btc_tx as _btx
    if not has_secret("GS_BTC_SEED"):
        integrity_log("wake", "btc_seed_unset")
        raise Refused(
            "btc_seed_unset",
            "the machine has no BTC seed configured, so no deposit address "
            "was issued: the forward could never sign for it. Nothing was "
            f"published. Set GS_BTC_SEED{_set_in()}, at the machine."
            + _reseal_hint("GS_BTC_SEED"))
    # THE CONSTANT-TIME BACKEND, BEFORE ANY ADDRESS: the forward refuses
    # to sign without the system libsecp256k1, so an address issued on a
    # machine without it holds the client's money until someone installs
    # the package -- and the proof below would derive from the seed on the
    # variable-time curve. Asked before the seed is touched.
    try:
        _btx.require_native()
    except _btx.BtcTxError:
        integrity_log("wake", "btc_backend_missing")
        raise Refused(
            "btc_backend_missing",
            "this machine has no constant-time libsecp256k1 (the "
            "libsecp256k1-1 package), so no deposit address was issued: the "
            "forward refuses to sign without it and could never send what "
            "landed there. Nothing was published. Install it at the machine.")
    account_no = _btc_setting(key, "btc_account", 0, 0, 2 ** 31 - 1)
    account = None
    try:
        try:
            account = _btx.account_from_mnemonic(
                secret_of("GS_BTC_SEED"),
                str(key.get("btc_network") or "main"),
                secret_of("GS_BTC_SEED_PASSPHRASE", ""),
                account=account_no)
        except _btx.BtcTxError:
            integrity_log("wake", "btc_seed_invalid")
            raise Refused(
                "btc_seed_invalid",
                f"the BTC seed in {_secret_home('GS_BTC_SEED')} is not a "
                "valid mnemonic, so no deposit address was issued: the "
                "forward could never sign for it. Nothing was published. Fix "
                "GS_BTC_SEED at the machine." + _reseal_hint("GS_BTC_SEED"))
        ok = _btx.account_matches_xpub(account, str(key["btc_account_xpub"]))
    finally:
        del account
    if not ok:
        integrity_log("wake", "btc_seed_xpub_mismatch")
        raise Refused(
            "btc_seed_xpub_mismatch",
            f"the BTC seed in {_secret_home('GS_BTC_SEED')} does not derive "
            f"the account xpub this pair watches (m/84'/coin'/{account_no}'), "
            "so no deposit address was issued: every deposit would settle "
            "on an address the forward refuses to sign for. Nothing was "
            "published. The xpub was exported under another purpose or "
            "account, or with another passphrase: re-pair with the wallet's "
            "native-segwit account xpub (gs_wake_keys prints its first "
            "address to compare), or fix the seed at the machine."
            + _reseal_hint("GS_BTC_SEED"))


def _issued_mark_path(key: dict):
    """Where the issued-index mark lives (load_key names it beside the
    keyfile), or None for a key that names none -- a hand-built one."""
    p = key.get("btc_issued_mark")
    return Path(str(p)) if isinstance(p, str) and p else None


def _xpub_id(key: dict) -> str:
    """Which CHAIN a mark is about: gs_btc_watch.chain_id -- keyed by the
    account's chain code, never the xpub itself (it derives every deposit
    address) and never a plain digest of an address (a paid address is
    public, and a digest of one is a lookup away: see chain_id). A mark
    left behind by a wipe names no address, no amount and no client, to
    anyone who cannot already derive them all. An xpub and a zpub of one
    account are one chain (self-doubt over the fix pass: a re-pair that
    pasted the other encoding read as a fresh chain and handed index 0 out
    again). An xpub that derives nothing (refused elsewhere) gets a digest
    of its text, so this never raises and a mark is still a mark."""
    xpub = str(key.get("btc_account_xpub") or "")
    try:
        import gs_btc_watch as _w
        return _w.chain_id(xpub, str(key.get("btc_network") or "main"))
    except Exception:                                        # noqa: BLE001
        return hashlib.sha256(("xpub:" + xpub).encode()).hexdigest()[:16]


def _legacy_xpub_id(key: dict) -> str:
    """The id a mark for this chain carried before it was keyed (a digest
    of address 0), read only to find and replace such a mark: a vault
    updated in place still knows what it handed out. Falls back as
    _xpub_id does, to the same text digest."""
    xpub = str(key.get("btc_account_xpub") or "")
    try:
        import gs_btc_watch as _w
        return _w.legacy_chain_id(xpub, str(key.get("btc_network") or "main"))
    except Exception:                                        # noqa: BLE001
        return hashlib.sha256(("xpub:" + xpub).encode()).hexdigest()[:16]


def _on_this_chain(rec: dict, key: dict) -> bool:
    """Whether an intake record's btc_index is an index of THIS pair's
    account chain. The record says which chain it was issued on
    (`btc_chain`, _xpub_id at the allocation); one from before the field
    is taken to be this chain's, which is all an older build knew.

    BOOKKEEPING, NOT A DEFENCE: the id tells two accounts of one seed
    apart for the operator's own ledger, and rests on nothing secret. A
    re-pair to another account (--btc-account one higher: the way out of
    ledger_wiped) made every record from the old account name an index of
    the NEW one. Its forward looked at an address nobody paid and said
    "not yet" for ever while the client's money sat on the old one, and
    the next deposit was numbered one past the old account's highest -- a
    hole at the start of the new chain, toward the recovery gap."""
    _c = rec.get("btc_chain") if isinstance(rec, dict) else None
    return _c is None or _c == _xpub_id(key)


#: The mark's times, and its directory's, are set back to this bucket after
#: each write -- the integrity chain's ten minutes (gs_common.integrity_log).
#: The exact second of the last write is the second a client was handed an
#: address. The CTIME cannot be moved by an unprivileged call and still
#: says it; that is the chain log's limit too, said rather than hidden.
ISSUED_MARK_BUCKET_S = 600


def _blur_mark_times(p: Path) -> None:
    """mtime and atime of the mark and its directory to the bucket. Never
    raises: the mark is written, and a clock it could not blur is no reason
    to refuse the deposit it records."""
    ts = int(time.time()) // ISSUED_MARK_BUCKET_S * ISSUED_MARK_BUCKET_S
    for _q in (p, p.parent):
        try:
            os.utime(_q, (ts, ts), follow_symlinks=False)
        except (OSError, NotImplementedError):
            pass


def _read_mark_text(q: Path) -> str:
    """The mark's text, read WITHOUT MOVING ITS ATIME where the kernel
    allows (O_NOATIME: the owner may): the times are set back to the
    bucket, and under relatime the first read after that set the atime to
    the second -- the second of the next deposit asked for, a refused one
    included. Raises what open raises (FileNotFoundError is "no mark")."""
    try:
        fd = os.open(str(q), os.O_RDONLY | getattr(os, "O_NOATIME", 0))
    except PermissionError:
        fd = os.open(str(q), os.O_RDONLY)
    with os.fdopen(fd, "r", encoding="utf-8") as f:
        return f.read()


def _legacy_mark_path(key: dict, p: Path):
    """Where a mark for this chain sat under its unkeyed id, when that is
    another file than `p` (a marks directory names the file by the id; a
    mark beside the keyfile has one name either way): or None."""
    _new, _old = _xpub_id(key), _legacy_xpub_id(key)
    if _old != _new and p.name == f"issued_{_new}.json":
        return p.with_name(f"issued_{_old}.json")
    return None


def _read_issued_mark(key: dict):
    """The mark's record for THIS chain -- {"account", "xpub_id",
    "issued"} -- or None when there is no mark, or the mark is another
    chain's (a re-pair on the next account starts fresh, as the wiped
    ledger's refusal tells the operator to). A mark that exists and cannot
    be read is not "no mark": that is the fail-open a wipe would hide
    behind, so it refuses."""
    p = _issued_mark_path(key)
    if p is None:
        return None
    # THE UNKEYED MARK TOO (the host-privacy pass keyed the id): a vault
    # updated in place has its mark under the old id, in the old file, and
    # read as "no mark" its wiped ledger would hand address 0 out again --
    # the one thing the mark is for. Either id is this chain's; where both
    # files exist the higher count stands (a mark is a floor). What was
    # found under the old id is written again under the new and the old
    # file erased, so the name a paid address hashes to does not outlive
    # the update.
    _ids = (_xpub_id(key), _legacy_xpub_id(key))
    _old = _legacy_mark_path(key, p)
    best, _from = None, None
    for _q in (p, _old):
        if _q is None:
            continue
        try:
            d = json.loads(_read_mark_text(_q))
        except FileNotFoundError:
            continue
        except Exception as e:                               # noqa: BLE001
            integrity_log("wake", "btc_issued_mark_unreadable")
            raise Refused("btc_issued_mark_unreadable",
                          f"the issued-index mark ({_q}) exists and cannot be "
                          f"read ({type(e).__name__}); it is what tells a "
                          "wiped ledger from a fresh one, so no address was "
                          "issued. Fix or remove it at the machine.") from e
        if not isinstance(d, dict) or d.get("xpub_id") not in _ids:
            continue
        # ...AND SAYS A COUNT (self-doubt over the fix pass): a mark whose
        # `issued` is not a whole number under the hardened bound escaped
        # as an uncaught ValueError -- a crash, the box powered off -- or
        # as btc_config_malformed, blaming an xpub that was fine.
        _n = d.get("issued")
        if isinstance(_n, bool) or not isinstance(_n, int) \
                or not 0 <= _n < 0x80000000:
            integrity_log("wake", "btc_issued_mark_unreadable")
            raise Refused("btc_issued_mark_unreadable",
                          f"the issued-index mark ({_q}) does not carry a "
                          "whole number of issued addresses; it is what tells "
                          "a wiped ledger from a fresh one, so no address was "
                          "issued. Fix or remove it at the machine.")
        if best is None or _n > best["issued"]:
            best, _from = d, _q
    if best is not None and (_from != p or best.get("xpub_id") != _ids[0]
                             or (_old is not None and _old.exists())):
        _migrate_issued_mark(key, p, _old, best["issued"])
    return best


def _migrate_issued_mark(key: dict, p: Path, old, issued: int) -> None:
    """The mark under the keyed id, the unkeyed one erased. NEVER raises:
    what was read stands either way, and the next issue writes it again."""
    from gs_common import integrity_log_once as _once
    try:
        atomic_write_json({"account": int(key.get("btc_account") or 0),
                           "xpub_id": _xpub_id(key), "issued": int(issued)},
                          p, perms=0o600)
        if old is not None and not secure_delete_or_warn(
                old, "the issued-index mark under its old, unkeyed name"):
            _once("wake", "btc_issued_mark_legacy_left")
        _blur_mark_times(p)
    except Exception:                                        # noqa: BLE001
        _once("wake", "btc_issued_mark_legacy_left")


def _mark_probe(key: dict) -> tuple:
    """(writable, what): whether the issued-index mark's place can be
    written by THIS process, proven by writing and removing a probe file
    beside it -- never the mark itself (a dry run issues nothing). NEVER
    raises; `what` is the directory or the error's class."""
    p = _issued_mark_path(key)
    if p is None:
        return False, "no mark named"
    try:
        probe = p.with_name(p.name + f".probe{os.getpid()}")
        secure_mkdir(p.parent, narrow_existing=False)
        atomic_write_json({"probe": True}, probe, perms=0o600)
        probe.unlink()
        return True, str(p.parent)
    except Exception as e:                                   # noqa: BLE001
        return False, f"{p}: {type(e).__name__}"


def _write_issued_mark(key: dict, issued: int) -> None:
    """Record that this chain has handed out `issued` addresses, BEFORE
    the address is handed out: a record that cannot be written refuses
    the deposit, since it is the one thing that stops a wiped ledger from
    handing the same address to two people."""
    p = _issued_mark_path(key)
    if p is None:
        return
    try:
        # THE DIRECTORY TOO, owner-only: the unit's StateDirectory= exists
        # at every start, a hand-run or a dev box's does not yet, and a
        # mark refused for a missing parent is the same refusal of every
        # deposit as a read-only one -- with the same fix a mkdir is.
        secure_mkdir(p.parent, narrow_existing=False)
        atomic_write_json({"account": int(key.get("btc_account") or 0),
                           "xpub_id": _xpub_id(key), "issued": int(issued)},
                          p, perms=0o600)
    except Exception as e:                                   # noqa: BLE001
        integrity_log("wake", "btc_issued_unrecorded")
        raise Refused("btc_issued_unrecorded",
                      f"could not record the issued deposit index beside the "
                      f"keyfile ({p}: {type(e).__name__}), so no address was "
                      "issued: that record is what stops a wiped ledger "
                      "handing one address to two people. Nothing was "
                      "published.") from e
    # Recorded; now what the record's NAME and TIMES say. A mark still
    # under the unkeyed id is erased (its count is folded into this one by
    # the read before every write), and the times go back to the bucket.
    _old = _legacy_mark_path(key, p)
    if _old is not None and (_old.exists() or _old.is_symlink()):
        if not secure_delete_or_warn(
                _old, "the issued-index mark under its old, unkeyed name"):
            from gs_common import integrity_log_once as _once
            _once("wake", "btc_issued_mark_legacy_left")
    _blur_mark_times(p)


def _allocate_btc_index(key: dict, handles: dict, unused=None,
                        prefer=None) -> int:
    """The next deposit index: one past the highest the ledger knows,
    stepping past any address the NETWORK says has been used, up to
    BTC_INDEX_GAP of them. The ledger's counter is never trusted alone --
    paranoia_mode wipes the ledger, and a wiped ledger restarting at 0 would
    hand a new client an address an earlier client paid. An address is
    issued only once a server has said it is fresh; "could not ask" refuses
    the deposit (fail closed) rather than guess. `unused` may be injected
    (a test); by default the live look.

    AND NEVER BELOW THE MARK (fix pass after the deep read): the network
    cannot tell an address that was ISSUED and not yet PAID from a fresh
    one, so the chain alone let a wiped ledger hand address 0 to a second
    client while the first's payment was still coming -- and, on a
    ledger that lost only its newest records, the same for every index
    between what it remembers and what was handed out. The mark beside
    the keyfile (_write_issued_mark, outside the wipe) is the floor: an
    empty ledger it contradicts is refused as wiped, a short one is
    stepped past it."""
    from gs_common import integrity_log_once as _once
    # THIS CHAIN'S INDICES ONLY (_on_this_chain): another account's say
    # nothing about which of this one's addresses were handed out.
    used = [r.get("btc_index") for r in handles.values()
            if isinstance(r, dict) and isinstance(r.get("btc_index"), int)
            and not isinstance(r.get("btc_index"), bool)
            and _on_this_chain(r, key)]
    # A NEVER-PUBLISHED INDEX HANDED BACK (`prefer`: a reused record's, see
    # _dispatch) is one the ledger knew: it counts as known here, so the
    # deposit after a failed one is not refused as a wiped ledger, and it
    # is reissued below once the network says it is still fresh.
    _pref = (prefer if isinstance(prefer, int) and not isinstance(prefer, bool)
             and prefer >= 0 else None)
    if _pref is not None:
        used = used + [_pref]
    nxt = (max(used) + 1) if used else 0
    _mark = _read_issued_mark(key)
    _marked = int(_mark.get("issued") or 0) if isinstance(_mark, dict) else 0
    if not used and _marked > 0:
        integrity_log("wake", "ledger_wiped")
        raise Refused("ledger_wiped",
                      "this machine's ledger knows no deposit, and the "
                      f"issued-index mark ({_issued_mark_path(key)}) says this "
                      f"chain has already handed out {_marked} address(es): "
                      "the ledger was wiped behind a chain in use, and an "
                      "address it handed out may be unpaid still, with its "
                      "payment on the way. Nothing was published. Re-pair "
                      "with --btc-account one higher and that account's "
                      "xpub: a fresh chain nobody was handed. (Remove the "
                      "mark instead ONLY if you know no address of this "
                      "chain is owed a payment -- for one, a machine that "
                      "died between issuing an address and recording it "
                      "never sent that address to anyone.)")
    if used and _marked > nxt:
        _once("wake", "btc_index_below_mark")
        nxt = _marked
    _live = unused or (lambda addr: _btc_unused_live(key, addr))

    def ask(addr):
        """Fresh or not -- and "could not ask" is a REFUSAL of the deposit,
        never a guess: an address that might have been used already is two
        people's money on one line."""
        # A STOP ENDS THE LOOKUPS (the review of the uncovered dimensions):
        # each is a Tor circuit's worth of waiting, up to BTC_INDEX_GAP of
        # them, and systemd's SIGKILL follows its SIGTERM by 20 seconds.
        # Nothing is published before an address is fresh, so stopping here
        # hands out nothing.
        _stop_if_asked()
        try:
            return _live(addr)
        except Exception:                                    # noqa: BLE001
            integrity_log("wake", "btc_lookup_failed")
            raise Refused("btc_lookup_failed",
                          "could not ask the network whether the next deposit "
                          "address is fresh, so no address was issued: one "
                          "that might have been used already is two people's "
                          "money on one line. Nothing was published.")
    if _pref is not None:
        # REISSUED, once the network says it is still fresh: the address
        # was issued (the mark counts it) and never published (its record
        # had no slip), so it is the right one for this deposit and leaves
        # no hole in the chain -- a wallet recovering by gap limit stops
        # at twenty unused addresses in a row, and a hole per failed
        # deposit was a way to get there. Used after all: the next index.
        try:
            _pa = _btc_address(key, _pref)
        except Exception as e:                               # noqa: BLE001
            raise Refused("btc_config_malformed",
                          "this machine's keyfile names an account xpub the "
                          f"watch side cannot derive from ({type(e).__name__}); "
                          "re-pair.")
        if ask(_pa):
            if _marked < _pref + 1:
                _write_issued_mark(key, _pref + 1)
            return _pref
    if not used:
        # THE LEDGER KNOWS NO INDEX: a fresh pair, or a WIPED ledger behind
        # a used chain (STAGE5_PLAN.md 3.6). The two are told apart by
        # address 0 alone: fresh, and this is index 0; used, and every
        # address the gap search could reach was handed to somebody whose
        # payment may still be coming -- a late payer and a new client on
        # one line is the one thing a fresh chain prevents. So a used
        # address 0 with an empty ledger is refused outright, with the way
        # out: the next account of the same seed. Intake records are
        # exempt from the ledger's pruning, so a quiet month cannot fake
        # this.
        try:
            addr0 = _btc_address(key, 0)
        except Exception as e:                               # noqa: BLE001
            raise Refused("btc_config_malformed",
                          "this machine's keyfile names an account xpub the "
                          f"watch side cannot derive from ({type(e).__name__}); "
                          "re-pair.")
        fresh0 = ask(addr0)
        if fresh0:
            _write_issued_mark(key, 1)
            return 0
        integrity_log("wake", "ledger_wiped")
        raise Refused("ledger_wiped",
                      "this machine's ledger knows no deposit and the "
                      "account's first address has already been used: the "
                      "ledger was wiped behind a used chain, or the account "
                      "was used before this pair. Every address this chain "
                      "could hand out may have been handed out already, to "
                      "someone whose payment could still arrive. Nothing was "
                      "published. Re-pair with --btc-account one higher and "
                      "that account's xpub: a fresh chain nobody was handed.")
    for step in range(int(proto.BTC_INDEX_GAP) + 1):
        idx = nxt + step
        try:
            addr = _btc_address(key, idx)
        except Exception as e:                               # noqa: BLE001
            raise Refused("btc_config_malformed",
                          "this machine's keyfile names an account xpub the "
                          f"watch side cannot derive from ({type(e).__name__}); "
                          "re-pair.")
        fresh = ask(addr)
        if fresh:
            if step:
                # ONCE per run, never a count: how many were skipped is the
                # number of deposits the ledger forgot.
                _once("wake", "btc_index_skipped")
            _write_issued_mark(key, idx + 1)
            return idx
    integrity_log("wake", "btc_index_exhausted")
    raise Refused("btc_index_exhausted",
                  f"the next {int(proto.BTC_INDEX_GAP) + 1} deposit addresses "
                  "have all been used and the ledger knows none of them: the "
                  "ledger and the chain disagree by more than a recovery gap. "
                  "Nothing was published. The intake stays closed until the "
                  "ledger is restored at the machine, or the pair is retired "
                  "to a fresh chain: re-pair with --btc-account one higher "
                  "and that account's xpub (re-pairing the same account does "
                  "not reopen it: same chain, same addresses).")


#: The forwarder's one-word status when it did not send -> the phase word.
#: "seen" is money on the address, none of it deep enough yet; "delayed" a
#: fee the forward would not pay today (the Pi tries again by itself);
#: "short" money that can never be sent on at any rate this pair allows
#: (under what was quoted) -- stage 5.
_FORWARD_STATUS_PHASE = {"not_seen": "not_yet", "seen": "arriving",
                         "delayed": "delayed", "short": "short",
                         "returned": "returned", "leftover": "leftover"}


def _forward_status_path(artifact_dir, handle: str) -> Path:
    return Path(artifact_dir) / f"btc_forward_{handle}.status.json"


def _forward_status_word(artifact_dir, handle: str, reader=None) -> str:
    """The phase a forward that FOUND NOTHING SETTLED earned, from the
    status file btc_forwarder writes on that refusal, or "". NEVER raises.
    A file carrying anything but the two words it may carry is ignored."""
    try:
        out = (reader or _read_json)(_forward_status_path(artifact_dir,
                                                          handle)) or {}
        if not isinstance(out, dict) or set(out) != {"state"}:
            return ""
        return _FORWARD_STATUS_PHASE.get(out.get("state"), "")
    except Exception:                                        # noqa: BLE001
        return ""


def _forward_outcome(artifact_dir, handle: str, reader=None) -> tuple:
    """(moved, outcome) from the plan btc_forwarder wrote for `handle`:
    moved is True only when the plan says broadcast and names an outcome
    after which money may have moved (accepted, ambiguous). NEVER raises:
    no plan, an unreadable one, a dry run -- all (False, None)."""
    try:
        plan = (reader or _read_json)(
            Path(artifact_dir) / f"btc_forward_{handle}.json") or {}
        outcome = plan.get("broadcast_outcome")
        moved = (plan.get("broadcast") is True
                 and outcome in ("accepted", "ambiguous"))
        if not moved and plan.get("superseded_by"):
            # A PLAN SUPERSEDED BY A FORWARD OF OURS moved its money, by
            # that forward: the reconciliation writes the mark only when
            # the network lists one of ours spending this plan's inputs.
            # Whatever this plan's own outcome became after (a re-send
            # that could reach no server, one every server rejected), it
            # read as never sent: no word when the record mined, and the
            # mark dropped forward_sent, so the next wake ran a plain
            # --broadcast instead of a reconciliation.
            return True, "accepted"
        return moved, (outcome if moved else None)
    except Exception:                                        # noqa: BLE001
        return False, None


def _pos_int(v) -> bool:
    return isinstance(v, int) and not isinstance(v, bool) and v > 0


def _forward_mined(artifact_dir, handle: str, reader=None) -> bool:
    """Whether the plan btc_forwarder wrote for `handle` says the forward
    that IS the record is IN A BLOCK (stage 6): its own transaction at
    `seen_height` above 0, or -- for a plan the reconciliation marked
    superseded by another forward of ours over the same outpoints (an
    original that mined after its replacement, an evicted original that
    came back) -- that forward at `superseded_height` above 0. This plan's
    own txid never mines in the second case, and reading its height alone
    kept the Pi asking after a forward whose money had long moved. A plan
    the reconciliation brought up to date carries the height it was listed
    at; a first send usually saw it in the mempool (0). NEVER raises: no
    plan, an unreadable one -- False."""
    try:
        plan = (reader or _read_json)(
            Path(artifact_dir) / f"btc_forward_{handle}.json") or {}
        if plan.get("seen") is True and _pos_int(plan.get("seen_height")):
            return True
        return (bool(plan.get("superseded_by"))
                and _pos_int(plan.get("superseded_height")))
    except Exception:                                        # noqa: BLE001
        return False


def _forward_superseded(artifact_dir, handle: str, reader=None) -> bool:
    """Whether the plan for `handle` was marked superseded by another
    forward of ours (the reconciliation found that one listed spending
    this one's inputs). NEVER raises."""
    try:
        plan = (reader or _read_json)(
            Path(artifact_dir) / f"btc_forward_{handle}.json") or {}
        return bool(plan.get("superseded_by"))
    except Exception:                                        # noqa: BLE001
        return False


def _forward_kept(artifact_dir, handle: str, reader=None) -> bool:
    """Whether the plan for `handle` says money that came back to the
    address is KEPT there (the reconciliation's --returns-max, third
    self-doubt pass: a route that keeps refunding is not paid for once
    more). NEVER raises."""
    try:
        plan = (reader or _read_json)(
            Path(artifact_dir) / f"btc_forward_{handle}.json") or {}
        return isinstance(plan.get("returned_kept"), dict)
    except Exception:                                        # noqa: BLE001
        return False


def _forward_chain(artifact_dir, handle: str) -> list:
    """The rotated predecessors of this handle's plan (a reconciliation's
    fresh forward moves the earlier plan aside as <stem>.<n>.json), newest
    first. NEVER raises; unreadable ones are skipped."""
    out = []
    try:
        stem = f"btc_forward_{handle}"
        for f in Path(artifact_dir).glob(f"{stem}.*.json"):
            mid = f.name[len(stem) + 1:-len(".json")]
            if not mid.isdigit():
                continue
            p = _read_json(f)
            if isinstance(p, dict):
                out.append((int(mid), p))
    except Exception:                                        # noqa: BLE001
        return []
    return [p for _n, p in sorted(out, reverse=True)]


def _reconcile_pairs(rec: dict, plan: dict, chain=()) -> bool:
    """THE XMR SIDE JUDGES THE REAL SWAP (STAGE5_PLAN.md 3.4). The watching
    jobs read `expected_xmr` and `btc_in` from the pairs file the
    DEPOSIT-time quote wrote, for the whole deposit at that day's rate; the
    swap that actually ran was quoted at forward time for the deposit
    minus the fee. A rate move over the watcher's tolerance read as
    "short" about a swap that delivered exactly what it quoted. So once a
    plan says the money moved and carries a quote, the pair routed to this
    deposit's destination is rewritten from it: what was sent, what was
    quoted -- the deposit-time figures kept beside them as
    `quoted_at_deposit`, written once. No transaction id: the slip names
    the deposit address and the XMR destination already, and a txid beside
    them was the deposit's whole public-chain link on one file (the
    host-privacy pass took it off).

    EVERY FORWARD OF THE DEPOSIT COUNTS. A returned deposit (a refund, a
    second payment) is forwarded again as a second swap to the SAME
    destination; rewriting from the newest plan alone would tell the
    watcher to expect only the second swap's output, so it would call the
    payment complete when that one landed and the first was still in
    flight. What is sent and what is quoted are summed over the plan and
    its rotated predecessors that moved money and were not superseded. A
    reconstructed plan carries the quote its signed record kept; one from a
    record without a quote contributes nothing itself, and the plan it
    superseded stands in for it.
    Returns whether the file was rewritten. Never raises."""
    try:
        path = rec.get("slip")
        # THE RECORDS: a forward of ours the reconciliation found listed
        # spending a plan's inputs, when it marked that plan superseded.
        # One counts even if its own (older) file says it was superseded in
        # turn -- a rotated plan is never rewritten, so its mark can be
        # stale -- and where two marks disagree the FRESHER NAMER wins: the
        # current plan's, then the newest rotated one's (the chain comes
        # newest first). ANY PLAN'S MARK NAMES ONE, not the current plan's
        # alone (the review of "every swap counts once"): a rejected
        # re-send, its fresh forward superseded by the original that mined
        # after all, then one more forward of money that came back -- the
        # superseded plan rotated aside with its mark, and the original,
        # whose own file says broadcast False, dropped out of the sum. The
        # watcher then called the deposit complete a whole swap early.
        _named = {}
        for _pos, _np in enumerate([plan] + list(chain or ())):
            if not isinstance(_np, dict):
                continue
            _r = str(_np.get("superseded_by") or "").lower()
            if _r and _r not in _named:
                _named[_r] = (_pos, _np)
        # A FORWARD THORCHAIN REFUNDED DOES NOT COUNT (third self-doubt
        # pass): its swap did not happen, and expecting its output kept
        # the watcher on "partial" for ever about a deposit whose
        # re-forward had fully landed. Only a VERIFIED refund lowers what
        # is expected -- one whose money came from ThorChain's own vault,
        # which nobody else can spend from (btc_forwarder.classify_returns).
        # A claim is a memo anyone can write into a transaction of their
        # own (Kerckhoffs: the convention is public); a forged one must not
        # be able to tell the client their swap is complete, so it changes
        # nothing here.
        # ...A FULL ONE DROPS THE FORWARD; A PARTIAL ONE SCALES IT (fix
        # pass after the deep read). A streaming swap that filled part of
        # the way refunds only the rest, and its forward's output is still
        # coming in part. Leaving such a forward in at its WHOLE quote --
        # beside the re-forward of the part that came back -- expected the
        # same satoshis twice: the pair then waited for more than could
        # ever land and told the client "short" for ever about a deposit
        # that delivered everything. So a verified partial refund takes
        # its share out: what was sent less what ThorChain did not swap,
        # and the quote scaled by that fraction. The same output recorded
        # on two plans (the current file and the rotated one it was merged
        # from) is counted once.
        # WHAT WAS NOT SWAPPED IS THE REFUND PLUS THE FEE IT LACKS (self-
        # doubt over that fix): ThorChain takes its outbound fee from the
        # unfilled part before refunding it, so the refund alone reads the
        # fill a fee's worth too HIGH -- a tenth of a 0.003 BTC forward,
        # the whole arrival tolerance, so every forward under ten fees
        # read `short` for ever, with the fill's real slippage on top. The
        # forwarder records the fee on the refund (`outbound_fee_sat`,
        # from THORNode's inbound entry when the forward was built); a
        # record without it counts the refund alone and says so on the
        # chain once a rewrite (refund_fee_unknown) -- a touch high, the
        # direction that reads `short`, never `complete`.
        # ...AND SEVERAL PARTS MAY MAKE A WHOLE: two outputs refunding one
        # forward that together reach the FULL test (gs_btc_tx
        # refund_is_full, the forwarder's own rule) are the whole swap
        # undone -- the forward drops out and, when it was the only one,
        # the deposit-time quote comes back -- where the sum used to be
        # capped at what was sent and the forward left in at nothing: a
        # target of zero, which the watcher refuses to wait for at all.
        import gs_btc_tx as _btx
        _rf_seen, _refunded, _back, _said = set(), set(), {}, set()
        _sent_of = {str(p.get("txid") or "").lower(): int(p.get("send_sat")
                                                          or 0)
                    for p in [plan] + list(chain or ())
                    if isinstance(p, dict) and p.get("txid")}
        for p in [plan] + list(chain or ()):
            if not isinstance(p, dict):
                continue
            for r in (p.get("refunds") or []):
                if not (isinstance(r, dict) and r.get("verified") is True
                        and r.get("of")):
                    continue
                _of = str(r.get("of") or "").lower()
                try:
                    _vo = int(r.get("vout"))
                except (TypeError, ValueError):
                    _vo = None
                _op = (str(r.get("txid") or "").lower(), _vo, _of)
                if _op in _rf_seen:
                    continue
                _rf_seen.add(_op)
                if r.get("full") is True:
                    _refunded.add(_of)
                    continue
                try:
                    _v = int(r.get("value") or 0)
                except (TypeError, ValueError):
                    _v = 0
                if _v <= 0:
                    # A verified partial refund whose amount cannot be read
                    # takes nothing out: the whole quote stands (the state
                    # this fix exists to end), so the operator hears of it.
                    if "refund_value_unreadable" not in _said:
                        _said.add("refund_value_unreadable")
                        integrity_log("wake", "refund_value_unreadable")
                    continue
                _f = r.get("outbound_fee_sat")
                if isinstance(_f, int) and not isinstance(_f, bool) \
                        and _f >= 0:
                    _v += _f
                elif "refund_fee_unknown" not in _said:
                    _said.add("refund_fee_unknown")
                    integrity_log("wake", "refund_fee_unknown")
                _back[_of] = _back.get(_of, 0) + _v
        for _of, _b in list(_back.items()):
            if _btx.refund_is_full(_b, _sent_of.get(_of, 0)):
                _refunded.add(_of)
                del _back[_of]

        def _share(p):
            """(send_sat, expected_xmr) of forward `p` LESS the verified
            part that came back: the quote scaled by what ThorChain kept."""
            _s = int(p.get("send_sat") or 0)
            _e = Decimal(str(p["expected_xmr"]))
            _b = min(int(_back.get(str(p.get("_refund_of") or p.get("txid")
                                       or "").lower(), 0)), _s)
            if _b <= 0 or _s <= 0:
                return _s, _e
            _e2 = (_e * Decimal(_s - _b) / Decimal(_s)).quantize(
                Decimal("0.000000000001"), rounding="ROUND_DOWN")
            return _s - _b, _e2

        def _is_record(p):
            return str(p.get("txid") or "").lower() in _named

        def _counts(p):
            # THE RECORD COUNTS WHATEVER ITS OWN FILE SAYS OF ITS SEND: the
            # network lists it, so it moved. A re-send every server rejected
            # rewrote its plan `broadcast False`; when that one mined after
            # all (the fresh forward beside it then superseded by it), it
            # failed this test and the fresh forward was superseded -- the
            # swap counted zero times.
            return (isinstance(p, dict)
                    and ((p.get("broadcast") is True
                          and p.get("broadcast_outcome") in ("accepted",
                                                             "ambiguous"))
                         or _is_record(p))
                    and (not p.get("superseded_by") or _is_record(p))
                    and p.get("expected_xmr") not in (None, "")
                    and p.get("dest_xmr") == plan.get("dest_xmr")
                    and str(p.get("txid") or "").lower() not in _refunded)
        counted = [p for p in [plan] + list(chain or ()) if _counts(p)]
        # ...AND A RECORD WITH NO QUOTE HAS A STAND-IN: the plan it
        # superseded, whose quote was for the same money (the record spent
        # its inputs). A forward sent and killed before its plan, rebuilt
        # from the chain by a build whose signed record kept no quote, is
        # quote-less; the plan it superseded was dropped for being
        # superseded; and the swap counted neither way -- the watcher said
        # "complete" a swap early. Not when the record was refunded in full:
        # then that swap did not happen, and neither counts.
        # ...THE PLAN THAT NAMED IT, whether it is current or rotated aside
        # since (the same review: the stand-in went with the next forward).
        # A rotated namer stands in only for a record the chain HOLDS
        # without a quote: marks are made only for forwards of ours, each
        # filed as a plan, so a rotated mark naming one the chain does not
        # hold is not a swap this can vouch for. The current plan's may
        # name one whose plan could not be written this run.
        _held = {str(p.get("txid") or "").lower()
                 for p in [plan] + list(chain or ()) if isinstance(p, dict)}
        for _r, (_pos, _stand) in _named.items():
            if (_pos != 0 and _r not in _held) \
                    or any(str(p.get("txid") or "").lower() == _r
                           for p in counted) \
                    or _r in _refunded \
                    or any(str(p.get("txid") or "").lower() == _r
                           and p.get("expected_xmr") not in (None, "")
                           for p in [plan] + list(chain or ())
                           if isinstance(p, dict)) \
                    or _stand.get("expected_xmr") in (None, "") \
                    or _stand.get("dest_xmr") != plan.get("dest_xmr") \
                    or any(p is _stand for p in counted):
                continue
            # ...WHAT CAME BACK OF THE RECORD COMES OUT OF IT (the review of
            # 657deae): a refund names the forward the network listed --
            # the record -- so _share looked the stand-in up under its own
            # txid, found nothing come back, and counted the whole quote
            # for a record ThorChain had refunded half of: the watcher
            # waited for more than could land and said `short` for ever.
            # ONLY the refund is read under the record's txid (`_refund_of`,
            # never written anywhere): renamed to it outright, the stand-in
            # ranked as the record over a live re-sign of the same money,
            # and a namer that `replaces` the record dropped itself as
            # replaced -- a swap counted neither way (the review of that).
            counted.append(dict(_stand, _refund_of=_r))
        # A REPLACED PLAN AND ITS REPLACEMENT ARE ONE SWAP (stage 6). A
        # bump spends the same outpoints again at today's rate, and the
        # new plan names the old in `replaces`; counting both would tell
        # the XMR watcher to expect two arrivals of one payment. The
        # replacement counts and the original does not -- unless the
        # network mined the original after all, in which case the
        # reconciliation has marked the replacement superseded (so it is
        # not in `counted`) and the original counts. Never both, never
        # neither.
        _replaced = {str(p.get("replaces") or "").lower()
                     for p in counted if p.get("replaces")}
        counted = [p for p in counted
                   if str(p.get("txid") or "").lower() not in _replaced]
        # ...AND, MORE GENERALLY, ONE SWAP PER OUTPOINT (stage 6, self-doubt
        # pass). An evicted forward's re-sign and a rejected re-send's
        # fresh forward name nothing in `replaces` -- they were built
        # because the original was NOT in the network -- yet the original's
        # file still says it was sent and seen once, and it was summed
        # beside the plan that actually carries the money. Two plans that
        # spend a common outpoint are one payment: the record counts if
        # the reconciliation named one, else the newest, and the other is
        # dropped. Plans over different outpoints (a returned deposit's
        # second swap) are two payments and still sum.

        def _rank(p):
            _ts = p.get("ts")
            _t = str(p.get("txid") or "").lower()
            return (_t in _named,
                    -_named[_t][0] if _t in _named else 0,
                    float(_ts) if isinstance(_ts, (int, float))
                    and not isinstance(_ts, bool) else 0.0)
        kept, spent = [], set()
        for p in sorted(counted, key=_rank, reverse=True):
            ops = {(str(i.get("tx_hash") or "").lower(), int(i.get("vout") or 0))
                   for i in (p.get("inputs") or []) if isinstance(i, dict)}
            if ops & spent:
                continue
            kept.append(p)
            spent |= ops
        counted = [p for p in counted if any(p is k for k in kept)]
        if not path or not plan.get("dest_xmr"):
            return False
        # EVERY FORWARD REFUNDED IN FULL: nothing moved, and the pair must
        # say so -- not keep the forward-time figures an earlier rewrite
        # put there for a swap that then never happened. The DEPOSIT-time
        # quote is put back (the watcher waits for it, and says "not yet",
        # rather than for less than the client is owed), and the record
        # names no forward.
        _all_refunded = bool(_refunded) and not counted
        if not counted and not _all_refunded:
            return False
        pairs = _read_json(Path(path))
        if not isinstance(pairs, list):
            return False
        from gs_common import fmt_btc as _fmt
        _sent = sum(_share(p)[0] for p in counted)
        _exp = sum((_share(p)[1] for p in counted), Decimal(0))
        changed = False
        for pair in pairs:
            if not isinstance(pair, dict) \
                    or pair.get("dest_xmr") != plan.get("dest_xmr"):
                continue
            pair.setdefault("quoted_at_deposit",
                            {"btc_in": pair.get("btc_in"),
                             "expected_xmr": pair.get("expected_xmr")})
            if _all_refunded:
                _q = pair.get("quoted_at_deposit") or {}
                if not isinstance(_q, dict):
                    _q = {}
                pair["btc_in"] = _q.get("btc_in", pair.get("btc_in"))
                pair["expected_xmr"] = _q.get("expected_xmr",
                                              pair.get("expected_xmr"))
            else:
                pair["btc_in"] = _fmt(Decimal(_sent) / Decimal(10 ** 8))
                pair["expected_xmr"] = str(_exp)
            # NO TRANSACTION ID ON THE SLIP (the host-privacy pass). The
            # rewrite named the forwards' txids here "for the operator's
            # reading"; nothing read them, and a txid beside the deposit
            # address and the XMR destination made the slip the complete
            # public-chain link of the deposit, on a file that lives until
            # the pay-out. The watcher needs the figures alone. A slip from
            # before is stripped the next time it is rewritten.
            pair.pop("forwarded_txids", None)
            pair.pop("forwarded_txid", None)
            changed = True
        if changed:
            atomic_write_json(pairs, Path(path), perms=0o600)
            integrity_log("wake", "pairs_reconciled")
        return changed
    except Exception:                                        # noqa: BLE001
        integrity_log("wake", "pairs_unreconciled")
        return False


def _btc_setting(key: dict, name: str, default: int, lo: int, hi: int) -> int:
    """A whole-number BTC-intake setting from the keyfile: the default only
    when the field is ABSENT (a keyfile from before it existed), refused
    when present and not a whole number in [lo, hi]. Never coerced."""
    v = key.get(name)
    if v is None or v == "":
        return default
    if isinstance(v, bool) or not isinstance(v, int) or not lo <= v <= hi:
        raise Refused("btc_config_malformed",
                      f"this machine's keyfile carries a {name} that is not "
                      f"a whole number in {lo}..{hi}; re-pair rather than "
                      "let a guessed value decide a forward.")
    return v


def build_argv(job: str, params: dict, key: dict, artifact_dir: Path,
               bundle: str = None, slip: str = None, handle: str = None,
               owned_fee=(), btc_index=None, reconcile: bool = False) -> list:
    """The argv lists for one job, in order, composed ENTIRELY from the fixed
    template plus this machine's own keyfile. (The per-step environment is
    built by _dispatch beside each step; only build_fee_sweep_argv returns
    an (argv, env) pair.)

    The only things that come from the note are: an int already range-checked
    against a closed schema, and a handle already matched against
    ^[0-9A-F]{4}$. Neither is ever a flag name, a path, a URL or a proxy.
    """
    proxy = key["tor_proxy"]
    rpc = key["rpc_primary"]
    if job == "receive_and_quote":
        # RE-CHECKED HERE, and the bounds come from the protocol rather than
        # from a literal typed in this file. The predecessor of this branch
        # read a ladder slot and checked `slot >= len(ladder)` -- one end only
        # -- so a NEGATIVE slot indexed from the far end (ladder[-1] is the
        # largest rung) and the refusal never fired. What actually stopped it
        # was _int_range two files away, which is a real check and is also
        # somebody else's. The lesson survives the ladder's removal: this is
        # the box that acts on the number, so it bounds the number, and it
        # bounds BOTH ends by asking the schema rather than by restating it.
        _amt = params["amount_sat"]
        try:
            proto.JOBS["receive_and_quote"]["schema"]["amount_sat"](_amt)
        except Exception as e:                               # noqa: BLE001
            raise Refused("bad_amount",
                          f"the note's deposit amount is not one this "
                          f"machine will quote: {e}")
        # ON THE BTC INTAKE, THE FLOOR IS WHAT CAN BE FORWARDED, not the
        # wire's typo guard: the forward pays a network fee out of the
        # deposit and must still reach ThorChain's own minimum. Refused
        # HERE, before a mint, a look or a quote spends anything.
        if btc_mode(key):
            _floor = btc_deposit_min_sat(key)
            if int(_amt) < _floor:
                raise Refused("deposit_too_small",
                              f"a deposit under {_floor} satoshi could not be "
                              "forwarded after its own network fee at this "
                              "machine's ceiling rate; nothing was minted.")
        return [
            [sys.executable, _tool("create_receive_wallet"),
             "--tor-proxy", proxy, "--rpc", rpc,
             "--count", "1", "--output-dir", str(artifact_dir)],
            # The amount rides in the ENVIRONMENT. /proc/<pid>/cmdline is 0444
            # and gs_common.env_or_argv's docstring records what argv already
            # cost this repo three times.
            [sys.executable, _tool("thor_swap_preparer"),
             "--tor-proxy", proxy,
             "--dest-from-receive-wallet", str(bundle),
             # A QUOTE TOO SMALL TO MIX IS REFUSED BEFORE ANY DEPOSIT
             # INSTRUCTION IS ISSUED. Without this the payment settled
             # through ThorChain and only THEN met the mixing minimum -- at
             # /withdraw, with the money already sitting on an address the
             # swap memo names in a public OP_RETURN, and nothing the phone
             # could do about it. gs_wake_proto.MIX_MINIMUM_XMR_MIRROR has
             # the sequence in full.
             #
             # ONE FLOOR, AND IT IS NOT THE ONE A FEE WOULD NEED. This first
             # passed the with-cut figure when the keyfile named a fee
             # destination, which refused quotes that would have mixed
             # perfectly well: plan_usage_fee waives a cut too small to spend
             # and the mix goes ahead in full.
             "--min-out-xmr", live_min_out_xmr(key),
             "--outfile", str(artifact_dir / f"thor_pairs_{handle}.json")],
        ]
    if job == "watch":
        return [[sys.executable, _tool("receive_watch"),
                 "--tor-proxy", proxy, "--rpc", rpc,
                 "--receive-wallet", str(bundle),
                 "--pairs", str(slip),
                 # Inside the 7200 s budget, and the same number OPSEC_SETUP.md
                 # §5 step 7 states. --choice is omitted deliberately: with
                 # stdin closed the prompt cannot fire, and omitting the flag
                 # is the only value under which the tool cannot print a mix
                 # command.
                 "--timeout-min", "110",
                 # AND IT REPORTS WHAT IT SAW, for the same reason swap_status
                 # does. Without this, receive_watch exits non-zero when the
                 # 110 minutes run out and the pager says "watch: failed." --
                 # about money that is simply still in flight. That is the
                 # exact sentence swap_status was built to stop saying, on the
                 # command an operator uses when they are least able to check
                 # anything themselves.
                 #
                 # The path is composed from the keyfile's artifact_dir and a
                 # fixed name, like the swap_status one: no operator input
                 # reaches it. Both jobs writing one file is safe because the
                 # pager runs one wake at a time and reads the file
                 # immediately.
                 #
                 # --stall-min is left at its default (30), which is inside
                 # this 110-minute window; passing 110 would make the shortfall
                 # check unable to fire at all and receive_watch warns about
                 # exactly that.
                 "--result-json", str(artifact_dir / STATUS_FILE)]]
    if job == "swap_status":
        # LOOK, DO NOT WAIT. Three minutes inside a 300 s budget: enough for
        # the wallet to answer, and the vault is off again before the wake is
        # worth noticing. --result-json is what makes the answer more than a
        # boolean; without it every outcome but "funded" reaches the operator
        # as "the vault FAILED".
        return [[sys.executable, _tool("receive_watch"),
                 "--tor-proxy", proxy, "--rpc", rpc,
                 "--receive-wallet", str(bundle),
                 "--pairs", str(slip),
                 "--timeout-min", "3",
                 # NO --stall-min, AND THE ABSENCE IS THE FIX. This passed
                 # --stall-min 3 to match the timeout, so the tool would
                 # not warn -- and receive_watch checks the balance stall
                 # BEFORE the timeout on the same tick. A partial arrival
                 # that had fully unlocked (the first of two transactions,
                 # a refund leg still to come) therefore came back "stalled"
                 # from three minutes of looking: "it has stopped growing.
                 # Check before going further", with the full menu under
                 # it, one tap from a withdrawal that strands the second
                 # leg on a burned address. The tool's own liveness check
                 # says in as many words that a three-minute probe is too
                 # short to reach a verdict and should time out; the
                 # default stall window (30 min) is longer than the probe,
                 # so that branch cannot fire, the tool prints its warning
                 # into the job log, and _phase_of reads what was SEEN.
                 "--result-json", str(artifact_dir / STATUS_FILE)]]
    if job == "withdraw":
        # THE ADDRESS IS NOT HERE, and that is the whole point of this branch.
        #
        # It is the first operator-chosen string this channel carries, it
        # crosses a machine boundary, and it is handed to a subprocess -- so it
        # goes in GS_EXIT_TO, set by the runner below, exactly like
        # GS_SWAP_AMOUNTS. /proc/<pid>/cmdline is 0444 and every local account
        # on this box could read an argv for the whole run; more importantly,
        # a value that never reaches an argv cannot become a flag however it
        # is shaped.
        #
        # --receive-wallet, so the mix spends the bundle this handle names and
        # nothing else on the wallet. --dag-mixing because a withdrawal the
        # operator cannot supervise should take the stronger of the two shapes
        # rather than the faster one; the budget is sized for it.
        # --wallet-file IS NOT OPTIONAL HERE, and leaving it out is what made
        # the first version of this job unable to complete at all.
        #
        # GhostSpiral's Round 1 runs `airgap_tx_signer --phase sign
        # --wallet-file <path>` with the password in the environment. Both
        # arguments have DEFAULTS -- "offline.wallet" and "" -- so composing
        # neither does not fail loudly: the mix plans, veils, relays a fan-out,
        # waits out its confirmations, and dies hours later at "phase 'sign'
        # produced no signed TX files". Every earlier stage succeeded, so the
        # money has already moved on-chain when it stops.
        #
        # The path comes from THIS MACHINE'S keyfile, like every other path
        # here. It is not a job parameter and must never become one: a wake
        # note that could name a wallet file could name any file on the vault.
        _wf = key.get("wallet_file")
        if not _wf:
            raise Refused(
                "no_wallet_file",
                "this machine's keyfile does not say which wallet to sign "
                "with, so the mix would relay a fan-out and then fail at the "
                "signing step with the money already moved. Re-pair with "
                "--wallet-file.")
        return [[sys.executable, _tool("GhostSpiral"),
                 "--tor-proxy", proxy, "--rpc-primary", rpc,
                 # THE DAEMON, FROM THIS MACHINE'S KEYFILE.
                 #
                 # GhostSpiral reads the network fee from --rpc-daemon and
                 # REFUSES the run rather than guessing when it cannot: the
                 # fallback measured 38-58x below the real fee, so every hop
                 # under-reserved and the run died on a later hop with "not
                 # enough money" after the fan-out had already gone on chain.
                 #
                 # So a vault whose monerod is not on GhostSpiral's default
                 # port failed EVERY woken withdrawal at stage 0, and the chat
                 # said "withdraw: refused." with nothing the operator could
                 # change -- gs_console has this as a settable field and the
                 # wake path did not. It fails safe, before anything is spent,
                 # which is why this is a configuration gap and not the
                 # money-losing kind.
                 #
                 # .get() with GhostSpiral's own default, so a keyfile written
                 # before gs_wake_keys grew --rpc-daemon behaves exactly as it
                 # did and no re-pairing is needed.
                 "--rpc-daemon", str(key.get("rpc_daemon")
                                     or "http://127.0.0.1:18081"),
                 "--receive-wallet", str(bundle),
                 "--wallet-file", str(_wf),
                 "--dag-mixing",
                 # FROM THE OPERATOR'S CHOSEN DEPTH, via a closed table --
                 # never GhostSpiral's own default, and never a raw number off
                 # the note. Leaving it to the default made the job's runtime
                 # a property of a default in another file: at --wallets 20
                 # the same run takes 13.1 h and at 40 it takes far longer,
                 # and nothing here would have noticed either. Depth and
                 # budget are one setting: gs_wake_proto sizes budget_s from
                 # the deepest row of this same table, and
                 # tests/test_wake_agent.py recomputes both from GhostSpiral's
                 # arithmetic so they cannot drift apart.
                 "--wallets", str(withdraw_wallets(params["depth"])),
                 "--output", str(artifact_dir)]
                + _withdraw_fee_argv(key, params.get("exit_to") or [],
                                     owned=owned_fee)]

    if job == "forward_to_swap":
        # EVERYTHING FROM THIS MACHINE'S KEYFILE, plus the ledger's two facts
        # about the handle: the bundle (the XMR destination) and the BTC
        # index (the address). The seed is NOT here: it rides in the
        # environment of this one step, set by _dispatch, exactly as the
        # wallet password does for a withdrawal.
        _xpub = str(key.get("btc_account_xpub") or "")
        _servers = [str(s) for s in (key.get("btc_electrum") or []) if s]
        if not _xpub or not _servers:
            raise Refused(
                "no_btc_config",
                "this machine's keyfile names no BTC account xpub or no "
                "Electrum server, so it cannot forward a deposit. Re-pair "
                "with --btc-xpub and --btc-electrum.")
        if btc_index is None or isinstance(btc_index, bool) \
                or not isinstance(btc_index, int) or btc_index < 0:
            raise Refused("no_btc_deposit",
                          "this handle has no BTC deposit address recorded, "
                          "so there is nothing to forward.")
        # VALIDATED, NEVER COERCED. `int(key.get(...) or 2)` turned a paired
        # 0 into 2 confirmations the operator never chose; a keyfile value
        # that is present and wrong is refused, and only an ABSENT one takes
        # the default (a keyfile written before the field existed).
        _min_conf = _btc_setting(key, "btc_min_conf", 2, 1, 1008)
        # A POLICY NO SWAP MEMO FITS is refused before the child, which
        # would refuse memo_overflow after a look, a quote and a wake.
        _check_btc_policy(key)
        _op_max = _btc_setting(key, "op_return_max_bytes", 80, 1, 255)
        _floor = _btc_setting(key, "feerate_floor_sat_vb", 1, 1, 100000)
        _ceiling = _btc_setting(key, "feerate_ceiling_sat_vb", 200, 1, 100000)
        if _floor > _ceiling:
            raise Refused("btc_config_malformed",
                          "this machine's keyfile puts the fee-rate floor "
                          "above the ceiling; re-pair.")
        _aff = _btc_setting(key, "max_affiliate_bps", 0, 0, 1000)
        # HOW FAR A QUOTE MAY SIT FROM THE PRICE REFERENCES (the stage 2
        # read), in basis points: the keyfile's word, absent means the
        # forwarder's own 25% it always was. PUBLIC, like every limit
        # here: a hostile quote can sit just under it, so it bounds the
        # loss to the aggregator's word and does not prevent it.
        _slip = _btc_setting(key, "btc_max_slippage_bps", 2500, 100, 5000)
        # HOW LONG A FORWARD MAY SIT IN THE MEMPOOL under today's rate
        # before a reconciliation replaces it (stage 6): the keyfile's
        # word, absent means the two hours it was before the field.
        _bump = _btc_setting(key, "btc_bump_after_s", 7200, 0, 7 * 86400)
        # HOW MANY FORWARDS OF RETURNED MONEY a deposit's record may hold
        # before the reconciliation keeps the next return for the operator
        # (third self-doubt pass): the keyfile's word, absent means two.
        _returns = _btc_setting(key, "btc_returns_max", 2, 0, 1000)
        _net = str(key.get("btc_network") or "main")
        if _net not in ("main", "testnet", "signet", "regtest"):
            raise Refused("btc_config_malformed",
                          "this machine's keyfile names a Bitcoin network "
                          "this tool does not know; re-pair.")
        # MONEY DOES NOT MOVE ON THE AGGREGATOR'S WORD ALONE (STAGE5_PLAN.md
        # 3.5): a run that may send -- a broadcast, or a reconciliation --
        # needs the THORNode cross-check, and the forwarder refuses to run
        # without it. Refused HERE, before a wake is spent on a child that
        # will refuse, with the re-pair named; a keyfile written before
        # pairing required it is exactly the case.
        if (reconcile or _btc_broadcast_on(key)) \
                and not key.get("thornode_url"):
            raise Refused("no_thornode",
                          "this pair sends but names no THORNode to check "
                          "the inbound address against; re-pair with "
                          "--thornode (money does not move on the "
                          "aggregator's word alone).")
        # THE XPUB AND THE INDEX ARE NOT HERE. The xpub is the public
        # generator of every deposit address this host has ever minted --
        # holding it links all of them to each other and to this box -- and
        # /proc/<pid>/cmdline is 0444 for the whole 900 s of Tor round trips.
        # Both ride in the environment of this one step, set by _dispatch,
        # like the seed and like GS_SWAP_AMOUNTS.
        argv = [sys.executable, _tool("btc_forwarder"),
                # THE MODE IS THE KEYFILE'S SECOND SWITCH. A rehearsal --
                # signed, printed, never sent -- unless the operator paired
                # --allow-btc-broadcast as well; then the forward SENDS.
                # A forward that already went out is RECONCILED instead
                # (stage 5): what became of it decides what the run does,
                # and _dispatch has checked this pair may still send.
                "--reconcile" if reconcile else
                ("--broadcast" if _btc_broadcast_on(key) else "--dry-run"),
                "--tor-proxy", proxy,
                "--network", _net,
                "--dest-from-receive-wallet", str(bundle),
                "--min-conf", str(_min_conf),
                "--op-return-max-bytes", str(_op_max),
                "--feerate-floor", str(_floor),
                "--feerate-ceiling", str(_ceiling),
                "--max-affiliate-bps", str(_aff),
                "--max-slippage", str(Decimal(_slip) / Decimal(10000)),
                "--bump-after", str(_bump),
                "--returns-max", str(_returns),
                # THE SAME MIX FLOOR the quote step is given, so a deposit
                # that could not be mixed is not forwarded into the swap.
                "--min-out-xmr", str(live_min_out_xmr(key)),
                "--outfile", str(artifact_dir / f"btc_forward_{handle}.json")]
        for _s in _servers:
            argv += ["--electrum", _s]
        if key.get("thornode_url"):
            argv += ["--thornode", str(key["thornode_url"])]
        return [argv]

    raise Refused("unknown_job", "no argv template for this job")


def fee_addresses(key: dict, exclude=()) -> list:
    """Every destination this machine's keyfile allows the cut to be paid to.

    `exclude` IS THE OPERATOR'S OWN WITHDRAWAL DESTINATIONS, and it exists
    because GhostSpiral refuses the whole run when they overlap:
    resolve_usage_fee sys.exits with "--usage-fee-address is also an --exit-to
    destination ... Then it is not a fee: it lands in the same place as the
    mixed funds". That refusal is right, it happens at PARSE time before stage
    0, and it names command-line flags a phone operator never typed -- onto a
    stdout the unit diverts to a 0600 log on a machine that then powers off.
    What reaches the chat is "withdraw: failed", with a hint about mixing depth
    that is wrong and a warning that some of it may already have moved, which
    is false: nothing ran.

    A SINGLE-TENANT BOT MAKES THE OVERLAP THE NATURAL SETUP. The operator IS
    the user, so paying the cut to an address they also withdraw to is an
    ordinary thing to pair. And the address LIST made it intermittent rather
    than constant: with N paired, roughly one withdrawal in N drew the
    colliding one and died while the rest worked -- the hardest possible shape
    to reason about from a phone.

    So the collision is resolved here, where both halves are known, by not
    offering that address for this run. If every paired address is a
    destination the answer is none of them, and the cut is WAIVED rather than
    the run refused: the money lands in the operator's own hands either way,
    which is exactly what GhostSpiral's refusal says. plan_usage_fee already
    waives rather than aborts when the cut is not worth moving, for the same
    reason -- a mix that ran is worth more than a fee that did not.

    THE LIST IS THE POINT, and the singular field is the compatibility half.
    One address collecting a slice of every run is address reuse that survives
    the mix: the rate is published in this repository's source, so an analyst
    who finds that address divides an arrival by 0.011 and reads back the
    deposit behind it -- and with one address, reads back every deposit the
    operator ever took.

    With several, each run picks one at random and each address collects
    roughly 1/N of the income. That is a REDUCTION and is not unlinkability;
    gs_wake_keys' help says so in those words rather than implying more.

    Nothing is remembered between runs, deliberately. An index would be
    durable state on the one machine paranoia_mode wipes -- it would reset to
    the first address after every sweep, which is the worst possible reuse
    pattern -- and two withdrawals racing it would both read the same number.
    A uniform draw has no state to corrupt, survives the wipe, and cannot be
    raced.
    """
    _skip = {str(a).strip() for a in (exclude or []) if isinstance(a, str)}
    out = []
    v = key.get("usage_fee_addresses")
    if isinstance(v, list):
        # EVERY ELEMENT CHECKED. This comes off a file on disk; a list holding
        # a dict or a None would reach str() and become a destination made of
        # the word "None".
        out += [a.strip() for a in v
                if isinstance(a, str) and a.strip() and a.strip() not in _skip]
    one = key.get("usage_fee_address")
    if isinstance(one, str) and one.strip() and one.strip() not in out \
            and one.strip() not in _skip:
        out.append(one.strip())
    return out


def wallet_owned_fee_addresses(key: dict, rpc=None) -> list:
    """Which paired fee addresses this wallet already holds the keys to.

    A FEE PAID TO THE WALLET IT CAME OUT OF IS NOT A FEE, and GhostSpiral
    already knows it: plan_usage_fee asks _wallet_owns_address and WAIVES the
    cut when the answer is yes. The trouble is where that discovery happens --
    once per withdrawal, on the vault, onto a stdout gs_wake_agent diverts to a
    0600 job log that paranoia_mode then erases. The exit code is unaffected,
    so the phone says "withdraw: sent", the operator collects nothing, and
    there is nothing anywhere to say why. Forever.

    AND PASTING SUCH AN ADDRESS IS THE EASY MISTAKE. This bot's own /address
    mints receive subaddresses on that very wallet, so the most available
    Monero address an operator has is one that triggers the waiver.

    Asked here, once, on the run that is about to spend, from the machine that
    has the wallet. The addresses are simply not offered for the draw -- the
    same treatment a destination collision gets, for the same reason.

    NONE ON ANY ERROR, and that is deliberate rather than lax. wallet-rpc
    answers get_address_index for a FOREIGN address with an error, so an error
    is the expected reply for a correctly-supplied external destination;
    treating it as "unknown, so exclude" would waive the fee on every correct
    configuration. GhostSpiral's own helper records this reasoning at length.
    """
    addrs = fee_addresses(key)
    if not addrs:
        return []
    try:
        if rpc is None:
            from gs_common import connect_rpc
            rpc = connect_rpc(key["rpc_primary"],
                              proxy_url=key.get("tor_proxy", ""))
    except Exception:                                        # noqa: BLE001
        return []
    owned = []
    for _a in addrs:
        try:
            res = rpc.raw_request("get_address_index", {"address": _a})
        except Exception:                                    # noqa: BLE001
            continue
        _ix = (res or {}).get("index") if isinstance(res, dict) else None
        if isinstance(_ix, dict) and isinstance(_ix.get("major"), int) \
                and not isinstance(_ix.get("major"), bool):
            owned.append(_a)
    return owned


def pick_fee_address(key: dict, rng=None, exclude=()) -> str:
    """One of them, uniformly, or "" when none is usable this run.

    "" means WAIVE THE CUT, not "mint one on the mixing wallet": the caller
    composes --usage-fee from the same predicate, so the flag and the address
    cannot disagree. See fee_addresses for why "" is the right answer when
    every paired address is also a destination.
    """
    addrs = fee_addresses(key, exclude=exclude)
    if not addrs:
        return ""
    return (rng or random.SystemRandom()).choice(addrs)


def _withdraw_fee_argv(key: dict, dests=(), owned=()) -> list:
    """["--usage-fee"], but only where the keyfile says where it goes.

    `dests` MUST BE THE SAME LIST pick_fee_address is given, or the flag and
    the address disagree: --usage-fee with no GS_USAGE_FEE_ADDRESS is exactly
    the configuration that mints the cut onto the mixing wallet, which is the
    recapture this function exists to prevent. One predicate, asked twice.

    THE FIRST FIX FOR THE RECAPTURE BUG WAS WORSE THAN THE BUG. A phone
    withdrawal was taking the operator's cut onto a fresh account of the very
    wallet it was emptying, and _funded_entry then handed that account to the
    NEXT withdrawal. The first fix here was to take no fee at all unless the
    keyfile named a fixed --usage-fee-address, i.e. somewhere off this wallet.

    That closed the recapture and seemed to open something else. gs_wake_keys
    at the time called omitting the address the RECOMMENDED setting: with no
    address a fresh account was minted per run, "so no address collects from
    two runs", and a fixed destination looked like one address taking a slice
    of everything. That was a Bitcoin instinct: outputs to one Monero address
    are unlinkable on-chain, and the fee address is never published the way a
    swap destination is (the memo puts THAT one in an OP_RETURN). What
    identifies runs at the fee address is the AMOUNT, a published fraction of
    each deposit, to whoever holds that wallet's keys or reads this vault's
    records -- the same whether the address is fresh or fixed. So the rule
    below costs nothing it was thought to cost, and plan_usage_fee now keeps
    it on the desk path as well: no destination off the wallet, no cut.

    SO A MARKER WAS PROPOSED AND IS NOT SHIPPED. READ THE NEXT PARAGRAPH
    BEFORE BELIEVING THIS ONE. The proposal was:

        gs_common.USAGE_FEE_ACCOUNT_LABEL is written into the wallet by
        plan_usage_fee, and _funded_entry skips it. The wallet is the one
        durable store both processes share, a label never reaches the chain,
        and fresh-mint-per-run keeps working.

    That was written here in the PRESENT TENSE, as though it had been built.
    It has not: USAGE_FEE_ACCOUNT_LABEL does not exist in gs_common or
    anywhere else in this repository, plan_usage_fee writes label="" at the
    mint and says at length why it must, and _funded_entry has nothing to
    skip. AGENTS.md rule 3 cites this very constant as THE example of a
    rejected design recorded as shipped -- and the sentence it was citing was
    still here, unmarked, which is how a reader arrives at "the fee account is
    marked, so _funded_entry is safe" and builds on nothing.

    THE MARKER CANNOT LIVE IN THE WALLET, WHICH IS WHY IT WAS REJECTED.
    (The proposal is kept above because it is the reasoning for the shape this
    settled into, and deleting it would invite a third attempt at it.)
    Labelling the fee account would let _funded_entry tell it apart -- and
    paranoia_mode deliberately never deletes the wallet file, so a label
    outlives every artifact wipe. It would survive a seizure that erased the
    plans, the logs and the staging directory, name which account is the
    operator's revenue, and hand over the deposit size to anyone who divides
    by the published rate. GhostSpiral carries that reasoning at the mint.

    SO THE FEE GOES OFF THIS WALLET OR IT IS NOT TAKEN, and the cost of that
    used to be a single reused address. It is not any more: --usage-fee-address
    is repeatable, fee_addresses reads the list, and each run draws one. The
    reuse is divided by however many the operator paired, which is a reduction
    and is not unlinkability -- see fee_addresses.
    """
    # A SILENT ZERO IS A HIDDEN BROKEN FEE, so the three ways of taking none
    # are told apart in the chain rather than all looking like "no fee".
    #
    # Driven across every configuration: a keyfile with a fee destination
    # takes nothing when that destination is ALSO an --exit-to (GhostSpiral
    # refuses the whole run when they overlap, so it is dropped here first)
    # and when it turns out to be an address of the wallet being mixed. Both
    # are correct -- a cut landing on the exit is not a cut, and one on the
    # mixing wallet is swept back out -- and both used to be indistinguishable
    # from "the operator never asked for a fee". Over many runs that is an
    # operator earning nothing and having no way to find out why.
    #
    # THE CHAIN AND NOT THE CHAT. The vault's integrity log is 0600 on the
    # machine that already knows every one of these values; putting a fee
    # configuration into the transcript would be publishing the one number an
    # analyst divides by to read the deposit.
    # THREE CAUSES, THREE TOKENS, AND IT WROTE TWO. The paragraph above says
    # "the three ways of taking none are told apart in the chain" and then
    # names all three -- never asked; the destination is also an --exit-to;
    # the destination is an address of the wallet being mixed -- while the
    # code merged the last two into one `fee_all_excluded`, because both
    # exclusions were applied in a single call and only their union was
    # visible afterwards.
    #
    # That collapse is not cosmetic: the two need DIFFERENT operator actions.
    # "every paired address is on this wallet" is fixed by pairing one that is
    # not; "every paired address is also somewhere you withdraw to" is fixed
    # by pairing one you do not. An operator reading one token cannot tell
    # which, which is the state the comment says this exists to prevent.
    #
    # Asked as three separate questions so each answer means one thing.
    _all = fee_addresses(key)
    _off_wallet = fee_addresses(key, exclude=list(owned))
    _usable = fee_addresses(key, exclude=list(dests) + list(owned))
    if _usable:
        return ["--usage-fee"]
    if not _all:
        integrity_log("wake", "fee_none_configured")
    elif not _off_wallet:
        # Every paired destination is one this wallet already holds the keys
        # to, so a cut paid to any of them is swept back out by the exit.
        integrity_log("wake", "fee_all_on_this_wallet")
    else:
        # Some are off the wallet, and every one of those is also a
        # destination for THIS withdrawal.
        integrity_log("wake", "fee_all_are_destinations")
    return []


#: Where a woken job's children write. NOT the journal. 0600, in the artifact
#: directory, so paranoia_mode wipes it with the rest of the run.
JOB_LOG = "gs_wake_job.log"
#: THE LOGS OF BOOTS THAT DID NOT FINISH CLEANLY (the review of the uncovered
#: dimensions). A clean run's log is shredded before its seal; a run that went
#: wrong kept its log in the store "so the operator can read it with
#: --unseal-state" -- and the NEXT boot destroyed it before anyone could: it
#: truncated a fresh log at start, state_open saw one on the disk and left the
#: sealed copy where it was, and the close sealed the fresh one over it. A
#: crashed run's plaintext log went at the same truncation. Both land here
#: instead, each under a header, and it is a sealed member like the rest.
#: Clean runs do not touch it -- the pager's own automatic wakes are usually
#: clean, and they came next. Bounded: a part goes after JOB_LOG_PREV_DAYS,
#: and the oldest go first past JOB_LOG_PREV_MAX bytes.
JOB_LOG_PREV = "gs_wake_job.prev.log"
JOB_LOG_PREV_DAYS = 14
JOB_LOG_PREV_MAX = 256 * 1024
_PREV_HEAD = b"==== day "


def _prev_parts(blob: bytes) -> list:
    """[(day, header+text bytes)] out of a JOB_LOG_PREV body."""
    out = []
    for _chunk in (b"\n" + (blob or b"")).split(b"\n" + _PREV_HEAD)[1:]:
        _part = _PREV_HEAD + _chunk
        try:
            _day = int(_chunk.split(b" ", 1)[0])
        except ValueError:
            _day = 0
        out.append((_day, _part.rstrip(b"\n") + b"\n"))
    return out


def _prev_part(label: str, text: bytes) -> tuple:
    _day = int(time.time()) // 86400
    return (_day, _PREV_HEAD + f"{_day} -- {label} ====\n".encode()
            + text.rstrip(b"\n") + b"\n")


#: No one part may take more than this of JOB_LOG_PREV_MAX: a failed run's
#: long log is TRIMMED to its tail -- where the reason is -- and keeps its
#: header, rather than being dropped whole for the small leftover beside it.
JOB_LOG_PREV_PART_MAX = JOB_LOG_PREV_MAX // 2


def _prev_body_of(part: bytes) -> bytes:
    """A part without its header line: what two copies of it share."""
    return part.split(b"\n", 1)[1] if b"\n" in part else b""


def _prev_write(artifact_dir: Path, parts: list, prune: bool = True) -> bool:
    """Write JOB_LOG_PREV from `parts`, oldest first. True once written (or
    nothing was left to write). Never raises: keeping a log must not cost
    the wake.

    THE SAME PART ONCE (the review of this pass): a boot killed between the
    store's open and its close merged the history into itself at the next
    open, one more copy each time; a part is its text, whatever day its
    header says. PRUNED only when `prune` -- never on the way OUT to a
    person (--unseal-state), who opened the store to read exactly this. And
    written beside and renamed over, so a kill mid-write loses nothing."""
    try:
        _seen, _uniq = set(), []
        for _d, _b in reversed(parts):
            _k = _prev_body_of(_b)
            if _b.strip() and _k not in _seen:
                _seen.add(_k)
                _uniq.append((_d, _b))
        parts = list(reversed(_uniq))
        if prune:
            _keep = int(time.time()) // 86400 - JOB_LOG_PREV_DAYS
            parts = [p for p in parts if p[0] >= _keep]
            _trim = []
            for _d, _b in parts:
                if len(_b) > JOB_LOG_PREV_PART_MAX:
                    _head, _, _rest = _b.partition(b"\n")
                    _b = (_head + b"\n[... the start of this log was cut; "
                          b"its end is kept ...]\n"
                          + _rest[-(JOB_LOG_PREV_PART_MAX - len(_head) - 64):])
                _trim.append((_d, _b))
            parts = _trim
            while len(parts) > 1 and sum(len(b) for _d, b in parts) \
                    > JOB_LOG_PREV_MAX:
                parts.pop(0)
        _body = b"".join(b for _d, b in parts)
        _p = artifact_dir / JOB_LOG_PREV
        if not _body:
            if _p.is_file():
                secure_delete_or_warn(_p, "the earlier boots' log")
            return True
        _tmp = artifact_dir / (JOB_LOG_PREV + ".new")
        secure_write_bytes(_tmp, _body, mode=0o600)
        os.replace(_tmp, _p)
        return True
    except Exception:                                        # noqa: BLE001
        return False


def _prune_prev_log(artifact_dir: Path) -> None:
    """Age and size rules on the JOB_LOG_PREV on the disk, if there is one."""
    _p = artifact_dir / JOB_LOG_PREV
    try:
        if _p.is_file():
            _prev_write(artifact_dir, _prev_parts(_p.read_bytes()))
    except OSError:
        pass


def _keep_leftover_log(artifact_dir: Path, keep: bool = True) -> None:
    """At the start of a boot: a job log still on the disk is one no seal
    and no clean finish took -- a run that crashed, the lines a failed run
    wrote after its seal, an idle boot's refusal -- so it goes to
    JOB_LOG_PREV, not to a truncation. Then a fresh, empty log.

    ONLY ON A PAIRING THAT SEALS (`keep`; the review of this pass). The
    point of keeping it is that the next wake seals it; a box that never
    seals would keep the memo naming a client's address in the clear for
    good. There the old rule holds -- shredded -- and so does any earlier
    boots' log still lying there. And pruned on every boot, not only when a
    new leftover arrives, so a run of clean boots does not keep an old one
    past its days."""
    _lp = artifact_dir / JOB_LOG
    try:
        if not keep:
            for _old in (_lp, artifact_dir / JOB_LOG_PREV):
                if _old.is_file() and not _old.is_symlink():
                    secure_delete_or_warn(_old, "an earlier boot's job log")
        elif _lp.is_file() and not _lp.is_symlink() and _lp.stat().st_size:
            _old = _lp.read_bytes()
            _prev = artifact_dir / JOB_LOG_PREV
            _have = _prev.read_bytes() if _prev.is_file() else b""
            # SHREDDED ONLY ONCE IT IS KEPT: a card too full to take the
            # copy keeps the original, and the truncation below is the old
            # behaviour, not a new loss.
            if _prev_write(artifact_dir, _prev_parts(_have) + [_prev_part(
                    "left on the disk by an earlier boot", _old)]):
                secure_delete_or_warn(_lp, "an earlier boot's job log")
        else:
            _prune_prev_log(artifact_dir)
        if _lp.is_symlink():
            # NEVER THROUGH A LINK: the truncation below would empty
            # whatever it points at.
            _lp.unlink()
    except Exception:                                        # noqa: BLE001
        pass
    try:
        _fd = os.open(str(_lp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC
                      | getattr(os, "O_NOFOLLOW", 0), 0o600)
        os.close(_fd)
    except OSError:
        pass


#: Filled in by run_once once the keyfile names the artifact directory.
_AGENT_LOG: list = [None]


def agent_say(msg: str) -> None:
    """Print, AND append to the 0600 job log once we know where it is.

    THE UNIT SILENCES stdout AND stderr, and it has to: the children print the
    BTC deposit address and the ThorChain memo, and systemd would journal them
    onto the SD card. But the agent's OWN refusal reasons and tracebacks went
    out the same pipe, so silencing it took those too -- and with
    OnFailure=gs-wake-poweroff.service, a vault that refuses for no_keyfile,
    keyfile_perms or outside_wipe_roots now boots, powers itself off, and
    leaves NOTHING behind saying why. Only the terse code reached the chain.

    So the reason goes where the children's output already goes: the artifact
    directory, 0600, gitignored, on paranoia_mode's wipe list. Diagnostics
    survive exactly as long as the artifacts do, and no longer.

    Never raises: a logging call must not become the thing that aborts a wake.
    """
    print(msg)
    _p = _AGENT_LOG[0]
    if _p is None:
        return
    try:
        _fd = os.open(str(_p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(_fd, "a") as _fh:
            _fh.write(msg.rstrip("\n") + "\n")
    except Exception:                                        # noqa: BLE001
        pass


def run_child(argv: list, env_extra: dict, budget_s: int,
              runner=None, log_path: Path = None) -> tuple:
    """Run one child under a watchdog. Returns (rc, killed_hard).

    THE CHILD'S OUTPUT MUST NOT REACH THE JOURNAL, and this is the worst leak
    this feature has had. gs-wake-agent.service is a systemd unit with no
    StandardOutput=, so everything its children printed went to
    /var/log/journal -- and the children are thor_swap_preparer, which prints
    the BTC deposit address and the THORCHAIN MEMO. The memo names the
    destination XMR address in plain text. So the one string this entire
    toolchain exists to keep off durable storage was being written to a
    persistent, root-owned, journald-rotated file on the vault, which
    paranoia_mode does not touch and cannot reach.

    The slip on disk is 0600 and gets wiped. Its contents were being copied
    into a log nobody thought of as a copy.

    So: the unit is silenced, and the children write HERE instead -- 0600, in
    the artifact directory, inside paranoia_mode's sweep. Diagnostics survive
    for as long as the artifacts do and no longer.
    """
    # A STOP REQUEST STARTS NOTHING NEW. Checked before the runner too, so
    # a job's next step is not spawned into a unit systemd is taking down.
    _stop_if_asked()
    if runner is not None:
        return runner(argv, env_extra, budget_s)
    env = dict(os.environ)
    # EVERY GS_ VARIABLE IS STRIPPED, AND ONLY env_extra PUTS ANY BACK.
    #
    # This was `dict(os.environ)` and nothing else, so every child of every job
    # inherited the agent's whole environment. That was harmless while the unit
    # set no GS_ variables -- and it stops being harmless the moment one is
    # needed: adding GS_WALLET_PASSWORD to the unit so the mix can sign would
    # hand the spend password to thor_swap_preparer, to create_receive_wallet,
    # and to anything else a job runs.
    #
    # GhostSpiral's own _child_env exists for exactly this, one layer up, and
    # its docstring says why: "a third-party child that logs or dumps its
    # environment would leak it". gs_console's _child_env does the same with an
    # allow-list per action. This is the third copy of that rule, at the layer
    # that actually spawns the processes.
    #
    # An ALLOW-LIST BY CONSTRUCTION: the only way a GS_ variable reaches a
    # child is for the dispatcher to have put it in env_extra for THAT step.
    for _k in [k for k in env if k.startswith("GS_")]:
        env.pop(_k, None)
    env["PYTHONUNBUFFERED"] = "1"
    env.update(env_extra or {})
    sink = None
    if log_path is not None:
        # 0600 at creation, not after: a world-readable window while a memo is
        # being written to it is a window.
        fd = os.open(str(log_path),
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        sink = os.fdopen(fd, "ab", buffering=0)
    # start_new_session so the watchdog can signal the whole GROUP: a tool that
    # spawns monero-wallet-cli must not leave it behind.
    try:
        p = subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL,
                             stdout=sink or subprocess.DEVNULL,
                             stderr=subprocess.STDOUT,
                             start_new_session=True)
    finally:
        if sink is not None:
            sink.close()
    # WAITED IN SLICES, so a stop request is seen within a second. One
    # p.wait(budget_s) -- up to 16.5 hours for a withdrawal -- could not see
    # it at all: the handler only records a SIGTERM, and a wait it
    # interrupts is resumed.
    _end = time.monotonic() + budget_s
    while True:
        try:
            return p.wait(timeout=max(0.0, min(1.0,
                                               _end - time.monotonic()))), \
                False
        except subprocess.TimeoutExpired:
            if _STOP_SIGNAL["int"] and not _STOP_SIGNAL["said"] \
                    and not _term_asked():
                # A CTRL-C DOES NOT KILL THE STEP. The child runs in its own
                # session, so the terminal's SIGINT never reached it; ending
                # it here would be the agent killing a mix on a keystroke.
                _STOP_SIGNAL["said"] = True
                agent_say("  [!] Ctrl-C: the step running now is left to "
                          "finish -- a mix killed part way is the one thing "
                          "here with no automatic recovery. Nothing new "
                          "starts after it, and this machine stays on. "
                          "`systemctl stop` (SIGTERM) ends the step itself.")
            if _term_asked():
                # THE CHILD'S OUTCOME IS RETURNED, not thrown away. It had
                # systemd's SIGTERM too, and what it did with it -- finished
                # the step, wrote a partial record, exited -- is in its exit
                # code and its files, which the caller already knows how to
                # read. Raising here discarded a clean exit inside the grace
                # and skipped the bookkeeping of a step that had happened.
                # The stop is still honoured: the next spawn refuses
                # (_stop_if_asked), a report stops retrying, a _nap ends.
                _killed = _stop_child_now(p)
                return (p.returncode if p.returncode is not None else -9), \
                    _killed
            if time.monotonic() >= _end:
                break
    # THE BUDGET IS SPENT: the watchdog's own stop, unchanged.
    import signal
    try:
        os.killpg(p.pid, signal.SIGTERM)
    except Exception:                                        # noqa: BLE001
        p.terminate()
    try:
        return p.wait(timeout=JOB_TERM_GRACE_S), False
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except Exception:                                    # noqa: BLE001
            p.kill()
        p.wait(timeout=30)
        return -9, True


def _stop_child_now(p) -> bool:
    """A stop request's end for a running child: its grace, then the kill,
    so the artifact directory is quiet before the records are sealed.

    SIGTERM to the GROUP first, though systemd has usually sent one: this
    also covers a stop the agent noticed some other way, and a second
    SIGTERM costs a child nothing. Returns whether it had to be KILLED."""
    import signal
    try:
        os.killpg(p.pid, signal.SIGTERM)
    except Exception:                                        # noqa: BLE001
        p.terminate()
    try:
        p.wait(timeout=STOP_CHILD_GRACE_S)
        return False
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except Exception:                                        # noqa: BLE001
        p.kill()
    try:
        p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    return True


# ---------------------------------------------------------------------------
#  One wake
# ---------------------------------------------------------------------------
def _dry_run_report(key: dict, window) -> None:
    """What a dry run can say about this machine without taking a job.
    `window` is the doorbell's wake window, or None when it did not answer
    (a hand boot, which is the ordinary one)."""
    if window is not None:
        agent_say("  [+] Dry run: keyfile, preflight, Tor and the doorbell "
                  "all check out.")
    else:
        # THE BOOT THE DOCS SEND THE OPERATOR TO (the review of the uncovered
        # dimensions). The doorbell listens only while the Pi is waking this
        # machine, so a dry run on a hand boot found nobody -- and ended at
        # doorbell_unreachable one branch before every check below, the
        # issued-index mark the checklist asks about among them.
        agent_say("  [+] Dry run: keyfile, preflight and Tor check out.")
        agent_say("  [*] The doorbell did not answer. It listens only while "
                  "the Pi is waking this machine, so on a hand boot that is "
                  "expected; the checks that do not need it follow.")
    if key.get(KEYFILE_SEALED) is not None:
        agent_say("  [*] This keyfile's settings are sealed to the pair, "
                  "so the checks that read them -- the BTC intake and "
                  "its issued-index mark, the fee wallet -- were NOT "
                  "run. Add `--unseal-state` (it asks for the half "
                  "`gs_doorbell state-key` prints) to include them.")
    else:
        _dry_fee_check(key)
    # THE PAIRING CODE, READ BACK. Both keyfiles record it and nothing
    # read either copy; printing the vault's here gives the operator a
    # way to confirm which ceremony this keyfile came from.
    _pf = (key.get("pair_fingerprint") or "").strip()
    if _pf:
        agent_say(f"      Pairing code {_pf} -- the Pi's keyfile carries "
                  f"the same one if these two boxes were paired together.")
    # print, NOT agent_say (the host-privacy pass): the Pi's address is
    # for the operator's eyes at the terminal, not for the job log on
    # the disk, which the dry run had opened before this line.
    if window is not None:
        print(f"      The doorbell answered at {key['doorbell_url']} with "
              f"a {len(window)}-byte wake window.")
    # THE ISSUED-INDEX MARK, TRIED (self-doubt over the fix pass): a
    # mark this unit cannot write refuses EVERY deposit as
    # btc_issued_unrecorded, and beside a keyfile under /etc that was
    # the shipped layout -- read-only under ProtectSystem=strict --
    # with nothing before the first client saying so. This is the
    # command the pairing tells the operator to run, so it says.
    if btc_mode(key):
        _ok, _what = _mark_probe(key)
        if _ok:
            agent_say(f"      Issued-index mark: writable ({_what}).")
        else:
            agent_say(f"  [!] Issued-index mark: NOT writable ({_what}). "
                      "Every deposit would be refused "
                      "btc_issued_unrecorded under this unit. Its "
                      "directory must be one the unit may write "
                      "(StateDirectory=ghostspiral-marks in the shipped "
                      "unit; the pairing's --mark-dir names it): re-pair "
                      "with --mark-dir, or fix the unit.")
    # WHERE A SLIP WILL GO, said here because this is the command the
    # pairing tells the operator to run, and because the answer changes
    # SILENTLY under them.
    #
    # A re-pair rebuilds this keyfile from scratch, and do_pair's payload
    # has thirteen fields of which delivery_public is not one -- correctly,
    # since a fresh pairing mints a fresh vault keypair and a delivery key
    # minted against the old one can no longer open anything. But
    # seal_slip_for_delivery answers a missing key with "" and never
    # raises, and the chat reply on that path is "depo ready · slip A3F1"
    # -- byte-identical to what an operator who never configured a delivery
    # key has always seen. There was no signal at all beyond the blob
    # quietly ceasing to arrive, at the moment money is waiting on it.
    _dp = (key.get("delivery_public") or "").strip()
    if _dp:
        # print, not agent_say: the key's prefix stays off the job log.
        print(f"      Slips will be SEALED to delivery key "
              f"{_dp[:16]}... — only gs_delivery.key opens them.")
    elif key.get("deposit_in_chat"):
        agent_say("      Slips will be sent as PLAIN TEXT into the chat "
                  "(deposit_in_chat is set in this keyfile).")
    else:
        agent_say("      Slips will STAY ON THIS MACHINE: this keyfile "
                  "names no delivery key. If you")
        agent_say("      set one up before a re-pair, it is now orphaned "
                  "— pairing mints a new vault")
        agent_say("      keypair, so mint a new one with "
                  "`gs_delivery_key new` or you will find out at")
        agent_say("      the moment a swap is quoted and you cannot reach "
                  "this box.")
    agent_say("      NOT proven: that the two keyfiles are a matched "
              "pair. Testing that needs a real")
    agent_say("      note, and a real note TAKES THE JOB — the handover "
              "is at-most-once. So this")
    agent_say("      stops here rather than spending your poke to tell "
              "you it worked.")


def _dry_fee_check(key: dict) -> None:
    """THE FEE WALLET, TRIED, which the dry run promised and no path ran
    (the review of the uncovered dimensions): its settings whole, and the
    wallet the sweep signs with on this disk. Nothing is opened; a sweep is
    the only thing that reads the wallet, and it is hours."""
    try:
        _cfg = fee_sweep_config(key)
    except Refused as e:
        agent_say(f"  [!] Fee wallet: {e.msg}")
        return
    if _cfg is None:
        agent_say("      Fee wallet: none paired.")
        return
    _wf = Path(_cfg["wallet_file"])
    _missing = [str(p) for p in (_wf, Path(str(_wf) + ".keys"))
                if not p.is_file()]
    if _missing:
        agent_say(f"  [!] Fee wallet: {len(_missing)} of its two files is "
                  f"not on this disk where the keyfile says -- a sweep "
                  f"would relay a fan-out and fail at signing. Fix the path "
                  f"or pair again.")
    else:
        agent_say("      Fee wallet: its settings are whole and its files "
                  "are where the keyfile says.")


def run_once(args, deps: dict = None) -> tuple:
    """Do at most one job. Returns (code, status, handle).

    NEVER calls sys.exit itself: main() owns the exit code because main() owns
    the finally that powers the machine off. It can still PROPAGATE a
    SystemExit raised by gs_common's own fail-closed aborts (verify_tor), and
    that is fine -- main()'s finally catches every path, and past collection
    such an abort is reported to the doorbell as a refusal like any other.

    `status` is what the doorbell is told, and it is deliberately coarse:
    done / refused / failed. The REASON stays on this machine. A doorbell that
    learns why a job was refused learns something about this wallet.
    """
    # PER RUN, NOT PER PROCESS. See _CHILD_STARTED: the handler below reads it
    # to choose between two words that mean opposite things to the operator,
    # so a stale True from an earlier job in the same process would report a
    # pre-dispatch refusal as a run that may have spent money.
    _CHILD_STARTED[0] = False
    d = deps or {}
    _post = d.get("post_record", post_record)
    # _nap, not time.sleep: the jitter is minutes long and runs with the
    # store open, and a plain sleep does not notice a stop (see _nap).
    _sleep = d.get("sleep", _nap)
    _clock = d.get("clock", time.monotonic)
    _rng = d.get("rng", random.SystemRandom())
    _child = d.get("run_child", None)
    _verify_tor = d.get("verify_tor", None)
    _accounts = d.get("account_count", None)

    proto.require_nacl()
    import nacl.public

    key = load_key(Path(args.key))
    artifact_dir = Path(key.get("artifact_dir") or ".").resolve()
    # secure_mkdir, NOT a bare mkdir. This was `mkdir(parents=True,
    # exist_ok=True)`, which is 0777 & ~umask -- measured 0755 under the
    # default umask, and the shipped unit sets no UMask=. The FILES written
    # here are 0600, but the LISTING is the leak this toolchain treats as real
    # everywhere else (see secure_mkdir): a local account could enumerate
    # thor_pairs_*.json, wallet_*.json, the job log and the status file, and
    # so learn how many swaps were arranged, when, and that this machine runs
    # a Monero cold-signing operation at all. Driven as a real unprivileged
    # uid: all four artifact names were listable. Every other directory in the
    # repo already goes through secure_mkdir; this was the one bare call left.
    #
    # narrow_existing=False, deliberately. artifact_dir defaults to "." when
    # the keyfile omits it, so a pre-existing directory here may be the
    # operator's own cwd -- and silently chmod'ing a directory you were merely
    # asked to write into is the exact regression secure_mkdir's docstring
    # records from create_receive_wallet. A directory this CREATES is 0700,
    # including its parents; one that already existed is narrowed in
    # preflight, after wipe_covers has established it is this tool's own
    # territory rather than somewhere borrowed.
    secure_mkdir(artifact_dir, narrow_existing=False)
    # From here on agent_say() has somewhere durable to write. Anything refused
    # BEFORE this line (a missing or world-readable keyfile) is still terminal
    # only -- there is no trusted directory to write to yet, and inventing one
    # from an untrusted keyfile is how you get a log outside the wipe roots.
    _AGENT_LOG[0] = artifact_dir / JOB_LOG
    # ONE BOOT'S LOG, NOT THE SERVICE'S HISTORY. The children print the
    # deposit address, the memo and the amounts, and this file was opened
    # O_APPEND by every boot: every deposit the service ever quoted, in the
    # clear, on a disk that auto-unlocks, until a hand-run wipe. A fresh one
    # at each boot instead -- and what an earlier boot left in it is kept,
    # sealed, in JOB_LOG_PREV rather than truncated away (see there).
    _keep_leftover_log(artifact_dir,
                       keep=key.get("state_half") not in (None, ""))

    # A DRY RUN ON A SEALED KEYFILE SEES ONLY ITS CLEAR HALF, so every check
    # below that reads a sealed field -- the intake, its issued-index mark,
    # the fee wallet -- found nothing and said nothing: `if btc_mode(key)`
    # is simply false without the xpub. The operator is at the machine
    # (that is what a dry run is), so it takes the same half the fee sweep
    # does; without one it says what it could not check.
    if args.dry_run and getattr(args, "unseal_state", ""):
        key = _by_hand(key, args.unseal_state, "this dry run")
    preflight(key, artifact_dir, args.dry_run, probes=d)

    # THE SEAL'S PRECONDITIONS ARE THE KEYFILE'S AND THE DISK'S, NOT THE
    # NOTE'S, so they are checked HERE -- before the doorbell is asked for
    # anything, because the handover is at-most-once and asking takes the
    # job. Both used to be decided only after M2 had been opened:
    #
    #   * a malformed state_half refused state_half_malformed there, with
    #     a client's job already taken off the Pi and not run;
    #   * a sealed secrets file beside a keyfile with NO half was never
    #     noticed at all. open_secrets is reached only when this pairing
    #     seals, so the wake signed from whatever the environment still
    #     held -- the exact fallback open_secrets refuses, taken silently
    #     by the one path that skipped it.
    #
    # NOT A DEFENCE AGAINST ANYBODY, said so per AGENTS.md rule 1: whoever
    # can write this disk can make it refuse, as they can make it do
    # anything. It rests on no secret and claims none. What it guarantees
    # is narrower and still worth it -- that the OPERATOR's sealed seed is
    # never quietly swapped for a plaintext leftover by a path that forgot
    # to open the seal.
    _vh0, _ = state_halves(key)
    _sp0 = _secrets_path(args)
    # ...AND A SEALED STORE BESIDE A KEYFILE WITH NO HALF, which ran on an
    # EMPTY ledger: the replay record, the issued deposits and the owners'
    # accounts are all inside it, so a deposit could be handed an address
    # somebody has already paid. Same rule, same moment -- before the job is
    # taken off the Pi.
    if _vh0 is None and (artifact_dir / SEALED_FILE).exists():
        integrity_log("wake", "state_unreadable")
        raise Refused(
            "state_unreadable",
            f"this machine's records are sealed ({artifact_dir / SEALED_FILE}) "
            f"and its keyfile carries no half of the key they were sealed "
            f"under -- so they are from another pairing, or the keyfile has "
            f"been altered. Nothing is run against a ledger it cannot read. "
            f"Nothing was asked of the doorbell, so the job is still waiting.")
    if _vh0 is None and _sp0.is_file():
        integrity_log("wake", "secrets_unreadable")
        raise Refused(
            "secrets_unreadable",
            f"this machine has sealed spend secrets at {_sp0}, and its "
            f"keyfile carries no half of the key they were sealed under -- "
            f"so they are from another pairing, or the keyfile has been "
            f"altered. Nothing is signed with secrets this machine cannot "
            f"read, and it will not fall back to the environment. Nothing "
            f"was asked of the doorbell, so the job is still waiting.")

    tp_sk = nacl.public.PrivateKey(bytes.fromhex(key["secret"]))
    pi_pk = nacl.public.PublicKey(bytes.fromhex(key["peer_public"]))

    # PER-BOOT EPHEMERAL. M2 is boxed to this, never to the static key, so a
    # door kick that yields the Pi's long-term secret does not decrypt months
    # of M2s recorded off the switch -- and a replayed M1 cannot open at the M2
    # reader at all. Generated here, never written down, gone when this process
    # ends and the machine powers off minutes later.
    eph = nacl.public.PrivateKey.generate()
    challenge = proto.new_challenge()

    # THE DOORBELL'S CURRENT WINDOW, FETCHED BEFORE ANYTHING IS SEALED. An M1
    # is otherwise valid forever: capture one on-path ONCE and it can be
    # replayed from anywhere on the switch at every future wake, taking each
    # job and leaving this machine to boot, be told "no job", and power off.
    # Echoing the window binds the note to the wake it was written for.
    wstat, window = _post(key["doorbell_url"], "/window", b"")
    if wstat != 200 or len(window) != proto.WINDOW_BYTES:
        # NO DOORBELL AT ALL IS THE IDLE BOOT THAT ACTUALLY HAPPENS. See
        # _idle_boot_sweep: the doorbell listens only during a pager wake,
        # so a hand power-on lands here, not at the no-job branch below.
        # Status 0 only -- a doorbell that answered something else is a
        # doorbell that is up, and a wake may be in progress around this
        # boot. Never on a dry run, which stops short of everything that
        # spends. No dwell: the sweep is hours, and a boot that does not
        # run one is left exactly as it was.
        if wstat == 0 and not args.dry_run:
            _idle_boot_sweep(key, artifact_dir, d, _secrets_path(args))
        if wstat == 0 and args.dry_run:
            _dry_run_report(key, None)
            raise Refused("dry_run",
                          "dry run complete; the doorbell was not listening, "
                          "nothing was collected and nothing ran.",
                          power=False)
        raise Refused("doorbell_unreachable",
                      "the doorbell did not hand over a wake window, so there "
                      "is nothing to bind this note to. Nothing was handed "
                      "over, so the job is still waiting.")

    # --dry-run STOPS HERE, AND THE REASON IS THAT M1 IS NOT A QUESTION.
    #
    # Driven, before this existed: `--dry-run` sent a real M1, the doorbell
    # handed the job over -- consuming its at-most-once handover -- and the
    # agent went on to run create_receive_wallet and thor_swap_preparer FOR
    # REAL, minting a wallet and quoting a live swap over Tor. Its own --help
    # said "do everything except run a job and power off", and OPSEC_SETUP
    # tells the operator to use it to confirm the pairing before relying on
    # the machine. The one command described as safe was the one that spent a
    # wake and a job.
    #
    # There is no way to ask the doorbell "would you hand me a job?" without
    # taking it: at-most-once is a property of the handover, and that is
    # correct. So the dry run stops one line before the question.
    #
    # WHAT IT STILL PROVES, and this is most of what actually breaks: the
    # keyfile loads and is 0400, preflight passes (deadman armed, no removable
    # disk, disk and RAM fine, inside the wipe roots), Tor is up, the doorbell
    # is reachable at the address in the keyfile, and it answered with a
    # well-formed wake window.
    #
    # WHAT IT DOES NOT PROVE, said out loud rather than implied: that the two
    # keyfiles are a matched pair. That takes a real M1, which takes a real
    # job. The first genuine poke is the test of that, and it is one the
    # operator can watch.
    if args.dry_run:
        _dry_run_report(key, window)
        raise Refused("dry_run",
                      "dry run complete; nothing was collected and nothing "
                      "ran.", power=False)

    m1 = proto.seal(tp_sk, pi_pk, proto.TAG_M1,
                    {"eph_pk": eph.public_key.encode().hex(),
                     "challenge": challenge.hex(),
                     "window": window.hex()})
    sent_at = _clock()
    status, m2 = _post(key["doorbell_url"], "/wake", m1)
    # UNREACHABLE AND NO-JOB ARE DIFFERENT FACTS WITH DIFFERENT ACTIONS, and
    # the first version collapsed them: post_record returns (0, b"") when the
    # request never completed, and `if status == 204 or not m2` caught that
    # first -- so a dead Pi, a pulled cable or a wrong LAN address all reported
    # "the doorbell has no job for this boot", i.e. "somebody sent a stray
    # magic packet". The operator checks the switch for an intruder while the
    # actual fault is their own network. Caught by driving it.
    if status == 0:
        raise Refused("doorbell_unreachable",
                      "could not reach the doorbell at all. The Pi may be "
                      "down, the cable out, or the address wrong. Nothing was "
                      "handed over, so the job is still waiting.")
    if status == 204 or not m2:
        # DWELL BEFORE DYING. A boot that powers off the instant it is told
        # "nothing for you" has an uptime of a few seconds, and that shape is
        # itself a statement: whoever sent that packet did not have a note for
        # this machine. Sitting a random 1-3 min removes the instant
        # boot-and-die tell. It does NOT make this look like a job boot -- a
        # real job waits 5-20 min of jitter before it starts anything -- and
        # neither this comment nor the table in OPSEC_SETUP.md claims it does.
        #
        # This block is the fix for a defect in the first version of this
        # file: NO_JOB_DWELL_LO_S/HI_S were declared, documented in the doc's
        # threat table, and never called. Dead constants that look like a
        # feature are worse than no feature, because the operator plans around
        # them.
        #
        # THERE IS NO --dry-run GUARD HERE ANY MORE, and its absence is the
        # point. It read `if not args.dry_run:` -- correct when a dry run
        # reached this line, and unreachable now that a dry run stops before
        # M1 is ever sent. A dead guard is the same defect as a dead constant
        # in the other direction: it reads as a case that is handled.
        _sleep(_rng.randint(NO_JOB_DWELL_LO_S, NO_JOB_DWELL_HI_S))
        # A BOOT WITH NO JOB IS THE FEE SWEEP'S MOMENT, if the keyfile says
        # so. The doorbell has nothing for this boot, the machine is on and
        # preflight passed; with fee_sweep_on_idle_boot the operator has
        # chosen to let a boot nobody asked for -- a stranger's magic
        # packet here, a hand power-on at the /window fetch above -- run
        # the sweep before the power-off. Off by default: the flag's help
        # says what a stranger's packet then costs. AFTER the dwell, so
        # the hostile-packet shape is unchanged when it does not run.
        _idle_boot_sweep(key, artifact_dir, d, _secrets_path(args))
        raise Refused("no_job",
                      "the doorbell answered, and it has no job for this boot. "
                      "That is what a magic packet from anyone on the switch "
                      "looks like: boot, run the idle-boot fee sweep if one "
                      "is configured (above), shut down.")
    if status != 200:
        raise Refused("doorbell_unreachable",
                      f"the doorbell answered {status}, which is not an "
                      f"answer this protocol has. Nothing was handed over.")

    body = proto.open_record(eph, pi_pk, m2, proto.TAG_M2)

    # ONE JOB PER BOOT is a property of the process, not of a flag: run_once is
    # called exactly once from main(), there is no loop, and the ephemeral and
    # the challenge are locals that die with it. An earlier draft set the
    # challenge to None here and checked it on the next line -- a guard that
    # could never fire, wearing a safety net's clothes. This repo has a name
    # for that ("a comment claiming a gate where there is none") and deletes
    # them rather than testing them.
    got = proto.challenge_of(body)
    if not _ct_eq(got, challenge):
        raise Refused("challenge_mismatch",
                      "the doorbell's answer does not echo this boot's "
                      "challenge.")
    # VALIDATE BEFORE THE WINDOW CHECK, so a slow answer still knows its
    # job_id and can be REPORTED. Order is safe: the body is already
    # authenticated and already bound to this boot's challenge, and
    # validate_job only reads a closed, typed schema out of it.
    #
    # AND A NOTE THAT FAILS IT IS STILL TOLD TO THE PI (the review of the
    # uncovered dimensions). It authenticated and echoed this boot's
    # challenge, so it is the Pi's own job, taken off it at-most-once -- and
    # the WakeError went straight up to main's bad_note, the Pi was never
    # answered, and the pager held its one-job lock for the whole result
    # window: sixteen and a half hours for a withdrawal, on the one failure
    # that says the two boxes are on different builds. Its job_id is all a
    # report needs; a note without a well-formed one cannot be answered.
    try:
        job_id, job, params = proto.validate_job(body)
    except proto.WakeError as _ve:
        try:
            _bad_jid = proto.job_id_of(body)
        except proto.WakeError:
            raise _ve
        raise _reported(key, d, _bad_jid, challenge, _ve)

    # THE PI'S HALF OF THE STATE KEY, OUT OF THE AUTHENTICATED NOTE
    # (STAGE7_PLAN.md). Recorded for main()'s finally, which re-seals and
    # has neither the keyfile nor the note. A vault paired for sealing and
    # handed a note without a half is a half-upgraded pair: refuse, because
    # the alternative is running against records it cannot open, or
    # starting an empty ledger and re-issuing somebody's address.
    _vault_half, _ = state_halves(key)
    if _vault_half is not None:
        # A REFUSAL HERE IS TOLD TO THE DOORBELL. The handover is
        # at-most-once and M2 has already taken the job off the Pi; a
        # note with no half, or a keyfile or secrets file that will
        # not open, raised a bare Refused, so the Pi was never answered
        # and the pager held its one-job lock -- every other command
        # with it -- for the whole result budget: sixteen and a half
        # hours for a withdrawal. slow_answer, below, already reported;
        # these did not. The clear half of the keyfile is all
        # report_back needs: the wake keypair and the doorbell.
        _key_clear = key
        try:
            try:
                _pi_half = proto.state_half_of(body)
            except proto.WakeError:
                raise Refused(
                    "state_half_missing",
                    "this machine's records are sealed to the pair, and the "
                    "note carries no half of the key. The Pi is running a "
                    "build from before that: update BOTH boxes, in the same "
                    "sitting, as the wire version says.")
            _STATE_KEY["vault"], _STATE_KEY["pi"] = _vault_half, _pi_half
            _STATE_KEY["dir"] = artifact_dir
            # AND THE KEYFILE'S OWN SEALED SECTION, with the same two halves
            # (STAGE8_PLAN.md). Here rather than at load, because the half only
            # exists once the note has been opened -- which is the point: the
            # xpub that names every deposit address this intake ever issued is
            # not on the seized disk in a readable form. Rebinding `key` is the
            # whole wiring; everything downstream takes it as a parameter.
            key = open_keyfile(key, _vault_half, _pi_half)
            # ...AND THE SPEND SECRETS (STAGE9_PLAN.md), if this box has sealed
            # them. Same halves, same moment, same reason: the seed spends every
            # deposit address the xpub above can find, and a machine taken
            # between wakes should not be holding it in a readable file.
            _ns = open_secrets(_secrets_path(args), _vault_half, _pi_half)
        except Refused as _m2e:
            raise _reported(_key_clear, d, job_id, challenge, _m2e)
        integrity_log("wake", "secrets_opened" if _ns else "secrets_plain")

    elapsed = _clock() - sent_at
    if elapsed > M1_M2_WINDOW_S:
        # NEVER the word "expired". The job is current; what is out of bounds
        # is the round trip, and saying so is the difference between an
        # operator checking the network and an operator checking a clock.
        raise _reported(key, d, job_id, challenge, Refused(
            "slow_answer",
            f"the doorbell answered {int(elapsed)} s after the "
            f"challenge; the window is {M1_M2_WINDOW_S} s."))

    # ONCE THE JOB IS OFF THE DOORBELL, THE DOORBELL IS OWED AN ANSWER.
    # Only the post-dispatch refusal reported back, so every refusal between
    # collection and dispatch -- a replayed job_id, the 24 h wake budget, the
    # account ceiling, an empty ladder slot, an unwatchable handle, a Tor
    # check that aborts -- left the Pi to time out and tell the operator
    # "collected but never reported back ... this job may already be done.
    # CHECK THE VAULT." Nothing had run. That is the defect this repo names
    # most often, wearing a network timeout as a disguise.
    #
    # SystemExit is in the handler because gs_common's verify_tor aborts that
    # way; an abort is still a refusal the doorbell can be told about, and
    # main()'s finally still powers the machine off after it.
    #
    # BaseException, NOT (Refused, SystemExit), AND THAT NARROW TUPLE WAS THE
    # SAME DEFECT WEARING A DIFFERENT EXCEPTION CLASS.
    #
    # The paragraph above describes fixing exactly this and then fixed it only
    # for the two exception types it happened to be thinking about. Any
    # ordinary Python failure inside _run_validated -- an AttributeError, a
    # KeyError, an OSError off a full disk -- sailed past this handler.
    # main() logs it, the finally powers the machine off, and the doorbell is
    # never told anything at all.
    #
    # What that costs the operator is the sentence this comment already calls
    # "the defect this repo names most often, wearing a network timeout as a
    # disguise": the Pi waits out the ENTIRE result budget and then reports
    # "collected but never reported back ... CHECK THE VAULT" for a job that
    # crashed in its first second. For a withdrawal that budget is 59700s, so
    # a one-line bug on the vault holds the pager's one-job lock -- and every
    # other command with it -- for sixteen and a half hours.
    #
    # It re-raises unchanged, so main()'s handler still writes the traceback
    # and the finally still powers off. report_back is internally
    # exception-safe and the doorbell refuses a second answer for a job
    # already reported, so this cannot overwrite a real result posted just
    # before a crash.
    _RUNNING[0] = "The job"
    try:
        return _run_validated(d, key, artifact_dir, state_deps=(
            job_id, job, params, challenge, _sleep, _rng, _verify_tor,
            _accounts, _child))
    except BaseException as e:
        # A STOP IS SEALED BEFORE IT IS REPORTED. report_back can spend a
        # minute on Tor and its backoff; the poweroff unit's SIGKILL comes
        # 20 seconds after its SIGTERM. Reporting first is how the records
        # were still plaintext when the power went.
        if isinstance(e, Stopping):
            _seal_state_now()
        # "refused" ONLY WHILE IT IS STILL TRUE. This reported "refused" for
        # everything raised in there, and the pager turns that word into
        # "refused before it started - nothing was spent and nothing moved."
        # A withdrawal that finished and then died writing its bookkeeping
        # reaches this handler, and that sentence is the last thing the
        # operator is told about it. "failed" is the word for a run that
        # started and did not finish, and the pager already renders it without
        # any promise about the money: "Some of it may already have moved ...
        # CHECK THE BALANCE before running it again."
        # TWO REFUSALS CARRY A WORD: "full" (at_capacity), because "wait,
        # this frees up" is the one reason a person can act on and it names
        # nothing about this wallet; and "unwatched" (intake_unwatched),
        # because the fix is at the asking end and waiting is not it. Every
        # other reason stays here.
        report_back(key, job_id, challenge.hex(),
                    "failed" if _CHILD_STARTED[0] else "refused", "",
                    phase=(_REFUSAL_PHASE.get(e.code, "")
                           if isinstance(e, Refused)
                           and not _CHILD_STARTED[0] else ""),
                    poster=d.get("post_record"), sleeper=d.get("sleep"))
        raise e


#: The refusals the Pi is told a word about (proto.PHASES), and no other.
_REFUSAL_PHASE = {"at_capacity": "full", "intake_unwatched": "unwatched"}


def _run_validated(d, key, artifact_dir, state_deps) -> tuple:
    """Everything after the job is validated. Its refusals all report back."""
    # _post is deliberately NOT threaded through: everything in here that
    # talks to the doorbell goes via report_back(poster=d.get("post_record")),
    # so a second handle on the same channel would be a second thing to keep
    # in step. The M1 POST is run_once's, and it is already done by here.
    (job_id, job, params, challenge, _sleep, _rng, _verify_tor,
     _accounts, _child) = state_deps

    # THE RECORDS ARE OPENED HERE, BEFORE ANYTHING READS ONE (STAGE7).
    # First line of the first function that touches the directory: the
    # replay ledger below is a member, and so is everything after it. A
    # pairing that does not seal (no half in the keyfile) falls straight
    # through, which is every install from before this stage.
    if _STATE_KEY.get("vault") is not None:
        _n = state_open(artifact_dir, _STATE_KEY["vault"], _STATE_KEY["pi"])
        # ONLY NOW is there anything to close. See _seal_state_now.
        _STATE_KEY["opened"] = True
        integrity_log("wake", "state_opened" if _n else "state_empty")
    else:
        integrity_log("wake", "state_unsealed")
    # WHAT THE LEDGER SAYS WAS RETIRED STAYS RETIRED. state_open restores
    # every member it does not find on the disk, and it cannot tell "never
    # written out yet" from "shredded by a run that then died before its
    # seal" -- so a power cut in that window brought a paid-out deposit's
    # slip and bundle back from the older container. The ledger that says
    # "spent" is newer than that container, so it decides.
    _heal_retired(artifact_dir)

    state = load_state(artifact_dir)
    if job_id in {j.get("id") for j in state["jobs"]}:
        prev = next(j for j in state["jobs"] if j.get("id") == job_id)
        raise Refused("job_replayed",
                      f"this machine already started job {job_id[:8]} at "
                      f"{prev.get('at')}. It may or may not have finished — "
                      f"check {artifact_dir} before poking again.")

    # A 24 h wake budget. A wipe resets it, and the account ceiling below is
    # the half that cannot be reset from this disk.
    # BUCKETED LIKE EVERYTHING ELSE THAT TOUCHES THIS DISK. The chain, the
    # bundles and the slips all coarsen to ten minutes; this file held the
    # exact second each job was accepted, beside its kind, for the last two
    # hundred -- a timetable correlatable with chain timestamps. The 24 h
    # budget and the replay refusal both survive ten-minute stamps.
    now_wall = int(time.time()) // 600 * 600
    recent = [w for w in state["wakes"] if now_wall - int(w) < 86400]
    if len(recent) >= int(key.get("daily_wake_budget", 12)):
        raise Refused("wake_budget",
                      f"{len(recent)} wakes in the last 24 h, which is the "
                      f"budget. Refusing.")

    _btc_release, _btc_release_needed = None, False
    if job == "receive_and_quote":
        # A DEPOSIT THE ASKING END CANNOT WATCH IS REFUSED HERE (wire 12),
        # before anything is minted, quoted or counted: on the intake the
        # client pays an address of this machine's that the Pi alone
        # watches and says "received" about, and the Pi refused to show one
        # only AFTER it had been issued -- the reserve's place then held for
        # two days, and the next /deposit after the operator's fix was
        # "full". Off the intake the flag changes nothing.
        if params.get("unwatched") is True and btc_mode(key):
            integrity_log("wake", "intake_unwatched")
            raise Refused("intake_unwatched",
                          "the pager that asked has no BTC servers to watch "
                          "a deposit address with, and this pair issues one "
                          "per deposit; nothing was minted or quoted. "
                          "Restart it with --btc-electrum (OPSEC_SETUP.md).")
        # THE CHAT'S PREVIOUS DEPOSIT NEVER REACHED IT (wire 12). Released
        # before the gate reads the ledger, so "/deposit again" is not
        # "full" for two days about details nobody was shown.
        # ...AN INTAKE DEPOSIT'S RELEASE WAITS FOR ITS BTC ADDRESS, asked
        # after the jitter and the Tor check (_release_undelivered): until
        # then the gate counts it as released, and if the gate needed that
        # place and the address turns out used, the deposit is refused
        # there -- still before anything is minted or quoted.
        if params.get("replaces"):
            _rel = _release_undelivered(artifact_dir, params["replaces"],
                                        params.get("owner"), key=key,
                                        defer_btc=True)
            if _rel == "btc":
                _btc_release = params["replaces"]
        ceiling = int(key.get("account_ceiling", 45))
        n = _account_count(key, _accounts)
        if n is None:
            raise Refused("account_count_unreadable",
                          "could not read how many accounts this wallet "
                          "holds, so the ceiling that stops a doorbell "
                          "minting past the offline wallet's lookahead cannot "
                          "be enforced. Refusing.")
        if n >= ceiling:
            raise Refused("account_ceiling",
                          f"this wallet holds {n} accounts and the ceiling is "
                          f"{ceiling}. OPSEC_SETUP.md §4: the offline signing "
                          f"wallet derives subaddresses for a bounded number. "
                          f"Refusing to mint more from a pager.")
        # ...AND ROOM FOR WHAT EVERY ADMITTED DEPOSIT WILL STILL MINT.
        #
        # The ceiling was checked at the deposit and never at the withdrawal
        # -- and the withdrawal is what mints: one account per mix output,
        # decoys, a carrier and a change sweep, up to twenty-nine at twenty
        # hops. So a wallet at 44 accounts took a deposit and then ran to 73.
        # Each deposit that has not been paid out is a mix still to come; this
        # reserves the deepest one the phone can ask for, per arrival, plus
        # this one, and refuses a deposit the wallet could not carry. A
        # withdrawal of an admitted deposit is NEVER refused for this: you
        # can always get your own money out. This is the capacity of the
        # service in accounts, and OPSEC_SETUP 4f gives the arithmetic and
        # the knobs that raise it.
        # ...MINUS THE GHOSTS. A deposit that was quoted and never paid held
        # its place forever, and a service whose clients ask for an address
        # and then think better of it filled up with nothing in it: after
        # (ceiling / 30) such deposits every /deposit was "full" for good.
        # An unpaid deposit past DEPOSIT_PLACE_TTL_S stops counting; a paid
        # one keeps its place at any age, and one that cannot be asked
        # about counts as paid. Nothing else changes for it: its accounts
        # stay its owner's and a late payment is still theirs to withdraw.
        _pending, _held = 0, False
        for _h, _r in _load_ledger(artifact_dir)["handles"].items():
            if _deposit_pending(_r, key, now_wall,
                                ask=d.get("subaddress_total")):
                if _h == _btc_release:
                    _held = True
                else:
                    _pending += 1
        _at_capacity(n, _pending, ceiling)
        # Would the gate have refused with that deposit still counted?
        # Then its release is what admits this one.
        _btc_release_needed = bool(_btc_release and _held) and (
            n + deposit_reserve_accounts() * (_pending + 2) > ceiling)

    # WRITE THE LEDGER BEFORE DISPATCH. If power is lost mid-job, the next boot
    # must refuse this job_id rather than run it twice -- a second slip would
    # overwrite the first, and if BTC was already sent against the first, the
    # only record of what was paid is gone.
    # THE ID AND THE BUCKET, NOT THE KIND. The replay refusal reads the id;
    # nothing reads the job word, and a job word beside a stamp is the shape
    # of the arrangement on a disk that auto-unlocks.
    state["jobs"] = (state["jobs"] + [{"id": job_id, "at": now_wall}])[-200:]
    # `recent` already dropped everything older than 24 h, so this is the
    # window plus this wake -- not an append to the unpruned list.
    state["wakes"] = recent + [now_wall]
    save_state(artifact_dir, state)
    integrity_log("wake", f"job_accepted:{job}")

    # JITTER. After the note is validated and the ledger is written, before any
    # network work the job does. OPSEC_SETUP.md §5 step 4.
    delay = _rng.randint(JITTER_LO_S, JITTER_HI_S)
    print(f"  [*] Job {job} accepted. Waiting {delay // 60} min before "
          f"starting, so the boot and the swap are not the same moment.")
    _sleep(delay)

    # The FULL Tor check now, with an exit request. Its sys.exit is caught by
    # main()'s finally, which powers off.
    if _verify_tor is not None:
        _verify_tor()
    else:
        from gs_common import validate_proxy, verify_tor as _vt
        # ON ITS OWN CIRCUIT (the host-privacy pass). The check rode the
        # bare proxy -- Tor's default circuit, shared with any other
        # uncredentialed stream of this process -- so the one request
        # every job boot makes to check.torproject.org shared a circuit,
        # and an exit, with whatever else went bare. validate_proxy
        # keeps its format refusals; the request itself is isolated.
        validate_proxy(key["tor_proxy"])
        _vt(isolated_proxy(key["tor_proxy"], "verify"))

    # THE DEFERRED RELEASE (see the gate): asked now, after the jitter and
    # the Tor check. Used, or nobody answered: the place stays, and when
    # the gate needed it this deposit is refused as it would have been --
    # before anything is minted or quoted.
    # ASKED WHETHER OR NOT THIS DEPOSIT NEEDED THE PLACE, and that is a
    # choice between two costs, made knowingly. The look puts the old
    # deposit's BTC address on the wire in the wake that then asks about
    # this deposit's new one, and a server answering both can guess from
    # the timing that they are one client's retry (_release_undelivered
    # states it). Asking only when the gate needed the place was tried
    # (15a68c4) and reverted: this is the one wake that carries `replaces`
    # -- the pager forgets it once it is answered -- so a place not
    # released now is held until it ages out (DEPOSIT_PLACE_TTL_S), and it
    # is the NEXT client's deposit that meets "full" for two days about
    # details nobody was ever shown. Skipping it would put that loss on a
    # second person to spare the first a link between two of their own
    # addresses, on a server that answers both -- a link, not a name: the
    # look says whose neither address is.
    if _btc_release is not None:
        if _release_undelivered(artifact_dir, _btc_release,
                                params.get("owner"), key=key,
                                unused=d.get("btc_unused")) is not True \
                and _btc_release_needed:
            _at_capacity(n, _pending + 1, ceiling)

    handle = proto.new_handle()
    # EVERYTHING PAST THE LEDGER REPORTS BACK, including a refusal. An earlier
    # draft returned without ever sending M3, so report_back was dead code and
    # the doorbell reported "collected_no_result" after every successful job --
    # sending the operator to check a vault that had already finished and
    # powered off. Refusals report too: "refused" with no handle and no reason,
    # because a doorbell that learns WHY a job was refused learns something
    # about this wallet.
    # A refusal raised in here is reported by run_once's handler, which now
    # covers this and every other refusal past collection alike -- rather than
    # this one path having its own copy and the rest having none.
    # A SPENDING JOB IS REFUSED UNLESS THIS MACHINE'S OWN KEYFILE ALLOWS IT,
    # AND UNLESS THE BACKSTOP CAN BE MADE TO FIT IT. Both gates here, after
    # collection and before any work, because both answers are the vault's and
    # neither may be inferred from the note.
    # Injectable like every other side effect in here, so a test can drive the
    # refusal without a systemd on the box.
    _extend_deadman = d.get("extend_deadman", extend_deadman)
    if job in getattr(proto, "SPENDING_JOBS", ()):
        # THE KEYFILE, NOT THE NOTE. `allow_withdraw` is written with physical
        # access, like the amount ladder, and is ABSENT from every keyfile
        # written before this job existed -- so upgrading the code does not
        # silently give a pager the ability to spend. getattr-with-default is
        # deliberate: an old keyfile means "no".
        # EACH SPENDING JOB HAS ITS OWN SWITCH. Enabling Monero withdrawals
        # must not silently enable spending clients' Bitcoin, or the reverse:
        # `allow_withdraw` gates the mix, `allow_btc_forward` gates the
        # forward, and both are absent from every keyfile that predates them.
        # AS BOOLEANS, NEVER COERCED (_key_switch): "false" in a hand-edited
        # keyfile was truthy here and let the job spend.
        if job == "forward_to_swap":
            _allowed = _key_switch(key, "allow_btc_forward",
                                   "btc_config_malformed")
            _switch, _code = "--allow-btc-forward", "forward_not_allowed"
        else:
            _allowed = _key_switch(key, "allow_withdraw",
                                   "withdraw_config_malformed")
            _switch, _code = "--allow-withdraw", "withdraw_not_allowed"
        if not _allowed:
            raise Refused(
                _code,
                "this machine's keyfile does not allow this spending job. "
                "That is the default, and turning it on means a machine a "
                f"pager can wake can spend -- re-pair with {_switch}, with "
                "physical access, if you mean it.")
        # THE BACKSTOP MUST OUTLAST THE JOB, or it becomes the thing that
        # breaks it. The shipped deadman is sized for the largest NON-spending
        # job; a mix runs far past it, and a power-off mid-round is the one
        # failure GhostSpiral cannot recover from automatically.
        _need = int(proto.result_budget_s(job)) + 600
        if not _extend_deadman(_need):
            raise Refused(
                "deadman_too_short",
                "could not arm a backstop long enough for this job, so it was "
                "not started. The short one is still armed and this machine "
                "will still power itself off.")
    code, status, handle = _dispatch(job, params, key, artifact_dir,
                                     handle, _child, job_id,
                                     accounts=d.get("account_indices"),
                                     btc_unused=d.get("btc_unused"))
    # A STATUS PROBE REPORTS THE HANDLE IT WAS ASKED ABOUT, not the fresh one
    # _run_validated drew. See _dispatch: handles[] is written only for
    # receive_and_quote, and the collision loop guarantees the
    # drawn handle is absent from the file -- so a watch used to answer
    # "ready · slip 7C3D" for a label the operator could not look up.
    if job in ("watch", "swap_status", "forward_to_swap"):
        handle = params["handle"]
    # ONLY THE QUOTING JOB HAS A SLIP. Both builders key on status and
    # handle alone, and a forward reports the DEPOSIT's own handle -- whose
    # record still points at the thor_pairs file the quote wrote. Left
    # unguarded, a finished forward re-shipped that slip (the deposit
    # address, the amount, the memo naming the full XMR destination) to the
    # phone, captioned as deposit instructions, on the run that had just
    # signed a spend of it. Driven and seen. The forward has nothing to
    # deliver; the watching jobs never had.
    if job == "receive_and_quote":
        slip = seal_slip_for_delivery(key, artifact_dir, status, handle)
        plain = plain_slip_for_chat(key, artifact_dir, status, handle)
    else:
        slip, plain = "", {}
    phase = _phase_of(job, artifact_dir, key=key, status=status,
                      owner=params.get("owner"), handle=handle,
                      depth=params.get("depth"))
    # THE PROBE'S ANSWER IS READ ONCE AND THEN GONE. The status file holds
    # the probe's state word and figures; it was deleted only at the START
    # of the next probe, so between two probes it sat on the auto-unlocking
    # disk. Removed here, after the one read that needed it -- and BEFORE
    # the seal below, so its figures are dropped rather than sealed away.
    if job in ("watch", "swap_status"):
        try:
            (artifact_dir / STATUS_FILE).unlink()
        except OSError:
            pass
    if job == "forward_to_swap":
        # The forwarder's one-word status, likewise read once and gone.
        try:
            _forward_status_path(artifact_dir, handle).unlink()
        except OSError:
            pass
    # SEALED BEFORE IT IS REPORTED, on a job that finished as on one that
    # was stopped. Everything the job writes is written by here; the report
    # that follows can take minutes over Tor (three attempts, 15 and 30
    # seconds between). The seal used to wait for it in main()'s finally,
    # so for those minutes a paid-out deposit's slip and bundle were
    # already shredded and the container still held them -- and a power
    # cut there brought them back at the next state_open, which restores
    # any member it does not find on the disk.
    # ...and a CLEAN run's log goes first, so this seal does not keep it.
    retire_job_log(code)
    _seal_state_now()
    report_back(key, job_id, challenge.hex(), status, handle, slip=slip,
                plain=plain, phase=phase, poster=d.get("post_record"),
                sleeper=d.get("sleep"))
    return code, status, handle


#: receive_watch's own outcome word -> the one word this protocol has for it.
#: Its five outcomes collapse into three exit codes and then, at `if rc != 0`,
#: into one boolean -- which is why "your money has not arrived yet" reached
#: the phone as "the vault FAILED". The mapping is restored from the machine
#: readable result file rather than from stdout, because a tool's human-facing
#: output is not an interface.
_PHASE_OF_STATE = {
    "funded": "landed",
    "stalled": "short",
    "not_syncing": "stuck",
    "timeout": "not_yet",
    "interrupted": "",
    # WRITTEN BY _dispatch ITSELF, not by receive_watch: a handle whose
    # arrival a withdrawal has already spent is answered from the ledger,
    # without waking the watcher on an emptied address to hear "nothing".
    "moved": "moved",
}


def _more_floor(key: dict, depth=None) -> Decimal:
    """What an arrival must hold for the NEXT leg to mix at `depth`: the
    same floor _dispatch refuses a withdrawal below (the review of this
    pass). Judged against the shallowest instead, a deep withdrawal chained
    into a leg the vault then refused below_depth_minimum -- a wake spent,
    and the reason left on this machine."""
    try:
        _wd = withdraw_wallets(depth) if depth is not None else None
    except Exception:                                        # noqa: BLE001
        _wd = None
    if _wd is None or _wd == _MIN_OUT_WALLETS:
        return Decimal(live_min_out_xmr(key))
    return Decimal(live_floor_xmr(key, _wd))


def _phase_of(job: str, artifact_dir: Path, reader=None,
              key: dict = None, status: str = "", owner=None,
              handle: str = "", depth=None) -> str:
    """The one word a status probe earned, or "". NEVER raises.

    A DONE FORWARD ANSWERS FROM ITS PLAN: `sent` when a server took the
    transaction, `unsure` when the bytes left and nothing confirmed taking
    them (the money MAY have moved -- "failed" would be the lie the
    vocabulary exists to stop), and "" for a rehearsal or a run that never
    got that far. The txid, the server and the outcome word itself stay in
    the plan; only the closed word travels.

    BOTH WATCHING JOBS, not just the short one. `watch` used to be excluded
    here, so a 110-minute wait that ended with the money still in flight came
    back to the operator as "watch: failed." -- money that has not arrived
    reported as a failure of the machine, which is the precise sentence
    swap_status exists to stop saying. Both now write the same status file and
    both are read the same way.
    """
    if job == "forward_to_swap":
        if status != "done" or not handle:
            return ""
        moved, outcome = _forward_outcome(artifact_dir, handle, reader)
        if moved:
            # MONEY KEPT PAST THE BOUND FIRST (the review of the fix): the
            # listed branch keeps the kept mark through a bump at the bound
            # precisely so this answers `kept`; letting a `delayed` from
            # that bump win told the phone "tried again later, by itself --
            # nothing to do" about money nothing retries and the operator
            # must move, and every tap after it cost a wake.
            if _forward_kept(artifact_dir, handle, reader):
                return "kept"
            # THIS RUN'S OWN WORD NEXT, for the two a reconciliation over
            # a moved plan leaves when it refuses: money came back and is
            # not settled (`returned`), or a replacement -- or a fresh
            # forward of returned money -- that today's fee will not carry
            # (`delayed`). The status file is removed before every child
            # and written only on a refusal that sent nothing, so a word
            # here is this run's. Read after the plan, they were answered
            # `sent` / `forwarded` ("the forward has confirmed. Nothing
            # more to check" about money sitting back on the address), and
            # the Pi's branches for them -- watch it again; wait the fee
            # retry -- never ran. NOT `short` or `arriving`: their
            # sentences are about a deposit that has not gone, and the
            # forward this plan records did.
            _word = _forward_status_word(artifact_dir, handle, reader)
            if _word in ("returned", "delayed"):
                return _word
            # MONEY BACK THAT NO RATE CAN CARRY, once the forward on record
            # is in a block (wire 11): `leftover`, where the plan alone said
            # `forwarded` and the Pi started the same refused forward every
            # recheck window. While the record is still in the mempool the
            # plan's `sent` stands -- the Pi's recheck of it must go on
            # until it mines, and the next one answers this word. A plan
            # SUPERSEDED by a forward of ours is here too, with no clause of
            # its own: _forward_outcome reads it `accepted` whatever its own
            # outcome became, and _forward_mined reads its superseder's
            # height. (An `or _forward_superseded(...)` here was dead code:
            # removing it changed no answer, so nothing could pin it.)
            if _word == "leftover" and outcome == "accepted" and (
                    _forward_mined(artifact_dir, handle, reader)):
                return "leftover"
            # (KEPT, above, comes before `forwarded` too: or the Pi would end
            # its rechecks on a deposit whose money is sitting here, and the
            # chat would hear "confirmed" about it -- third self-doubt pass.)
            # IN A BLOCK IS ITS OWN WORD (stage 6): the Pi's rechecks of
            # this forward end on it, and the arrival is the XMR side's
            # question. Only an ACCEPTED forward can be mined; an
            # ambiguous one that the network later listed was made
            # accepted by the reconciliation before this reads it. A plan
            # SUPERSEDED by another forward of ours that mined is the
            # word too, whatever its own outcome was: the record moved.
            if _forward_mined(artifact_dir, handle, reader) and (
                    outcome == "accepted"
                    or _forward_superseded(artifact_dir, handle, reader)):
                return "forwarded"
            return "sent" if outcome == "accepted" else "unsure"
        # NOTHING WAS SENT. Either a rehearsal (a plan, no outcome: "") or
        # a forward that found nothing settled and said what it saw
        # (not_yet / arriving) -- the answer a tap on "Has it arrived?"
        # gets on a deposit the Pi is not watching (STAGE4_PLAN.md 3.6).
        # Never `leftover` here: it says the forward confirmed, and with no
        # plan that moved nothing did.
        _word = _forward_status_word(artifact_dir, handle, reader)
        return "" if _word == "leftover" else _word
    # A FINISHED WITHDRAWAL ANSWERS A DIFFERENT QUESTION: is there another
    # arrival still sitting here?
    #
    # _funded_entry takes the LARGEST SINGLE unlocked output and never sums,
    # because summing spends inputs from several subaddresses in one
    # transaction and that is permanent public proof they share an owner. So a
    # withdrawal moves ONE arrival -- correct, and it left the operator with no
    # idea whether anything remained, which reads as having been paid a
    # fraction. Asked here, on the machine that has the wallet, at the one
    # moment the answer is both cheap and true.
    #
    # ONLY ON SUCCESS. A failed or refused run has not moved the entry it
    # chose, so "there is more" would be trivially true and would chain the
    # pager into repeating a run that just failed.
    if job == "withdraw":
        if status != "done":
            return ""
        # THE OWNER'S OWN REMAINDER, not the wallet's. Unscoped, a finished
        # withdrawal said "more is here" about another client's arrival and
        # invited this one to take it -- the largest output on the wallet,
        # whoever put it there. With an owner the question is asked over that
        # owner's accounts alone; a ledger that cannot be read gives an empty
        # set, which says nothing rather than the wallet.
        _owned = None
        if owner:
            try:
                _owned = _owner_accounts(_load_ledger(Path(artifact_dir)),
                                         owner)
            except Exception:                                # noqa: BLE001
                _owned = set()
        try:
            _left = _funded_entry(key, owned_accounts=_owned)
            if not _left:
                # NOTHING UNLOCKED IS NOT NOTHING. A deposit that landed
                # while this leg ran is inside the network's unlock window
                # for twenty minutes, and _funded_entry cannot see it by
                # design (a mix planned around it fails partway). "Nothing
                # more was found" for it was a false statement about the
                # balance, on the surface this chain was added to stop
                # making one -- and the client, told that, was done, with
                # their second deposit still on the wallet. The same floor
                # as below: locked dust is not more.
                _locked = _locked_value(key, owned_accounts=_owned)
                if (_locked is not None
                        and _locked >= _more_floor(key, depth)):
                    return "more_locked"
                return ""
            # ...AND IT HAS TO BE BIG ENOUGH TO MIX, or the next leg is a wake
            # spent to fail at stage 0.
            #
            # "There is more here" was answered by ANY unlocked output, so the
            # chain chased leftovers it could not process: a dust arrival, or
            # a usage fee a desk run minted onto this wallet -- which
            # _funded_entry genuinely cannot tell from a deposit, and which is
            # typically about a hundredth of one. Each such leg costs a magic
            # packet, a boot, a 5-20 minute jitter and one of twelve daily
            # slots, and comes back "withdraw: failed" with a hint about
            # mixing depth that is not the reason.
            #
            # The same floor the deposit gate uses: what can be MIXED, not
            # what a fee would need. This first used the with-cut figure when
            # the keyfile named a fee destination, which ABANDONED arrivals
            # between the two and told the operator "that was the last one
            # here, nothing left to send" about money still sitting there --
            # a false statement about their balance, on the surface this chain
            # was added to stop making one. plan_usage_fee waives a cut too
            # small to spend and the mix goes ahead in full.
            #
            # Decimal(10 ** 12) is how GhostSpiral itself converts atomic
            # units, spelled the same way here so the two cannot disagree
            # about what a piconero is.
            _left_xmr = Decimal(str(_left[3])) / Decimal(10 ** 12)
            _floor = _more_floor(key, depth)
            if _left_xmr >= _floor:
                return "more_left"
            # ...AND UNLOCKED DUST DOES NOT HIDE A DEPOSIT STILL UNLOCKING
            # (the vault review): a returning client's leftover under the
            # floor made this "nothing more" about four XMR a few blocks
            # from spendable -- the unlocking figure was asked only when
            # nothing at all was unlocked.
            _locked = _locked_value(key, owned_accounts=_owned)
            if _locked is not None and _locked >= _floor:
                return "more_locked"
            return ""
        except Exception:                                    # noqa: BLE001
            # The wallet could not be asked. "" is honest: the operator is
            # told the withdrawal finished and nothing more, which is where
            # they were before this existed.
            return ""
    if job not in ("swap_status", "watch"):
        return ""
    try:
        out = (reader or _read_json)(Path(artifact_dir) / STATUS_FILE) or {}
        word = _PHASE_OF_STATE.get(out.get("state"), "")
        # TIMEOUT SPLITS IN TWO, and the split is the whole point of a THREE
        # MINUTE probe. receive_watch has no "arriving" state because it is
        # built to wait for hours, so a payment that is on-chain and still
        # confirming looks identical to an empty address inside a short
        # window -- both come back "timeout". `total` is what separates them,
        # and telling an operator "nothing yet" when their money is two
        # confirmations away is the same class of wrong answer as telling them
        # the vault failed.
        # ...AND "ARRIVING" SPLITS AGAIN. "Still confirming" is what a
        # balance with something pending is; a balance that has ALL
        # unlocked and is still under the quote is not confirming anything,
        # it is short SO FAR -- a swap delivered in two transactions, or a
        # refund leg still to come. The probe cannot tell "so far" from
        # "for good" in three minutes (see the argv: it passes no stall
        # window for exactly that reason), so it says what it saw and asks
        # for another look, and leaves "stopped growing" to the long watch.
        if word == "not_yet":
            try:
                _tot = Decimal(str(out.get("total") or "0"))
                _unl = Decimal(str(out.get("unlocked") or "0"))
                if _tot > 0:
                    word = "partial" if _unl >= _tot else "arriving"
            except (InvalidOperation, ValueError):
                pass                      # unreadable total: stay with not_yet
        return word if proto.phase_is_known(word) else ""
    except Exception:                                        # noqa: BLE001
        # No file, unreadable, or a state word this version has never heard of.
        # "" is honest: the pager then says the probe ran and told us nothing,
        # which is true, rather than inventing a reassurance.
        return ""


def _reported(key, d, job_id, challenge, exc):
    """Tell the doorbell 'refused', then hand back the exception to raise."""
    report_back(key, job_id, challenge.hex(), "refused", "",
                poster=d.get("post_record"), sleeper=d.get("sleep"))
    return exc


def _ct_eq(a: bytes, b: bytes) -> bool:
    import hmac
    return hmac.compare_digest(a, b)


def _account_count(key: dict, injected=None):
    if injected is not None:
        return injected()
    try:
        from gs_common import connect_rpc
        rpc = connect_rpc(key["rpc_primary"], proxy_url=key.get("tor_proxy", ""))
        r = rpc.raw_request("get_accounts", {}) or {}
        return len(r.get("subaddress_accounts") or [])
    except Exception:                                        # noqa: BLE001
        return None


def _account_indices(key: dict, injected=None):
    """The wallet's account indices as a set, or None when it cannot be asked.

    Read BEFORE and AFTER a withdrawal's mix: every account the mix minted --
    its outputs, its decoys, the veil carrier, the change sweep -- is one the
    requesting owner's money created, and the difference is recorded as that
    owner's, so a later leg chases the owner's own change and nobody else's.
    Correct because ONE job runs per boot (run_once has no loop); a test
    anchors that invariant beside this one.
    """
    if injected is not None:
        return injected()
    try:
        from gs_common import connect_rpc
        rpc = connect_rpc(key["rpc_primary"], proxy_url=key.get("tor_proxy", ""))
        r = rpc.raw_request("get_accounts", {}) or {}
        out = set()
        for _a in (r.get("subaddress_accounts") or []):
            _i = _a.get("account_index") if isinstance(_a, dict) else None
            if isinstance(_i, int) and not isinstance(_i, bool):
                out.add(_i)
        return out
    except Exception:                                        # noqa: BLE001
        return None


def _funded_entry(key: dict, injected=None, rpc_url: str = None,
                  owned_accounts=None):
    """The (account, subaddress, address, atomic) holding this wallet's money.

    THE VAULT ANSWERS THIS, NOT THE PHONE. A withdrawal used to name a 4-hex
    handle pointing at a receive bundle a /depo had minted -- which meant only
    money that arrived through this tool's own deposit flow could be withdrawn
    at all, and the operator had to remember which label named which pile. The
    machine holding the wallet is the one that can see where the money is;
    asking a chat message to name an account index was asking the wrong box.

    THE LARGEST SINGLE OUTPUT, and it is a deliberate refusal to be clever.
    Summing several subaddresses would mean a mix whose first transaction
    spends inputs from all of them, which is permanent public proof they share
    an owner -- exactly what the rest of this pipeline spends hours avoiding.
    One output in, one mix, one destination. If the operator has money in three
    places, that is three withdrawals, and that is the honest cost rather than
    a merge dressed up as convenience.

    UNLOCKED ONLY. A balance that has not unlocked cannot be spent, and a mix
    planned around it fails partway with money already moved.

    RETURNS None WHEN NOTHING QUALIFIES, and the caller refuses. Guessing an
    account here would point a spend at the wrong pile.

    `owned_accounts`: THE ONE FILTER, and it only ever NARROWS. When it is a
    set, an output is a candidate only if its account is in it -- the accounts
    the requesting owner's own deposits and mixes created, from the ledger.
    None means the whole wallet, which is right for the fee wallet (it has no
    clients) and for a hand-run. An EMPTY set means nothing of this owner's
    is here, and that is answered as None, never widened to the wallet:
    isolation between clients rests on this line and the pairing secret that
    signs the owner token, not on anyone not knowing the code.
    """
    if injected is not None:
        _got = injected()
        if owned_accounts is not None and _got and _got[0] not in owned_accounts:
            return None
        return _got
    try:
        from gs_common import connect_rpc
        rpc = connect_rpc(rpc_url or key["rpc_primary"],
                          proxy_url=key.get("tor_proxy", ""))
        try:
            rpc.raw_request("refresh", {})
        except Exception:                                    # noqa: BLE001
            # A refresh that fails is not fatal -- the balances below are
            # whatever the wallet has already scanned. It is worth trying
            # because a wallet that has just booted may not have caught up.
            pass
        accts = (rpc.raw_request("get_accounts", {})
                 or {}).get("subaddress_accounts") or []
        best = None
        for _a in accts:
            _ai = _a.get("account_index")
            if not isinstance(_ai, int) or isinstance(_ai, bool):
                continue
            if owned_accounts is not None and _ai not in owned_accounts:
                continue
            r = rpc.raw_request("get_balance",
                                {"account_index": _ai,
                                 "address_indices": [],
                                 "all_accounts": False}) or {}
            for _sub in (r.get("per_subaddress") or []):
                _amt = _sub.get("unlocked_balance")
                _si = _sub.get("address_index")
                _ad = _sub.get("address")
                if not isinstance(_amt, int) or isinstance(_amt, bool):
                    continue
                if not isinstance(_si, int) or isinstance(_si, bool):
                    continue
                if not _amt or not isinstance(_ad, str) or not _ad:
                    continue
                if best is None or _amt > best[3]:
                    best = (_ai, _si, _ad, _amt)
        return best
    except Exception as e:                                   # noqa: BLE001
        # NOT THE SAME None. A wallet that could not be asked is not a wallet
        # with nothing in it; the caller cannot tell them apart from the
        # value, so the difference is recorded here, where it is known.
        integrity_log("wake", "funded_entry:rpc_failed")
        agent_say(f"  [!] could not read the wallet's balances "
                  f"({terminal_safe(type(e).__name__)}); treating as none "
                  f"found.")
        return None


def _locked_value(key: dict, injected=None, rpc_url: str = None,
                  owned_accounts=None):
    """The largest single subaddress's balance that has not all unlocked
    yet, in XMR -- what the next withdrawal's entry will be once it has --
    or None when the wallet could not be asked. Nothing is spent from
    this; it decides whether a finished withdrawal says "more is here,
    still unlocking" or "nothing more was found". None is treated by the
    caller as "" (say nothing), never as "more".

    ONE SUBADDRESS, NOT THE SUM (the vault review, rule 2: one state
    decided twice). The sum was compared with the mix floor, while the
    withdrawal it invites takes ONE entry -- the largest unlocked output,
    per subaddress (_funded_entry) -- and refuses under the floor. Two
    arrivals each under it summed over it: "Run /withdraw again in a
    while", and that withdrawal spent a wake to be refused
    below_mix_minimum. Asked the same way the entry is chosen, the answer
    is one the next step can act on.

    `owned_accounts` scopes it the way _funded_entry is scoped: the owner's
    accounts alone, so one client is never told another's arrival is
    "still unlocking". An empty set is zero, not the wallet.
    """
    if injected is not None:
        return injected()
    try:
        from gs_common import connect_rpc
        rpc = connect_rpc(rpc_url or key["rpc_primary"],
                          proxy_url=key.get("tor_proxy", ""))
        if owned_accounts is None:
            _queries = [{"account_index": 0, "all_accounts": True}]
        else:
            _queries = [{"account_index": int(_i), "all_accounts": False}
                        for _i in sorted(owned_accounts)]
        _best = 0
        for _q in _queries:
            r = rpc.raw_request("get_balance", _q) or {}
            _subs = r.get("per_subaddress")
            if _subs is None:
                _subs = []
            if not isinstance(_subs, list):
                return None
            for _sub in _subs:
                if not isinstance(_sub, dict):
                    return None
                _bal, _unl = _sub.get("balance"), _sub.get("unlocked_balance")
                for _v in (_bal, _unl):
                    if not isinstance(_v, int) or isinstance(_v, bool):
                        return None
                if _bal > _unl and _bal > _best:
                    _best = _bal
        return Decimal(str(_best)) / Decimal(10 ** 12)
    except Exception:                                        # noqa: BLE001
        return None


def _bundle_pair(rec: dict):
    """(account, subaddress) a handle record's bundle points at, or None.

    Read from the bundle FILE through the one strict loader, never from the
    record: the record holds a path and the file holds the address, and a
    record whose file is gone (wiped, or never written) names nothing --
    EXCEPT a record retired on purpose: a paid-out deposit's bundle is
    shredded (see _retire_files) and the pair it named is kept on the record,
    two small integers, so the ledger can still answer for it.
    """
    try:
        from gs_common import load_receive_bundle
        _b = load_receive_bundle(rec.get("bundle"))
        return (int(_b["account_index"]), int(_b["subaddress_index"]))
    except Exception:                                        # noqa: BLE001
        pass
    _p = rec.get("pair")
    if (isinstance(_p, list) and len(_p) == 2
            and all(isinstance(_i, int) and not isinstance(_i, bool)
                    and _i >= 0 for _i in _p)):
        return (int(_p[0]), int(_p[1]))
    return None


# What a paid-out INTAKE record keeps past its payout: what a later
# reconciliation of the host's own deposit address reads. See _retire_files.
_INTAKE_KEEPS = ("bundle", "forward_plan")


def _retire_files(rec: dict, artifact_dir: Path) -> None:
    """Shred a paid-out deposit's slip and bundle. The record keeps its
    (account, subaddress) pair and its spent flag; the files kept the deposit
    address, the memo naming the receive address in full, the amounts and the
    account -- a who-sent-what line for every client, on a disk that
    auto-unlocks, until a hand-run wipe that would also end every other
    client's open run. Retired the moment the money has left instead.

    NOT THE FORWARD PLAN OF AN INTAKE RECORD (the MED pass after the deep
    read): the plan chain is what a later reconciliation reads to tell a
    refund from a stranger's payment, to leave out what a listed forward
    of ours consumed, and to know the outpoints it must never sign twice
    -- and money can reach the host's own address after the withdrawal
    (the forward branch of _dispatch says how). Shredded here, the next
    return to the address met a chain with no plan and was refused for
    ever. It stays until the hand-run wipe, which covers every
    btc_forward_*.json; a record with no deposit address of the host's
    (quoted for the client to pay ThorChain directly) has no chain to
    keep and its plan goes with the rest.

    NOR ITS BUNDLE (the stage 5 read). The reconciliation that plan chain
    exists for is a forwarder run, and the forwarder takes the swap's
    destination from the bundle (--dest-from-receive-wallet) before it
    asks the network anything. Shredded here with the plan kept, every
    later return to the address -- the refund of a swap that filled part
    of the way and paid out, a client paying the address once more -- met
    `bad_bundle` for ever: the plan kept for a run that could not start.
    Nothing new stays on the disk for it. The bundle is the destination
    address, which the kept plan names as `dest_xmr`; the account and
    subaddress, which this record keeps as `pair`; and the wallet's
    endpoint, which the keyfile beside it holds. It goes with the plan, at
    the hand-run wipe (wallet_*.json). The slip -- the memo, the amounts --
    is not needed by any reconciliation and still goes now.

    ONLY INSIDE `artifact_dir`, as _heal_retired (the vault review, a guard
    on one side of a boundary): every file a deposit has is written there,
    and a record naming a path elsewhere -- damaged, or edited by hand --
    had it shredded by the withdrawal's cleanup while the heal refused the
    same path. A limit on what a bad record can cost, not a defence against
    whoever can write this disk."""
    try:
        _root = Path(artifact_dir).resolve()
    except (OSError, ValueError):
        return
    for _k in ("slip", "bundle", "forward_plan"):
        _p = rec.get(_k)
        if not _p:
            continue
        if _k in _INTAKE_KEEPS and rec.get("btc_index") is not None:
            continue
        try:
            if Path(str(_p)).resolve().parent != _root:
                integrity_log("wake", f"retire_refused:{_k}")
                continue
            if Path(_p).is_file():
                secure_delete_or_warn(Path(_p), f"a paid-out deposit's {_k}")
        except Exception:                                    # noqa: BLE001
            integrity_log("wake", f"retire_failed:{_k}")


def _heal_retired(artifact_dir: Path) -> int:
    """Retire again what a spent record's files left behind. Returns how
    many records it touched. NEVER raises: a wake is not refused over
    housekeeping.

    Two ways to get here, both a run that died mid-way: shredded, then
    brought back by state_open from a container sealed before the shred;
    or marked spent and saved, then killed before the shred. Either way the
    ledger says spent and the files say otherwise, and the files are the
    who-sent-what line _retire_files exists to remove.

    ONLY INSIDE THE ARTIFACT DIRECTORY. A record names its files by path,
    and a ledger is a file: this runs on every wake, so it must not be able
    to shred anything a damaged or hand-edited record happens to name. Not
    a defence against whoever can write this disk -- they can delete what
    they like without it -- a limit on what a bad record can cost."""
    try:
        root = artifact_dir.resolve()
        handles = _load_handles(artifact_dir) or {}
    except Exception:                                        # noqa: BLE001
        return 0
    touched = 0
    for rec in handles.values():
        if not (isinstance(rec, dict) and rec.get("spent") is True):
            continue
        mine = {}
        for _k in ("slip", "bundle", "forward_plan"):
            # WHAT AN INTAKE RECORD KEEPS IS NOT A LEFTOVER. Counted as one,
            # every wake after such a payout touched the record, shredded
            # nothing, and wrote `retired_leftovers` to the chain: a line
            # that said a crash had been healed, every wake, about none.
            if _k in _INTAKE_KEEPS and rec.get("btc_index") is not None:
                continue
            _p = rec.get(_k)
            try:
                if (isinstance(_p, str) and _p
                        and Path(_p).resolve().parent == root
                        and Path(_p).is_file()):
                    mine[_k] = _p
            except (OSError, ValueError):
                continue
        if not mine:
            continue
        mine["btc_index"] = rec.get("btc_index")
        _retire_files(mine, artifact_dir)
        touched += 1
    if touched:
        integrity_log("wake", "retired_leftovers")
    return touched


def _subaddress_total(key: dict, acct: int, sub: int, injected=None):
    """Atomic units on ONE subaddress, locked and unlocked together, or None.

    None is "could not be asked", and the caller treats it as "not zero":
    a bundle is reused only when the wallet has SAID nothing ever reached it.
    """
    if injected is not None:
        return injected(key, acct, sub)
    try:
        from gs_common import connect_rpc
        rpc = connect_rpc(key["rpc_primary"], proxy_url=key.get("tor_proxy", ""))
        r = rpc.raw_request("get_balance",
                            {"account_index": int(acct),
                             "address_indices": [int(sub)],
                             "all_accounts": False}) or {}
        for _s in (r.get("per_subaddress") or []):
            if _s.get("address_index") == int(sub):
                _amt = _s.get("balance")
                if isinstance(_amt, int) and not isinstance(_amt, bool):
                    return _amt
                return None
        # A subaddress the wallet does not list has never been paid.
        return 0
    except Exception:                                        # noqa: BLE001
        return None


def _wallet_address_index(key: dict, address: str):
    """(account, subaddress) at which this machine's wallet holds `address`,
    or None when its answer names none; RAISES on any error. The wallet's own
    answer (get_address_index), over rpc_primary. wallet-rpc answers a
    FOREIGN address with an error too (see wallet_owned_fee_addresses), and
    that error is not told apart from an unreachable wallet here: the one
    caller refuses either way, in words true of both."""
    from gs_common import connect_rpc
    rpc = connect_rpc(key["rpc_primary"], proxy_url=key.get("tor_proxy", ""))
    res = rpc.raw_request("get_address_index", {"address": address})
    ix = (res or {}).get("index") if isinstance(res, dict) else None
    if not isinstance(ix, dict):
        return None
    a, s = ix.get("major"), ix.get("minor")
    if any(isinstance(v, bool) or not isinstance(v, int) or v < 0
           for v in (a, s)):
        return None
    return (a, s)


def _rebuild_retired_bundle(key: dict, artifact_dir: Path, handle: str,
                            rec: dict) -> str:
    """The receive bundle of a paid-out intake record, written back where
    the record names it, from what the vault still holds -- or a refusal
    (`bundle_unrecoverable`), before anything runs.

    WHERE THE DESTINATION COMES FROM, AND WHAT IT RESTS ON. The plan chain
    names it (`dest_xmr`, every forward of this deposit, which _retire_files
    keeps for an intake record) and the record kept the (account,
    subaddress) pair when it was paid out. Neither is taken on its own
    word: every plan must name the SAME destination, and the WALLET must say
    it holds that address at exactly that pair (_wallet_address_index). A
    swap's destination is where money goes, so this rests on the wallet,
    the one party here that knows which addresses are this machine's -- not
    on a file a damaged disk could have changed. A wallet that cannot be
    asked, a pair it does not confirm, plans that disagree or name nothing,
    or a record naming a path outside the artifact directory: refused, and
    the operator can move the money by hand as before."""
    _p = rec.get("pair")
    pair = (tuple(int(v) for v in _p)
            if isinstance(_p, list) and len(_p) == 2
            and all(isinstance(v, int) and not isinstance(v, bool)
                    and v >= 0 for v in _p) else None)
    dests = set()
    for _pl in [_read_json(artifact_dir / f"btc_forward_{handle}.json")] \
            + _forward_chain(artifact_dir, handle):
        if isinstance(_pl, dict) and _pl.get("dest_xmr"):
            dests.add(str(_pl["dest_xmr"]))
    try:
        target = Path(str(rec.get("bundle")))
        inside = target.resolve().parent == artifact_dir.resolve()
    except (OSError, ValueError):
        inside = False
    if pair is None or len(dests) != 1 or not inside:
        integrity_log("wake", "bundle_unrecoverable")
        raise Refused("bundle_unrecoverable",
                      f"handle {handle} was paid out by an earlier build that "
                      "shredded its receive bundle, and what the vault kept "
                      "cannot rebuild it (no single destination on its plans, "
                      "no recorded pair, or a path outside the artifact "
                      "directory). Nothing was run. Money that reached its "
                      "BTC address since is the seed's to move by hand.")
    dest = dests.pop()
    try:
        held = _wallet_address_index(key, dest)
    except Exception:                                        # noqa: BLE001
        held = "unasked"
    if held != pair:
        integrity_log("wake", "bundle_rebuild_unconfirmed"
                      if held == "unasked" else "bundle_rebuild_mismatch")
        raise Refused("bundle_unrecoverable",
                      f"handle {handle}'s receive bundle must be rebuilt, and "
                      "the wallet did not confirm it holds the destination "
                      "its plans name at the pair this deposit was paid out "
                      "from (it could not be asked, or it answered otherwise)."
                      " Nothing was run and nothing was written; the chain "
                      "line says which. Check the wallet at the machine.")
    atomic_write_json({"schema": "gs_receive_wallet_v1",
                       "address": dest,
                       "account_index": pair[0],
                       "subaddress_index": pair[1],
                       "rpc_endpoint": key.get("rpc_primary", "")},
                      target, perms=0o600)
    integrity_log("wake", "bundle_rebuilt")
    return str(target)


def _at_capacity(n: int, pending: int, ceiling: int) -> None:
    """Refuse `at_capacity` when this wallet's `n` accounts, and what
    `pending` admitted deposits and this one may still mint, pass the
    ceiling (see the gate in _run_validated)."""
    _need = n + deposit_reserve_accounts() * (pending + 1)
    if _need > ceiling:
        integrity_log("wake", "at_capacity")
        raise Refused("at_capacity",
                      f"this wallet holds {n} accounts, {pending} "
                      f"deposit(s) are admitted and not yet paid out, and "
                      f"each may still mint up to "
                      f"{deposit_reserve_accounts()}: {_need} against a "
                      f"ceiling of {ceiling}. Refusing to admit another "
                      f"until some are paid out, or the wallet is "
                      f"recreated with a larger lookahead and the ceiling "
                      f"raised (OPSEC_SETUP.md 4f).")


def _release_undelivered(artifact_dir: Path, h: str, owner, key=None,
                         unused=None, defer_btc=False):
    """Mark handle `h` RELEASED: its details never reached the chat that
    asked (the pager says so, wire 12's `replaces`), so it gives up the
    youth grace that holds an unpaid deposit's place in the reserve
    (_deposit_pending). Returns whether a record was marked. Never raises
    (a stop asked for aside, which is not a refusal): a deposit is not
    refused over the one before it.

    ONLY THE ASKING OWNER'S OWN RECORD, and it rests on the pairing secret:
    only the paired Pi can seal a note, and the owner token in it is the
    one it derives from the asking chat. A record with no owner (from
    before owners existed), another owner's, a paid-out one, or a handle
    this ledger does not know is left alone.

    NOT "NEVER PAID". A send the Pi saw fail may still have reached the
    chat -- a reply lost after Telegram took the message -- and the client
    may have paid. So the release waives only the grace an UNPAID deposit
    gets for being young; the evidence still decides: money on its BTC
    side within the grace (_paid_since), money on its address, or a wallet
    that cannot be asked keeps the place as before. Nothing is shredded and the record stays: its label still
    answers, and money that does arrive is still that client's.

    ...AND AN INTAKE DEPOSIT'S EVIDENCE IS ON ITS BTC ADDRESS FIRST (the
    review of 657deae). Its client pays this machine's BTC address, and
    nothing reaches the XMR subaddress until a forward runs -- which the
    Pi starts only while it watches the deposit, and a deposit whose pay
    message it saw fail it does not watch. Released, that record met the
    evidence with no forward behind it and an empty subaddress, and its
    place went to the next deposit while the first client's BTC sat on the
    address: two mixes to come against a reserve for one. So the address is
    asked first (_btc_unused_live, `unused` injected in tests): released
    only when the network says it was never used. Used, or nobody
    answered, or a record of another chain this pair cannot derive: the
    place is kept. Rests on the server's word, not on a secret: a server
    that lies "unused" admits one deposit too many; one that lies "used"
    keeps a place for two days, as before the release existed. A HAZARD,
    STATED: the look runs in the wake that then asks about the next
    address, each on its own circuit, and a server that answers both can
    guess from the timing that they are one client's -- a retry. (Each
    address is asked of the server its own script hash picks first, so
    with several servers the two often go to different ones; with one,
    never.) Both were that client's, and neither look names them. It is
    asked on every such wake, needed or not: _run_validated says why
    skipping it costs the next client instead.

    NOT BEFORE THE JITTER AND THE TOR CHECK (the review of this change):
    the gate that needs the answer runs before both, and a look there put
    a deposit address on the wire at the moment the jitter exists to
    decorrelate, ahead of the check that refuses a proxy which is not Tor.
    So `defer_btc` answers "btc" for an intake record without asking
    anyone; the gate counts it as released, and _run_validated asks, and
    releases or refuses, after both."""
    try:
        led = _load_ledger(artifact_dir)
        rec = (led.get("handles") or {}).get(h)
        if not isinstance(rec, dict) or not owner \
                or rec.get("owner") != owner or rec.get("spent") is True:
            integrity_log("wake", "release_not_applied")
            return False
        if rec.get("released"):
            return False
        if rec.get("btc_index") is not None and defer_btc:
            return "btc"
        if rec.get("btc_index") is not None:
            _stop_if_asked()
            _idx = rec.get("btc_index")
            _fresh = False
            if isinstance(key, dict) and key.get("btc_account_xpub") \
                    and isinstance(_idx, int) and not isinstance(_idx, bool) \
                    and _on_this_chain(rec, key):
                try:
                    _addr = _btc_address(key, _idx)
                    _fresh = (unused or (lambda a: _btc_unused_live(key, a))
                              )(_addr) is True
                except Exception:                            # noqa: BLE001
                    _fresh = False
            if not _fresh:
                integrity_log("wake", "release_btc_unconfirmed")
                return False
        rec["released"] = int(time.time()) // 600 * 600
        _save_handles(artifact_dir, led["handles"], led["owners"])
        integrity_log("wake", "deposit_released")
        return True
    except Exception:                                        # noqa: BLE001
        integrity_log("wake", "release_not_applied")
        return False


def _deposit_pending(rec: dict, key: dict, now: int, ask=None) -> bool:
    """Does this handle record still hold a place in the account reserve?

    Pending is: quoted (bundle and slip on record) and not paid out. A
    record like that is a mix still to come, and the reserve gate keeps
    room for it -- unless it is a GHOST: older than DEPOSIT_PLACE_TTL_S and
    with NOTHING on its address, locked or unlocked. Then it is a quote
    nobody paid, and it stops counting.

    FAILS TOWARD RESERVING. No `admitted` stamp (a record from before the
    stamp existed) is treated as old, so a stale unpaid one from then can
    let go too; but a pair the record cannot name, or a wallet that cannot
    be asked (`None` from _subaddress_total), keeps the place. Age alone
    never frees anything: only the address saying it holds nothing does.

    QUOTED MEANS THE SLIP FILE IS THERE, not that the record names one (the
    stage 4 read). The record is saved naming its slip's path before the
    quote runs (the intake saves it early, so the ledger follows the
    issued-index mark), and a machine that dies while the quote runs -- the
    deadman, the job budget, a power cut -- leaves that record on the disk:
    state_open keeps a member a dead run left, as newer than the seal. It
    named a slip that was never written, held a whole account reserve for
    two days, and closed the intake to the next client (at_capacity) about
    a deposit nobody was ever shown. The refused allocation and a person
    sitting down already clear the path; a kill cannot. The same test
    _reusable_receive makes: no slip file, nothing was published, and its
    bundle is the next deposit's.
    """
    if not (rec.get("bundle") and rec.get("slip")) or rec.get("spent") is True:
        return False
    try:
        if not Path(str(rec["slip"])).is_file():
            return False
    except Exception:                                        # noqa: BLE001
        # Could not tell: the place is kept, as for a wallet that cannot
        # be asked.
        return True
    _adm = rec.get("admitted")
    if not isinstance(_adm, int) or isinstance(_adm, bool):
        _adm = 0
    # ...UNLESS ITS DETAILS NEVER REACHED THE CHAT (`released`, see
    # _release_undelivered): then it is judged on the evidence at once,
    # as an old one is.
    if int(now) - _adm < proto.DEPOSIT_PLACE_TTL_S \
            and not rec.get("released"):
        return True
    # AN INTAKE DEPOSIT PAID ON THE BTC SIDE (the stage 4 read). Its client
    # paid the host's BTC address, not the XMR subaddress, and that stays
    # empty until the forward's swap lands -- hours after the forward, or
    # days while a fee spike holds it `delayed`. Asked about it alone, a
    # paid deposit read as a ghost after DEPOSIT_PLACE_TTL_S and gave its
    # place to the next client: two mixes to come against a reserve for one.
    # So the grace runs again from the LATEST SIGN OF THAT MONEY
    # (_paid_since: a forward that sent or rehearsed, one still in flight
    # or first found mined, a `delayed` answer), and after it the
    # subaddress decides as for any deposit -- where the swap's XMR sits
    # until the mix takes it.
    # NOT "a forward ran, so for ever" (the review of that fix): the XMR
    # that landed can leave without the record being marked spent -- a
    # withdrawal leg that failed after the mix moved it, the owner's next
    # leg spending from the mix accounts -- and the place was then held at
    # any age, which at the stock ceiling is the intake closed for good.
    _paid = _paid_since(rec)
    if _paid is not None and int(now) - _paid < proto.DEPOSIT_PLACE_TTL_S:
        return True
    # SETTLED ON THE BTC SIDE AND HELD BY TODAY'S FEE: pending at any age,
    # until a forward of it answers anything but `delayed` (see where the
    # mark is made). Not the stage 4 read's "a forward ran, so for ever":
    # that held a place after the money had LEFT; this one the forward has
    # just seen settled on this machine's address. A deposit whose money
    # was moved by hand meanwhile is let go by the next ask of it.
    # ...ON THIS PAIR'S CHAIN ONLY (the vault review): a forward of a record
    # issued on another BTC account is refused btc_chain_changed before any
    # child runs, so nothing would ever clear the mark -- a place held for
    # good, at the stock ceiling the intake closed. Such a record keeps the
    # two-day clock from its last sign, like any other.
    if rec.get("btc_index") is not None \
            and isinstance(rec.get("btc_delayed"), int) \
            and not isinstance(rec.get("btc_delayed"), bool) \
            and (not isinstance(key, dict) or _on_this_chain(rec, key)):
        return True
    _pair = _bundle_pair(rec)
    if _pair is None:
        return True
    _total = (ask or _subaddress_total)(key, _pair[0], _pair[1])
    return _total != 0


def _paid_since(rec: dict):
    """The latest sign of money on an intake deposit's BTC side (a 600 s
    bucket), or None: `btc_money_at` (every forward run that sent, found
    its plan's money in flight or first found it mined, or answered
    `delayed`) or,
    for a record from before it, `forwarded` (the first forward's bucket).
    None off the intake. Neither says an amount."""
    if rec.get("btc_index") is None:
        return None
    _ts = [v for v in (rec.get("btc_money_at"), rec.get("forwarded"))
           if isinstance(v, int) and not isinstance(v, bool) and v > 0]
    return max(_ts) if _ts else None


def _reusable_receive(key: dict, handles: dict, balance=None, owner=None):
    """(handle, bundle) of a receive address minted and never quoted, or None.

    THE SAME OWNER'S, OR NOBODY'S. The mint at step 0 records the account as
    the asking owner's before the quote runs (the argv needs the record), so
    a quote that fails leaves the account in THAT owner's set. Handing the
    bundle to the next deposit regardless of whose it was put one account in
    two owners' sets: the second owner's money landed on it and the first
    owner's withdrawal -- largest unlocked output among THEIR accounts --
    could spend it. A record that names a different owner is not reusable;
    one that names none (from before owners existed) is anyone's, as it
    always was.

    A DEPOSIT WHOSE QUOTE FAILED LEFT AN ACCOUNT BEHIND, FOREVER. Step 0
    mints a fresh wallet account and step 1 quotes the swap; when step 1
    fails -- the quote under the mix floor, Tor down, the provider gone --
    the record is saved with no slip, the phone hears "failed" with no
    label, and the NEXT /deposit mints ANOTHER account. Every retry burned
    one of a ceiling (45) that nothing on this disk can reset, and once it
    was reached every /deposit was refused "before it started", forever,
    with the reason kept on this machine.

    The address is unused: the quote is what publishes it, and the quote
    never ran. So it is the right address for the next deposit, and it is
    taken instead of minting. THREE THINGS MAKE IT SAFE: the record has no
    slip file (nothing was ever published for it), it is not marked spent,
    and the wallet says the subaddress holds nothing -- and "could not ask"
    counts as "holds something".
    """
    _ask = (lambda k, a, s: balance(k, a, s)) if balance else _subaddress_total
    for _h, _rec in handles.items():
        if _rec.get("spent") is True or not _rec.get("bundle"):
            continue
        if _rec.get("owner") and _rec.get("owner") != owner:
            continue
        _slip = _rec.get("slip")
        if _slip and Path(_slip).exists():
            continue
        if not Path(_rec["bundle"]).is_file():
            continue
        _pair = _bundle_pair(_rec)
        if _pair is None:
            continue
        if _ask(key, _pair[0], _pair[1]) == 0:
            return _h, _rec["bundle"]
    return None


def _handles_on_disk(d: Path) -> set:
    """Handles still named by a slip file in the artifact directory.

    The redraw loop below avoids the LEDGER's handles; the ledger keeps the
    newest MAX_HANDLES and drops the rest, while their slip files may still
    be on disk and their labels still on a phone. A handle drawn again after
    its record fell off names two deposits to one chat. The files are the
    other place the machine remembers, so they are asked too.
    """
    out = set()
    for _f in glob.glob(str(d / "thor_pairs_*.json")):
        out.add(Path(_f).name[len("thor_pairs_"):-len(".json")])
    return out


def _dispatch(job, params, key, artifact_dir, handle, runner, job_id,
              funded=None, reuse_balance=None, accounts=None,
              btc_unused=None) -> tuple:
    """Run the job's tools in order. Returns (code, status, handle)."""
    budget = proto.JOBS[job]["budget_s"]
    led = _load_ledger(artifact_dir)
    handles = led["handles"]
    # A MIX AN EARLIER WAKE DID NOT SEE THE END OF, SETTLED FIRST -- before
    # this job mints anything, so the difference is still that mix's.
    if _recover_pending_mixes(key, accounts, led):
        _save_handles(artifact_dir, handles, led["owners"])
    # ...AND WHEN IT CANNOT BE SETTLED, NOTHING THAT MINTS RUNS (the vault
    # review, rule 8). The recovery gives the marked owner every account the
    # wallet holds beyond the ones its mix started from. A wallet busy for a
    # few seconds left the mark standing and the job went on: a deposit
    # minted the next client's account, the next wake's recovery gave it to
    # the earlier owner, and that owner's withdrawal spent the other
    # client's deposit -- whose /check then said "moved". A retry of the
    # same owner's mix wrote a new mark over the old one, and the accounts
    # the first mix had moved their money onto belonged to nobody. Refused
    # here, before anything runs; a probe or a forward mints nothing and
    # goes on. Rests on the one-job-per-boot rule, not on anything secret.
    if job in _MINTING_JOBS and _pending_marks(led):
        integrity_log("wake", "mix_unsettled")
        raise Refused("mix_unsettled",
                      "an earlier mix's accounts are not recorded yet (the "
                      "wallet could not be asked), and this job would create "
                      "more: nothing was run and nothing was spent. Ask "
                      "again in a few minutes.")
    # WHOSE JOB. Off the validated note, never off a chat: the vault holds an
    # opaque token and a ledger of what that token's money created. Never
    # absent on the wire -- a hand-poked job carries HOST_OWNER (the
    # all-zero token), so the host's own deposits and mixes are one more
    # owner's, and a hand-poked withdrawal spends from THOSE accounts, not
    # from the wallet at large. Absent only on a direct call of this
    # function, where None means the whole wallet (the fee wallet, a test).
    _owner = params.get("owner") if isinstance(params, dict) else None

    # A HANDLE IS FOUR HEX CHARACTERS, SO COLLISIONS ARE NOT A CURIOSITY.
    # 65536 values: at ~300 recorded handles a repeat is more likely than not,
    # and this dict is keyed on the handle, so a repeat SILENTLY OVERWRITES
    # the record it lands on -- after which a `watch` on the older label
    # watches the newer job's address. Redraw instead.
    #
    # Four characters stays. The operator reads it aloud off a terminal;
    # widening it to fix a bookkeeping problem would be paying in the wrong
    # currency, and the fix costs nothing here.
    _taken = set(handles) | _handles_on_disk(artifact_dir)
    for _ in range(64):
        if handle not in _taken:
            break
        handle = proto.new_handle()
    else:
        raise Refused("handle_space",
                      "could not draw an unused handle in 64 tries, which "
                      "means this machine is holding most of the 65536 there "
                      "are. Run paranoia_mode: the handles file is one of the "
                      "things it wipes.")

    bundle = slip = None
    _spent_pair = None
    _btc_index = None
    _reconcile = False
    # EVERY JOB THAT NAMES A HANDLE RESOLVES IT HERE, and `withdraw` was
    # missing from this tuple while its argv template already interpolated
    # `bundle`. Driven: the composed command was
    # `--receive-wallet None`, i.e. a mix pointed at a bundle that does not
    # exist, on the one job that spends. It reached that state because the
    # argv template and the resolver are in different functions and only the
    # template was written for the new job -- the same producer/consumer seam
    # this repo has been caught by three times now.
    if job == "withdraw":
        # THE VAULT LOOKS. See _funded_entry: the machine holding the wallet is
        # the one that can see where the money is, and a chat message naming an
        # account index was the wrong box being asked.
        # `funded` is injectable like every other side effect here, so a test
        # can drive both the found and the empty case without a wallet. The
        # first version reached for `d`, which is _run_validated's parameter
        # and does not exist in this scope -- a NameError on the one job that
        # spends, caught immediately by driving it.
        # THIS OWNER'S ACCOUNTS AND NO OTHER'S. The candidate set is the
        # ledger's answer for the note's owner; an owner the ledger has never
        # seen has an empty set and is refused, never handed the wallet.
        _owned = _owner_accounts(led, _owner) if _owner else None
        _found = _funded_entry(key, injected=funded, owned_accounts=_owned)
        if not _found:
            raise Refused(
                "nothing_to_withdraw",
                "no unlocked balance is visible on this wallet, so there is "
                "nothing to mix. If a payment is still confirming it is not "
                "spendable yet; ask again once it has."
                if _owned is None else
                "nothing of this owner's is unlocked on this wallet: no "
                "arrival recorded for them has cleared. If a payment is still "
                "confirming it is not spendable yet; ask again once it has.")
        _fa, _fs, _fad, _famt = _found
        # ...AND IT HAS TO BE BIG ENOUGH TO MIX, WHICH NOTHING ASKED HERE.
        #
        # THE SAME FLOOR EXISTS ON THE OTHER SIDE OF THIS BOUNDARY AND NOT ON
        # THIS ONE. _phase_of applies exactly this test to decide whether to
        # report "more_left" and chain another leg, and its comment gives the
        # reason at length: an arrival too small to mix is "a wake spent to
        # fail at stage 0", costing "a magic packet, a boot, a 5-20 minute
        # jitter and one of twelve daily slots", coming back as
        # "withdraw: failed" with a hint about mixing depth that is not the
        # reason. Every word of that is true of the FIRST leg too, and the
        # first leg had no such check: _famt was unpacked here and thrown
        # away, so the only gate was `not _found`, which fires on a zero
        # balance and on nothing else.
        #
        # So a wallet holding a dust arrival -- above DUST_XMR, below the mix
        # minimum -- answered /withdraw by waking the machine, unlocking the
        # SPEND wallet, running GhostSpiral to stage 0 and failing there. The
        # unlocked spend wallet is the signature this whole design spends its
        # effort not producing, and it was produced for a run that could not
        # have worked.
        #
        # REFUSED BEFORE THE SPEND WALLET IS TOUCHED, not before the wake: the
        # wake has already happened by the time this runs, and it must -- the
        # pager has never been told a balance and must not be (see
        # /settings, which refuses to fetch one). What this saves is the
        # unlock, the run, and an operator being told the wrong reason.
        #
        # THE SAME FLOOR, SPELLED THE SAME WAY, so the two sides cannot drift:
        # live_min_out_xmr(key) and Decimal(10 ** 12), which is how
        # GhostSpiral itself converts atomic units.
        _fxmr = Decimal(str(_famt)) / Decimal(10 ** 12)
        if _fxmr < Decimal(live_min_out_xmr(key)):
            integrity_log("wake", "withdraw_below_mix_minimum")
            raise Refused(
                "below_mix_minimum",
                "what is here is too small to mix. It is not lost and "
                "nothing was spent — a mix has a floor, and one arrival on "
                "its own is under it. Send more in and withdraw once, or "
                "take it out by hand at the machine.")
        # ...AND BIG ENOUGH FOR THE DEPTH ASKED FOR, not only the shallowest
        # (the review of the uncovered dimensions). The floor above is the
        # three-wallet one -- the deposit gate's, and the "more left"
        # chain's, where no depth is known yet -- and a twenty-hop
        # withdrawal of an arrival between the two floors passed it,
        # unlocked the spend wallet, and ran GhostSpiral, which minted one
        # account per output plus its decoys -- some twenty-five -- before
        # finding the amount too small to fan out. Nobody owns those
        # accounts, they count against the ceiling every client's deposit
        # is refused at, and each retry at the same depth added as many
        # again. The depth is in the note; its floor is asked here, where
        # refusing still costs nothing.
        _wd = withdraw_wallets(params["depth"])
        if _wd != _MIN_OUT_WALLETS \
                and _fxmr < Decimal(live_floor_xmr(key, _wd)):
            integrity_log("wake", "withdraw_below_depth_minimum")
            raise Refused(
                "below_depth_minimum",
                "what is here is enough to mix, but not at the depth asked "
                "for: more hops need more to split. Nothing was spent. Ask "
                "again with fewer hops, or send more in first.")
        # THE WALLET'S ACCOUNTS BEFORE THE MIX, read BEFORE anything is
        # written or unlocked. Every account the mix adds is this owner's
        # money at work (see _account_indices); the difference is recorded
        # after the run so the next leg chases the owner's own change and the
        # ledger's answer stays whole. UNREADABLE IS A REFUSAL (the review of
        # the uncovered dimensions): read as None and passed over, the mix
        # ran, and everything it minted -- the owner's change among it --
        # was never recorded as theirs, with no line anywhere saying so.
        # Here refusing still costs nothing.
        _accts_before = (_read_accounts_patiently(key, accounts)
                         if _owner else None)
        if _owner and _accts_before is None:
            integrity_log("wake", "owner_accounts_unreadable")
            raise Refused(
                "owner_accounts_unreadable",
                "the wallet could not say which accounts it holds, so a mix "
                "now could not record what it creates as this owner's. "
                "Nothing was spent; ask again in a few minutes.")
        # ...AND IT MUST LIST EVERY ACCOUNT THE LEDGER GAVE AN OWNER (the
        # vault review, rule 8). A list that went backwards -- a wallet file
        # restored from a backup, a power cut before it was stored --
        # re-mints those accounts during the mix, and "the accounts now less
        # the accounts before" then gives another owner's accounts to this
        # one. Refused here, before the mix, where it costs nothing.
        _owned_all = {i for r in (led.get("owners") or {}).values()
                      if isinstance(r, dict) for i in (r.get("accounts")
                                                       or [])}
        if _owner and _owned_all - set(_accts_before):
            integrity_log("wake", "wallet_accounts_behind")
            raise Refused(
                "wallet_accounts_behind",
                "the wallet does not list accounts this machine has recorded "
                "as holding clients' money -- its account list has gone "
                "backwards. A mix now would create accounts that are already "
                "someone's. Nothing was spent; check the wallet at the "
                "machine.")
        # ...AND WRITTEN DOWN BEFORE THE MIX STARTS (the review of this
        # pass): held only in memory, it died with a power cut, an OOM kill
        # or the SIGKILL that follows a stop, and what the mix had minted
        # then held this owner's money with no owner in the ledger. On the
        # ledger, sealed with it, the next wake settles it
        # (_recover_pending_mixes) whatever ended this one.
        if _owner:
            _mark_pending_mix(led, _owner, _accts_before)
            _save_handles(artifact_dir, handles, led["owners"])
        # A BUNDLE IS WRITTEN, and it is the same 0600 file in the same swept
        # directory every other job's bundle already lives in -- not a new
        # class of artifact. GhostSpiral's receive mode reads a
        # gs_receive_wallet_v1 pointer and nothing else, so this is the format
        # the boundary takes; inventing a second way in would mean two parsers
        # for the thing that says where money is.
        #
        # NOT create_receive_wallet. That mints a NEW subaddress, which is
        # exactly what a withdrawal must not do: the money is already
        # somewhere, and minting somewhere else to point at it would be a
        # second account for the wipe to miss and a second address for nothing.
        # NAMED wallet_* SO THE WIPE ACTUALLY TAKES IT. The first version
        # called this gs_withdraw_<handle>.json, which matches NOTHING in
        # gs_common.GS_ARTIFACT_FILE_PATTERNS -- driven with fnmatch against
        # the real list. It would have sat in the artifact directory naming an
        # account and a subaddress of this wallet, through every paranoia_mode
        # run, on the machine that is supposed to keep nothing.
        #
        # wallet_*.json is the pattern receive bundles already match, and this
        # IS a receive bundle: same schema, same directory, same 0600. A new
        # name would have meant a new pattern, and a pattern nobody added.
        bundle = str(artifact_dir / f"wallet_withdraw_{handle}.json")
        atomic_write_json({"schema": "gs_receive_wallet_v1",
                           "address": _fad,
                           "account_index": int(_fa),
                           "subaddress_index": int(_fs),
                           "rpc_endpoint": key.get("rpc_primary", "")},
                          Path(bundle), perms=0o600)
        # REMEMBERED FOR THE LEDGER, written there only if the run reports
        # done -- see the end of this function. A failed run has moved
        # nothing it can be sure of, and a handle marked spent about money
        # still sitting there is the lie in the other direction.
        _spent_pair = (int(_fa), int(_fs))
    elif job == "forward_to_swap":
        # THE DEPOSIT THIS HANDLE NAMES: its bundle is the swap's XMR
        # destination, its btc_index the address the client paid. Both from
        # the ledger, never from the note. The owner wall is the same wall
        # the watching jobs have; a handle another owner minted is refused
        # here even if a forged note carried it.
        rec = handles.get(params["handle"])
        if not rec:
            raise Refused("unknown_handle",
                          f"no deposit on this machine for handle "
                          f"{params['handle']}.")
        # THE HOST MAY FORWARD ANY DEPOSIT; A CLIENT ONLY THEIR OWN. The
        # forward is the host's act on the host's own key, and its reply
        # reveals nothing but a status and a handle -- so a hand-poked note
        # (which carries HOST_OWNER) may forward a record a client minted.
        # Without this, every deposit a pager minted was refused on the one
        # machine that holds the key, and the job existed for nothing.
        # A CLIENT'S token is still walled to their own records.
        if _owner and _owner != proto.HOST_OWNER and rec.get("owner") \
                and rec.get("owner") != _owner:
            integrity_log("wake", "forward_not_owner")
            raise Refused("handle_not_yours",
                          f"handle {params['handle']} was recorded for a "
                          f"different owner.")
        # PAID OUT IS THE XMR SIDE'S WORD, NOT THE ADDRESS'S (the MED pass
        # after the deep read). `spent` says the record's subaddress was
        # withdrawn. On a record quoted for the client to pay ThorChain
        # directly that is the end of it. On an intake record the deposit
        # address is the host's own, and money can reach it AFTER the
        # withdrawal: the refund of a streaming swap that filled part of
        # the way and paid out (the part that did swap was withdrawn, the
        # rest comes back later), or a client paying the address they
        # were shown once more. Both need the reconciliation the forward
        # runs, which this refusal denied for ever -- and the plan chain
        # it reconciles by, which _retire_files keeps for such a record.
        if rec.get("spent") is True and rec.get("btc_index") is None:
            raise Refused("already_moved",
                          f"handle {params['handle']} has already been paid "
                          "out; there is nothing left to forward.")
        # ONCE SENT, NEVER AGAIN. A forward that was handed to the network
        # (or may have been: `forward_sent` covers the ambiguous outcome
        # too) has moved the money; a second run would re-quote the same
        # destination for an address that is empty, or -- if the first
        # send never propagated -- sign a CONFLICTING spend of the same
        # outputs. Stage 5 owns re-sending the same signed bytes.
        # THE PLAN ON DISK IS CONSULTED TOO, not the ledger alone: a crash
        # between the child's exit and the ledger mark would leave a plan
        # saying "accepted" beside a record saying nothing, and the next
        # wake would sign a CONFLICTING spend of outputs already in flight.
        # The file the sending run wrote is the record of what it did.
        _sent_before = (rec.get("forward_sent")
                        or _forward_outcome(artifact_dir, params["handle"])[0])
        if _sent_before:
            # ...AND RECONCILED, NOT REFUSED (STAGE5_PLAN.md 3.1). The wake
            # that reaches here is the client tapping "has it arrived?"
            # AFTER the forward went out (the Pi routes every ask about an
            # intake deposit to this job). Stage 4 answered it from the
            # plan; stage 5 runs the forwarder in --reconcile mode, which
            # asks the network what became of the forward and acts: it
            # confirms it is listed, re-sends kept bytes, re-signs an
            # evicted one, forwards money that came back, or FAILS on a
            # spend that is not ours. The invariant is one signature per
            # OUTPOINT while a spend of it may be in the network, kept by
            # the forwarder from its plan chain -- and there only: the
            # ledger's copy (`forward_inputs`) was read by nothing and named
            # the client's transactions, and the host-privacy pass took it
            # off (see the mark below). A reconciliation may SEND, so a
            # pair whose sending switch was turned off since is refused
            # here rather than handed a mode it may not run.
            if not _btc_broadcast_on(key):
                integrity_log("wake", "forward_repeat")
                raise Refused("forward_not_sending",
                              f"a forward of handle {params['handle']} went "
                              "out and this pair no longer sends "
                              "(allow_btc_broadcast is off), so what became "
                              "of it cannot be reconciled from here. Re-pair "
                              "to send, or read the plan at the machine.")
            integrity_log("wake", "forward_reconcile")
            _reconcile = True
        # A REHEARSAL MAY BE FOLLOWED BY THE REAL THING, and by nothing
        # else. A done dry run marks its record (a time bucket, no amount,
        # no txid); a second DRY RUN is refused rather than re-quoting the
        # same destination on a fresh circuit and silently overwriting the
        # plan the job log describes. A --broadcast run supersedes the
        # rehearsal: it quotes and signs afresh and overwrites the plan
        # with the one that was sent.
        if rec.get("forwarded") and not _btc_broadcast_on(key):
            integrity_log("wake", "forward_repeat")
            raise Refused("already_forwarded",
                          f"handle {params['handle']} already has a forward "
                          "planned on this machine; only a sending run may "
                          "follow a rehearsal.")
        bundle = rec.get("bundle")
        if not bundle:
            raise Refused("handle_not_forwardable",
                          f"handle {params['handle']} names no single "
                          "receive bundle, so it has no swap destination.")
        _btc_index = rec.get("btc_index")
        if _btc_index is None:
            raise Refused("no_btc_deposit",
                          f"handle {params['handle']} has no BTC deposit "
                          "address recorded (it was quoted for the client to "
                          "pay ThorChain directly), so there is nothing on "
                          "this machine's key to forward.")
        # ISSUED ON ANOTHER ACCOUNT OF THE SEED (see _on_this_chain): this
        # pair derives a different address for that index, and a forward
        # run on it looks at an address nobody paid -- "not yet" for ever,
        # while the client's money sits where they paid it. Refused before
        # anything runs, with the way out.
        if not _on_this_chain(rec, key):
            integrity_log("wake", "btc_chain_changed")
            raise Refused("btc_chain_changed",
                          f"handle {params['handle']}'s deposit address was "
                          "issued on another account of the seed than the one "
                          "this pair names (a re-pair with a different "
                          "--btc-account or xpub since). The money on it is "
                          "the seed's still; this pair cannot find it. Nothing "
                          "was run. Re-pair with the account it was issued "
                          "on to forward it, or move it by hand.")
        # A PAID-OUT INTAKE RECORD WHOSE BUNDLE AN EARLIER BUILD SHREDDED
        # (the stage 5 read kept it from 2ead043 on; records paid out before
        # that have none). The forwarder reads the swap's destination from
        # it before anything else, so every later return to the host's
        # address was refused bad_bundle for ever. Rebuilt here from what
        # the vault still holds, and only if the WALLET agrees -- see
        # _rebuild_retired_bundle.
        if rec.get("spent") is True and not Path(str(bundle)).is_file():
            bundle = _rebuild_retired_bundle(key, artifact_dir,
                                             params["handle"], rec)
        # THE DEPOSIT'S OWN LABEL, not the fresh one drawn above: the plan
        # file is named for the deposit it forwards, and the reply names the
        # handle the operator asked about (as the watching jobs do).
        handle = params["handle"]
    elif job in ("watch", "swap_status"):
        rec = handles.get(params["handle"])
        if not rec:
            raise Refused("unknown_handle",
                          f"no bundle on this machine for handle "
                          f"{params['handle']}.")
        # NOT YOURS, REFUSED HERE TOO. The pager binds a label to a chat with
        # its own MAC; this is the second wall, on the machine that holds the
        # money, so a label that reached the wire anyway -- a guessed tag, a
        # forged note from a stolen card -- cannot surface another owner's
        # arrival. A record from before owners existed carries none and is
        # answered as before.
        if _owner and rec.get("owner") and rec.get("owner") != _owner:
            integrity_log("wake", "watch_not_owner")
            raise Refused("handle_not_yours",
                          f"handle {params['handle']} was recorded for a "
                          f"different owner.")
        # PAID AND SENT ON, ANSWERED FROM THE LEDGER. A watcher on an
        # address that was paid and then emptied by a withdrawal sees a
        # zero balance and times out into "nothing on the address yet.
        # Normal -- ask again in a while", with an ask-again button under
        # it: a wake spent to tell the client their money never came,
        # about money that came and was sent to them, and an invitation
        # to spend the next wake hearing it again. The handle had no state
        # after "landed". It has one now, and the answer costs no child.
        if rec.get("spent") is True:
            atomic_write_json({"state": "moved"},
                              artifact_dir / STATUS_FILE, perms=0o600)
            integrity_log("wake", "watch_spent_handle")
            return "done", "done", handle
        bundle, slip = rec.get("bundle"), rec.get("slip")
        # ONE HANDLE, ONE ADDRESS. A job that wrote several bundles could
        # not have its handle name one of them without picking arbitrarily,
        # so it names none and this refuses.
        if not bundle:
            raise Refused(
                "handle_not_watchable",
                f"handle {params['handle']} covers "
                f"{rec.get('minted', 'several')} receive bundles, so it does "
                f"not name ONE address to watch. Watch the address you mean "
                f"from this machine, or quote it with receive_and_quote.")
        # A WATCH WITH NO QUOTE IS NOT A WATCH. The first version passed
        # str(slip) here, so a handle with no quote behind it -- which never
        # writes a slip -- reached receive_watch as the literal path "None".
        # load_pairs then exited on a missing file and the doorbell was told
        # "failed", which is true and useless: a wake and a boot spent to
        # learn that a string was not a filename.
        #
        # There is no --any fallback here, deliberately. --any stops on ANY
        # balance, so one piconero of dust from anyone who has the address
        # would report "done" to the doorbell -- telling the operator over the
        # pager that their money landed when what landed was a probe.
        if not slip:
            raise Refused(
                "no_quote",
                f"handle {params['handle']} names a receive bundle with no "
                f"swap quote, so there is no expected amount to watch for. "
                f"Only a receive_and_quote handle can be watched.")

    # DELETE LAST TIME'S ANSWER BEFORE ASKING AGAIN.
    #
    # Nothing else removes this file, and _phase_of reads whatever is there.
    # So a probe whose child dies before writing -- an RPC that will not
    # answer, a SIGKILL past the budget, a wallet that never opens -- reported
    # the PREVIOUS probe's outcome as this one's. The failure mode is the worst
    # available: last week's answer was "funded", so the operator is told
    # "landed and spendable, the swap is done" about money that never arrived,
    # and the one thing they would do next is stop watching for it.
    #
    # It also decides the branch below: that branch treats "the file exists" as
    # proof the probe answered, which a stale file satisfies for free.
    #
    # Missing is already handled correctly everywhere -- _phase_of returns ""
    # and the pager says the probe told us nothing -- so removing it first
    # makes "no answer" the honest default rather than a lie inherited from a
    # previous run.
    # BOTH WATCHING JOBS. `watch` writes this file now too (see build_argv),
    # so leaving it uncleared would let a 110-minute wait report the answer a
    # three-minute probe left behind hours earlier -- the exact stale-file lie
    # this unlink was added to stop, through the door the new job opened.
    if job in ("swap_status", "watch"):
        try:
            (artifact_dir / STATUS_FILE).unlink()
        except FileNotFoundError:
            pass
        except OSError as e:
            # Cannot clear it, so cannot trust it. Refuse rather than risk
            # reporting a stale "landed".
            raise Refused(
                "status_file_stuck",
                f"could not clear the previous status answer "
                f"({e.strerror}). Refusing to run a probe that might report "
                f"the last one's result.")
    # THE FORWARD'S OWN ONE-WORD ANSWER, TOO (the MED pass after the deep
    # read). btc_forwarder writes btc_forward_<h>.status.json when it finds
    # nothing settled, and this end removes it after the one read that
    # needs it -- unless the agent died between the child's write and that
    # read (the deadman, a power cut, a timeout during the result post),
    # when the stale word made a LATER refusal that wrote no word of its
    # own (inbound_mismatch, a rejected broadcast) read as done and
    # `not_yet`: a failed forward reported as money not yet there.
    if job == "forward_to_swap" and handle:
        try:
            _forward_status_path(artifact_dir, handle).unlink()
        except FileNotFoundError:
            pass
        except OSError as e:
            raise Refused(
                "status_file_stuck",
                f"could not clear the previous forward's status answer "
                f"({e.strerror}). Refusing to run a forward that might "
                f"report the last one's word.")

    # ASKED ONCE, USED TWICE. The flag and the drawn address must agree --
    # --usage-fee with no GS_USAGE_FEE_ADDRESS is the configuration that mints
    # the cut onto the mixing wallet -- so the same list feeds both, and the
    # wallet is asked a single time rather than once per consultation.
    _owned_fee = (wallet_owned_fee_addresses(key)
                  if job == "withdraw" else [])
    # ON THE INTAKE, THE SEED IS PROVEN BEFORE ANYTHING IS MINTED OR
    # PUBLISHED (see _prove_btc_seed): a deposit address this machine could
    # never sign for is not one to hand a client, and the refusal costs no
    # child -- no XMR subaddress minted, no quote, no address asked about.
    if job == "receive_and_quote" and btc_mode(key):
        # ...AND THAT THE FORWARD COULD EVER SEND WHAT LANDS THERE: an
        # OP_RETURN policy no swap memo fits is refused here, before an
        # address exists, for the same reason the seed is proven here.
        _check_btc_policy(key)
        _prove_btc_seed(key)
    steps = build_argv(job, params, key, artifact_dir, bundle=bundle,
                       slip=slip, handle=handle, owned_fee=_owned_fee,
                       btc_index=_btc_index, reconcile=_reconcile)

    # AN ADDRESS MINTED FOR A DEPOSIT THAT NEVER GOT ITS QUOTE IS THE NEXT
    # DEPOSIT'S ADDRESS. See _reusable_receive; decided before the loop so
    # step 0 (the mint) can be skipped whole.
    _reuse = (_reusable_receive(key, handles, balance=reuse_balance,
                                owner=_owner)
              if job == "receive_and_quote" else None)
    # ...AND ITS DEPOSIT INDEX WITH IT (self-doubt over the issued-index
    # mark): the reused record may carry an index that was ISSUED (the
    # mark counts it) and never published (no slip). Popping the record
    # dropped the index from the ledger's knowledge, and a ledger that
    # knew only that record then contradicted the mark: ledger_wiped, for
    # the deposit right after a failed one. The index is handed to the
    # allocator, which reissues it once the network says it is still
    # fresh -- never a hole in the chain, never a mark ahead of nothing.
    _reuse_idx = None
    before = set(glob.glob(str(artifact_dir / "wallet_*.json")))
    _fw_run = ""
    # WHETHER THE FORWARD ON RECORD WAS ALREADY IN A BLOCK BEFORE THIS RUN
    # (read off the plan the last run left): a run that finds it mined for
    # the first time is the last one that holds the deposit's place from
    # the BTC side (see the forward mark below).
    _mined_before = (job == "forward_to_swap" and bool(handle)
                     and _forward_mined(artifact_dir, handle))
    for i, argv in enumerate(steps):
        # BETWEEN STEPS, BEFORE THE WORK THAT PREPARES THE NEXT ONE (the
        # review of the uncovered dimensions). run_child refuses to spawn once
        # a stop is asked -- but the intake's address lookups over Tor and
        # its mark write ran first, past the SIGKILL.
        _stop_if_asked()
        env_extra = {}
        if job == "receive_and_quote" and i == 0 and _reuse:
            continue
        if job == "receive_and_quote" and i == 1:
            if _reuse:
                _old_h, _old_b = _reuse
                new = [_old_b]
                # THE OLD RECORD GOES. Its handle was reported to a phone
                # that dropped it (a failed deposit carries no label), and
                # two handles naming one address is the collision the
                # redraw loop exists to prevent.
                _old_rec = handles.pop(_old_h, None) or {}
                _reuse_idx = _old_rec.get("btc_index")
                if isinstance(_reuse_idx, bool) \
                        or not isinstance(_reuse_idx, int) \
                        or not _on_this_chain(_old_rec, key):
                    _reuse_idx = None
                integrity_log("wake", "receive_bundle_reused")
            else:
                # Identify the new bundle by a DIRECTORY DIFF, not by
                # parsing stdout: a tool's human-facing output is not an
                # interface, and a wrong bundle here would quote a swap to
                # the wrong address.
                new = sorted(set(glob.glob(str(artifact_dir
                                               / "wallet_*.json")))
                             - before)
                if len(new) != 1:
                    raise Refused("bundle_ambiguous",
                                  f"expected exactly one new receive "
                                  f"bundle, found {len(new)}. Refusing "
                                  f"to quote a swap without knowing "
                                  f"which address it pays.")
                # ...AND IT MUST BE AN ADDRESS THIS LEDGER HAS NEVER SEEN.
                # create_receive_wallet checks for a repeated answer only
                # within one run. A wallet whose account list rolled back
                # (a file restored from a backup, a power cut before it
                # was stored) mints the same account and subaddress again,
                # and two deposits then quote one address: one client's
                # watch confirms on the other's arrival, and the two are
                # later spent as one pile, linked on-chain. Refused before
                # the quote, so nothing is published for it.
                _np = _bundle_pair({"bundle": new[0]})
                # ...AND ITS ACCOUNT MUST BE NO OWNER'S YET (the vault
                # review, rule 8). The check above compares deposit
                # records' address pairs, and a mix mints up to twenty-nine
                # accounts to a deposit's one: a list that went backwards
                # re-mints a MIX's account far more often than a deposit's,
                # and handed it to the next client beside the owner whose
                # mix made it -- whose withdrawal could then spend this
                # deposit. A fresh mint is a fresh account; one an owner
                # already holds is the wallet going backwards.
                _held_by = _account_owners(led, _np[0]) \
                    if _np is not None else set()
                if _np is not None and (_held_by or any(
                        _bundle_pair(_r) == _np for _r in handles.values()
                        if _r.get("bundle"))):
                    integrity_log("wake", "receive_bundle_duplicate")
                    raise Refused(
                        "bundle_reused",
                        "the wallet handed out an address it had already "
                        "handed out for an earlier deposit, which means "
                        "its account list has gone backwards. Nothing was "
                        "published. Check the wallet at the machine before "
                        "taking another deposit.")
            argv[argv.index("--dest-from-receive-wallet") + 1] = new[0]
            # THE AMOUNT, AS A DECIMAL BTC STRING, IN THE ENVIRONMENT.
            # thor_swap_preparer reads GS_SWAP_AMOUNTS through env_or_argv and
            # prefers it over argv for the reason gs_common.env_or_argv's
            # docstring records: /proc/<pid>/cmdline is 0444.
            #
            # sat_to_btc and not str(): the wire carries an exact integer
            # count of satoshis precisely so that no float or locale ever
            # touches this number, and str() on that int would hand the
            # preparer a satoshi count where it expects bitcoin -- a hundred
            # million times the intended swap, quoted without complaint.
            env_extra["GS_SWAP_AMOUNTS"] = proto.sat_to_btc(
                params["amount_sat"])
            # ...AND THE AGGREGATOR'S KEY, IF THIS MACHINE HAS ONE (the review
            # of the uncovered dimensions). This step IS the quote; run_child
            # strips every GS_ variable and only the forward below was handed
            # it, so on a keyed SwapKit every deposit was refused at its
            # quote while the forwards that never came would have worked.
            if secret_of("GS_SWAPKIT_API_KEY"):
                env_extra["GS_SWAPKIT_API_KEY"] = \
                    secret_of("GS_SWAPKIT_API_KEY")
            # `admitted` IS A TEN-MINUTE BUCKET, like every stamp on this
            # disk, and it is what lets an unpaid deposit stop holding a
            # place (DEPOSIT_PLACE_TTL_S): the reserve gate reads it beside
            # the address's balance. Not a second, not the kind of job.
            handles[handle] = {"bundle": new[0], "minted": 1,
                               "admitted": int(time.time()) // 600 * 600,
                               "slip": str(artifact_dir /
                                           f"thor_pairs_{handle}.json")}
            # RECORDED AS THE OWNER'S, address and account both. The account
            # is what a withdrawal for this owner may later spend from; a
            # reused bundle (see _reusable_receive) belongs to whoever is
            # quoting it now, which is what this line says.
            if _owner:
                handles[handle]["owner"] = _owner
                _np = _bundle_pair({"bundle": new[0]})
                if _np is not None:
                    _add_owner_accounts(led, _owner, {_np[0]})
            # THE BTC DEPOSIT ADDRESS, on the intake: an index under this
            # machine's account xpub, recorded on the handle beside the XMR
            # bundle so the forward can find both. Allocated only once the
            # network has said the address is fresh (see
            # _allocate_btc_index); a refusal here leaves the record
            # WITHOUT a slip, so its bundle is the next deposit's
            # (_reusable_receive), and nothing was published.
            if btc_mode(key):
                try:
                    handles[handle]["btc_index"] = _allocate_btc_index(
                        key, handles, unused=btc_unused, prefer=_reuse_idx)
                    # ...AND WHICH ACCOUNT'S INDEX IT IS (_on_this_chain).
                    handles[handle]["btc_chain"] = _xpub_id(key)
                    # THE LEDGER FOLLOWS THE MARK AT ONCE (self-doubt over
                    # the fix pass): the record used to be saved only
                    # after the quote child ran, so a machine that died
                    # in between (the deadman, a timeout, a power cut)
                    # left a mark one ahead of an empty ledger, and the
                    # next deposit was refused ledger_wiped for a wipe
                    # that never happened. The mark and the ledger now
                    # diverge only inside one write.
                    _save_handles(artifact_dir, handles, led["owners"])
                except Refused:
                    # ...AND THE SLIP PATH GOES WITH IT (fix pass after the
                    # deep read): the record was saved naming a slip file
                    # that was never written, and _deposit_pending tests
                    # the FIELD, so a deposit nobody was ever shown held a
                    # whole account reserve for two days and closed the
                    # intake to the next client (at_capacity).
                    handles[handle]["slip"] = None
                    _save_handles(artifact_dir, handles, led["owners"])
                    raise
        if job == "forward_to_swap":
            # THE SEED, IN THE ENVIRONMENT OF THIS ONE STEP, NEVER ON THE
            # ARGV AND NEVER IN THE KEYFILE -- the wallet password's rule,
            # for the same reasons. Absent means refused, before the child
            # starts: a forward that cannot sign should not spend a look.
            if not has_secret("GS_BTC_SEED"):
                integrity_log("wake", "btc_seed_unset")
                raise Refused(
                    "btc_seed_unset",
                    "the machine has no BTC seed configured, so the forward "
                    f"cannot sign. Nothing was spent. Set GS_BTC_SEED"
                    f"{_set_in()}, at the machine."
                    + _reseal_hint("GS_BTC_SEED"))
            env_extra["GS_BTC_SEED"] = secret_of("GS_BTC_SEED")
            if has_secret("GS_BTC_SEED_PASSPHRASE"):
                env_extra["GS_BTC_SEED_PASSPHRASE"] = \
                    secret_of("GS_BTC_SEED_PASSPHRASE")
            # THE XPUB AND THE INDEX, off the argv for the reasons build_argv
            # gives; and the aggregator's API key, if this machine has one,
            # so a keyed SwapKit does not refuse every quote (run_child strips
            # every GS_ variable, so nothing reaches a child unless handed
            # here).
            env_extra["GS_BTC_XPUB"] = str(key["btc_account_xpub"])
            env_extra["GS_BTC_INDEX"] = str(int(_btc_index))
            # ...AND WHICH ACCOUNT OF THE SEED THE XPUB IS (STAGE5_PLAN.md
            # 3.5): absent from a keyfile written before the field existed
            # means 0, which it was; present and wrong is refused, never
            # coerced, like every other intake setting.
            env_extra["GS_BTC_ACCOUNT"] = str(
                _btc_setting(key, "btc_account", 0, 0, 2 ** 31 - 1))
            if secret_of("GS_SWAPKIT_API_KEY"):
                env_extra["GS_SWAPKIT_API_KEY"] = \
                    secret_of("GS_SWAPKIT_API_KEY")
        if job == "withdraw":
            # THE DESTINATION, IN THE ENVIRONMENT, NEVER ON THE ARGV.
            # GhostSpiral reads GS_EXIT_TO through env_or_argv and prefers it
            # for exactly this reason. Re-validated one last time against the
            # protocol's own gate: this value came off a chat, through a
            # doorbell, out of a sealed record, and this is the last place that
            # can refuse it before it reaches a process that spends.
            # SPACE-SEPARATED, BECAUSE THE VARIABLE HOLDS A LIST.
            #
            # resolve_exit_destinations splits GS_EXIT_TO on r"[\s{,}]+" and
            # its own docstring gives the form: GS_EXIT_TO="addr1 addr2". One
            # address joins to itself, so the single-destination case is
            # byte-identical to what this sent before.
            #
            # This is what the schema change is FOR. The exit relays one
            # transaction per output -- at fewest 5, 12 or 22 of them at the
            # three depths -- and every one used to land on the same address,
            # because the wire had room for exactly one and nothing here could
            # have used a second. resolve_exit_destinations warns about that
            # in as many words, onto a stdout this unit diverts to a 0600 log
            # on a machine that powers off. Nobody has ever read it.
            _dests = proto.JOBS["withdraw"]["schema"]["exit_to"](
                params["exit_to"])
            env_extra["GS_EXIT_TO"] = " ".join(_dests)
            # THE SPEND PASSWORD, TO THIS CHILD AND NO OTHER.
            #
            # run_child strips every GS_ variable from the inherited
            # environment, so the unit may hold GS_WALLET_PASSWORD without
            # handing it to thor_swap_preparer or create_receive_wallet. This
            # is the one step that needs it, and it is put back only here.
            #
            # An EMPTY password is a legitimate configuration -- a wallet
            # with no password -- so an empty value is passed through as
            # meant. What must not happen is passing nothing when the operator
            # meant to pass something.
            #
            # "THE PREFLIGHT REFUSAL ABOVE IS WHERE THAT IS CAUGHT" WAS FALSE.
            # That is what this comment said, and preflight() never looks at
            # the environment at all: it checks the inhibit file, the scope
            # lock, the deadman unit, removable devices, resources, wipe
            # coverage, the directory mode and Tor. Grepping the whole
            # function for os.environ returns nothing. So the case the
            # sentence promised was handled was handled nowhere, and the
            # failure it produces is the one this file keeps fixing: the wake
            # is spent, the box boots, GhostSpiral opens the wallet with ""
            # (resolve_wallet_password takes an empty value as "no password"
            # and accepts it), monero-wallet-rpc refuses, and the chat says
            # "withdraw: failed" with no reason in it.
            #
            # AND THE TWO CASES ARE DISTINGUISHABLE, which is what made the
            # old sentence give up too early. os.environ.get(k, "") collapses
            # them; `k in os.environ` does not. A passwordless wallet is
            # declared by SETTING the variable to empty, which is a thing an
            # operator does on purpose; an absent variable is a thing they
            # forgot. Only the second is refused, and the message says which
            # to type.
            #
            # BEFORE THE WALLET IS OPENED, which is the only place a refusal
            # is free. The wake has already been spent by the time this runs
            # -- the pager cannot know this and must not be told the wallet's
            # configuration -- but nothing has been unlocked and nothing has
            # moved.
            if not has_secret("GS_WALLET_PASSWORD"):
                integrity_log("wake", "wallet_password_unset")
                raise Refused(
                    "wallet_password_unset",
                    "the machine has no spend password configured, so the "
                    "wallet cannot be opened. Nothing was spent. Set it at "
                    "the machine — and if the wallet genuinely has no "
                    "password, set it to an empty value so that choice is "
                    "on the record rather than assumed."
                    + _reseal_hint("GS_WALLET_PASSWORD"))
            env_extra["GS_WALLET_PASSWORD"] = secret_of("GS_WALLET_PASSWORD")
            # THE OPERATOR'S CUT, WHICH THIS PATH WAS NOT TAKING AT ALL.
            #
            # --usage-fee is action="store_true" and defaults OFF ("a run that
            # has not been asked to skim must not skim"), and nothing here ever
            # asked. gs_console sets GS_USAGE_FEE_ADDRESS on its own runs, so
            # the desktop path skimmed and the PHONE path -- the one this whole
            # feature exists for -- silently did not. Every withdrawal started
            # from a chat kept 100% and put 0% aside, for as long as the job
            # has existed.
            #
            # NO ADDRESS MEANS NO CUT. With --usage-fee and no address
            # GhostSpiral WAIVES the fee (it used to mint a fresh account on
            # the mixing wallet, which the next withdrawal then spent), so the
            # address is what makes a woken withdrawal take a fee at all. It
            # comes from this machine's own keyfile.
            #
            # ON THE ARGV, DELIBERATELY, because it is a boolean that carries
            # no value: `ps` learns that this run skims, which is public in
            # this repository's source anyway. The ADDRESS is the part that
            # would identify the operator, and that goes in the environment
            # like every other secret here -- GhostSpiral's own flag help says
            # to prefer GS_USAGE_FEE_ADDRESS for exactly this reason.
            # DRAWN, NOT READ. The keyfile may name several; picking one per
            # run is the whole reason it may. See fee_addresses.
            # ...AND ADDRESSES THIS WALLET ALREADY OWNS, for the same
            # reason: GhostSpiral waives the cut on those, once per
            # withdrawal, into a log that is wiped. Asked here instead, on the
            # machine that has the wallet, so the draw can simply pick one of
            # the others. See wallet_owned_fee_addresses.
            _fee_addr = pick_fee_address(
                key, exclude=list(_dests) + list(_owned_fee))
            if _fee_addr:
                # VALIDATED HERE TOO. It came off this machine's keyfile rather
                # than off the wire, so it is not attacker-controlled -- but a
                # typo in a paired address is a cut sent somewhere nobody can
                # spend it, discovered after the mix has already run.
                #
                # proto.xmr_address, NOT the withdraw schema's exit_to field.
                # This used to borrow that one, which was fine only while the
                # two happened to be the same check: exit_to is a LIST now, so
                # the borrowed validator would have put the text of a Python
                # list into GS_USAGE_FEE_ADDRESS and sent the operator's cut
                # nowhere. The fee address is one address and asks for the
                # one-address check by name.
                env_extra["GS_USAGE_FEE_ADDRESS"] = \
                    proto.xmr_address(str(_fee_addr))
        # WHO IS WATCHING DECIDES WHERE THE OUTPUT GOES.
        #
        # The diversion exists because systemd journals whatever the children
        # print, and thor_swap_preparer prints the ThorChain memo. That is true
        # of the UNATTENDED path only. Diverting unconditionally also swallowed
        # the by-hand and --dry-run runs -- so the unit's own mitigation ("run
        # the agent by hand with --dry-run and you still see everything on your
        # terminal") was false, and JOB_LOG was named nowhere on screen, so an
        # operator had no way to find what they were no longer being shown.
        #
        # A tty means a human is present and there is no journal in the path;
        # anything else (systemd, a pipe, a redirect) gets the 0600 file.
        _jl = artifact_dir / JOB_LOG
        _watched = False
        try:
            _watched = sys.stdout.isatty()
        except Exception:                                    # noqa: BLE001
            _watched = False
        if _watched:
            agent_say(f"  [i] Step {i + 1} output follows on this terminal "
                      f"(no journal in the path when a human is watching).")
        else:
            agent_say(f"  [i] Step {i + 1} output -> {_jl} (0600, wiped with "
                      f"the artifacts).")
        # SOMEBODY SAT DOWN. Checked BETWEEN steps, not only at preflight.
        #
        # The inhibit file means "a person is using this machine", and the
        # moment a person reaches for it is the moment they walk up to a
        # running vault -- which is to say, mid-job. Read once at preflight it
        # could only ever catch someone who was already there before the wake,
        # so the case it was written for was the one it could not see: the job
        # ran to completion and powered the box off under them.
        #
        # Between steps rather than mid-step: a tool that is already running
        # gets to finish, because killing thor_swap_preparer halfway leaves a
        # quote nobody knows about. What it does not get is the NEXT tool, or
        # the power-off -- Refused(power=False) skips that and disarms the
        # deadman, exactly as preflight's copy does.
        _inh = artifact_dir / INHIBIT_FILE
        if _inh.exists():
            integrity_log("wake", "inhibited_mid_job")
            # A SLIP THAT WAS NEVER WRITTEN IS NO SLIP (self-doubt over the
            # ghost-record fix): the deposit's record is built with its
            # slip's PATH before the quote runs, and saved here with that
            # path intact when a person sat down between the mint and the
            # quote -- the same ghost the refused allocation used to leave,
            # holding a whole account reserve for two days and closing the
            # intake (at_capacity). The bundle stays: it is the next
            # deposit's (_reusable_receive).
            _rec_i = handles.get(handle)
            if isinstance(_rec_i, dict) and _rec_i.get("slip") \
                    and not Path(str(_rec_i["slip"])).is_file():
                _rec_i["slip"] = None
            _save_handles(artifact_dir, handles, led["owners"])
            raise Refused(
                "inhibited",
                f"{_inh} appeared while this job was running, so somebody is "
                f"at the machine. Stopping before step {i + 1} and NOT "
                f"powering off. Anything already finished is in the artifact "
                f"directory; remove the file when you are done.", power=False)
        # THE LAST INSTANT AT WHICH "NOTHING RAN" IS STILL TRUE. Everything
        # after this line can have moved money, minted an account or written a
        # plan, and run_once's handler needs to know that to choose the word
        # it reports. See _CHILD_STARTED.
        _CHILD_STARTED[0] = True
        rc, hard = run_child(argv, env_extra, budget, runner=runner,
                             log_path=None if _watched else _jl)
        # A STATUS PROBE THAT FINDS NOTHING HAS NOT FAILED, and this branch is
        # where the opposite used to be decided.
        #
        # receive_watch exits non-zero for timeout, stalled AND not_syncing
        # alike. For `watch` that is defensible -- the operator asked it to
        # wait for money and it did not come. For `swap_status` it is exactly
        # backwards: "nothing on the address yet" is the ordinary answer, the
        # one the operator will get most often, and reporting it as a failed
        # job is what put "the vault ran it and it FAILED" on their phone while
        # they were waiting for a payment that was simply still in flight.
        #
        # The probe SUCCEEDED as long as it ran and wrote an answer. Only a
        # hard kill or a missing answer is a real failure.
        # BOTH WATCHING JOBS, and the comment above used to argue the
        # opposite for `watch`: "the operator asked it to wait for money and it
        # did not come" -- defensible when watch reported nothing but a return
        # code, and wrong now that it writes what it SAW. A payment still
        # confirming after 110 minutes is not a failed job, and calling it one
        # sends the operator to a machine that is already powered off.
        #
        # The job SUCCEEDED as long as it ran and wrote an answer. Only a hard
        # kill or a missing answer is a real failure.
        if rc != 0 and job in ("swap_status", "watch") and not hard:
            # AN ANSWER, NOT A FILE. This checked that STATUS_FILE EXISTS and
            # nothing else -- so a probe killed at its budget, which writes
            # {"state": "interrupted"} on its way out, counted as a success.
            #
            # _PHASE_OF_STATE maps "interrupted" to "", meaning no phase was
            # earned. The vault then reported "done" with no phase, and the
            # pager's done-branch falls past the phase reply into the SLIP
            # branches. Driven on a deposit handle:
            #
            #   /check A3F1, probe killed at its budget
            #     seal_slip_for_delivery(status="done") -> 568 chars
            #     plain_slip_for_chat(status="done")    -> b d h m x
            #     and the memo field carries the destination XMR address whole
            #
            # So "has my payment arrived?" re-published the entire deposit
            # slip into the transcript, captioned as ready, for a probe that
            # answered nothing. Twice the exposure of the original delivery,
            # bought with a question about it.
            #
            # _phase_of is the exact test for "did this probe earn an answer":
            # it reads the same file, maps the state through the protocol's
            # closed table, and returns "" for every state that did not.
            if _phase_of(job, artifact_dir):
                continue
        # A FORWARD THAT FOUND NOTHING SETTLED HAS NOT FAILED EITHER. The
        # forwarder refuses `nothing_settled` (exit 2) and writes what it
        # saw -- not_seen or seen -- as one word; that is a status probe's
        # answer and is reported as one, so "has it arrived?" on a deposit
        # the Pi is not watching is answered "not yet" or "still confirming"
        # rather than "the machine FAILED". Any other non-zero exit is a
        # failure as before: no status file, no word.
        if rc != 0 and job == "forward_to_swap" and not hard:
            _fw = _forward_status_word(artifact_dir, handle)
            if _fw:
                # MONEY ON THE BTC SIDE WITH A SWAP STILL TO COME: settled
                # and held by today's fee. The deposit's place in the
                # reserve runs from here again (_paid_since). Not `seen`,
                # `short` or `returned`: a stranger's dust on an address in
                # the chat says any of them -- `returned` is any new output
                # not yet settled beside a forward of ours, 300 sat
                # included, which the forwarder cannot tell from a refund
                # until it settles (classify_returns reads confirmed
                # outputs only) -- and must not hold the intake's place.
                # A real refund does not need it: it lands within the grace
                # of the forward it refunds, and the forward of it, once
                # settled, stamps again. One that lands later than that
                # leaves the place free until then; a hazard stated, not
                # guarded. (`delayed` is not a stranger's to say for
                # nothing: it is settled money a forward in the pair's fee
                # band would carry -- theirs to lose into this swap.)
                if _fw == "delayed" and handle in handles:
                    handles[handle]["btc_money_at"] = \
                        int(time.time()) // 600 * 600
                # ...AND `delayed` HOLDS IT UNTIL A FORWARD SAYS OTHERWISE
                # (the residual of the stage 4 review): settled money on
                # this machine's own address that today's fee will not
                # carry is a mix still to come, as money on the subaddress
                # is. On a two-day clock from the last `delayed`, a fee
                # spike that outlasted the Pi's retries -- or a Pi restart,
                # which forgets them -- gave its place to the next client.
                # Cleared by any other answer from a forward of it: sent,
                # nothing there (a hand move), short, returned.
                _fw_run = _fw
                if handle in handles:
                    if _fw == "delayed":
                        handles[handle]["btc_delayed"] = \
                            int(time.time()) // 600 * 600
                    else:
                        handles[handle].pop("btc_delayed", None)
                continue
        if rc != 0:
            if hard:
                # agent_say, NOT print, AND THAT IS THE WHOLE FIX. The unit
                # sets StandardOutput=null and StandardError=null -- it has
                # to, because the children print the deposit address -- so a
                # bare print() on the woken path goes nowhere at all. This is
                # the message that tells the operator a child was SIGKILLed
                # with its cleanup skipped, i.e. that plaintext may be left in
                # the artifact directory and paranoia_mode has to be run by
                # hand. It is the single most consequential line this file can
                # emit and it was the one line in this loop that could not be
                # read: two agent_say calls sit ten lines above it.
                agent_say(f"  [!] Step {i + 1} had to be SIGKILLed after its "
                          f"budget. Its cleanup did NOT run — run "
                          f"paranoia_mode.")
            integrity_log("wake", f"job_failed:{job}")
            # NEVER RECORD A SLIP THAT WAS NOT WRITTEN. The handle is recorded
            # before the quote step runs, because the argv needs the path. If
            # that step then failed, the bundle exists and the slip does not,
            # and leaving the path in would make a later `watch` die inside
            # receive_watch on a missing file instead of refusing here with a
            # reason the operator can act on.
            rec = handles.get(handle)
            if rec and rec.get("slip") and not Path(rec["slip"]).exists():
                rec["slip"] = None
            # THE WITHDRAWAL'S ENTRY BUNDLE GOES ON THIS PATH TOO. It names
            # the account and subaddress the run spent from, on a disk that
            # auto-unlocks, and "gone with the job" below was only true of a
            # job that finished. The wallet itself still knows where the
            # money is; the file added nothing but a record.
            if job == "withdraw" and bundle:
                try:
                    if Path(bundle).is_file():
                        secure_delete_or_warn(Path(bundle),
                                              "the withdrawal's entry bundle")
                except Exception:                            # noqa: BLE001
                    integrity_log("wake", "retire_failed:withdraw_bundle")
            # ...AND THE ACCOUNTS THE MIX MINTED ARE STILL THIS OWNER'S: a
            # failed run may have moved their money onto them already.
            # Nothing is marked spent -- that stays a finished run's word.
            #
            # NOT ON A STOP (the review of this pass): the wallet can take
            # seconds to answer -- a minute and a half, busy with the mix
            # just killed -- and the SIGKILL comes twenty seconds after
            # systemd's stop, before the seal. The record written before
            # the mix stays, and the next wake settles it.
            if job == "withdraw" and _owner and _accts_before is not None \
                    and not _term_asked():
                _attribute_mix_accounts(key, accounts, led, _owner,
                                        _accts_before)
            _save_handles(artifact_dir, handles, led["owners"])
            return "job_failed", "failed", handle

    # THE DEPOSIT THAT JUST LEFT IS MARKED, on the run that reports done and
    # no other. The withdrawal's entry was one handle's receive address (or
    # none: money that came in some other way has no handle); every record
    # pointing at that (account, subaddress) is now a deposit that has been
    # paid out, and a /check on it is answered from here -- see the
    # watching branch above -- rather than from an emptied address.
    # THE FORWARD IS MARKED ON ITS RECORD: when (a 600 s bucket), where
    # the plan is, and WHETHER IT WENT OUT (read from the plan the child
    # wrote, never assumed from the mode: a sending run that was refused
    # before sending exits non-zero and never reaches here), so the wipe
    # takes the plan with the handle and a repeat wake is refused (see the
    # forward branch). No amount, no txid, no outcome word.
    # ...AND ONLY WHEN A PLAN WAS WRITTEN. A forward that found nothing
    # settled reports done with a word and wrote no plan; marking it would
    # refuse the real forward later as a repeat rehearsal.
    if job == "forward_to_swap" and handle in handles \
            and (artifact_dir / f"btc_forward_{handle}.json").is_file():
        # THE BUCKET IS THE SENDING RUN'S. A later ask on a sent handle is
        # answered without a child (see the forward branch) and reaches
        # here too; it must not move "when it went out" to "now".
        if not handles[handle].get("forward_sent"):
            handles[handle]["forwarded"] = int(time.time()) // 600 * 600
        handles[handle]["forward_plan"] = \
            str(artifact_dir / f"btc_forward_{handle}.json")
        # ONCE SENT, ALWAYS RECONCILED: never downgraded. A later plan can
        # say broadcast False -- a kept re-send every server rejected, and
        # the fresh forward of the same money then refused on today's fee
        # -- and rewriting the mark from it sent the next wake down the
        # plain --broadcast path: no history read, no exclusions, the
        # chain's current plan overwritten unrotated, about a deposit
        # whose first forward the network once accepted.
        # ...AND A RUN THAT RECONCILED IS ONE THAT WAS SENT: it only ran
        # because the ledger or the plan on disk said the money moved. With
        # the ledger mark missing (the agent died between the first send
        # and its save), the mark was read off the plan alone -- and that
        # plan, rewritten by a re-send every server rejected, said False:
        # the "once sent" above held only when the mark was already set.
        handles[handle]["forward_sent"] = bool(
            handles[handle].get("forward_sent") or _reconcile
            or _forward_outcome(artifact_dir, handle)[0])
        # ...AND THE MONEY IS IN FLIGHT AS OF NOW (_paid_since): a sending
        # run, or a reconciliation of one, holds the deposit's place for a
        # grace from here -- long enough for the swap to land on the
        # subaddress, which then holds it -- and no longer.
        # WHILE IT IS IN FLIGHT, AND ONCE MORE ON THE RUN THAT FINDS IT
        # MINED (the review of 657deae): stamped by every reconciliation,
        # a forward that mined weeks ago was "money in flight as of now"
        # on each tap of "has it arrived?" -- every reconcile of a sent
        # handle reaches here -- and its place was held for as long as
        # the client kept asking, after its XMR had landed and left. The
        # money left the BTC side when the forward mined; the swap lands
        # within the grace from the run that first saw that, and the
        # subaddress holds the place from there.
        _mined_now = _forward_mined(artifact_dir, handle)
        if handles[handle]["forward_sent"] \
                and not (_mined_now and _mined_before):
            handles[handle]["btc_money_at"] = int(time.time()) // 600 * 600
        # A PLAN WAS WRITTEN: the money went out, or was rehearsed on its
        # way -- unless this very run's word was `delayed` (a replacement,
        # or returned money, today's fee would not carry), which set it.
        if _fw_run != "delayed":
            handles[handle].pop("btc_delayed", None)
        # THE PAIRS REWRITE READS THE PLAN THE FORWARD JUST WROTE. The
        # outpoints it spent were accumulated on the record too, as "the
        # ledger's copy, read by the pairs rewrite and by the operator" --
        # and nothing read them: the forwarder keeps its own list on the
        # plan chain (STAGE5_PLAN.md section 2), and each entry was a
        # public-chain transaction id of the client's payment, on a record
        # the pay-out never retires, on a disk that unlocks itself. The
        # host-privacy pass took them off: the ledger names no transaction,
        # and a record from before is stripped the next time it is written.
        handles[handle].pop("forward_inputs", None)
        try:
            _plan_now = _read_json(
                artifact_dir / f"btc_forward_{handle}.json") or {}
            _reconcile_pairs(handles[handle], _plan_now,
                             chain=_forward_chain(artifact_dir, handle))
        except Exception:                                    # noqa: BLE001
            integrity_log("wake", "pairs_unreconciled")
    # THE LEDGER IS WRITTEN BEFORE ANYTHING IS SHREDDED. The files went
    # first and _save_handles came after, so a run killed between the two
    # left a ledger saying "unspent" beside a deposit whose files were gone
    # -- and with the store sealed, the next state_open brought the files
    # back from the older container: the whole record as it stood BEFORE a
    # payout that had happened. Written first, the worst a kill can leave
    # is "spent" with the files still there, which _heal_retired finishes.
    _retire_after = []
    if _spent_pair is not None:
        for _rec in handles.values():
            if _rec.get("bundle") and _bundle_pair(_rec) == _spent_pair:
                _rec["spent"] = True
                # THE PAIR STAYS, THE FILES GO. See _retire_files.
                _rec["pair"] = [int(_spent_pair[0]), int(_spent_pair[1])]
                _retire_after.append(_rec)
        # THE MIX'S ACCOUNTS ARE THE OWNER'S. Read after the child so the
        # fan-out, the decoys, the carrier and the change sweep it minted
        # are recorded as this owner's for the next leg. Unreadable on
        # either side means nothing is recorded, never a guess.
        if _owner and _accts_before is not None and not _term_asked():
            _attribute_mix_accounts(key, accounts, led, _owner, _accts_before)
        # THE WITHDRAWAL'S OWN BUNDLE NAMED THE ACCOUNT IT SPENT. Gone with
        # the job; the ledger keeps the pair.
    _save_handles(artifact_dir, handles, led["owners"])
    for _rec in _retire_after:
        _retire_files(_rec, artifact_dir)
    if _spent_pair is not None and bundle:
        try:
            if Path(bundle).is_file():
                secure_delete_or_warn(Path(bundle),
                                      "the withdrawal's entry bundle")
        except Exception:                                    # noqa: BLE001
            integrity_log("wake", "retire_failed:withdraw_bundle")
    integrity_log("wake", f"job_done:{job}")
    return "done", "done", handle


def _load_handles(d: Path) -> dict:
    """The handle ledger, or {}. NEVER raises, and never yields a bad record.

    THE TOP LEVEL WAS CHECKED AND THE RECORDS WERE NOT. A file holding
    {"A3F1": "hello"} passed -- it IS a dict -- and handed a string to every
    caller that then does rec.get("slip"). Driven: it comes back verbatim, and
    the failure path in _dispatch does `rec.get("slip")` on it, which is an
    AttributeError on the one branch that runs when a job has already failed.
    The slip readers survive it only because they are wrapped in a bare except
    that turns it into "no slip", so a corrupt ledger silently costs a
    delivery instead of naming itself.

    This file is 0600 in a swept directory and nothing but this tool writes
    it, so a bad record means corruption or a hand edit rather than an
    attacker -- which is exactly the case where a quiet AttributeError is the
    wrong answer. Bad records are DROPPED rather than the whole file
    discarded: one damaged entry should cost that one handle, not every other
    handle on the machine.
    """
    return _load_ledger(d)["handles"]


def _load_ledger(d: Path) -> dict:
    """{"handles": {...}, "owners": {owner: {"accounts": [int, ...]}}}.

    THE LEDGER GREW A SECOND HALF, and the file kept its name. `handles` is
    the record _load_handles has always returned; `owners` is which wallet
    ACCOUNTS each owner token's deposits and mixes created -- the set a
    withdrawal for that owner may spend from, and nothing else. A file written
    before this existed is a bare handles dict; it loads as handles with no
    owners, which is exactly what it says: nothing on it is anyone's.

    Account 0 is never anyone's: it is the wallet's own primary and change
    address, and money there belongs to the host. Indices are checked the way
    every integer off this disk is (no bools), and duplicates collapse.
    """
    _empty = {"handles": {}, "owners": {}}
    try:
        v = json.loads((d / HANDLES_FILE).read_text())
    except Exception:                                        # noqa: BLE001
        return _empty
    if not isinstance(v, dict):
        return _empty
    if isinstance(v.get("handles"), dict):
        _h, _o = v["handles"], v.get("owners")
    else:
        _h, _o = v, {}
    # A KEY THAT IS NOT A HANDLE IS NOT A RECORD. Four uppercase hex is what
    # every job names and every slip file is called after; a key of any
    # other shape can never be looked up and only ever counts -- toward the
    # ceiling of the file and toward the deposits held pending.
    handles = {k: r for k, r in _h.items()
               if isinstance(k, str) and proto.HANDLE_RE.match(k)
               and isinstance(r, dict)}
    owners = {}
    if isinstance(_o, dict):
        for k, r in _o.items():
            if not (isinstance(k, str) and isinstance(r, dict)):
                continue
            _acc = [a for a in (r.get("accounts") or [])
                    if isinstance(a, int) and not isinstance(a, bool)
                    and a > 0]
            owners[k] = {"accounts": sorted(set(_acc))}
            # A MIX'S STARTING ACCOUNTS, while what it minted is unrecorded
            # (_mark_pending_mix). Kept only as a list of plain integers --
            # account 0 among them, which a wallet always has.
            _pm = r.get(PENDING_MIX_FIELD)
            if isinstance(_pm, list):
                owners[k][PENDING_MIX_FIELD] = sorted(
                    {a for a in _pm if isinstance(a, int)
                     and not isinstance(a, bool) and a >= 0})
                # ...and how many wakes found nothing new for it: dropped
                # here, the count never reached its bound and the mark --
                # every minting job refused with it -- stood for good.
                _pe = r.get(PENDING_EMPTY_FIELD)
                if isinstance(_pe, int) and not isinstance(_pe, bool) \
                        and 0 < _pe < PENDING_EMPTY_MAX:
                    owners[k][PENDING_EMPTY_FIELD] = _pe
    return {"handles": handles, "owners": owners}


def _owner_accounts(led: dict, owner) -> set:
    """The wallet accounts this owner may spend from. Empty when unknown.

    LESS EVERY ACCOUNT ANOTHER OWNER'S SET ALSO HOLDS (the review of this
    change, rule 8): _add_owner_accounts no longer writes an account into
    two sets, but a ledger an earlier build wrote may hold one there
    already -- and either owner's withdrawal then spent the other's money,
    the record of it marked spent, no chain line. The guard on the side
    that spends as well as the side that writes: such an account is
    neither's to spend from the phone; the money on it is settled by a
    person at the machine. Said on the chain (owner_account_conflict)."""
    if not owner:
        return set()
    _owners = led.get("owners") or {}
    _mine = set((_owners.get(owner) or {}).get("accounts") or [])
    _theirs = {i for o, r in _owners.items() if o != owner
               and isinstance(r, dict) for i in (r.get("accounts") or [])}
    if _mine & _theirs:
        integrity_log("wake", "owner_account_conflict")
    return _mine - _theirs


def _read_accounts_patiently(key: dict, accounts=None):
    """_account_indices, asked three times a few seconds apart before it is
    taken as unreadable: a wallet-rpc busy right after a refresh or a mix
    answers the second time. time.sleep, not _nap -- see the callers."""
    for _try in range(3):
        _got = _account_indices(key, injected=accounts)
        if _got is not None:
            return _got
        if _try < 2:
            time.sleep(2)
    return None


def _attribute_mix_accounts(key: dict, accounts, led: dict, owner,
                            before) -> None:
    """Record every account the mix minted as `owner`'s: the wallet's
    accounts now, less `before`. ONE job runs per boot, so the difference
    is this owner's money at work -- its fan-out, decoys, carrier, change.

    ON EVERY EXIT AFTER THE MIX STARTED, not only a finished one (the
    review of the uncovered dimensions). A run that failed or was stopped
    after the fan-out had moved the owner's money onto new accounts saved
    the ledger with the owner holding only the account it had emptied:
    their next withdrawal found nothing of theirs, and the money sat on
    accounts no owner -- not even the host's token -- could reach.

    ASKED AGAIN BEFORE GIVING UP, AND SAID OUT LOUD WHEN IT CANNOT BE: a
    wallet that still cannot be asked is written to the chain and the
    terminal, so the host knows which run left accounts unattributed.
    time.sleep, not _nap, inside: the money has moved by here, and a stop
    that skipped the save after this would lose the record of whose
    accounts the mix minted. Six seconds at most."""
    _after = _read_accounts_patiently(key, accounts)
    if _after is not None:
        _add_owner_accounts(led, owner, set(_after) - set(before))
        _clear_pending_mix(led, owner)
        return
    integrity_log("wake", "owner_accounts_unreadable")
    agent_say("  [!] could not read the wallet's accounts after the mix; "
              "what it minted is recorded as this owner's at the next wake "
              "(the accounts before it are on the ledger).")


#: The owner's record field that holds the accounts a mix started from,
#: until what it minted has been recorded.
PENDING_MIX_FIELD = "mix_before"


#: The jobs whose tools create wallet accounts: a deposit's receive wallet,
#: a withdrawal's mix. Nothing else may run while a mix's accounts are
#: unrecorded (see _dispatch).
_MINTING_JOBS = ("receive_and_quote", "withdraw")


def _pending_marks(led: dict) -> list:
    """The owners whose mix an earlier wake did not see the end of."""
    return [o for o, r in (led.get("owners") or {}).items()
            if isinstance(r, dict)
            and isinstance(r.get(PENDING_MIX_FIELD), list)]


def _mark_pending_mix(led: dict, owner, before) -> None:
    """Write down the accounts a mix is about to start from. NEVER OVER
    ANOTHER MARK (the vault review): written over, the first mix's accounts
    were in nobody's set; beside another owner's, the recovery would give
    both of them the same accounts. _dispatch refuses a minting job while a
    mark stands; this is the same rule at the place the mark is made."""
    if _pending_marks(led):
        integrity_log("wake", "mix_unsettled")
        raise Refused("mix_unsettled",
                      "an earlier mix's accounts are not recorded yet; "
                      "nothing was run and nothing was spent. Ask again in "
                      "a few minutes.")
    _o = led.setdefault("owners", {}).setdefault(owner, {"accounts": []})
    _o[PENDING_MIX_FIELD] = sorted(int(i) for i in before
                                   if isinstance(i, int)
                                   and not isinstance(i, bool))


def _clear_pending_mix(led: dict, owner) -> None:
    _o = (led.get("owners") or {}).get(owner)
    if isinstance(_o, dict):
        _o.pop(PENDING_MIX_FIELD, None)
        _o.pop(PENDING_EMPTY_FIELD, None)


#: How many wakes a mark whose wallet shows NOTHING new is kept before it
#: is let go (_recover_pending_mixes), and where the count is kept.
PENDING_EMPTY_MAX = 3
PENDING_EMPTY_FIELD = "mix_empty_reads"


def _recover_pending_mixes(key: dict, accounts, led: dict) -> bool:
    """At the start of a wake, before anything mints: every owner whose mix
    an earlier wake did not see the end of -- a stop, a power cut, a wallet
    that would not answer -- is given what that mix minted, and the mark
    goes. True if the ledger changed. No mark, no wallet call.

    RESTS ON ONE ASSUMPTION, stated: nothing minted accounts on this wallet
    between that wake and this one. The machine is off between wakes; a
    mix run BY HAND on it in between would have its accounts given to the
    owner too, and the line below says so, so the operator can check."""
    _pend = [(o, led["owners"][o]) for o in _pending_marks(led)]
    if not _pend:
        return False
    _now = _read_accounts_patiently(key, accounts)
    if _now is None:
        integrity_log("wake", "owner_accounts_unreadable")
        return False
    # NOTHING NEW IS NOT "IT MINTED NOTHING" (the review of this change). A
    # power cut mid-mix used to leave a wallet file that had never stored
    # what the mix minted, and the wallet listed `before` again until a
    # refresh had scanned the mix's own outputs and derived those accounts
    # anew. Cleared on that first read, the next owner's mix minted the same
    # indices and they were recorded as theirs -- with the first owner's
    # money on them.
    #
    # THE CAUSE IS CLOSED WHERE IT STARTED: GhostSpiral stores the wallet,
    # flushed to the device, before it mints, after its first batch of
    # mints and again after its last, before its first relay; the vault's
    # runs are receive mode, where each of those stops the run if it cannot
    # (persist_minted). Its first batch is the mix accounts, so a mix that
    # got as far as moving anything reads back non-empty here, and an EMPTY
    # read means it stopped between minting and storing, with nothing
    # relayed -- the accounts it forgot hold nothing. What an empty read
    # still cannot be told apart from is a wallet file that is not the one
    # the mix stored to: an older copy restored, or another file opened. For
    # that the mark is still kept (every job that
    # mints stays refused mix_unsettled) for PENDING_EMPTY_MAX wakes and
    # only then let go, said on the chain -- the operator's cue to check the
    # wallet at the machine.
    _done = 0
    for _o, _r in _pend:
        _before = set(_r.get(PENDING_MIX_FIELD) or [])
        _new = set(_now) - _before
        if not _new:
            _tries = _r.get(PENDING_EMPTY_FIELD)
            _tries = (_tries if isinstance(_tries, int)
                      and not isinstance(_tries, bool) else 0) + 1
            if _tries < PENDING_EMPTY_MAX:
                _r[PENDING_EMPTY_FIELD] = _tries
                integrity_log("wake", "owner_accounts_not_found")
                continue
            integrity_log("wake", "owner_accounts_none_found")
        _add_owner_accounts(led, _o, _new)
        _clear_pending_mix(led, _o)
        _done += 1
    if _done:
        integrity_log("wake", "owner_accounts_recovered")
        agent_say(f"  [*] {_done} earlier mix(es) did not see their end on "
                  f"a wake; the accounts they minted are now recorded as "
                  f"their owner's. If anything was run BY HAND on this "
                  f"wallet since, check the ledger.")
    return True


def _account_owners(led: dict, idx) -> set:
    """The owner tokens whose set holds wallet account `idx`."""
    return {o for o, r in (led.get("owners") or {}).items()
            if isinstance(r, dict) and idx in (r.get("accounts") or [])}


def _add_owner_accounts(led: dict, owner, idxs) -> None:
    """Record accounts as this owner's. Account 0 is never recorded, and
    NEITHER IS ONE ANOTHER OWNER HOLDS (the vault review, rule 8): two sets
    holding one account let either owner's withdrawal spend the other's
    money. That only happens when the wallet's account list went backwards
    and re-minted it; the account is left to the owner who had it, and the
    chain says so -- the money on it may be this owner's, which a person
    at the machine settles, never a withdrawal from the phone."""
    if not owner:
        return
    _o = led.setdefault("owners", {}).setdefault(owner, {"accounts": []})
    _have = set(_o.get("accounts") or [])
    for _i in idxs or ():
        if isinstance(_i, int) and not isinstance(_i, bool) and _i > 0:
            if _account_owners(led, _i) - {owner}:
                integrity_log("wake", "owner_account_conflict")
                continue
            _have.add(_i)
    _o["accounts"] = sorted(_have)


#: Bound on the handles file. Insertion order is preserved by dict, so this
#: keeps the most recent. Nothing pruned this before and it only ever grew --
#: 12 wakes a day for a month is ~360 entries, so 1000 is far past any real
#: between-wipe usage, and an entry that does fall off gives `unknown_handle`,
#: which is a refusal the operator can read, not a silently wrong address.
MAX_HANDLES = 1000


def _save_handles(d: Path, h: dict, owners: dict = None) -> None:
    """Write the ledger. `owners` omitted keeps what the file already holds,
    so a caller that only touched handles cannot drop the other half."""
    if len(h) > MAX_HANDLES:
        # INTAKE RECORDS ARE NEVER PRUNED (STAGE5_PLAN.md 3.6): a record
        # carrying btc_index is what tells a fresh pair from a wiped ledger
        # and what the once-per-outpoint rule reads. The bound falls on the
        # rest, most recent kept.
        _intake = {k for k, r in h.items()
                   if isinstance(r, dict)
                   and isinstance(r.get("btc_index"), int)
                   and not isinstance(r.get("btc_index"), bool)}
        _others = [k for k in h if k not in _intake]
        _room = max(0, MAX_HANDLES - len(_intake))
        _drop = set(_others[:max(0, len(_others) - _room)])
        h = {k: r for k, r in h.items() if k not in _drop}
    if owners is None:
        owners = _load_ledger(d)["owners"]
    atomic_write_json({"handles": h, "owners": owners},
                      d / HANDLES_FILE, perms=0o600)


# ---------------------------------------------------------------------------
#: The slip fields that travel, and NOTHING ELSE from the pair record.
#:
#: An allowlist rather than "the pair minus a few keys", because the pair is
#: written by another tool and the next field somebody adds to it would ride
#: along uninspected. Short keys because 384 bytes is the budget and a 95-char
#: address plus a 111-char memo is most of it.
#:
#: `a` (dest_xmr) is here even though the memo already contains it, and that is
#: deliberate: it lets the delivery machine re-run memo_binds_destination
#: LOCALLY, against a field sealed by the same key, before the operator sends
#: anything. It cannot catch a hostile vault -- a vault that lies can lie in
#: both fields -- but a swap whose memo does not name its own destination is
#: the one failure that silently pays a stranger, and checking it twice on two
#: machines costs 100 bytes.
SLIP_FIELDS = (("btc_in", "b"), ("deposit", "d"), ("memo", "m"),
               ("dest_xmr", "a"), ("expected_xmr", "x"), ("ts", "t"))


def seal_slip_for_delivery(key: dict, artifact_dir: Path, status: str,
                           handle: str, reader=None) -> str:
    """Seal this job's deposit instructions for the delivery machine, or "".

    Returns "" -- not an error -- whenever there is nothing to seal or no key
    to seal it to. The operator who has not set up a delivery key gets exactly
    the behaviour they had before, and the slip stays on this machine.

    NEVER RAISES. A job that ran is a job that ran; a slip that could not be
    sealed does not un-mint an address or un-quote a swap, and turning a
    completed job into a reported failure would send the operator to check a
    vault that has already powered off. It is loud on this terminal and in the
    integrity log instead, and the operator learns from the chat that no slip
    came back -- which is a true statement of what happened.
    """
    try:
        if status != "done":
            return ""
        dpub = (key.get("delivery_public") or "").strip()
        if not dpub:
            return ""
        rec = (_load_handles(artifact_dir) or {}).get(handle) or {}
        path = rec.get("slip")
        if not path:
            # A handle with no quote behind it has no deposit address to
            # deliver, and that is not a fault.
            return ""
        # A BTC-INTAKE DEPOSIT IS NEVER SEALED FOR A DELIVERY MACHINE. The
        # delivery path is the shared-inbound flow: an operator at a desktop
        # pays ThorChain's vault with the memo. On the intake the client pays
        # a plain address from a phone and the memo is the forward's; the
        # pairs file's inbound and memo must not travel as instructions.
        if isinstance(rec.get("btc_index"), int) \
                and not isinstance(rec.get("btc_index"), bool):
            integrity_log("wake", "slip_not_sealed_btc")
            return ""
        pairs = (reader or _read_json)(Path(path))
        if not isinstance(pairs, list) or len(pairs) != 1:
            # ONE amount goes in (a single ladder slot), so one pair comes out.
            # Any other count means something is not what this code thinks it
            # is, and picking one of several deposit addresses to send money to
            # is not a guess worth making.
            raise ValueError(
                f"expected exactly one quoted pair, found "
                f"{len(pairs) if isinstance(pairs, list) else 'a non-list'}")
        pair = pairs[0]
        body = {}
        for src, short in SLIP_FIELDS:
            v = pair.get(src)
            if v is None:
                raise ValueError(f"the quoted pair has no {src!r}")
            # `ts` IS NOT JUST "PRESENT", IT HAS TO BE A TIME. Every other
            # field here is a string the delivery machine re-checks for itself
            # (memo_binds_destination, instruction_field_safe); `ts` is the one
            # the operator cannot sanity-check by eye, and it is the input to
            # the only control that says "this quote has expired".
            #
            # Checked here as well as in gs_unseal because the two machines
            # know different things. gs_unseal cannot tell a malformed slip
            # from a vault with a broken clock, so all it can do is report the
            # age as unknown and refuse to call the quote fresh. THIS side can
            # see the pairs file that produced it, and the operator is standing
            # at a terminal that prints why -- so a slip with an unusable
            # timestamp is worth not sealing at all, rather than sending one
            # whose age nobody can read.
            #
            # isinstance(True, int) is True, which is why the bool is excluded
            # explicitly -- the same trap unlock_keyfile's ops/mem bounds call
            # out. Zero and negatives are refused too: a Unix epoch of 0 is not
            # a quote time, it is a field somebody defaulted.
            if src == "ts" and (isinstance(v, bool)
                                or not isinstance(v, int) or v <= 0):
                raise ValueError(
                    f"the quoted pair's 'ts' is not a usable timestamp "
                    f"({v!r}); without it the delivery machine cannot tell "
                    f"whether the quote has expired")
            body[short] = v
        body["h"] = handle
        import nacl.public
        tp_sk = nacl.public.PrivateKey(bytes.fromhex(key["secret"]))
        blob = proto.seal_slip(tp_sk,
                               nacl.public.PublicKey(bytes.fromhex(dpub)),
                               body)
        integrity_log("wake", "slip_sealed")
        return blob
    except Exception as e:                                   # noqa: BLE001
        integrity_log("wake", "slip_seal_failed")
        # terminal_safe: this quotes a message that can contain a filename and
        # a field name, and this line reaches a terminal.
        agent_say(f"  [!] The job finished but its slip could NOT be sealed "
                  f"for delivery ({terminal_safe(str(e))[:160]}).")
        agent_say(f"      The deposit address and memo are on THIS machine, "
                  f"unchanged. Nothing was sent anywhere.")
        return ""


def _read_json(path: Path):
    return json.loads(path.read_text())


#: pair-record field -> plaintext slip key. A SEPARATE, SHORTER allowlist than
#: SLIP_FIELDS, and the difference is deliberate: the sealed slip carries
#: dest_xmr so gs_unseal can re-run memo_binds_destination on a second machine,
#: and it carries ts so it can call a stale quote stale. A phone can do
#: neither, so both fields would be extra copies of sensitive values in a
#: transcript, bought for nothing. What is left is exactly what a human needs
#: to make the payment.
#: THE MEMO IS IN THIS MAP, and for one turn it was not.
#:
#: It was dropped on two true arguments -- it names the destination address,
#: and a token holder could substitute it -- and the drop broke the one mode
#: this record exists for. `deposit_in_chat` is the mode for a person whose
#: only device is a phone (OPSEC_SETUP.md, "If you have only a phone"): the
#: deposit address is a SHARED pooled inbound vault, the memo is the entire
#: binding between their Bitcoin and their Monero, and BTC paid to that
#: address without it is routed to nobody. Handing them the address and the
#: amount with no memo was the trap the docs warn about, in the mode the
#: docs said carries both. A service whose clients pay from their own desktop
#: app cannot take a deposit without it.
#:
#: What the memo costs is paid where it is stated (gs_wake_proto's
#: PLAIN_FIELDS): a one-shot destination, public in the OP_RETURN once paid,
#: a message deleted after --burn-after, and the token as the only mitigation
#: for substitution -- exactly as it is for the address line beside it. And
#: the binding is CHECKED here, on this machine, against this machine's own
#: dest_xmr, right before the record is built: a memo naming anyone else is
#: refused, loudly, and nothing is sent.
PLAIN_MAP = (("btc_in", "b"), ("deposit", "d"), ("memo", "m"),
             ("expected_xmr", "x"))


def plain_slip_for_chat(key: dict, artifact_dir: Path, status: str,
                        handle: str, reader=None) -> dict:
    """The deposit instructions, in the clear, or {}.

    Same contract as seal_slip_for_delivery and for the same reasons: returns
    empty rather than raising when there is nothing to send or the operator has
    not turned this on, and NEVER raises -- a job that ran is a job that ran.
    """
    try:
        if status != "done" or not key.get("deposit_in_chat"):
            return {}
        rec = (_load_handles(artifact_dir) or {}).get(handle) or {}
        path = rec.get("slip")
        if not path:
            return {}                       # nothing was quoted
        pairs = (reader or _read_json)(Path(path))
        if not isinstance(pairs, list) or len(pairs) != 1:
            # The same refusal the sealed path makes. N slips in one transcript
            # is worse here than there: GhostSpiral calls two or more
            # publicly-known outputs the catastrophic case, and a chat is
            # exactly where they pile up.
            raise ValueError(
                f"expected exactly one quoted pair, found "
                f"{len(pairs) if isinstance(pairs, list) else 'a non-list'}")
        pair = pairs[0]
        # THE BTC INTAKE: the amount, the host's OWN unique address derived
        # for this handle, the expected figure and the label -- and NO memo.
        # The pairs file's `deposit` is ThorChain's shared inbound and its
        # `memo` names the destination: both are the forward's business at
        # forward time, and neither may reach a phone as an instruction. The
        # absence of `m` is how the Pi knows which flow this is
        # (gs_wake_proto.PLAIN_SHAPES).
        _bi = rec.get("btc_index")
        if isinstance(_bi, int) and not isinstance(_bi, bool):
            body = {}
            for src, short in (("btc_in", "b"), ("expected_xmr", "x")):
                v = pair.get(src)
                if v is None:
                    raise ValueError(f"the quoted pair has no {src!r}")
                body[short] = str(v)
            body["d"] = _btc_address(key, _bi)
            body["h"] = handle
            if not proto.plain_slip_is_wellformed(body):
                raise ValueError("the deposit instructions do not fit the "
                                 "plaintext slip format")
            integrity_log("wake", "plain_slip_sent_btc")
            return body
        body = {}
        for src, short in PLAIN_MAP:
            v = pair.get(src)
            if v is None:
                raise ValueError(f"the quoted pair has no {src!r}")
            body[short] = str(v)
        body["h"] = handle
        # THE MEMO MUST NAME THIS MACHINE'S OWN DESTINATION, checked here at
        # the last line before it reaches a wire, against the pair's own
        # dest_xmr -- the same check thor_swap_preparer made when it quoted
        # and gs_unseal makes on a sealed slip. The Pi cannot make it (it
        # never learns the destination), so the one box that can, does. A
        # memo naming anyone else is a payment to anyone else.
        from gs_common import memo_binds_destination as _binds
        if not _binds(str(pair.get("memo") or ""), str(pair.get("dest_xmr") or "")):
            integrity_log("wake", "plain_memo_unbound")
            raise ValueError("the quoted pair's memo does not name its own "
                             "destination; refusing to send it anywhere")
        # Checked against the SAME predicate the doorbell will use, here, where
        # the operator can be told. Otherwise a control character in a memo
        # would be refused by the Pi and the vault would have powered off
        # believing it delivered.
        if not proto.plain_slip_is_wellformed(body):
            raise ValueError("the quoted pair does not fit the plaintext slip "
                             "format (a field is empty, too long, or carries a "
                             "control character)")
        integrity_log("wake", "plain_slip_sent")
        return body
    except Exception as e:                                   # noqa: BLE001
        integrity_log("wake", "plain_slip_failed")
        agent_say(f"  [!] The job finished but its deposit instructions could "
                  f"NOT be sent ({terminal_safe(str(e))[:160]}).")
        agent_say(f"      They are on THIS machine, unchanged.")
        return {}


#: Attempts to deliver the result record, and the waits between them. Four
#: tries over about 105 s: long enough for a Tor circuit to be rebuilt, short
#: against every job budget. Bounded so a Pi that is gone for good cannot hold
#: the vault powered on.
RESULT_POST_ATTEMPTS = 4
RESULT_POST_BACKOFF_S = (15, 30, 60)


def report_back(key: dict, job_id: str, challenge_hex: str, status: str,
                handle: str, slip: str = "", plain: dict = None,
                phase: str = "", poster=None, sleeper=None) -> None:
    """Tell the doorbell the outcome, a 4-hex label, and at most ONE payload.

    Never the reason a job was refused. The payload is either a SEALED slip --
    ciphertext for a key the doorbell does not have -- or, when the operator's
    own keyfile says so, the deposit instructions in the clear. Never both:
    see gs_wake_proto's "THE PLAINTEXT SLIP" for what each costs.
    """
    plain = plain or {}
    done = status == "done"
    # THE PHASE TRAVELS WHATEVER THE STATUS IS, and it is the only field here
    # that may.
    #
    # handle, slip and plain are gated on `done` because a job that did not
    # finish has no result to hand over, and reporting one would tell the
    # operator it worked. The phase is the opposite kind of value: it is what
    # the probe SAW, drawn from a closed table the doorbell re-checks
    # membership against (gs_doorbell's phase check is a set test with no
    # status coupling), and its whole purpose is to say something truer than
    # the return code.
    #
    # Gating it on `done` is what made a /watch whose money was still in
    # flight report "watch: failed." -- the phase was computed, carried this
    # far, and thrown away one line before it would have been useful.
    body = {"job_id": job_id, "challenge": challenge_hex, "status": status,
            "handle": handle if done else "",
            "slip": slip if done else "",
            "plain": plain if done else {},
            "phase": phase}
    try:
        import nacl.public
        tp_sk = nacl.public.PrivateKey(bytes.fromhex(key["secret"]))
        pi_pk = nacl.public.PublicKey(bytes.fromhex(key["peer_public"]))
        m3 = proto.seal(tp_sk, pi_pk, proto.TAG_M3, body)
    except proto.WakeError as e:
        # A RECORD THAT WILL NOT FIT IS NOT A DELIVERY PROBLEM, and treating it
        # as one is how a successful job becomes silence.
        #
        # This whole function used to sit under one bare `except Exception`
        # whose comment said "an undeliverable result is not a failure of the
        # job". True for a dead socket. NOT true for seal() refusing an
        # oversized record: that is a bug in what we just built, the operator
        # is told "collected but never reported back" for a job that fully
        # succeeded, and the vault powers off before anyone can look. Retry
        # WITHOUT the payload so the outcome and the handle still arrive --
        # they are what lets the operator find the job on the vault.
        integrity_log("wake", "result_too_large")
        agent_say(f"  [!] The result record would not fit the wire "
                  f"({terminal_safe(str(e))[:120]}).")
        agent_say(f"      Reporting the outcome WITHOUT the deposit "
                  f"instructions; they are on this machine.")
        try:
            import nacl.public
            m3 = proto.seal(
                nacl.public.PrivateKey(bytes.fromhex(key["secret"])),
                nacl.public.PublicKey(bytes.fromhex(key["peer_public"])),
                proto.TAG_M3,
                dict(body, slip="", plain={}))
        except Exception:                                    # noqa: BLE001
            integrity_log("wake", "result_undeliverable")
            return
    except Exception:                                        # noqa: BLE001
        integrity_log("wake", "result_undeliverable")
        return
    # DELIVERED, OR SAID TO BE UNDELIVERABLE -- AND TRIED MORE THAN ONCE.
    # post_record returns (0, b"") on any transport failure and NEVER raises,
    # so the except below could not fire on the one failure that happens in
    # practice: a Tor circuit to the Pi that is down for the thirty seconds
    # this ran in. The result record is the ONLY thing that tells the phone
    # money moved; losing it to one bad circuit meant "withdraw: failed" for
    # a withdrawal that succeeded. So: a bounded set of attempts with backoff,
    # a refusal (the doorbell answered and would not take it: 204/400/404)
    # stopping at once because the same record would be refused again, and
    # the chain recording which of the three happened.
    _post = poster or post_record
    # _nap: a backoff of up to a minute must not outlast a stop request.
    _sleep = sleeper or _nap
    _status = 0
    for _i in range(RESULT_POST_ATTEMPTS):
        try:
            _status = int((_post(key["doorbell_url"], "/result", m3)
                           or (0, b""))[0] or 0)
        except Exception:                                    # noqa: BLE001
            _status = 0
        if _status == 200:
            if _i:
                integrity_log("wake", "result_delivered_on_retry")
            return
        if _status in (204, 400, 404):
            integrity_log("wake", "result_rejected")
            agent_say(f"  [!] The doorbell answered {_status} to the result "
                      f"record and will not take it; not retrying the same "
                      f"record. The job's artifacts are on this machine.")
            return
        if _i < RESULT_POST_ATTEMPTS - 1:
            # A STOP ENDS THE RETRIES, AND ONLY THE RETRIES. Raising here
            # threw a FINISHED job into run_once's handler, which reported it
            # again as "failed" -- with no handle and no slip -- over the
            # "done" the doorbell may already have taken. The records are
            # sealed before any report; what is lost is a retry.
            try:
                _sleep(RESULT_POST_BACKOFF_S[
                    min(_i, len(RESULT_POST_BACKOFF_S) - 1)])
            except Stopping:
                integrity_log("wake", "result_stopped")
                return
    # THIS one really is a delivery problem. The job either happened or did
    # not, and the record of it is here.
    integrity_log("wake", "result_undeliverable")
    agent_say(f"  [!] The result record could not be delivered after "
              f"{RESULT_POST_ATTEMPTS} attempts (last status {_status}). The "
              f"phone will not be told; the job's artifacts are on this "
              f"machine.")


def retire_job_log(code: str, dry_run: bool = False) -> bool:
    """Shred the job log when the run went well. Returns whether it went.

    IT HOLDS THE CHILDREN'S OUTPUT: the deposit address, the memo naming
    the client's XMR address, the amounts. It was truncated at the START
    of the next boot, so between two wakes -- weeks, on the machine this
    whole design keeps switched off -- the last deposit sat in the clear
    beside the sealed records. Sealing those and leaving this is sealing
    nothing.

    ONLY ON A CLEAN RUN. A refusal or a crash is exactly when the operator
    needs to read it, and under StandardOutput=null it is the only place
    the reason exists. _AGENT_LOG is cleared first so a later line -- a
    power-off that failed, say -- does not write the file straight back.
    Never raises: bookkeeping must not be what keeps a vault switched on.
    """
    if dry_run or code not in ("done", "not_configured"):
        return False
    _p = _AGENT_LOG[0]
    _AGENT_LOG[0] = None
    if _p is None:
        return False
    try:
        if Path(_p).is_file():
            secure_delete_or_warn(Path(_p), "the job log")
        return True
    except Exception:                                        # noqa: BLE001
        return False


def unseal_state_cli(args) -> str:
    """--unseal-state: open the sealed records by hand and stop.

    The recovery path of STAGE7_PLAN.md §5. Everything the vault keeps
    between jobs is sealed under two halves and the Pi holds one of them,
    so a dead card would otherwise mean a ledger nobody can read and open
    deposits nobody can pay out. This takes that half on the command line
    -- printed by `gs_doorbell state-key`, at the machine, by the operator
    -- and writes the members out as plaintext.

    It does not power anything off and does not touch the doorbell. The
    next ordinary wake seals what it finds, so the plaintext is the
    operator's to use and then let the next poke put away.
    """
    key = load_key(Path(args.key))
    artifact_dir = Path(key.get("artifact_dir") or ".").resolve()
    vault, _ = state_halves(key)
    if vault is None:
        agent_say("  [!] This keyfile carries no state half, so this "
                  "machine's records are not sealed: they are already "
                  "plaintext in the artifact directory. Nothing to open.")
        return "unsealed"
    try:
        pi = bytes.fromhex(str(args.unseal_state).strip())
    except ValueError:
        pi = b""
    if len(pi) != proto.STATE_HALF_BYTES:
        agent_say(f"  [!] --unseal-state takes the Pi's half as "
                  f"{proto.STATE_HALF_BYTES * 2} hex characters. Print it "
                  f"with `gs_doorbell state-key` on the Pi.")
        return "bad_half"
    try:
        n = state_open(artifact_dir, vault, pi)
    except Refused as e:
        agent_say(f"  [!] {e.msg}")
        return e.code
    # THE OLD CONTAINER IS RETIRED once every record is on the disk, and
    # that is what makes this the way through a RE-PAIRING. Left in place,
    # the next wake -- under a new pair, whose halves cannot open it --
    # refused state_unreadable, and named this command as the cure, for
    # ever: the refusal's own recovery instruction did not recover. The
    # records are complete on the disk now (state_open wrote every member
    # it did not find there), so the container holds nothing they do not,
    # and the next wake seals them again under whichever pair wakes it.
    #
    # THE ANSWER IS CHECKED, not assumed: secure_delete_or_warn says False
    # rather than raising, and a container left behind is a pairing that
    # refuses and a wake that refuses, so this does not report "opened".
    _old = artifact_dir / SEALED_FILE
    try:
        _gone = secure_delete_or_warn(_old, "the retired sealed records")
    except Exception:                                        # noqa: BLE001
        _gone = False
    if not _gone:
        agent_say(f"  [!] {n} record(s) are written out in the clear at "
                  f"{artifact_dir}, but {_old} could not be removed. A new "
                  f"pairing refuses, and every wake under one refuses "
                  f"state_unreadable, until it is: what it held is on the "
                  f"disk now, so shred it by hand.")
        return "not_retired"
    agent_say(f"  [+] {n} record(s) written out in the clear at "
              f"{artifact_dir}. The old container is retired; the next "
              f"wake seals them again, under this pairing or a new one. "
              f"Run paranoia_mode instead if this box is finished with.")
    return "opened"


#: The character classes of systemd's env-file parser (src/basic/env-file.c
#: and string-util.h). NEWLINE includes a bare carriage return.
_SD_NEWLINE = "\n\r"
_SD_WHITESPACE = " \t\n\r"
_SD_COMMENTS = "#;"
_SD_NEED_ESCAPE = '"\\`$'


def _sd_rejects(text: str) -> bool:
    """Would systemd refuse the whole file over this key or value? Its
    push checks every one with utf8_is_valid, which also turns away the
    Unicode noncharacters (U+FDD0..U+FDEF and anything ending FFFE/FFFF).
    Measured: `A=x<U+FDD0>` fails load_env_file with EINVAL."""
    for ch in text:
        o = ord(ch)
        if 0xFDD0 <= o <= 0xFDEF or (o & 0xFFFE) == 0xFFFE:
            return True
    return False


def parse_env_file(text: str) -> dict:
    """What systemd puts in a unit's environment from this EnvironmentFile.

    A PORT OF systemd's OWN STATE MACHINE (parse_env_file_internal, v255),
    not a reading of the man page -- because the reading that was here
    before sealed a DIFFERENT value from the one the unit runs with, and
    this is the one place in the design where that costs money. It stripped
    quotes off both ends of a line and did nothing else, so against
    libsystemd-shared-255's load_env_file, driven through ctypes:

        line                         systemd      was sealed
        GS_WALLET_PASSWORD="a\\"b"    a"b          a\\"b
        GS_WALLET_PASSWORD="a\\\\b"   a\\b          a\\\\b
        GS_WALLET_PASSWORD=a\\ b      "a b"        a\\ b
        GS_WALLET_PASSWORD=ends"      ends"        ends
        GS_WALLET_PASSWORD='it''s'    its          it''s

    and it could not see a quoted value spanning two lines, a continuation
    line, or a bare carriage return, which systemd treats as a newline. A
    password manager's password with a quote or a backslash in it sealed
    wrong, the read-back compared the wrong value with itself, and the
    operator was told to shred the plaintext. The next withdrawal could not
    open the wallet, and the only correct copy was gone.

    PROVEN AGAINST systemd, not argued. While this was written it was
    fuzzed against systemd 255's own load_env_file (libsystemd-shared,
    through ctypes) over 200,000 generated files, with no difference; the
    answers measured from that function are pinned as data in
    tests/test_wake_agent.py, so every box runs them, library or not.

    REFUSES, with ValueError naming a LINE and never a value, in the cases
    where systemd refuses the file or where versions disagree:

      * a NUL byte, or a Unicode noncharacter in a key or a value --
        load_env_file fails the whole file (EBADMSG, EINVAL), so the unit
        never started with it and there is no value to be faithful to;
      * a comment line ending in a backslash WHERE IT MATTERS. From v254
        the next line is read as a line of its own; before v254 it was
        swallowed into the comment. Debian 12 ships 252, so the same file
        can give the unit a secret on one box and not on another, and
        which one this box runs is not something to guess about a seed.
        The file is read both ways and refused only if the two differ: a
        backslash before another comment or a blank line changes nothing,
        and refusing it sent the operator to fix a difference that was
        not there.

    Invalid UTF-8 is the caller's to refuse: this takes text.
    """
    _seen = []
    out = _parse_env_core(text, False, _seen)
    if _seen:
        try:
            _old = _parse_env_core(text, True, None)
        except ValueError:
            _old = None
        if _old != out:
            raise ValueError(
                f"line {_seen[0]} is a comment ending in a backslash, and "
                f"systemd before v254 reads the line after it as more "
                f"comment while v254 and later read it as a line of its "
                f"own -- here that changes what the unit is given. Remove "
                f"the trailing backslash")
    return out


def _parse_env_core(text: str, legacy: bool, seen) -> dict:
    """parse_env_file's state machine. `legacy` reads a comment's trailing
    backslash as systemd before v254 did; `seen` collects the lines where
    that rule applied."""
    if "\x00" in text:
        _ln = text[:text.index("\x00")].count("\n") + 1
        raise ValueError(f"line {_ln} holds a NUL byte, which systemd "
                         f"refuses the whole file for")
    out = {}
    state = "PRE_KEY"
    key, value = [], None
    last_key_ws = last_value_ws = None
    line = 1

    def push():
        k = "".join(key[:last_key_ws] if last_key_ws is not None else key)
        v = "".join(value or [])
        if _sd_rejects(k) or _sd_rejects(v):
            raise ValueError(f"the assignment ending on line {line} holds a "
                             f"Unicode noncharacter, which systemd refuses "
                             f"the whole file for")
        out[k] = v

    for c in text:
        if state == "PRE_KEY":
            if c in _SD_COMMENTS:
                state = "COMMENT"
            elif c not in _SD_WHITESPACE:
                state = "KEY"
                last_key_ws = None
                key.append(c)
            elif c in _SD_NEWLINE:
                line += 1
        elif state == "KEY":
            if c in _SD_NEWLINE:
                state = "PRE_KEY"
                line += 1
                key = []
            elif c == "=":
                state = "PRE_VALUE"
                last_value_ws = None
            else:
                if c not in _SD_WHITESPACE:
                    last_key_ws = None
                elif last_key_ws is None:
                    last_key_ws = len(key)
                key.append(c)
        elif state == "PRE_VALUE":
            if c in _SD_NEWLINE:
                push()
                state = "PRE_KEY"
                line += 1
                key, value = [], None
            elif c == "'":
                state = "SINGLE_QUOTE_VALUE"
                value = value if value is not None else []
            elif c == '"':
                state = "DOUBLE_QUOTE_VALUE"
                value = value if value is not None else []
            elif c == "\\":
                state = "VALUE_ESCAPE"
                value = value if value is not None else []
            elif c not in _SD_WHITESPACE:
                state = "VALUE"
                value = value if value is not None else []
                value.append(c)
        elif state == "VALUE":
            if c in _SD_NEWLINE:
                if last_value_ws is not None:
                    del value[last_value_ws:]
                push()
                state = "PRE_KEY"
                line += 1
                key, value = [], None
            elif c == "\\":
                state = "VALUE_ESCAPE"
                last_value_ws = None
            else:
                if c not in _SD_WHITESPACE:
                    last_value_ws = None
                elif last_value_ws is None:
                    last_value_ws = len(value)
                value.append(c)
        elif state == "VALUE_ESCAPE":
            state = "VALUE"
            if c not in _SD_NEWLINE:
                value.append(c)
            else:
                line += 1
        elif state == "SINGLE_QUOTE_VALUE":
            if c == "'":
                state = "PRE_VALUE"
            else:
                if c == "\n":
                    line += 1
                value.append(c)
        elif state == "DOUBLE_QUOTE_VALUE":
            if c == '"':
                state = "PRE_VALUE"
            elif c == "\\":
                state = "DOUBLE_QUOTE_VALUE_ESCAPE"
            else:
                if c == "\n":
                    line += 1
                value.append(c)
        elif state == "DOUBLE_QUOTE_VALUE_ESCAPE":
            state = "DOUBLE_QUOTE_VALUE"
            if c in _SD_NEED_ESCAPE:
                value.append(c)
            elif c != "\n":
                value.append("\\")
                value.append(c)
            else:
                line += 1
        elif state == "COMMENT":
            if c == "\\":
                state = "COMMENT_ESCAPE"
            elif c in _SD_NEWLINE:
                state = "PRE_KEY"
                line += 1
        elif state == "COMMENT_ESCAPE":
            if c in _SD_NEWLINE:
                if seen is not None:
                    seen.append(line)
                line += 1
                state = "COMMENT" if legacy else "PRE_KEY"
            else:
                state = "COMMENT"
    if state in ("PRE_VALUE", "VALUE", "VALUE_ESCAPE", "SINGLE_QUOTE_VALUE",
                 "DOUBLE_QUOTE_VALUE", "DOUBLE_QUOTE_VALUE_ESCAPE"):
        if state == "VALUE" and last_value_ws is not None:
            del value[last_value_ws:]
        push()
    return out


def seal_secrets_cli(args) -> str:
    """--seal-secrets: put the spend secrets behind the pair, by hand.

    THE ONE SETUP STEP THAT CANNOT HAPPEN AT PAIRING, because the secrets
    do not exist yet: the operator writes the seed and the passwords after
    the two boxes are paired (OPSEC_SETUP.md section 5). So this is a
    command they run once, at the machine, with the half from the Pi --
    which means the recovery path is not a habit they are asked to
    remember, it is the habit that installs the feature.

    IT DOES NOT SHRED THE PLAINTEXT. It prints the command. A seal this
    tool wrote and then destroyed the only copy of the seed against would
    be the one failure in this whole design that costs a client's money
    rather than their privacy, and no read-back check is worth betting a
    seed on when the operator can look at the file themselves. Same rule
    as state_close, one step further out.
    """
    key = load_key(Path(args.key))
    pi = _half_bytes(getattr(args, "seal_secrets", ""))
    vault, _ = state_halves(key)
    if vault is None:
        agent_say("  [!] This keyfile carries no state half, so there is no "
                  "pair to seal to. Re-pair both boxes first.")
        return "unsealed"
    if pi is None:
        agent_say(f"  [!] --seal-secrets takes the Pi's half as "
                  f"{proto.STATE_HALF_BYTES * 2} hex characters. Print it "
                  f"with `gs_doorbell state-key` on the Pi.")
        return "bad_half"
    # THE HALF IS CHECKED AGAINST SOMETHING THE REAL ONE OPENS, before
    # anything is sealed under it. It was not: the container was sealed
    # under whatever hex was typed and read back with THE SAME hex, so a
    # half one character off passed the read-back, the operator was told
    # to shred the plaintext, and the next wake -- the Pi sending its real
    # half -- refused secrets_unreadable on every job, with the only copy of
    # the seed on this disk sealed under a key nobody holds. Driven.
    #
    # This machine already holds things sealed under the real half: the
    # keyfile's own settings on every pairing since stage 8, and the record
    # store once any job has run. Either one opening is proof; one failing
    # is a wrong half, a re-pairing, or an altered container -- Poly1305
    # cannot tell those apart, so the refusal names all three.
    #
    # WHAT THIS RESTS ON (AGENTS.md rule 1): the two halves, and nothing
    # else -- it is the same MAC that guards the containers. It is NOT an
    # oracle an adversary gains: they have this code and the seized disk,
    # and can try a candidate half against the same containers directly;
    # this check tells them nothing that trying would not, and a half is 32
    # bytes. What it protects is the OPERATOR from their own typo.
    _checked = ""
    try:
        if key.get(KEYFILE_SEALED) is not None:
            key = open_keyfile(key, vault, pi)
            _checked = "this machine's sealed settings"
        else:
            _store = (Path(key.get("artifact_dir") or ".").resolve()
                      / SEALED_FILE)
            if _store.is_file():
                proto.state_unseal(json.loads(_store.read_text()), vault, pi)
                _checked = "this machine's sealed records"
    except (Refused, proto.WakeError, OSError, ValueError, TypeError):
        agent_say("  [!] That half does not open what this machine has "
                  "already sealed with the Pi's half: it is mistyped, from "
                  "another pairing, or what it was checked against has been "
                  "altered -- there is no telling which from here. Nothing "
                  "was written and the plaintext is untouched. Print it "
                  "again with `gs_doorbell state-key` on the Pi.")
        return "wrong_half"
    src = Path(getattr(args, "secrets_env", "") or SECRETS_ENV_FILE)
    try:
        raw = src.read_bytes()
    except OSError as e:
        agent_say(f"  [!] cannot read {src} ({e.strerror}). That is the "
                  f"EnvironmentFile the unit uses today; point at it with "
                  f"--secrets-env if it is somewhere else.")
        return "no_source"
    # READ EXACTLY AS systemd READS IT, or not at all. Decoded as strict
    # UTF-8 here rather than with read_text(), whose codec is the LOCALE's:
    # under LANG=C that is ASCII, and a password with one accented letter
    # would either fail or -- with a lenient codec -- seal different bytes.
    # Neither refusal below repeats the offending bytes: they are part of a
    # secret, and this prints to a terminal.
    try:
        env = parse_env_file(raw.decode("utf-8"))
    except UnicodeDecodeError as e:
        _ln = raw[:e.start].count(b"\n") + 1
        agent_say(f"  [!] line {_ln} of {src} is not valid UTF-8. This "
                  f"reads only valid UTF-8 (systemd refuses it in any key or "
                  f"value, though not in a comment). Nothing was written.")
        return "unparseable"
    except ValueError as e:
        agent_say(f"  [!] {src} cannot be read the way systemd reads it: "
                  f"{e}. Nothing was written, and the file is untouched.")
        return "unparseable"
    # THE ALLOW-LIST ON THE WAY IN AS WELL AS OUT. An EnvironmentFile can
    # hold anything; only the five this machine actually hands to a child
    # are sealed, so the container cannot become a general-purpose smuggler
    # for whatever else is in that file.
    found = {_n: _v for _n, _v in env.items() if _n in SECRETS_ALLOWED}
    if not found:
        agent_say(f"  [!] {src} names none of the spend secrets "
                  f"({', '.join(SECRETS_ALLOWED)}). Nothing was written.")
        return "nothing_to_seal"
    # WHAT IS ALREADY SEALED IS KEPT, and what this file names replaces it.
    # This replaced the sealed file wholesale -- and every refusal about a
    # missing secret says "add it to the plaintext and re-seal", to an
    # operator who has shredded the plaintext as this command tells them
    # to. So the fee password went in and the seed and the spend password
    # silently came out; the next deposit refused btc_seed_unset with the
    # same advice, which dropped the fee password in turn. Nothing reads
    # the sealed secrets back, so there was no way to rebuild the file.
    # A seal that will not open under this pair is not overwritten: it is
    # another pairing's or altered, and what it holds cannot be carried
    # over -- the operator moves it aside, knowing that.
    out = _secrets_path(args)
    kept = {}
    if out.is_file():
        try:
            _om = proto.state_unseal(json.loads(out.read_text()), vault, pi,
                                     schema=proto.SECRETS_SCHEMA)
            _oi = json.loads(_om[proto.SECRETS_MEMBER])
            if not isinstance(_oi, dict):
                raise ValueError("not an object")
        except (proto.WakeError, KeyError, ValueError, TypeError,
                OSError):
            agent_say(f"  [!] {out} is already here and does not open under "
                      f"this half: "
                      + ("it is another pairing's, or altered"
                         if _checked else
                         "the half is mistyped, or it is another pairing's, "
                         "or altered")
                      + f". Nothing was written. Its contents cannot be "
                        f"carried over without the halves it was sealed "
                        f"under; if it is another pairing's, move it aside "
                        f"and run this again with a plaintext that holds "
                        f"every secret.")
            return "existing_unreadable"
        kept = {_n: _v for _n, _v in _oi.items()
                if _n in SECRETS_ALLOWED and _n not in found}
        _checked = _checked or "the spend secrets already sealed here"
    merged = dict(kept)
    merged.update(found)
    # THE SEED IS PROVEN BEFORE ANYBODY IS TOLD TO SHRED IT. The advice
    # below ends in `shred -u`, and a deposit already refuses a seed that
    # does not derive this pair's xpub (btc_seed_xpub_mismatch) -- so a
    # wrong seed sealed here costs nothing at once and everything later,
    # when the plaintext that might have shown the mistake is gone. Checked
    # the way _prove_btc_seed checks it, offline, from the values about to
    # be sealed; the account key is derived and dropped.
    _seed = ""
    if "GS_BTC_SEED" in merged and key.get("btc_account_xpub") and (
            "GS_BTC_SEED" in found or "GS_BTC_SEED_PASSPHRASE" in found):
        _acct = None
        try:
            import gs_btc_tx as _btx
            try:
                # NOT ON THE VARIABLE-TIME CURVE: with no constant-time
                # library nothing is derived here, and the operator is told
                # why -- "proven" on this box read as ready while every
                # deposit is refused btc_backend_missing.
                _btx.require_native()
            except _btx.BtcTxError:
                raise _NoNativeBackend()
            try:
                _acct = _btx.account_from_mnemonic(
                    merged["GS_BTC_SEED"],
                    str(key.get("btc_network") or "main"),
                    merged.get("GS_BTC_SEED_PASSPHRASE", ""),
                    account=_btc_setting(key, "btc_account", 0, 0,
                                         2 ** 31 - 1))
                _ok = _btx.account_matches_xpub(
                    _acct, str(key["btc_account_xpub"]))
            except _btx.BtcTxError:
                _ok = False
        except _NoNativeBackend:
            _ok = None
            _seed = ("NOT checked: this machine has no constant-time "
                     "libsecp256k1 (the libsecp256k1-1 package), so nothing "
                     "is derived from the seed here -- and every deposit is "
                     "refused until it is installed")
        except Exception as e:                               # noqa: BLE001
            _ok = None
            _seed = f"NOT checked ({type(e).__name__})"
        finally:
            del _acct
        if _ok is False:
            agent_say(f"  [!] GS_BTC_SEED, with the passphrase it would be "
                      f"sealed beside -- {src}'s, and the seal's for any "
                      f"it does not name (none, if neither names one: one "
                      f"set elsewhere in the unit is not in what this "
                      f"seals) -- is not a valid mnemonic or does not "
                      f"derive the account xpub this pair watches. A "
                      f"deposit already refuses this seed; sealing it "
                      f"would only end in advice to shred the one copy "
                      f"you could still check. Nothing was written.")
            return "seed_mismatch"
        if _ok:
            _seed = "proven: it derives this pair's account xpub"
    tmp = out.with_name(out.name + ".new")
    try:
        container = proto.state_seal(
            {proto.SECRETS_MEMBER: json.dumps(merged, sort_keys=True)},
            vault, pi, schema=proto.SECRETS_SCHEMA)
        # READ IT BACK WITH THE SAME TWO HALVES before it is in place, the
        # same rule the store's close and the pairing's own seal follow.
        back = proto.state_unseal(container, vault, pi,
                                  schema=proto.SECRETS_SCHEMA)
        if json.loads(back[proto.SECRETS_MEMBER]) != merged:
            raise ValueError("the sealed copy does not read back")
        # O_EXCL on a fresh name: a stale .new from an earlier run would keep
        # ITS mode through O_TRUNC, and os.replace would carry that mode --
        # 0644, say -- onto the sealed file.
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
        _fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o400)
        with os.fdopen(_fd, "w") as fh:
            json.dump(container, fh, sort_keys=True)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(str(tmp), str(out))
    except Exception as e:                                   # noqa: BLE001
        # "NOTHING WAS WRITTEN" HAS TO BE TRUE. A write that failed part
        # way left the .new file behind, and the sentence below said
        # otherwise.
        try:
            tmp.unlink()
        except OSError:
            pass
        agent_say(f"  [!] the spend secrets could not be sealed "
                  f"({type(e).__name__}). Nothing was written and {src} is "
                  f"untouched.")
        return "seal_failed"
    print()
    print(f"  {len(found)} secret(s) sealed into {out} (0400):")
    for _n in sorted(found):
        print(f"      {_n}")
    if kept:
        print("  and kept, unchanged, from the seal already there:")
        for _n in sorted(kept):
            print(f"      {_n}")
        print("  (To drop one, move the sealed file aside and seal again "
              "from a plaintext that holds every secret you keep.)")
    print()
    print("  They now open only with this pair. The Pi's half was checked "
          "against")
    print(f"  {_checked}." if _checked else
          "  NOTHING: this machine has nothing sealed yet to check it "
          "against,\n  so a mistyped half would only show at the next wake.")
    print()
    # WHICH JOB PROVES WHICH SECRET. "Check the seal works with a real job
    # first" was the whole instruction, and the job an operator reaches for
    # first -- a deposit -- touches the seed and nothing else. A spend
    # password sealed wrong would pass that check and surface at the first
    # withdrawal, after the shred. So the list says what each one needs.
    _proves = {
        "GS_BTC_SEED": _seed or "a deposit (it is proven against the xpub "
                                "before an address is issued)",
        "GS_BTC_SEED_PASSPHRASE": "proven with the seed" if _seed.startswith(
            "proven") else "a deposit, with the seed",
        "GS_WALLET_PASSWORD": "only a WITHDRAWAL opens the spend wallet",
        "GS_FEE_WALLET_PASSWORD": "only a FEE SWEEP opens the fee wallet",
        "GS_SWAPKIT_API_KEY": "a deposit's quote, or a forward that asks "
                              "the aggregator for one",
    }
    print("  The plaintext is STILL there and this tool will not destroy it.")
    print("  Before you shred it, each sealed secret needs the job that")
    print("  actually uses it to have run once from the seal:")
    print()
    for _n in sorted(found):
        print(f"      {_n}: {_proves.get(_n, 'a job that uses it')}")
    print()
    print("  and then:")
    print()
    print(f"      shred -u {src}")
    print("      # and remove the EnvironmentFile= line from the unit")
    print()
    # THE IDLE-BOOT SWEEP CANNOT OPEN THIS. It runs on a boot nothing woke,
    # so no half arrives; it will say so and stand down. Said here, while
    # the operator is present, rather than only in a job log they may not
    # read -- the pairing refuses the flag for a sealed keyfile for the
    # same reason, and this is the step that makes an unsealed one sealed.
    try:
        _fc = fee_sweep_config(key) if "GS_FEE_WALLET_PASSWORD" in found \
            else None
    except Exception:                                        # noqa: BLE001
        _fc = None
    if _fc and _fc.get("on_idle_boot"):
        print("  THE IDLE-BOOT FEE SWEEP WILL STOP RUNNING. It runs on a boot")
        print("  nothing woke, so no half arrives to open the fee wallet's")
        print("  password. Run it by hand instead:")
        print(f"      gs_wake_agent --fee-sweep --unseal-state "
              f"{_key_flag()}")
        print()
    print("  KEEP THE SEED SOMEWHERE ELSE TOO. This seals the copy on this")
    print("  disk; it is not a backup. A re-pairing changes the Pi's half")
    print("  and this file stops opening.")
    return "sealed"


def unseal_key_cli(args) -> str:
    """--unseal-key: print this machine's sealed SETTINGS and stop.

    The recovery path of STAGE8_PLAN.md section 5, and the reason a sealed
    keyfile is not a way to lose a working install: the operator standing
    at the machine, with the half from the Pi or from inside the LUKS USB,
    can read back everything the pairing put away.

    PRINTS, and does not rewrite the keyfile. Putting the settings back in
    the clear would undo the stage silently and leave a box that looks
    paired-for-sealing and is not; if they want that they re-pair, which
    is one command and says what it does. print() rather than agent_say()
    for the same reason the dry run does: this is a terminal somebody is
    reading, not a line for the job log on the disk.
    """
    key = load_key(Path(args.key))
    if key.get(KEYFILE_SEALED) is None:
        agent_say("  [!] This keyfile carries no sealed section: its "
                  "settings are already readable. Nothing to open.")
        return "unsealed"
    try:
        key = _by_hand(key, getattr(args, "unseal_key", ""), "this command",
                       flag="--unseal-key")
    except Refused as e:
        agent_say(f"  [!] {e.msg}")
        return e.code
    _shown = sorted(k for k in key if k not in ("secret", "peer_public"))
    print()
    print("  This machine's settings, out of the sealed section:")
    print()
    for _k in _shown:
        print(f"      {_k} = {key[_k]!r}")
    print()
    # THE TWO SECRETS ARE NOT IN THAT LIST, and it is not squeamishness:
    # this prints to a terminal and very often into a scrollback, and
    # neither of them is what the operator came here for. `secret` is the
    # wake key; `peer_public` is not secret but travels with it.
    print("  The wake keypair is not shown. Nothing here is written back:")
    print("  re-pair if you want these readable on the disk again.")
    return "opened"


def build_cli() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description="Collect one job from the doorbell, run it, power off.")
    ap.add_argument("--key", required=True, help="the ThinkPad keyfile (0400)")
    ap.add_argument("--fee-sweep", action="store_true",
                    help="do not ask the doorbell for a job: mix what has "
                         "gathered on the fee wallet to the addresses the "
                         "keyfile names, if it clears the threshold, then "
                         "stop. A sweep that RUNS powers the machine off "
                         "when it ends, like a wake -- it takes hours, and "
                         "nobody may be here by then -- unless the inhibit "
                         "file (.gs_wake_inhibit in the artifact directory) "
                         "is there by then: touch it WHILE it runs, not "
                         "before (preflight refuses to start with it "
                         "there). A refusal keeps the machine on. With "
                         "--dry-run, say whether it would.")
    ap.add_argument("--unseal-state", metavar="HEX", nargs="?", const=HALF_ASK,
                    default=None,
                    help="open this machine's sealed records BY HAND and "
                         "leave them as plaintext, then stop: no job, no "
                         "doorbell, no power-off. Asks for the Pi's half of "
                         "the key -- `gs_doorbell state-key` prints it on "
                         "the Pi -- without echoing it; give HEX here only "
                         "if you accept it landing in shell history. For the case the records must be read "
                         "with no Pi to wake this box -- the card is dead "
                         "and a deposit still has to be paid out. They are "
                         "sealed again by the next ordinary wake. Also what "
                         "--fee-sweep takes when this machine's SETTINGS are "
                         "sealed too: that boot has no note, so nothing "
                         "brings it a half.")
    ap.add_argument("--seal-secrets", metavar="HEX", nargs="?", const=HALF_ASK,
                    default=None,
                    help="put this machine's spend secrets -- the BTC seed, "
                         "the wallet passwords, the aggregator key -- behind "
                         "the pair, then stop. HEX is the Pi's half, the same "
                         "one --unseal-state takes. Reads the unit's "
                         "EnvironmentFile once and writes a sealed file "
                         "beside it; it does NOT destroy the plaintext, it "
                         "prints the command. Run this once, after pairing, "
                         "at the machine.")
    ap.add_argument("--secrets-env", metavar="PATH", default="",
                    help=f"where the plaintext secrets are now (default "
                         f"{SECRETS_ENV_FILE}). Only --seal-secrets reads it.")
    ap.add_argument("--secrets-file", metavar="PATH", default=SECRETS_FILE,
                    help=f"the sealed spend secrets (default {SECRETS_FILE}). "
                         f"Absent means this box still uses the unit's "
                         f"EnvironmentFile, which is how every install from "
                         f"before this stage keeps working.")
    ap.add_argument("--unseal-key", metavar="HEX", nargs="?", const=HALF_ASK,
                    default=None,
                    help="print this machine's sealed SETTINGS and stop -- "
                         "the xpub, the servers, the fee destinations, the "
                         "switches. HEX is the same half --unseal-state "
                         "takes. Nothing is written back: this reads a "
                         "keyfile, it does not un-seal one.")
    ap.add_argument("--dry-run", action="store_true",
                    help="check the keyfile, preflight, Tor and that the "
                         "doorbell answers — then STOP, without asking for a "
                         "job and without powering off. It cannot ask: the "
                         "handover is at-most-once, so asking takes the job. "
                         "It therefore does not prove the two keyfiles are a "
                         "matched pair; the first real poke does that.")
    return ap


#: What the three half-taking flags hold when given with no value: ask.
HALF_ASK = "-"


def _ask_half(flag: str) -> str:
    """The Pi's half, typed at a prompt that does not echo -- or one line
    from stdin when it is piped (`gs_doorbell state-key` on the Pi, carried
    over by hand, or through a pipe the operator trusts).

    NEVER ON THE COMMAND LINE IF IT CAN BE HELPED (the review of the
    uncovered dimensions). On argv it lands in the shell's history file on
    this disk -- the disk that unlocks itself, the one the seal exists for
    -- and in /proc/<pid>/cmdline, world-readable, for as long as the run
    lasts: a hand fee sweep is hours. With the half and this disk, the
    sealed store, the sealed settings and the sealed seed all open."""
    import getpass
    import signal
    # CTRL-C MUST END THE PROMPT (the review of this pass). main() installs
    # the stop handlers first, and they only record the signal -- so a
    # Ctrl-C here set a flag while getpass went on waiting. Python's own
    # handler is put back for the length of the prompt: the interrupt
    # raises, and the command refuses for want of a half, box kept on.
    try:
        _prev_int = signal.signal(signal.SIGINT, signal.default_int_handler)
    except (ValueError, OSError):
        _prev_int = None
    try:
        if sys.stdin is not None and sys.stdin.isatty():
            return getpass.getpass(f"  The Pi's half for {flag} "
                                   f"(64 hex, not echoed): ").strip()
        return (sys.stdin.readline() if sys.stdin else "").strip()
    except (EOFError, KeyboardInterrupt, OSError):
        return ""
    finally:
        if _prev_int is not None:
            try:
                signal.signal(signal.SIGINT, _prev_int)
            except (ValueError, OSError):
                pass


def _halves_from_prompt(args) -> None:
    """Resolve the half-taking flags once, in main(): HALF_ASK is asked
    for; a value typed on argv is used, and the operator is told where it
    now is. Nothing here repeats the value."""
    for _attr, _flag in (("unseal_state", "--unseal-state"),
                         ("seal_secrets", "--seal-secrets"),
                         ("unseal_key", "--unseal-key")):
        _v = getattr(args, _attr, None)
        if _v is None:
            continue
        if _v == HALF_ASK:
            setattr(args, _attr, _ask_half(_flag))
        elif str(_v).strip():
            agent_say(f"  [!] The Pi's half was given ON THE COMMAND LINE "
                      f"({_flag} <hex>): it is in this shell's history on "
                      f"this disk, and readable in /proc while this runs. "
                      f"Remove it from the history now, and next time give "
                      f"{_flag} with no value -- it asks, without echo.")


def main(argv=None) -> int:
    install_signal_handlers()
    _STOP_SIGNAL.update(term=False, int=False, said=False)
    _install_stop_kinds()
    _SEAL_OUTCOME[0] = None
    _RUNNING[0] = ""
    args = build_cli().parse_args(argv)
    _halves_from_prompt(args)
    code = "unknown"
    #: Set by a Refused(power=False): the machine stays on. Read by the
    #: finally, which is the one place the power-off is decided.
    _keep_on = False
    try:
        try:
            # THE THREE HAND COMMANDS NEVER POWER THE MACHINE OFF, and the
            # flag that says so is set BEFORE each one runs, not after it
            # returns. It was after, which kept the promise only for the
            # paths that returned: load_key and state_halves sit above each
            # command's own try, so a keyfile with a malformed half raised
            # Refused straight past it, and the finally below powered the
            # box off under the operator standing at it, mid-recovery.
            # Driven, before this fix: --unseal-state and --seal-secrets
            # both called power_off on a keyfile whose state_half is not
            # hex. Set first, the promise holds for a refusal and a crash.
            # --unseal-state IS TWO THINGS: a command of its own, and the
            # half that --fee-sweep and --dry-run take on a sealed box. With
            # either beside it, it is the second. This branch used to win whenever
            # the flag was present, so the exact command every refusal and
            # OPSEC_SETUP.md name for a sealed box's sweep -- `--fee-sweep
            # --unseal-state <hex>` -- never swept anything: it wrote every
            # sealed record out in plaintext and stopped. Driven.
            # `is not None`, not truthiness: an EMPTY value -- a shell
            # variable that was never set, `--seal-secrets "$HALF"` -- is
            # still the hand command, refused for its bad half with the box
            # kept on. Truthiness read it as no flag at all and ran a full
            # wake: the doorbell asked, a job taken.
            if getattr(args, "unseal_state", None) is not None \
                    and not getattr(args, "fee_sweep", False) \
                    and not getattr(args, "dry_run", False):
                # NOTHING ELSE RUNS ON THIS PATH, and it never powers the
                # machine off: the operator is standing here, with the
                # records open in front of them, which is the whole point.
                _keep_on = True
                code = unseal_state_cli(args)
                return 0 if code == "opened" else 1
            if getattr(args, "seal_secrets", None) is not None:
                # SETUP, not recovery, but the same posture: the operator is
                # at the machine, nothing is woken and nothing powers off.
                _keep_on = True
                code = seal_secrets_cli(args)
                return 0 if code == "sealed" else 1
            if getattr(args, "unseal_key", None) is not None:
                # SAME PATH, SAME REASON as --unseal-state above: the
                # operator is at the machine and nothing is woken or
                # powered off. Ordered after it so that passing both
                # opens the records first, which is the one somebody in
                # a hurry actually needs.
                _keep_on = True
                code = unseal_key_cli(args)
                return 0 if code == "opened" else 1
            if getattr(args, "fee_sweep", False):
                code = run_fee_sweep_cli(args)
                agent_say(f"  [+] Fee sweep finished: {code}.")
                return 0
            code, _status, _handle = run_once(args)
            agent_say(f"  [+] Wake finished: {code}.")
            return 0
        except Refused as e:
            code = e.code
            agent_say(f"  [!] Wake refused ({e.code}): {e.msg}")
            integrity_log("wake", f"refused:{e.code}")
            if not e.power:
                # The cases where a human is demonstrably present or the
                # box is theirs to keep on (Refused.power=False). Disarm the
                # deadman so the machine they are using does not go down
                # under them -- and REMEMBER IT for the finally below, which
                # used to re-decide from a hand-typed pair of codes and
                # powered the machine off anyway on every other one.
                _keep_on = True
                disarm_deadman()
                return 0
            return 1
        except Stopping as e:
            # systemd is taking the unit down (the deadman, a timeout, a
            # `systemctl stop`), or a person pressed Ctrl-C. Sealed HERE,
            # before a word is said about it, so that the word is true: the
            # message is built from what the seal did, and names a job only
            # when one was taken. It said "Stopped mid-job ... The records
            # are sealed" on every path -- the no-job dwell, a hand fee
            # sweep, and right after the line saying the seal had failed.
            code = "stopped"
            _seal_state_now()
            _by_person = _STOP_SIGNAL["int"] and not _term_asked()
            _said = {"sealed": " The records are sealed.",
                     "failed": " The records could NOT be sealed (above).",
                     }.get(_SEAL_OUTCOME[0], "")
            if _RUNNING[0]:
                _said += f" {_RUNNING[0]} did not finish."
            if _by_person:
                # Somebody is at this terminal (the finally below keeps the
                # machine on for them).
                _said += " This machine stays on."
            agent_say(f"  [!] Stopped: {e}.{_said}")
            integrity_log("wake", "interrupted" if _by_person else "stopped")
            return 1
        except proto.WakeError as e:
            code = "bad_note"
            agent_say(f"  [!] Wake refused: {e}")
            integrity_log("wake", "refused:bad_note")
            return 1
        except Exception as e:                               # noqa: BLE001
            # NOT a catch-and-continue: it re-raises, so the finally below
            # still powers off exactly as it did when this was unhandled. The
            # only thing that changes is that the reason is written down --
            # under StandardOutput=null an unhandled traceback went to a null
            # stderr and the machine powered off silently.
            code = "crash"
            agent_say(f"  [!] Wake FAILED, unhandled "
                      f"{type(e).__name__}: {terminal_safe(str(e))}")
            agent_say(traceback.format_exc())
            try:
                integrity_log("wake", "crash")
            except Exception:                                # noqa: BLE001
                pass
            raise
    finally:
        # THE RECORDS GO BACK IN THE STORE BEFORE THE POWER DOES (STAGE7).
        # Here, in the finally, because every other path out of this
        # function -- a refusal, a crash, a fail-closed abort from
        # gs_common -- ends with the machine off and the directory on a
        # disk that unlocks itself. A run that never opened the store
        # (no half in the keyfile, or a refusal before the note) leaves
        # _STATE_KEY empty and this does nothing.
        #
        # FAILS THE OTHER WAY FROM state_open, and it must: an unsealed
        # directory is a privacy loss the operator can still fix, while a
        # shred whose ciphertext never landed is a client's money with no
        # bookkeeping. state_close returns -1 rather than raising, and
        # says so.
        # A CLEAN RUN'S LOG IS SHREDDED BEFORE THE SEAL, or the seal would
        # keep what retire_job_log exists to destroy. A run that went wrong
        # keeps it, and the seal puts it away (SEALED_GLOBS).
        retire_job_log(code, args.dry_run)
        _seal_state_now()
        # THE SECRETS GO FROM RAM HERE, on every path out. The machine is
        # about to power off, which clears them anyway -- but --dry-run, the
        # hand commands and a refusal that keeps the box on all return
        # through this finally without powering anything off, and a seed
        # left in a module dict in a process that keeps running is a seed
        # one bug away from a log line. (A hand --fee-sweep that RAN does
        # power off, unless the inhibit file is there -- see its --help.
        # This comment said it did not, which the review of the uncovered
        # dimensions caught.)
        _SECRETS.clear()
        _SECRETS_FROM[0] = None
        # EVERY path, including SystemExit from gs_common's own fail-closed
        # aborts, and including an unhandled exception.
        #
        # AND THE GUARDS ARE RE-READ HERE, because this is the instant the
        # decision is taken and every earlier read is stale by minutes or by
        # hours. `code` is a verdict reached at preflight, or between two
        # steps of a job that mostly has one step -- see somebody_is_here.
        # Powering the machine off under somebody who is using it is the one
        # failure this feature must not introduce, and it is worth one stat
        # and one socket bind on every path to avoid it.
        # A CTRL-C IS SOMEBODY AT THIS TERMINAL -- the one stop that is not
        # systemd's -- and it is not a request to power off the machine
        # under the person who pressed it. Here, not only in the Stopping
        # handler: a Ctrl-C during the last step lets that step finish, and
        # then nothing is left to raise.
        if not _keep_on and _STOP_SIGNAL["int"] and not _term_asked():
            agent_say("  [!] Ctrl-C was pressed at this terminal: NOT "
                      "powering off.")
            _keep_on = True
            disarm_deadman()
        if not _keep_on:
            _late = somebody_is_here()
            if _late:
                agent_say(f"  [!] {_late} NOT powering off.")
                try:
                    integrity_log("wake", "inhibited_at_poweroff")
                except Exception:                            # noqa: BLE001
                    # Bookkeeping must never be the thing that powers the box
                    # off under a person. This branch exists not to.
                    pass
                disarm_deadman()
            else:
                power_off(dry_run=args.dry_run)


