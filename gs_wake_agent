class Stopping(BaseException):
    """systemd asked this unit to stop while a job was running.

    WHY THIS EXISTS. gs-wake-poweroff.service -- the deadman's action, and
    OnFailure's -- says "stop the job cleanly, then power off": SIGTERM, 20
    seconds, SIGKILL. gs_common's handler only RECORDS a SIGTERM (a handler
    that does work deadlocked on the chain's flock; see _shutdown_handler),
    and nothing in this file ever read the record. So the SIGTERM did
    nothing, the SIGKILL landed, main()'s finally never ran, and the records
    the store had opened stayed in PLAINTEXT on a machine that was then off
    -- the exact seizure stage 7 exists for, on every overrun, every
    TimeoutStartSec, every `systemctl stop`. Driven: a wake with its store
    open and a real child running ignored SIGTERM for as long as it was
    watched, and after the SIGKILL a client's record sat on the disk.

    A BaseException, so no `except Exception` on the way up can swallow it
    and carry on to the next step; main() catches it by name. It is raised
    only where the agent waits (run_child, _nap), never from the handler.
    """


#: How long a child gets to stop after the agent notices a stop request.
#: The child has already had systemd's SIGTERM (`systemctl kill` signals the
#: whole unit); this is its grace before the agent kills it, so that the
#: directory is quiet when the records are sealed. Sized to the poweroff
#: unit's 20-second window: noticed within a second, 10 for the child, a
#: second or two to reap it, and the seal -- milliseconds -- with room to
#: spare before the SIGKILL. The child used to get the whole 20 and then
#: take the unsealed records down with it.
STOP_CHILD_GRACE_S = 10


#: WHICH stop was asked for. gs_common's handler sets one flag for SIGINT
#: and SIGTERM alike, and they are not the same request: SIGTERM is systemd
#: (the deadman, a timeout, `systemctl stop`), which will SIGKILL the unit
#: 20 seconds later whatever this does; SIGINT is a person at the terminal
#: pressing Ctrl-C, often only to stop output scrolling. Treated as one, a
#: Ctrl-C during a hand `--fee-sweep` SIGTERMed the mix, SIGKILLed it ten
#: seconds later -- the one thing here with no automatic recovery -- and
#: then powered the machine off under the person who pressed it.
_STOP_SIGNAL = {"term": False, "int": False, "said": False}


def _install_stop_kinds() -> None:
    """Record which signal asked, then do exactly what gs_common's handler
    does -- it stays the one that sets the flag and queues the chain line,
    and it still never blocks."""
    import signal
    for _sig, _kind in ((signal.SIGTERM, "term"), (signal.SIGINT, "int")):
        _prev = signal.getsignal(_sig)

        def _h(signum, frame, _kind=_kind, _prev=_prev):
            _STOP_SIGNAL[_kind] = True
            if callable(_prev):
                _prev(signum, frame)
        signal.signal(_sig, _h)


def _term_asked() -> bool:
    """A stop that ends a RUNNING CHILD: systemd's. A flag set with no kind
    recorded -- a handler installed before main()'s, a test -- is read as
    systemd's, the stricter of the two."""
    return _STOP_SIGNAL["term"] or (shutdown_requested()
                                    and not _STOP_SIGNAL["int"])


def _stop_if_asked() -> None:
    """Raise Stopping if a stop was asked for. Either kind: nothing new
    starts after a Ctrl-C either -- it is the running child that only
    systemd's stop ends (run_child)."""
    if _term_asked():
        raise Stopping("the unit was asked to stop")
    if _STOP_SIGNAL["int"]:
        raise Stopping("interrupted at the terminal (Ctrl-C)")


def _nap(seconds) -> None:
    """time.sleep that a stop request ends. A plain sleep does not: PEP 475
    resumes it after a handler that only records the signal, so a SIGTERM
    during the jitter or a result-post backoff was noticed minutes late --
    after the SIGKILL. In slices of at most a second."""
    _end = time.monotonic() + max(0.0, float(seconds))
    while True:
        _stop_if_asked()
        _left = _end - time.monotonic()
        if _left <= 0:
            return
        time.sleep(min(1.0, _left))


class Refused(Exception):
    """A reason not to run. Carries the operator-facing text."""

    def __init__(self, code: str, msg: str, power: bool = True):
        super().__init__(msg)
        self.code = code
        self.msg = msg
        #: False where a human is demonstrably present (an inhibit file, a
        #: mix already running on the console) or the box is theirs to keep
        #: on (a dry run, a hand-run fee sweep with nothing configured).
        #: main() reads it ONCE, into the flag its finally decides on.
        self.power = power


# ---------------------------------------------------------------------------
#  Injectable process boundaries. Tests replace these MODULE ATTRIBUTES; that
#  only works because everything below calls through the module, so no
#  `from time import sleep` anywhere in this file.
# ---------------------------------------------------------------------------
def power_off(dry_run: bool = False) -> bool:
    """Turn this machine off. Returns True if the command was accepted.

    NEVER print "powering off" before checking. An unchecked call that failed
    while the message said it succeeded is this repo's most-repeated defect,
    and here it would leave the vault running while the operator believed it
    was down.
    """
    if dry_run:
        print("  [*] --dry-run: NOT powering off. In a real wake this is where "
              "the machine goes down.")
        return False
    # --no-block. This process IS gs-wake-agent.service, and systemd's
    # shutdown transaction stops that unit -- so a BLOCKING `systemctl
    # poweroff` waits for a transaction that is waiting for this process,
    # until the SIGTERM lands in the middle of the call. Queue it and return.
    # "Accepted", which is what this function's contract already says, is the
    # honest reading either way; --no-block is the one that does not hang.
    for cmd in (["systemctl", "--no-block", "poweroff"], ["poweroff"]):
        try:
            r = subprocess.run(cmd, timeout=60)
            if r.returncode == 0:
                return True
        except Exception:                                    # noqa: BLE001
            continue
    # Deliberately not "Powering off." -- say what is true.
    print("  [!] COULD NOT POWER OFF: this machine is still ON. The deadman "
          "timer should take it down; if it does not, shut it down by hand.")
    integrity_log("wake", "poweroff_failed")
    return False


def unit_is_active(unit: str) -> bool:
    try:
        r = subprocess.run(["systemctl", "is-active", "--quiet", unit],
                           timeout=30)
        return r.returncode == 0
    except Exception:                                        # noqa: BLE001
        return False


def disarm_deadman(runner=None, ext: bool = True) -> bool:
    """Stop the backstops. True only if the shipped one really stopped.

    `ext` EXISTS BECAUSE WIDENING THIS WITHOUT IT BROKE THE THING IT FIXED.
    extend_deadman's whole shape is arm-verify-disarm: it starts the long
    transient timer, verifies it is active, and only THEN stops the short one,
    so there is never an instant with no backstop. It does that by calling
    this function -- so a version of this that always stops the ext units
    armed the long backstop, verified it, stopped it, and returned True. A
    withdrawal then ran for up to sixteen hours with NOTHING to power the
    machine off: the always-on vault this whole feature exists to end, reached
    by the fix for the opposite bug. Driven, the recorded argv was
    `systemd-run --unit=gs-wake-deadman-ext` followed immediately by
    `systemctl stop gs-wake-deadman-ext.timer`.

    IT STOPPED ONE OF TWO. extend_deadman starts a transient
    gs-wake-deadman-ext timer for a spending job -- up to result_budget_s +
    600, which for a withdrawal is over sixteen hours -- and DEADMAN_EXT_UNIT
    appeared in exactly three places in this file: the name, the systemd-run
    that starts it, and the is-active that verifies it started. Nothing ever
    stopped it.

    So the refusal whose entire purpose is "somebody is at the machine, do NOT
    power off" powered the machine off anyway, hours later, by a timer nobody
    had disarmed. The caller that needs the WIDE form is main()'s
    Refused(power=False) path -- the one whose message says "NOT powering
    off", after which main() returns 0 believing it. The caller that needs the
    NARROW one is extend_deadman, above.

    THE STOPS ARE CHECKED NOW. This discarded returncode entirely, so a stop
    that failed looked exactly like one that worked -- and the arm half is
    verified with unit_is_active under a comment calling it "the one check
    standing between a four-hour spend and no backstop at all". The disarm is
    the same decision pointing the other way and had no check at all.

    THE .service GOES WITH THE .timer. systemd-run --unit=NAME creates
    NAME.timer AND NAME.service; stopping only the timer leaves a queued
    service that can still fire. Stopping a unit that does not exist is not an
    error worth reacting to -- systemctl returns non-zero and the caller's
    only use for that is to refuse a job it was going to refuse anyway.
    """
    _run = runner or (lambda argv: subprocess.run(argv, timeout=30))
    _units = (DEADMAN_UNIT,) + ((f"{DEADMAN_EXT_UNIT}.timer",
                                 f"{DEADMAN_EXT_UNIT}.service") if ext else ())
    ok = True
    for _u in _units:
        try:
            r = _run(["systemctl", "stop", _u])
            # THE EXT UNITS MAY LEGITIMATELY NOT EXIST -- they are transient
            # and only a spending job creates them -- so their absence is not
            # a failure to report. The SHIPPED timer is always installed, and
            # a failed stop of that one is the case worth returning False for.
            if _u == DEADMAN_UNIT and getattr(r, "returncode", 0) != 0:
                ok = False
        except Exception:                                    # noqa: BLE001
            if _u == DEADMAN_UNIT:
                ok = False
    return ok


#: ACCOUNTS A MIX MINTS ON THE WALLET IT RUNS FROM, beyond its outputs.
#:
#: GhostSpiral mints one wallet account per mix output -- `wallets` of them
#: plus randint(DECOY_MIN, DECOY_MAX) decoys (GhostSpiral.DECOY_MAX = 7) --
#: and, in receive mode, one veil carrier for the entry and one account for
#: the change sweep. Seven plus two, worst case; a test pins the seven to
#: GhostSpiral's own constant so this cannot drift from it.
MIX_EXTRA_ACCOUNTS = 7 + 2


def worst_mix_accounts(depth) -> int:
    """The most accounts one withdrawal at `depth` can add to the wallet."""
    return int(withdraw_wallets(depth)) + MIX_EXTRA_ACCOUNTS


def deposit_reserve_accounts() -> int:
    """What one admitted deposit reserves against the account ceiling: its own
    receive account plus the deepest mix the phone can ask for. The deepest,
    because the depth is chosen at withdrawal time and the reserve is made
    at deposit time; a smaller figure would be a promise the wallet could not
    keep for a client who then chose twenty hops."""
    return 1 + worst_mix_accounts(max(proto.WITHDRAW_DEPTHS))


def withdraw_wallets(depth) -> int:
    """How many mix outputs a WITHDRAW composes, for one chosen depth.

    A LOOKUP IN A CLOSED TABLE, not arithmetic on the note's value. This was
    `WITHDRAW_WALLETS = 10`, one pinned number for every withdrawal, deciding
    for the operator both how long their vault sits powered on with an
    unlocked spend wallet (6.1 h at three hops against 12.9 h at twenty) and,
    on a deposit small enough that the cut is waived, how little could be
    mixed at all.

    THE SECOND EFFECT IS SMALLER THAN THIS DOCSTRING FIRST CLAIMED. It said
    the tool "would not move anything under 0.2936 XMR" at ten hops against
    0.1748 at three -- real figures, measured with no operator cut, which was
    only true of this path because --usage-fee was never being passed. With
    the cut on, the cut's spendability floor sets the minimum flat up to about
    fifteen hops. gs_wake_proto.WITHDRAW_DEPTHS carries the full correction.

    It is a table and not an int off the wire because the budget in
    gs_wake_proto is sized from the deepest row of that same table: any depth
    the note can name is a depth the vault can finish, and a depth outside it
    would be a run that run_child SIGKILLs mid-spend. The schema bounds it
    too (_int_range(1, 3)); this is the second of the two, on the side that
    holds the money, and it raises rather than defaulting -- a KeyError here
    would be caught and reported, but a silent fallback to some default depth
    would spend at a hop count nobody chose.

    EXACT, and deliberately not `int(depth)`. Coercing first accepts 2.5 as
    depth 2 and True as depth 1, rounding to a hop count the operator did not
    pick, on the one job that spends. The schema refuses both already; this
    refuses them again rather than trusting that it did, which is the whole
    reason for checking twice.
    """
    if isinstance(depth, bool) or not isinstance(depth, int) \
            or depth not in proto.WITHDRAW_DEPTHS:
        raise Refused(
            "bad_depth",
            f"the note asked for mixing depth {depth!r}, which is not one of "
            f"{sorted(proto.WITHDRAW_DEPTHS)}. The vault's budget is sized "
            f"from that table, so a depth outside it is a run that gets "
            f"killed part way through spending.")
    return proto.WITHDRAW_DEPTHS[depth][0]

#: The transient timer extend_deadman starts. Named so a human can find it.
DEADMAN_EXT_UNIT = "gs-wake-deadman-ext"

#: HAS ANY CHILD PROCESS STARTED ON THIS RUN?
#:
#: run_once's handler tells the doorbell "refused" for EVERY exception raised
#: inside _run_validated, and the pager renders "refused" as, verbatim:
#:
#:     "refused before it started - nothing was spent and nothing moved."
#:
#: That is the single sentence in this toolchain that promises, with no hedge,
#: that the money did not move. It is true of the refusals it was written for
#: -- a replayed job_id, the 24 h budget, the account ceiling, a Tor check
#: that aborts -- all of which happen before any tool runs.
#:
#: It is FALSE for two other paths that reach the same handler:
#:
#:   * A withdrawal that ran to completion and then hit an ordinary error in
#:     the fifteen lines of bookkeeping after it -- an OSError off a full or
#:     read-only artifact disk, an integrity_log append that re-raises. The
#:     mix has run. The money has moved. The operator is told it did not, and
#:     there is no second report, because the crash is before report_back.
#:   * A multi-step job refused BETWEEN steps: receive_and_quote mints an
#:     address in step 1, the operator touches the inhibit file, and step 2 is
#:     refused. Step 1 ran.
#:
#: A list, in the module, in the same idiom as _DOORBELL: _dispatch sets it
#: immediately before the first run_child and run_once clears it on the way
#: in, so it means "on THIS run" and not "ever".
_CHILD_STARTED = [False]


def extend_deadman(seconds: int, runner=None, is_active=None) -> bool:
    """Arm a LONGER backstop for one job. True only if it is really armed.

    WHY NOT JUST MAKE THE SHIPPED TIMER LONGER. It is armed at boot, before any
    job is known, so lengthening it to cover the slowest job lengthens it for
    every wake -- including the five-minute status probe. A vault sitting
    powered on for four and a half hours because its agent died during a
    two-minute job is the power and network signature this whole design exists
    to avoid. The backstop should fit the job that was actually collected.

    ARM FIRST, DISARM SECOND, and never the other way round. The new timer is
    started and then VERIFIED active before the short one is stopped, so there
    is no instant with no backstop at all. If anything fails, the short timer
    is left exactly as it was and this returns False -- the caller refuses the
    job, which is the safe end: a refused job is a wake wasted, and a long job
    under a short deadman is the vault powering off mid-round, which
    GhostSpiral says it cannot recover from automatically.

    A TRANSIENT UNIT rather than a second shipped one, because the delay is a
    property of the job and systemd timer units cannot take one at start time.
    It starts the SAME gs-wake-poweroff.service the shipped timer does, so the
    SIGTERM-then-SIGKILL ordering that lets the finally blocks erase the plans
    is unchanged.
    """
    _run = runner or (lambda argv: subprocess.run(
        argv, timeout=30, capture_output=True))
    try:
        r = _run(["systemd-run", f"--on-active={int(seconds)}",
                  f"--unit={DEADMAN_EXT_UNIT}",
                  "--timer-property=AccuracySec=30s",
                  "systemctl", "start", "gs-wake-poweroff.service"])
        if getattr(r, "returncode", 1) != 0:
            return False
        # VERIFIED, not assumed. systemd-run can exit 0 having queued a job
        # that then fails to start, and this is the one check standing between
        # a four-hour spend and no backstop at all.
        # unit_is_active, the MODULE-level helper. The first version of this
        # called `_unit_active`, which is a local inside preflight() -- so the
        # one check standing between a four-hour spend and no backstop would
        # have raised NameError at runtime, been swallowed by the except
        # below, and returned False on every call. Fail-closed by accident is
        # still a check that never passes; found by driving it.
        if not (is_active or unit_is_active)(f"{DEADMAN_EXT_UNIT}.timer"):
            return False
    except Exception:                                        # noqa: BLE001
        return False
    # ARM VERIFIED ABOVE, DISARM VERIFIED HERE. This returned True whatever
    # the stop did. A failed stop leaves the SHIPPED 9300 s timer armed across
    # a job budgeted for up to 58200 s -- the vault powering off mid-round,
    # which GhostSpiral says it cannot recover from automatically -- and the
    # caller was told the backstop had been swapped. Returning False sends the
    # caller to `deadman_too_short`, which refuses the job: a wasted wake, and
    # the safe end of this choice.
    # THE SAME RUNNER, so the whole function is drivable without systemd. It
    # was injected for the ARM and not for the disarm, which meant the disarm
    # half shelled out for real from inside a test that had injected
    # everything else -- and once this function's answer depends on it, a
    # half-injected helper is a test that passes on a box with no systemd for
    # the wrong reason.
    # ext=False, AND THAT IS THE WHOLE POINT OF THE FLAG. The long timer was
    # armed four lines up and verified two lines up; stopping it here would be
    # stopping the backstop this function exists to install.
    if not disarm_deadman(runner=_run, ext=False):
        return False
    return True


def removable_devices() -> list:
    """Block devices the kernel marks removable.

    OPSEC_SETUP.md §4: "Spend USB left in the laptop -> No -- you blew the
    split." A woken box must not be a box with custody on it. Read from
    /sys/block, which is the kernel's own answer -- not from udisks policy,
    which is not reliably introspectable from here, so this never claims
    "removable media cannot be mounted".
    """
    out = []
    for p in glob.glob("/sys/block/*/removable"):
        try:
            if Path(p).read_text().strip() != "1":
                continue
        except OSError:
            continue
        # AN EMPTY SLOT IS NOT A DEVICE. A built-in SD reader with no card in
        # it publishes removable=1 permanently, so the first version refused
        # EVERY boot on any ThinkPad that has one -- a check that fails closed
        # so hard the feature never runs is a broken feature, not a strict one.
        # `size` is in 512-byte sectors and reads 0 when there is no medium.
        # An unreadable size still counts as present: this errs toward
        # refusing, which is the right direction when custody is the question.
        try:
            if (Path(p).parent / "size").read_text().strip() == "0":
                continue
        except OSError:
            pass
        out.append(Path(p).parent.name)
    return out


def tor_bootstrapped(proxy_url: str) -> bool:
    """Is THIS machine's own Tor up?

    Checked before M1 so a Tor-down boot never consumes the job. This is a
    local liveness probe, not an exit test: the full verify_tor() runs after
    the jitter, and doing a real exit request here would put boot-time Tor
    traffic on the wire at exactly the moment the jitter exists to decorrelate.
    """
    m = re.match(r"^socks5h?://(?:[^@]*@)?([^:/]+):(\d+)", proxy_url or "")
    if not m:
        return False
    import socket
    try:
        with socket.create_connection((m.group(1), int(m.group(2))), timeout=10):
            return True
    except OSError:
        return False


def post_record(url: str, path: str, record: bytes, timeout: int = 30) -> tuple:
    """POST one record to the doorbell. Returns (status, body).

    urllib, not requests: this runs before the job and a hard dependency here
    would be one more thing that can fail between boot and power-off.
    """
    import urllib.request
    import urllib.error
    req = urllib.request.Request(url.rstrip("/") + path, data=record,
                                 method="POST")
    req.add_header("Content-Type", "application/octet-stream")
    req.add_header("Content-Length", str(len(record)))
    try:
        with _no_redirect_opener().open(req, timeout=timeout) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, b""
    except Exception:                                        # noqa: BLE001
        return 0, b""


_OPENER = [None]


def _no_redirect_opener():
    """An opener that REFUSES redirects instead of following them.

    THE VAULT TALKS TO THE DOORBELL ON THE LAN AND TO NOTHING ELSE, and
    post_record was the hole in that. urllib.request.urlopen installs a
    HTTPRedirectHandler by default and this request carries no proxy -- so a
    doorbell answering 302 (a compromised Pi, or whatever answers on that
    address) sent the vault off to any host it named, off the LAN entirely and
    outside the Mullvad-then-Tor path §4 exists to enforce.

    WHAT IT DOES AND DOES NOT DO, measured rather than assumed, because the
    first description of this defect overstated it. urllib turns a redirected
    POST into a GET, so the RECORD IS NOT RE-SENT -- driven against a real
    redirector, the second server saw a zero-length request. The record is
    also a sealed box, so its content would not open even if it did arrive.

    What actually leaks is the contact itself: this machine exists, it is
    awake right now, and it will reach out to an address a third party chose.
    From a box whose whole design is to be off, unreachable, and to speak to
    exactly one peer on the LAN, that is worth closing on its own -- and
    /window is a request whose ANSWER this code then trusts as a wake window,
    which a redirected fetch would let someone else supply.

    Refusing rather than ignoring: a doorbell that redirects is not a doorbell
    this protocol has, and post_record's caller already reads a non-200 as
    "unreachable", which is the correct reading of one.

    Built lazily, INSIDE the function, because the class has to subclass
    something from urllib and this module keeps urllib out of its import path
    on purpose. The first version put the class at module scope and referenced
    a helper defined below it -- a NameError at import, which py_compile does
    not catch and which would have bricked every wake.
    """
    if _OPENER[0] is None:
        import urllib.request

        class _RefuseRedirect(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, req, fp, code, msg, headers, newurl):
                return None

        # AND NO PROXY FROM THE ENVIRONMENT (the host-privacy pass, the
        # loopback finding's twin here): build_opener adds a ProxyHandler
        # that reads HTTP_PROXY / http_proxy, so a unit or a shell that set
        # one sent the doorbell's records -- and the fact of this machine
        # being awake -- to that proxy instead of across the LAN. An empty
        # map is "no proxy", whatever the environment says.
        _OPENER[0] = urllib.request.build_opener(
            urllib.request.ProxyHandler({}), _RefuseRedirect)
    return _OPENER[0]


# ---------------------------------------------------------------------------
#  Keyfile and local state
# ---------------------------------------------------------------------------
def load_key(path: Path) -> dict:
    # The keyfile a refusal's printed command names (_key_flag): the one
    # this run actually read, whichever entry point read it.
    _KEY_PATH[0] = str(path)
    try:
        st = os.stat(path)
    except OSError as e:
        raise Refused(
            "no_keyfile",
            f"no wake keyfile at {path} ({e.strerror}). This machine is not "
            f"paired with a doorbell, so it cannot tell a real job from a "
            f"magic packet anyone on the switch can send. If you just ran "
            f"paranoia_mode, it wiped the pairing: re-run gs_wake_keys with "
            f"physical access.") from e
    if stat.S_IMODE(st.st_mode) & 0o077:
        raise Refused("keyfile_perms",
                      f"{path} is group- or world-accessible (mode "
                      f"{stat.S_IMODE(st.st_mode):04o}); chmod 0400 it.")
    try:
        container = json.loads(Path(path).read_text())
    except Exception as e:                                   # noqa: BLE001
        raise Refused("keyfile_unreadable",
                      f"{path} is not readable JSON ({type(e).__name__})") from e
    # THIS ONE IS NOT SEALED, AND THE FILE SAYS SO RATHER THAN THIS CODE
    # ASSUMING IT. gs_wake_agent runs at boot with nobody here, on a disk that
    # unlocks itself so that it can: a passphrase this machine stores in order
    # to type it to itself is not a passphrase. See gs_wake_keys' docstring for
    # exactly what that costs, which is bounded and is not nothing.
    #
    # A SEALED file reaching here is a real mix-up worth naming: it is the Pi's,
    # and the Pi's file must never be on this box.
    if proto.keyfile_is_sealed(container):
        raise Refused(
            "keyfile_sealed",
            f"{path} is passphrase-sealed, which this machine's keyfile is "
            f"never allowed to be -- nobody is here at boot to type one. That "
            f"makes this the PI's keyfile, and it must not be on this box. Get "
            f"it off, then re-pair with `gs_wake_keys pair`.")
    try:
        k = proto.unlock_keyfile(container)
    except proto.WakeError as e:
        raise Refused("keyfile_schema", str(e)) from e
    if k.get("role") != "thinkpad":
        raise Refused("keyfile_role",
                      f"{path} is the {k.get('role')!r} keyfile. The Pi's file "
                      f"holds the DOORBELL's secret; this machine needs its "
                      f"own.")
    # THE DELIVERY KEY IS OPTIONAL, AND A MALFORMED ONE IS NOT.
    #
    # Checked HERE, at load, and not where it is used. If a mistyped hex string
    # first failed inside seal_slip_for_delivery, it would fail after the swap
    # was quoted -- and that function deliberately never raises, so the operator
    # would get a completed job, no slip, and a line on a terminal that is
    # 500 km away. A keyfile that cannot do what it says it will do should
    # refuse at the top, while the machine has done nothing yet.
    dp = k.get("delivery_public")
    if dp is not None:
        ok = isinstance(dp, str)
        if ok and dp != "":
            try:
                ok = len(bytes.fromhex(dp)) == 32
            except ValueError:
                ok = False
        if not ok:
            raise Refused(
                "delivery_public_malformed",
                f"{path} carries a delivery_public that is not 64 hex "
                f"characters (a 32-byte X25519 public key). Re-run "
                f"`gs_delivery_key new` rather than editing it by hand, or "
                f"remove the field to go back to leaving slips on this "
                f"machine.")
    # PLAINTEXT DELIVERY IS A KEYFILE DECISION, WHICH IS TO SAY A PHYSICAL ONE.
    #
    # It lives here and nowhere else on purpose: the Pi has no way to ask for
    # it, so a compromised Pi -- or a stolen bot token -- cannot turn the chat
    # into a plaintext channel. Changing it means being at the vault.
    # A KEYFILE FROM BEFORE THE RENAME FAILS LOUDLY.
    #
    # This field was called plain_slip. Reading the new name with .get() would
    # turn an old keyfile's `true` into a silent `false`: the vault would stop
    # sending the deposit details and the chat would go back to "read them on
    # the machine", with nothing anywhere saying why. A setting that quietly
    # stops applying is worse than one that refuses -- the operator is not
    # told they have lost it, and on this one they find out by having nothing
    # to pay.
    if "plain_slip" in k:
        raise Refused(
            "keyfile_field_renamed",
            f"{path} carries plain_slip, which is what deposit_in_chat used "
            f"to be called. Re-pair with gs_wake_keys (add --deposit-in-chat "
            f"if that is the mode you want); this machine will not guess "
            f"which way you meant it.")
    ps = k.get("deposit_in_chat")
    if ps is not None and not isinstance(ps, bool):
        raise Refused("deposit_in_chat_malformed",
                      f"{path} carries a deposit_in_chat that is not true or false.")
    # ONE MODE, NOT TWO. Sealed and plaintext answer the same question for
    # different operators, and an M3 carrying both would put the payload in the
    # transcript AND in a blob -- twice the exposure for one delivery. Refusing
    # here, at load, is the only place the operator is present to fix it.
    if ps and (k.get("delivery_public") or "").strip():
        raise Refused(
            "delivery_mode_ambiguous",
            f"{path} sets BOTH deposit_in_chat and delivery_public. Those are two "
            f"answers to one question and this machine will not guess: sealed "
            f"delivery puts the payload where only gs_delivery.key can read "
            f"it, plaintext puts it in the chat. Remove one.")
    # THE ISSUED-INDEX MARK: the one record, outside the ledger, that an
    # intake chain has handed out an address. Named here so every key this
    # machine runs under names one; _allocate_btc_index refuses an empty
    # ledger the mark contradicts. Without it a wiped ledger behind an
    # address that was ISSUED but not yet PAID handed that address to a
    # second client -- the chain cannot tell an unpaid address from a
    # fresh one, and address 0 was the only one asked.
    # IN ITS OWN DIRECTORY (self-doubt over that fix): the pairing names
    # one (`btc_issued_mark_dir`; /var/lib/ghostspiral-marks by default,
    # the unit's StateDirectory=, outside every wipe root), and the mark
    # for a chain is <dir>/issued_<chain id>.json -- one file per chain,
    # never dropped, never tied to the keyfile's name or place. Beside the
    # keyfile it sat under /etc, which ProtectSystem=strict mounts
    # read-only: under the shipped unit EVERY deposit was refused
    # btc_issued_unrecorded, and nothing before the first client said so.
    # A keyfile from before the field keeps the old place beside itself,
    # and --dry-run tries the write and says what it found.
    _md = k.get("btc_issued_mark_dir")
    if isinstance(_md, str) and _md.strip():
        k["btc_issued_mark"] = str(Path(_md.strip())
                                   / f"issued_{_xpub_id(k)}.json")
    else:
        k["btc_issued_mark"] = str(path) + ".issued"
    return k


def _is_sealed_member(name: str) -> bool:
    """Whether `name` is one state_close would seal: the one rule both
    directions read, so state_open cannot write a name the close never
    takes back."""
    import fnmatch
    return name not in SEALED_SKIP and any(
        fnmatch.fnmatchcase(name, _p) for _p in SEALED_GLOBS)


def _sealed_members(dirpath: Path) -> list:
    """Every plaintext member present in `dirpath`, sorted. Names only --
    the caller reads them. A directory entry that is not a file (a stray
    directory named like a member) is not one."""
    out = set()
    for pat in SEALED_GLOBS:
        for p in dirpath.glob(pat):
            if p.is_file() and p.name not in SEALED_SKIP:
                out.add(p.name)
    return sorted(out)


def secret_of(name: str, default=None):
    """One spend secret: from the sealed file if this box has one, else
    from the environment.

    THE ENVIRONMENT IS STILL READ, and that is the compatibility story
    rather than a hole: an install that has not run `--seal-secrets` keeps
    working off its EnvironmentFile exactly as it did. Sealed wins, so an
    operator who has sealed and forgotten to shred the plaintext gets the
    sealed value and not a stale one.
    """
    if name in _SECRETS:
        return _SECRETS[name]
    return os.environ.get(name, default)


def has_secret(name: str) -> bool:
    """Whether this box has that secret AT ALL -- sealed or in the
    environment. Separate from secret_of because an EMPTY password is a
    real answer ("this wallet has none") and `not value` is not the
    question: every refusal in this file distinguishes unset from empty."""
    return name in _SECRETS or name in os.environ


def _secret_home(name: str) -> str:
    """Where this machine read `name` from, in words, for a refusal about
    its VALUE (a seed that is not a mnemonic, or derives another xpub)."""
    if name in _SECRETS:
        return (f"the sealed spend secrets "
                f"({_SECRETS_FROM[0] or SECRETS_FILE})")
    return "the agent unit's environment"


def _reseal_hint(name: str) -> str:
    """The sentence a refusal about a spend secret is missing when this box
    has sealed them, and "" when it has not -- so every message from before
    stage 9 reads exactly as it did.

    THE REFUSALS SENT THE OPERATOR TO THE WRONG COPY. Every one said "set"
    or "fix" the variable in the EnvironmentFile. On a box that has sealed
    its secrets, secret_of() reads the SEALED copy first, so an operator
    who fixed a bad seed in the file as told changed nothing and got the
    same refusal on the next wake; one told a sealed-away password was
    "unset" would put it back in the clear, undoing the seal."""
    if not _SECRETS:
        return ""
    where = _SECRETS_FROM[0] or SECRETS_FILE
    # THE COMMAND MERGES: what a plaintext file names replaces the sealed
    # value and everything else sealed is kept, so a file holding this one
    # name is enough -- the plaintext of the rest was shredded, as the seal
    # tells the operator to.
    _cmd = (f"`gs_wake_agent --seal-secrets {_key_flag()} "
            f"--secrets-env <file>` at the machine, with a plaintext file "
            f"that names it; the rest stays sealed as it is. Then shred "
            f"that file")
    if name in _SECRETS:
        return (f" That value is the SEALED copy ({where}), which wins over "
                f"the EnvironmentFile: editing that file alone changes "
                f"nothing. Re-seal the corrected value with {_cmd}.")
    return (f" This machine seals its spend secrets ({where}) and {name} is "
            f"in neither them nor the environment. Seal it too, rather "
            f"than leave it in the clear beside them: {_cmd}.")


def _set_in() -> str:
    """Where a refusal's main sentence tells the operator to set a missing
    secret: the unit's EnvironmentFile on a box that has not sealed them,
    and nowhere in particular on one that has -- the hint after it says
    how, and "the EnvironmentFile" there would put a seed back in the
    clear, the one thing _reseal_hint exists to stop."""
    return "" if _SECRETS else " in the agent unit's EnvironmentFile"


def _secrets_path(args) -> Path:
    """THE sealed secrets file for this run -- one resolution, used by every
    reader. The early check resolved `--secrets-file ""` to the default and
    open_secrets was handed the "" itself, which is Path("."), which is not
    a file: the check saw a sealed seed, the opener saw none, and the job
    signed from the environment beside it -- the fallback the seal exists
    to remove."""
    return Path(getattr(args, "secrets_file", "") or SECRETS_FILE)


def open_secrets(path, vault_half: bytes, pi_half: bytes) -> int:
    """Load the sealed spend secrets into _SECRETS. Returns how many.

    REFUSES rather than falling back to the environment. A box that has a
    sealed secrets file and cannot open it is a box whose seed the
    operator believes is protected; quietly signing from a plaintext
    leftover instead would make the seal decorative, and the operator
    would never learn. The same two causes as everything else under this
    key: a re-pairing, or an altered file.
    """
    p = Path(path)
    if not p.is_file():
        return 0
    try:
        container = json.loads(p.read_text())
        members = proto.state_unseal(container, vault_half, pi_half,
                                     schema=proto.SECRETS_SCHEMA)
        inner = json.loads(members[proto.SECRETS_MEMBER])
        if not isinstance(inner, dict):
            raise ValueError("not an object")
    except (proto.WakeError, KeyError, ValueError, TypeError) as e:
        raise Refused(
            "secrets_unreadable",
            f"the sealed spend secrets at {p} did not open ({e}). Either "
            "the two boxes were re-paired since they were sealed -- the "
            "Pi's half of the key changes with its secret -- or the file "
            "has been altered. Nothing is signed with a seed this machine "
            "cannot read, and it will NOT fall back to the environment: "
            "that would make the seal decorative. After a re-pairing, move "
            f"{p} aside and seal them again from the plaintext, at the "
            f"machine: `gs_wake_agent --seal-secrets {_key_flag()}` (it "
            f"asks for the half).")
    _SECRETS.clear()
    for _k, _v in inner.items():
        # THE ALLOW-LIST, applied on the way IN. A sealed file is still a
        # file; one swapped for another operator's would otherwise put
        # whatever GS_ variables it liked into every child's environment.
        if _k in SECRETS_ALLOWED and isinstance(_v, str):
            _SECRETS[_k] = _v
    _SECRETS_FROM[0] = str(p)
    return len(_SECRETS)


def open_keyfile(key: dict, vault_half: bytes, pi_half: bytes) -> dict:
    """The keyfile with its sealed section merged in (STAGE8_PLAN.md).

    Returns a NEW dict; the caller rebinds. A keyfile with no sealed
    section -- every pairing from before this stage -- comes back
    unchanged, which is the whole of the compatibility story.

    REFUSES rather than running on the clear half alone. A vault that
    cannot read its own settings does not know its xpub, so it cannot tell
    a deposit address it issued from one it did not; it does not know
    whether it was permitted to spend; and it does not know where the
    operator's cut goes. Every one of those is a wrong answer about money,
    and none of them announces itself. The same two causes as the store,
    because it is the same key: a re-pairing since it was written, or a
    file that has been altered.
    """
    blob = key.get(KEYFILE_SEALED)
    if blob is None:
        return key
    if not isinstance(blob, dict):
        raise Refused(
            "keyfile_unreadable",
            "this machine's keyfile carries a sealed section that is not a "
            "container. Re-pair rather than run on half a keyfile.")
    try:
        members = proto.state_unseal(blob, vault_half, pi_half,
                                     schema=proto.SETTINGS_SCHEMA)
        inner = json.loads(members[KEYFILE_MEMBER])
        if not isinstance(inner, dict):
            raise ValueError("not an object")
    except (proto.WakeError, KeyError, ValueError, TypeError) as e:
        raise Refused(
            "keyfile_unreadable",
            f"this machine's keyfile did not open ({e}). Either the two "
            "boxes were re-paired since it was written -- the Pi's half of "
            "the key changes with its secret -- or the file has been "
            "altered. Nothing is run against settings that cannot be read: "
            "this machine would not know which addresses are its own. To "
            "read them by hand: `gs_doorbell state-key` on the Pi, then "
            f"`gs_wake_agent --unseal-key {_key_flag()}` here (it asks for "
            f"the half).")
    # THE CLEAR HALF WINS ON A COLLISION, and a collision is a malformed
    # keyfile rather than a choice: `secret` inside the seal must never be
    # able to replace the secret that authenticated the note this half
    # arrived in.
    merged = dict(inner)
    merged.update(key)
    merged.pop(KEYFILE_SEALED, None)
    # WHAT load_key DERIVED FROM FIELDS IT COULD NOT SEE is derived again.
    # btc_issued_mark is built at load from btc_issued_mark_dir and the
    # xpub's chain id -- both SEALED on a keyfile from stage 8 on -- so at
    # load it fell back to a mark beside the keyfile, under /etc, which the
    # unit mounts read-only: every deposit refused btc_issued_unrecorded,
    # the exact failure the marks' directory was added to end. And "the
    # clear half wins" kept that fallback over anything the seal held.
    # Driven: one set of settings named marks/issued_<chain>.json when
    # readable and <keyfile>.issued when sealed.
    _md = merged.get("btc_issued_mark_dir")
    if isinstance(_md, str) and _md.strip():
        merged["btc_issued_mark"] = str(Path(_md.strip())
                                        / f"issued_{_xpub_id(merged)}.json")
    return merged


def state_halves(key: dict, pi_half: bytes = None) -> tuple:
    """(vault half, Pi half) as bytes, or (None, None) when this pairing
    does not seal its records.

    The vault's half is in its keyfile; its PRESENCE is the switch, so a
    keyfile written before this stage runs exactly as it did. A malformed
    one is refused rather than ignored: a pairing that meant to seal and
    cannot is not a pairing that should quietly stop.
    """
    raw = key.get("state_half")
    if raw is None or raw == "":
        # NO HALF IS "THIS PAIRING DOES NOT SEAL" ONLY IF NOTHING IS SEALED
        # (the review of the uncovered dimensions). A keyfile with a sealed
        # section and no half ran on its clear half alone, silently: open_
        # keyfile is reached only through the half. Altered, or restored in
        # part; either way not a keyfile to run.
        if key.get(KEYFILE_SEALED) is not None:
            raise Refused(
                "state_half_missing",
                "this machine's keyfile carries sealed settings and no half "
                "of the key they were sealed under, so it has been altered "
                "or restored in part. Nothing is run on half a keyfile: "
                "this machine would not know which addresses are its own. "
                "Pair again.")
        return None, None
    try:
        vault = bytes.fromhex(str(raw))
    except (TypeError, ValueError):
        vault = b""
    if len(vault) != proto.STATE_HALF_BYTES:
        raise Refused(
            "state_half_malformed",
            "this machine's keyfile carries a state_half that is not "
            f"{proto.STATE_HALF_BYTES} bytes of hex. That is the half of "
            "the key its own records are sealed under; re-pair rather than "
            "run with records nothing can open.")
    return vault, pi_half


def state_open(artifact_dir: Path, vault_half: bytes, pi_half: bytes) -> int:
    """Write the sealed store's members out as plaintext. Returns how many.

    REFUSES rather than starting empty. A store that will not open means
    either a re-pairing since it was written or a file that has been
    altered; running past it would hand out an address that is already
    somebody's and lose the map from owner tokens to accounts. There is no
    safe way to guess, so the job does not start.
    """
    p = artifact_dir / SEALED_FILE
    if not p.is_file():
        return 0
    try:
        container = json.loads(p.read_text())
    except Exception as e:                                   # noqa: BLE001
        raise Refused("state_unreadable",
                      f"{p} is not readable JSON ({type(e).__name__}). The "
                      "records this machine keeps are in it; nothing is run "
                      "against a ledger that cannot be read.")
    try:
        members = proto.state_unseal(container, vault_half, pi_half)
    except proto.WakeError as e:
        raise Refused(
            "state_unreadable",
            f"the sealed records at {p} did not open ({e}). Either the two "
            "boxes were re-paired since they were written -- the Pi's half "
            "of the key changes with its secret -- or the file has been "
            "altered. Nothing is run against a ledger that cannot be read. "
            "To open it by hand, with BOTH halves it was sealed under: "
            "`gs_wake_agent --unseal-state --key <keyfile>` here (it asks "
            "for the half), "
            "where the hex is `gs_doorbell state-key` on the Pi that sealed "
            "them and the keyfile is the one that pairing wrote. After a "
            "re-pairing both changed: the OLD keyfile you moved aside, and "
            "the old half from the copy inside the LUKS USB. That also "
            "retires the old container, so the new pair can seal them.")
    # A MEMBER ALREADY ON DISK IS A RUN THAT DIED, not something to
    # overwrite: it is newer than the seal. Left where it is, and rolled
    # into the next seal with the rest.
    # ONLY NAMES THE CLOSE WOULD SEAL, ALL CHECKED BEFORE ONE IS WRITTEN
    # (the review of the uncovered dimensions). The schema label in the
    # header is compared, not authenticated, and the keyfile's sealed
    # settings and the sealed secrets are under the same two halves:
    # relabelled as the store, either opened here and wrote settings.json or
    # secrets.json out -- a name state_close never seals or shreds, so the
    # xpub or the seed stayed on the disk in the clear. Only someone who can
    # write this disk can relabel a file, and they can change this code too;
    # what this rules out is the store writing out what it cannot take back.
    if not all(isinstance(_nm, str) and _is_sealed_member(_nm)
               for _nm in members):
        raise Refused("state_unreadable",
                      "the sealed records name a member this machine never "
                      "seals: another kind of container relabelled as the "
                      "store, or an altered file. Nothing was written out.")
    n = 0
    _sealed_prev = _sealed_job = None
    for name, text in members.items():
        if "/" in name or "\\" in name or name in ("", ".", ".."):
            raise Refused("state_unreadable",
                          "the sealed records name a member that is not a "
                          "plain file name; refusing to write it.")
        _t = artifact_dir / name
        # THE LOGS ARE JOINED, NOT SHADOWED (see JOB_LOG_PREV): the sealed
        # log is a run that did not finish cleanly, and this boot's fresh
        # one on the disk is not newer than it in any way that matters.
        if name == JOB_LOG_PREV:
            _sealed_prev = _u8(text)
            n += 1
            continue
        if name == JOB_LOG and _t.exists():
            _sealed_job = _u8(text)
            n += 1
            continue
        if name == CHAIN_MEMBER and _t.is_file():
            # NOT "a run that died, newer, left where it is" -- or not only.
            # The chain on the disk is usually this boot's own lines from
            # before the note, or an idle boot's, written onto a fresh file
            # after the last seal shredded the old one; skipping the sealed
            # copy for it would throw the whole history away at the next
            # close. Joined instead: the history, then whatever the disk
            # holds past it.
            _merge_chain(_t, text)
            n += 1
            continue
        if _t.exists():
            continue
        _fd = os.open(str(_t), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(_fd, "wb") as fh:
            fh.write(_u8(text))
        n += 1
    if _sealed_prev is not None or _sealed_job is not None:
        # OLDEST FIRST: what was already kept, then the run the last seal
        # held, then whatever this boot found left on the disk after it.
        _dp = artifact_dir / JOB_LOG_PREV
        try:
            _disk = _dp.read_bytes() if _dp.is_file() else b""
        except OSError:
            _disk = b""
        _prev_write(artifact_dir,
                    _prev_parts(_sealed_prev or b"")
                    + ([_prev_part("sealed by a run that did not finish "
                                   "cleanly", _sealed_job)]
                       if _sealed_job and _sealed_job.strip() else [])
                    + _prev_parts(_disk), prune=False)
    return n


def _merge_chain(path: Path, sealed_text: str) -> None:
    """Write the sealed chain back with the disk's newer lines after it.

    ONE RULE covers both ways the two copies relate: the sealed history, and
    then every line the disk holds past the prefix the two share,
    re-chained onto the history's last hash. A fresh tail (this boot's lines
    before the note, an idle boot's) shares nothing and is appended whole; a
    run that died holding the full history shares all of it, and what comes
    after is re-chained onto the same hashes it already had -- so the file
    comes out as it was.

    RE-CHAINING RESTS ON NOTHING, and nothing is lost by it: the chain is
    unkeyed, so any writer could compute these hashes. What it keeps is the
    thing the chain can actually do -- show where an accidental truncation
    or overwrite broke it.

    Under the chain's own lock, like every other write to it -- taken
    BEFORE the disk copy is read, or a line another process appended
    between the read and the replace was dropped.

    NEVER STOPPED BY A BYTE. The disk copy is read as bytes and a byte that
    is not UTF-8 is carried through as itself (surrogateescape): a chain
    torn mid-character, or left as random bytes by a shred the power cut
    through, raised UnicodeDecodeError here -- in state_open, after the
    members before it were already written out -- so every later wake
    crashed with the ledger in the clear until someone removed the file by
    hand. Such a line does not verify, so it is copied as it is and
    verify_integrity_chain still stops at it."""
    import fcntl
    lock_fd = None
    try:
        lock_fd = os.open(str(path) + ".lock", os.O_WRONLY | os.O_CREAT,
                          0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
    except OSError:
        lock_fd = None
    try:
        _merge_chain_locked(path, sealed_text)
    finally:
        if lock_fd is not None:
            os.close(lock_fd)


def _u8(text: str) -> bytes:
    """Text back to the bytes it was read from (see _merge_chain)."""
    return text.encode("utf-8", "surrogateescape")


def _merge_chain_locked(path: Path, sealed_text: str) -> None:
    sealed = [ln for ln in sealed_text.splitlines() if ln.strip()]
    try:
        disk = [ln for ln in path.read_bytes().decode(
            "utf-8", "surrogateescape").splitlines() if ln.strip()]
    except OSError:
        disk = []
    k = 0
    while k < min(len(sealed), len(disk)) and sealed[k] == disk[k]:
        k += 1
    prev = (sealed[-1].split(" | ", 1)[0].strip() if sealed else "0" * 64)
    # Each disk line is checked against the DISK's own chain first. A line
    # that held there is re-chained onto the history; one that did not --
    # a torn last line from a power cut, an overwrite -- is copied as it
    # is, so verify_integrity_chain still stops at it. Re-hashing it would
    # erase the one kind of damage an unkeyed chain can show.
    dprev = (disk[k - 1].split(" | ", 1)[0].strip() if k else "0" * 64)
    out = list(sealed)
    for ln in disk[k:]:
        h_disk = ln.split(" | ", 1)[0].strip() if " | " in ln else ""
        payload = ln.split(" | ", 1)[1] if " | " in ln else ln
        held = (h_disk == hashlib.sha256(
            _u8(dprev + payload)).hexdigest())
        dprev = h_disk
        if held:
            prev = hashlib.sha256(_u8(prev + payload)).hexdigest()
            out.append(f"{prev} | {payload}")
        else:
            out.append(ln)
            prev = h_disk
    tmp = path.with_name(path.name + ".merge")
    _fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(_fd, "wb") as fh:
        fh.write(_u8("".join(ln + "\n" for ln in out)))
    os.replace(str(tmp), str(path))


def _shred_mix_trees(artifact_dir: Path) -> None:
    """Shred GhostSpiral's staging trees a killed round left (MIX_TREES).
    Never raises: a tree that will not go is said, and chained."""
    for _d in MIX_TREES:
        _t = artifact_dir / _d
        try:
            if _t.is_dir() and not _t.is_symlink():
                if not secure_delete_tree(_t):
                    integrity_log("wake", f"retire_failed:{_d}")
                    agent_say(f"  [!] {_t} could not be shredded; it holds a "
                              f"killed round's manifests. Run paranoia_mode.")
        except Exception:                                    # noqa: BLE001
            integrity_log("wake", f"retire_failed:{_d}")


def state_close(artifact_dir: Path, vault_half: bytes, pi_half: bytes) -> int:
    """Seal every member back into the store and shred the plaintext.

    Returns how many were sealed, or -1 when nothing could be. FAILS SAFE
    IN THE OTHER DIRECTION from state_open, deliberately: a seal that does
    not happen leaves the bookkeeping readable, which is a privacy loss;
    a shred whose ciphertext never landed loses the bookkeeping itself,
    which is a client's money stuck. So the plaintext goes only after the
    new container is on disk AND has been read back with the same key.
    """
    # THE MIX'S STAGING TREES GO FIRST, whatever the seal then does: they
    # are not members (the store holds files) and have no use kept.
    _shred_mix_trees(artifact_dir)
    # THE EARLIER BOOTS' LOG IS PRUNED HERE, going into the store -- not on
    # the way out of it, where a person opening it by hand wants all of it.
    _prune_prev_log(artifact_dir)
    names = _sealed_members(artifact_dir)
    p = artifact_dir / SEALED_FILE
    if not names:
        # NOTHING LEFT TO KEEP: a wiped vault, or a run that retired the
        # last record. The stale container goes too -- left behind, it
        # would be opened next time and write its members back out.
        if p.is_file():
            try:
                secure_delete_or_warn(p, "the sealed records")
            except Exception:                                # noqa: BLE001
                return -1
        return 0
    members = {}
    try:
        for name in names:
            # AS BYTES, a byte that is not UTF-8 carried as itself: one torn
            # member -- the chain, most likely, or a job log cut
            # mid-character -- failed read_text() and so the whole seal,
            # leaving EVERY record in the clear on every wake after it.
            members[name] = (artifact_dir / name).read_bytes().decode(
                "utf-8", "surrogateescape")
        container = proto.state_seal(members, vault_half, pi_half)
        tmp = artifact_dir / (SEALED_FILE + ".new")
        _fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(_fd, "w") as fh:
            json.dump(container, fh, sort_keys=True)
            fh.flush()
            os.fsync(fh.fileno())
        # READ IT BACK BEFORE ANYTHING IS DESTROYED. Not paranoia: this is
        # the one moment where a bug costs the operator the ledger rather
        # than costing them privacy, and the two failures point opposite
        # ways.
        back = proto.state_unseal(json.loads(tmp.read_text()),
                                  vault_half, pi_half)
        if back != members:
            raise ValueError("the sealed copy does not read back")
        os.replace(str(tmp), str(p))
    except Exception:                                        # noqa: BLE001
        try:
            (artifact_dir / (SEALED_FILE + ".new")).unlink()
        except OSError:
            pass
        return -1
    gone = 0
    for name in names:
        try:
            secure_delete_or_warn(artifact_dir / name,
                                  "a sealed record's plaintext")
            gone += 1
        except Exception:                                    # noqa: BLE001
            continue
    return gone


#: What the last _seal_state_now did: "sealed", "failed", or None when no
#: store was open. main()'s stop message is built from this one value; it
#: used to say "The records are sealed" unconditionally -- the line after
#: the one saying they could not be, and on paths that never opened any.
_SEAL_OUTCOME = [None]
#: What a stop would leave unfinished, in words, or "" before a job is taken.
_RUNNING = [""]
#: The --key this run was given, for the commands a refusal prints: they
#: were printed without it, and argparse refuses every one typed as shown.
_KEY_PATH = [None]


def _key_flag() -> str:
    """`--key <path>` for a printed command: this run's, or the unit's."""
    import shlex
    return "--key " + shlex.quote(str(_KEY_PATH[0]
                                      or "/etc/gs_wake_thinkpad.key"))


def _seal_state_now() -> None:
    """Put the open records back in the store, ONCE, and forget the key.

    main()'s finally calls this on every path out, and a stop request calls
    it EARLIER, before the doorbell is told anything (run_once): reporting
    can take a minute of backoff over Tor and the poweroff unit allows 20
    seconds before its SIGKILL, so the seal cannot wait behind it.

    ONCE, because state_close is not idempotent. Called again after it has
    shredded every plaintext member, it finds nothing to keep and deletes
    the container as a wiped vault's -- which would destroy the records it
    just sealed. So _STATE_KEY is cleared here, on success and failure, and
    a second call does nothing.

    FAILS THE OTHER WAY FROM state_open, and it must: an unsealed directory
    is a privacy loss the operator can still fix, while a shred whose
    ciphertext never landed is a client's money with no bookkeeping.
    state_close returns -1 rather than raising, and says so."""
    if _STATE_KEY.get("vault") is None:
        return
    # A STORE THAT WAS NEVER OPENED IS NEVER CLOSED. The halves are recorded
    # the moment M2 is read, and a refusal can still come between that and
    # state_open -- a slow answer past the M1-M2 window, a keyfile or a
    # secrets file that will not open. state_close on that directory finds
    # no plaintext member, reads it as a wiped vault and DELETES THE
    # CONTAINER -- the whole ledger, every open slip, every plan chain --
    # or, with the chain a member, replaces it with one holding only this
    # boot's chain lines. Nothing was opened, so nothing is closed.
    #
    # And an open that failed PART WAY is not closed either: sealing then
    # would keep the members it had written and drop the rest. The
    # plaintext it left is a privacy loss the operator can see and fix; the
    # other way is a ledger nobody can get back.
    if not _STATE_KEY.get("opened"):
        _STATE_KEY.clear()
        return
    try:
        _sealed = state_close(_STATE_KEY["dir"], _STATE_KEY["vault"],
                              _STATE_KEY["pi"])
        _SEAL_OUTCOME[0] = "failed" if _sealed < 0 else "sealed"
        if _sealed < 0:
            agent_say("  [!] THE RECORDS COULD NOT BE SEALED and are "
                      "still readable on this disk. Nothing was "
                      "destroyed. Look at the artifact directory "
                      "before the next wake.")
            integrity_log("wake", "state_unsealed_fail")
        else:
            # THE JOB LOG WENT INTO THE STORE, so nothing may write it back
            # in the clear: a later line (the report, "Wake finished", a
            # power-off) goes to the terminal only -- under the unit, to
            # nowhere, and the chain still carries its code.
            if (_AGENT_LOG[0] is not None
                    and Path(_AGENT_LOG[0]).parent.resolve()
                    == Path(_STATE_KEY["dir"]).resolve()):
                _AGENT_LOG[0] = None
            integrity_log("wake", "state_sealed")
    except Exception:                                        # noqa: BLE001
        # Bookkeeping must never be what keeps the box on, and a failure
        # here has already left the plaintext in place.
        if _SEAL_OUTCOME[0] is None:
            _SEAL_OUTCOME[0] = "failed"
        try:
            integrity_log("wake", "state_unsealed_fail")
        except Exception:                                    # noqa: BLE001
            pass
    finally:
        _STATE_KEY.clear()


def load_state(dirpath: Path) -> dict:
    p = dirpath / STATE_FILE
    try:
        d = json.loads(p.read_text())
        if not isinstance(d, dict):
            raise ValueError("not an object")
        d.setdefault("jobs", [])
        d.setdefault("wakes", [])
        return d
    except Exception as e:                                   # noqa: BLE001
        # A missing or corrupt ledger is not fatal, and it must not be: this
        # file lives where paranoia_mode wipes. Carry on with the Pi's copy,
        # which is the one that does not live on a wipeable disk.
        #
        # SAY IT, though. This comment claimed "say honestly what is lost" for
        # a whole draft while the code returned in silence -- a comment
        # describing a behaviour that was not there, which is the defect this
        # repo names most often. A missing file is the normal first boot and
        # says nothing; a file that EXISTS and will not parse is a fact the
        # operator needs, because the replay and wake-budget backstops both
        # start over from it.
        # agent_say, NOT print (the review of the uncovered dimensions): the
        # unit sends stdout to /dev/null, so the one sentence this branch
        # exists to say reached nobody on the path that actually runs.
        if p.exists():
            agent_say(f"  [!] {p} exists but does not parse "
                      f"({type(e).__name__}). "
                      f"Starting a NEW ledger: the local replay guard and the "
                      f"24 h wake budget both begin again from zero this "
                      f"boot. The doorbell's one-job-per-process rule still "
                      f"holds.")
            integrity_log("wake", "ledger_unreadable")
        return {"jobs": [], "wakes": []}


def save_state(dirpath: Path, state: dict) -> None:
    atomic_write_json(state, dirpath / STATE_FILE, perms=0o600)


# ---------------------------------------------------------------------------
#  Preflight: everything that must be true BEFORE the job is consumed
# ---------------------------------------------------------------------------
def preflight(key: dict, artifact_dir: Path, dry_run: bool,
              probes: dict = None) -> None:
    p = probes or {}
    _unit_active = p.get("unit_is_active", unit_is_active)
    _removable = p.get("removable_devices", removable_devices)
    _resources = p.get("resource_check", resource_check)
    _tor = p.get("tor_bootstrapped", tor_bootstrapped)
    _covers = p.get("wipe_covers", wipe_covers)

    # A human is present: an operator boot, or a mix already running. Refuse
    # the job and DISARM the deadman -- powering the box off under someone who
    # is using it is the one failure this feature must not introduce.
    # RECORDED FOR THE LATE CHECK, before either question is asked. main()'s
    # finally has no keyfile and these two values are only known in here; see
    # somebody_is_here for why the same questions have to be asked again at
    # the instant the power-off decision is actually taken.
    # FROM `key`, NOT FROM `probes`. `probes` is the test-injection dict and
    # every entry in it is a function override -- unit_is_active,
    # removable_devices, resource_check, tor_bootstrapped. Reading the
    # wallet-rpc endpoint out of it meant the value was "" on every real run,
    # so the lock half of this guard was dead code that a driven test still
    # passed, because the test set _LATE_GUARD by hand. That is the exact
    # "declared in one place, never wired to the thing that runs" shape this
    # file already carries two other notes about.
    _LATE_GUARD["dir"] = artifact_dir
    _LATE_GUARD["rpc"] = key.get("rpc_primary") or ""
    inhibit = artifact_dir / INHIBIT_FILE
    if inhibit.exists():
        raise Refused("inhibited",
                      f"{inhibit} exists, so a person is using this machine. "
                      f"Not running a job and NOT powering off. Remove the "
                      f"file when you are done.", power=False)
    # THE LOCK THAT ACTUALLY EXISTS. This looked for
    # artifact_dir/".ghostspiral.lock" and GhostSpiral takes its lock at a
    # path RELATIVE to cwd -- gs_console runs it from the repo -- so the two
    # were never the same file and this check has never once been true.
    # scope_lock_taken asks _scope_lock's abstract socket, keyed on the
    # wallet-rpc endpoint, which is what "the same wallet" means and what the
    # refusal below already claims to be about.
    #
    # The file probe stays as a weaker second signal: it is right in the one
    # case where a run really was started from the artifact directory, and it
    # costs a stat.
    lock = artifact_dir / ".ghostspiral.lock"
    if scope_lock_taken(rpc_lock_scope(key.get("rpc_primary") or "")) \
            or (lock.exists() and _lock_is_held(lock)):
        raise Refused("mix_running",
                      "a GhostSpiral run holds the lock on this wallet. Not "
                      "running a job and NOT powering off — a mix mid-flight "
                      "is the one thing here with no automatic recovery.",
                      power=False)

    if not dry_run and not _unit_active(DEADMAN_UNIT):
        # Doing a job on a box that cannot turn itself off is strictly worse
        # than refusing: it is the always-on vault this feature exists to end.
        raise Refused("no_deadman",
                      f"{DEADMAN_UNIT} is not active, so nothing would turn "
                      f"this machine off if the agent died. Refusing to start "
                      f"a job. Install the units in systemd/ from this repo.")

    rem = _removable()
    if rem:
        raise Refused("removable_media",
                      f"removable device(s) attached ({', '.join(rem)}). "
                      f"OPSEC_SETUP.md §4: the spend USB must not be in a "
                      f"machine a pager can wake. Refusing.")

    # resource_check, NOT require_resources. The latter returns None and
    # aborts by sys.exit, so `if not require_resources(...)` would have been
    # False-y on every healthy boot and refused every job -- caught by running
    # it. It also CONTINUES when psutil is missing, which is right for an
    # attended run and wrong here: nobody is watching, so a check that could
    # not be performed is not a check that passed.
    try:
        ok = _resources(2.0, 90.0)
    except ResourceCheckUnavailable:
        raise Refused("no_sentinel",
                      "psutil is not installed, so free disk and RAM were NOT "
                      "checked. An attended run may continue past this; an "
                      "unattended one must not — a job that fills the disk "
                      "leaves half-written artifacts nobody is watching for.")
    except Exception as e:                                   # noqa: BLE001
        raise Refused("sentinel_error",
                      f"the resource sentinel failed ({type(e).__name__}).")
    if not ok:
        raise Refused("resources",
                      "this machine is short of disk or memory. Refusing.")

    if not _covers(artifact_dir):
        # SAY WHICH OF THE TWO THIS IS. wipe_covers resolves against cwd and
        # $HOME, and the systemd unit sets both to the artifact directory on
        # purpose (gs-wake-agent.service:41-42). So this refusal has two very
        # different causes and only one of them is a misconfiguration:
        #
        #   * run by hand from an ordinary shell -> cwd and $HOME are the
        #     operator's, the sweep is anchored somewhere else, and this fires
        #     on a CORRECT install. It fired on the shipped default, on the
        #     command gs_wake_keys prints as "confirm the pairing works".
        #   * run by systemd with the unit as shipped -> genuinely misplaced.
        #
        # Telling an operator their install is broken when it is not is its
        # own defect, so name the by-hand case explicitly.
        raise Refused("outside_wipe_roots",
                      f"{artifact_dir} is outside every directory "
                      f"paranoia_mode searches, so the bundles and slips this "
                      f"job writes would never be erased. Refusing.\n"
                      f"      paranoia_mode's sweep is anchored on cwd and "
                      f"$HOME. If you are running this BY HAND to check a "
                      f"pairing, run it the way the unit does:\n"
                      f"          cd {artifact_dir} && HOME={artifact_dir} "
                      f"python3 gs_wake_agent --key ... --dry-run\n"
                      f"      If systemd runs it, set WorkingDirectory= and "
                      f"Environment=HOME= to {artifact_dir} in "
                      f"gs-wake-agent.service.")

    # NOW it is ours, so narrow it. run_job creates artifact_dir with
    # narrow_existing=False, which leaves a PRE-EXISTING directory's mode
    # alone -- correct there, because at that point this is just a path out of
    # a keyfile and might be the operator's cwd. wipe_covers passing settles
    # that: this tool guarantees paranoia_mode will securely ERASE this
    # directory, and refuses to run at all otherwise. A directory whose
    # contents this toolchain destroys is its own territory, not one it was
    # merely asked to write a file into, so 0755 here is a leak to fix rather
    # than an operator preference to respect.
    #
    # WARN RATHER THAN REFUSE. Everything above this line is fail-closed
    # because it names a condition this process cannot fix; a directory mode
    # is one it can, and bricking an unattended vault over something already
    # repaired would be its own defect. The mode is reported because a
    # too-wide directory means the artifacts of PREVIOUS runs were listable,
    # and this chmod does not undo that.
    try:
        _mode = stat.S_IMODE(artifact_dir.stat().st_mode)
        if _mode & 0o077:
            os.chmod(artifact_dir, 0o700)
            agent_say(f"[!] {artifact_dir} was mode {_mode:04o} — group/other "
                      f"could list this run's artifacts. Narrowed to 0700. "
                      f"Anything earlier runs left here was listable too.")
    except OSError as e:                                     # noqa: BLE001
        # Not fatal: the files inside are 0600 regardless, and refusing the
        # job would be a worse outcome than a wide directory.
        agent_say(f"[!] could not read or narrow the mode of {artifact_dir} "
                  f"({type(e).__name__}). Continuing; check it by hand.")

    if not _tor(key.get("tor_proxy", "")):
        raise Refused("tor_down",
                      f"this machine's own Tor is not answering on "
                      f"{key.get('tor_proxy')}. Refusing BEFORE asking for the "
                      f"job, so the job is still waiting at the doorbell for "
                      f"the next boot.")


#: WHAT THE LATE CHECK NEEDS, RECORDED WHEN IT IS KNOWN.
#:
#: main()'s finally decides whether to power the machine off, and it has no
#: keyfile: the artifact dir and the wallet-rpc endpoint are read out of one
#: inside run_once. preflight stores them here the moment it has them, so the
#: decision can be re-taken at the instant it is actually made. Empty when no
#: keyfile was ever loaded -- in which case nothing ran and there is nothing
#: to be careful about.
_LATE_GUARD = {}


def somebody_is_here(artifact_dir=None, rpc=None) -> str:
    """Why this machine must NOT power off right now, or "".

    ASKED AT THE INSTANT THE DECISION IS TAKEN, and that is the whole point.
    Both facts this returns were read once, at preflight, and then acted on
    minutes to hours later:

      * The inhibit file was read in preflight and again inside _dispatch's
        `for i, argv in enumerate(steps)` loop -- which iterates ONCE for
        withdraw, watch and swap_status. So for three of the four
        jobs the "somebody sat down" check ran immediately after the jitter
        and never again, while the job ran for up to 58200 s. An operator who
        touched the file during a withdrawal was ignored and the box powered
        off under them.
      * The mix-running check looked for artifact_dir/".ghostspiral.lock".
        GhostSpiral takes that lock at Path(".ghostspiral.lock") -- RELATIVE
        to cwd, which gs_console sets to the repo. Two different files, always.
        The refusal text claims to be about "a mix mid-flight", and it was
        reading a file no mix ever creates. scope_lock_taken asks the guard
        that actually exists: the abstract socket _scope_lock binds, keyed on
        the wallet-rpc endpoint, which is what "the same wallet" means.

    The pair matters together: a `watch` job holds the box up for ~2 h and
    takes no GhostSpiral lock, so an operator can start the by-hand mix
    OPSEC_SETUP documents on the same machine -- and watch ends first and
    powers it off mid-mix, the one failure GhostSpiral says it cannot recover
    from automatically.
    """
    _d = artifact_dir if artifact_dir is not None else _LATE_GUARD.get("dir")
    _r = rpc if rpc is not None else _LATE_GUARD.get("rpc")
    if _d is not None:
        try:
            if (Path(_d) / INHIBIT_FILE).exists():
                return (f"{Path(_d) / INHIBIT_FILE} exists, so a person is "
                        f"using this machine.")
        except Exception:                                    # noqa: BLE001
            # A stat that raises is not evidence anybody is here. Fail open,
            # exactly as the file check always has.
            pass
    if _r:
        try:
            if scope_lock_taken(rpc_lock_scope(_r)):
                return ("a GhostSpiral run holds the lock on this wallet. A "
                        "mix mid-flight is the one thing here with no "
                        "automatic recovery.")
        except Exception:                                    # noqa: BLE001
            pass
    return ""


def _lock_is_held(path: Path) -> bool:
    """True if something holds the run lock right now.

    flock, so the kernel answers -- a stale lock file from a killed run is not
    a held lock, and a box that refuses forever because of a leftover file is a
    box that never wakes again.
    """
    import fcntl
    try:
        fh = open(path, "a+")
    except OSError:
        return False
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        fh.close()


