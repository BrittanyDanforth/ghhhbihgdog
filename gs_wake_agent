def load_key(path: Path) -> dict:
    try:
        st = os.stat(path)
    except OSError as e:
        raise Refused(
            "no_keyfile",
            f"no wake keyfile at {path} ({e.strerror}). This machine is not "
            f"paired with a doorbell, so it cannot tell a real job from a "
            f"magic packet anyone on the switch can send. If you just ran "
            f"paranoia_mode, it wiped the pairing: re-run gs_wake_keys with "
            f"physical access.") from e
    if stat.S_IMODE(st.st_mode) & 0o077:
        raise Refused("keyfile_perms",
                      f"{path} is group- or world-accessible (mode "
                      f"{stat.S_IMODE(st.st_mode):04o}); chmod 0400 it.")
    try:
        container = json.loads(Path(path).read_text())
    except Exception as e:                                   # noqa: BLE001
        raise Refused("keyfile_unreadable",
                      f"{path} is not readable JSON ({type(e).__name__})") from e
    # THIS ONE IS NOT SEALED, AND THE FILE SAYS SO RATHER THAN THIS CODE
    # ASSUMING IT. gs_wake_agent runs at boot with nobody here, on a disk that
    # unlocks itself so that it can: a passphrase this machine stores in order
    # to type it to itself is not a passphrase. See gs_wake_keys' docstring for
    # exactly what that costs, which is bounded and is not nothing.
    #
    # A SEALED file reaching here is a real mix-up worth naming: it is the Pi's,
    # and the Pi's file must never be on this box.
    if proto.keyfile_is_sealed(container):
        raise Refused(
            "keyfile_sealed",
            f"{path} is passphrase-sealed, which this machine's keyfile is "
            f"never allowed to be -- nobody is here at boot to type one. That "
            f"makes this the PI's keyfile, and it must not be on this box. Get "
            f"it off, then re-pair with `gs_wake_keys pair`.")
    try:
        k = proto.unlock_keyfile(container)
    except proto.WakeError as e:
        raise Refused("keyfile_schema", str(e)) from e
    if k.get("role") != "thinkpad":
        raise Refused("keyfile_role",
                      f"{path} is the {k.get('role')!r} keyfile. The Pi's file "
                      f"holds the DOORBELL's secret; this machine needs its "
                      f"own.")
    # THE DELIVERY KEY IS OPTIONAL, AND A MALFORMED ONE IS NOT.
    #
    # Checked HERE, at load, and not where it is used. If a mistyped hex string
    # first failed inside seal_slip_for_delivery, it would fail after the swap
    # was quoted -- and that function deliberately never raises, so the operator
    # would get a completed job, no slip, and a line on a terminal that is
    # 500 km away. A keyfile that cannot do what it says it will do should
    # refuse at the top, while the machine has done nothing yet.
    dp = k.get("delivery_public")
    if dp is not None:
        ok = isinstance(dp, str)
        if ok and dp != "":
            try:
                ok = len(bytes.fromhex(dp)) == 32
            except ValueError:
                ok = False
        if not ok:
            raise Refused(
                "delivery_public_malformed",
                f"{path} carries a delivery_public that is not 64 hex "
                f"characters (a 32-byte X25519 public key). Re-run "
                f"`gs_delivery_key new` rather than editing it by hand, or "
                f"remove the field to go back to leaving slips on this "
                f"machine.")
    # PLAINTEXT DELIVERY IS A KEYFILE DECISION, WHICH IS TO SAY A PHYSICAL ONE.
    #
    # It lives here and nowhere else on purpose: the Pi has no way to ask for
    # it, so a compromised Pi -- or a stolen bot token -- cannot turn the chat
    # into a plaintext channel. Changing it means being at the vault.
    ps = k.get("plain_slip")
    if ps is not None and not isinstance(ps, bool):
        raise Refused("plain_slip_malformed",
                      f"{path} carries a plain_slip that is not true or false.")
    # ONE MODE, NOT TWO. Sealed and plaintext answer the same question for
    # different operators, and an M3 carrying both would put the payload in the
    # transcript AND in a blob -- twice the exposure for one delivery. Refusing
    # here, at load, is the only place the operator is present to fix it.
    if ps and (k.get("delivery_public") or "").strip():
        raise Refused(
            "delivery_mode_ambiguous",
            f"{path} sets BOTH plain_slip and delivery_public. Those are two "
            f"answers to one question and this machine will not guess: sealed "
            f"delivery puts the payload where only gs_delivery.key can read "
            f"it, plaintext puts it in the chat. Remove one.")
    return k


def load_state(dirpath: Path) -> dict:
    p = dirpath / STATE_FILE
    try:
        d = json.loads(p.read_text())
        if not isinstance(d, dict):
            raise ValueError("not an object")
        d.setdefault("jobs", [])
        d.setdefault("wakes", [])
        return d
    except Exception as e:                                   # noqa: BLE001
        # A missing or corrupt ledger is not fatal, and it must not be: this
        # file lives where paranoia_mode wipes. Carry on with the Pi's copy,
        # which is the one that does not live on a wipeable disk.
        #
        # SAY IT, though. This comment claimed "say honestly what is lost" for
        # a whole draft while the code returned in silence -- a comment
        # describing a behaviour that was not there, which is the defect this
        # repo names most often. A missing file is the normal first boot and
        # says nothing; a file that EXISTS and will not parse is a fact the
        # operator needs, because the replay and wake-budget backstops both
        # start over from it.
        if p.exists():
            print(f"  [!] {p} exists but does not parse ({type(e).__name__}). "
                  f"Starting a NEW ledger: the local replay guard and the "
                  f"24 h wake budget both begin again from zero this boot. "
                  f"The doorbell's one-job-per-process rule still holds.")
            integrity_log("wake", "ledger_unreadable")
        return {"jobs": [], "wakes": []}


def save_state(dirpath: Path, state: dict) -> None:
    atomic_write_json(state, dirpath / STATE_FILE, perms=0o600)


# ---------------------------------------------------------------------------
#  Preflight: everything that must be true BEFORE the job is consumed
# ---------------------------------------------------------------------------
def preflight(key: dict, artifact_dir: Path, dry_run: bool,
              probes: dict = None) -> None:
    p = probes or {}
    _unit_active = p.get("unit_is_active", unit_is_active)
    _removable = p.get("removable_devices", removable_devices)
    _resources = p.get("resource_check", resource_check)
    _tor = p.get("tor_bootstrapped", tor_bootstrapped)
    _covers = p.get("wipe_covers", wipe_covers)

    # A human is present: an operator boot, or a mix already running. Refuse
    # the job and DISARM the deadman -- powering the box off under someone who
    # is using it is the one failure this feature must not introduce.
    inhibit = artifact_dir / INHIBIT_FILE
    if inhibit.exists():
        raise Refused("inhibited",
                      f"{inhibit} exists, so a person is using this machine. "
                      f"Not running a job and NOT powering off. Remove the "
                      f"file when you are done.", power=False)
    lock = artifact_dir / ".ghostspiral.lock"
    if lock.exists() and _lock_is_held(lock):
        raise Refused("mix_running",
                      "a GhostSpiral run holds the lock on this machine. Not "
                      "running a job and NOT powering off — a mix mid-flight "
                      "is the one thing here with no automatic recovery.",
                      power=False)

    if not dry_run and not _unit_active(DEADMAN_UNIT):
        # Doing a job on a box that cannot turn itself off is strictly worse
        # than refusing: it is the always-on vault this feature exists to end.
        raise Refused("no_deadman",
                      f"{DEADMAN_UNIT} is not active, so nothing would turn "
                      f"this machine off if the agent died. Refusing to start "
                      f"a job. Install the units in systemd/ from this repo.")

    rem = _removable()
    if rem:
        raise Refused("removable_media",
                      f"removable device(s) attached ({', '.join(rem)}). "
                      f"OPSEC_SETUP.md §4: the spend USB must not be in a "
                      f"machine a pager can wake. Refusing.")

    # resource_check, NOT require_resources. The latter returns None and
    # aborts by sys.exit, so `if not require_resources(...)` would have been
    # False-y on every healthy boot and refused every job -- caught by running
    # it. It also CONTINUES when psutil is missing, which is right for an
    # attended run and wrong here: nobody is watching, so a check that could
    # not be performed is not a check that passed.
    try:
        ok = _resources(2.0, 90.0)
    except ResourceCheckUnavailable:
        raise Refused("no_sentinel",
                      "psutil is not installed, so free disk and RAM were NOT "
                      "checked. An attended run may continue past this; an "
                      "unattended one must not — a job that fills the disk "
                      "leaves half-written artifacts nobody is watching for.")
    except Exception as e:                                   # noqa: BLE001
        raise Refused("sentinel_error",
                      f"the resource sentinel failed ({type(e).__name__}).")
    if not ok:
        raise Refused("resources",
                      "this machine is short of disk or memory. Refusing.")

    if not _covers(artifact_dir):
        # SAY WHICH OF THE TWO THIS IS. wipe_covers resolves against cwd and
        # $HOME, and the systemd unit sets both to the artifact directory on
        # purpose (gs-wake-agent.service:41-42). So this refusal has two very
        # different causes and only one of them is a misconfiguration:
        #
        #   * run by hand from an ordinary shell -> cwd and $HOME are the
        #     operator's, the sweep is anchored somewhere else, and this fires
        #     on a CORRECT install. It fired on the shipped default, on the
        #     command gs_wake_keys prints as "confirm the pairing works".
        #   * run by systemd with the unit as shipped -> genuinely misplaced.
        #
        # Telling an operator their install is broken when it is not is its
        # own defect, so name the by-hand case explicitly.
        raise Refused("outside_wipe_roots",
                      f"{artifact_dir} is outside every directory "
                      f"paranoia_mode searches, so the bundles and slips this "
                      f"job writes would never be erased. Refusing.\n"
                      f"      paranoia_mode's sweep is anchored on cwd and "
                      f"$HOME. If you are running this BY HAND to check a "
                      f"pairing, run it the way the unit does:\n"
                      f"          cd {artifact_dir} && HOME={artifact_dir} "
                      f"python3 gs_wake_agent --key ... --dry-run\n"
                      f"      If systemd runs it, set WorkingDirectory= and "
                      f"Environment=HOME= to {artifact_dir} in "
                      f"gs-wake-agent.service.")

    # NOW it is ours, so narrow it. run_job creates artifact_dir with
    # narrow_existing=False, which leaves a PRE-EXISTING directory's mode
    # alone -- correct there, because at that point this is just a path out of
    # a keyfile and might be the operator's cwd. wipe_covers passing settles
    # that: this tool guarantees paranoia_mode will securely ERASE this
    # directory, and refuses to run at all otherwise. A directory whose
    # contents this toolchain destroys is its own territory, not one it was
    # merely asked to write a file into, so 0755 here is a leak to fix rather
    # than an operator preference to respect.
    #
    # WARN RATHER THAN REFUSE. Everything above this line is fail-closed
    # because it names a condition this process cannot fix; a directory mode
    # is one it can, and bricking an unattended vault over something already
    # repaired would be its own defect. The mode is reported because a
    # too-wide directory means the artifacts of PREVIOUS runs were listable,
    # and this chmod does not undo that.
    try:
        _mode = stat.S_IMODE(artifact_dir.stat().st_mode)
        if _mode & 0o077:
            os.chmod(artifact_dir, 0o700)
            agent_say(f"[!] {artifact_dir} was mode {_mode:04o} — group/other "
                      f"could list this run's artifacts. Narrowed to 0700. "
                      f"Anything earlier runs left here was listable too.")
    except OSError as e:                                     # noqa: BLE001
        # Not fatal: the files inside are 0600 regardless, and refusing the
        # job would be a worse outcome than a wide directory.
        agent_say(f"[!] could not read or narrow the mode of {artifact_dir} "
                  f"({type(e).__name__}). Continuing; check it by hand.")

    if not _tor(key.get("tor_proxy", "")):
        raise Refused("tor_down",
                      f"this machine's own Tor is not answering on "
                      f"{key.get('tor_proxy')}. Refusing BEFORE asking for the "
                      f"job, so the job is still waiting at the doorbell for "
                      f"the next boot.")


def _lock_is_held(path: Path) -> bool:
    """True if something holds the run lock right now.

    flock, so the kernel answers -- a stale lock file from a killed run is not
    a held lock, and a box that refuses forever because of a leftover file is a
    box that never wakes again.
    """
    import fcntl
    try:
        fh = open(path, "a+")
    except OSError:
        return False
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        fh.close()


# ---------------------------------------------------------------------------
#  argv composition. Nothing from the note becomes a flag.
# ---------------------------------------------------------------------------
def _tool(name: str) -> str:
    return str(Path(__file__).resolve().parent / name)


def build_argv(job: str, params: dict, key: dict, artifact_dir: Path,
               bundle: str = None, slip: str = None, handle: str = None) -> list:
    """(argv, env_extra) pairs for one job, composed ENTIRELY from the fixed
    template plus this machine's own keyfile.

    The only things that come from the note are: an int already range-checked
    against a closed schema, and a handle already matched against
    ^[0-9A-F]{4}$. Neither is ever a flag name, a path, a URL or a proxy.
    """
    proxy = key["tor_proxy"]
    rpc = key["rpc_primary"]
    if job == "receive_new":
        return [[sys.executable, _tool("create_receive_wallet"),
                 "--tor-proxy", proxy, "--rpc", rpc,
                 "--count", str(int(params["count"])),
                 "--output-dir", str(artifact_dir)]]
    if job == "receive_and_quote":
        # RE-CHECKED HERE, and the bounds come from the protocol rather than
        # from a literal typed in this file. The predecessor of this branch
        # read a ladder slot and checked `slot >= len(ladder)` -- one end only
        # -- so a NEGATIVE slot indexed from the far end (ladder[-1] is the
        # largest rung) and the refusal never fired. What actually stopped it
        # was _int_range two files away, which is a real check and is also
        # somebody else's. The lesson survives the ladder's removal: this is
        # the box that acts on the number, so it bounds the number, and it
        # bounds BOTH ends by asking the schema rather than by restating it.
        _amt = params["amount_sat"]
        try:
            proto.JOBS["receive_and_quote"]["schema"]["amount_sat"](_amt)
        except Exception as e:                               # noqa: BLE001
            raise Refused("bad_amount",
                          f"the note's deposit amount is not one this "
                          f"machine will quote: {e}")
        return [
            [sys.executable, _tool("create_receive_wallet"),
             "--tor-proxy", proxy, "--rpc", rpc,
             "--count", "1", "--output-dir", str(artifact_dir)],
            # The amount rides in the ENVIRONMENT. /proc/<pid>/cmdline is 0444
            # and gs_common.env_or_argv's docstring records what argv already
            # cost this repo three times.
            [sys.executable, _tool("thor_swap_preparer"),
             "--tor-proxy", proxy,
             "--dest-from-receive-wallet", str(bundle),
             "--outfile", str(artifact_dir / f"thor_pairs_{handle}.json")],
        ]
    if job == "watch":
        return [[sys.executable, _tool("receive_watch"),
                 "--tor-proxy", proxy, "--rpc", rpc,
                 "--receive-wallet", str(bundle),
                 "--pairs", str(slip),
                 # Inside the 7200 s budget, and the same number OPSEC_SETUP.md
                 # §5 step 7 states. --choice is omitted deliberately: with
                 # stdin closed the prompt cannot fire, and omitting the flag
                 # is the only value under which the tool cannot print a mix
                 # command.
                 "--timeout-min", "110",
                 # AND IT REPORTS WHAT IT SAW, for the same reason swap_status
                 # does. Without this, receive_watch exits non-zero when the
                 # 110 minutes run out and the pager says "watch: failed." --
                 # about money that is simply still in flight. That is the
                 # exact sentence swap_status was built to stop saying, on the
                 # command an operator uses when they are least able to check
                 # anything themselves.
                 #
                 # The path is composed from the keyfile's artifact_dir and a
                 # fixed name, like the swap_status one: no operator input
                 # reaches it. Both jobs writing one file is safe because the
                 # pager runs one wake at a time and reads the file
                 # immediately.
                 #
                 # --stall-min is left at its default (30), which is inside
                 # this 110-minute window; passing 110 would make the shortfall
                 # check unable to fire at all and receive_watch warns about
                 # exactly that.
                 "--result-json", str(artifact_dir / STATUS_FILE)]]
    if job == "swap_status":
        # LOOK, DO NOT WAIT. Three minutes inside a 300 s budget: enough for
        # the wallet to answer, and the vault is off again before the wake is
        # worth noticing. --result-json is what makes the answer more than a
        # boolean; without it every outcome but "funded" reaches the operator
        # as "the vault FAILED".
        return [[sys.executable, _tool("receive_watch"),
                 "--tor-proxy", proxy, "--rpc", rpc,
                 "--receive-wallet", str(bundle),
                 "--pairs", str(slip),
                 "--timeout-min", "3",
                 # stall_min must not exceed timeout_min or the tool warns and
                 # the stall check can never fire inside the window anyway.
                 "--stall-min", "3",
                 "--result-json", str(artifact_dir / STATUS_FILE)]]
    if job == "withdraw":
        # THE ADDRESS IS NOT HERE, and that is the whole point of this branch.
        #
        # It is the first operator-chosen string this channel carries, it
        # crosses a machine boundary, and it is handed to a subprocess -- so it
        # goes in GS_EXIT_TO, set by the runner below, exactly like
        # GS_SWAP_AMOUNTS. /proc/<pid>/cmdline is 0444 and every local account
        # on this box could read an argv for the whole run; more importantly,
        # a value that never reaches an argv cannot become a flag however it
        # is shaped.
        #
        # --receive-wallet, so the mix spends the bundle this handle names and
        # nothing else on the wallet. --dag-mixing because a withdrawal the
        # operator cannot supervise should take the stronger of the two shapes
        # rather than the faster one; the budget is sized for it.
        # --wallet-file IS NOT OPTIONAL HERE, and leaving it out is what made
        # the first version of this job unable to complete at all.
        #
        # GhostSpiral's Round 1 runs `airgap_tx_signer --phase sign
        # --wallet-file <path>` with the password in the environment. Both
        # arguments have DEFAULTS -- "offline.wallet" and "" -- so composing
        # neither does not fail loudly: the mix plans, veils, relays a fan-out,
        # waits out its confirmations, and dies hours later at "phase 'sign'
        # produced no signed TX files". Every earlier stage succeeded, so the
        # money has already moved on-chain when it stops.
        #
        # The path comes from THIS MACHINE'S keyfile, like every other path
        # here. It is not a job parameter and must never become one: a wake
        # note that could name a wallet file could name any file on the vault.
        _wf = key.get("wallet_file")
        if not _wf:
            raise Refused(
                "no_wallet_file",
                "this machine's keyfile does not say which wallet to sign "
                "with, so the mix would relay a fan-out and then fail at the "
                "signing step with the money already moved. Re-pair with "
                "--wallet-file.")
        return [[sys.executable, _tool("GhostSpiral"),
                 "--tor-proxy", proxy, "--rpc-primary", rpc,
                 # THE DAEMON, FROM THIS MACHINE'S KEYFILE.
                 #
                 # GhostSpiral reads the network fee from --rpc-daemon and
                 # REFUSES the run rather than guessing when it cannot: the
                 # fallback measured 38-58x below the real fee, so every hop
                 # under-reserved and the run died on a later hop with "not
                 # enough money" after the fan-out had already gone on chain.
                 #
                 # So a vault whose monerod is not on GhostSpiral's default
                 # port failed EVERY woken withdrawal at stage 0, and the chat
                 # said "withdraw: refused." with nothing the operator could
                 # change -- gs_console has this as a settable field and the
                 # wake path did not. It fails safe, before anything is spent,
                 # which is why this is a configuration gap and not the
                 # money-losing kind.
                 #
                 # .get() with GhostSpiral's own default, so a keyfile written
                 # before gs_wake_keys grew --rpc-daemon behaves exactly as it
                 # did and no re-pairing is needed.
                 "--rpc-daemon", str(key.get("rpc_daemon")
                                     or "http://127.0.0.1:18081"),
                 "--receive-wallet", str(bundle),
                 "--wallet-file", str(_wf),
                 "--dag-mixing",
                 # FROM THE OPERATOR'S CHOSEN DEPTH, via a closed table --
                 # never GhostSpiral's own default, and never a raw number off
                 # the note. Leaving it to the default made the job's runtime
                 # a property of a default in another file: at --wallets 20
                 # the same run takes 13.1 h and at 40 it takes far longer,
                 # and nothing here would have noticed either. Depth and
                 # budget are one setting: gs_wake_proto sizes budget_s from
                 # the deepest row of this same table, and
                 # tests/test_wake_agent.py recomputes both from GhostSpiral's
                 # arithmetic so they cannot drift apart.
                 "--wallets", str(withdraw_wallets(params["depth"])),
                 # THE CUT. See the GS_USAGE_FEE_ADDRESS block in _dispatch
                 # for why this was missing and what it cost. A boolean with
                 # no value in it: the address, if this machine's keyfile
                 # names one, rides in the environment instead.
                 "--usage-fee",
                 "--output", str(artifact_dir)]]
    raise Refused("unknown_job", "no argv template for this job")


#: Where a woken job's children write. NOT the journal. 0600, in the artifact
#: directory, so paranoia_mode wipes it with the rest of the run.
JOB_LOG = "gs_wake_job.log"

#: Filled in by run_once once the keyfile names the artifact directory.
_AGENT_LOG: list = [None]


def agent_say(msg: str) -> None:
    """Print, AND append to the 0600 job log once we know where it is.

    THE UNIT SILENCES stdout AND stderr, and it has to: the children print the
    BTC deposit address and the ThorChain memo, and systemd would journal them
    onto the SD card. But the agent's OWN refusal reasons and tracebacks went
    out the same pipe, so silencing it took those too -- and with
    OnFailure=gs-wake-poweroff.service, a vault that refuses for no_keyfile,
    keyfile_perms or outside_wipe_roots now boots, powers itself off, and
    leaves NOTHING behind saying why. Only the terse code reached the chain.

    So the reason goes where the children's output already goes: the artifact
    directory, 0600, gitignored, on paranoia_mode's wipe list. Diagnostics
    survive exactly as long as the artifacts do, and no longer.

    Never raises: a logging call must not become the thing that aborts a wake.
    """
    print(msg)
    _p = _AGENT_LOG[0]
    if _p is None:
        return
    try:
        _fd = os.open(str(_p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(_fd, "a") as _fh:
            _fh.write(msg.rstrip("\n") + "\n")
    except Exception:                                        # noqa: BLE001
        pass


def run_child(argv: list, env_extra: dict, budget_s: int,
              runner=None, log_path: Path = None) -> tuple:
    """Run one child under a watchdog. Returns (rc, killed_hard).

    THE CHILD'S OUTPUT MUST NOT REACH THE JOURNAL, and this is the worst leak
    this feature has had. gs-wake-agent.service is a systemd unit with no
    StandardOutput=, so everything its children printed went to
    /var/log/journal -- and the children are thor_swap_preparer, which prints
    the BTC deposit address and the THORCHAIN MEMO. The memo names the
    destination XMR address in plain text. So the one string this entire
    toolchain exists to keep off durable storage was being written to a
    persistent, root-owned, journald-rotated file on the vault, which
    paranoia_mode does not touch and cannot reach.

    The slip on disk is 0600 and gets wiped. Its contents were being copied
    into a log nobody thought of as a copy.

    So: the unit is silenced, and the children write HERE instead -- 0600, in
    the artifact directory, inside paranoia_mode's sweep. Diagnostics survive
    for as long as the artifacts do and no longer.
    """
    if runner is not None:
        return runner(argv, env_extra, budget_s)
    env = dict(os.environ)
    # EVERY GS_ VARIABLE IS STRIPPED, AND ONLY env_extra PUTS ANY BACK.
    #
    # This was `dict(os.environ)` and nothing else, so every child of every job
    # inherited the agent's whole environment. That was harmless while the unit
    # set no GS_ variables -- and it stops being harmless the moment one is
    # needed: adding GS_WALLET_PASSWORD to the unit so the mix can sign would
    # hand the spend password to thor_swap_preparer, to create_receive_wallet,
    # and to anything else a job runs.
    #
    # GhostSpiral's own _child_env exists for exactly this, one layer up, and
    # its docstring says why: "a third-party child that logs or dumps its
    # environment would leak it". gs_console's _child_env does the same with an
    # allow-list per action. This is the third copy of that rule, at the layer
    # that actually spawns the processes.
    #
    # An ALLOW-LIST BY CONSTRUCTION: the only way a GS_ variable reaches a
    # child is for the dispatcher to have put it in env_extra for THAT step.
    for _k in [k for k in env if k.startswith("GS_")]:
        env.pop(_k, None)
    env["PYTHONUNBUFFERED"] = "1"
    env.update(env_extra or {})
    sink = None
    if log_path is not None:
        # 0600 at creation, not after: a world-readable window while a memo is
        # being written to it is a window.
        fd = os.open(str(log_path),
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        sink = os.fdopen(fd, "ab", buffering=0)
    # start_new_session so the watchdog can signal the whole GROUP: a tool that
    # spawns monero-wallet-cli must not leave it behind.
    try:
        p = subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL,
                             stdout=sink or subprocess.DEVNULL,
                             stderr=subprocess.STDOUT,
                             start_new_session=True)
    finally:
        if sink is not None:
            sink.close()
    try:
        return p.wait(timeout=budget_s), False
    except subprocess.TimeoutExpired:
        import signal
        try:
            os.killpg(p.pid, signal.SIGTERM)
        except Exception:                                    # noqa: BLE001
            p.terminate()
        try:
            return p.wait(timeout=JOB_TERM_GRACE_S), False
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except Exception:                                # noqa: BLE001
                p.kill()
            p.wait(timeout=30)
            return -9, True


# ---------------------------------------------------------------------------
#  One wake
# ---------------------------------------------------------------------------
def run_once(args, deps: dict = None) -> tuple:
    """Do at most one job. Returns (code, status, handle).

    NEVER calls sys.exit itself: main() owns the exit code because main() owns
    the finally that powers the machine off. It can still PROPAGATE a
    SystemExit raised by gs_common's own fail-closed aborts (verify_tor), and
    that is fine -- main()'s finally catches every path, and past collection
    such an abort is reported to the doorbell as a refusal like any other.

    `status` is what the doorbell is told, and it is deliberately coarse:
    done / refused / failed. The REASON stays on this machine. A doorbell that
    learns why a job was refused learns something about this wallet.
    """
    d = deps or {}
    _post = d.get("post_record", post_record)
    _sleep = d.get("sleep", time.sleep)
    _clock = d.get("clock", time.monotonic)
    _rng = d.get("rng", random.SystemRandom())
    _child = d.get("run_child", None)
    _verify_tor = d.get("verify_tor", None)
    _accounts = d.get("account_count", None)

    proto.require_nacl()
    import nacl.public

    key = load_key(Path(args.key))
    artifact_dir = Path(key.get("artifact_dir") or ".").resolve()
    # secure_mkdir, NOT a bare mkdir. This was `mkdir(parents=True,
    # exist_ok=True)`, which is 0777 & ~umask -- measured 0755 under the
    # default umask, and the shipped unit sets no UMask=. The FILES written
    # here are 0600, but the LISTING is the leak this toolchain treats as real
    # everywhere else (see secure_mkdir): a local account could enumerate
    # thor_pairs_*.json, wallet_*.json, the job log and the status file, and
    # so learn how many swaps were arranged, when, and that this machine runs
    # a Monero cold-signing operation at all. Driven as a real unprivileged
    # uid: all four artifact names were listable. Every other directory in the
    # repo already goes through secure_mkdir; this was the one bare call left.
    #
    # narrow_existing=False, deliberately. artifact_dir defaults to "." when
    # the keyfile omits it, so a pre-existing directory here may be the
    # operator's own cwd -- and silently chmod'ing a directory you were merely
    # asked to write into is the exact regression secure_mkdir's docstring
    # records from create_receive_wallet. A directory this CREATES is 0700,
    # including its parents; one that already existed is narrowed in
    # preflight, after wipe_covers has established it is this tool's own
    # territory rather than somewhere borrowed.
    secure_mkdir(artifact_dir, narrow_existing=False)
    # From here on agent_say() has somewhere durable to write. Anything refused
    # BEFORE this line (a missing or world-readable keyfile) is still terminal
    # only -- there is no trusted directory to write to yet, and inventing one
    # from an untrusted keyfile is how you get a log outside the wipe roots.
    _AGENT_LOG[0] = artifact_dir / JOB_LOG

    preflight(key, artifact_dir, args.dry_run, probes=d)

    tp_sk = nacl.public.PrivateKey(bytes.fromhex(key["secret"]))
    pi_pk = nacl.public.PublicKey(bytes.fromhex(key["peer_public"]))

    # PER-BOOT EPHEMERAL. M2 is boxed to this, never to the static key, so a
    # door kick that yields the Pi's long-term secret does not decrypt months
    # of M2s recorded off the switch -- and a replayed M1 cannot open at the M2
    # reader at all. Generated here, never written down, gone when this process
    # ends and the machine powers off minutes later.
    eph = nacl.public.PrivateKey.generate()
    challenge = proto.new_challenge()

    # THE DOORBELL'S CURRENT WINDOW, FETCHED BEFORE ANYTHING IS SEALED. An M1
    # is otherwise valid forever: capture one on-path ONCE and it can be
    # replayed from anywhere on the switch at every future wake, taking each
    # job and leaving this machine to boot, be told "no job", and power off.
    # Echoing the window binds the note to the wake it was written for.
    wstat, window = _post(key["doorbell_url"], "/window", b"")
    if wstat != 200 or len(window) != proto.WINDOW_BYTES:
        raise Refused("doorbell_unreachable",
                      "the doorbell did not hand over a wake window, so there "
                      "is nothing to bind this note to. Nothing was handed "
                      "over, so the job is still waiting.")

    # --dry-run STOPS HERE, AND THE REASON IS THAT M1 IS NOT A QUESTION.
    #
    # Driven, before this existed: `--dry-run` sent a real M1, the doorbell
    # handed the job over -- consuming its at-most-once handover -- and the
    # agent went on to run create_receive_wallet and thor_swap_preparer FOR
    # REAL, minting a wallet and quoting a live swap over Tor. Its own --help
    # said "do everything except run a job and power off", and OPSEC_SETUP
    # tells the operator to use it to confirm the pairing before relying on
    # the machine. The one command described as safe was the one that spent a
    # wake and a job.
    #
    # There is no way to ask the doorbell "would you hand me a job?" without
    # taking it: at-most-once is a property of the handover, and that is
    # correct. So the dry run stops one line before the question.
    #
    # WHAT IT STILL PROVES, and this is most of what actually breaks: the
    # keyfile loads and is 0400, preflight passes (deadman armed, no removable
    # disk, disk and RAM fine, inside the wipe roots), Tor is up, the doorbell
    # is reachable at the address in the keyfile, and it answered with a
    # well-formed wake window.
    #
    # WHAT IT DOES NOT PROVE, said out loud rather than implied: that the two
    # keyfiles are a matched pair. That takes a real M1, which takes a real
    # job. The first genuine poke is the test of that, and it is one the
    # operator can watch.
    if args.dry_run:
        agent_say("  [+] Dry run: keyfile, preflight, Tor and the doorbell "
                  "all check out.")
        agent_say(f"      The doorbell answered at {key['doorbell_url']} with "
                  f"a {len(window)}-byte wake window.")
        agent_say("      NOT proven: that the two keyfiles are a matched "
                  "pair. Testing that needs a real")
        agent_say("      note, and a real note TAKES THE JOB — the handover "
                  "is at-most-once. So this")
        agent_say("      stops here rather than spending your poke to tell "
                  "you it worked.")
        raise Refused("dry_run",
                      "dry run complete; nothing was collected and nothing "
                      "ran.", power=False)

    m1 = proto.seal(tp_sk, pi_pk, proto.TAG_M1,
                    {"eph_pk": eph.public_key.encode().hex(),
                     "challenge": challenge.hex(),
                     "window": window.hex()})
    sent_at = _clock()
    status, m2 = _post(key["doorbell_url"], "/wake", m1)
    # UNREACHABLE AND NO-JOB ARE DIFFERENT FACTS WITH DIFFERENT ACTIONS, and
    # the first version collapsed them: post_record returns (0, b"") when the
    # request never completed, and `if status == 204 or not m2` caught that
    # first -- so a dead Pi, a pulled cable or a wrong LAN address all reported
    # "the doorbell has no job for this boot", i.e. "somebody sent a stray
    # magic packet". The operator checks the switch for an intruder while the
    # actual fault is their own network. Caught by driving it.
    if status == 0:
        raise Refused("doorbell_unreachable",
                      "could not reach the doorbell at all. The Pi may be "
                      "down, the cable out, or the address wrong. Nothing was "
                      "handed over, so the job is still waiting.")
    if status == 204 or not m2:
        # DWELL BEFORE DYING. A boot that powers off the instant it is told
        # "nothing for you" has an uptime of a few seconds, and that shape is
        # itself a statement: whoever sent that packet did not have a note for
        # this machine. Sitting a random 1-3 min removes the instant
        # boot-and-die tell. It does NOT make this look like a job boot -- a
        # real job waits 5-20 min of jitter before it starts anything -- and
        # neither this comment nor the table in OPSEC_SETUP.md claims it does.
        #
        # This block is the fix for a defect in the first version of this
        # file: NO_JOB_DWELL_LO_S/HI_S were declared, documented in the doc's
        # threat table, and never called. Dead constants that look like a
        # feature are worse than no feature, because the operator plans around
        # them.
        #
        # THERE IS NO --dry-run GUARD HERE ANY MORE, and its absence is the
        # point. It read `if not args.dry_run:` -- correct when a dry run
        # reached this line, and unreachable now that a dry run stops before
        # M1 is ever sent. A dead guard is the same defect as a dead constant
        # in the other direction: it reads as a case that is handled.
        _sleep(_rng.randint(NO_JOB_DWELL_LO_S, NO_JOB_DWELL_HI_S))
        raise Refused("no_job",
                      "the doorbell answered, and it has no job for this boot. "
                      "That is what a magic packet from anyone on the switch "
                      "looks like: boot, sit, shut down.")
    if status != 200:
        raise Refused("doorbell_unreachable",
                      f"the doorbell answered {status}, which is not an "
                      f"answer this protocol has. Nothing was handed over.")

    body = proto.open_record(eph, pi_pk, m2, proto.TAG_M2)

    # ONE JOB PER BOOT is a property of the process, not of a flag: run_once is
    # called exactly once from main(), there is no loop, and the ephemeral and
    # the challenge are locals that die with it. An earlier draft set the
    # challenge to None here and checked it on the next line -- a guard that
    # could never fire, wearing a safety net's clothes. This repo has a name
    # for that ("a comment claiming a gate where there is none") and deletes
    # them rather than testing them.
    got = proto.challenge_of(body)
    if not _ct_eq(got, challenge):
        raise Refused("challenge_mismatch",
                      "the doorbell's answer does not echo this boot's "
                      "challenge.")
    # VALIDATE BEFORE THE WINDOW CHECK, so a slow answer still knows its
    # job_id and can be REPORTED. Order is safe: the body is already
    # authenticated and already bound to this boot's challenge, and
    # validate_job only reads a closed, typed schema out of it.
    job_id, job, params = proto.validate_job(body)

    elapsed = _clock() - sent_at
    if elapsed > M1_M2_WINDOW_S:
        # NEVER the word "expired". The job is current; what is out of bounds
        # is the round trip, and saying so is the difference between an
        # operator checking the network and an operator checking a clock.
        raise _reported(key, d, job_id, challenge, Refused(
            "slow_answer",
            f"the doorbell answered {int(elapsed)} s after the "
            f"challenge; the window is {M1_M2_WINDOW_S} s."))

    # ONCE THE JOB IS OFF THE DOORBELL, THE DOORBELL IS OWED AN ANSWER.
    # Only the post-dispatch refusal reported back, so every refusal between
    # collection and dispatch -- a replayed job_id, the 24 h wake budget, the
    # account ceiling, an empty ladder slot, an unwatchable handle, a Tor
    # check that aborts -- left the Pi to time out and tell the operator
    # "collected but never reported back ... this job may already be done.
    # CHECK THE VAULT." Nothing had run. That is the defect this repo names
    # most often, wearing a network timeout as a disguise.
    #
    # SystemExit is in the handler because gs_common's verify_tor aborts that
    # way; an abort is still a refusal the doorbell can be told about, and
    # main()'s finally still powers the machine off after it.
    try:
        return _run_validated(d, key, artifact_dir, state_deps=(
            job_id, job, params, challenge, _sleep, _rng, _verify_tor,
            _accounts, _child))
    except (Refused, SystemExit) as e:
        report_back(key, job_id, challenge.hex(), "refused", "",
                    poster=d.get("post_record"))
        raise e


def _run_validated(d, key, artifact_dir, state_deps) -> tuple:
    """Everything after the job is validated. Its refusals all report back."""
    # _post is deliberately NOT threaded through: everything in here that
    # talks to the doorbell goes via report_back(poster=d.get("post_record")),
    # so a second handle on the same channel would be a second thing to keep
    # in step. The M1 POST is run_once's, and it is already done by here.
    (job_id, job, params, challenge, _sleep, _rng, _verify_tor,
     _accounts, _child) = state_deps

    state = load_state(artifact_dir)
    if job_id in {j.get("id") for j in state["jobs"]}:
        prev = next(j for j in state["jobs"] if j.get("id") == job_id)
        raise Refused("job_replayed",
                      f"this machine already started job {job_id[:8]} at "
                      f"{prev.get('at')}. It may or may not have finished — "
                      f"check {artifact_dir} before poking again.")

    # A 24 h wake budget. A wipe resets it, and the account ceiling below is
    # the half that cannot be reset from this disk.
    now_wall = int(time.time())
    recent = [w for w in state["wakes"] if now_wall - int(w) < 86400]
    if len(recent) >= int(key.get("daily_wake_budget", 12)):
        raise Refused("wake_budget",
                      f"{len(recent)} wakes in the last 24 h, which is the "
                      f"budget. Refusing.")

    if job in ("receive_new", "receive_and_quote"):
        ceiling = int(key.get("account_ceiling", 45))
        n = _account_count(key, _accounts)
        if n is None:
            raise Refused("account_count_unreadable",
                          "could not read how many accounts this wallet "
                          "holds, so the ceiling that stops a doorbell "
                          "minting past the offline wallet's lookahead cannot "
                          "be enforced. Refusing.")
        if n >= ceiling:
            raise Refused("account_ceiling",
                          f"this wallet holds {n} accounts and the ceiling is "
                          f"{ceiling}. OPSEC_SETUP.md §4: the offline signing "
                          f"wallet derives subaddresses for a bounded number. "
                          f"Refusing to mint more from a pager.")

    # WRITE THE LEDGER BEFORE DISPATCH. If power is lost mid-job, the next boot
    # must refuse this job_id rather than run it twice -- a second slip would
    # overwrite the first, and if BTC was already sent against the first, the
    # only record of what was paid is gone.
    state["jobs"] = (state["jobs"] + [{"id": job_id, "job": job,
                                       "at": now_wall}])[-200:]
    # `recent` already dropped everything older than 24 h, so this is the
    # window plus this wake -- not an append to the unpruned list.
    state["wakes"] = recent + [now_wall]
    save_state(artifact_dir, state)
    integrity_log("wake", f"job_accepted:{job}")

    # JITTER. After the note is validated and the ledger is written, before any
    # network work the job does. OPSEC_SETUP.md §5 step 4.
    delay = _rng.randint(JITTER_LO_S, JITTER_HI_S)
    print(f"  [*] Job {job} accepted. Waiting {delay // 60} min before "
          f"starting, so the boot and the swap are not the same moment.")
    _sleep(delay)

    # The FULL Tor check now, with an exit request. Its sys.exit is caught by
    # main()'s finally, which powers off.
    if _verify_tor is not None:
        _verify_tor()
    else:
        from gs_common import validate_proxy, verify_tor as _vt
        _vt(validate_proxy(key["tor_proxy"]))

    handle = proto.new_handle()
    # EVERYTHING PAST THE LEDGER REPORTS BACK, including a refusal. An earlier
    # draft returned without ever sending M3, so report_back was dead code and
    # the doorbell reported "collected_no_result" after every successful job --
    # sending the operator to check a vault that had already finished and
    # powered off. Refusals report too: "refused" with no handle and no reason,
    # because a doorbell that learns WHY a job was refused learns something
    # about this wallet.
    # A refusal raised in here is reported by run_once's handler, which now
    # covers this and every other refusal past collection alike -- rather than
    # this one path having its own copy and the rest having none.
    # A SPENDING JOB IS REFUSED UNLESS THIS MACHINE'S OWN KEYFILE ALLOWS IT,
    # AND UNLESS THE BACKSTOP CAN BE MADE TO FIT IT. Both gates here, after
    # collection and before any work, because both answers are the vault's and
    # neither may be inferred from the note.
    # Injectable like every other side effect in here, so a test can drive the
    # refusal without a systemd on the box.
    _extend_deadman = d.get("extend_deadman", extend_deadman)
    if job in getattr(proto, "SPENDING_JOBS", ()):
        # THE KEYFILE, NOT THE NOTE. `allow_withdraw` is written with physical
        # access, like the amount ladder, and is ABSENT from every keyfile
        # written before this job existed -- so upgrading the code does not
        # silently give a pager the ability to spend. getattr-with-default is
        # deliberate: an old keyfile means "no".
        if not key.get("allow_withdraw"):
            raise Refused(
                "withdraw_not_allowed",
                "this machine's keyfile does not allow spending jobs. That is "
                "the default, and turning it on means the spend wallet is "
                "reachable by a machine a pager can wake -- re-pair with "
                "--allow-withdraw, with physical access, if you mean it.")
        # THE BACKSTOP MUST OUTLAST THE JOB, or it becomes the thing that
        # breaks it. The shipped deadman is sized for the largest NON-spending
        # job; a mix runs far past it, and a power-off mid-round is the one
        # failure GhostSpiral cannot recover from automatically.
        _need = int(proto.result_budget_s(job)) + 600
        if not _extend_deadman(_need):
            raise Refused(
                "deadman_too_short",
                "could not arm a backstop long enough for this job, so it was "
                "not started. The short one is still armed and this machine "
                "will still power itself off.")
    code, status, handle = _dispatch(job, params, key, artifact_dir,
                                     handle, _child, job_id)
    # A STATUS PROBE REPORTS THE HANDLE IT WAS ASKED ABOUT, not the fresh one
    # _run_validated drew. See _dispatch: handles[] is written only for
    # receive_and_quote and receive_new, and the collision loop guarantees the
    # drawn handle is absent from the file -- so a watch used to answer
    # "ready · slip 7C3D" for a label the operator could not look up.
    if job in ("watch", "swap_status"):
        handle = params["handle"]
    slip = seal_slip_for_delivery(key, artifact_dir, status, handle)
    plain = plain_slip_for_chat(key, artifact_dir, status, handle)
    phase = _phase_of(job, artifact_dir)
    report_back(key, job_id, challenge.hex(), status, handle, slip=slip,
                plain=plain, phase=phase, poster=d.get("post_record"))
    return code, status, handle


#: receive_watch's own outcome word -> the one word this protocol has for it.
#: Its five outcomes collapse into three exit codes and then, at `if rc != 0`,
#: into one boolean -- which is why "your money has not arrived yet" reached
#: the phone as "the vault FAILED". The mapping is restored from the machine
#: readable result file rather than from stdout, because a tool's human-facing
#: output is not an interface.
_PHASE_OF_STATE = {
    "funded": "landed",
    "stalled": "short",
    "not_syncing": "stuck",
    "timeout": "not_yet",
    "interrupted": "",
}


def _phase_of(job: str, artifact_dir: Path, reader=None) -> str:
    """The one word a status probe earned, or "". NEVER raises.

    BOTH WATCHING JOBS, not just the short one. `watch` used to be excluded
    here, so a 110-minute wait that ended with the money still in flight came
    back to the operator as "watch: failed." -- money that has not arrived
    reported as a failure of the machine, which is the precise sentence
    swap_status exists to stop saying. Both now write the same status file and
    both are read the same way.
    """
    if job not in ("swap_status", "watch"):
        return ""
    try:
        out = (reader or _read_json)(Path(artifact_dir) / STATUS_FILE) or {}
        word = _PHASE_OF_STATE.get(out.get("state"), "")
        # TIMEOUT SPLITS IN TWO, and the split is the whole point of a THREE
        # MINUTE probe. receive_watch has no "arriving" state because it is
        # built to wait for hours, so a payment that is on-chain and still
        # confirming looks identical to an empty address inside a short
        # window -- both come back "timeout". `total` is what separates them,
        # and telling an operator "nothing yet" when their money is two
        # confirmations away is the same class of wrong answer as telling them
        # the vault failed.
        if word == "not_yet":
            try:
                if Decimal(str(out.get("total") or "0")) > 0:
                    word = "arriving"
            except (InvalidOperation, ValueError):
                pass                      # unreadable total: stay with not_yet
        return word if proto.phase_is_known(word) else ""
    except Exception:                                        # noqa: BLE001
        # No file, unreadable, or a state word this version has never heard of.
        # "" is honest: the pager then says the probe ran and told us nothing,
        # which is true, rather than inventing a reassurance.
        return ""


def _reported(key, d, job_id, challenge, exc):
    """Tell the doorbell 'refused', then hand back the exception to raise."""
    report_back(key, job_id, challenge.hex(), "refused", "",
                poster=d.get("post_record"))
    return exc


def _ct_eq(a: bytes, b: bytes) -> bool:
    import hmac
    return hmac.compare_digest(a, b)


def _account_count(key: dict, injected=None):
    if injected is not None:
        return injected()
    try:
        from gs_common import connect_rpc
        rpc = connect_rpc(key["rpc_primary"], proxy_url=key.get("tor_proxy", ""))
        r = rpc.raw_request("get_accounts", {}) or {}
        return len(r.get("subaddress_accounts") or [])
    except Exception:                                        # noqa: BLE001
        return None


def _funded_entry(key: dict, injected=None):
    """The (account, subaddress, address, atomic) holding this wallet's money.

    THE VAULT ANSWERS THIS, NOT THE PHONE. A withdrawal used to name a 4-hex
    handle pointing at a receive bundle a /depo had minted -- which meant only
    money that arrived through this tool's own deposit flow could be withdrawn
    at all, and the operator had to remember which label named which pile. The
    machine holding the wallet is the one that can see where the money is;
    asking a chat message to name an account index was asking the wrong box.

    THE LARGEST SINGLE OUTPUT, and it is a deliberate refusal to be clever.
    Summing several subaddresses would mean a mix whose first transaction
    spends inputs from all of them, which is permanent public proof they share
    an owner -- exactly what the rest of this pipeline spends hours avoiding.
    One output in, one mix, one destination. If the operator has money in three
    places, that is three withdrawals, and that is the honest cost rather than
    a merge dressed up as convenience.

    UNLOCKED ONLY. A balance that has not unlocked cannot be spent, and a mix
    planned around it fails partway with money already moved.

    RETURNS None WHEN NOTHING QUALIFIES, and the caller refuses. Guessing an
    account here would point a spend at the wrong pile.
    """
    if injected is not None:
        return injected()
    try:
        from gs_common import connect_rpc
        rpc = connect_rpc(key["rpc_primary"], proxy_url=key.get("tor_proxy", ""))
        try:
            rpc.raw_request("refresh", {})
        except Exception:                                    # noqa: BLE001
            # A refresh that fails is not fatal -- the balances below are
            # whatever the wallet has already scanned. It is worth trying
            # because a wallet that has just booted may not have caught up.
            pass
        accts = (rpc.raw_request("get_accounts", {})
                 or {}).get("subaddress_accounts") or []
        best = None
        for _a in accts:
            _ai = _a.get("account_index")
            if not isinstance(_ai, int) or isinstance(_ai, bool):
                continue
            r = rpc.raw_request("get_balance",
                                {"account_index": _ai,
                                 "address_indices": [],
                                 "all_accounts": False}) or {}
            for _sub in (r.get("per_subaddress") or []):
                _amt = _sub.get("unlocked_balance")
                _si = _sub.get("address_index")
                _ad = _sub.get("address")
                if not isinstance(_amt, int) or isinstance(_amt, bool):
                    continue
                if not isinstance(_si, int) or isinstance(_si, bool):
                    continue
                if not _amt or not isinstance(_ad, str) or not _ad:
                    continue
                if best is None or _amt > best[3]:
                    best = (_ai, _si, _ad, _amt)
        return best
    except Exception:                                        # noqa: BLE001
        return None


def _dispatch(job, params, key, artifact_dir, handle, runner, job_id,
              funded=None) -> tuple:
    """Run the job's tools in order. Returns (code, status, handle)."""
    budget = proto.JOBS[job]["budget_s"]
    handles = _load_handles(artifact_dir)

    # A HANDLE IS FOUR HEX CHARACTERS, SO COLLISIONS ARE NOT A CURIOSITY.
    # 65536 values: at ~300 recorded handles a repeat is more likely than not,
    # and this dict is keyed on the handle, so a repeat SILENTLY OVERWRITES
    # the record it lands on -- after which a `watch` on the older label
    # watches the newer job's address. Redraw instead.
    #
    # Four characters stays. The operator reads it aloud off a terminal;
    # widening it to fix a bookkeeping problem would be paying in the wrong
    # currency, and the fix costs nothing here.
    for _ in range(64):
        if handle not in handles:
            break
        handle = proto.new_handle()
    else:
        raise Refused("handle_space",
                      "could not draw an unused handle in 64 tries, which "
                      "means this machine is holding most of the 65536 there "
                      "are. Run paranoia_mode: the handles file is one of the "
                      "things it wipes.")

    bundle = slip = None
    # EVERY JOB THAT NAMES A HANDLE RESOLVES IT HERE, and `withdraw` was
    # missing from this tuple while its argv template already interpolated
    # `bundle`. Driven: the composed command was
    # `--receive-wallet None`, i.e. a mix pointed at a bundle that does not
    # exist, on the one job that spends. It reached that state because the
    # argv template and the resolver are in different functions and only the
    # template was written for the new job -- the same producer/consumer seam
    # this repo has been caught by three times now.
    if job == "withdraw":
        # THE VAULT LOOKS. See _funded_entry: the machine holding the wallet is
        # the one that can see where the money is, and a chat message naming an
        # account index was the wrong box being asked.
        # `funded` is injectable like every other side effect here, so a test
        # can drive both the found and the empty case without a wallet. The
        # first version reached for `d`, which is _run_validated's parameter
        # and does not exist in this scope -- a NameError on the one job that
        # spends, caught immediately by driving it.
        _found = _funded_entry(key, injected=funded)
        if not _found:
            raise Refused(
                "nothing_to_withdraw",
                "no unlocked balance is visible on this wallet, so there is "
                "nothing to mix. If a payment is still confirming it is not "
                "spendable yet; ask again once it has.")
        _fa, _fs, _fad, _famt = _found
        # A BUNDLE IS WRITTEN, and it is the same 0600 file in the same swept
        # directory every other job's bundle already lives in -- not a new
        # class of artifact. GhostSpiral's receive mode reads a
        # gs_receive_wallet_v1 pointer and nothing else, so this is the format
        # the boundary takes; inventing a second way in would mean two parsers
        # for the thing that says where money is.
        #
        # NOT create_receive_wallet. That mints a NEW subaddress, which is
        # exactly what a withdrawal must not do: the money is already
        # somewhere, and minting somewhere else to point at it would be a
        # second account for the wipe to miss and a second address for nothing.
        # NAMED wallet_* SO THE WIPE ACTUALLY TAKES IT. The first version
        # called this gs_withdraw_<handle>.json, which matches NOTHING in
        # gs_common.GS_ARTIFACT_FILE_PATTERNS -- driven with fnmatch against
        # the real list. It would have sat in the artifact directory naming an
        # account and a subaddress of this wallet, through every paranoia_mode
        # run, on the machine that is supposed to keep nothing.
        #
        # wallet_*.json is the pattern receive bundles already match, and this
        # IS a receive bundle: same schema, same directory, same 0600. A new
        # name would have meant a new pattern, and a pattern nobody added.
        bundle = str(artifact_dir / f"wallet_withdraw_{handle}.json")
        atomic_write_json({"schema": "gs_receive_wallet_v1",
                           "address": _fad,
                           "account_index": int(_fa),
                           "subaddress_index": int(_fs),
                           "rpc_endpoint": key.get("rpc_primary", "")},
                          Path(bundle), perms=0o600)
    elif job in ("watch", "swap_status"):
        rec = handles.get(params["handle"])
        if not rec:
            raise Refused("unknown_handle",
                          f"no bundle on this machine for handle "
                          f"{params['handle']}.")
        bundle, slip = rec.get("bundle"), rec.get("slip")
        # ONE HANDLE, ONE ADDRESS. `receive_new --count 4` writes four
        # wallet_<random>.json files and the handle cannot name one of them
        # without picking arbitrarily, so it names none and this refuses.
        if not bundle:
            raise Refused(
                "handle_not_watchable",
                f"handle {params['handle']} covers "
                f"{rec.get('minted', 'several')} receive bundles, so it does "
                f"not name ONE address to watch. Watch the address you mean "
                f"from this machine, or quote it with receive_and_quote.")
        # A WATCH WITH NO QUOTE IS NOT A WATCH. The first version passed
        # str(slip) here, so a handle minted by receive_new -- which never
        # writes a slip -- reached receive_watch as the literal path "None".
        # load_pairs then exited on a missing file and the doorbell was told
        # "failed", which is true and useless: a wake and a boot spent to
        # learn that a string was not a filename.
        #
        # There is no --any fallback here, deliberately. --any stops on ANY
        # balance, so one piconero of dust from anyone who has the address
        # would report "done" to the doorbell -- telling the operator over the
        # pager that their money landed when what landed was a probe.
        if not slip:
            raise Refused(
                "no_quote",
                f"handle {params['handle']} names a receive bundle with no "
                f"swap quote, so there is no expected amount to watch for. "
                f"Only a receive_and_quote handle can be watched.")

    # DELETE LAST TIME'S ANSWER BEFORE ASKING AGAIN.
    #
    # Nothing else removes this file, and _phase_of reads whatever is there.
    # So a probe whose child dies before writing -- an RPC that will not
    # answer, a SIGKILL past the budget, a wallet that never opens -- reported
    # the PREVIOUS probe's outcome as this one's. The failure mode is the worst
    # available: last week's answer was "funded", so the operator is told
    # "landed and spendable, the swap is done" about money that never arrived,
    # and the one thing they would do next is stop watching for it.
    #
    # It also decides the branch below: that branch treats "the file exists" as
    # proof the probe answered, which a stale file satisfies for free.
    #
    # Missing is already handled correctly everywhere -- _phase_of returns ""
    # and the pager says the probe told us nothing -- so removing it first
    # makes "no answer" the honest default rather than a lie inherited from a
    # previous run.
    # BOTH WATCHING JOBS. `watch` writes this file now too (see build_argv),
    # so leaving it uncleared would let a 110-minute wait report the answer a
    # three-minute probe left behind hours earlier -- the exact stale-file lie
    # this unlink was added to stop, through the door the new job opened.
    if job in ("swap_status", "watch"):
        try:
            (artifact_dir / STATUS_FILE).unlink()
        except FileNotFoundError:
            pass
        except OSError as e:
            # Cannot clear it, so cannot trust it. Refuse rather than risk
            # reporting a stale "landed".
            raise Refused(
                "status_file_stuck",
                f"could not clear the previous status answer "
                f"({e.strerror}). Refusing to run a probe that might report "
                f"the last one's result.")

    steps = build_argv(job, params, key, artifact_dir, bundle=bundle,
                       slip=slip, handle=handle)

    before = set(glob.glob(str(artifact_dir / "wallet_*.json")))
    for i, argv in enumerate(steps):
        env_extra = {}
        if job == "receive_and_quote" and i == 1:
            # Identify the new bundle by a DIRECTORY DIFF, not by parsing
            # stdout: a tool's human-facing output is not an interface, and a
            # wrong bundle here would quote a swap to the wrong address.
            new = sorted(set(glob.glob(str(artifact_dir / "wallet_*.json")))
                         - before)
            if len(new) != 1:
                raise Refused("bundle_ambiguous",
                              f"expected exactly one new receive bundle, found "
                              f"{len(new)}. Refusing to quote a swap without "
                              f"knowing which address it pays.")
            argv[argv.index("--dest-from-receive-wallet") + 1] = new[0]
            # THE AMOUNT, AS A DECIMAL BTC STRING, IN THE ENVIRONMENT.
            # thor_swap_preparer reads GS_SWAP_AMOUNTS through env_or_argv and
            # prefers it over argv for the reason gs_common.env_or_argv's
            # docstring records: /proc/<pid>/cmdline is 0444.
            #
            # sat_to_btc and not str(): the wire carries an exact integer
            # count of satoshis precisely so that no float or locale ever
            # touches this number, and str() on that int would hand the
            # preparer a satoshi count where it expects bitcoin -- a hundred
            # million times the intended swap, quoted without complaint.
            env_extra["GS_SWAP_AMOUNTS"] = proto.sat_to_btc(
                params["amount_sat"])
            handles[handle] = {"bundle": new[0], "minted": 1,
                               "slip": str(artifact_dir /
                                           f"thor_pairs_{handle}.json")}
        if job == "withdraw":
            # THE DESTINATION, IN THE ENVIRONMENT, NEVER ON THE ARGV.
            # GhostSpiral reads GS_EXIT_TO through env_or_argv and prefers it
            # for exactly this reason. Re-validated one last time against the
            # protocol's own gate: this value came off a chat, through a
            # doorbell, out of a sealed record, and this is the last place that
            # can refuse it before it reaches a process that spends.
            _dest = proto.JOBS["withdraw"]["schema"]["exit_to"](
                params["exit_to"])
            env_extra["GS_EXIT_TO"] = _dest
            # THE SPEND PASSWORD, TO THIS CHILD AND NO OTHER.
            #
            # run_child strips every GS_ variable from the inherited
            # environment, so the unit may hold GS_WALLET_PASSWORD without
            # handing it to thor_swap_preparer or create_receive_wallet. This
            # is the one step that needs it, and it is put back only here.
            #
            # An EMPTY password is a legitimate configuration -- a wallet with
            # no password -- so this cannot distinguish "not set" from "set to
            # nothing", and does not try. What it must not do is silently pass
            # nothing when the operator meant to pass something, and the
            # preflight refusal above is where that is caught.
            env_extra["GS_WALLET_PASSWORD"] = os.environ.get(
                "GS_WALLET_PASSWORD", "")
            # THE OPERATOR'S CUT, WHICH THIS PATH WAS NOT TAKING AT ALL.
            #
            # --usage-fee is action="store_true" and defaults OFF ("a run that
            # has not been asked to skim must not skim"), and nothing here ever
            # asked. gs_console sets GS_USAGE_FEE_ADDRESS on its own runs, so
            # the desktop path skimmed and the PHONE path -- the one this whole
            # feature exists for -- silently did not. Every withdrawal started
            # from a chat kept 100% and put 0% aside, for as long as the job
            # has existed.
            #
            # NO ADDRESS BY DEFAULT, and that is the OPSEC-load-bearing half.
            # With --usage-fee alone GhostSpiral mints a FRESH account and
            # subaddress per run, so no address collects from two runs. Naming
            # a fixed one is the address reuse this toolchain refuses
            # everywhere else, and it survives the mix -- so it is available,
            # from this machine's own keyfile, and never the default.
            #
            # ON THE ARGV, DELIBERATELY, because it is a boolean that carries
            # no value: `ps` learns that this run skims, which is public in
            # this repository's source anyway. The ADDRESS is the part that
            # would identify the operator, and that goes in the environment
            # like every other secret here -- GhostSpiral's own flag help says
            # to prefer GS_USAGE_FEE_ADDRESS for exactly this reason.
            _fee_addr = key.get("usage_fee_address")
            if _fee_addr:
                # VALIDATED HERE TOO. It came off this machine's keyfile rather
                # than off the wire, so it is not attacker-controlled -- but a
                # typo in a paired address is a cut sent somewhere nobody can
                # spend it, discovered after the mix has already run.
                env_extra["GS_USAGE_FEE_ADDRESS"] = \
                    proto.JOBS["withdraw"]["schema"]["exit_to"](str(_fee_addr))
        # WHO IS WATCHING DECIDES WHERE THE OUTPUT GOES.
        #
        # The diversion exists because systemd journals whatever the children
        # print, and thor_swap_preparer prints the ThorChain memo. That is true
        # of the UNATTENDED path only. Diverting unconditionally also swallowed
        # the by-hand and --dry-run runs -- so the unit's own mitigation ("run
        # the agent by hand with --dry-run and you still see everything on your
        # terminal") was false, and JOB_LOG was named nowhere on screen, so an
        # operator had no way to find what they were no longer being shown.
        #
        # A tty means a human is present and there is no journal in the path;
        # anything else (systemd, a pipe, a redirect) gets the 0600 file.
        _jl = artifact_dir / JOB_LOG
        _watched = False
        try:
            _watched = sys.stdout.isatty()
        except Exception:                                    # noqa: BLE001
            _watched = False
        if _watched:
            agent_say(f"  [i] Step {i + 1} output follows on this terminal "
                      f"(no journal in the path when a human is watching).")
        else:
            agent_say(f"  [i] Step {i + 1} output -> {_jl} (0600, wiped with "
                      f"the artifacts).")
        # SOMEBODY SAT DOWN. Checked BETWEEN steps, not only at preflight.
        #
        # The inhibit file means "a person is using this machine", and the
        # moment a person reaches for it is the moment they walk up to a
        # running vault -- which is to say, mid-job. Read once at preflight it
        # could only ever catch someone who was already there before the wake,
        # so the case it was written for was the one it could not see: the job
        # ran to completion and powered the box off under them.
        #
        # Between steps rather than mid-step: a tool that is already running
        # gets to finish, because killing thor_swap_preparer halfway leaves a
        # quote nobody knows about. What it does not get is the NEXT tool, or
        # the power-off -- Refused(power=False) skips that and disarms the
        # deadman, exactly as preflight's copy does.
        _inh = artifact_dir / INHIBIT_FILE
        if _inh.exists():
            integrity_log("wake", "inhibited_mid_job")
            _save_handles(artifact_dir, handles)
            raise Refused(
                "inhibited",
                f"{_inh} appeared while this job was running, so somebody is "
                f"at the machine. Stopping before step {i + 1} and NOT "
                f"powering off. Anything already finished is in the artifact "
                f"directory; remove the file when you are done.", power=False)
        rc, hard = run_child(argv, env_extra, budget, runner=runner,
                             log_path=None if _watched else _jl)
        # A STATUS PROBE THAT FINDS NOTHING HAS NOT FAILED, and this branch is
        # where the opposite used to be decided.
        #
        # receive_watch exits non-zero for timeout, stalled AND not_syncing
        # alike. For `watch` that is defensible -- the operator asked it to
        # wait for money and it did not come. For `swap_status` it is exactly
        # backwards: "nothing on the address yet" is the ordinary answer, the
        # one the operator will get most often, and reporting it as a failed
        # job is what put "the vault ran it and it FAILED" on their phone while
        # they were waiting for a payment that was simply still in flight.
        #
        # The probe SUCCEEDED as long as it ran and wrote an answer. Only a
        # hard kill or a missing answer is a real failure.
        # BOTH WATCHING JOBS, and the comment above used to argue the
        # opposite for `watch`: "the operator asked it to wait for money and it
        # did not come" -- defensible when watch reported nothing but a return
        # code, and wrong now that it writes what it SAW. A payment still
        # confirming after 110 minutes is not a failed job, and calling it one
        # sends the operator to a machine that is already powered off.
        #
        # The job SUCCEEDED as long as it ran and wrote an answer. Only a hard
        # kill or a missing answer is a real failure.
        if rc != 0 and job in ("swap_status", "watch") and not hard:
            if (artifact_dir / STATUS_FILE).exists():
                continue
        if rc != 0:
            if hard:
                print(f"  [!] Step {i + 1} had to be SIGKILLed after its "
                      f"budget. Its cleanup did NOT run — run paranoia_mode.")
            integrity_log("wake", f"job_failed:{job}")
            # NEVER RECORD A SLIP THAT WAS NOT WRITTEN. The handle is recorded
            # before the quote step runs, because the argv needs the path. If
            # that step then failed, the bundle exists and the slip does not,
            # and leaving the path in would make a later `watch` die inside
            # receive_watch on a missing file instead of refusing here with a
            # reason the operator can act on.
            rec = handles.get(handle)
            if rec and rec.get("slip") and not Path(rec["slip"]).exists():
                rec["slip"] = None
            _save_handles(artifact_dir, handles)
            return "job_failed", "failed", handle

    if job == "receive_new":
        new = sorted(set(glob.glob(str(artifact_dir / "wallet_*.json"))) - before)
        if new:
            # `bundle` only when there is exactly ONE, because --count N writes
            # N files named wallet_<random>.json and new[0] is whichever of
            # them sorts first -- an address the operator could not have
            # predicted. `minted` is what the refusal above quotes back.
            handles[handle] = {"bundle": new[0] if len(new) == 1 else None,
                               "minted": len(new), "slip": None}
    _save_handles(artifact_dir, handles)
    integrity_log("wake", f"job_done:{job}")
    return "done", "done", handle


def _load_handles(d: Path) -> dict:
    try:
        v = json.loads((d / HANDLES_FILE).read_text())
        return v if isinstance(v, dict) else {}
    except Exception:                                        # noqa: BLE001
        return {}


#: Bound on the handles file. Insertion order is preserved by dict, so this
#: keeps the most recent. Nothing pruned this before and it only ever grew --
#: 12 wakes a day for a month is ~360 entries, so 1000 is far past any real
#: between-wipe usage, and an entry that does fall off gives `unknown_handle`,
#: which is a refusal the operator can read, not a silently wrong address.
MAX_HANDLES = 1000


def _save_handles(d: Path, h: dict) -> None:
    if len(h) > MAX_HANDLES:
        h = dict(list(h.items())[-MAX_HANDLES:])
    atomic_write_json(h, d / HANDLES_FILE, perms=0o600)


# ---------------------------------------------------------------------------
#: The slip fields that travel, and NOTHING ELSE from the pair record.
#:
#: An allowlist rather than "the pair minus a few keys", because the pair is
#: written by another tool and the next field somebody adds to it would ride
#: along uninspected. Short keys because 384 bytes is the budget and a 95-char
#: address plus a 111-char memo is most of it.
#:
#: `a` (dest_xmr) is here even though the memo already contains it, and that is
#: deliberate: it lets the delivery machine re-run memo_binds_destination
#: LOCALLY, against a field sealed by the same key, before the operator sends
#: anything. It cannot catch a hostile vault -- a vault that lies can lie in
#: both fields -- but a swap whose memo does not name its own destination is
#: the one failure that silently pays a stranger, and checking it twice on two
#: machines costs 100 bytes.
SLIP_FIELDS = (("btc_in", "b"), ("deposit", "d"), ("memo", "m"),
               ("dest_xmr", "a"), ("expected_xmr", "x"), ("ts", "t"))


def seal_slip_for_delivery(key: dict, artifact_dir: Path, status: str,
                           handle: str, reader=None) -> str:
    """Seal this job's deposit instructions for the delivery machine, or "".

    Returns "" -- not an error -- whenever there is nothing to seal or no key
    to seal it to. The operator who has not set up a delivery key gets exactly
    the behaviour they had before, and the slip stays on this machine.

    NEVER RAISES. A job that ran is a job that ran; a slip that could not be
    sealed does not un-mint an address or un-quote a swap, and turning a
    completed job into a reported failure would send the operator to check a
    vault that has already powered off. It is loud on this terminal and in the
    integrity log instead, and the operator learns from the chat that no slip
    came back -- which is a true statement of what happened.
    """
    try:
        if status != "done":
            return ""
        dpub = (key.get("delivery_public") or "").strip()
        if not dpub:
            return ""
        rec = (_load_handles(artifact_dir) or {}).get(handle) or {}
        path = rec.get("slip")
        if not path:
            # receive_new mints addresses and quotes nothing. There is no
            # deposit address to deliver and this is not a fault.
            return ""
        pairs = (reader or _read_json)(Path(path))
        if not isinstance(pairs, list) or len(pairs) != 1:
            # ONE amount goes in (a single ladder slot), so one pair comes out.
            # Any other count means something is not what this code thinks it
            # is, and picking one of several deposit addresses to send money to
            # is not a guess worth making.
            raise ValueError(
                f"expected exactly one quoted pair, found "
                f"{len(pairs) if isinstance(pairs, list) else 'a non-list'}")
        pair = pairs[0]
        body = {}
        for src, short in SLIP_FIELDS:
            v = pair.get(src)
            if v is None:
                raise ValueError(f"the quoted pair has no {src!r}")
            # `ts` IS NOT JUST "PRESENT", IT HAS TO BE A TIME. Every other
            # field here is a string the delivery machine re-checks for itself
            # (memo_binds_destination, instruction_field_safe); `ts` is the one
            # the operator cannot sanity-check by eye, and it is the input to
            # the only control that says "this quote has expired".
            #
            # Checked here as well as in gs_unseal because the two machines
            # know different things. gs_unseal cannot tell a malformed slip
            # from a vault with a broken clock, so all it can do is report the
            # age as unknown and refuse to call the quote fresh. THIS side can
            # see the pairs file that produced it, and the operator is standing
            # at a terminal that prints why -- so a slip with an unusable
            # timestamp is worth not sealing at all, rather than sending one
            # whose age nobody can read.
            #
            # isinstance(True, int) is True, which is why the bool is excluded
            # explicitly -- the same trap unlock_keyfile's ops/mem bounds call
            # out. Zero and negatives are refused too: a Unix epoch of 0 is not
            # a quote time, it is a field somebody defaulted.
            if src == "ts" and (isinstance(v, bool)
                                or not isinstance(v, int) or v <= 0):
                raise ValueError(
                    f"the quoted pair's 'ts' is not a usable timestamp "
                    f"({v!r}); without it the delivery machine cannot tell "
                    f"whether the quote has expired")
            body[short] = v
        body["h"] = handle
        import nacl.public
        tp_sk = nacl.public.PrivateKey(bytes.fromhex(key["secret"]))
        blob = proto.seal_slip(tp_sk,
                               nacl.public.PublicKey(bytes.fromhex(dpub)),
                               body)
        integrity_log("wake", "slip_sealed")
        return blob
    except Exception as e:                                   # noqa: BLE001
        integrity_log("wake", "slip_seal_failed")
        # terminal_safe: this quotes a message that can contain a filename and
        # a field name, and this line reaches a terminal.
        agent_say(f"  [!] The job finished but its slip could NOT be sealed "
                  f"for delivery ({terminal_safe(str(e))[:160]}).")
        agent_say(f"      The deposit address and memo are on THIS machine, "
                  f"unchanged. Nothing was sent anywhere.")
        return ""


def _read_json(path: Path):
    return json.loads(path.read_text())


#: pair-record field -> plaintext slip key. A SEPARATE, SHORTER allowlist than
#: SLIP_FIELDS, and the difference is deliberate: the sealed slip carries
#: dest_xmr so gs_unseal can re-run memo_binds_destination on a second machine,
#: and it carries ts so it can call a stale quote stale. A phone can do
#: neither, so both fields would be extra copies of sensitive values in a
#: transcript, bought for nothing. What is left is exactly what a human needs
#: to make the payment.
PLAIN_MAP = (("btc_in", "b"), ("deposit", "d"), ("memo", "m"),
             ("expected_xmr", "x"))


def plain_slip_for_chat(key: dict, artifact_dir: Path, status: str,
                        handle: str, reader=None) -> dict:
    """The deposit instructions, in the clear, or {}.

    Same contract as seal_slip_for_delivery and for the same reasons: returns
    empty rather than raising when there is nothing to send or the operator has
    not turned this on, and NEVER raises -- a job that ran is a job that ran.
    """
    try:
        if status != "done" or not key.get("plain_slip"):
            return {}
        rec = (_load_handles(artifact_dir) or {}).get(handle) or {}
        path = rec.get("slip")
        if not path:
            return {}                       # receive_new quotes nothing
        pairs = (reader or _read_json)(Path(path))
        if not isinstance(pairs, list) or len(pairs) != 1:
            # The same refusal the sealed path makes. N slips in one transcript
            # is worse here than there: GhostSpiral calls two or more
            # publicly-known outputs the catastrophic case, and a chat is
            # exactly where they pile up.
            raise ValueError(
                f"expected exactly one quoted pair, found "
                f"{len(pairs) if isinstance(pairs, list) else 'a non-list'}")
        pair = pairs[0]
        body = {}
        for src, short in PLAIN_MAP:
            v = pair.get(src)
            if v is None:
                raise ValueError(f"the quoted pair has no {src!r}")
            body[short] = str(v)
        body["h"] = handle
        # Checked against the SAME predicate the doorbell will use, here, where
        # the operator can be told. Otherwise a control character in a memo
        # would be refused by the Pi and the vault would have powered off
        # believing it delivered.
        if not proto.plain_slip_is_wellformed(body):
            raise ValueError("the quoted pair does not fit the plaintext slip "
                             "format (a field is empty, too long, or carries a "
                             "control character)")
        integrity_log("wake", "plain_slip_sent")
        return body
    except Exception as e:                                   # noqa: BLE001
        integrity_log("wake", "plain_slip_failed")
        agent_say(f"  [!] The job finished but its deposit instructions could "
                  f"NOT be sent ({terminal_safe(str(e))[:160]}).")
        agent_say(f"      They are on THIS machine, unchanged.")
        return {}


def report_back(key: dict, job_id: str, challenge_hex: str, status: str,
                handle: str, slip: str = "", plain: dict = None,
                phase: str = "", poster=None) -> None:
    """Tell the doorbell the outcome, a 4-hex label, and at most ONE payload.

    Never the reason a job was refused. The payload is either a SEALED slip --
    ciphertext for a key the doorbell does not have -- or, when the operator's
    own keyfile says so, the deposit instructions in the clear. Never both:
    see gs_wake_proto's "THE PLAINTEXT SLIP" for what each costs.
    """
    plain = plain or {}
    done = status == "done"
    # THE PHASE TRAVELS WHATEVER THE STATUS IS, and it is the only field here
    # that may.
    #
    # handle, slip and plain are gated on `done` because a job that did not
    # finish has no result to hand over, and reporting one would tell the
    # operator it worked. The phase is the opposite kind of value: it is what
    # the probe SAW, drawn from a closed table the doorbell re-checks
    # membership against (gs_doorbell's phase check is a set test with no
    # status coupling), and its whole purpose is to say something truer than
    # the return code.
    #
    # Gating it on `done` is what made a /watch whose money was still in
    # flight report "watch: failed." -- the phase was computed, carried this
    # far, and thrown away one line before it would have been useful.
    body = {"job_id": job_id, "challenge": challenge_hex, "status": status,
            "handle": handle if done else "",
            "slip": slip if done else "",
            "plain": plain if done else {},
            "phase": phase}
    try:
        import nacl.public
        tp_sk = nacl.public.PrivateKey(bytes.fromhex(key["secret"]))
        pi_pk = nacl.public.PublicKey(bytes.fromhex(key["peer_public"]))
        m3 = proto.seal(tp_sk, pi_pk, proto.TAG_M3, body)
    except proto.WakeError as e:
        # A RECORD THAT WILL NOT FIT IS NOT A DELIVERY PROBLEM, and treating it
        # as one is how a successful job becomes silence.
        #
        # This whole function used to sit under one bare `except Exception`
        # whose comment said "an undeliverable result is not a failure of the
        # job". True for a dead socket. NOT true for seal() refusing an
        # oversized record: that is a bug in what we just built, the operator
        # is told "collected but never reported back" for a job that fully
        # succeeded, and the vault powers off before anyone can look. Retry
        # WITHOUT the payload so the outcome and the handle still arrive --
        # they are what lets the operator find the job on the vault.
        integrity_log("wake", "result_too_large")
        agent_say(f"  [!] The result record would not fit the wire "
                  f"({terminal_safe(str(e))[:120]}).")
        agent_say(f"      Reporting the outcome WITHOUT the deposit "
                  f"instructions; they are on this machine.")
        try:
            import nacl.public
            m3 = proto.seal(
                nacl.public.PrivateKey(bytes.fromhex(key["secret"])),
                nacl.public.PublicKey(bytes.fromhex(key["peer_public"])),
                proto.TAG_M3,
                dict(body, slip="", plain={}))
        except Exception:                                    # noqa: BLE001
            integrity_log("wake", "result_undeliverable")
            return
    except Exception:                                        # noqa: BLE001
        integrity_log("wake", "result_undeliverable")
        return
    try:
        (poster or post_record)(key["doorbell_url"], "/result", m3)
    except Exception:                                        # noqa: BLE001
        # THIS one really is a delivery problem. The job either happened or did
        # not, and the record of it is here.
        integrity_log("wake", "result_undeliverable")


def build_cli() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description="Collect one job from the doorbell, run it, power off.")
    ap.add_argument("--key", required=True, help="the ThinkPad keyfile (0400)")
    ap.add_argument("--dry-run", action="store_true",
                    help="check the keyfile, preflight, Tor and that the "
                         "doorbell answers — then STOP, without asking for a "
                         "job and without powering off. It cannot ask: the "
                         "handover is at-most-once, so asking takes the job. "
                         "It therefore does not prove the two keyfiles are a "
                         "matched pair; the first real poke does that.")
    return ap


def main(argv=None) -> int:
    install_signal_handlers()
    args = build_cli().parse_args(argv)
    code = "unknown"
    try:
        try:
            code, _status, _handle = run_once(args)
            agent_say(f"  [+] Wake finished: {code}.")
            return 0
        except Refused as e:
            code = e.code
            agent_say(f"  [!] Wake refused ({e.code}): {e.msg}")
            integrity_log("wake", f"refused:{e.code}")
            if not e.power:
                # The two cases where a human is demonstrably present. Disarm
                # the deadman so the machine they are using does not go down
                # under them.
                disarm_deadman()
                return 0
            return 1
        except proto.WakeError as e:
            code = "bad_note"
            agent_say(f"  [!] Wake refused: {e}")
            integrity_log("wake", "refused:bad_note")
            return 1
        except Exception as e:                               # noqa: BLE001
            # NOT a catch-and-continue: it re-raises, so the finally below
            # still powers off exactly as it did when this was unhandled. The
            # only thing that changes is that the reason is written down --
            # under StandardOutput=null an unhandled traceback went to a null
            # stderr and the machine powered off silently.
            code = "crash"
            agent_say(f"  [!] Wake FAILED, unhandled "
                      f"{type(e).__name__}: {terminal_safe(str(e))}")
            agent_say(traceback.format_exc())
            try:
                integrity_log("wake", "crash")
            except Exception:                                # noqa: BLE001
                pass
            raise
    finally:
        # EVERY path, including SystemExit from gs_common's own fail-closed
        # aborts, and including an unhandled exception.
        if code not in ("inhibited", "mix_running"):
            power_off(dry_run=args.dry_run)


if __name__ == "__main__":
    sys.exit(main())
