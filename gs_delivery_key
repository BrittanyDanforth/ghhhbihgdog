#!/usr/bin/env python3
"""gs_delivery_key - mint the key that lets a quoted swap REACH YOU.

    ThinkPad, once:   python3 gs_delivery_key new --vault-key /etc/gs_wake_tp.key
    anywhere:         python3 gs_delivery_key show --key gs_delivery.key

--------------------------------------------------------------------------
WHY THIS EXISTS
--------------------------------------------------------------------------
OPSEC_SETUP.md section 8 says, correctly: "Do not 'just run a Telegram bot'
that prints the memo -- that throws away the only reason to have a Pi." The
whole wake channel is built so the deposit address and the memo stay on the
vault and the Pi learns a four-character label and nothing else.

That rule quietly assumes the operator can WALK TO THE VAULT. When they cannot
-- and a vault that lives somewhere far away and hard to reach is the design,
not an accident -- "read it on the vault" is not an OPSEC property. It is a
dead end. The operator is told a swap is quoted and handed no way to pay it,
and a ThorChain quote that nobody acts on is a quote that expires.

So the payload travels, and it travels sealed to a key that exists on NEITHER
of the two machines that carry it. This tool mints that key.

    the vault      seals the slip to delivery_public.  Holds no secret for it.
    the Pi         relays 568 characters of base64.    Holds no key at all.
    Telegram       carries the same base64.            Holds no key at all.
    THIS FILE      opens it.                           Never touches either box.

A seized Pi, a stolen SD card, a stolen phone, a stolen bot token and Telegram
itself all get exactly the same thing out of a slip: nothing.

--------------------------------------------------------------------------
WHAT IT COSTS, SAID PLAINLY RATHER THAN BURIED
--------------------------------------------------------------------------
Before this, the ciphertext did not exist anywhere off the vault. Now it does,
and Telegram has a copy forever. If the delivery key is obtained LATER, every
blob that was kept can be read. That is a real reduction and it is the trade
being made on purpose, in exchange for being able to use the system at all.

Two things bound it, and neither is rhetoric:

  * The delivery key is only ever on the machine that sends the BTC. It is not
    on the Pi, and after `new` finishes it is not on the vault either -- the
    file is written to removable media and the copy here is shredded.
  * A slip names one deposit address, one memo and one amount, and it is spent
    the moment the BTC is sent. It is not a wallet, not a seed, and not a key
    to anything. Reading a two-month-old slip tells an attacker about a swap
    that already happened.

What it is NOT is a way to move money. Nothing here can spend: section 8's
other rule -- the mix needs a physically present spend USB -- is untouched, and
FORBIDDEN_TOOLS still names every tool a wake may not run.

--------------------------------------------------------------------------
WHY Box AND NOT SealedBox
--------------------------------------------------------------------------
An anonymous sealed box would encrypt to delivery_public without proving who
wrote it. Anyone who learned that public key -- and it is stored in plaintext
in the vault's keyfile, so a seized vault yields it -- could then hand the
operator a slip naming any deposit address they liked, through a bot token they
had already stolen. "Where do I send the Bitcoin" is the one field in this
entire system that must be authenticated. So: Box(vault_secret,
delivery_public), and gs_unseal refuses any slip the vault did not seal.
"""
from __future__ import annotations

import argparse
import json
import os
import stat
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from gs_common import (                                      # noqa: E402
    atomic_write_json, integrity_log, install_signal_handlers,
    secure_delete_file, terminal_safe,
)
import gs_wake_proto as proto                                # noqa: E402

#: The delivery keyfile's role, checked on read so a wake keyfile handed to
#: gs_unseal is refused by name rather than failing as a decrypt error.
ROLE = "delivery"


def _file_delivery_public(path: Path) -> tuple:
    """The delivery PUBLIC key recorded beside a sealed delivery keyfile.

    Returns (public_hex, why) -- why is "" on success, else the reason there is
    no usable value: "absent", "malformed" or "unreadable".

    Stored in the container HEAD, unencrypted, because it is not a secret --
    the vault's own keyfile already holds it in plaintext, which is the whole
    premise of sealing slips to it. Keeping a copy here is what lets
    _refuse_existing tell "this is the vault's delivery key" apart from "this
    is A delivery key" WITHOUT the passphrase for the file, which the operator
    may well not have to hand when they are being warned about it.

    THE REASON IS RETURNED BECAUSE THE CALLER STATED ONE AS FACT. This returned
    a bare "" and swallowed every failure into it, and _refuse_existing then
    printed "it was minted before that field existed" -- a specific cause, in a
    confident sentence, about a file it had not established anything about.
    Driven, six shapes reaching that one sentence:

        field genuinely absent          ''   <- the only one it described
        field present, truncated hex    ''
        field present, not hex at all   ''
        field present, a number         ''
        file is not JSON (corrupt)      ''
        file is empty                   ''

    Three of those are the TAMPERING shape -- a head someone edited -- and
    telling the operator "it is just an old keyfile" about an altered file is
    worse than saying nothing, because it is an explanation that closes the
    question. This function's own docstring already said the caller "must treat
    that as UNKNOWN and say so, never as a match"; unknown has causes, and
    naming the wrong one is the same defect in a smaller place.
    """
    try:
        raw = path.read_text()
    except Exception:                                        # noqa: BLE001
        return "", "unreadable"
    try:
        head = json.loads(raw)
    except Exception:                                        # noqa: BLE001
        return "", "unreadable"
    if not isinstance(head, dict) or "delivery_public" not in head:
        return "", "absent"
    v = head.get("delivery_public")
    if not v:
        # Present but empty/null is not the same as never written, and it is
        # not something this tool produces.
        return "", "malformed"
    try:
        ok = isinstance(v, str) and len(bytes.fromhex(v)) == 32
    except Exception:                                        # noqa: BLE001
        ok = False
    return (v, "") if ok else ("", "malformed")


def _refuse_existing(path: Path, vault_names_one: bool,
                     vault_public: str = "") -> None:
    """Refuse to overwrite a delivery key, and say which situation this is.

    THREE states reach here, and the first version of this handled two. Saying
    "the vault's keyfile names the matching public key" unconditionally would
    be a confident lie -- this repo's named recurring defect -- and that is
    what it did in the state it did not have a branch for.

    The missing one: a file exists at --out, the vault DOES name a delivery
    key, and they are DIFFERENT keys. A stale copy, or one belonging to another
    vault. `bool(existing)` cannot tell that apart from a match, and nothing
    here ever read the key out of the file. Driven: a vault sealing to A with B
    sitting at --out printed "already exists and the vault seals to it", which
    is false, about the one file that decides whether any slip can ever be
    opened. The operator's next move is to trust it.
    """
    if not path.exists():
        return
    if vault_names_one:
        _file_pub, _why = _file_delivery_public(path)
        if _file_pub and vault_public and _file_pub != vault_public:
            sys.exit(
                f"[!] {path} already exists, and it is NOT the delivery key "
                f"this vault seals to.\n"
                f"    the vault seals to : {vault_public[:16]}...\n"
                f"    this file holds    : {_file_pub[:16]}...\n"
                f"    Nothing here can open a slip from this vault as things "
                f"stand. That file\n"
                f"    belongs to a different vault, or it is a stale copy from "
                f"before a re-key.\n"
                f"    Move it aside; then `new --replace` mints a key this "
                f"vault will seal to,\n"
                f"    or restore the real one if you still have it.")
        if not _file_pub:
            # THE CAUSE IS REPORTED, NOT GUESSED. This said "it was minted
            # before that field existed" for all of absent / malformed /
            # unreadable, and only the first of those is that. The other two
            # are the shape a TAMPERED or damaged head takes, and an
            # explanation that closes the question is worse there than none.
            _cause = {
                "absent": ("it records no delivery_public field at all, which "
                           "is how every keyfile minted before that field "
                           "existed looks"),
                "malformed": ("it HAS a delivery_public field and the value is "
                              "not a 32-byte hex public key -- this tool never "
                              "writes that, so the header has been edited or "
                              "damaged"),
                "unreadable": ("it could not be read or parsed as JSON at all, "
                               "so nothing about its contents is established"),
            }.get(_why, "the recorded public key could not be established")
            integrity_log("delivery", f"refuse_existing_unknown:{_why or 'other'}")
            sys.exit(
                f"[!] {path} already exists and this vault names a delivery "
                f"key, but whether\n"
                f"    they are the SAME key CANNOT be checked from here: "
                f"{_cause}.\n"
                f"    The secret inside is sealed, so nothing here can settle "
                f"it without the\n"
                f"    passphrase.\n"
                f"    Confirm it with `show --key {path}` and compare against "
                f"the vault, or move\n"
                f"    it aside and run `new --replace`. Refusing to overwrite "
                f"it either way.")
        # "RECORDS", NOT "IS", AND THAT DISTINCTION IS THE WHOLE POINT.
        #
        # The first version of this branch said "already exists and the vault
        # seals to it" on the strength of the head field matching -- and the
        # head is OUTSIDE the sealed box, so anyone who can write the file can
        # put any value there. Driven: a file whose sealed secret is B, with a
        # head claiming A, against a vault sealing to A, printed exactly that
        # sentence. Which is the same confident false statement this function
        # was rewritten to remove, reached by tampering instead of by accident.
        #
        # The head field can carry the MISMATCH branch above safely, because
        # both readings of a mismatch -- a genuinely different key, or a
        # tampered head -- end in "do not trust this file". It cannot carry
        # this one: a match is only evidence if the field is authentic, and
        # nothing here has the passphrase to check that.
        #
        # So this says what is actually known, and points at the command that
        # CAN check it. _open_delivery verifies the head against the sealed
        # secret whenever the file is opened, so `show` settles it.
        sys.exit(
            f"[!] {path} already exists and RECORDS the delivery key this "
            f"vault seals to.\n"
            f"    That match is what the file's header claims, and the header "
            f"is outside the\n"
            f"    sealed box -- so it is a label, not proof. `show --key "
            f"{path}` opens the\n"
            f"    file and checks the label against the secret inside; this "
            f"cannot, because it\n"
            f"    has no passphrase.\n"
            f"    Refusing to overwrite it either way: replacing this file "
            f"makes every future\n"
            f"    slip unopenable, and it fails at the moment a swap is quoted "
            f"and money is\n"
            f"    waiting on it.\n"
            f"    To re-key deliberately: move this aside and run `new "
            f"--replace`.\n"
            f"    Slips already sent become unreadable either way.")
    # THREE CAUSES, AND THE THIRD IS THE LIKELY ONE. This listed two -- a
    # half-finished `new`, or a file from another vault -- and omitted the one
    # that produces this state in normal operation: THE VAULT WAS RE-PAIRED.
    # gs_wake_keys rebuilds the keyfile from scratch and its payload has no
    # delivery_public field, correctly, because a fresh pairing mints a fresh
    # vault keypair. So an operator who re-keyed after a suspected compromise,
    # a new SD card or a moved Pi lands here, and the two causes offered both
    # suggest the file at --out is suspect when it is simply out of date.
    sys.exit(
        f"[!] {path} already exists, but this vault does NOT name a delivery\n"
        f"    key. Three ways to be here:\n"
        f"      * THIS BOX WAS RE-PAIRED. Pairing rewrites the vault keyfile "
        f"and mints a fresh\n"
        f"        vault keypair, so it names no delivery key and the file at "
        f"{path.name}\n"
        f"        can no longer open anything this box seals. This is the "
        f"usual cause.\n"
        f"      * an earlier `new` wrote the file and stopped before it told "
        f"the vault.\n"
        f"      * the file belongs to a different vault.\n"
        f"    Nothing here can open a slip as things stand. Move it aside and\n"
        f"    run `new` again. Slips sealed by a PREVIOUS pairing of this box "
        f"stay unreadable\n"
        f"    either way -- they were sealed by a vault key that no longer "
        f"exists -- so\n"
        f"    re-keying costs you nothing you still had.")


def read_passphrase(prompt: str, getter=None) -> bytes:
    """From the terminal. NEVER from argv, and NEVER from the environment.

    gs_doorbell's read_passphrase honours GS_WAKE_PASSPHRASE because a headless
    trigger has no terminal to ask on. This one deliberately does not have an
    equivalent: nothing unattended ever opens a delivery key, so an env var
    here would exist only to be left set in somebody's shell profile.
    """
    fn = getter
    if fn is None:
        import getpass
        fn = getpass.getpass
    try:
        return fn(prompt).encode()
    except Exception as e:                                   # noqa: BLE001
        sys.exit(f"[!] no terminal to read a passphrase on ({type(e).__name__}). "
                 f"Run this by hand, on a real console.")


def load_vault_key(path: Path) -> dict:
    try:
        st = os.stat(path)
    except OSError as e:
        sys.exit(f"[!] no keyfile at {path} ({e.strerror}). Run this on the "
                 f"VAULT, and point --vault-key at the file gs_wake_keys "
                 f"wrote there.")
    if stat.S_IMODE(st.st_mode) & 0o077:
        sys.exit(f"[!] {path} is group- or world-accessible (mode "
                 f"{stat.S_IMODE(st.st_mode):04o}); chmod 0400 it.")
    try:
        container = json.loads(path.read_text())
    except Exception as e:                                   # noqa: BLE001
        sys.exit(f"[!] {path} is not readable JSON ({type(e).__name__}).")
    if proto.keyfile_is_sealed(container):
        sys.exit(f"[!] {path} is passphrase-sealed, which makes it the PI's "
                 f"keyfile.\n"
                 f"    The delivery key is minted on the VAULT, because only "
                 f"the vault's\n"
                 f"    secret can seal a slip. Run this there.")
    try:
        k = proto.unlock_keyfile(container)
    except proto.WakeError as e:
        sys.exit(f"[!] {path}: {e}")
    if k.get("role") != "thinkpad":
        sys.exit(f"[!] {path} is the {k.get('role')!r} keyfile, not the "
                 f"vault's. Run this on the ThinkPad.")
    return k


def cmd_new(args) -> int:
    import nacl.public
    out = Path(args.out).expanduser()
    vault_path = Path(args.vault_key).expanduser()
    # The vault is read BEFORE the overwrite refusal, because which refusal is
    # true depends on whether the vault already names a delivery key.
    key = load_vault_key(vault_path)
    # ONE DELIVERY MODE, REFUSED HERE RATHER THAN AT THE NEXT WAKE.
    #
    # gs_wake_agent.load_key raises delivery_mode_ambiguous on a keyfile that
    # sets BOTH plain_slip and delivery_public -- correctly, because they are
    # two answers to one question. It raises on EVERY WAKE, at load, before
    # any job runs: so writing the second field here does not create a
    # conflict to resolve later, it stops the vault answering the phone at
    # all, and re-pairing both boxes is the only way back. The phone sees a
    # refusal with no reason on it, which reads as "try again".
    #
    # This check was not needed while nothing could set plain_slip. Now that
    # `gs_wake_keys pair --plain-slip` can, the trap is one command away.
    if key.get("plain_slip"):
        sys.exit(
            f"[!] {vault_path} is paired with --plain-slip, which already\n"
            f"    delivers the deposit details -- as text, to the chat.\n"
            f"    A vault may have ONE delivery mode. Writing a delivery "
            f"key\n"
            f"    into this keyfile would make it refuse every wake at "
            f"load,\n"
            f"    not just this one, and re-pairing both boxes is the only\n"
            f"    way back. Re-pair WITHOUT --plain-slip first if you want\n"
            f"    sealed delivery instead.")
    existing = (key.get("delivery_public") or "").strip()
    # The vault's OWN delivery_public goes in, so the refusal can compare it
    # against the key actually inside the file at --out instead of asserting a
    # match from `bool(existing)`.
    _refuse_existing(out, bool(existing), existing)

    if existing and not args.replace:
        sys.exit(
            f"[!] {vault_path} already names a delivery key "
            f"({existing[:16]}...).\n"
            f"    A vault seals to ONE delivery key. Minting a second without\n"
            f"    saying so would leave you holding a file that opens nothing.\n"
            f"    Pass --replace if the old delivery key is genuinely gone --\n"
            f"    slips already sent under it stay unreadable either way.")

    # The vault's own public key, DERIVED rather than stored: gs_unseal needs
    # it to verify who sealed a slip, and deriving it from the secret that
    # will do the sealing means the two cannot drift apart.
    vault_sk = nacl.public.PrivateKey(bytes.fromhex(key["secret"]))
    vault_pub = bytes(vault_sk.public_key).hex()

    dk = nacl.public.PrivateKey.generate()
    dpub = bytes(dk.public_key).hex()

    print()
    print("  This file is the only thing that can ever read a slip.")
    print("  Give it a passphrase you will still have in six months, and one")
    print("  that is not the vault's -- a single passphrase covering both")
    print("  means a shoulder-surfed unlock at the vault also opens this.")
    p1 = read_passphrase("  Passphrase for the delivery key: ",
                         getter=args._getpass)
    p2 = read_passphrase("  Again: ", getter=args._getpass)
    if p1 != p2:
        sys.exit("[!] The two passphrases differ. Nothing was written.")
    if not p1:
        sys.exit("[!] An empty passphrase would store the delivery secret in "
                 "plaintext on removable media. Refusing.")

    container = proto.lock_keyfile(
        {"role": ROLE,
         "delivery_secret": bytes(dk).hex(),
         "vault_public": vault_pub},
        p1, kdf=args.kdf, role=ROLE)
    # THE PUBLIC KEY GOES IN THE HEAD, unencrypted and deliberately so. It is
    # not a secret -- the vault's keyfile stores it in plaintext, which is what
    # sealing to it means -- and recording it here is what lets a later
    # `new` tell "this is THE delivery key" from "this is A delivery key"
    # without the passphrase. unlock_keyfile reads the head by name and ignores
    # fields it does not know, so this does not change how the file opens.
    container["delivery_public"] = dpub
    atomic_write_json(container, out, perms=0o400)

    # THE VAULT'S KEYFILE IS REWRITTEN LAST, and only once the delivery file is
    # safely on disk. The other order loses: a vault that names a delivery key
    # whose file was never written seals every future slip to nothing, and the
    # failure does not surface until a swap is quoted.
    key["delivery_public"] = dpub
    _rewrite_vault_key(vault_path, key)

    integrity_log("delivery", "key_minted")
    print()
    print(f"  [+] Delivery key written: {out} (0400)")
    print(f"  [+] {vault_path} now seals slips to {dpub[:16]}...")
    print()
    print("  NOW DO THESE THREE THINGS, IN THIS ORDER:")
    print(f"    1. Copy {out} to the machine you will SEND THE BITCOIN from.")
    print(f"       That machine already needs Electrum or Sparrow for the")
    print(f"       OP_RETURN, so it already has what gs_unseal needs.")
    print(f"    2. Check it opens there:  python3 gs_unseal --key <file> --self-test")
    print(f"    3. Come back and shred the copy here:")
    print(f"         python3 gs_delivery_key shred --key {out}")
    print()
    print("  Until step 3 the delivery secret is on the vault, which is the")
    print("  one place it is not supposed to live.")
    return 0


def _rewrite_vault_key(path: Path, payload: dict) -> None:
    """Put delivery_public into the vault's keyfile, atomically, still 0400."""
    container = proto.lock_keyfile(payload, b"", role=payload.get("role", ""))
    try:
        # atomic_write_json replaces by rename, so there is no window where the
        # vault's keyfile is truncated or half-written. A wake that starts
        # mid-rewrite reads either the old file or the new one.
        atomic_write_json(container, path, perms=0o400)
    except OSError as e:
        sys.exit(f"[!] could not rewrite {path} ({e.strerror}).\n"
                 f"    The delivery key WAS written, but the vault does not "
                 f"know about it yet,\n"
                 f"    so slips will not be sealed. Fix the permissions and "
                 f"run `new --replace` again.")


def cmd_show(args) -> int:
    path = Path(args.key).expanduser()
    payload = _open_delivery(path, args)
    import nacl.public
    dpub = bytes(nacl.public.PrivateKey(
        bytes.fromhex(payload["delivery_secret"])).public_key).hex()
    print(f"  delivery public : {dpub}")
    print(f"  vault public    : {terminal_safe(payload['vault_public'])}")
    print()
    print("  The vault's keyfile must name that delivery public key, or slips")
    print("  it seals will not open here.")
    return 0


def cmd_shred(args) -> int:
    path = Path(args.key).expanduser()
    if not path.exists():
        sys.exit(f"[!] no file at {path}. Nothing to shred.")
    # OPEN IT FIRST. Shredding a file the operator cannot open elsewhere is
    # destroying the only copy of the only key that reads their slips, and
    # "I already copied it" is exactly the thing people are wrong about at 2am.
    print("  Confirming this file opens before destroying it.")
    _open_delivery(path, args)
    print()
    print(f"  This opened. If the copy on your sending machine ALSO opens,")
    print(f"  this one is safe to destroy. If it does not, you lose every")
    print(f"  future slip and there is no recovery.")
    ans = (args._input or input)(
        "  Type EXACTLY 'shred it' to destroy this copy: ")
    if ans.strip() != "shred it":
        print("  Nothing was destroyed.")
        return 1
    # THE RETURN VALUE IS THE ANSWER, and this line discarded it.
    #
    # secure_delete_file returns bool and every other caller in the toolchain
    # -- fourteen of them, across GhostSpiral, paranoia_mode, thor_swap_preparer
    # and gs_common -- checks it. This one did not, and it is the one whose
    # entire job is confirming that the delivery secret has LEFT THE VAULT.
    # cmd_new's own last line says so: "Until step 3 the delivery secret is on
    # the vault, which is the one place it is not supposed to live." Step 3 is
    # this command.
    #
    # It was not a rare failure either. cmd_new writes this file 0400, and
    # secure_delete_file opened it O_WRONLY -- EACCES for any non-root owner.
    # Driven end to end as an ordinary user, on the file cmd_new had just
    # minted: "[+] ... destroyed.", rc 0, and the sealed X25519 secret still
    # sitting there. Every run as root hid it. secure_delete_file now chmods
    # its own 0400 file before overwriting, so the success path works; this
    # check is what makes the failure path honest.
    if not secure_delete_file(path):
        # "NOTHING WAS OVERWRITTEN" WAS A GUESS, AND IN THE COMMONEST FAILURE
        # IT IS THE OPPOSITE OF WHAT HAPPENED.
        #
        # secure_delete_file overwrites the extent FIRST and unlinks second, so
        # a failure can land on either side of that. When the directory denies
        # unlink -- removable media mounted read-only, or a directory the
        # operator does not own, which is exactly where this file is told to
        # live -- the overwrite SUCCEEDS and the unlink fails. Driven: a 657
        # byte keyfile came back 657 bytes of ZEROS, and the first version of
        # this message told the operator "Nothing was overwritten. The delivery
        # secret is still on this machine."
        #
        # Both halves false, and false in the direction that costs them
        # everything: believing they still hold the key, they shred the copy on
        # the sending machine, or simply never re-key -- and every future slip
        # is unopenable, discovered at the moment a swap is quoted and money is
        # waiting on it.
        #
        # WHICH ONE HAPPENED IS READABLE WITHOUT A PASSPHRASE. An intact keyfile
        # is a sealed JSON container; an overwritten one is not JSON at all. So
        # ask the file rather than assert.
        # THREE STATES, and the first draft of this asserted two. "The file is
        # still on disk" is itself a claim -- secure_delete_file also returns
        # False when its opening lstat fails, i.e. when the file is not there
        # at all -- so it is checked rather than assumed, for the same reason
        # the overwrite is.
        _exists = path.exists()
        _still_a_key = False
        if _exists:
            try:
                _still_a_key = proto.keyfile_is_sealed(
                    json.loads(path.read_text()))
            except Exception:                                # noqa: BLE001
                _still_a_key = False
        integrity_log("delivery",
                      "key_shred_FAILED_gone" if not _exists
                      else "key_shred_FAILED_intact" if _still_a_key
                      else "key_shred_FAILED_after_overwrite")
        if not _exists:
            sys.exit(
                f"[!] The shred reported FAILURE, and {path} is not there any "
                f"more.\n"
                f"    Those two do not normally go together: something removed "
                f"it out from under\n"
                f"    this command, or the path changed while it ran. Nothing "
                f"here can say whether\n"
                f"    the contents were overwritten first.\n"
                f"    TREAT THE COPY ON THE SENDING MACHINE AS YOUR ONLY ONE "
                f"and verify it opens\n"
                f"    there now: `gs_unseal --key <file> --self-test`.")
        if _still_a_key:
            sys.exit(
                f"[!] {path} could NOT be destroyed, and it is still there "
                f"INTACT.\n"
                f"    It still opens as a sealed delivery key, so nothing was "
                f"overwritten and the\n"
                f"    delivery secret is still on this machine -- the one place "
                f"it is not supposed\n"
                f"    to live.\n"
                f"    Check that you own the file and can write to its "
                f"directory, then run this\n"
                f"    again. If the media is read-only, destroy the media.")
        sys.exit(
            f"[!] {path} was OVERWRITTEN but could not be removed.\n"
            f"    The file is still on disk and it is now a husk: it no longer "
            f"parses as a\n"
            f"    sealed keyfile, so the delivery secret THAT WAS IN IT IS "
            f"GONE. This copy is\n"
            f"    destroyed even though the filename remains.\n"
            f"    YOU ARE NOW RELYING ENTIRELY ON THE COPY YOU MADE ON THE "
            f"SENDING MACHINE.\n"
            f"    Verify it opens there NOW -- `gs_unseal --key <file> "
            f"--self-test` -- before\n"
            f"    anything else. If it does not, no future slip can be opened "
            f"and there is no\n"
            f"    recovery.\n"
            f"    Then delete the husk by hand; it holds nothing, but it names "
            f"what it was.")
    integrity_log("delivery", "key_shredded")
    print(f"  [+] {path} destroyed.")
    return 0


def _open_delivery(path: Path, args) -> dict:
    try:
        container = json.loads(path.read_text())
    except Exception as e:                                   # noqa: BLE001
        sys.exit(f"[!] {path} is not readable JSON ({type(e).__name__}).")
    if not proto.keyfile_is_sealed(container):
        sys.exit(f"[!] {path} is not passphrase-sealed. A delivery key that is "
                 f"not sealed is a plaintext secret on removable media.")
    p = read_passphrase("  Passphrase for the delivery key: ",
                        getter=args._getpass)
    try:
        payload = proto.unlock_keyfile(container, p)
    except proto.WakeError as e:
        sys.exit(f"[!] {path}: {e}")
    if payload.get("role") != ROLE:
        sys.exit(f"[!] {path} is the {payload.get('role')!r} keyfile, not a "
                 f"delivery key.")
    for f in ("delivery_secret", "vault_public"):
        v = payload.get(f)
        try:
            ok = isinstance(v, str) and len(bytes.fromhex(v)) == 32
        except ValueError:
            ok = False
        if not ok:
            sys.exit(f"[!] {path} carries no usable {f}.")
    # THE LABEL MUST MATCH THE KEY IT LABELS.
    #
    # delivery_public lives in the container HEAD, unencrypted, so
    # _refuse_existing can compare it without a passphrase. That is what makes
    # it useful and it is also what makes it forgeable: the head is outside the
    # sealed box, so anyone who can write the file can set it to anything.
    # Driven -- a file whose sealed secret was B, with a head claiming A,
    # against a vault sealing to A -- and _refuse_existing's match branch said
    # "the vault seals to it". Which is the confident false statement that
    # branch was rewritten to stop making.
    #
    # HERE is where it can actually be settled, because here there IS a
    # passphrase and the secret is in hand. Deriving the public key from the
    # sealed secret and comparing costs one scalar multiplication and turns the
    # head field from a claim into a checked one -- for `show`, which is the
    # command _refuse_existing now points the operator at, and for `shred`,
    # which must never destroy a file on the strength of a forged label.
    #
    # ABSENT IS FINE, MISMATCHED IS NOT. Every keyfile minted before the field
    # existed has no head entry, and those still open normally; only a head
    # that is PRESENT and WRONG is refused, because that cannot happen by age.
    _head_pub = (container.get("delivery_public") or "")
    if _head_pub:
        import nacl.public
        _real = bytes(nacl.public.PrivateKey(
            bytes.fromhex(payload["delivery_secret"])).public_key).hex()
        if _head_pub != _real:
            sys.exit(
                f"[!] {path} has been TAMPERED WITH.\n"
                f"    Its header labels it   : {str(_head_pub)[:16]}...\n"
                f"    The sealed secret is   : {_real[:16]}...\n"
                f"    The header is outside the sealed box, so a mismatch means "
                f"someone edited\n"
                f"    the label -- the secret itself is intact and "
                f"Poly1305-authenticated, or it\n"
                f"    would not have opened at all. Something wanted this file "
                f"to be taken for a\n"
                f"    key it is not. Do not use it; find out what wrote to it.")
    return payload


def build_cli() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description="Mint and manage the key that opens a sealed slip.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    n = sub.add_parser("new", help="mint a delivery key (run on the VAULT)")
    n.add_argument("--vault-key", required=True,
                   help="the ThinkPad's wake keyfile, as gs_wake_agent takes it")
    n.add_argument("--out", default="gs_delivery.key",
                   help="where to write the delivery key (0400). Put this on "
                        "removable media, not on the vault's disk.")
    n.add_argument("--kdf", default=proto.DEFAULT_KDF,
                   choices=sorted(proto.KDF_PROFILES),
                   help="Argon2id profile, recorded in the file")
    n.add_argument("--replace", action="store_true",
                   help="the vault already names a delivery key and you mean "
                        "to abandon it")
    n.set_defaults(fn=cmd_new)

    s = sub.add_parser("show", help="print the two public keys in a delivery key")
    s.add_argument("--key", required=True)
    s.set_defaults(fn=cmd_show)

    d = sub.add_parser("shred", help="destroy the vault's copy, after checking "
                                     "it opens")
    d.add_argument("--key", required=True)
    d.set_defaults(fn=cmd_shred)
    return ap


def main(argv=None) -> int:
    install_signal_handlers()
    # ARGS FIRST, NACL SECOND -- see gs_unseal's main() for why: --help must
    # work on a box that has not installed anything yet.
    args = build_cli().parse_args(argv)
    try:
        proto.require_nacl()
    except proto.WakeError as e:
        sys.exit(f"[!] {e}")
    args._getpass = getattr(args, "_getpass", None)
    args._input = getattr(args, "_input", None)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
