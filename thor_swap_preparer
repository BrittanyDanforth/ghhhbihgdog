thor swap preparer

#!/usr/bin/env python3
"""
thor_swap_preparer.py  v10.0 — ThorChain BTC → XMR quote fetcher (production‑hardened)
====================================================================
Generates **integrity‑logged** deposit / memo pairs that GhostSpiral v10
can consume later with `--auto‑swap` or deliver to an air‑gap operator.

Security & Resilience (v10 spec)
────────────────────────────────
1. **Tor‑leak guard**             – Aborts if `check.torproject.org` ≠ IsTor.
2. **Exponential‑retry + NEWNYM** – 4 attempts per quote; rotates Tor on fail.
3. **XMR dest checksum**          – Validates each provided destination.
4. **Fee‑oracle v3**              – Pulls BTC/XMR spot; warns if quote dev > 5 %.
5. **Atomic fsync‑rename**        – Writes `thor_pairs_v1.json.tmp` → fsync → rename.
6. **Integrity hash‑chain**       – Appends a SHA‑256‑linked log line per pair.

Usage
-----
```bash
torsocks python3 thor_swap_preparer.py \
    --amounts 0.04 0.0258 \
    --dests  48XMRsub1 48XMRsub2 \
    --tor-proxy socks5h://127.0.0.1:9050 \
    --outfile thor_pairs_batch.json
``` 
"""
from __future__ import annotations
import argparse, json, os, sys, time, hashlib, tempfile, random, re
from decimal import Decimal
from pathlib import Path
from typing import Dict, List
import requests
from tenacity import retry, wait_exponential, stop_after_attempt
from stem.control import Controller, Signal
from monero.address import address as _xmr_addr, Address

THOR_API = "https://api.thorswap.net/aggregator"
CHECK_TOR = "https://check.torproject.org/api/ip"
CG_PRICE = "https://api.coingecko.com/api/v3/simple/price?ids=monero,bitcoin&vs_currencies=btc"
PAIR_SCHEMA = "thor_pairs_v1"

_XMR_RE = re.compile(r"^[48][0-9AB][1-9A-HJ-NP-Za-km-z]{93}$")

################################################################################
#  Integrity‑log helpers
################################################################################
INT_LOG = Path("integrity_chain.log")

def _hash_line(line: str) -> None:
    """Append a hash‑chained line to integrity log."""
    prev = "0" * 64
    if INT_LOG.exists():
        prev = INT_LOG.read_text().splitlines()[-1].split(" | ")[0]
    h = hashlib.sha256((prev + line).encode()).hexdigest()
    INT_LOG.open("a").write(f"{h} | {line}\n")

################################################################################
#  Tor helpers
################################################################################

def _ensure_tor(proxy: Dict[str, str]):
    try:
        resp = requests.get(CHECK_TOR, timeout=15, proxies=proxy).json()
        if not resp.get("IsTor"):
            sys.exit("[!] Tor leak detected — aborting.")
    except Exception:
        sys.exit("[!] Could not verify Tor connection — aborting.")

def _newnym(ctrl: str = "/var/run/tor/control"):
    try:
        with Controller.from_socket_file(ctrl) as c:
            c.authenticate(); c.signal(Signal.NEWNYM)
    except Exception:
        print("[!] NEWNYM failed; continuing with same circuit.")

################################################################################
#  Retry‑wrapped HTTP helpers
################################################################################
@retry(stop=stop_after_attempt(4), wait=wait_exponential(multiplier=2, min=4, max=30))
def _jget(url: str, proxy: Dict[str, str] | None):
    return requests.get(url, timeout=20, proxies=proxy).json()

@retry(stop=stop_after_attempt(4), wait=wait_exponential(multiplier=2, min=4, max=30))
def _jpost(url: str, payload: dict, proxy: Dict[str, str] | None):
    return requests.post(url, json=payload, timeout=25, proxies=proxy).json()

################################################################################
#  Atomic JSON dump
################################################################################

def _atomic_dump(obj, path: Path):
    tmp = Path(str(path) + ".tmp")
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=2)
        f.flush(); os.fsync(f.fileno())
    os.replace(tmp, path)
    # quick verification read
    json.load(open(path))

################################################################################
#  Price oracle & slippage check
################################################################################

def _btc_per_xmr(proxy):
    try:
        p = _jget(CG_PRICE, proxy)
        return Decimal(str(p["monero"]["btc"]))
    except Exception:
        print("[!] Price oracle failed; using fallback 0.000015 BTC/XMR")
        return Decimal("0.000015")  # ~ 1 XMR ≈ 0.000015 BTC (placeholder)

################################################################################
#  Main
################################################################################
if __name__ == "__main__":
    ap = argparse.ArgumentParser("thor_swap_preparer v10.0")
    ap.add_argument("--amounts", nargs='+', required=True, type=Decimal)
    ap.add_argument("--dests", nargs='+', required=True)
    ap.add_argument("--tor-proxy")
    ap.add_argument("--gpg-recipient")
    ap.add_argument("--outfile", default="thor_pairs_batch.json")
    args = ap.parse_args()

    if len(args.amounts) != len(args.dests):
        sys.exit("[!] amounts and dests length mismatch")

    proxy = {"http": args.tor_proxy, "https": args.tor_proxy} if args.tor_proxy else None
    if args.tor_proxy:
        _ensure_tor(proxy)

    # validate XMR addresses
    for d in args.dests:
        if not _XMR_RE.match(d):
            sys.exit(f"[!] Bad XMR address format: {d}")
        try:
            Address(d)  # checksum validation from monero‑py
        except Exception:
            sys.exit(f"[!] XMR checksum invalid: {d}")

    btc_per_xmr = _btc_per_xmr(proxy)
    pairs: List[dict] = []

    for amt, dest in zip(args.amounts, args.dests):
        payload = {"from": "BTC.BTC", "to": "XMR.XMR", "amount": str(amt), "destination": dest}
        try:
            quote = _jpost(f"{THOR_API}/swap", payload, proxy)
        except Exception as e:
            _newnym(); raise

        deposit = quote.get("deposit")
        if not deposit or not deposit.startswith("bc1"):
            sys.exit("[!] ThorChain response missing/invalid deposit address")

        expected_xmr = Decimal(quote.get("expected_amount_out", "0"))
        oracle_xmr = (amt / btc_per_xmr) if btc_per_xmr else Decimal("0")
        if oracle_xmr and abs(expected_xmr - oracle_xmr) > oracle_xmr * Decimal("0.05"):
            print("⚠️  Quote deviates >5 % from oracle price — check liquidity.")

        pair = {
            "schema": PAIR_SCHEMA,
            "btc_in": str(amt),
            "deposit": deposit,
            "memo": quote.get("memo", ""),
            "dest_xmr": dest,
            "expected_xmr": str(expected_xmr),
            "ts": int(time.time())
        }
        pairs.append(pair)
        _hash_line(f"thor_pair {deposit[:10]}… → {dest[:10]} {expected_xmr} XMR")
        time.sleep(random.uniform(2, 5))

    _out = Path(args.outfile)
    _atomic_dump(pairs, _out)
    print(f"[✓] Saved {len(pairs)} pair(s) → {_out}")

    if args.gpg_recipient:
        import gnupg
        g = gnupg.GPG()
        enc = g.encrypt(json.dumps(pairs, indent=2), args.gpg_recipient)
        Path(str(_out) + ".gpg").write_text(str(enc))
        print("[✓] GPG bundle →", str(_out) + ".gpg")
