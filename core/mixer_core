def _exponential_delay(delay_min: int, delay_max: int) -> int:
    """Sample a delay from a truncated exponential distribution.

    Exponential is harder to fingerprint than uniform because it has no
    sharp cut-off at the boundaries.  Lambda is chosen so that ~95% of
    the distribution falls within [delay_min, delay_max].
    """
    span = delay_max - delay_min
    if span <= 0:
        return delay_min
    lam = 3.0 / span
    # BUG 98 FIX: Add iteration cap to prevent theoretical infinite loop
    # when samples consistently fall outside [delay_min, delay_max].
    for _ in range(1000):
        u = secrets.randbelow(1_000_000) / 1_000_000.0
        if u == 0.0:
            continue
        sample = -math.log(u) / lam
        delay = int(delay_min + sample)
        if delay_min <= delay <= delay_max:
            return delay
    return delay_min + (span // 2)


