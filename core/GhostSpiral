#!/usr/bin/env python3
"""
GhostSpiral v10.5 - Fully-wired BTC->XMR Mixer Core
=====================================================
!! RESEARCH / RED-TEAM TOOL !!
Never use on main-net coins you do not own.

End-to-end pipeline:
  Stage 0: Validate inputs, Tor, RPC sync
  Stage 1: JoinMarket receive (optional BTC tumble)
  Stage 2: ThorChain BTC->XMR swap
  Stage 3: Build wallets & DAG mixing graph
  Stage 4: Build unsigned TX plan with fee-aware amounts
  Stage 5: Auto-sign + broadcast (or dump for cold/airgap)

OPSEC hardening (v10.5):
  - All traffic forced through Tor with leak checks at every stage
  - NEWNYM circuit rotation between stages
  - CSPRNG for all security-critical randomness (delays, hex extras)
  - Timing jitter between operations
  - Secure file permissions (0600) on all outputs
  - Signal handlers for graceful shutdown
  - Integrity hash-chain logging for every action
  - Resource sentinel prevents operation under system stress
"""
from __future__ import annotations
import argparse, json, os, re, secrets, sys, time, subprocess
from decimal import Decimal
from pathlib import Path
from typing import List

# Ensure gs_common is found when run from any working directory
_CORE_DIR = str(Path(__file__).resolve().parent)
if _CORE_DIR not in sys.path:
    sys.path.insert(0, _CORE_DIR)

from gs_common import (
    VERSION, integrity_log, verify_tor, tor_recheck, newnym,
    safe_get, connect_rpc, require_resources, lock_memory,
    secure_hex, secure_delay, atomic_write_json, secure_file_perms,
    validate_proxy, install_signal_handlers, shutdown_requested,
    scrub_address,
)

DUST_XMR = Decimal("0.0001")
BTC_RE = re.compile(
    r"^(bc1[ac-hj-np-z02-9]{25,59}|tb1[ac-hj-np-z02-9]{25,59}"
    r"|[13][a-km-zA-HJ-NP-Z1-9]{25,34})$",
    re.I
)
THORNODE_APIS = [
    "https://thornode.ninerealms.com",
    "https://rpc.ninerealms.com",
    "https://thornode-v1.ninerealms.com",
]

def _core_script(name: str) -> str:
    """Resolve path to a sibling script in core/ directory."""
    return str(Path(__file__).resolve().parent / name)

MIN_WALLETS = 3
MIN_DEEP = 1
NUM_DECOYS = 4

# Fallback fee: conservative estimate for typical 2-input/2-output Monero TX.
# Updated periodically; safe to overshoot slightly (operator keeps the change).
FALLBACK_FEE_XMR = Decimal("0.00005")


def fetch_fee_from_rpc(rpc) -> Decimal:
    """Ask monero-wallet-rpc for current fee estimate (the only reliable source).
    Returns fee per TX in XMR, assuming ~2kB typical TX weight at default priority."""
    try:
        resp = rpc.raw_request("get_fee_estimate", {})
        fee_per_byte = resp.get("fee", 0)
        if fee_per_byte > 0:
            # Typical Monero TX is ~1.5-2kB; use 2000 bytes as conservative estimate
            fee_atomic = fee_per_byte * 2000
            fee_xmr = Decimal(str(fee_atomic)) / Decimal(10 ** 12)
            if fee_xmr > 0:
                integrity_log("fee", "rpc_fee_estimate_ok")
                return fee_xmr
    except Exception as e:
        integrity_log("fee", f"rpc_fee_estimate_fail:{str(e)[:40]}")
    integrity_log("fee", "using_fallback_fee")
    return FALLBACK_FEE_XMR


def main():
    install_signal_handlers()

    cli = argparse.ArgumentParser(
        "GhostSpiral v10.5",
        description="BTC->XMR mixing pipeline with Tor, ThorChain, and JoinMarket support",
    )

    mode_group = cli.add_mutually_exclusive_group(required=True)
    mode_group.add_argument("--btc-entry",
                            help="BTC entry address (bech32) — SENDER mode: you own the BTC")
    mode_group.add_argument("--receive-wallet",
                            help="gs_receive_wallet_v1 JSON from create_receive_wallet — "
                                 "RECEIVER mode: XMR already arrived on this address")

    cli.add_argument("--tor-proxy", required=True,
                     help="SOCKS5 proxy (e.g. socks5h://127.0.0.1:9050)")
    cli.add_argument("--joinmarket", action="store_true",
                     help="Enable JoinMarket tumble before ThorChain swap")
    cli.add_argument("--split", type=int, default=1,
                     help="Number of BTC chunks to split across ThorChain")
    cli.add_argument("--btc-amount", type=Decimal,
                     help="Total BTC amount for ThorChain swap "
                          "(required when --split > 0 in sender mode)")
    cli.add_argument("--wallets", type=int, default=10,
                     help=f"Number of mix wallets (min {MIN_WALLETS})")
    cli.add_argument("--deep", type=int, default=2,
                     help=f"Depth multiplier for DAG edges (min {MIN_DEEP})")
    cli.add_argument("--airgap", action="store_true",
                     help="Dump unsigned plan and stop (manual sign required)")
    cli.add_argument("--cold", action="store_true",
                     help="Dump unsigned plan for cold-wallet signing")
    cli.add_argument("--rpc-primary", default="http://127.0.0.1:18083",
                     help="Primary monero-wallet-rpc endpoint")
    cli.add_argument("--rpc-alt",
                     help="Fallback monero-wallet-rpc endpoint")
    cli.add_argument("--output", default="./unsigned",
                     help="Output directory for unsigned TX plans")
    cli.add_argument("--joinmarket-wallet",
                     help="JoinMarket wallet file for tumbles")
    cli.add_argument("--fee-priority", type=int, choices=[1, 2, 3, 4], default=1,
                     help="Monero fee priority: 1=default, 2=x4, 3=x20, 4=x166")
    cli.add_argument("--wallet-file", default="offline.wallet",
                     help="Path to Monero wallet file for auto-mode signing")
    cli.add_argument("--wallet-password", default="",
                     help="Password for the wallet file (empty for no password). "
                          "WARNING: visible in /proc/PID/cmdline — prefer GS_WALLET_PASSWORD env var")
    cli.add_argument("--resume-plan",
                     help="Resume Stage 5 on an existing unsigned plan JSON file. "
                          "Skips Stages 0-4 and jumps straight to create→sign→broadcast. "
                          "Use after a crash to continue from where the last run stopped. "
                          "The plan's fingerprint must match any existing stage5_progress.json.")
    args = cli.parse_args()

    # ---- Resume-plan shortcut: skip Stages 0-4, jump to Stage 5 ----
    if args.resume_plan:
        resume_path = Path(args.resume_plan)
        if not resume_path.exists():
            sys.exit(f"[!] Resume plan not found: {resume_path}")
        with open(resume_path) as f:
            _rp = json.load(f)
        if _rp.get("meta", {}).get("schema") != "unsigned_v1":
            sys.exit("[!] Resume plan is not unsigned_v1 schema")
        if _rp.get("meta", {}).get("mock"):
            sys.exit("[!] Cannot resume a mock plan (no real funds)")

        proxy = validate_proxy(args.tor_proxy)
        require_resources(min_disk_gb=2.0)
        verify_tor(proxy)

        print(f"\n  [*] RESUME MODE: Loading existing plan {resume_path}")
        print(f"  [*] Skipping Stages 0-4, jumping to Stage 5.")
        integrity_log("stage5", f"resume_plan:{resume_path.name}")

        rpc_primary = connect_rpc(args.rpc_primary, proxy_url=args.tor_proxy)
        bal = Decimal("0")
        try:
            res = rpc_primary.raw_request("get_balance", {"account_index": 0})
            bal = Decimal(str(res.get("unlocked_balance", 0))) / Decimal(10 ** 12)
        except Exception:
            pass

        staging_dir = "tx_staging"
        lock_path = Path(".ghostspiral.lock")
        if lock_path.exists():
            sys.exit("[!] Lock file exists. Another instance may be running.")
        lock_path.write_text(str(os.getpid()))
        secure_file_perms(lock_path)

        try:
            _stage5_run(args, resume_path, staging_dir, proxy, bal)
        finally:
            if lock_path.exists():
                lock_path.unlink()

        print("\n  [+] GhostSpiral resume complete.")
        sys.exit(0)

    # ---- Determine mode ----
    receive_mode = bool(args.receive_wallet)
    receive_entry_addr = None
    receive_account_index = 0

    if receive_mode:
        rw_path = Path(args.receive_wallet)
        if not rw_path.exists():
            sys.exit(f"[!] Receive wallet file not found: {rw_path}")
        with open(rw_path) as f:
            rw_data = json.load(f)
        if rw_data.get("schema") != "gs_receive_wallet_v1":
            sys.exit(f"[!] Expected schema gs_receive_wallet_v1, got: {rw_data.get('schema')}")
        receive_entry_addr = rw_data.get("address")
        receive_account_index = rw_data.get("account_index", 0)
        if not receive_entry_addr:
            sys.exit("[!] Receive wallet JSON missing 'address' field")
        wallet_network = rw_data.get("network")
        if wallet_network and wallet_network != "mainnet":
            sys.exit(
                f"[!] Receive wallet is for {wallet_network.upper()}, not mainnet.\n"
                f"    Feeding a {wallet_network} address into a mainnet pipeline will\n"
                f"    cause all swaps/transfers to fail or send funds to the void.\n"
                f"    Regenerate the wallet against a mainnet monero-wallet-rpc."
            )
        integrity_log("stage0", "receive_mode:entry_loaded")
        print(f"  [*] RECEIVER MODE: XMR entry address = {scrub_address(receive_entry_addr)}")
        if args.joinmarket:
            sys.exit("[!] --joinmarket is not applicable in receiver mode (no BTC to tumble)")
    else:
        if not BTC_RE.match(args.btc_entry):
            sys.exit(
                f"[!] Invalid BTC address: {args.btc_entry}\n"
                f"    Expected formats:\n"
                f"      Legacy P2PKH:     1... (25-34 chars)\n"
                f"      P2SH:             3... (25-34 chars)\n"
                f"      Bech32 (segwit):  bc1q... (42 chars) or bc1p... (62 chars)\n"
                f"      Testnet bech32:   tb1q... or tb1p...\n"
                f"    Your input does not match any valid Bitcoin address format.\n"
                f"    Double-check for typos or extra characters."
            )
        integrity_log("stage0", "btc_entry_validated")

    # ---- Validate inputs early ----
    args.wallets = max(args.wallets, MIN_WALLETS)
    args.deep = max(args.deep, MIN_DEEP)

    proxy = validate_proxy(args.tor_proxy)

    # ---- Stage 0: Environment checks ----
    require_resources(min_disk_gb=2.0)
    verify_tor(proxy)
    integrity_log("stage0", "tor_ok")

    # Fee estimation done after RPC is connected (needs the RPC)
    integrity_log("stage0", "env_checks_ok")

    rpc_primary = connect_rpc(args.rpc_primary, proxy_url=args.tor_proxy)
    rpc_alt = connect_rpc(args.rpc_alt, proxy_url=args.tor_proxy) if args.rpc_alt else None

    # Sync guard: wait for nodes to agree on height
    # BUG 39 FIX: h1 was referenced after the for/else but only assigned
    # inside a try block — if every attempt threw an exception, h1 would
    # be unbound at the integrity_log call (NameError on the success path
    # that never succeeds, but also confusing if partial success).
    h1 = 0
    for attempt in range(30):
        if shutdown_requested():
            sys.exit("[!] Shutdown requested during sync wait.")
        try:
            h1 = rpc_primary.raw_request("get_height", {})["height"]
            if rpc_alt:
                h2 = rpc_alt.raw_request("get_height", {})["height"]
                if abs(h1 - h2) <= 2:
                    break
            else:
                if h1 > 0:
                    break
        except Exception as e:
            integrity_log("stage0", f"rpc_height_err:{str(e)[:40]}")
        time.sleep(10)
    else:
        sys.exit("[!] RPC nodes out of sync after 5 min; abort.")
    integrity_log("stage0", "rpc_sync_ok")

    fee_xmr = fetch_fee_from_rpc(rpc_primary)
    integrity_log("stage0", "fee_fetched")

    ###########################################################################
    # Stage 1 - JoinMarket (optional BTC tumble before ThorChain)
    ###########################################################################
    newnym()

    def stage1_joinmarket(btc_addr: str) -> List[Decimal]:
        if not args.joinmarket:
            integrity_log("stage1", "JM_skipped")
            return []
        if not args.joinmarket_wallet:
            sys.exit("[!] --joinmarket-wallet required when --joinmarket is set")
        try:
            # JoinMarket has its own Tor config in joinmarket.cfg, but we pass
            # --socks5-host/port to be explicit (JM >= 0.9 supports this).
            # Without this, JM may resolve maker addresses over clearnet.
            from urllib.parse import urlparse as _urlparse
            _parsed_proxy = _urlparse(args.tor_proxy)
            result = subprocess.run(
                ["python3", "tumble.py",
                 "--socks5-host", _parsed_proxy.hostname or "127.0.0.1",
                 "--socks5-port", str(_parsed_proxy.port or 9050),
                 args.joinmarket_wallet, btc_addr, "all"],
                check=True, capture_output=True, text=True, timeout=3600,
            )
            integrity_log("stage1", "JM_tumble_OK")
            # TODO: parse actual UTXO amounts from result.stdout
            # For now return empty - operator must check JM output manually
            return []
        except subprocess.TimeoutExpired:
            integrity_log("stage1", "JM_timeout")
            sys.exit("[!] JoinMarket tumble timed out after 1 hour")
        except FileNotFoundError:
            integrity_log("stage1", "JM_not_found")
            sys.exit("[!] tumble.py not found - JoinMarket not installed?")
        except subprocess.CalledProcessError as e:
            integrity_log("stage1", f"JM_fail:{e.returncode}")
            sys.exit(f"[!] JoinMarket tumble failed (exit {e.returncode})")

    if receive_mode:
        jm_utxos = []
        integrity_log("stage1", "skipped:receive_mode")
    else:
        jm_utxos = stage1_joinmarket(args.btc_entry)
    integrity_log("stage1", f"done:jm_utxos={len(jm_utxos)}")

    ###########################################################################
    # Stage 2 - ThorChain swap definition
    ###########################################################################

    def _thornode_quote(amt: Decimal, xmr_dest: str) -> dict | None:
        """Try THORNode native API for a swap quote (no API key needed)."""
        from urllib.parse import quote as _url_quote
        amount_sats = int(amt * Decimal("1e8"))
        params = (
            f"from_asset=BTC.BTC&to_asset=XMR.XMR"
            f"&amount={amount_sats}&destination={_url_quote(xmr_dest, safe='')}"
        )
        for base_url in THORNODE_APIS:
            try:
                url = f"{base_url}/thorchain/quote/swap?{params}"
                resp = safe_get(url, proxy)
                if resp.get("error"):
                    continue
                inbound = resp.get("inbound_address", "")
                memo = resp.get("memo", "")
                expected_out = resp.get("expected_amount_out", "0")
                if inbound and memo:
                    expected_xmr = Decimal(str(expected_out)) / Decimal("1e12")
                    return {
                        "deposit_address": inbound,
                        "memo": memo,
                        "expected_xmr": str(expected_xmr),
                    }
            except Exception:
                continue
        return None

    def stage2_get_swap_quotes(chunks: List[Decimal], xmr_dest: str) -> List[dict]:
        """Get ThorChain swap quotes for each BTC chunk via THORNode native API.

        Returns list of deposit instructions for the operator.
        The operator must MANUALLY send BTC to each deposit address.
        """
        deposits = []
        for i, amt in enumerate(chunks):
            if shutdown_requested():
                integrity_log("stage2", f"shutdown_at_chunk_{i}")
                sys.exit("[!] Shutdown requested during quote fetch.")

            if amt <= Decimal(0):
                continue

            if i > 0:
                newnym()
                secure_delay(3.0, 10.0)

            result = _thornode_quote(amt, xmr_dest)

            if not result:
                integrity_log("stage2", f"thornode_failed_all_endpoints:{i}")
                sys.exit(
                    f"[!] All THORNode endpoints failed for chunk {i}.\n"
                    f"    Tried: {', '.join(THORNODE_APIS)}\n"
                    f"    Check Tor connectivity and try again later."
                )

            deposit_addr = result["deposit_address"]
            memo = result.get("memo", "")
            expected_dec = Decimal(result.get("expected_xmr", "0"))

            deposit_info = {
                "chunk": i,
                "btc_amount": str(amt),
                "deposit_address": deposit_addr,
                "memo": str(memo),
                "expected_xmr": str(expected_dec),
                "source": "thornode",
            }
            deposits.append(deposit_info)

            print(f"  [*] Chunk {i}/{len(chunks)-1} (via thornode):")
            print(f"      Send {amt} BTC to: {scrub_address(deposit_addr)}")
            if memo:
                print(f"      With memo: {str(memo)[:40]}...")
            print(f"      Expected: ~{expected_dec} XMR")
            integrity_log("stage2", f"quote_ready:{i}:thornode")

            secure_delay(5.0, 15.0)

        return deposits

    ###########################################################################
    # Stage 3 - Build wallets & DAG (runs BEFORE stage2 invocation so
    # the ENTRY receive address exists for ThorChain destination)
    ###########################################################################
    newnym()
    tor_recheck(proxy, "stage3_pre")

    sub_account = receive_account_index if receive_mode else 0

    def create_subs(rpc, n: int, decoys: int, acct_idx: int = 0) -> List[str]:
        """Create mixing subaddresses. Labels use random hex instead of
        sequential indices to avoid leaking the role or count of each
        address if the wallet file is inspected forensically (BUG 37 FIX)."""
        subs = []
        for i in range(n):
            label = secure_hex(6)
            addr = rpc.new_subaddress(account_index=acct_idx, label=label)
            subs.append(addr)
        for d in range(decoys):
            label = secure_hex(6)
            addr = rpc.new_subaddress(account_index=acct_idx, label=label)
            subs.append(addr)
        return subs

    subs = create_subs(rpc_primary, args.wallets, NUM_DECOYS, acct_idx=sub_account)
    if len(subs) < MIN_WALLETS + 1:
        sys.exit("[!] Failed to create enough subaddresses")

    if receive_mode:
        ENTRY = receive_entry_addr
        if ENTRY in subs:
            subs.remove(ENTRY)
        subs.insert(0, ENTRY)
        integrity_log("stage3", "entry_reused_from_receive_wallet")
        print(f"  [+] ENTRY (from receive wallet): {scrub_address(ENTRY)}")
    else:
        ENTRY = subs[0]
        integrity_log("stage3", "entry_created")

    secrets.SystemRandom().shuffle(subs)

    ###########################################################################
    # Stage 2 execution - ThorChain swap (now that ENTRY address exists)
    ###########################################################################
    newnym()
    tor_recheck(proxy, "stage2_exec")

    if receive_mode:
        integrity_log("stage2", "skipped:receive_mode:xmr_already_on_entry")
        print(f"\n  [+] RECEIVER MODE: Skipping ThorChain swap (XMR already on entry address).")
        print(f"  [+] Entry address: {scrub_address(ENTRY)}")
    else:
        btc_chunks = []

        if jm_utxos:
            btc_chunks = jm_utxos
        elif args.btc_amount and args.btc_amount > 0:
            num_splits = max(args.split, 1)
            per_chunk = (args.btc_amount / Decimal(num_splits)).quantize(Decimal("0.00000001"))
            btc_chunks = [per_chunk] * num_splits
            remainder = args.btc_amount - (per_chunk * num_splits)
            if remainder > 0:
                btc_chunks[0] += remainder
            integrity_log("stage2", f"btc_split:{num_splits}_chunks:{per_chunk}_each")
            print(f"\n  [*] Splitting {args.btc_amount} BTC into {num_splits} chunk(s) of ~{per_chunk} BTC")

        if btc_chunks:
            swap_deposits = stage2_get_swap_quotes(btc_chunks, ENTRY)
            integrity_log("stage2", "swap_quotes_generated")
            total_expected = sum(Decimal(d["expected_xmr"]) for d in swap_deposits)
            print(f"\n  [+] {len(swap_deposits)} deposit instruction(s) generated.")
            print(f"  [+] Expected total: ~{total_expected} XMR after swaps")
            print()
            print("  ============================================================")
            print("  SENDER INSTRUCTIONS — send BTC to these deposit addresses:")
            print("  ============================================================")
            for dep in swap_deposits:
                print(f"\n  --- Chunk {dep['chunk']} ---")
                print(f"  Send exactly: {dep['btc_amount']} BTC")
                # Show full deposit address — the operator needs it to send BTC.
                # These are THORChain vault addresses, not the operator's own.
                print(f"  To address:   {dep['deposit_address']}")
                if dep.get("memo"):
                    # Truncate memo in terminal to reduce log exposure
                    print(f"  With memo:    {dep['memo'][:40]}…")
                print(f"  Expected XMR: ~{dep['expected_xmr']}")
            print()
            print("  ============================================================")
            print("  [!] YOU MUST manually send BTC to each deposit address above!")
            print("  [!] Include the memo in the BTC transaction OP_RETURN field!")
            print("  [!] Wait for XMR to arrive and confirm before proceeding!")
            print("  ============================================================")
        else:
            integrity_log("stage2", "manual_mode")
            print(f"\n  [!] MANUAL MODE: No --btc-amount specified.")
            print(f"  [!] Use thor_swap_preparer to generate deposit addresses:")
            print(f"        python3 thor_swap_preparer \\")
            print(f"          --amounts <BTC_AMOUNT> \\")
            print(f"          --dests {scrub_address(ENTRY)} \\")
            print(f"          --tor-proxy {args.tor_proxy}")
            print(f"  [!] Then wait for XMR to arrive at ENTRY before proceeding.")

    dag = {}
    for a in subs:
        others = [b for b in subs if b != a]
        max_k = len(others)
        k = min((secrets.randbelow(3) + 1) * args.deep, max_k)
        k = max(k, 1)
        chosen = []
        pool = list(others)
        for _ in range(k):
            idx = secrets.randbelow(len(pool))
            chosen.append(pool.pop(idx))
        dag[a] = chosen
    integrity_log("stage3", "dag_built")

    ###########################################################################
    # Stage 4 - Balance, amounts, plan
    ###########################################################################

    bal_account = receive_account_index if receive_mode else 0

    def xmr_balance() -> tuple[Decimal, Decimal]:
        """Returns (total_balance, unlocked_balance) in XMR."""
        res = rpc_primary.raw_request(
            "get_balance", {"account_index": bal_account, "address_indices": []}
        )
        total = Decimal(str(res.get("balance", 0))) / Decimal(10 ** 12)
        unlocked = Decimal(str(res.get("unlocked_balance", 0))) / Decimal(10 ** 12)
        return total, unlocked

    total_bal, unlocked_bal = xmr_balance()
    integrity_log("stage4", "balance_fetched")

    if total_bal > unlocked_bal + DUST_XMR:
        print(f"  [!] {total_bal - unlocked_bal} XMR still locked (pending confirmations)")

    bal = unlocked_bal
    is_mock_plan = False
    if bal <= DUST_XMR:
        if args.cold or args.airgap:
            print("[!] Balance too low - producing dry-run plan with mock 10 XMR")
            print("[!] DO NOT sign/broadcast this plan without real funds!")
            bal = Decimal("10.0")
            is_mock_plan = True
            integrity_log("stage4", "mock_balance:dry_run_only")
        else:
            sys.exit(
                f"[!] Unlocked balance is {unlocked_bal} XMR (below dust threshold).\n"
                f"    Cannot create a real TX plan without funds.\n"
                f"    Total balance: {total_bal} XMR (may be locked/unconfirmed).\n"
                f"    Use --cold or --airgap for dry-run planning."
            )

    rounds = args.wallets * 2 * args.deep
    per_round_fee = fee_xmr * Decimal("1.5")  # 1 TX/round + 50% safety margin for fee spikes
    total_fees = per_round_fee * rounds
    usable = bal - total_fees

    if usable <= DUST_XMR:
        sys.exit(
            f"[!] Balance {bal} XMR insufficient.\n"
            f"    Estimated fees: {total_fees} XMR for {rounds} rounds.\n"
            f"    Usable after fees: {usable} XMR"
        )

    split_amt = usable / Decimal(rounds)
    integrity_log("stage4", "plan_calculated")

    # Guard against rounding dust loss: sum of all TX amounts must not exceed usable
    quantized_split = split_amt.quantize(Decimal("0.0001"))
    total_planned = quantized_split * rounds
    if total_planned > usable:
        quantized_split -= Decimal("0.0001")
        integrity_log("stage4", f"rounding_adj:new_split={quantized_split}")

    plan = []

    # Phase A: Fan-out — distribute funds from ENTRY into mix subaddresses.
    # In receiver mode, ALL funds sit on ENTRY. In sender mode, ThorChain
    # deposits to ENTRY. Either way, we must spread funds outward before
    # the random DAG mixing can function (otherwise src addresses have no
    # balance and every TX fails).
    mix_targets = [s for s in subs if s != ENTRY]
    fanout_count = min(len(mix_targets), args.wallets)
    fanout_amt = (usable * Decimal("0.9") / Decimal(fanout_count)).quantize(Decimal("0.0001"))
    # BUG 40 FIX: Verify fan-out total doesn't exceed usable balance.
    # Quantization rounding can push total above usable for small balances.
    fanout_total = fanout_amt * fanout_count
    if fanout_total > usable:
        fanout_amt -= DUST_XMR
    if fanout_amt <= DUST_XMR:
        sys.exit(
            f"[!] Usable balance {usable} XMR too small to fan out across "
            f"{fanout_count} subaddresses (each would get {fanout_amt} XMR)."
        )
    for fi in range(fanout_count):
        if shutdown_requested():
            integrity_log("stage4", f"shutdown_at_fanout_{fi}")
            break
        plan.append({
            "src": ENTRY,
            "dst": mix_targets[fi],
            "amt": str(fanout_amt),
            "delay": secrets.randbelow(540) + 180,
            "extra": secure_hex(16),
        })
    integrity_log("stage4", f"fanout_plan:{fanout_count}_txs:amt_each={fanout_amt}")

    # Phase B: DAG mixing — random hops between mix subaddresses.
    # Recalculate per-round amount from the remaining balance after fan-out.
    remaining_after_fanout = usable - (fanout_amt * fanout_count) - (per_round_fee * fanout_count)
    dag_rounds = max(rounds - fanout_count, args.wallets)
    if remaining_after_fanout > DUST_XMR and dag_rounds > 0:
        dag_split = (remaining_after_fanout / Decimal(dag_rounds)).quantize(Decimal("0.0001"))
        if dag_split <= DUST_XMR:
            dag_split = DUST_XMR
        for r in range(dag_rounds):
            if shutdown_requested():
                integrity_log("stage4", f"shutdown_at_round_{r}")
                break
            src_idx = secrets.randbelow(len(mix_targets))
            s = mix_targets[src_idx]
            dst_candidates = dag.get(s, [t for t in mix_targets if t != s])
            if not dst_candidates:
                continue
            dst_idx = secrets.randbelow(len(dst_candidates))
            d = dst_candidates[dst_idx]
            plan.append({
                "src": s,
                "dst": d,
                "amt": str(dag_split),
                "delay": secrets.randbelow(540) + 180,
                "extra": secure_hex(16),
            })
    else:
        integrity_log("stage4", "dag_mixing_skipped:insufficient_remaining")

    meta = {
        "schema": "unsigned_v1",
        "version": VERSION,
        "created": int(time.time()) // 600 * 600,
        "rounds": len(plan),
        "fee_per_round": str(per_round_fee),
        "total_fees": str(total_fees),
        "account_index": bal_account,
    }
    if is_mock_plan:
        meta["mock"] = True
    if shutdown_requested():
        meta["partial"] = True
    unsigned = {"meta": meta, "txs": plan}

    outdir = Path(args.output)
    outdir.mkdir(parents=True, exist_ok=True)
    ufile = outdir / f"unsigned_{secure_hex(8)}.json"
    atomic_write_json(unsigned, ufile)
    integrity_log("stage4", "unsigned_dump_saved")
    print(f"  [+] Unsigned plan: {ufile} ({len(plan)} TXs)")

    if args.cold or args.airgap:
        mode = "cold" if args.cold else "airgap"
        for stale in ["signer_progress.json", "broadcast_progress.json",
                       "stage5_progress.json"]:
            stale_path = Path(stale)
            if stale_path.exists():
                stale_path.unlink()
                integrity_log("stage4", f"cleaned_stale:{stale}")
        print(f"  [+] {mode.upper()} mode - transfer {ufile} to signer manually.")
        integrity_log("stage4", f"{mode}_exit")
        sys.exit(0)

    ###########################################################################
    # Stage 5 - Auto sign + broadcast
    ###########################################################################
    newnym()
    tor_recheck(proxy, "stage5_pre")

    import shutil as _shutil

    # Clean ALL stale artifacts from prior runs to prevent poisoning
    for stale in ["signer_progress.json", "broadcast_progress.json"]:
        stale_path = Path(stale)
        if stale_path.exists():
            stale_path.unlink()
            integrity_log("stage5", f"cleaned_stale:{stale}")

    # Clean old signed blobs directory
    for old_dir in ["signed_blobs", "tx_staging"]:
        old_path = Path(old_dir)
        if old_path.is_dir():
            _shutil.rmtree(old_path)
            integrity_log("stage5", f"cleaned_old_dir:{old_dir}")

    # Clean old unsigned plans (OPSEC: contain full destination addresses)
    # but NOT the current plan that Stage 4 just created
    outdir_path = Path(args.output)
    if outdir_path.is_dir():
        current_plan_name = ufile.name if hasattr(ufile, 'name') else Path(str(ufile)).name
        old_plans = list(outdir_path.glob("unsigned_*.json"))
        for old_plan in old_plans:
            if old_plan.name != current_plan_name:
                old_plan.unlink()
                integrity_log("stage5", f"cleaned_old_plan:{old_plan.name}")

    # Lock file to prevent concurrent runs
    lock_path = Path(".ghostspiral.lock")
    if lock_path.exists():
        sys.exit(
            "[!] Lock file exists: .ghostspiral.lock\n"
            "    Another GhostSpiral instance may be running.\n"
            "    If not, delete the lock file manually."
        )
    lock_path.write_text(str(os.getpid()))
    secure_file_perms(lock_path)

    staging_dir = "tx_staging"

    try:  # ensures lock file is cleaned even on error
        _stage5_run(args, ufile, staging_dir, proxy, bal)
    finally:
        if lock_path.exists():
            lock_path.unlink()

    print("\n  [+] GhostSpiral v10.5 pipeline complete.")


def _stage5_run(args, ufile, staging_dir, proxy, bal):
    """Execute the iterative create→sign→broadcast pipeline.

    CRITICAL DESIGN NOTE (BUG 58 FIX):
    Monero wallet-rpc does NOT reserve/lock outputs when do_not_relay=True.
    Creating multiple unsigned TXs without broadcasting between them causes
    all TXs to reuse the same inputs — only one can be broadcast, the rest
    are rejected as double-spends.

    Furthermore, change outputs from unbroadcast TXs are invisible to the
    wallet's coin selection. You CANNOT create a TX that spends the change
    from another unsigned/unbroadcast TX.

    Therefore, auto-mode MUST process TXs one at a time:
      For each TX in the plan:
        1. Create unsigned TX (wallet-rpc transfer_split with do_not_relay)
        2. Sign the unsigned TX (wallet-cli sign_transfer)
        3. Broadcast the signed TX (wallet-rpc submit_transfer)
        4. Wait for confirmation (at least accepted into mempool)
        5. Key image sync (export_outputs → import_key_images) so the
           view-only wallet knows which outputs are now spent

    This is slower than batch mode but is the ONLY correct approach for
    chained Monero transactions.
    """
    sign_env = os.environ.copy()
    sign_env["GS_WALLET_PASSWORD"] = args.wallet_password or ""

    if not lock_memory():
        print("  [!] WARNING: mlockall() failed — wallet password may leak to swap.")
        print("  [!] Run as root or with CAP_IPC_LOCK to prevent this.")

    # Read the plan to get TX count
    with open(str(ufile)) as _pf:
        plan_data = json.load(_pf)
    plan_txs = plan_data.get("txs", [])
    total_txs = len(plan_txs)

    if total_txs == 0:
        sys.exit("[!] Plan has no TXs")

    print(f"  [*] Stage 5: Processing {total_txs} TXs iteratively (create→sign→broadcast each)")
    print(f"  [*] This is the ONLY safe approach — Monero does not support batch unsigned TXs.")

    # Compute plan fingerprint so resume rejects stale progress from a different plan.
    # BUG 74 FIX: Include ALL plan fields (src, dst, amt, delay, extra) in the
    # fingerprint. The old hash only covered (dst, amt), so changing delays, src
    # addresses, or extra nonces produced the same fingerprint. Stale progress
    # from a prior run would be loaded, skipping TXs that should be re-executed
    # with different timing decorrelation or routing.
    import hashlib as _hl
    _h = _hl.sha256()
    for _tx in plan_txs:
        _h.update(f"{_tx.get('src','')}:{_tx.get('dst','')}:{_tx.get('amt','')}:"
                  f"{_tx.get('delay','')}:{_tx.get('extra','')}".encode())
    plan_fingerprint = _h.hexdigest()[:32]

    # Progress tracking for resume
    progress_file = Path("stage5_progress.json")
    completed_indices = set()
    if progress_file.exists():
        try:
            with open(progress_file) as pf:
                progress = json.load(pf)
            saved_fp = progress.get("plan_fingerprint", "")
            if saved_fp and saved_fp != plan_fingerprint:
                print(f"  [!] Progress file is from a DIFFERENT plan (fingerprint mismatch).")
                print(f"  [!] Discarding stale progress and starting fresh.")
                integrity_log("stage5", "progress_fingerprint_mismatch:discarded")
                progress_file.unlink()
            else:
                completed_indices = set(progress.get("completed", []))
                # BUG 73 FIX: Detect broadcast_pending — a TX that was
                # broadcast but progress wasn't finalized (crash/kill
                # between broadcast and completed save). Treat as
                # completed to prevent double-payment on resume.
                pending_idx = progress.get("broadcast_pending")
                if pending_idx is not None and pending_idx not in completed_indices:
                    print(f"  [!] TX {pending_idx} was broadcast but not confirmed "
                          f"as complete (crash during broadcast?).")
                    print(f"  [!] Treating TX {pending_idx} as completed to prevent "
                          f"double-payment. Verify wallet state manually.")
                    integrity_log("stage5", f"broadcast_pending_recovered:tx={pending_idx}")
                    completed_indices.add(pending_idx)
                if completed_indices:
                    print(f"  [+] Resuming: {len(completed_indices)} TXs already completed")
        except Exception:
            pass

    success_count = 0
    fail_count = 0

    for tx_idx in range(total_txs):
        if shutdown_requested():
            integrity_log("stage5", f"shutdown_at_tx_{tx_idx}")
            print(f"  [!] Shutdown at TX {tx_idx}. Rerun to resume from here.")
            break

        if tx_idx in completed_indices:
            print(f"  [skip] TX {tx_idx} already completed in prior run")
            success_count += 1
            continue

        tx = plan_txs[tx_idx]
        print(f"\n  [*] TX {tx_idx}/{total_txs-1}: {tx['amt']} XMR -> {scrub_address(tx['dst'])}")

        # Apply planned delay (timing decorrelation)
        if tx_idx > 0:
            delay = tx.get("delay", 0)
            if delay > 0:
                print(f"  [*] Waiting {delay}s (planned delay)...")
                waited = 0
                while waited < delay:
                    if shutdown_requested():
                        break
                    chunk = min(30, delay - waited)
                    time.sleep(chunk)
                    waited += chunk

        newnym()
        secure_delay(3.0, 8.0)

        # Step 1: Create unsigned TX
        print(f"  [*] Step 1: Creating unsigned TX {tx_idx}...")
        try:
            create_cmd = [
                "python3", _core_script("airgap_tx_signer"), str(ufile),
                "--phase", "create",
                "--rpc", args.rpc_primary,
                "--tor-proxy", args.tor_proxy,
                "--outdir", staging_dir,
                f"--fee-priority={args.fee_priority}",
                "--tx-index", str(tx_idx),
            ]
            subprocess.run(create_cmd, check=True, timeout=300)
        except subprocess.CalledProcessError as e:
            integrity_log("stage5", f"create_fail:tx={tx_idx}:rc={e.returncode}")
            print(f"  [!] TX {tx_idx} create failed (exit {e.returncode})")
            print(f"  [!] ABORTING — subsequent TXs depend on change from this TX.")
            fail_count += 1
            break
        except subprocess.TimeoutExpired:
            integrity_log("stage5", f"create_timeout:tx={tx_idx}")
            print(f"  [!] TX {tx_idx} create timed out — ABORTING pipeline.")
            fail_count += 1
            break

        # Hot wallets write presigned TXs directly to signed/tx_N.signed
        # (no unsigned file created). View-only wallets write tx_N.unsigned.
        unsigned_file = Path(staging_dir) / f"tx_{tx_idx}.unsigned"
        presigned_file = Path(staging_dir) / "signed" / f"tx_{tx_idx}.signed"
        is_presigned = presigned_file.exists() and not unsigned_file.exists()

        if not unsigned_file.exists() and not presigned_file.exists():
            print(f"  [!] TX {tx_idx}: neither unsigned nor presigned file created — ABORTING.")
            fail_count += 1
            break

        if is_presigned:
            print(f"  [skip] Step 2: TX {tx_idx} already signed (hot wallet)")
            signed_file = presigned_file
        else:
            # Step 2: Sign the unsigned TX
            print(f"  [*] Step 2: Signing TX {tx_idx}...")
            try:
                sign_cmd = [
                    "python3", _core_script("airgap_tx_signer"), str(ufile),
                    "--phase", "sign",
                    "--wallet-file", args.wallet_file,
                    "--outdir", staging_dir,
                    "--tx-index", str(tx_idx),
                ]
                subprocess.run(sign_cmd, check=True, timeout=300, env=sign_env)
            except subprocess.CalledProcessError as e:
                integrity_log("stage5", f"sign_fail:tx={tx_idx}:rc={e.returncode}")
                print(f"  [!] TX {tx_idx} signing failed — ABORTING pipeline.")
                fail_count += 1
                break
            except subprocess.TimeoutExpired:
                integrity_log("stage5", f"sign_timeout:tx={tx_idx}")
                print(f"  [!] TX {tx_idx} sign timed out — ABORTING pipeline.")
                fail_count += 1
                break

            signed_file = Path(staging_dir) / "signed" / f"tx_{tx_idx}.signed"
            if not signed_file.exists():
                print(f"  [!] TX {tx_idx}: signed file not created — ABORTING.")
                fail_count += 1
                break

        # BUG 73 FIX: Save "broadcast_pending" state BEFORE broadcasting.
        # If the process is killed between broadcast and progress save,
        # the TX is on-chain but progress doesn't reflect it. On resume,
        # the code would re-create a NEW TX (different nonces) spending
        # the same inputs. If the original confirmed between crash and
        # resume, the wallet picks different inputs → double-payment.
        # By persisting broadcast_pending first, the resume path can
        # detect this and verify wallet state before re-creating.
        from gs_common import atomic_write_json as _awj
        broadcast_pending = set(completed_indices)
        broadcast_pending.add(tx_idx)
        _awj({
            "plan_fingerprint": plan_fingerprint,
            "completed": sorted(completed_indices),
            "broadcast_pending": tx_idx,
        }, progress_file)

        # Step 3: Broadcast via wallet-rpc's submit_transfer
        # (NOT via monerod — submit_transfer is a wallet-rpc method)
        print(f"  [*] Step 3: Broadcasting TX {tx_idx}...")
        newnym()
        try:
            signed_data = signed_file.read_bytes()
            rpc_primary = connect_rpc(args.rpc_primary, proxy_url=args.tor_proxy)
            result = rpc_primary.raw_request("submit_transfer", {
                "tx_data_hex": signed_data.hex(),
            })
            tx_hashes = result.get("tx_hash_list", [])
            if not tx_hashes:
                integrity_log("stage5", f"broadcast_no_txid:tx={tx_idx}")
                print(f"  [!] TX {tx_idx} submitted but no txid returned — ABORTING pipeline.")
                print(f"  [!] Wallet state is ambiguous. Investigate before rerunning.")
                fail_count += 1
                break
            txid = tx_hashes[0]
            print(f"  [+] TX {tx_idx} broadcast OK | txid: {txid[:16]}...")
            integrity_log("stage5", f"broadcast_ok:tx={tx_idx}")
        except Exception as e:
            integrity_log("stage5", f"broadcast_fail:tx={tx_idx}:{str(e)[:40]}")
            print(f"  [!] TX {tx_idx} broadcast failed: {str(e)[:80]}")
            print(f"  [!] ABORTING pipeline — wallet state may be inconsistent.")
            print(f"  [!] Check if the TX was actually broadcast before rerunning.")
            _awj({
                "plan_fingerprint": plan_fingerprint,
                "completed": sorted(completed_indices),
            }, progress_file)
            fail_count += 1
            break

        # Step 4: Wait for mempool acceptance, then refresh wallet state.
        # submit_transfer broadcasts via wallet-rpc, which updates the hot
        # wallet's internal state (spent outputs). But we must still call
        # refresh so the wallet re-scans and sees the TX in the mempool/chain.
        # Without this, the next transfer_split may reuse spent outputs.
        time.sleep(5)
        try:
            rpc_primary.raw_request("refresh", {})
        except Exception as e:
            integrity_log("stage5", f"refresh_warn:tx={tx_idx}:{str(e)[:40]}")
            print(f"  [!] Wallet refresh after TX {tx_idx} failed: {str(e)[:60]}")
            print(f"  [!] Next TX may fail due to stale wallet state.")

        success_count += 1
        completed_indices.add(tx_idx)

        _awj({
            "plan_fingerprint": plan_fingerprint,
            "completed": sorted(completed_indices),
        }, progress_file)

        print(f"  [+] TX {tx_idx} complete ({success_count}/{total_txs})")

    # Summary
    integrity_log("stage5", f"pipeline:{success_count}_ok:{fail_count}_fail")
    print(f"\n  [+] Stage 5 complete: {success_count} sent, {fail_count} failed out of {total_txs}")

    if fail_count:
        print(f"  [!] {fail_count} TXs failed. Check logs and retry.")

    # Clean progress file on full success
    if success_count == total_txs and progress_file.exists():
        progress_file.unlink()

    # Exit strategy simulation
    newnym()
    secure_delay(5.0, 15.0)

    try:
        print("  [*] Exit strategy simulation...")
        exit_amt = str(sum(Decimal(t["amt"]) for t in plan_txs))
        subprocess.run(
            ["python3", _core_script("exit_strategy_simulator"), exit_amt,
             "--method", "bisq", "--tor-proxy", args.tor_proxy],
            check=True, timeout=300,
        )
        integrity_log("stage5", "exit_sim_ok")
    except Exception as e:
        integrity_log("stage5", f"exit_sim_warn:{str(e)[:40]}")
        print(f"  [!] Exit simulation failed (non-fatal): {e}")

    integrity_log("stage5", "full_pipeline_complete")


if __name__ == "__main__":
    main()
