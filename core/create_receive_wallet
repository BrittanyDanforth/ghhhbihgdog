#!/usr/bin/env python3
"""
create_receive_wallet - Receive wallet generator
==================================================
Generates a fresh Monero receive wallet / sub-address bundle that
conforms to the pipeline's JSON schema.

OPSEC hardening:
  - Tor leak check before RPC contact
  - NEWNYM after wallet creation to break timing correlation
  - Output files written 0600 (owner-only)
  - Addresses scrubbed in terminal output
  - Integrity hash-chain for every wallet event
  - Atomic JSON writes with fsync
  - Resource sentinel
"""
from __future__ import annotations
import argparse, sys, time
from pathlib import Path

_CORE_DIR = str(Path(__file__).resolve().parent)
if _CORE_DIR not in sys.path:
    sys.path.insert(0, _CORE_DIR)

from gs_common import (
    integrity_log, verify_tor, validate_proxy, connect_rpc,
    require_resources, atomic_write_json, validate_wallet_json,
    install_signal_handlers, newnym, scrub_address, secure_hex,
    data_path, TOOLKIT_ROOT,
)


def _detect_network(addr_str: str) -> str:
    """Detect which Monero network an address belongs to.

    Mainnet standard addresses start with '4', subaddresses with '8'.
    Testnet standard starts with '9', subaddresses with 'B'.
    Stagenet standard starts with '5', subaddresses with '7'.
    Falls back to monero-python's address parser if available.
    """
    try:
        from monero.address import address as parse_address
        a = parse_address(addr_str)
        net = getattr(a, "net", None)
        if net == "main":
            return "mainnet"
        elif net == "test":
            return "testnet"
        elif net == "stage":
            return "stagenet"
    except Exception as e:
        integrity_log("wallet", f"network_detect_fallback:{type(e).__name__}")
    if addr_str and addr_str[0] in ("4", "8"):
        return "mainnet"
    elif addr_str and addr_str[0] in ("9", "B"):
        return "testnet"
    elif addr_str and addr_str[0] in ("5", "7"):
        return "stagenet"
    return "unknown"


def main():
    install_signal_handlers()

    ap = argparse.ArgumentParser(
        description="Generate a fresh Monero receive subaddress for the mixer pipeline",
    )
    ap.add_argument("--rpc", default="http://127.0.0.1:18083",
                    help="monero-wallet-rpc endpoint")
    ap.add_argument("--tor-proxy",
                    help="socks5h://host:port if routing via Tor")
    ap.add_argument("--label", default="",
                    help="label for the new subaddress (default: random hex)")
    ap.add_argument("--account-index", type=int, default=0,
                    help="wallet account index to create subaddress on (default: 0)")
    ap.add_argument("--output-dir", default=str(TOOLKIT_ROOT),
                    help="directory for wallet JSON output (default: toolkit root)")
    args = ap.parse_args()

    require_resources(min_disk_gb=2.0)

    if not args.tor_proxy:
        sys.exit(
            "[!] --tor-proxy is REQUIRED. The Tor verification check itself needs\n"
            "    a proxy to confirm safe operation. Aborting."
        )
    proxy = validate_proxy(args.tor_proxy)
    verify_tor(proxy)

    try:
        wallet_rpc = connect_rpc(args.rpc, proxy_url=args.tor_proxy)
    except Exception as e:
        integrity_log("wallet", f"rpc_connect_fail:{str(e)[:60]}")
        sys.exit(f"[!] Cannot connect to monero-wallet-rpc: {e}")

    if not args.label:
        args.label = secure_hex(6)

    acct_idx = args.account_index
    accounts = wallet_rpc.accounts
    if acct_idx >= len(accounts):
        sys.exit(
            f"[!] Account index {acct_idx} does not exist "
            f"(wallet has {len(accounts)} account(s), indices 0-{len(accounts)-1}).\n"
            f"    Create the account first via monero-wallet-rpc's create_account."
        )
    try:
        addr_str, sub_idx = wallet_rpc.new_subaddress_indexed(
            account_index=acct_idx, label=args.label,
        )
    except Exception as e:
        integrity_log("wallet", f"subaddress_create_fail:{str(e)[:60]}")
        sys.exit(
            f"[!] Failed to create subaddress: {e}\n"
            f"    Verify monero-wallet-rpc is running and the wallet is open."
        )

    if not addr_str:
        integrity_log("wallet", "subaddress_empty")
        sys.exit("[!] wallet-rpc returned empty address — wallet may not be open.")

    network = _detect_network(addr_str)
    if network not in ("mainnet", "unknown"):
        integrity_log("wallet", f"network_BLOCK:{network}")
        sys.exit(
            f"[!] Address belongs to {network.upper()}, not mainnet.\n"
            f"    A {network} wallet JSON fed into a mainnet pipeline will cause\n"
            f"    all transfers to fail or send funds to unreachable addresses.\n"
            f"    Connect monero-wallet-rpc to a mainnet wallet and retry."
        )
    # FUNDS-LOSS FIX: 'unknown' previously passed the gate. A malformed
    # or unusual subaddress that our local parser didn't recognise would
    # be blessed as mainnet-compatible and wired into the pipeline. If
    # monero-python is available we REQUIRE it to classify the address;
    # refusing 'unknown' is safer than leaking into a mainnet broadcast.
    if network == "unknown":
        try:
            from monero.address import address as _parse_address  # noqa
            _have_monero_python = True
        except Exception:
            _have_monero_python = False
        if _have_monero_python:
            integrity_log("wallet", "network_BLOCK:unknown_with_parser")
            sys.exit(
                "[!] Could not classify the subaddress's network even "
                "though monero-python is installed.\n"
                "    Refusing to write a wallet JSON for an unclassified "
                "address — funds sent here might be unreachable.")
        else:
            print("  [!] monero-python is not installed; network could not "
                  "be confirmed.")
            print("  [!] Continuing with network='unknown' ONLY because the "
                  "local parser couldn't help.")
            integrity_log("wallet", "network_UNKNOWN_accepted_no_parser")

    integrity_log("wallet", f"created:{scrub_address(addr_str)}:label={args.label}")

    out = {
        "schema": "recv_wallet",
        "created": int(time.time()) // 600 * 600,
        "address": addr_str,
        "account_index": acct_idx,
        "subaddress_index": sub_idx,
        "label": args.label,
        "network": network,
    }

    validate_wallet_json(out)

    outdir = Path(args.output_dir)
    outdir.mkdir(parents=True, exist_ok=True)
    fname = outdir / f"wallet_{secure_hex(8)}.json"
    atomic_write_json(out, fname)

    print(f"  [+] Wallet written -> {fname.name} (fsync'd, 0600 permissions)")
    print(f"  [+] Address (scrubbed): {scrub_address(addr_str)}")
    print(f"  [+] Network: {network}")
    print(f"  [+] Full address is in the JSON file — do NOT display it in terminal.")

    integrity_log("wallet", f"saved:{fname.name}")

    if proxy:
        newnym()

    print(f"  [+] Integrity chain updated.")
    print()
    # BUG 55 FIX: Don't print full XMR address in terminal output.
    # Terminal scrollback, screen recordings, and shoulder-surfing can
    # capture it. Instead, reference the JSON file which has 0600 perms.
    print(f"  === NEXT STEPS ===")
    print(f"  From the main menu:")
    print(f"")
    print(f"  Option 2 (Receive - guided) walks you through everything:")
    print(f"    → Select this wallet (it will auto-detect {fname.name})")
    print(f"    → Generate a BTC deposit address for the sender")
    print(f"    → Wait for BTC → XMR conversion")
    print(f"    → Mix the received XMR")


if __name__ == "__main__":
    main()
