#!/usr/bin/env python3
"""
thor_swap_preparer v10.0 - ThorChain BTC -> XMR quote fetcher
==============================================================
Generates integrity-logged deposit/memo pairs that GhostSpiral v10
can consume later.

OPSEC hardening:
  - Tor verified with retry before any API contact
  - NEWNYM circuit rotation between each quote request
  - Timing jitter between quotes to frustrate correlation
  - XMR destination addresses validated (regex + checksum)
  - BTC deposit addresses validated (bech32 format check)
  - Slippage oracle cross-check with 5% deviation warning
  - Atomic fsync-rename on all output files (0600 perms)
  - GPG encryption support with import guard
  - Integrity hash-chain per pair
"""
from __future__ import annotations
import argparse, json, os, sys, time, re
from decimal import Decimal
from pathlib import Path
from typing import Dict, List

_CORE_DIR = str(Path(__file__).resolve().parent)
if _CORE_DIR not in sys.path:
    sys.path.insert(0, _CORE_DIR)

from gs_common import (
    integrity_log, verify_tor, validate_proxy, newnym,
    safe_get, secure_delay, atomic_write_json,
    install_signal_handlers, shutdown_requested, scrub_address,
    secure_hex,
)

try:
    from monero.address import Address as XMRAddress
except ImportError:
    sys.exit("[!] python-monero missing - pip install monero")

THORNODE_APIS = [
    "https://thornode.ninerealms.com",
    "https://thornode-v1.ninerealms.com",
    "https://thornode.thorswap.net",
]
CG_PRICE = "https://api.coingecko.com/api/v3/simple/price?ids=monero,bitcoin&vs_currencies=btc"
PAIR_SCHEMA = "swap_pairs_v1"
# BUG 66 FIX: Accept all valid BTC address formats including legacy (1...),
# P2SH (3...), and bech32 (bc1...). ThorChain vaults can use any format.
BTC_RE = re.compile(
    r"^(bc1[ac-hj-np-z02-9]{25,59}|tb1[ac-hj-np-z02-9]{25,59}"
    r"|[13][a-km-zA-HJ-NP-Z1-9]{25,34})$",
    re.I
)
# BUG 65 FIX: Accept standard (95 char), subaddress (95 char), and
# integrated (106 char) Monero address formats.
_XMR_RE = re.compile(r"^[48][0-9AB][1-9A-HJ-NP-Za-km-z]{93,104}$")


def _btc_per_xmr(proxy: Dict[str, str] | None) -> Decimal:
    """Fetch current BTC/XMR rate from CoinGecko.
    Set COINGECKO_API_KEY env var for reliable access (free demo key).
    """
    try:
        url = CG_PRICE
        cg_key = os.environ.get("COINGECKO_API_KEY", "")
        if cg_key:
            url += f"&x_cg_demo_api_key={cg_key}"
        p = safe_get(url, proxy)
        rate = Decimal(str(p.get("monero", {}).get("btc", 0)))
        if rate <= 0:
            raise ValueError("Non-positive rate")
        return rate
    except Exception as e:
        integrity_log("thor", f"price_oracle_fail:{str(e)[:40]}")
        print("[!] Price oracle failed; using hardcoded fallback 0.003 BTC/XMR")
        print("[!] WARNING: This fallback never updates. If the real XMR/BTC rate has")
        print("[!] moved significantly, slippage checks will produce false positives")
        print("[!] or false negatives. Verify the rate manually before proceeding.")
        return Decimal("0.003")


def _validate_xmr_addr(addr: str) -> None:
    """Validate XMR address format and checksum."""
    if not _XMR_RE.match(addr):
        sys.exit(f"[!] Bad XMR address format: {scrub_address(addr)}")
    try:
        XMRAddress(addr)
    except Exception:
        sys.exit(f"[!] XMR checksum invalid: {scrub_address(addr)}")


def _thornode_quote(amt_btc: Decimal, xmr_dest: str, proxy: dict) -> dict | None:
    """Try THORNode native API for a swap quote. Returns deposit info or None."""
    amt_sats = int(amt_btc * Decimal("100000000"))
    for node in THORNODE_APIS:
        try:
            url = (f"{node}/thorchain/quote/swap"
                   f"?from_asset=BTC.BTC&to_asset=XMR.XMR"
                   f"&amount={amt_sats}&destination={xmr_dest}")
            resp = safe_get(url, proxy)
            # BUG 77 FIX: Check for error key presence, not truthiness.
            # {"error": ""} has a falsy value but still indicates an error.
            if "error" in resp:
                integrity_log("thor", f"thornode_error:{node}:{str(resp['error'])[:60]}")
                continue
            inbound = resp.get("inbound_address", "")
            memo = resp.get("memo", "")
            expected_out = resp.get("expected_amount_out", "0")
            if inbound and memo and len(memo) > 5:
                # BUG 78 FIX: Check memo length against BTC OP_RETURN limit.
                memo_bytes = len(memo.encode("utf-8"))
                if memo_bytes > 80:
                    integrity_log("thor", f"memo_too_long:{node}:{memo_bytes}B")
                    print(f"  [!] WARNING: ThorChain memo is {memo_bytes} bytes "
                          f"(BTC OP_RETURN limit is 80 bytes). Skipping endpoint.")
                    continue

                # BUG 79 FIX: Enforce recommended_min_amount_in.
                rec_min = resp.get("recommended_min_amount_in")
                if rec_min:
                    try:
                        min_sats = int(rec_min)
                        if amt_sats < min_sats:
                            min_btc = Decimal(str(min_sats)) / Decimal("1e8")
                            integrity_log("thor", f"below_min:{amt_btc}<{min_btc}")
                            print(f"  [!] WARNING: {amt_btc} BTC is below ThorChain "
                                  f"minimum of {min_btc} BTC. Swap will likely fail.")
                            continue
                    except (ValueError, TypeError):
                        pass

                expected_xmr = Decimal(str(expected_out)) / Decimal("1000000000000")
                if expected_xmr <= 0:
                    continue
                if expected_xmr > 100000:
                    continue

                # BUG 80 FIX: Extract quote expiry.
                expiry = resp.get("expiry", 0)
                try:
                    expiry = int(expiry)
                except (ValueError, TypeError):
                    expiry = 0

                return {
                    "deposit": inbound,
                    "memo": memo,
                    "expected_xmr": expected_xmr,
                    "source": "thornode",
                    "expiry": expiry,
                    "memo_bytes": memo_bytes,
                }
        except Exception as e:
            integrity_log("thor", f"thornode_fail:{node}:{str(e)[:40]}")
            continue
    return None


def main():
    install_signal_handlers()

    ap = argparse.ArgumentParser(
        description="Fetch ThorChain BTC->XMR quotes via THORNode native API with OPSEC hardening",
    )
    ap.add_argument("--amounts", nargs="+", required=True, type=Decimal,
                    help="BTC amounts to swap")
    ap.add_argument("--dests", nargs="+", required=True,
                    help="XMR destination addresses (one per amount)")
    ap.add_argument("--tor-proxy",
                    help="SOCKS5 proxy (required for production use)")
    ap.add_argument("--gpg-recipient",
                    help="GPG recipient for encrypted output")
    ap.add_argument("--outfile", default="thor_pairs_batch.json")
    ap.add_argument("--force", action="store_true",
                    help="Overwrite existing output file (DANGER: old deposit "
                         "addresses are invalidated when new ones are generated)")
    args = ap.parse_args()

    if len(args.amounts) != len(args.dests):
        sys.exit(f"[!] Mismatch: {len(args.amounts)} amounts vs {len(args.dests)} dests")

    for amt in args.amounts:
        if amt <= 0:
            sys.exit(f"[!] Amount must be positive: {amt}")

    if not args.tor_proxy:
        sys.exit(
            "[!] --tor-proxy is REQUIRED. Clearnet queries to ThorChain API leak\n"
            "    your IP and reveal you are performing BTC->XMR swaps. Aborting."
        )
    proxy = validate_proxy(args.tor_proxy)
    verify_tor(proxy)

    for d in args.dests:
        _validate_xmr_addr(d)

    btc_per_xmr = _btc_per_xmr(proxy)
    integrity_log("thor", "oracle_fetched")

    pairs: List[dict] = []

    for i, (amt, dest) in enumerate(zip(args.amounts, args.dests)):
        if shutdown_requested():
            integrity_log("thor", f"shutdown_at_pair_{i}")
            break

        # Rotate circuit between quotes
        if i > 0 and proxy:
            newnym()
            secure_delay(3.0, 8.0)

        tn_result = _thornode_quote(amt, dest, proxy)
        if tn_result:
            deposit = tn_result["deposit"]
            memo = tn_result["memo"]
            expected_xmr = tn_result["expected_xmr"]
            integrity_log("thor", f"thornode_ok_{i}")
            print(f"  [+] Using THORNode native API for pair {i}")
        else:
            integrity_log("thor", f"thornode_failed_all_endpoints_{i}")
            sys.exit(
                f"[!] All THORNode endpoints failed for pair {i}.\n"
                f"    Tried: {', '.join(THORNODE_APIS)}\n"
                f"    Check Tor connectivity and try again later."
            )

        if not deposit:
            integrity_log("thor", f"no_deposit_{i}")
            sys.exit(f"[!] ThorChain returned no deposit address for pair {i}")

        if not BTC_RE.match(deposit):
            integrity_log("thor", f"bad_deposit_format_{i}")
            sys.exit(f"[!] Deposit address not a valid BTC address: {scrub_address(deposit)}")

        # Slippage check
        oracle_xmr = (amt / btc_per_xmr) if btc_per_xmr else Decimal("0")
        if oracle_xmr > 0:
            deviation = abs(expected_xmr - oracle_xmr) / oracle_xmr
            if deviation > Decimal("0.05"):
                print(f"  [!] Pair {i}: quote deviates {deviation * 100:.1f}% from oracle")
                integrity_log("thor", f"slippage_warn_{i}:dev={deviation:.4f}")

        expiry = tn_result.get("expiry", 0)
        memo_bytes = tn_result.get("memo_bytes", 0)

        pair = {
            "schema": PAIR_SCHEMA,
            "btc_in": str(amt),
            "deposit": deposit,
            "memo": str(memo),
            "dest_xmr": dest,
            "expected_xmr": str(expected_xmr),
            "ts": int(time.time()) // 600 * 600,  # coarsen to 10-min bucket
            "expiry": expiry,
            "memo_bytes": memo_bytes,
        }
        pairs.append(pair)
        integrity_log("thor", f"pair_{i}:ready")
        print(f"  [+] Pair {i}: {amt} BTC -> {scrub_address(deposit)} "
              f"(expected {expected_xmr} XMR)")
        if expiry:
            remaining = expiry - int(time.time())
            if remaining <= 0:
                print(f"  [!] PAIR {i} QUOTE ALREADY EXPIRED — do NOT send BTC!")
                integrity_log("thor", f"pair_{i}_expired_at_print")
            else:
                print(f"  [*] Pair {i} expires in {remaining // 60}m {remaining % 60}s")

    if not pairs:
        sys.exit("[!] No pairs generated")

    # BUG 76 FIX: /v3/swap creates a binding commitment on ThorChain.
    # Re-running generates different deposit addresses. If the sender
    # already sent BTC to the old addresses, overwriting the file loses
    # those addresses and the BTC may be unrecoverable.
    _out = Path(args.outfile)
    if _out.exists() and not args.force:
        sys.exit(
            f"[!] Output file {_out} already exists!\n"
            f"    Re-running creates NEW deposit addresses — old ones may expire.\n"
            f"    If a sender already sent BTC to the old addresses, DO NOT overwrite.\n"
            f"    Use --force to overwrite, or --outfile <different_name>."
        )
    atomic_write_json(pairs, _out)
    integrity_log("thor", f"saved:{_out.name}:pairs={len(pairs)}")
    print(f"\n  [+] {len(pairs)} pair(s) written to {_out} (fsync'd, 0600 permissions)")

    print()
    print("  ============================================================")
    print("  SENDER INSTRUCTIONS — copy-paste and give to the BTC sender:")
    print("  ============================================================")
    for i, pair in enumerate(pairs):
        print(f"\n  --- Payment {i+1} of {len(pairs)} ---")
        print(f"  Send exactly: {pair['btc_in']} BTC")
        print(f"  To address:   {pair['deposit']}")
        if pair.get("memo"):
            print(f"  With memo:    {pair['memo']}")
        else:
            print(f"  Memo:         (none required)")
        print(f"  Expected XMR: ~{pair['expected_xmr']}")
        pair_expiry = pair.get("expiry", 0)
        if pair_expiry:
            pair_remaining = pair_expiry - int(time.time())
            if pair_remaining <= 0:
                print(f"  *** EXPIRED — DO NOT SEND — request new quote! ***")
            elif pair_remaining < 600:
                print(f"  *** URGENT: expires in {pair_remaining // 60}m {pair_remaining % 60}s ***")
            else:
                print(f"  Expires in:   {pair_remaining // 60}m {pair_remaining % 60}s")
    print()
    print("  ============================================================")
    print("  IMPORTANT: The sender must include the memo in the BTC")
    print("  transaction's OP_RETURN field. Without it, ThorChain cannot")
    print("  route the swap.")
    print("  QUOTES EXPIRE — send BTC BEFORE the expiry shown above!")
    print("  Sending after expiry = funds stuck in ThorChain vault!")
    print("  ============================================================")

    if args.gpg_recipient:
        try:
            import gnupg
            g = gnupg.GPG()
            enc = g.encrypt(json.dumps(pairs, indent=2), args.gpg_recipient, armor=True)
            if enc.ok:
                gpg_path = Path(str(_out) + ".gpg")
                gpg_path.write_bytes(enc.data if isinstance(enc.data, bytes) else str(enc).encode())
                os.chmod(gpg_path, 0o600)
                integrity_log("thor", f"gpg_ok:{gpg_path.name}")
                print(f"  [+] GPG bundle -> {gpg_path}")
            else:
                integrity_log("thor", f"gpg_fail:{enc.status}")
                print(f"  [!] GPG encryption failed: {enc.status}")
        except ImportError:
            print("[!] python-gnupg not installed - skipping GPG encryption")

    if proxy:
        newnym()


if __name__ == "__main__":
    main()
