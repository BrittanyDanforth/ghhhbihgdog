#!/usr/bin/env python3
"""
receive_watch - GhostSpiral companion: watch a receive address until paid
=========================================================================
Closes the one manual gap in the receiver flow. create_receive_wallet prints
"3. Wait for sender's BTC to arrive and ThorChain to convert to XMR" and then
leaves the operator refreshing something by hand. This waits for them, tells
them when the money is really theirs, and then asks what to do with it.

    receive_watch --receive-wallet wallet_ab12.json --pairs thor_pairs.json \
                  --tor-proxy socks5h://127.0.0.1:9050

WHAT IT WATCHES, AND WHY THAT SIDE
----------------------------------
The sender pays BITCOIN, so the obvious design is to watch the BTC deposit
address. This tool deliberately does NOT, and will not be extended to:

  * Asking mempool.space / blockstream / any explorer "has this address been
    paid?" tells a party that did not previously know it that SOMEONE cares
    about that address, at that moment, repeatedly, for as long as you wait.
    Tor hides who is asking; it does not un-ask the question. The polling
    pattern itself then times the arrival for that party.
  * The BTC leg is not the event that matters anyway. BTC landing in a
    ThorChain vault is not money you control -- the swap can still fail, be
    refunded, or under-deliver. The event worth waiting for is XMR arriving,
    confirmed and unlocked, on YOUR subaddress.

So the watch runs entirely against YOUR OWN monero-wallet-rpc: the balance of
one subaddress of a wallet you already hold. On the normal localhost setup
that is a loopback socket and reaches no third party at all; the daemon behind
it syncs over Tor exactly as it already did. Watching therefore adds ZERO new
disclosure to anyone -- which is the only reason it is safe to poll for hours.

The swap provider is a different case: it already created the BTC-deposit ->
XMR-destination binding and cannot un-know it, so asking it about your own
swap discloses nothing new. That is still not done here, because it is not
needed -- the XMR side answers the question authoritatively.

OPSEC hardening:
  - Tor verified ONCE at start, never per poll (a check.torproject.org request
    on every tick would be a far louder pattern than the thing being watched)
  - Poll interval JITTERED, so a remote/observed RPC sees no fixed heartbeat
  - Amounts never enter the integrity log (they are the most linkable value in
    the whole pipeline); only state transitions are chained
  - Addresses scrubbed in the log; printed in full to the terminal, because
    the operator has to read them to use them
  - Spends NOTHING, ever. It reports and prints the command it would suggest;
    arming and running a spend stays where the rest of the toolchain puts it.
"""
from __future__ import annotations
import argparse, json, secrets, shlex, sys, time
from decimal import Decimal, ROUND_DOWN
from pathlib import Path

from gs_common import (
    integrity_log, verify_tor, validate_proxy, connect_rpc,
    install_signal_handlers, shutdown_requested, scrub_address,
    load_receive_bundle, RECEIVE_SCHEMA, memo_binds_destination,
    env_or_argv,
)

ATOMIC = Decimal("1000000000000")          # piconero per XMR
PAIR_SCHEMA = "thor_pairs_v1"

# Poll cadence. A fixed interval is a heartbeat an observer of a remote RPC can
# lock onto, so the wait is jittered inside this band rather than ticking.
POLL_MIN_S = 45
POLL_MAX_S = 90

# How long the balance may sit unchanged, AFTER something has arrived, before
# we stop assuming more is coming. A swap that under-delivers (slippage, a
# partial fill, a fee taken off the top) otherwise leaves the operator waiting
# forever for a number that is never going to arrive.
STALL_MINUTES_DEFAULT = 30


def to_xmr(atomic: int) -> Decimal:
    """Atomic units -> XMR, truncated at 12dp (never rounded up: this number is
    shown as 'you have', and rounding money up is how a plan is built on funds
    that are not there)."""
    return (Decimal(int(atomic)) / ATOMIC).quantize(Decimal("0.000000000001"),
                                                    rounding=ROUND_DOWN)


def load_pairs(path: str) -> list:
    """Load a thor_pairs_v1 bundle (the list thor_swap_preparer writes)."""
    p = Path(path)
    if not p.is_file():
        raise FileNotFoundError(f"pairs bundle not found: {path}")
    try:
        d = json.loads(p.read_text())
    except Exception as e:                                   # noqa: BLE001
        raise ValueError(f"pairs bundle is not readable JSON: {str(e)[:60]}")
    if not isinstance(d, list) or not d:
        raise ValueError("pairs bundle must be a non-empty JSON list")
    for entry in d:
        if not isinstance(entry, dict) or entry.get("schema") != PAIR_SCHEMA:
            raise ValueError(f"every pair must carry schema {PAIR_SCHEMA}")
    return d


def pairs_for_dest(pairs: list, dest_addr: str) -> list:
    """Only the pairs actually routed to THIS receive address.

    A pairs file can hold several swaps to several destinations. Summing all of
    them would set a target this subaddress is never going to reach, and the
    watch would run until timeout on a payment that already completed.
    """
    return [p for p in pairs if p.get("dest_xmr") == dest_addr]


def expected_total(pairs: list) -> Decimal:
    """Sum of quoted XMR output across pairs. Unreadable/absent quotes count 0,
    matching thor_swap_preparer, which already warned about them at quote time."""
    tot = Decimal(0)
    for p in pairs:
        try:
            v = Decimal(str(p.get("expected_xmr") or "0"))
        except Exception:                                    # noqa: BLE001
            v = Decimal(0)
        if v > 0:
            tot += v
    return tot


def accept_floor(target: Decimal, tolerance: Decimal) -> Decimal:
    """The amount at which we call the payment complete.

    A swap essentially never delivers its quote to the digit -- the rate moves
    between quote and execution and the network takes its cut. Waiting for the
    exact quoted figure is waiting for something that will not happen, so the
    gate sits a tolerance below it and the shortfall is shown honestly.
    """
    if target <= 0:
        return Decimal(0)
    if not (Decimal(0) <= tolerance < Decimal(1)):
        raise ValueError("tolerance must be >= 0 and < 1")
    return (target * (Decimal(1) - tolerance)).quantize(
        Decimal("0.000000000001"), rounding=ROUND_DOWN)


def poll_seconds(rng=None) -> int:
    """A jittered poll interval inside [POLL_MIN_S, POLL_MAX_S]."""
    r = rng or secrets.SystemRandom()
    return r.randint(POLL_MIN_S, POLL_MAX_S)


def fmt(x: Decimal) -> str:
    """Render an XMR amount for a human.

    str(Decimal) uses scientific notation for a quantized zero -- a balance of
    nothing printed as "0E-12 XMR", which reads as a malfunction to someone
    watching a payment they are anxious about. Fixed-point always, and trailing
    zeros trimmed so 3.000000000000 shows as 3.
    """
    s = f"{x:f}"
    if "." in s:
        s = s.rstrip("0").rstrip(".")
    return s or "0"


def progress_line(unlocked: Decimal, total: Decimal, floor_: Decimal) -> str:
    """One human line: what has landed, what is still locked, how far to go."""
    pending = total - unlocked
    if pending < 0:
        pending = Decimal(0)
    bits = [f"unlocked {fmt(unlocked)} XMR"]
    if pending > 0:
        bits.append(f"{fmt(pending)} still confirming")
    if floor_ > 0:
        remain = floor_ - unlocked
        if remain > 0:
            pct = (unlocked / floor_ * 100) if floor_ > 0 else Decimal(0)
            bits.append(f"{fmt(remain)} to go ({pct.quantize(Decimal('0.1'))}%)")
        else:
            bits.append("target reached")
    return " · ".join(bits)


