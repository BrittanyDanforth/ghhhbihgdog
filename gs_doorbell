def read_job_from_stdin(stream=None) -> tuple:
    """Read one JSON object from stdin and validate it against JOBS.

    Validated HERE, before anything is woken, so a typo costs nothing. The
    vault validates it again on arrival -- this side's check is a courtesy to
    the operator, the vault's is the security boundary, and neither trusts the
    other.
    """
    raw = (stream or sys.stdin).read()
    if not raw.strip():
        raise Doorbell(
            'no job on stdin. Pipe one in, e.g.\n'
            '    echo \'{"job":"receive_and_quote","amount_slot":2}\' | '
            'gs_doorbell wake --key /etc/gs_wake_pi.key')
    body = proto.parse_body(raw.encode() if isinstance(raw, str) else raw)
    job = body.get("job")
    if not isinstance(job, str) or job not in proto.JOBS:
        raise Doorbell(
            f"no such job. This doorbell can ask for: "
            f"{', '.join(sorted(proto.JOBS))}. It cannot ask for anything that "
            f"spends — the mix needs the spend USB and a person.")
    spec = proto.JOBS[job]
    got = set(body) - {"job"}
    want = set(spec["schema"])
    if got != want:
        raise Doorbell(
            f"{job} takes exactly {sorted(want) or 'no parameters'}; got "
            f"{sorted(got) or 'none'}.")
    params = {}
    for k, check in spec["schema"].items():
        try:
            params[k] = check(body[k])
        except proto.WakeError as e:
            raise Doorbell(f"{job} parameter {k!r}: {e}") from None
    return job, params


def build_cli() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description="Wake the vault and hand it one job (Raspberry Pi side).")
    sub = ap.add_subparsers(dest="cmd", required=True)
    w = sub.add_parser("wake", help="read one job from stdin, wake, hand over")
    w.add_argument("--key", required=True, help="the Pi keyfile (0400)")
    w.add_argument("--no-jitter", action="store_true",
                   help="skip the pre-WOL delay. The vault still applies its "
                        "own mandatory 5-20 min jitter; this only removes the "
                        "decorrelation between your poke and the power spike.")
    # Deliberately NO --job / --amount / --count flags: the job is read from
    # stdin so it never lands in /proc/<pid>/cmdline. tests/test_cli_flags.py
    # asserts these flags do not exist. There is NO --passphrase either, for
    # the same reason and more so.
    p = sub.add_parser("pair", help="generate this Pi's key and pair with the "
                                    "vault (run this second)")
    p.add_argument("vault", help="the ThinkPad's LAN address, as gs_wake_keys "
                                 "printed it")
    p.add_argument("--pair-port", type=int, default=PAIR_PORT,
                   help=f"the port the vault is waiting on (default: "
                        f"{PAIR_PORT})")
    p.add_argument("--key", default="/etc/gs_wake_pi.key",
                   help="where to write this Pi's sealed keyfile")
    p.add_argument("--port", type=int, default=0,
                   help="the port this doorbell will answer wakes on. Default "
                        "0 = pick a random high port, so no two installs of "
                        "this public repository share one.")
    p.add_argument("--kdf", default=proto.DEFAULT_KDF,
                   choices=sorted(proto.KDF_PROFILES),
                   help=f"passphrase hardening for the keyfile (default: "
                        f"{proto.DEFAULT_KDF}). 'moderate' needs "
                        f"{proto.KDF_PROFILES['moderate'][1] // 2**20} MiB of "
                        f"RAM every time this Pi is poked; 'interactive' needs "
                        f"{proto.KDF_PROFILES['interactive'][1] // 2**20} MiB "
                        f"and is weaker. The choice is recorded in the file.")
    return ap


# ---------------------------------------------------------------------------
#  Pairing, from this side
# ---------------------------------------------------------------------------
#: The vault's ceremony port. Open for one connection, once, ever.
PAIR_PORT = 8769
#: The doorbell's own port is drawn from here at pairing time. A fixed default
#: in a PUBLIC repository is a fingerprint: anyone who reads this file knows to
#: look at that port, and finding it open on a home LAN identifies the setup.
#: Randomising it does not make the doorbell secure -- Kerckhoffs, the design
#: is published -- it makes one install look unlike the next.
PORT_LO, PORT_HI = 20001, 60000
#: Or four whitespace-separated words. Was 8, which against Argon2id at 256 MiB
#: and an attacker holding the SD card is not enough for anything a person
#: invents. See new_passphrase for why this is a floor and not a measure.
MIN_PASSPHRASE = 16


def ask_match(sas: str, reader=None) -> bool:
    """Show the code and get a real answer. The security of the whole exchange.

    Deliberately NOT defaulting to yes on a bare Enter. This is the one place
    a human decision is load-bearing, and a prompt that treats "operator hit
    return without reading" as consent has thrown that decision away.
    """
    bar = "=" * 46
    print()
    print(f"  {bar}")
    print(f"     PAIRING CODE      {sas}")
    print(f"  {bar}")
    print()
    print("  The ThinkPad is showing a code too. They must match EXACTLY.")
    print("  If they do not, something on your network answered instead of")
    print("  the ThinkPad. Answer n, and take everything you do not own off")
    print("  the switch before trying again.")
    print()
    fn = reader or input
    while True:
        try:
            a = fn("  Do the two codes match? (yes/no) ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return False
        if a in ("yes", "y"):
            return True
        if a in ("no", "n"):
            return False
        print("  Type yes or no.")


def new_passphrase(getter=None) -> bytes:
    """Ask twice, refuse an empty one, refuse a mismatch.

    NO STRENGTH METER and no rules about symbols. What actually decides whether
    this passphrase survives an imaged SD card is its entropy and the Argon2id
    parameters, and a rule that says 'must contain a digit' produces
    Password1 -- which is worse than the four random words this asks for.

    THE FLOOR IS A FLOOR, NOT A MEASURE, and this says so where the operator
    reads it. It was eight characters, which against Argon2id at 256 MiB and an
    attacker holding the card is not enough for anything a person invents.
    Four words or sixteen characters is still not a guarantee; it is the point
    below which this refuses to pretend.
    """
    import getpass
    fn = getter or getpass.getpass
    print()
    print("  This passphrase seals the Pi's keyfile. It is asked for again")
    print("  every time you poke the doorbell, so it has to be one you can")
    print("  type. Four or five random words beat any amount of punctuation.")
    print()
    print("  If you lose it the keyfile is gone and you re-pair both boxes.")
    print("  There is no recovery and nothing here can help you: that is what")
    print("  it means for a file to be sealed.")
    print()
    while True:
        try:
            a = fn("  New passphrase: ")
        except Exception as e:                               # noqa: BLE001
            # No terminal. Say the way out rather than letting an EOF traceback
            # be the operator's first news.
            raise Doorbell(
                f"cannot ask for a passphrase: this box has no terminal "
                f"({type(e).__name__}). Pairing needs one -- run it over SSH "
                f"rather than from a script.") from e
        if len(a.split()) < 4 and len(a) < MIN_PASSPHRASE:
            print(f"  [!] Too short. Give four or more words, or at least")
            print(f"      {MIN_PASSPHRASE} characters. Against Argon2id and "
                  f"somebody")
            print("      holding your SD card, anything less is not a")
            print("      passphrase, it is a delay.")
            print("      This is a FLOOR, not a measure: four words you chose")
            print("      because they were easy to remember are weaker than")
            print("      four a dice roll chose for you, and nothing here can")
            print("      tell the difference.")
            continue
        b = fn("  Again: ")
        if a != b:
            print("  [!] They do not match. Again.")
            continue
        return a.encode()


def do_pair(args, connect=None, ask=None, getpass_fn=None, rng=None) -> int:
    import nacl.public
    import random as _random

    keypath = Path(args.key)
    if keypath.exists():
        raise Doorbell(
            f"{keypath} already exists. Refusing to overwrite it: the vault "
            f"holds the matching half, and replacing this one silently breaks "
            f"the pair in a way that looks exactly like a dead switch or a "
            f"hostile WOL. If you really are re-keying, move it aside and "
            f"re-pair BOTH boxes in the same sitting.")
    if not re.match(r"^(\d{1,3}\.){3}\d{1,3}\Z", args.vault):
        # A hostname would mean a DNS lookup on a box whose whole point is that
        # it does not make unexpected lookups, and the vault printed an address.
        raise Doorbell(f"{args.vault!r} is not an IPv4 address. Use the one "
                       f"gs_wake_keys printed on the ThinkPad.")
    if not 1 <= args.pair_port <= 65535:
        raise Doorbell("--pair-port is not a port.")
    r = rng or _random.SystemRandom()
    port = args.port or r.randint(PORT_LO, PORT_HI)
    if not 1 <= port <= 65535:
        raise Doorbell("--port is not a port.")

    sk = nacl.public.PrivateKey.generate()
    my_pub = sk.public_key.encode()

    # THE PASSPHRASE FIRST, BEFORE ANYTHING IS AGREED. It used to be asked for
    # after the ceremony, so a typo, a mismatch or a ctrl-C at the prompt left
    # the ThinkPad holding a keyfile for a pair this box never completed -- and
    # the next attempt then refused on BOTH boxes for reasons that look nothing
    # like "the last one died halfway". Nothing between agreement and the write
    # can now ask a human anything.
    pw = new_passphrase(getpass_fn)

    print("  [*] This Pi's wake keypair is generated. It stays on this SD")
    print("      card; only the public half will cross the LAN.")
    print(f"  [*] Connecting to the ThinkPad at {args.vault}:{args.pair_port}...")
    if connect is not None:
        sock = connect()
    else:
        try:
            sock = socket.create_connection((args.vault, args.pair_port),
                                            timeout=proto.PAIR_TIMEOUT_S)
        except OSError as e:
            raise Doorbell(
                f"cannot reach the ThinkPad at {args.vault}:{args.pair_port} "
                f"({e.strerror}). Is `gs_wake_keys pair` running over there, "
                f"and are both boxes on the same switch? Nothing was "
                f"written.") from e
    # THIS PI'S OWN ADDRESS, AS THE VAULT WILL SEE IT. Taken from the socket
    # rather than asked for: an operator-typed listen address that is right for
    # this box but wrong for the route is a doorbell that binds fine and is
    # never reachable.
    my_host = sock.getsockname()[0]
    try:
        agreed = proto.pair_initiator(
            sock, sk, my_pub, {"host": my_host, "port": port},
            ask or ask_match, print)
    finally:
        try:
            sock.close()
        except OSError:
            pass

    info = agreed["peer_info"]
    if "mac" not in info or "broadcast" not in info:
        raise Doorbell("the ThinkPad did not send the MAC to wake. Nothing "
                       "was written.")

    payload = {
        "role": "pi",
        "secret": sk.encode().hex(),
        "peer_public": agreed["peer_public"],
        "pair_fingerprint": agreed["sas"],
        "listen_host": my_host,
        "listen_port": int(port),
        "target_mac": info["mac"],
        "wol_broadcast": info["broadcast"],
        "wol_port": 9,
    }
    print()
    print(f"  [*] Sealing the keyfile ({args.kdf}). This is deliberately slow.")
    t0 = time.monotonic()
    try:
        container = proto.lock_keyfile(payload, pw, kdf=args.kdf, role="pi")
    except proto.WakeError as e:
        raise Doorbell(str(e)) from e
    took = time.monotonic() - t0

    keypath.parent.mkdir(parents=True, exist_ok=True)
    tmp = keypath.with_suffix(keypath.suffix + ".tmp")
    # 0400 BEFORE any content is in the file, not after. A world-readable
    # window while the bytes are being written is a window.
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o400)
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(container, fh, sort_keys=True)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, keypath)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        print()
        print("  [!] The pairing succeeded and this Pi then FAILED TO WRITE")
        print(f"      {keypath}. The ThinkPad has already written its own.")
        print("      Delete the ThinkPad's keyfile before pairing again, or")
        print("      the two boxes will hold halves of different pairs and")
        print("      every wake will fail in a way that looks like a network")
        print("      fault:")
        print("          shred -u /etc/gs_wake_thinkpad.key    # on the vault")
        raise

    print(f"      Took {took:.1f} s ON THIS BOX with --kdf {args.kdf}. Every")
    print(f"      poke pays that again: each poke is a fresh process and has")
    print(f"      to re-derive the key from your passphrase.")
    if args.kdf != "interactive":
        # ONLY OFFER A CHEAPER PROFILE THAT IS ACTUALLY CHEAPER. The first
        # version printed "re-pair with --kdf interactive" unconditionally, so
        # an operator who had already chosen interactive was told to go and do
        # the thing they had just done -- advice that reads as a malfunction
        # and teaches them to stop reading the output.
        print(f"      If that is too slow to live with, re-pair with")
        print(f"      --kdf interactive: "
              f"{proto.KDF_PROFILES['interactive'][1] // 2**20} MiB instead of "
              f"{proto.KDF_PROFILES[args.kdf][1] // 2**20} MiB and fewer")
        print(f"      passes, so a stolen SD card is cheaper to attack.")
    else:
        print(f"      This is the WEAKER of the two profiles. --kdf moderate")
        print(f"      costs more time per poke and more to attack.")
    print()
    print(f"  [+] Paired. Code {agreed['sas']}.")
    print(f"      This Pi : {keypath}  (0400, SEALED)")
    print(f"      Answers wakes on {my_host}:{port}")
    print()
    print("  An imaged SD card now yields the KDF parameters and a salt.")
    print("  Not the key, not the ThinkPad's MAC, not your LAN layout.")
    print()
    print("  Poke it like this - the job goes in on a pipe, the passphrase is")
    print("  asked for on the terminal, and neither is ever on a command line:")
    print()
    print(f"      echo '{{\"job\":\"receive_and_quote\",\"amount_slot\":2}}' | \\")
    print(f"          python3 gs_doorbell wake --key {keypath}")
    return 0


def run_wake(args, key: dict, job: str, params: dict,
             server_factory=None, sock_factory=None, sleep=time.sleep,
             clock=time.monotonic, rng=None) -> Pending:
    pending = Pending(key, job, params, clock=clock)

    # BIND BEFORE THE MAGIC PACKET. Never wake a machine you have not already
    # proven you can answer: a vault that boots, finds nobody listening and
    # shuts down has burned a boot and told the operator nothing useful.
    factory = server_factory or (
        lambda addr, handler: ThreadingHTTPServer(addr, handler))
    try:
        srv = factory((key["listen_host"], int(key["listen_port"])),
                      make_handler(pending))
    except OSError as e:
        raise Doorbell(
            f"cannot listen on {key['listen_host']}:{key['listen_port']} "
            f"({e.strerror}). NOT sending the magic packet: waking the vault "
            f"with nowhere to collect the job wastes a boot and leaves it "
            f"powered on until its deadman fires.") from e

    import threading
    t = threading.Thread(target=srv.serve_forever, daemon=True)
    t.start()
    try:
        if not args.no_jitter:
            r = rng or random.SystemRandom()
            delay = r.randint(0, PRE_WOL_MAX_S)
            pending.events.append(f"pre_wol_delay:{delay}s")
            print(f"  [*] Waiting {delay // 60}m {delay % 60}s before the "
                  f"magic packet, so the poke and the power spike are not the "
                  f"same instant.")
            sleep(delay)
        sent = send_wol(key["target_mac"], key.get("wol_broadcast",
                                                   "255.255.255.255"),
                        int(key.get("wol_port", 9)), sock_factory=sock_factory)
        # THE WINDOW STARTS HERE, not when Pending was constructed: everything
        # above this line happened with the vault powered off. See Pending.arm.
        pending.arm()
        pending.events.append("wake_sent")
        print(f"  [+] Magic packet sent ({sent} bytes). Waiting up to "
              f"{FETCH_WINDOW_S // 60} min for the vault to collect job "
              f"{job}.")
        # Poll the state machine rather than sleeping a fixed span, so a job
        # that finishes early releases the socket early.
        while not pending.finished():
            sleep(1)
    finally:
        try:
            srv.shutdown()
        except Exception:                                    # noqa: BLE001
            pass
        try:
            srv.server_close()
        except Exception:                                    # noqa: BLE001
            pass
    return pending


def _report_events(pending: Pending) -> None:
    """Print the events that mean something happened on the switch.

    `events` was collected and never read by anything -- the same defect as a
    declared-but-uncalled constant, and worse here, because the one event that
    means "your job did not go where you think" was among the ones being
    thrown away.
    """
    second = pending.events.count("m1_second_ephemeral")
    if second:
        print(f"  [!] {second} further AUTHENTICATED wake note(s) arrived from "
              f"a different boot after this job was handed over.")
        print(f"      Only something holding the vault's key can produce one. "
              f"Either the vault booted twice, or a note captured on the LAN "
              f"was replayed — in which case the job went to a boot that "
              f"cannot read it, and nothing ran.")
        print(f"      The vault refuses a repeated job id on its own ledger, "
              f"so this cannot have run the job twice. CHECK THE VAULT.")
    bad = pending.events.count("result_bad")
    if bad:
        # Deliberately NOT called hostile. Any host on the LAN can post 296
        # bytes of noise here and land in this count.
        print(f"  [*] {bad} record(s) posted to /result did not authenticate "
              f"and were discarded.")
    refused = pending.events.count("result_refused")
    if refused:
        # A DIFFERENT FACT, and it used to share the line above. These DID
        # authenticate, so only something holding the vault's key sent them.
        print(f"  [!] {refused} result(s) authenticated and were then refused: "
              f"a second answer for a job already reported, an answer naming "
              f"another job, or a status this protocol has no word for.")
        print(f"      That is the vault contradicting itself, not a stranger "
              f"on the switch. CHECK THE VAULT.")


def report(pending: Pending) -> int:
    _report_events(pending)
    out = pending.outcome()
    if out == "done":
        h = pending.result.get("handle") or "(none)"
        print(f"  [+] Vault finished job {pending.job}. Handle {h}.")
        slip = pending.result.get("slip") or ""
        if not slip:
            print(f"      The deposit address, the memo and the slip stayed on "
                  f"the vault. Read them there — never from a chat window.")
            return 0
        # SEALED, AND THIS BOX CANNOT READ IT. Printing it here is not a leak:
        # it is the same ciphertext the pager relays, and this terminal is the
        # Pi's, which already knows a job ran and what its handle was.
        print(f"      A SEALED SLIP came back with it. This box has no key for "
              f"it and never will.")
        print(f"      Open it with gs_unseal on the machine that holds "
              f"gs_delivery.key — the one you send the BTC from.")
        print(f"")
        print(slip)
        print(f"")
        return 0
    if out == "refused":
        print(f"  [!] Vault REFUSED job {pending.job}. It did not say why, "
              f"deliberately — the reason is on the vault's terminal.")
        return 1
    if out == "failed":
        print(f"  [!] Vault ran job {pending.job} and it FAILED. The reason is "
              f"on the vault.")
        return 1
    if out == "expired_uncollected":
        print(f"  [!] Nothing collected job {pending.job} within "
              f"{FETCH_WINDOW_S // 60} min.")
        print(f"      The vault may be off, unreachable, without Tor, or "
              f"refusing before it ever asks. Nothing was handed over, so "
              f"poking again is safe.")
        return 1
    print(f"  [!] Job {pending.job} was collected but the vault never reported "
          f"back within {pending.result_budget_s // 60} min.")
    print(f"      It may have finished and powered off before answering. "
          f"CHECK THE VAULT before poking again: this job may already be done.")
    return 1


def main(argv=None):
    args = build_cli().parse_args(argv)
    try:
        proto.require_nacl()
    except proto.WakeError as e:
        sys.exit(f"[!] {e}")
    if args.cmd == "pair":
        try:
            return do_pair(args)
        except (Doorbell, proto.WakeError) as e:
            sys.exit(f"[!] {e}")
    try:
        # THE JOB FIRST, THE KEY SECOND. Reading the job before spending two
        # seconds on Argon2id means a typo costs the operator nothing, and it
        # means a wrong passphrase is not the first thing they find out about a
        # job that was malformed anyway.
        job, params = read_job_from_stdin()
        key = load_key(Path(args.key))
    except (Doorbell, proto.WakeError) as e:
        sys.exit(f"[!] {e}")
    try:
        pending = run_wake(args, key, job, params)
    except (Doorbell, proto.WakeError) as e:
        sys.exit(f"[!] {e}")
    return report(pending)


if __name__ == "__main__":
    sys.exit(main())
