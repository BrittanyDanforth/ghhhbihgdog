#!/usr/bin/env python3
"""gs_doorbell - the Pi half. Wake the vault, hand it ONE job, hear back, exit.

Runs on the Raspberry Pi that OPSEC_SETUP.md §3 defines by what it must never
hold: spend key, view key, wallet_*.json, thor_pairs.json, memo, seed.

    echo '{"job":"receive_and_quote","amount_slot":2}' | \
        gs_doorbell wake --key /etc/gs_wake_pi.key

ONE POKE IS ONE PROCESS, and there is no daemon.

The obvious design is a long-running service holding a job queue. This is not
that, deliberately. A daemon listens 24/7 on the LAN, which is the thing the
whole feature exists to stop doing -- it just moves the always-on socket from
the vault to the doorbell. Here the Pi hums 24/7 and LISTENS only inside a
window it opened on purpose, seconds before it wakes anything. Three properties
fall out for free rather than being maintained:

  * queue depth is exactly one, because a process holds one job;
  * nothing is persisted, because there is nowhere to persist it to -- the
    pending job, the response cache and the timers are process memory, and the
    keyfile is the only file this program ever touches. tests assert the
    working directory is byte-identical after a full cycle;
  * a crashed doorbell leaves no state to be stale.

The trigger INTO the Pi is gs_telegram_pager, and it pokes this program the
same way a terminal does. This paragraph used to say the trigger was "still out
of scope" and that "the one acceptable remote trigger is inbound over Tor to a
Pi onion service"; both were true when written and neither is now. The pager
long-polls OUTWARD over Tor and listens on nothing, which meets the same
requirement -- no port forward, no WAN path to WOL -- without an onion service.

OPSEC_SETUP.md §8's actual rule is unchanged and still binding: do not "just
run a Telegram bot that prints the memo", because that throws away the only
reason to have a Pi. This program still learns a status and a 4-hex label and
nothing else. It may now also CARRY a sealed slip -- ciphertext for a delivery
key that exists on neither this box nor its SD card -- which is a different
thing from printing a memo, and gs_wake_proto's "THE SEALED SLIP" is where the
difference is argued rather than asserted.

THE JOB COMES IN ON STDIN, NEVER ON argv.
/proc/<pid>/cmdline is mode 0444 and every local account can read it. This repo
has the scar written into gs_common.env_or_argv's docstring -- the wallet
password, then the off-ramp amount, then the BTC entry address. A job carries
an amount SLOT rather than an amount, so the leak would be small; "small" is
how the previous three got shipped.

WHAT THIS PROGRAM MAY NOT IMPORT
gs_common, GhostSpiral, monero, stem, psutil, requests. Not one of them is
needed here, and each is a reason for the next person to reach for it on a box
that is supposed to hold nothing. tests/test_opsec_doc.py asserts the import
list, so §3's "What the Pi must never hold" is a test rather than a paragraph.
"""
from __future__ import annotations

import argparse
import hmac
import json
import os
import random
import re
import socket
import stat
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import gs_wake_proto as proto                                # noqa: E402

MAC_RE = re.compile(r"^([0-9a-f]{2}:){5}[0-9a-f]{2}\Z")

#: How long the vault has to boot, bootstrap Tor and come and collect. Measured
#: on the Pi's own monotonic clock -- it is always on, NTP-synced through
#: Mullvad, and has been up for weeks, so it is the only party here in a
#: position to judge elapsed time. The vault has a flat CMOS battery and
#: knows it.
FETCH_WINDOW_S = 600
#: An additive, best-effort delay before the magic packet, so the poke and the
#: power spike are not the same instant. The vault applies its OWN mandatory
#: 5-20 min jitter after it boots; that one is the floor, because a pwned Pi
#: can zero this one and a pwned Pi must not be able to shorten the vault's.
PRE_WOL_MAX_S = 900


class Doorbell(Exception):
    """Refusal. The message reaches a terminal and the Pi's journal."""


# ---------------------------------------------------------------------------
#  Keyfile
# ---------------------------------------------------------------------------
#: Read from the ENVIRONMENT, never argv. /proc/<pid>/cmdline is mode 0444 and
#: every local account can read it; /proc/<pid>/environ is 0400. This exists so
#: a trigger wrapper can poke the doorbell without a terminal; a human at a
#: terminal gets prompted instead and nothing is stored.
PASSPHRASE_ENV = "GS_WAKE_PASSPHRASE"


def read_passphrase(prompt: str = "  Passphrase for the doorbell key: ",
                    getter=None, env=None) -> bytes:
    """The passphrase, from the environment or the terminal. NEVER from argv.

    getpass reads /dev/tty, not stdin -- which matters here, because stdin is
    already carrying the job. That is why the job goes in on a pipe and the
    passphrase does not: they arrive on two different file descriptors and
    neither can be mistaken for the other.
    """
    src = env if env is not None else os.environ
    v = src.get(PASSPHRASE_ENV)
    if v:
        return v.encode()
    fn = getter
    if fn is None:
        import getpass
        fn = getpass.getpass
    try:
        return fn(prompt).encode()
    except Exception as e:                                   # noqa: BLE001
        # No terminal and no environment variable. Say both ways out rather
        # than leaving a headless trigger to fail with an EOF traceback.
        raise Doorbell(
            f"no passphrase: this box has no terminal to ask on "
            f"({type(e).__name__}) and {PASSPHRASE_ENV} is not set. A trigger "
            f"that pokes the doorbell must set {PASSPHRASE_ENV} in its own "
            f"environment -- not on the command line, which every local "
            f"account can read out of /proc.") from e


def load_key(path: Path, passphrase: bytes = None) -> dict:
    try:
        st = os.stat(path)
    except OSError as e:
        raise Doorbell(
            f"cannot read the doorbell key at {path} ({e.strerror}). Without "
            f"it no note can be authenticated, so nothing is woken.") from e
    if stat.S_IMODE(st.st_mode) & 0o077:
        raise Doorbell(
            f"{path} is group- or world-accessible (mode "
            f"{stat.S_IMODE(st.st_mode):04o}). Refusing to use a wake secret "
            f"anyone on this box can read: chmod 0400 it.")
    try:
        container = json.loads(Path(path).read_text())
    except Exception as e:                                   # noqa: BLE001
        raise Doorbell(f"{path} is not readable JSON ({type(e).__name__})") from e
    # THE PI'S KEYFILE MUST BE SEALED. An SD card leaves the building in a
    # pocket and 0400 means nothing to someone mounting it on their own laptop.
    # This box is poked by somebody who can type, so there is no reason to
    # accept an unsealed one -- and accepting it "just this once" is how every
    # install ends up unsealed.
    if not proto.keyfile_is_sealed(container):
        raise Doorbell(
            f"{path} is not passphrase-sealed. The Pi's keyfile must be: its "
            f"SD card is the one that leaves the building, and mode 0400 is "
            f"nothing to somebody reading the card on their own machine. "
            f"Re-pair with `gs_doorbell pair <vault address>`.")
    if passphrase is None:
        passphrase = read_passphrase()
    try:
        k = proto.unlock_keyfile(container, passphrase)
    except proto.WakeError as e:
        raise Doorbell(str(e)) from e
    if k.get("role") != "pi":
        # The ThinkPad's file carries the ThinkPad's SECRET. Loading it here
        # would put the vault's identity on the doorbell, which is the one
        # thing the two-file split exists to prevent.
        raise Doorbell(
            f"{path} is the {k.get('role')!r} keyfile, not the Pi's. Refusing: "
            f"the other file holds the VAULT's secret and it must never be on "
            f"this box.")
    if not MAC_RE.match(str(k.get("target_mac", ""))):
        raise Doorbell(f"{path} carries no usable target_mac")
    host = str(k.get("listen_host", ""))
    if not host or host in ("0.0.0.0", "::", ""):
        # Never all-interfaces. The doorbell answers on the LAN address the
        # vault was told to ask, and nowhere else -- least of all on wg0, which
        # would put this endpoint on the far side of the Mullvad tunnel.
        raise Doorbell(
            f"{path} must name an exact listen_host; refusing to bind "
            f"{host!r}. Binding all interfaces would expose the doorbell on "
            f"the VPN tunnel as well as the LAN.")
    return k


# ---------------------------------------------------------------------------
#  Wake-on-LAN
# ---------------------------------------------------------------------------
def magic_packet(mac: str) -> bytes:
    """6 x 0xFF then the MAC 16 times. 102 bytes."""
    clean = re.sub(r"[^0-9a-fA-F]", "", mac)
    if len(clean) != 12:
        raise Doorbell(f"MAC must be six bytes, got {len(clean) // 2}")
    return b"\xff" * 6 + bytes.fromhex(clean) * 16


def send_wol(mac: str, broadcast: str, port: int, sock_factory=None) -> int:
    """Send the magic packet. Returns bytes sent.

    WOL IS NOT A LOGIN and this program does not pretend otherwise. Anyone on
    the switch can send one of these; that is why the vault refuses to do
    anything without an authenticated note, and why a random packet gets it
    booted, sat there and shut down again.
    """
    pkt = magic_packet(mac)
    factory = sock_factory or (lambda: socket.socket(socket.AF_INET,
                                                     socket.SOCK_DGRAM))
    s = factory()
    try:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        return s.sendto(pkt, (broadcast, port))
    finally:
        try:
            s.close()
        except Exception:                                    # noqa: BLE001
            pass


# ---------------------------------------------------------------------------
#  The one-job state machine
# ---------------------------------------------------------------------------
class Pending:
    """One job, its single M2, and the windows. Process memory only."""

    def __init__(self, key: dict, job: str, params: dict, clock=time.monotonic):
        self.key = key
        self.job = job
        self.params = params
        self.job_id = proto.new_job_id()
        self.clock = clock
        self.opened = clock()
        self.budget_s = proto.JOBS[job]["budget_s"]
        #: NOT budget_s. The vault sleeps up to VAULT_JITTER_HI_S BEFORE it
        #: starts, and _dispatch spends budget_s PER STEP -- so waiting only
        #: budget_s closed this socket while the job was still legitimately
        #: running. Every job was affected, worst case short by 1200-3000 s.
        #: See proto.result_budget_s for the measured table.
        self.result_budget_s = proto.result_budget_s(job)
        #: (eph_pk, challenge) -> the exact M2 bytes already returned.
        #: THE RETRY AND THE REPLAY ARE THE SAME REQUEST, and answering both
        #: from a cache is what makes this at-most-once without a counter: a
        #: genuine retry from the same boot reuses its ephemeral and gets the
        #: same note back, consuming nothing.
        #:
        #: SAY EXACTLY WHAT THIS COVERS. It is per-PROCESS, and an earlier
        #: version of this comment claimed more than that. Nothing is
        #: persisted, so an M1 captured off the switch during a PREVIOUS wake
        #: is a cache miss here: replayed at a fresh doorbell it authenticates
        #: (both M1 keys are static), misses the cache, and takes the job --
        #: sealing this window's M2 to a dead ephemeral nobody holds the secret
        #: for, and leaving the real vault to meet `m1_second_ephemeral` below.
        #: The job is denied, not disclosed.
        #:
        #: It is left that way ON PURPOSE rather than patched with a
        #: pre-handshake for a window nonce. Capturing an M1 requires sitting
        #: ON the Pi-vault path (mirrored port, ARP spoof); anyone in that
        #: position can simply DROP the packet, so the replay buys them nothing
        #: they did not already have. What it must not do is happen SILENTLY,
        #: which is why `report()` prints the event.
        self._issued = {}
        #: THIS WINDOW, AND ONLY THIS ONE. 32 fresh bytes the vault must echo
        #: in M1, fetched from /window before it seals anything.
        #:
        #: WITHOUT IT ONE CAPTURE BECOMES A PERMANENT REMOTE DoS. The response
        #: cache below makes a replay harmless WITHIN a process, and an earlier
        #: comment reasoned that capturing an M1 requires sitting on the
        #: Pi-vault path, so a replayer could simply drop packets instead and
        #: gains nothing. That reasoning was wrong, and the error is worth
        #: naming: capturing needs the on-path position ONCE. Replaying does
        #: not. Afterwards, any host anywhere on the switch can post that same
        #: M1 the moment a window opens, take the job, and leave the real vault
        #: to boot, be told "no job", and power off -- for every wake, forever,
        #: with the operator reading "somebody sent a stray magic packet".
        #:
        #: An old M1 carries an old window, so it does not open a new one. The
        #: nonce is public and an attacker may fetch it too; it is not a
        #: secret, it is a statement about WHEN.
        self.window = proto.new_window()
        self.collected_at = None
        self.result = None
        self.events = []

    # -- windows ----------------------------------------------------------
    def arm(self) -> None:
        """(Re)start the fetch window, at the moment the vault is told to boot.

        `opened` is set in __init__, but do_wake constructs this and THEN
        sleeps a random 0..PRE_WOL_MAX_S before sending the magic packet. The
        600 s the vault has to collect its job was therefore being spent while
        the vault was still switched off, and a delay over FETCH_WINDOW_S shut
        the window before the packet that opens it was even sent. Measured on
        the shipped constants: the pre-WOL delay alone closes it 33.2% of the
        time, and 46.7% once 120 s of real boot is allowed for.

        The vault then collects nothing, is told 204, and prints its no-job
        line -- "that is what a magic packet from anyone on the switch looks
        like" -- so a third of ordinary pokes looked to the operator like an
        intruder on the LAN rather than a bug here.

        OPSEC_SETUP.md section 5 step 3 already describes the intended order:
        "waits a random 0-15 min, THEN sends the magic packet and holds one job
        for 10 min". This makes the code do what that sentence says.
        """
        self.opened = self.clock()

    def fetch_open(self) -> bool:
        return (self.clock() - self.opened) < FETCH_WINDOW_S

    def result_open(self) -> bool:
        if self.collected_at is None:
            return False
        return (self.clock() - self.collected_at) < self.result_budget_s

    def finished(self) -> bool:
        if self.result is not None:
            return True
        if self.collected_at is None:
            return not self.fetch_open()
        return not self.result_open()

    def outcome(self) -> str:
        if self.result is not None:
            return self.result.get("status", "unknown")
        if self.collected_at is None:
            return "expired_uncollected"
        return "collected_no_result"

    # -- messages ---------------------------------------------------------
    def on_m1(self, record: bytes) -> bytes:
        """Authenticated M1 in, M2 out. Raises Doorbell to answer 204."""
        import nacl.public
        pi_sk = nacl.public.PrivateKey(bytes.fromhex(self.key["secret"]))
        tp_pk = nacl.public.PublicKey(bytes.fromhex(self.key["peer_public"]))
        body = proto.open_record(pi_sk, tp_pk, record, proto.TAG_M1)
        eph = proto.eph_pk_of(body)
        chal = proto.challenge_of(body)
        # A MISSING window FIELD IS AN OLD BUILD, NOT A STRANGER.
        #
        # window_of raises WakeError when the field is absent, and that raise
        # used to happen BEFORE any events.append, so do_POST answered 204 with
        # nothing recorded and the agent printed its no-job line: "that is what
        # a magic packet from anyone on the switch looks like". A half-upgraded
        # pair therefore booted the vault, powered it off, and sent the
        # operator hunting for an intruder on their own LAN. The per-window
        # nonce was added without bumping PAIR_PROTO, so this is OUR wire
        # break, and it has to name itself.
        try:
            _window = proto.window_of(body)
        except proto.WakeError:
            self.events.append("m1_no_window_field")
            raise Doorbell(
                "that note has no wake window in it, which means the box that "
                "sent it is running a build older than the per-window nonce "
                "-- update BOTH boxes and pair again")
        # compare_digest, and BEFORE the cache: a record for another window is
        # not a retry of anything, it is a record from another window.
        if not hmac.compare_digest(_window, self.window):
            self.events.append("m1_stale_window")
            raise Doorbell("that note was written for a different wake window")
        cached = self._issued.get((eph, chal))
        if cached is not None:
            self.events.append("m1_retry")
            return cached
        if not self.fetch_open():
            raise Doorbell("fetch window closed")
        if self._issued:
            # A DIFFERENT authenticated ephemeral after one was already served.
            # Queue depth is one: the second boot gets nothing rather than a
            # second copy of the job.
            self.events.append("m1_second_ephemeral")
            raise Doorbell("job already handed over to a different boot")
        m2 = proto.seal(
            pi_sk, nacl.public.PublicKey(eph), proto.TAG_M2,
            {"job_id": self.job_id, "challenge": chal.hex(),
             "job": self.job, **self.params})
        self._issued[(eph, chal)] = m2
        self.collected_at = self.clock()
        self.events.append("job_collected")
        return m2

    def on_m3(self, record: bytes) -> None:
        import nacl.public
        pi_sk = nacl.public.PrivateKey(bytes.fromhex(self.key["secret"]))
        tp_pk = nacl.public.PublicKey(bytes.fromhex(self.key["peer_public"]))
        body = proto.open_record(pi_sk, tp_pk, record, proto.TAG_M3)
        # AT MOST ONE RESULT, and this was missing. Driven over a real socket:
        # a second M3 was accepted and OVERWROTE the first, so the outcome the
        # operator is shown depended on which note arrived last. Only something
        # holding the vault's key can send one at all, so this is not an
        # attacker path -- it is a buggy or double-booted vault making the
        # doorbell's report nondeterministic, which is the same class of defect
        # as a message that contradicts what happened.
        if self.result is not None:
            raise Doorbell("this job already reported a result")
        if proto.job_id_of(body) != self.job_id:
            raise Doorbell("result names a different job")
        status = body.get("status")
        if status not in ("done", "refused", "failed"):
            raise Doorbell("result carries no usable status")
        handle = body.get("handle", "")
        if not isinstance(handle, str):
            raise Doorbell("result handle is not a string")
        # A 95-character "handle" is an address wearing a hat.
        #
        # THIS USED TO BE THE SECOND OF TWO DEFENCES AND IT IS NOW THE ONLY
        # ONE. The comment here said the wire format already refused a long
        # handle because an M3 that size would not fit the single padded
        # block -- true when PAD_BLOCK was 256 and MAX_INNER 255. PAD_BLOCK is
        # 1024 now (gs_wake_proto, "THE SEALED SLIP"), and a 95-character
        # handle fits an M3 with room to spare. The backstop the sentence was
        # counting on is gone, so this check is load-bearing on its own.
        #
        # EMPTY IS ONLY LEGAL WHEN THERE IS NOTHING TO NAME. The first version
        # read `if handle and not HANDLE_RE.match(...)`, so an empty string
        # skipped the check entirely and a "done" with no handle was recorded
        # as success the operator could not act on -- they are told the job
        # finished and given nothing to look up. Refused and failed jobs
        # genuinely have no handle, so those may be empty and only those.
        if status == "done":
            if not proto.HANDLE_RE.match(handle):
                raise Doorbell("a completed job must name its 4-character "
                               "handle; without one the operator is told it "
                               "worked and given nothing to find")
        elif handle and not proto.HANDLE_RE.match(handle):
            raise Doorbell("result handle is not a 4-character label")
        # THE SEALED SLIP, WHICH THIS BOX CANNOT READ AND MUST NOT TRY TO.
        #
        # The Pi has no delivery key -- that is the whole design -- so the only
        # honest check available here is SHAPE, and shape is checked strictly
        # rather than waved through: exactly SLIP_B64_LEN characters that
        # base64-decode to exactly one padded box. Anything else is refused
        # outright instead of being relayed onward, because the operator's next
        # move after receiving a slip is to send Bitcoin, and a mangled blob
        # must fail HERE, on the vault's own channel, and not later in a chat
        # window where the failure looks like the vault's fault.
        #
        # A blob of the right shape is still opaque: it is carried, logged as
        # present, and never parsed. gs_doorbell holds no key that opens it.
        slip = body.get("slip", "")
        # A TYPE CHECK BEFORE THE TRUTHINESS ONE. `if slip and not
        # wellformed(slip)` reads as a complete gate and is not: 0, [] and {}
        # are all falsy, so each would skip validation entirely and be stored
        # as this job's slip. Nothing downstream would crash -- the pager does
        # `res.get("slip") or ""` -- which is exactly what makes it worth
        # closing here rather than discovering it as a silently missing slip.
        if not isinstance(slip, str):
            raise Doorbell("result's slip field is not text")
        if slip and not proto.slip_is_wellformed(slip):
            raise Doorbell("result carries something in the slip field that is "
                           "not a sealed slip")
        if slip and status != "done":
            # A refused or failed job has nothing to deliver. A slip attached
            # to one is the vault contradicting itself.
            raise Doorbell("a job that did not finish cannot carry a slip")
        self.result = {"status": status, "handle": handle, "slip": slip}
        self.events.append("result_ok")
        if slip:
            self.events.append("slip_carried")


def make_handler(pending: Pending):
    class H(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        #: socketserver applies this to the accepted socket. WITHOUT IT any LAN
        #: host can open a connection, send nothing, and hold a thread for the
        #: whole ten-minute wake window -- and ThreadingHTTPServer starts a
        #: thread per connection, on a Pi with 1 GB of RAM and Tor resident.
        #: The real vault sends its one RECORD_LEN-byte record immediately.
        timeout = 20

        #: EMPTY, deliberately. BaseHTTPRequestHandler's default is
        #: "BaseHTTP/0.6 Python/3.11.15", which it puts in a Server: header on
        #: every response -- naming the software, the language and the minor
        #: version of the box that is supposed to hold nothing. The wake port
        #: is randomised at pairing so that one install does not look like the
        #: next; a banner that says "this is a Python BaseHTTPServer" hands
        #: that back, and the version dates the SD image.
        server_version = ""
        sys_version = ""

        def version_string(self):
            return ""

        def send_error(self, code, message=None, explain=None):
            """The SAME minimal reply as _reply, for the paths we do not own.

            _reply covers the four responses this handler writes itself, but
            anything BaseHTTPRequestHandler rejects before dispatch -- an
            unsupported method, a too-long request line, a bad HTTP version --
            goes through send_error -> send_response, which emits Server: AND
            Date: anyway. Measured against the running handler:

                PUT /wake HTTP/1.1  -> 501, Server: , Date: Sat, 22 Aug 2026 ...
                GET /<70000 a's>    -> 414, Server: , Date: Sat, 22 Aug 2026 ...

            So the wall clock the comment in _reply says was closed was still
            one malformed request away. Two smaller costs went with it: the
            stock HTML error page ('<title>Error response</title>',
            'Bad request syntax or unsupported method') fingerprints
            http.server as well as the banner did, and an EMPTY 'Server: ' is
            more distinctive than the stock one -- it marks the box as
            deliberately stripped. send_response_only emits neither header at
            all, and no body, which is what a box holding nothing should say.
            """
            try:
                self.send_response_only(code, message)
                self.send_header("Content-Length", "0")
                self.send_header("Connection", "close")
                self.end_headers()
            except Exception:                                # noqa: BLE001
                pass
            self.close_connection = True

        def log_message(self, fmt, *a):                      # noqa: A003
            # SILENT, deliberately. The default writes every request to stderr,
            # which systemd puts in the journal, which lands on the SD card --
            # timestamping every wake, with the vault's address, on the one box
            # that is meant to hold nothing.
            return

        def _reply(self, code, body=b""):
            # send_response_only, NOT send_response: the latter also emits
            # Server: and Date:. Date: is the Pi's wall clock, to the second,
            # handed to anyone who connects -- and this Pi is the only box here
            # with a correct clock, so it is the one whose clock is worth
            # correlating against a Tor circuit or a Bitcoin timestamp.
            self.send_response_only(code)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Content-Type", "application/octet-stream")
            # Answer one request per connection. HTTP/1.1 keep-alive would
            # otherwise let a client hold the socket open for the whole window
            # by simply not sending anything more, and the vault has exactly
            # two requests to make, on its own terms.
            self.send_header("Connection", "close")
            self.close_connection = True
            self.end_headers()
            if body:
                self.wfile.write(body)

        def _read(self):
            try:
                n = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                return None
            # Every record is exactly RECORD_LEN. Anything else is refused
            # before it is read, so a flood never reaches the AEAD.
            if n != proto.RECORD_LEN:
                return None
            return self.rfile.read(n)

        def do_POST(self):                                   # noqa: N802
            if self.path == "/window":
                # Unauthenticated by necessity: the vault must have this
                # BEFORE it can seal anything. It is 32 random bytes and a
                # statement that a window is open right now -- which the open
                # port already says.
                return self._reply(200, pending.window)
            if self.path == "/wake":
                rec = self._read()
                if rec is None:
                    return self._reply(400)
                try:
                    return self._reply(200, pending.on_m1(rec))
                except (proto.WakeError, Doorbell):
                    # 204 for every refusal, so a prober cannot tell "no job"
                    # from "bad note" from "window closed" by status code.
                    return self._reply(204)
            if self.path == "/result":
                rec = self._read()
                if rec is None:
                    return self._reply(400)
                try:
                    pending.on_m3(rec)
                    return self._reply(200)
                except proto.WakeError:
                    # Did not decrypt, did not authenticate, or did not parse.
                    pending.events.append("result_bad")
                    return self._reply(204)
                except Doorbell:
                    # AUTHENTICATED AND THEN REFUSED, which is a different
                    # fact: a duplicate result, a result naming another job, a
                    # status this protocol has no word for. Reporting these as
                    # "did not authenticate" would tell the operator a LAN
                    # host was posting noise when what happened is that the
                    # vault sent two answers. Same 204 on the wire either way,
                    # deliberately -- a prober must not learn which it hit.
                    pending.events.append("result_refused")
                    return self._reply(204)
            self._reply(404)

        def do_GET(self):                                    # noqa: N802
            # Nothing is readable without an authenticated record, and nothing
            # this program knows goes in a URL.
            self._reply(405)

    return H


