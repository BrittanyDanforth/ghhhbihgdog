def _init_tor_proxy():
    """Initialize Tor proxy. Called at runtime, not import time.

    Module-level proxy setup prevented --help from working without Tor
    (the verify_tor call would hang on network timeout). Deferring to
    runtime means the module can be imported and inspected freely.
    """
    global proxies, _tor_socks_port
    if not TOR_AVAILABLE:
        logger.critical("Tor (stem) not available — refusing to run over clearnet.")
        sys.exit(1)
    for _candidate_port in (9050, 9150):
        _proxy_url = f'socks5h://127.0.0.1:{_candidate_port}'
        try:
            _test_px = _gs_validate_proxy(_proxy_url)
            _gs_verify_tor(_test_px)
            _tor_socks_port = _candidate_port
            break
        except SystemExit:
            continue
    if _tor_socks_port:
        proxies = {
            'http': f'socks5h://127.0.0.1:{_tor_socks_port}',
            'https': f'socks5h://127.0.0.1:{_tor_socks_port}',
        }
    else:
        logger.critical("Tor not responding on 9050 or 9150. Start Tor first.")
        sys.exit(1)

def _secure_perms(path):
    """Set file to owner-only (0600) to protect collected data."""
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass

