#  Subdomain Enumerator (via crt.sh certificate transparency)
# ══════════════════════════════════════════════════════════════════════════

class SubdomainEnumerator:
    """Enumerate subdomains via certificate transparency logs.

    crt.sh is a free public service that indexes certificate transparency
    logs. It's Tor-friendly and doesn't block automated queries.
    """

    CRTSH_URL = "https://crt.sh/?q={domain}&output=json"

    def __init__(self, session: TorSession):
        self._session = session

    def enumerate(self, domain: str) -> List[str]:
        """Query crt.sh for subdomains of the given domain."""
        url = self.CRTSH_URL.format(domain=quote(f"%.{domain}"))
        resp = self._session.get(url)
        if not resp:
            return []

        subdomains: Set[str] = set()
        try:
            entries = resp.json()
            if not isinstance(entries, list):
                return []
            for entry in entries:
                name = entry.get("name_value", "")
                for line in name.split("\n"):
                    line = line.strip().lower()
                    if line and (line.endswith(f".{domain}") or line == domain):
                        # Remove wildcard prefix
                        line = line.lstrip("*.")
                        if line and re.match(r"^[a-z0-9.\-]+$", line):
                            subdomains.add(line)
        except (ValueError, KeyError):
            pass

        return sorted(subdomains)[:200]


