class HardwareOPSEC:
    """Hardware-level OPSEC features"""
    
    @staticmethod
    def randomize_hostname():
        """Set random hostname per session"""
        if CONFIG['OPSEC']['RANDOM_HOSTNAME']:
            hostname = f"host-{secrets.token_hex(4)}"
            try:
                subprocess.run(['hostname', hostname], check=True)
                logger.info(f"Hostname randomized: {hostname}")
            except:
                pass
    
    @staticmethod
    def randomize_mac():
        """Randomize MAC address"""
        if CONFIG['OPSEC']['RANDOM_MAC']:
            try:
                # Get interfaces
                result = subprocess.run(['ip', 'link'], capture_output=True, text=True)
                interfaces = re.findall(r'^\d+: (\w+):', result.stdout, re.MULTILINE)
                
                for iface in interfaces:
                    if iface not in ['lo', 'docker0']:
                        octets = [secrets.randbelow(256) for _ in range(6)]
                        octets[0] = (octets[0] | 0x02) & 0xFE  # locally administered, unicast
                        mac = ":".join(f"{b:02x}" for b in octets)
                        
                        # Apply MAC
                        subprocess.run(['ip', 'link', 'set', iface, 'down'])
                        subprocess.run(['ip', 'link', 'set', iface, 'address', mac])
                        subprocess.run(['ip', 'link', 'set', iface, 'up'])
                        
                        logger.info(f"MAC randomized for {iface}: {mac}")
            except:
                pass
    
    @staticmethod
    def setup_ram_disk():
        """Ensure RAM disk is available"""
        ram_path = Path("/dev/shm/intel")
        if not ram_path.exists():
            ram_path.mkdir(parents=True, mode=0o700)
        return ram_path
    
    @staticmethod
    def disable_gpu():
        """Disable GPU features"""
        if CONFIG['OPSEC']['DISABLE_GPU']:
            os.environ['LIBGL_ALWAYS_SOFTWARE'] = '1'
            os.environ['GALLIUM_DRIVER'] = 'softpipe'

