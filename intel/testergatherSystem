class DataExtractor:
    """Extract structured data from text with validated patterns."""

    PATTERNS = {
        "email": re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,7}\b"),
        "btc_address": re.compile(r"\b(?:bc1[ac-hj-np-z02-9]{25,59}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})\b"),
        "eth_address": re.compile(r"\b0x[a-fA-F0-9]{40}\b"),
        "xmr_address": re.compile(r"\b[48][0-9AB][1-9A-HJ-NP-Za-km-z]{93}\b"),
        "phone": re.compile(r"(?<![0-9])[\+]?[(]?[0-9]{1,3}[)]?[-\s.]?[(]?[0-9]{1,4}[)]?[-\s.]?[0-9]{3,4}[-\s.]?[0-9]{3,4}(?![0-9])"),
        "onion_v3": re.compile(r"\b[a-z2-7]{56}\.onion\b"),
        "ipv4": re.compile(r"\b(?:(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\b"),
        "tx_hash": re.compile(r"\b0x[a-fA-F0-9]{64}\b"),
        # Social / usernames
        "twitter_handle": re.compile(r"(?:twitter\.com|x\.com)/(@?[A-Za-z0-9_]{1,15})\b"),
        "github_user": re.compile(r"github\.com/([A-Za-z0-9\-]{1,39})(?:/|$)"),
        "linkedin_profile": re.compile(r"linkedin\.com/in/([A-Za-z0-9\-]{3,100})"),
        "reddit_user": re.compile(r"reddit\.com/u(?:ser)?/([A-Za-z0-9_\-]{3,20})"),
        # API keys / secrets
        "aws_key": re.compile(r"\b(AKIA[0-9A-Z]{16})\b"),
        "github_token": re.compile(r"\b(ghp_[A-Za-z0-9]{36})\b"),
        "stripe_key": re.compile(r"\b(sk_live_[A-Za-z0-9]{24,})\b"),
        "jwt_token": re.compile(r"\beyJ[A-Za-z0-9\-_]+\.eyJ[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+\b"),
        "generic_secret": re.compile(r"(?:api[_\-]?key|secret|token|password|passwd|auth)\s*[:=]\s*['\"]([A-Za-z0-9\-_./+=]{16,128})['\"]", re.I),
    }

    @classmethod
    def extract_all(cls, text: str) -> Dict[str, List[str]]:
        if not text:
            return {}
        results = {}
        for name, pattern in cls.PATTERNS.items():
            matches = pattern.findall(text)
            if matches:
                seen: Set[str] = set()
                validated = []
                for m in matches:
                    m = m.strip() if isinstance(m, str) else str(m).strip()
                    if m and m not in seen and cls._validate(name, m):
                        seen.add(m)
                        validated.append(m)
                        if len(validated) >= 50:
                            break
                if validated:
                    results[name] = validated
        return results

    @classmethod
    def extract_urls(cls, html: str, base_url: str) -> List[str]:
        """Extract all URLs from HTML content."""
        if not HAS_BS4 or not html:
            return []
        urls = set()
        try:
            soup = BeautifulSoup(html, "html.parser")
            for tag in soup.find_all(["a", "link", "script", "img", "form"]):
                for attr in ["href", "src", "action"]:
                    val = tag.get(attr)
                    if val and not val.startswith(("#", "javascript:", "data:", "mailto:")):
                        full = urljoin(base_url, val)
                        urls.add(full)
        except Exception as e:
            integrity_log("intel", f"url_extract_error:{type(e).__name__}")
        return list(urls)[:200]

    @classmethod
    def extract_comments(cls, html: str) -> List[str]:
        """Extract HTML comments (often contain secrets/debug info)."""
        if not HAS_BS4 or not html:
            return []
        try:
            soup = BeautifulSoup(html, "html.parser")
            comments = soup.find_all(string=lambda t: isinstance(t, Comment))
            return [c.strip() for c in comments if len(c.strip()) > 10][:50]
        except Exception as e:
            integrity_log("intel", f"comment_extract_error:{type(e).__name__}")
            return []

    @classmethod
    def _validate(cls, ptype: str, val: str) -> bool:
        if ptype == "email":
            parts = val.split("@")
            if len(parts) != 2 or "." not in parts[1] or len(parts[1]) < 4:
                return False
            # Filter common false positives
            if parts[1] in ("example.com", "test.com", "localhost"):
                return False
            return True
        elif ptype == "btc_address":
            return 26 <= len(val) <= 62
        elif ptype == "eth_address":
            return len(val) == 42
        elif ptype == "phone":
            digits = re.sub(r"\D", "", val)
            return 7 <= len(digits) <= 15
        elif ptype == "aws_key":
            return len(val) == 20 and val.startswith("AKIA")
        elif ptype == "github_token":
            return len(val) >= 40
        return True


