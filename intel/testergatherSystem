    @classmethod
    def fingerprint(cls, headers: dict, html: str) -> dict:
        tech = {"server": None, "cms": [], "frameworks": [], "powered_by": None,
                "language": None, "cdn": None}

        # Server header
        server = headers.get("Server", headers.get("server", ""))
        if server:
            tech["server"] = server
            for name, pat in cls.SERVER_PATTERNS.items():
                m = pat.search(server)
                if m:
                    tech["server"] = f"{name} {m.group(1) if m.group(1) else ''}".strip()
                    break

        # X-Powered-By
        powered = headers.get("X-Powered-By", headers.get("x-powered-by", ""))
        if powered:
            tech["powered_by"] = powered
            if "PHP" in powered.upper():
                tech["language"] = f"PHP ({powered})"
            elif "ASP.NET" in powered.upper():
                tech["language"] = f"ASP.NET ({powered})"
            elif "Express" in powered:
                tech["language"] = "Node.js (Express)"

        # CDN detection
        for cdn_header in ["cf-ray", "x-cache", "x-cdn", "x-amz-cf-id"]:
            if cdn_header in {k.lower() for k in headers}:
                if "cf-ray" in {k.lower() for k in headers}:
                    tech["cdn"] = "Cloudflare"
                elif "x-amz-cf-id" in {k.lower() for k in headers}:
                    tech["cdn"] = "AWS CloudFront"
                else:
                    tech["cdn"] = "CDN detected"
                break

        # CMS detection from HTML
        for cms_name, patterns in cls.CMS_PATTERNS.items():
            for pat in patterns:
                if pat.search(html[:50000]):
                    if cms_name not in tech["cms"]:
                        tech["cms"].append(cms_name)
                    break

        # Framework detection from HTML
        for fw_name, pat in cls.FRAMEWORK_PATTERNS.items():
            if pat.search(html[:50000]):
                tech["frameworks"].append(fw_name)

        # Meta generator
        if HAS_BS4:
            try:
                soup = BeautifulSoup(html[:10000], "html.parser")
                gen = soup.find("meta", attrs={"name": "generator"})
                if gen and gen.get("content"):
                    tech["meta_generator"] = gen["content"][:100]
            except Exception as e:
                integrity_log("intel", f"tech_meta_error:{type(e).__name__}")

        return tech


