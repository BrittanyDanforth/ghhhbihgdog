    # What HTTP statuses prove a path EXISTS on this server (not blanket 200).
    # A few specific high-value endpoints (like actuator/env) typically
    # answer 401/403 when protected — still a finding because the
    # endpoint exists and protection is the only thing between the
    # attacker and it.
    _AUTH_WALL_EXISTS = frozenset((
        "/actuator", "/actuator/env", "/actuator/heapdump",
        "/actuator/mappings", "/actuator/trace", "/actuator/httptrace",
        "/actuator/loggers", "/actuator/beans", "/actuator/configprops",
        "/actuator/threaddump", "/actuator/info",
        "/manage", "/jolokia/",
        "/server-status", "/server-info", "/nginx_status", "/stub_status",
        "/elmah.axd", "/trace.axd",
        "/_debugbar/", "/__debug__/",
    ))

    def _check_sensitive_paths(self, base_url: str) -> List[dict]:
        """Probe for exposed sensitive files and directories.

        Two-pass: HEAD first, GET only on promising responses. Soft-404
        and per-path content validation filter out the mountain of false
        positives we'd get from a blind "HTTP 200 = vuln" rule on a
        site that wildcards everything to a SPA shell.
        """
        findings = []
        domain = urlparse(base_url).netloc
        total = len(self.SENSITIVE_PATHS)
        skipped = 0
        hits = 0

        # Soft-404 baseline — hash the 'this path does not exist' body so
        # we can detect template-identical soft-404s even when their
        # length jitters by a few bytes.
        _baseline_url = urljoin(base_url, f"/gs_nonexistent_{secrets.token_hex(4)}")
        _baseline_resp = self._session.get(_baseline_url, allow_wayback=False, method="GET")
        if _baseline_resp and _baseline_resp.status_code == 200 and _baseline_resp.text:
            _baseline_body = _baseline_resp.text
            _soft404_length = len(_baseline_body)
            # Hash the first ~4KB so tiny dynamic bits (timestamps, CSRF
            # tokens) don't ruin the comparison.
            _soft404_head = hashlib.sha256(_baseline_body[:4096].encode("utf-8", "ignore")).hexdigest()
        else:
            _soft404_length = -1
            _soft404_head = None
        _soft404_patterns = re.compile(
            r"not\s*found|page\s*(?:does\s*not|doesn.t)\s*exist|no\s*such\s*page|"
            r"this\s*page\s*could\s*not|we\s*couldn.t\s*find|error\s*404",
            re.I
        )

        def _looks_like_soft_404(body: str) -> bool:
            if not body:
                return False
            if _soft404_length > 0 and abs(len(body) - _soft404_length) < 200:
                # Confirm template match via head hash
                head_hash = hashlib.sha256(body[:4096].encode("utf-8", "ignore")).hexdigest()
                if _soft404_head == head_hash:
                    return True
                # Close in length AND the body says "not found" → soft-404
                if _soft404_patterns.search(body[:1500]):
                    return True
            if _soft404_patterns.search(body[:1500]) and len(body) < 3000:
                return True
            return False

        # Inline progress for a long probe list. Without this the
        # operator stares at a blank terminal for minutes while the
        # scan churns through 90 HEAD requests.
        _last_progress = 0
        for idx, (path, title, severity, detail) in enumerate(self.SENSITIVE_PATHS):
            if shutdown_requested():
                break
            if self._session.is_domain_blocked(domain):
                skipped = total - idx
                break

            # Tick progress every 15 probes.
            if idx - _last_progress >= 15:
                print(f" [{idx}/{total}]", end="", flush=True)
                _last_progress = idx

            url = urljoin(base_url, path)
            resp = self._session.get(url, allow_wayback=False, method="HEAD")
            if not resp:
                continue

            status = resp.status_code
            # "Auth wall exists" is itself a finding for a small set of
            # endpoints where the fact that /actuator/env answers at all
            # (even with 401) means the endpoint is mounted.
            auth_wall_hit = (
                status in (401, 403)
                and path in self._AUTH_WALL_EXISTS
            )
            if status == 200 or auth_wall_hit:
                if auth_wall_hit:
                    findings.append({
                        "severity": severity,
                        "title": f"{title} (auth-walled)",
                        "detail": (f"{detail} — endpoint exists at {path} but "
                                   f"returns HTTP {status}. Test with "
                                   f"default creds / bearer tokens / the "
                                   f"Actuator default port (8081)."),
                        "evidence": f"HTTP {status} at {path}",
                        "path": path,
                        "exploitable": severity in (SEV_CRITICAL, SEV_HIGH),
                        "exploit_info": {
                            "type": "auth_walled_endpoint",
                            "path": path,
                            "method": (f"Endpoint {path} is mounted but "
                                       f"requires auth. Try default creds, "
                                       f"JWT leaks, or direct access "
                                       f"from inside the network."),
                            "risk": "Information disclosure if auth weak",
                        } if severity in (SEV_CRITICAL, SEV_HIGH) else {},
                    })
                    hits += 1
                    continue

                # HTTP 200: verify content to avoid soft-404 false positives.
                resp_full = self._session.get(url, allow_wayback=False)
                if not resp_full or resp_full.status_code != 200:
                    continue
                body = resp_full.text or ""
                if len(body) < 2 and path not in ("/.git/HEAD", "/.env"):
                    continue

                if _looks_like_soft_404(body):
                    continue

                validator = self._PATH_CONTENT_VALIDATORS.get(path)
                if validator is not None:
                    try:
                        if not validator(body):
                            continue
                    except Exception:
                        continue
                elif severity in (SEV_CRITICAL, SEV_HIGH):
                    # No validator + high-severity = be conservative:
                    # require the body NOT be an HTML shell (SPAs serve
                    # the same index.html for every path).
                    low_head = body[:256].lstrip().lower()
                    if low_head.startswith("<!doctype html") or low_head.startswith("<html"):
                        continue

                findings.append({
                    "severity": severity, "title": title,
                    "detail": detail, "evidence": f"HTTP 200 at {path}",
                    "path": path, "content_length": len(body),
                })
                hits += 1

        if skipped:
            print(f"        (skipped {skipped} paths — site is blocking probes)")
        if hits:
            print(f"        (confirmed {hits}/{total - skipped} sensitive path(s))")
        return findings

    def _check_http_methods(self, base_url: str) -> List[dict]:
        """Check for dangerous HTTP methods enabled."""
        findings = []
        domain = urlparse(base_url).netloc
        if self._session.is_domain_blocked(domain):
            return findings

        try:
            opt_resp = self._session.request("OPTIONS", base_url)
            # Servers commonly advertise Allow: from OPTIONS with status
            # 200 OR 204 (No Content). requiring 200 specifically misses
            # every correctly-implemented RFC-7231 server that returns
            # 204. Look at Allow whenever the response exists and the
            # status isn't a hard error.
            if opt_resp and opt_resp.status_code < 400:
                allow = opt_resp.headers.get("Allow", "")
                if allow:
                    dangerous = {"PUT", "DELETE", "TRACE", "PATCH"}
                    allowed = {m.strip().upper() for m in allow.split(",")}
                    found = dangerous & allowed
                    if found:
                        findings.append({
                            "severity": SEV_MEDIUM if "TRACE" not in found else SEV_HIGH,
                            "title": f"Dangerous HTTP methods enabled: {', '.join(sorted(found))}",
                            "detail": "TRACE enables Cross-Site Tracing (XST). "
                                      "PUT/DELETE may allow file manipulation." if "TRACE" in found
                                      else "PUT/DELETE methods may allow unauthorized file modification.",
                            "evidence": f"Allow: {allow}"
                        })
        except Exception as e:
            integrity_log("intel", f"http_methods_error:{type(e).__name__}")
        return findings

    def _check_open_redirect(self, base_url: str) -> List[dict]:
        """Check for open redirect vulnerabilities."""
        findings = []
        evil_target = "https://evil-attacker.com/pwned"
        domain = urlparse(base_url).netloc

        for param in self.REDIRECT_PARAMS[:5]:
            if shutdown_requested():
                break
            if self._session.is_domain_blocked(domain):
                break
            test_url = f"{base_url}?{param}={quote(evil_target)}"
            try:
                resp = self._session.request(
                    "GET", test_url, allow_redirects=False,
                )
                if resp and resp.status_code in (301, 302, 303, 307, 308):
                    location = resp.headers.get("Location", "")
                    # Must check that the redirect HOST is the attacker, not just
                    # that the attacker URL appears somewhere in query params
                    loc_parsed = urlparse(location)
                    if loc_parsed.netloc and "evil-attacker.com" in loc_parsed.netloc:
                        findings.append({
                            "severity": SEV_MEDIUM,
                            "title": f"Open redirect via '{param}' parameter",
                            "detail": "Server redirects to attacker-controlled URL. "
                                      "Usable for phishing and OAuth token theft.",
                            "evidence": f"?{param}={evil_target} → Location: {location[:100]}",
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "open_redirect",
                                "parameter": param,
                                "method": f"Redirect users via '{param}' parameter to phishing page. "
                                          "Chain with OAuth flows to steal authorization codes.",
                                "risk": "Phishing, OAuth token theft, trust exploitation",
                            },
                        })
                        break  # One is enough to confirm
            except Exception as e:
                integrity_log("intel", f"_check_open_redirect_error:{type(e).__name__}")
        return findings

    def _check_sqli_indicators(self, base_url: str) -> List[dict]:
        """Detect SQL injection indicators via error-based detection with baseline comparison.

        Sends a clean request first, then an apostrophe-injected request. Only flags as SQLi
        if the SQL error pattern appears ONLY in the injected response (not the baseline),
        which eliminates false positives from generic error pages or debug-mode sites that
        always show SQL traces.

        Also tries a broader payload set for the same parameter —
        apostrophe, double-quote, and an OR-TRUE comment. The old
        code only tried the apostrophe, which misses every int-
        context parameter.
        """
        findings = []
        test_params = self._get_test_params(["id", "page", "q", "search", "user", "item", "cat"])

        # Ordered payload set. Each payload is '<raw>' as passed to
        # the URL query string; we URL-encode it per request.
        probes = [
            ("'",  "'"),
            ('"',  '"'),
            (" OR 1=1-- -", " OR 1=1-- -"),
            ("' OR '1'='1'-- -", "' OR '1'='1'-- -"),
        ]

        for param in test_params[:5]:
            if shutdown_requested():
                break
            # Baseline: clean request with a safe value
            baseline_url = f"{base_url}?{param}=1"
            baseline_resp = self._session.get(baseline_url, allow_wayback=False)
            # If the baseline request failed, we have nothing to compare
            # against. Treating "no baseline" as "pattern absent in baseline"
            # turned every transient network failure into a false-positive
            # SQLi hit. Skip this parameter instead.
            if not baseline_resp or not baseline_resp.text:
                continue
            baseline_text = baseline_resp.text[:5000]

            for probe_name, payload in probes:
                if shutdown_requested():
                    break
                test_url = f"{base_url}?{param}=1{quote(payload)}"
                resp = self._session.get(test_url, allow_wayback=False)
                if not resp or not resp.text:
                    continue
                for indicator in self.SQLI_INDICATORS:
                    in_payload = indicator.search(resp.text[:5000])
                    in_baseline = indicator.search(baseline_text)
                    if in_payload and not in_baseline:
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": f"SQL injection indicator via '{param}' parameter",
                            "detail": ("SQL error message appears ONLY in response "
                                       f"to probe '{probe_name}' (not in baseline). "
                                       "Input likely reaches SQL query without "
                                       "parameterization."),
                            "evidence": f"Parameter: {param}, probe: {probe_name}, matched: {indicator.pattern[:60]}",
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "sqli",
                                "parameter": param,
                                "method": f"Inject SQL via '{param}' parameter. Error-based confirmed. "
                                          "Try: UNION SELECT, boolean-based blind, time-based blind.",
                                "risk": "Database access, data exfiltration, potential RCE via INTO OUTFILE",
                            },
                        })
                        return findings
        return findings

    def _check_sqli_headers(self, base_url: str) -> List[dict]:
        """Detect SQLi in request headers the app logs or passes to SQL.

        Apps that log User-Agent / Referer / X-Forwarded-For into a
        DB without parameterization are extremely common and usually
        go undetected by URL-param scanners. Probe the canonical
        loggable headers with a single-quote and look for SQL errors
        in the response body.

        Not every target will echo its own errors to the page (most
        log them silently), so this is an upper-bound probe —
        positives are strong, negatives don't mean clean.
        """
        findings = []
        baseline = self._session.get(base_url, allow_wayback=False)
        if not baseline or not baseline.text:
            return findings
        baseline_text = baseline.text[:6000]

        probe_headers = (
            "User-Agent", "Referer", "X-Forwarded-For",
            "X-Real-IP", "X-Client-IP", "Cookie",
        )
        for hname in probe_headers:
            if shutdown_requested():
                break
            # Use `Mozilla/5.0'` for User-Agent — breaking the
            # existing string mid-value is the most likely to reach
            # a logging query.
            if hname == "Cookie":
                payload_val = f"sess=gs{secrets.token_hex(4)}'"
            else:
                payload_val = f"gs{secrets.token_hex(4)}'"
            resp = self._session.request(
                "GET", base_url,
                extra_headers={hname: payload_val},
            )
            if not resp or not resp.text:
                continue
            body = resp.text[:6000]
            for indicator in self.SQLI_INDICATORS:
                if indicator.search(body) and not indicator.search(baseline_text):
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"SQL error reflected in response to injected {hname} header",
                        "detail": (f"Setting {hname} to a value containing "
                                   f"a single quote caused a database "
                                   f"error to appear in the response. "
                                   f"Common SQLi-via-logging pattern."),
                        "evidence": f"{hname}: {payload_val[:40]}, matched: {indicator.pattern[:60]}",
                        "exploitable": True,
                        "test_url": base_url,
                        "exploit_info": {
                            "type": "sqli",
                            "parameter": f"header:{hname}",
                            "method": (f"Inject into {hname}. Works "
                                       f"against apps that log requests "
                                       f"to a DB. Good starting point: "
                                       f"try UNION SELECT via "
                                       f"time-based blind because "
                                       f"errors don't always echo."),
                            "risk": "Database compromise via a header the WAF rarely inspects",
                        },
                    })
                    return findings
        return findings

    def _check_xss_reflection(self, base_url: str) -> List[dict]:
        """Detect reflected XSS by checking if a unique canary is reflected unescaped.

        Uses a fresh canary per scan (generated at class init) to avoid
        cached responses matching. Also checks that the reflection isn't
        inside a WAF/block page (which would be a false positive).
        """
        findings = []
        canary = f"gs{secrets.token_hex(4)}test"
        test_params = self._get_test_params(["q", "search", "query", "s", "name", "input"])

        for param in test_params[:5]:
            if shutdown_requested():
                break
            payload = f"<{canary}>"
            test_url = f"{base_url}?{param}={quote(payload)}"
            resp = self._session.get(test_url, allow_wayback=False)
            if resp and resp.text:
                # Reject WAF/block pages — canary might appear in error text
                if resp.status_code in (403, 429, 503):
                    continue
                text_lower = resp.text[:5000].lower()
                if any(kw in text_lower for kw in ("blocked", "forbidden", "access denied", "waf")):
                    if len(resp.text) < 2000:
                        continue

                if f"<{canary}>" in resp.text:
                    # Verify it's reflected in a context that would execute JS
                    # (not inside a <pre>, <textarea>, or HTML comment)
                    reflected_idx = resp.text.index(f"<{canary}>")
                    context = resp.text[max(0, reflected_idx - 100):reflected_idx + 100]
                    in_safe_context = any(tag in context.lower() for tag in
                                         ["<pre>", "<textarea", "<code>", "<!--"])
                    if in_safe_context:
                        confidence_penalty = 0.2
                    else:
                        confidence_penalty = 0

                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"Reflected XSS via '{param}' parameter",
                        "detail": "HTML input reflected unescaped in response. "
                                  "Attacker can inject arbitrary JavaScript.",
                        "evidence": f"Parameter: {param}, canary <{canary}> reflected as HTML",
                        "exploitable": True,
                        "test_url": test_url,
                        "exploit_info": {
                            "type": "xss",
                            "parameter": param,
                            "method": f"Inject JavaScript via '{param}' parameter. "
                                      "Payload: <script>alert(document.cookie)</script>. "
                                      "Use for session hijacking, keylogging, phishing.",
                            "risk": "Session theft, credential capture, client-side attacks",
                        },
                    })
                    if confidence_penalty:
                        findings[-1]["confidence"] = 0.7
                    return findings
        return findings

    def _check_directory_traversal(self, base_url: str) -> List[dict]:
        """Detect directory/path traversal indicators."""
        findings = []
        traversal_payloads = [
            ("..%2F..%2F..%2Fetc%2Fpasswd", "/etc/passwd content"),
            ("....//....//....//etc/passwd", "/etc/passwd content"),
        ]
        # Indicators that traversal succeeded
        passwd_indicators = [
            re.compile(r"root:.*:0:0:", re.I),
            re.compile(r"daemon:.*:/usr/sbin", re.I),
        ]

        for payload, desc in traversal_payloads[:1]:
            if shutdown_requested():
                break
            test_url = f"{base_url}/{payload}"
            resp = self._session.get(test_url, allow_wayback=False)
            if resp and resp.text:
                for ind in passwd_indicators:
                    if ind.search(resp.text[:2000]):
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": "Directory traversal — /etc/passwd readable",
                            "detail": "Path traversal allows reading arbitrary system files. "
                                      "Full filesystem access likely possible.",
                            "evidence": f"Payload: {payload}, {desc} detected",
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "directory_traversal",
                                "parameter": "path",
                                "method": "Path traversal to read arbitrary files. "
                                          "Try: /etc/shadow, application configs, database files, "
                                          "source code, SSH keys (~/.ssh/id_rsa).",
                                "risk": "Full filesystem read, credential theft, source code exposure",
                            },
                        })
                        return findings
        return findings

    # Common GraphQL mount points. Ordered by how likely they are.
    _GQL_PATHS = [
        "/graphql", "/graphql/", "/api/graphql", "/v1/graphql",
        "/v2/graphql", "/query", "/gql", "/api/gql",
        "/index.php?graphql", "/api/v1/graphql",
