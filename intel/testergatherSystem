#  Finding Chain — links related findings for targeted exploitation
# ══════════════════════════════════════════════════════════════════════════

class FindingChain:
    """Detect relationships between findings and chain them.

    Pipeline: extract → enrich → test
    Example chains:
    - Server version disclosed → search for CVEs for that version
    - WordPress detected → check WP-specific vulns
    - Admin panel found → test default credentials
    - API endpoint found → test for auth bypass
    """

    # Chain rules: if finding A exists, check for finding B
    CHAIN_RULES = [
        {
            "trigger": lambda f: "WordPress" in str(f.get("evidence", "")),
            "action": "wordpress_deep_scan",
            "description": "WordPress detected → check WP-specific endpoints",
        },
        {
            "trigger": lambda f: "Admin panel" in f.get("title", ""),
            "action": "admin_panel_check",
            "description": "Admin panel found → check for default paths",
        },
        {
            "trigger": lambda f: "GraphQL" in f.get("title", ""),
            "action": "graphql_enum",
            "description": "GraphQL found → enumerate sensitive queries",
        },
    ]

    WP_EXTRA_PATHS = [
        "/wp-login.php", "/wp-admin/", "/xmlrpc.php",
        "/wp-json/wp/v2/posts", "/wp-json/wp/v2/pages",
        "/wp-content/uploads/", "/wp-content/debug.log",
    ]

    def __init__(self, session: TorSession, scanner: VulnScanner):
        self._session = session
        self._scanner = scanner

    def process_chains(self, findings: List[dict], base_url: str,
                       tech: dict) -> List[dict]:
        """Process chain rules against existing findings.

        Returns NEW findings discovered through chaining.
        """
        new_findings = []

        for rule in self.CHAIN_RULES:
            triggered = [f for f in findings if rule["trigger"](f)]
            if not triggered:
                continue

            action = rule["action"]
            integrity_log("intel", f"chain_triggered:{action}")

            if action == "wordpress_deep_scan":
                new_findings.extend(self._wp_deep_scan(base_url))
            elif action == "admin_panel_check":
                new_findings.extend(self._admin_check(base_url))
            elif action == "graphql_enum":
                new_findings.extend(self._graphql_enum(base_url, triggered[0]))

        # Also chain based on tech fingerprint
        if "WordPress" in tech.get("cms", []):
            wp_findings = self._wp_deep_scan(base_url)
            new_findings.extend(wp_findings)

        return new_findings

    def _wp_deep_scan(self, base_url: str) -> List[dict]:
        """WordPress-specific vulnerability checks."""
        findings = []
        for wp_path in self.WP_EXTRA_PATHS:
            if shutdown_requested():
                break
            url = urljoin(base_url, wp_path)
            resp = self._session.get(url, allow_wayback=False, method="HEAD")
            if resp and resp.status_code == 200:
                sev = SEV_HIGH if "debug.log" in wp_path or "xmlrpc" in wp_path else SEV_MEDIUM
                findings.append({
                    "severity": sev,
                    "title": f"WordPress path accessible: {wp_path}",
                    "detail": f"WordPress endpoint found at {wp_path}.",
                    "evidence": f"HTTP 200 at {wp_path}",
                    "confidence": 0.8,
                    "chain_source": "wordpress_deep_scan",
                })
                if "xmlrpc" in wp_path:
                    findings[-1]["exploitable"] = True
                    findings[-1]["exploit_info"] = {
                        "type": "xmlrpc_abuse",
                        "path": wp_path,
                        "method": "XML-RPC can be used for brute-force amplification, "
                                  "pingback SSRF, and DoS. Test with: "
                                  "POST system.listMethods to enumerate available methods.",
                        "risk": "Brute-force, SSRF via pingback, denial of service",
                    }
        return findings

    def _admin_check(self, base_url: str) -> List[dict]:
        """Check admin panel for common patterns."""
        findings = []
        admin_paths = ["/admin/login", "/administrator/", "/wp-admin/",
                       "/admin/dashboard", "/panel/"]
        for path in admin_paths:
            if shutdown_requested():
                break
            resp = self._session.get(urljoin(base_url, path), allow_wayback=False)
            if resp and resp.status_code == 200 and len(resp.text) > 500:
                if re.search(r"<form.*(?:login|password|user)", resp.text[:5000], re.I):
                    findings.append({
                        "severity": SEV_MEDIUM,
                        "title": f"Admin login form at {path}",
                        "detail": "Login form accessible. Test for default credentials.",
                        "evidence": f"Login form at {path}",
                        "confidence": 0.85,
                        "chain_source": "admin_panel_check",
                    })
                    break
        return findings

    def _graphql_enum(self, base_url: str, gql_finding: dict) -> List[dict]:
        """Enumerate sensitive GraphQL queries from schema."""
        findings = []
        path = gql_finding.get("exploit_info", {}).get("path", "/graphql")
        url = urljoin(base_url, path)
        domain = urlparse(base_url).netloc

        if self._session.is_domain_blocked(domain):
            return findings

        query = '{ __schema { types { name fields { name type { name } } } } }'
        try:
            self._session._delay_for_domain(domain)
            self._session._maybe_rotate_circuit()
            resp = self._session._session.post(
                url, json={"query": query}, timeout=REQUEST_TIMEOUT,
                proxies=self._session._proxy, headers=_pick_profile(),
            )
            if resp and resp.status_code == 200:
                data = resp.json()
                types = data.get("data", {}).get("__schema", {}).get("types", [])
                sensitive_types = []
                for t in types:
                    name = t.get("name", "")
                    if name and not name.startswith("__"):
                        # Flag types that look sensitive
                        if any(kw in name.lower() for kw in
                               ["user", "account", "admin", "secret", "token",
                                "password", "credential", "payment", "order"]):
                            fields = [f.get("name", "") for f in t.get("fields", [])[:10]]
                            sensitive_types.append({"type": name, "fields": fields})

                if sensitive_types:
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"GraphQL exposes {len(sensitive_types)} sensitive types",
                        "detail": "Types: " + ", ".join(s["type"] for s in sensitive_types[:5]),
                        "evidence": json.dumps(sensitive_types[:3], default=str)[:200],
                        "confidence": 0.9,
                        "exploitable": True,
                        "exploit_info": {
                            "type": "graphql_data_exposure",
                            "path": path,
                            "method": "Query sensitive types directly: " +
                                      ", ".join(f'{{ {s["type"].lower()}s {{ ' +
                                               " ".join(s["fields"][:5]) + ' } }}'
                                               for s in sensitive_types[:2]),
                            "risk": "Data exfiltration of user accounts, credentials, payments",
                        },
                        "chain_source": "graphql_enum",
                    })
        except Exception as e:
            integrity_log("intel", f"graphql_enum_error:{type(e).__name__}")

        return findings


