class IntelScraper:
    def __init__(self, session: TorSession):
        self._session = session
        self._extractor = DataExtractor()
        self._honeypot = HoneypotDetector()

    def scrape_url(self, url: str) -> Optional[dict]:
        t0 = time.time()
        resp = self._session.get(url)
        elapsed_ms = (time.time() - t0) * 1000
        if resp is None:
            return None
        content = resp.text
        headers = dict(resp.headers)
        hp = self._honeypot.check(content, headers, elapsed_ms, len(resp.history))
        if hp["is_honeypot"]:
            integrity_log("intel", f"honeypot:{urlparse(url).netloc}")
            return {"url": url, "honeypot": True, "hp_reasons": hp["reasons"]}

        text = content
        title = ""
        meta_desc = ""
        if HAS_BS4:
            try:
                soup = BeautifulSoup(content, "html.parser")
                for tag in soup(["script", "style", "noscript"]):
                    tag.decompose()
                text = soup.get_text(separator=" ", strip=True)
                title = (soup.title.string.strip() if soup.title and soup.title.string else "")
                mt = soup.find("meta", attrs={"name": "description"})
                if mt:
                    meta_desc = mt.get("content", "")
            except Exception as e:
                integrity_log("intel", f"scrape_url_error:{type(e).__name__}")

        extracted = self._extractor.extract_all(text)
        urls = self._extractor.extract_urls(content, url)
        comments = self._extractor.extract_comments(content)
        secrets_in_comments = {}
        if comments:
            combined = " ".join(comments)
            secrets_in_comments = self._extractor.extract_all(combined)

        _coarsened = int(time.time()) // 600 * 600
        return {
            "url": url, "title": title[:200], "description": meta_desc[:500],
            "extracted": extracted, "urls_found": len(urls),
            "comments": len(comments),
            "secrets_in_comments": secrets_in_comments,
            "content_length": len(content), "timestamp": _coarsened,
            "raw_html": content, "raw_headers": headers,
            "honeypot": False,
        }

    def search_ddg(self, query: str, max_results: int = 20) -> List[dict]:
        """DuckDuckGo HTML search — Tor-friendly, no JS needed."""
        results = []
        url = f"https://html.duckduckgo.com/html/?q={quote(query)}"
        resp = self._session.get(url)
        if not resp or not HAS_BS4:
            return results
        try:
            soup = BeautifulSoup(resp.text, "html.parser")
            # DDG HTML uses result__a class for links
            links = soup.find_all("a", class_="result__a")
            if not links:
                # Fallback: find any result links
                links = soup.find_all("a", href=re.compile(r"^https?://"))
            for link in links[:max_results]:
                href = link.get("href", "")
                title = link.get_text(strip=True)
                if href and href.startswith("http") and "duckduckgo" not in href:
                    results.append({"url": href, "title": title, "source": "ddg"})
        except Exception as e:
            integrity_log("intel", f"ddg_parse_error:{str(e)[:40]}")
        return results


