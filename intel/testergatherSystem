class BreachChecker:
    """Check emails against breach databases via Tor."""

    def __init__(self, session: TorSession):
        self._session = session

    def check_hibp(self, email: str) -> Optional[dict]:
        """Check Have I Been Pwned for email breaches.

        Requires HIBP_KEY env var (paid API key).
        Uses the v3 breachedaccount endpoint, NOT pwnedpasswords.
        """
        if not HIBP_API_KEY:
            return None

        url = f"https://haveibeenpwned.com/api/v3/breachedaccount/{quote(email)}?truncateResponse=true"
        resp = self._session.get(url, headers={
            "hibp-api-key": HIBP_API_KEY,
            "User-Agent": "IntelGather-OSINT",
        })

        if resp is None:
            return {"email_hash": hashlib.sha256(email.encode()).hexdigest()[:16],
                    "status": "error", "source": "hibp"}

        if resp.status_code == 200:
            try:
                breaches = resp.json()
                return {
                    "email_hash": hashlib.sha256(email.encode()).hexdigest()[:16],
                    "breached": True,
                    "breach_count": len(breaches) if isinstance(breaches, list) else 1,
                    "breach_names": [b.get("Name", "?") for b in breaches[:10]]
                                    if isinstance(breaches, list) else [],
                    "source": "hibp",
                }
            except (ValueError, KeyError):
                pass
        elif resp.status_code == 404:
            return {
                "email_hash": hashlib.sha256(email.encode()).hexdigest()[:16],
                "breached": False,
                "source": "hibp",
            }

        return None

    def check_dehashed(self, email: str) -> Optional[dict]:
        """Check Dehashed API for breach data.

        Requires DEHASHED_KEY and DEHASHED_EMAIL env vars.
        """
        if not DEHASHED_API_KEY or not DEHASHED_EMAIL:
            return None

        url = f"https://api.dehashed.com/search?query=email:{quote(email)}"
        resp = self._session.get(url, headers={
            "Accept": "application/json",
        })

        if resp is None:
            return None

        if resp.status_code == 200:
            try:
                data = resp.json()
                entries = data.get("entries", [])
                if entries:
                    return {
                        "email_hash": hashlib.sha256(email.encode()).hexdigest()[:16],
                        "breached": True,
                        "entry_count": len(entries),
                        "sources": list(set(e.get("database_name", "?")
                                            for e in entries[:20])),
                        "source": "dehashed",
                    }
            except (ValueError, KeyError):
                pass

        return None


