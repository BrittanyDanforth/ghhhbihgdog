class IntelOrchestrator:
    """Wire everything together: scrape → extract → scan → check → report."""

    def __init__(self, proxy: dict, scan_depth: str = "full"):
        self._session = TorSession(proxy)
        self._request_log = RequestLog()
        self._scraper = IntelScraper(self._session)
        self._vulns = VulnScanner(self._session)
        self._breach = BreachChecker(self._session)
        self._subdomains = SubdomainEnumerator(self._session)
        self._dns = DNSRecon(self._session)
        self._tech = TechFingerprinter()
        self._chain = FindingChain(self._session, self._vulns)
        self._verifier = ExploitVerifier(self._session, self._request_log)
        self._storage = SecureStorage()
        self._results: List[dict] = []
        self._vuln_findings: List[dict] = []
        self._scan_depth = scan_depth

    def _run_phase(self, phase_num: int, name: str, func, *args, **kwargs):
        """Run a scan phase with timing, error isolation, and progress display.

        If a phase crashes or hangs, it's logged and skipped — never blocks
        the rest of the scan. Shows elapsed time so the operator knows
        what's happening.
        """
        if shutdown_requested():
            return None
        t0 = time.time()
        print(f"\n  [*] Phase {phase_num}: {name}...")
        try:
            result = func(*args, **kwargs)
            elapsed = time.time() - t0
            if elapsed > 30:
                print(f"      ({elapsed:.0f}s elapsed)")
            return result
        except KeyboardInterrupt:
            print(f"  [!] Phase {phase_num} interrupted by user")
            return None
        except Exception as e:
            elapsed = time.time() - t0
            print(f"  [!] Phase {phase_num} error: {type(e).__name__}: {str(e)[:60]} ({elapsed:.0f}s)")
            integrity_log("intel", f"phase_{phase_num}_error:{type(e).__name__}")
            return None

    def run_domain(self, domain: str):
        """Full domain reconnaissance + vulnerability scan.

        Each phase is isolated — one failure or hang does not block others.
        Progress is shown inline with timing.
        """
        print(f"\n  {'═' * 55}")
        print(f"  TARGET: {domain}")
        print(f"  DEPTH:  {self._scan_depth}")
        print(f"  {'═' * 55}")

        t_start = time.time()
        base_url = f"https://{domain}"

        # Phase 1: Main page scrape + data extraction
        def _phase1():
            r = self._scraper.scrape_url(base_url)
            if not r:
                r = self._scraper.scrape_url(f"http://{domain}")
            return r

        result = self._run_phase(1, "Fetching main page", _phase1)
        if not result:
            print(f"  [!] Could not fetch {domain} (both HTTPS and HTTP failed).")
            print(f"  [!] The site may be down, blocking Tor, or require authentication.")
            print(f"  [*] Continuing with header/DNS checks only...")
        elif result.get("honeypot"):
            print(f"  [!] Honeypot/WAF detected. Some checks may be limited.")
        else:
            self._results.append(result)
            self._print_extraction(result)
            if result.get("url", "").startswith("http://"):
                base_url = f"http://{domain}"

        # Phase 2: Technology fingerprinting
        html = result.get("raw_html", "") if result else ""
        headers = result.get("raw_headers", {}) if result else {}
        tech = self._run_phase(2, "Technology fingerprinting",
                               self._tech.fingerprint, headers, html) or {}
        if tech:
            self._print_tech(tech)

        # Phase 3: Vulnerability scanning (headers + path probes)
        vulns = self._run_phase(3, f"Vulnerability scanning ({self._scan_depth})",
                                self._vulns.scan_full, base_url, html, headers,
                                self._scan_depth) or []
        self._vuln_findings.extend(vulns)
        self._print_vulns(vulns)

        # Reset circuit breaker between phases.
        # Path probing (/.git, /.env, etc.) in phase 3 generates expected 403s
        # that fill the block counter. Without reset, deep scan crawling and
        # endpoint testing in later phases get killed by is_domain_blocked()
        # before they can even start — making the entire deep scan useless.
        self._session.reset_domain_blocks(domain)

        # Phase 4: DNS reconnaissance (full/deep only)
        if self._scan_depth in ("full", "deep"):
            dns_records = self._run_phase(4, "DNS reconnaissance",
                                          self._dns.lookup, domain) or {}
            self._print_dns(dns_records)
            if dns_records:
                self._results.append({"type": "dns", "domain": domain, "records": dns_records})

        # Phase 5: Subdomain enumeration (deep only)
        if self._scan_depth == "deep":
            subs = self._run_phase(5, "Subdomain enumeration (crt.sh)",
                                   self._subdomains.enumerate, domain) or []
            if subs:
                print(f"  [+] Found {len(subs)} subdomains")
                for s in subs[:20]:
                    print(f"      {s}")
                if len(subs) > 20:
                    print(f"      ... and {len(subs) - 20} more")
                self._results.append({"type": "subdomains", "domain": domain,
                                      "subdomains": subs, "count": len(subs)})

                # Phase 5b: subdomain takeover check (limit to 10, with progress)
                print(f"\n  [*] Phase 5b: Checking subdomains for takeover...")
                checked = 0
                for sub in subs[:10]:
                    if shutdown_requested():
                        break
                    checked += 1
                    try:
                        sub_dns = self._dns.lookup(sub)
                        cnames = sub_dns.get("CNAME", [])
                        if cnames:
                            takeover = self._vulns._check_subdomain_takeover(sub, cnames)
                            if takeover:
                                self._vulns._add_confidence(takeover, 0.85)
                                self._vuln_findings.extend(takeover)
                                for t in takeover:
                                    print(f"  [!] TAKEOVER: {t['title']}")
                    except Exception as e:
                        integrity_log("intel", f"takeover_check_error:{sub}:{type(e).__name__}")
                print(f"      checked {checked}/{min(len(subs), 10)} subdomains")

        # Phase 6: Search engine OSINT (limit scraping to avoid hanging)
        def _phase6():
            dork_queries = [f'site:{domain}', f'"{domain}" filetype:pdf']
            for dq in dork_queries[:2]:
                if shutdown_requested():
                    break
                self._run_search(dq, max_results=5)

        self._run_phase(6, "Search engine OSINT", _phase6)

        # Phase 7: Finding chaining (use discoveries to find more)
        if self._scan_depth in ("full", "deep") and self._vuln_findings:
            chain_findings = self._run_phase(
                7, "Finding chain analysis",
                self._chain.process_chains, self._vuln_findings, base_url, tech) or []
            if chain_findings:
                self._vulns._add_confidence(chain_findings, 0.8)
                self._vuln_findings.extend(chain_findings)
                print(f"  [+] Chain analysis found {len(chain_findings)} additional findings")
                self._print_vulns(chain_findings)

        # Phase 8: Verify exploitable findings (deep only, max 5 to avoid hanging)
        if self._scan_depth == "deep":
            exploitable = [f for f in self._vuln_findings if f.get("exploitable")]
            if exploitable:
                verify_limit = min(len(exploitable), 5)
                print(f"\n  [*] Phase 8: Verifying {verify_limit}/{len(exploitable)} exploitable findings...")
                for idx, ef in enumerate(exploitable[:verify_limit]):
                    if shutdown_requested():
                        break
                    try:
                        self._verifier.verify_finding(ef)
                        status = ef.get("verified", "?")
                        conf = ef.get("confidence", 0)
                        tag = "+" if status == "confirmed" else "-" if "not_reproduced" in status else "?"
                        print(f"      [{tag}] {ef['title'][:50]} -> {status} ({conf*100:.0f}%)")
                    except Exception as e:
                        print(f"      [?] {ef['title'][:50]} -> error ({type(e).__name__})")
                        integrity_log("intel", f"verify_error:{type(e).__name__}")

        # Final stats
        elapsed_total = time.time() - t_start
        print(f"\n  [*] Scan complete ({elapsed_total:.0f}s total)")
        stats = self._session.get_stats()
        if stats["total_blocks"] or stats["total_timeouts"]:
            blocked = f"{stats['total_blocks']} blocked" if stats["total_blocks"] else ""
            timeouts = f"{stats['total_timeouts']} timeouts" if stats["total_timeouts"] else ""
            sep = ", " if blocked and timeouts else ""
            print(f"  [*] Network issues: {blocked}{sep}{timeouts}")

    def run_email(self, email: str):
        """Breach database check for email."""
        print(f"  [*] Checking: {email[:3]}***@***")
        hibp = self._breach.check_hibp(email)
        if hibp:
            if hibp.get("breached"):
                print(f"  [!] HIBP: BREACHED ({hibp.get('breach_count', '?')} breaches)")
                for n in hibp.get("breach_names", [])[:5]:
                    print(f"      - {n}")
            elif hibp.get("status") == "error":
                print(f"  [!] HIBP: check failed")
            else:
                print(f"  [+] HIBP: not found")
            self._results.append({"type": "breach_check", "data": hibp})
        dehashed = self._breach.check_dehashed(email)
        if dehashed:
            if dehashed.get("breached"):
                print(f"  [!] Dehashed: BREACHED ({dehashed.get('entry_count', '?')} entries)")
            self._results.append({"type": "breach_check", "data": dehashed})
        if not hibp and not dehashed:
            if not HIBP_API_KEY and not DEHASHED_API_KEY:
                print(f"  [*] No breach DB API keys configured (set HIBP_KEY / DEHASHED_KEY)")
            else:
                print(f"  [*] Breach check returned no results (API may be rate-limited or unavailable)")

    def run_query(self, query: str, max_pages: int = 20):
        """Search + scrape pipeline."""
        print(f"  [*] Searching: {query[:50]}...")
        self._run_search(query, max_pages)

    def _run_search(self, query: str, max_results: int = 20):
        search_results = self._scraper.search_ddg(query, max_results)
        print(f"  [+] {len(search_results)} results")
        # Only scrape first few results to avoid getting stuck on slow sites
        scrape_limit = min(len(search_results), 5)
        for i, sr in enumerate(search_results[:scrape_limit]):
            if shutdown_requested():
                break
            url = sr["url"]
            domain = urlparse(url).netloc
            if self._session.is_domain_blocked(domain):
                print(f"  [*] [{i+1}/{scrape_limit}] {domain} (blocked, skipped)")
                continue
            print(f"  [*] [{i+1}/{scrape_limit}] {domain}...")
            result = self._scraper.scrape_url(url)
            if result:
                self._results.append(result)
                ex = result.get("extracted", {})
                if ex:
                    for etype, evals in ex.items():
                        print(f"      {etype}: {len(evals)}")
        if len(search_results) > scrape_limit:
            print(f"      ({len(search_results) - scrape_limit} additional results not scraped)")

    def run_file(self, filepath: Path):
        """Process targets from file."""
        if not filepath.exists():
            print(f"  [!] File not found")
            return
        lines = filepath.read_text().strip().splitlines()
        print(f"  [*] {len(lines)} targets from file")
        for i, line in enumerate(lines):
            if shutdown_requested():
                break
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            print(f"\n  ── Target {i+1}/{len(lines)} ──")
            if "@" in line and "." in line:
                self.run_email(line)
            elif "." in line and " " not in line:
                self.run_domain(line)
            else:
                self.run_query(line, 10)

    def _print_extraction(self, result: dict):
        ex = result.get("extracted", {})
        if ex:
            print(f"  [+] Data extracted:")
            for etype, evals in ex.items():
                print(f"      {etype}: {len(evals)} found")
        sc = result.get("secrets_in_comments", {})
        if sc:
            print(f"  [!] Secrets found in HTML comments:")
            for stype, svals in sc.items():
                print(f"      {stype}: {len(svals)}")

    def _print_tech(self, tech: dict):
        if tech.get("server"):
            print(f"  [+] Server: {tech['server']}")
        if tech.get("powered_by"):
            print(f"  [+] Powered by: {tech['powered_by']}")
        if tech.get("cdn"):
            print(f"  [+] CDN: {tech['cdn']}")
        for cms in tech.get("cms", []):
            print(f"  [+] CMS: {cms}")
        for fw in tech.get("frameworks", []):
            print(f"  [+] Framework: {fw}")
        if tech.get("language"):
            print(f"  [+] Language: {tech['language']}")
        if tech.get("meta_generator"):
            print(f"  [+] Generator: {tech['meta_generator']}")

    def _print_vulns(self, vulns: List[dict]):
        if not vulns:
            print(f"  [+] No vulnerabilities found at this scan depth")
            return
        # Sort by severity
        order = {SEV_CRITICAL: 0, SEV_HIGH: 1, SEV_MEDIUM: 2, SEV_LOW: 3, SEV_INFO: 4}
        vulns.sort(key=lambda v: order.get(v["severity"], 5))
        counts = defaultdict(int)
        for v in vulns:
            counts[v["severity"]] += 1
        print(f"  [!] {len(vulns)} findings: "
              f"{counts.get(SEV_CRITICAL,0)} critical, {counts.get(SEV_HIGH,0)} high, "
              f"{counts.get(SEV_MEDIUM,0)} medium, {counts.get(SEV_LOW,0)} low, "
              f"{counts.get(SEV_INFO,0)} info")
        exploitable_count = sum(1 for v in vulns if v.get("exploitable"))
        if exploitable_count:
            print(f"  [!] {exploitable_count} EXPLOITABLE vulnerabilities found!")

        for v in vulns:
            sev = v["severity"]
            color = {"CRITICAL": "\033[1;31m", "HIGH": "\033[0;31m",
                     "MEDIUM": "\033[1;33m", "LOW": "\033[0;36m",
                     "INFO": "\033[0;90m"}.get(sev, "")
            reset = "\033[0m"
            exploit_tag = " [EXPLOITABLE]" if v.get("exploitable") else ""
            conf = v.get("confidence", 0)
            conf_tag = f" ({conf*100:.0f}%)" if conf is not None else ""
            print(f"  {color}[{sev}]{reset} {v['title']}{exploit_tag}{conf_tag}")
            if sev in (SEV_CRITICAL, SEV_HIGH, SEV_MEDIUM):
                print(f"         {v['detail'][:120]}")
            if v.get("exploit_info"):
                ei = v["exploit_info"]
                print(f"         Exploit: {ei.get('method', '')[:100]}")
                print(f"         Risk: {ei.get('risk', '')[:80]}")

    def _print_dns(self, records: dict):
        if not records:
            print(f"  [*] No DNS records found (DoH may be blocked)")
            return
        for rtype, values in records.items():
            print(f"  [+] {rtype}: {', '.join(values[:5])}")

    def save_report(self) -> Optional[Path]:
        """Show results in terminal, then save report.

        Results are ALWAYS shown in terminal (the user shouldn't have to
        decrypt a file just to see what the scan found). Report is saved
        to RAM for later reference.
        """
        if not self._results and not self._vuln_findings:
            stats = self._session.get_stats()
            print(f"\n  [*] No results collected.")
            if stats["total_blocks"] > 0:
                print(f"  [*] {stats['total_blocks']} requests were blocked by the target.")
                print(f"  [*] {stats['domains_blocked']} domain(s) triggered circuit breaker.")
            if stats["total_timeouts"] > 0:
                print(f"  [*] {stats['total_timeouts']} request(s) timed out.")
            return None

        # Aggregate extracted data
        all_data: Dict[str, Set[str]] = defaultdict(set)
        pages = 0
        honeypots = 0
        breaches = 0
        for r in self._results:
            if r.get("honeypot"):
                honeypots += 1
                continue
            if r.get("type") == "breach_check":
                if r.get("data", {}).get("breached"):
                    breaches += 1
                continue
            if r.get("type") in ("dns", "subdomains"):
                continue
            pages += 1
            for etype, evals in r.get("extracted", {}).items():
                all_data[etype].update(evals)
            for etype, evals in r.get("secrets_in_comments", {}).items():
                all_data[f"comment_{etype}"].update(evals)

        vuln_counts = defaultdict(int)
        for v in self._vuln_findings:
            vuln_counts[v["severity"]] += 1

        stats = self._session.get_stats()
        pocs = PoCExporter.export_all(self._vuln_findings)

        # ── ALWAYS show results in terminal ──
        print(f"\n  {'═' * 55}")
        print(f"  SCAN RESULTS")
        print(f"  {'═' * 55}")
        print(f"  Pages scraped:      {pages}")
        print(f"  Honeypots:          {honeypots}")
        print(f"  Breached accounts:  {breaches}")
        print(f"  Requests made:      {stats['total_requests']}")
        if stats["total_blocks"]:
            print(f"  Blocked requests:   {stats['total_blocks']}")
        if stats["total_timeouts"]:
            print(f"  Timeouts:           {stats['total_timeouts']}")
        if stats["domains_blocked"]:
            print(f"  Domains blocked:    {stats['domains_blocked']} (circuit breaker)")

        # Show vulnerabilities inline
        if self._vuln_findings:
            print(f"\n  Vulnerabilities ({len(self._vuln_findings)}):")
            order = {SEV_CRITICAL: 0, SEV_HIGH: 1, SEV_MEDIUM: 2, SEV_LOW: 3, SEV_INFO: 4}
            for v in sorted(self._vuln_findings, key=lambda x: order.get(x.get("severity", ""), 5)):
                sev = v.get("severity", "?")
                color = {"CRITICAL": "\033[1;31m", "HIGH": "\033[0;31m",
                         "MEDIUM": "\033[1;33m", "LOW": "\033[0;36m",
                         "INFO": "\033[0;90m"}.get(sev, "")
                exploit = " [EXPLOITABLE]" if v.get("exploitable") else ""
                conf = f" ({v.get('confidence',0)*100:.0f}%)" if v.get("confidence") is not None else ""
                print(f"    {color}[{sev}]\033[0m {v.get('title','?')}{exploit}{conf}")

        # Show extracted data inline
        if all_data:
            print(f"\n  Data found:")
            for k, v in sorted(all_data.items()):
                if v:
                    # Show first few values, not just counts
                    sample = list(v)[:3]
                    more = f" (+{len(v)-3} more)" if len(v) > 3 else ""
                    # Truncate to 20 chars to avoid leaking full secrets/keys to scrollback
                    print(f"    {k}: {', '.join(str(s)[:20] + '...' if len(str(s)) > 20 else str(s) for s in sample)}{more}")

        # Show PoC commands inline
        if pocs:
            print(f"\n  Exploit PoCs ({len(pocs)}):")
            for poc in pocs[:15]:
                print(f"\n    [{poc.get('severity','?')}] {poc.get('finding','?')[:70]}")
                if poc.get("impact"):
                    print(f"    Impact: {poc['impact'][:120]}")
                if poc.get("steps"):
                    for step in poc["steps"][:8]:
                        print(f"      {step}")
                elif poc.get("curl"):
                    for curl_line in poc["curl"].split("\n")[:5]:
                        print(f"      {curl_line}")
                if poc.get("remediation"):
                    print(f"    Fix: {poc['remediation'][:120]}")

        print(f"  {'═' * 55}")

        # ── Save report ──
        _ts = int(time.time()) // 600 * 600
        report = {
            "schema": "intel_report_v2",
            "timestamp": _ts,
            "summary": {
                "pages_scraped": pages, "honeypots": honeypots,
                "breached_accounts": breaches,
                "vulnerabilities": dict(vuln_counts),
                "vuln_total": len(self._vuln_findings),
                "data_extracted": {k: len(v) for k, v in all_data.items()},
                "session_stats": stats,
            },
            "vulnerabilities": self._vuln_findings,
            "proof_of_concepts": [p for p in pocs],
            "results": [
                {k: v for k, v in r.items() if k not in ("raw_html", "raw_headers")}
                for r in self._results
            ],
        }

        outpath, enc_key = self._storage.save(report)

        if enc_key:
            print(f"\n  [+] Report saved (encrypted): {scrub_path(outpath)}")
            print(f"  [+] Decryption key: {enc_key}")
            print(f"  [*] To read later: ./gs gather --read-report {outpath.name}")
        else:
            print(f"\n  [+] Report saved: {scrub_path(outpath)}")
            print(f"  [*] To read later: ./gs gather --read-report {outpath.name}")

        return outpath

    def cleanup(self):
        self._session.close()
        gc.collect()

    def emergency_wipe(self):
        self._storage.wipe_all()
        self._results.clear()
        self._vuln_findings.clear()
        gc.collect()
        print("  [+] Emergency wipe complete")


