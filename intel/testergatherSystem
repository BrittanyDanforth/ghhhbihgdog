        }
        
        # Check headers
        headers = response_data.get('headers', {})
        suspicious_headers = [
            'x-honeypot', 'x-trap', 'x-security-scan',
            'cf-bot-score', 'x-abuse-info'
        ]
        
        for header in suspicious_headers:
            if header in headers:
                indicators['headers'] += 1
                
        # Check content patterns
        content = response_data.get('content', '')
        honeypot_patterns = [
            r'var _0x[a-f0-9]{4}',  # Obfuscated JS
            r'honeypot|trap|bot-check',
            r'please verify you are human',
            r'unusual activity detected'
        ]
        
        for pattern in honeypot_patterns:
            if re.search(pattern, content, re.I):
                indicators['content'] += 1
                
        # Check behavior
        if response_data.get('redirects', 0) > 3:
            indicators['behavior'] += 1
            
        if response_data.get('response_time', 0) < 50:  # Too fast
            indicators['behavior'] += 1
            
        # Calculate score
        total_score = sum(indicators.values())
        
        return {
            'is_honeypot': total_score > 2,
            'confidence': min(total_score / 10, 1.0),
            'indicators': indicators
        }

