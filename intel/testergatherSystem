class TorSession:
    """Rate-limited requests session with Tor, circuit rotation on blocks,
    and Wayback Machine fallback for blocked pages."""

    def __init__(self, proxy_dict: dict):
        self._proxy = proxy_dict
        self._session = requests.Session()
        self._session.proxies.update(proxy_dict)
        # Verify DNS goes through proxy
        self._verify_dns_safety()
        retry = Retry(total=0, backoff_factor=0)  # we handle retries ourselves
        adapter = HTTPAdapter(max_retries=retry, pool_maxsize=4)
        self._session.mount("http://", adapter)
        self._session.mount("https://", adapter)
        self._domain_last: Dict[str, float] = {}
        self._domain_blocks: Dict[str, int] = defaultdict(int)
        self._request_count = 0
        self._total_requests = 0
        self._total_blocks = 0
        self._total_timeouts = 0

    def _verify_dns_safety(self):
        """Verify DNS queries go through Tor, not local resolver.

        Uses two independent verification sources to avoid single-point
        dependency. If both fail (Tor may be slow), proceeds cautiously
        rather than false-aborting — but logs the failure.
        """
        # Quick check — 8s timeout (reduced from 15). Already verified by
        # require_tor_proxy() before session creation, so this is a belt-and-suspenders.
        verified = False
        try:
            resp = self._session.get(
                "https://check.torproject.org/api/ip",
                timeout=8, headers=_pick_profile(),
            )
            if resp.status_code == 200:
                data = resp.json()
                if data.get("IsTor"):
                    verified = True
                else:
                    integrity_log("intel", "DNS_LEAK:session_not_tor")
                    print("  [!] CRITICAL: Session NOT through Tor! Aborting.")
                    sys.exit(1)
        except (requests.exceptions.Timeout, requests.exceptions.ConnectionError):
            # Already verified by require_tor_proxy — proceed
            verified = True
            integrity_log("intel", "dns_verify_skip:already_verified_by_gs_common")
        except Exception as e:
            verified = True  # Don't block on verification failure
            integrity_log("intel", f"dns_verify_skip:{type(e).__name__}")

    def _delay_for_domain(self, domain: str):
        """Adaptive delay — scales up only under sustained blocking."""
        blocks = self._domain_blocks.get(domain, 0)
        if blocks < 3:
            base_min, base_max = DOMAIN_MIN_DELAY, DOMAIN_MAX_DELAY
        else:
            base_min = DOMAIN_MIN_DELAY + min(blocks, 6)
            base_max = DOMAIN_MAX_DELAY + min(blocks * 2, 12)
        last = self._domain_last.get(domain, 0)
        elapsed = time.time() - last
        needed = base_min + secrets.randbelow(int((base_max - base_min) * 1000 + 1)) / 1000.0
        if elapsed < needed:
            time.sleep(needed - elapsed)

    def _maybe_rotate_circuit(self):
        self._request_count += 1
        if self._request_count % CIRCUIT_ROTATION_EVERY == 0:
            newnym()
            time.sleep(2 + secrets.randbelow(3000) / 1000.0)

    def is_domain_blocked(self, domain: str) -> bool:
        """Check if a domain has blocked us too many times."""
        return self._domain_blocks.get(domain, 0) >= BLOCK_THRESHOLD

    def reset_domain_blocks(self, domain: str):
        """Reset block counter for a domain between scan phases.

        Path probing (/.git, /.env, etc.) triggers 403s that are NOT real blocks —
        they're expected responses. Without resetting, the circuit breaker trips
        before deep testing even starts, making the entire deep scan useless.
        """
        old = self._domain_blocks.get(domain, 0)
        self._domain_blocks[domain] = max(0, old // 2)

    def set_cookies(self, cookies: dict):
        """Set session cookies for authenticated scanning."""
        self._session.cookies.update(cookies)

    def get(self, url: str, allow_wayback: bool = True, method: str = "GET",
            **kwargs) -> Optional[requests.Response]:
        """GET/HEAD with retry-on-block, circuit rotation, and Wayback fallback.

        Key reliability features:
        - Hard per-request timeout (REQUEST_TIMEOUT seconds, not 25)
        - Domain-level circuit breaker: after BLOCK_THRESHOLD blocks, skip
        - Only 2 retries on block (was 3 — saves 30+ seconds on stubborn sites)
        - Returns None (not hangs) on every failure path
        """
        if shutdown_requested():
            return None

        domain = urlparse(url).netloc
        self._total_requests += 1

        # Circuit breaker: if this domain has blocked us too many times, don't waste time
        if self.is_domain_blocked(domain):
            return None

        kwargs.setdefault("timeout", REQUEST_TIMEOUT)

        for attempt in range(MAX_RETRIES_PER_URL):
            self._delay_for_domain(domain)
            self._maybe_rotate_circuit()

            headers = _pick_profile()
            if self._request_count > 1:
                headers["Referer"] = f"https://duckduckgo.com/?q={quote(domain)}"
            extra_headers = kwargs.get("headers", {})
            if extra_headers:
                headers.update(extra_headers)
            req_kwargs = {k: v for k, v in kwargs.items() if k != "headers"}

            try:
                self._domain_last[domain] = time.time()
                if method.upper() == "HEAD":
                    resp = self._session.head(url, headers=headers, allow_redirects=True, **req_kwargs)
                else:
                    resp = self._session.get(url, headers=headers, **req_kwargs)

                if resp.status_code in (200, 301, 302, 304):
                    self._domain_blocks[domain] = max(0, self._domain_blocks[domain] - 1)
                    return resp

                if resp.status_code in (403, 429, 503):
                    self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                    self._total_blocks += 1
                    if self.is_domain_blocked(domain):
                        integrity_log("intel", f"domain_circuit_breaker:{domain}")
                        return None
                    newnym()
                    time.sleep(2 + secrets.randbelow(3000) / 1000.0)
                    continue

                # 4xx/5xx: return as-is (may contain useful error info for vuln checks)
                # but don't count as blocks. 404 is expected for path probes.
                if resp.status_code == 404:
                    return resp
                # Server errors: rotate circuit and retry on 502 (proxy error)
                if resp.status_code == 502 and attempt < MAX_RETRIES_PER_URL - 1:
                    newnym()
                    time.sleep(1 + secrets.randbelow(2000) / 1000.0)
                    continue
                return resp

            except requests.exceptions.Timeout:
                self._total_timeouts += 1
                integrity_log("intel", f"timeout:{domain}:attempt={attempt}")
                if attempt < MAX_RETRIES_PER_URL - 1:
                    newnym()
                    time.sleep(1 + secrets.randbelow(2000) / 1000.0)
                    continue
                return None
            except requests.exceptions.ConnectionError:
                self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                integrity_log("intel", f"conn_error:{domain}")
                # Don't return immediately — fall through to Wayback on last attempt
                if attempt < MAX_RETRIES_PER_URL - 1:
                    newnym()
                    time.sleep(1 + secrets.randbelow(2000) / 1000.0)
                    continue
                break

        # All retries exhausted — try Wayback Machine
        if allow_wayback and WAYBACK_ENABLED and method.upper() == "GET":
            return self._wayback_fetch(url)
        return None

    def get_stats(self) -> dict:
        """Return session statistics for reporting."""
        return {
            "total_requests": self._total_requests,
            "total_blocks": self._total_blocks,
            "total_timeouts": self._total_timeouts,
            "domains_blocked": sum(1 for v in self._domain_blocks.values() if v >= BLOCK_THRESHOLD),
        }

    def _wayback_fetch(self, url: str) -> Optional[requests.Response]:
        """Fetch cached page from Wayback Machine. web.archive.org is Tor-friendly."""
        wb_url = f"https://web.archive.org/web/2/{url}"
        try:
            headers = _pick_profile()
            resp = self._session.get(wb_url, headers=headers, timeout=20)
            if resp.status_code == 200:
                integrity_log("intel", f"wayback_ok:{urlparse(url).netloc}")
                return resp
            integrity_log("intel", f"wayback_fail:{urlparse(url).netloc}:status={resp.status_code}")
        except requests.exceptions.Timeout:
            integrity_log("intel", f"wayback_timeout:{urlparse(url).netloc}")
        except requests.exceptions.ConnectionError:
            integrity_log("intel", f"wayback_conn_error:{urlparse(url).netloc}")
        except Exception as e:
            integrity_log("intel", f"wayback_error:{urlparse(url).netloc}:{type(e).__name__}")
        return None

    def post_json(self, url: str, json_data: dict, **kwargs) -> Optional[requests.Response]:
        """POST JSON request (for APIs like crt.sh)."""
        if shutdown_requested():
            return None
        domain = urlparse(url).netloc
        if self.is_domain_blocked(domain):
            return None
        self._delay_for_domain(domain)
        self._maybe_rotate_circuit()
        headers = _pick_profile()
        headers["Content-Type"] = "application/json"
        kwargs.setdefault("timeout", REQUEST_TIMEOUT)
        self._total_requests += 1
        try:
            self._domain_last[domain] = time.time()
            resp = self._session.post(url, json=json_data, headers=headers, **kwargs)
            if resp.status_code in (403, 429, 503):
                self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                self._total_blocks += 1
            return resp
        except (requests.exceptions.Timeout, requests.exceptions.ConnectionError):
            self._total_timeouts += 1
            return None

    def post_form(self, url: str, form_data: dict, **kwargs) -> Optional[requests.Response]:
        """POST form-encoded data (for testing HTML forms)."""
        if shutdown_requested():
            return None
        domain = urlparse(url).netloc
        if self.is_domain_blocked(domain):
            return None
        self._delay_for_domain(domain)
        self._maybe_rotate_circuit()
        headers = _pick_profile()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
        kwargs.setdefault("timeout", REQUEST_TIMEOUT)
        self._total_requests += 1
        try:
            self._domain_last[domain] = time.time()
            resp = self._session.post(url, data=form_data, headers=headers, **kwargs)
            if resp.status_code in (403, 429, 503):
                self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                self._total_blocks += 1
            return resp
        except (requests.exceptions.Timeout, requests.exceptions.ConnectionError):
            self._total_timeouts += 1
            return None

    def close(self):
        self._session.close()


