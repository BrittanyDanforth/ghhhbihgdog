        return findings

    @staticmethod
    def _add_confidence(findings: List[dict], base_confidence: float) -> List[dict]:
        """Add confidence score to findings.

        Confidence represents how reliably the finding is a real issue:
          1.0 = confirmed (e.g., we got /etc/passwd content back)
          0.9 = very likely (e.g., error-based SQLi, canary reflected as HTML)
          0.7 = likely (e.g., header missing, sensitive path accessible)
          0.5 = possible (e.g., pattern match that could be false positive)
          0.3 = informational (e.g., robots.txt exists)

        Exploitable findings get +0.1 confidence (we verified the exploit works).
        """
        for f in findings:
            if "confidence" not in f:
                conf = base_confidence
                if f.get("exploitable"):
                    conf = min(conf + 0.1, 1.0)
                if f.get("severity") == SEV_CRITICAL:
                    conf = max(conf, 0.8)
                f["confidence"] = round(conf, 2)
        return findings

    def _run_check(self, name: str, check_fn, args: tuple, confidence: float,
                   findings: list):
        """Run a single vuln check with timeout protection and progress display.

        If a check hangs (network timeout, slow response), it's skipped
        after 60 seconds instead of blocking the entire scan.
        """
        if shutdown_requested():
            return
        print(f"      checking {name}...", end="", flush=True)
        try:
            result = check_fn(*args)
            if result:
                result = self._add_confidence(result, confidence)
                findings.extend(result)
                print(f" {len(result)} finding(s)")
            else:
                print(" clean")
        except requests.exceptions.Timeout:
            print(" timeout (skipped)")
            integrity_log("intel", f"check_timeout:{name}")
        except requests.exceptions.ConnectionError:
            print(" connection failed (skipped)")
            integrity_log("intel", f"check_conn_fail:{name}")
        except re.error as e:
            print(f" regex error (skipped)")
            integrity_log("intel", f"check_regex_error:{name}:{e}")
        except Exception as e:
            print(f" error: {type(e).__name__} (skipped)")
            integrity_log("intel", f"check_error:{name}:{type(e).__name__}")

    def scan_full(self, base_url: str, html: str = "", headers: dict = None,
                  depth: str = "full") -> List[dict]:
        """Run all applicable vulnerability checks with progress display.

        Each check runs independently — one failure doesn't block others.
        Progress shown inline so the user knows it's not stuck.
        """
        if headers is None:
            headers = {}
        findings = []

        # Extract real params from the page HTML for targeted testing
        if html:
            self.extract_params_from_html(html, base_url)
            if self._page_params:
                print(f"      found {len(self._page_params)} testable parameters")

        # Header checks (instant, no network)
        self._run_check("security headers", self._check_security_headers,
                        (headers,), 0.95, findings)
        self._run_check("cookies", self._check_cookies, (headers,), 0.9, findings)
        self._run_check("CORS", self._check_cors, (base_url, headers), 0.85, findings)
        self._run_check("info disclosure", self._check_info_disclosure,
                        (headers, html), 0.8, findings)
        self._run_check("clickjacking", self._check_clickjacking,
                        (headers,), 0.9, findings)

        if depth in ("full", "deep"):
            # Network checks (can be slow)
            self._run_check("sensitive paths", self._check_sensitive_paths,
                            (base_url,), 0.75, findings)
            self._run_check("HTTP methods", self._check_http_methods,
                            (base_url,), 0.7, findings)
            self._run_check("open redirect", self._check_open_redirect,
                            (base_url,), 0.85, findings)

            # For full depth: basic SQLi/XSS on base URL (quick probe)
            if depth == "full":
                self._run_check("SQL injection (quick)", self._check_sqli_indicators,
                                (base_url,), 0.85, findings)
                self._run_check("XSS reflection (quick)", self._check_xss_reflection,
                                (base_url,), 0.85, findings)

        if depth == "deep":
            # Infrastructure checks (against base URL)
            self._run_check("SSL/TLS", self._check_ssl_cert,
                            (base_url,), 0.85, findings)
            self._run_check("GraphQL introspection", self._check_graphql_introspection,
                            (base_url,), 0.95, findings)
            self._run_check("directory traversal", self._check_directory_traversal,
                            (base_url,), 0.95, findings)

            # Crawl to discover real endpoints with parameters
            if html:
                self._run_check("crawling for endpoints", self.crawl_for_endpoints,
                                (base_url, html), 0.0, [])

            # Per-endpoint active testing — this is where real vulns are found
            endpoints = self._crawled_urls
            if not endpoints:
                endpoints = [{"url": base_url, "params": [{"name": p, "value": "1",
                              "hidden": False, "type": "text"}
                              for p in self._get_test_params(["id", "q", "search"])],
                              "method": "GET", "source": "fallback"}]

            # Reset circuit breaker before active testing.
            # Crawling and infra checks may have accumulated blocks from 403s
            # on nonexistent paths — those are expected, not real blocks.
            domain = urlparse(base_url).netloc
            self._session.reset_domain_blocks(domain)

            print(f"      testing {len(endpoints)} discovered endpoint(s)...")
            tested = 0
            skipped_blocked = 0
            for ep in endpoints[:20]:
                if shutdown_requested():
                    break
                if self._session.is_domain_blocked(urlparse(ep["url"]).netloc):
                    skipped_blocked += 1
                    if skipped_blocked >= 3:
                        print(f"\n      (stopped: domain is blocking active probes)")
                        break
                    continue
                tested += 1
                path = urlparse(ep["url"]).path or "/"
                params_str = ",".join(p["name"] for p in ep["params"][:3])
                print(f"        [{tested}] {ep['method']} {path} ({params_str})", end="", flush=True)

                ep_findings = []
                try:
                    sqli = self._test_endpoint_sqli(ep)
                    ep_findings.extend(sqli)
                except Exception as e:
                    integrity_log("intel", f"sqli_error:{path}:{type(e).__name__}")

                try:
                    xss = self._test_endpoint_xss(ep)
                    ep_findings.extend(xss)
                except Exception as e:
                    integrity_log("intel", f"xss_error:{path}:{type(e).__name__}")

                try:
                    lfi = self._test_endpoint_lfi(ep)
                    ep_findings.extend(lfi)
                except Exception as e:
                    integrity_log("intel", f"lfi_error:{path}:{type(e).__name__}")

                try:
                    ssti = self._test_endpoint_ssti(ep)
                    ep_findings.extend(ssti)
                except Exception as e:
                    integrity_log("intel", f"ssti_error:{path}:{type(e).__name__}")

                try:
                    crlf = self._test_endpoint_crlf(ep)
                    ep_findings.extend(crlf)
                except Exception as e:
                    integrity_log("intel", f"crlf_error:{path}:{type(e).__name__}")

                if ep_findings:
                    self._add_confidence(ep_findings, 0.9)
                    findings.extend(ep_findings)
                    print(f" -> {len(ep_findings)} FOUND")
                else:
                    print(f" -> clean")

            # Also run SSRF/LFI/cmd injection against base URL with page params
            self._run_check("SSRF", self._check_ssrf_indicators,
                            (base_url,), 0.9, findings)
            self._run_check("LFI", self._check_lfi, (base_url,), 0.95, findings)
            self._run_check("command injection", self._check_command_injection,
                            (base_url,), 0.95, findings)

        return findings

    def _check_security_headers(self, headers: dict) -> List[dict]:
        """Check for missing or weak security headers."""
        findings = []
        h = {k.lower(): v for k, v in headers.items()}

        checks = [
            ("strict-transport-security", SEV_MEDIUM,
             "Missing HSTS", "Site doesn't enforce HTTPS via HSTS header. "
             "Users can be downgraded to HTTP via MITM."),
            ("content-security-policy", SEV_MEDIUM,
             "Missing Content-Security-Policy", "No CSP header. "
             "XSS attacks can load scripts from any origin."),
            ("x-frame-options", SEV_MEDIUM,
             "Missing X-Frame-Options", "Page can be embedded in iframes. "
             "Vulnerable to clickjacking attacks."),
            ("x-content-type-options", SEV_LOW,
             "Missing X-Content-Type-Options", "Browser may MIME-sniff "
             "responses, enabling content-type confusion attacks."),
            ("referrer-policy", SEV_LOW,
             "Missing Referrer-Policy", "Full URL may be leaked in "
             "Referer header to third-party sites."),
            ("permissions-policy", SEV_LOW,
             "Missing Permissions-Policy", "Browser features (camera, "
             "mic, geolocation) not explicitly restricted."),
        ]

        for header, sev, title, detail in checks:
            if header not in h:
                findings.append({"severity": sev, "title": title,
                                 "detail": detail, "evidence": f"Header '{header}' absent"})

        # Check HSTS quality
        hsts = h.get("strict-transport-security", "")
        if hsts:
            if "max-age=0" in hsts:
                findings.append({"severity": SEV_HIGH, "title": "HSTS disabled (max-age=0)",
                                 "detail": "HSTS is explicitly disabled.",
                                 "evidence": f"HSTS: {hsts}"})
            elif "max-age" in hsts:
                try:
                    age = int(re.search(r"max-age=(\d+)", hsts).group(1))
                    if age < 15768000:  # < 6 months
                        findings.append({"severity": SEV_LOW, "title": "HSTS max-age too short",
                                         "detail": f"max-age={age} ({age//86400} days). Recommended: 1 year+.",
                                         "evidence": f"HSTS: {hsts}"})
                except (AttributeError, ValueError):
                    pass

        # Check CSP quality
        csp = h.get("content-security-policy", "")
        if csp:
            if "unsafe-inline" in csp:
                findings.append({"severity": SEV_MEDIUM, "title": "CSP allows unsafe-inline",
                                 "detail": "Inline scripts/styles permitted, weakening XSS protection.",
                                 "evidence": "CSP contains 'unsafe-inline'"})
            if "unsafe-eval" in csp:
                findings.append({"severity": SEV_MEDIUM, "title": "CSP allows unsafe-eval",
                                 "detail": "eval() permitted in scripts, enabling code injection.",
                                 "evidence": "CSP contains 'unsafe-eval'"})
            if "'*'" in csp or "* " in csp:
                findings.append({"severity": SEV_HIGH, "title": "CSP has wildcard source",
                                 "detail": "Wildcard allows loading resources from any origin.",
                                 "evidence": "CSP contains '*'"})

        return findings

    def _check_cookies(self, headers: dict) -> List[dict]:
        """Audit Set-Cookie headers for security flags."""
        findings = []
        for key, val in headers.items():
            if key.lower() != "set-cookie":
                continue
            cookie_name = val.split("=")[0].strip() if "=" in val else "unknown"
            val_lower = val.lower()

            if "secure" not in val_lower:
                findings.append({"severity": SEV_MEDIUM, "title": f"Cookie '{cookie_name}' missing Secure flag",
                                 "detail": "Cookie sent over HTTP (unencrypted), exposable via MITM.",
                                 "evidence": f"Set-Cookie: {val[:80]}"})
            if "httponly" not in val_lower:
                findings.append({"severity": SEV_MEDIUM, "title": f"Cookie '{cookie_name}' missing HttpOnly flag",
                                 "detail": "Cookie accessible via JavaScript — stealable via XSS.",
                                 "evidence": f"Set-Cookie: {val[:80]}"})
            if "samesite" not in val_lower:
                findings.append({"severity": SEV_LOW, "title": f"Cookie '{cookie_name}' missing SameSite flag",
                                 "detail": "Cookie sent on cross-site requests — CSRF risk.",
                                 "evidence": f"Set-Cookie: {val[:80]}"})
        return findings

    def _check_cors(self, url: str, headers: dict) -> List[dict]:
        """Check for CORS misconfiguration."""
        findings = []
        acao = headers.get("Access-Control-Allow-Origin", headers.get("access-control-allow-origin", ""))

        if acao == "*":
            acac = headers.get("Access-Control-Allow-Credentials", "").lower()
            sev = SEV_HIGH if acac == "true" else SEV_MEDIUM
            findings.append({
                "severity": sev,
                "title": "CORS allows any origin" + (" WITH credentials" if acac == "true" else ""),
                "detail": "Access-Control-Allow-Origin: * permits any website to read responses." +
                          (" Combined with credentials=true, this is exploitable." if acac == "true" else ""),
                "evidence": f"ACAO: {acao}, ACAC: {acac or 'absent'}"
            })

        # Test reflective CORS — send Origin header and check if reflected
        if not acao:
            evil_origin = "https://evil-attacker.com"
            resp = self._session.get(url, allow_wayback=False,
                                     headers={"Origin": evil_origin})
            if resp and resp.headers.get("Access-Control-Allow-Origin") == evil_origin:
                findings.append({
                    "severity": SEV_HIGH,
                    "title": "Reflective CORS — arbitrary origin accepted",
                    "detail": "Server reflects any Origin header in ACAO. "
                              "Attacker can read authenticated responses.",
                    "evidence": f"Sent Origin: {evil_origin}, Got ACAO: {evil_origin}"
                })
        return findings

    def _check_info_disclosure(self, headers: dict, html: str) -> List[dict]:
        """Check for information disclosure in headers and HTML."""
        findings = []

        # Server version strings
        server = headers.get("Server", "")
        if server and re.search(r"\d+\.\d+", server):
            findings.append({"severity": SEV_LOW, "title": "Server version disclosed",
                             "detail": f"Server header reveals version info. Aids attacker reconnaissance.",
                             "evidence": f"Server: {server[:80]}"})

        powered = headers.get("X-Powered-By", "")
        if powered:
            findings.append({"severity": SEV_LOW, "title": "X-Powered-By header present",
                             "detail": "Technology stack revealed. Remove this header.",
                             "evidence": f"X-Powered-By: {powered[:80]}"})

        # Debug headers
        for debug_h in ["X-Debug-Token", "X-Debug-Info", "X-Debug-Link"]:
            if debug_h in headers or debug_h.lower() in {k.lower() for k in headers}:
                findings.append({"severity": SEV_HIGH, "title": f"Debug header present: {debug_h}",
                                 "detail": "Debug mode likely enabled in production.",
                                 "evidence": f"{debug_h} header found"})

        # Stack traces in HTML
        stack_patterns = [
            (re.compile(r"Traceback \(most recent call last\)", re.I), "Python stack trace"),
            (re.compile(r"at\s+\w+\.\w+\([\w.]+:\d+\)", re.I), "Java/.NET stack trace"),
            (re.compile(r"Fatal error:.*on line \d+", re.I), "PHP fatal error"),
            (re.compile(r"Exception in thread", re.I), "Java exception"),
        ]
        for pat, desc in stack_patterns:
            if pat.search(html[:20000]):
                findings.append({"severity": SEV_HIGH, "title": f"Stack trace in response: {desc}",
                                 "detail": "Error details visible to users. Reveals internal paths, "
                                           "library versions, and potential attack vectors.",
                                 "evidence": desc})
                break

        return findings

    def _check_clickjacking(self, headers: dict) -> List[dict]:
        """Check clickjacking protection."""
        h = {k.lower(): v for k, v in headers.items()}
        xfo = h.get("x-frame-options", "")
        csp = h.get("content-security-policy", "")

        if not xfo and "frame-ancestors" not in csp:
            return [{"severity": SEV_MEDIUM, "title": "Clickjacking possible",
                     "detail": "No X-Frame-Options or CSP frame-ancestors. "
                               "Page can be embedded in attacker iframes.",
                     "evidence": "Neither X-Frame-Options nor frame-ancestors directive found"}]
        return []

    def _check_sensitive_paths(self, base_url: str) -> List[dict]:
        """Probe for exposed sensitive files and directories.

        Uses domain circuit breaker — if the site is actively blocking us,
        stops probing after BLOCK_THRESHOLD failures instead of trying all 26 paths.

        Soft-404 detection: many sites return HTTP 200 for nonexistent paths
        with a generic "not found" page. We first fetch a known-nonexistent path
        to get the baseline 404 page length, then compare against it.
        """
        findings = []
        domain = urlparse(base_url).netloc
        total = len(self.SENSITIVE_PATHS)
        skipped = 0

        # Soft-404 baseline: fetch a random path that definitely doesn't exist
        _baseline_url = urljoin(base_url, f"/gs_nonexistent_{secrets.token_hex(4)}")
        _baseline_resp = self._session.get(_baseline_url, allow_wayback=False, method="GET")
        _soft404_length = len(_baseline_resp.text) if _baseline_resp and _baseline_resp.status_code == 200 else -1
        _soft404_patterns = re.compile(
            r"not\s*found|404|page\s*(does\s*not|doesn.t)\s*exist|no\s*such\s*page|"
            r"this\s*page\s*could\s*not|we\s*couldn.t\s*find|error\s*404",
            re.I
        )

        for idx, (path, title, severity, detail) in enumerate(self.SENSITIVE_PATHS):
            if shutdown_requested():
                break
            if self._session.is_domain_blocked(domain):
                skipped = total - idx
                break

            url = urljoin(base_url, path)
            resp = self._session.get(url, allow_wayback=False, method="HEAD")
            if resp and resp.status_code == 200:
                if severity in (SEV_CRITICAL, SEV_HIGH):
                    resp_full = self._session.get(url, allow_wayback=False)
                    if resp_full and resp_full.status_code == 200 and len(resp_full.text) > 10:
                        body = resp_full.text
                        # Soft-404 check: skip if body matches baseline or has 404 patterns
                        if _soft404_length > 0 and abs(len(body) - _soft404_length) < 100:
                            continue
                        if _soft404_patterns.search(body[:1000]):
                            continue
                        # For git/env, verify content looks real
                        if path == "/.git/HEAD" and "ref:" not in body[:100]:
                            continue
                        if path == "/.env" and "=" not in body[:500]:
                            continue
                        findings.append({"severity": severity, "title": title,
                                         "detail": detail, "evidence": f"HTTP 200 at {path}",
                                         "path": path, "content_length": len(body)})
                else:
                    # For INFO/LOW/MEDIUM: check for soft-404 to avoid false positives
                    # on sites that return 200 with generic pages for every path
                    if severity in (SEV_INFO, SEV_LOW, SEV_MEDIUM) and _soft404_length > 0:
                        resp_check = self._session.get(url, allow_wayback=False)
                        if resp_check:
                            if abs(len(resp_check.text) - _soft404_length) < 100:
                                continue
                            if _soft404_patterns.search(resp_check.text[:1000]):
                                continue
                    findings.append({"severity": severity, "title": title,
                                     "detail": detail, "evidence": f"HTTP 200 at {path}",
                                     "path": path})

        if skipped:
            print(f"        (skipped {skipped} paths — site is blocking probes)")
        return findings

    def _check_http_methods(self, base_url: str) -> List[dict]:
        """Check for dangerous HTTP methods enabled."""
        findings = []
        domain = urlparse(base_url).netloc
        if self._session.is_domain_blocked(domain):
            return findings

        try:
            self._session._delay_for_domain(domain)
            self._session._maybe_rotate_circuit()
            opt_resp = self._session._session.options(base_url, timeout=REQUEST_TIMEOUT,
                                                       proxies=self._session._proxy,
                                                       headers=_pick_profile())
            if opt_resp and opt_resp.status_code == 200:
                allow = opt_resp.headers.get("Allow", "")
                if allow:
                    dangerous = {"PUT", "DELETE", "TRACE", "PATCH"}
                    allowed = {m.strip().upper() for m in allow.split(",")}
                    found = dangerous & allowed
                    if found:
                        findings.append({
                            "severity": SEV_MEDIUM if "TRACE" not in found else SEV_HIGH,
                            "title": f"Dangerous HTTP methods enabled: {', '.join(sorted(found))}",
                            "detail": "TRACE enables Cross-Site Tracing (XST). "
                                      "PUT/DELETE may allow file manipulation." if "TRACE" in found
                                      else "PUT/DELETE methods may allow unauthorized file modification.",
                            "evidence": f"Allow: {allow}"
                        })
        except Exception as e:
            integrity_log("intel", f"http_methods_error:{type(e).__name__}")
        return findings

    def _check_open_redirect(self, base_url: str) -> List[dict]:
        """Check for open redirect vulnerabilities."""
        findings = []
        evil_target = "https://evil-attacker.com/pwned"
        domain = urlparse(base_url).netloc

        for param in self.REDIRECT_PARAMS[:5]:
            if shutdown_requested():
                break
            if self._session.is_domain_blocked(domain):
                break
            test_url = f"{base_url}?{param}={quote(evil_target)}"
            try:
                self._session._delay_for_domain(domain)
                self._session._maybe_rotate_circuit()
                resp = self._session._session.get(
                    test_url, timeout=REQUEST_TIMEOUT, allow_redirects=False,
                    proxies=self._session._proxy, headers=_pick_profile()
                )
                if resp and resp.status_code in (301, 302, 303, 307, 308):
                    location = resp.headers.get("Location", "")
                    # Must check that the redirect HOST is the attacker, not just
                    # that the attacker URL appears somewhere in query params
                    loc_parsed = urlparse(location)
                    if loc_parsed.netloc and "evil-attacker.com" in loc_parsed.netloc:
                        findings.append({
                            "severity": SEV_MEDIUM,
                            "title": f"Open redirect via '{param}' parameter",
                            "detail": "Server redirects to attacker-controlled URL. "
                                      "Usable for phishing and OAuth token theft.",
                            "evidence": f"?{param}={evil_target} → Location: {location[:100]}",
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "open_redirect",
                                "parameter": param,
                                "method": f"Redirect users via '{param}' parameter to phishing page. "
                                          "Chain with OAuth flows to steal authorization codes.",
                                "risk": "Phishing, OAuth token theft, trust exploitation",
                            },
                        })
                        break  # One is enough to confirm
            except Exception as e:
                integrity_log("intel", f"_check_open_redirect_error:{type(e).__name__}")
        return findings

    def _check_sqli_indicators(self, base_url: str) -> List[dict]:
        """Detect SQL injection indicators via error-based detection with baseline comparison.

        Sends a clean request first, then an apostrophe-injected request. Only flags as SQLi
        if the SQL error pattern appears ONLY in the injected response (not the baseline),
        which eliminates false positives from generic error pages or debug-mode sites that
        always show SQL traces.
        """
        findings = []
        test_params = self._get_test_params(["id", "page", "q", "search", "user", "item", "cat"])

        for param in test_params[:5]:
            if shutdown_requested():
                break
            # Baseline: clean request with a safe value
            baseline_url = f"{base_url}?{param}=1"
            baseline_resp = self._session.get(baseline_url, allow_wayback=False)
            baseline_text = baseline_resp.text[:5000] if baseline_resp else ""

            # Payload: single apostrophe injection
            test_url = f"{base_url}?{param}=1%27"
            resp = self._session.get(test_url, allow_wayback=False)
            if resp and resp.text:
                for indicator in self.SQLI_INDICATORS:
                    # Only count if the pattern is NEW in the injected response
                    in_payload = indicator.search(resp.text[:5000])
                    in_baseline = indicator.search(baseline_text) if baseline_text else False
                    if in_payload and not in_baseline:
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": f"SQL injection indicator via '{param}' parameter",
                            "detail": "SQL error message appears ONLY in response to apostrophe injection "
                                      "(not in baseline). Input likely reaches SQL query without parameterization.",
                            "evidence": f"Parameter: {param}, matched: {indicator.pattern[:60]}",
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "sqli",
                                "parameter": param,
                                "method": f"Inject SQL via '{param}' parameter. Error-based confirmed. "
                                          "Try: UNION SELECT, boolean-based blind, time-based blind.",
                                "risk": "Database access, data exfiltration, potential RCE via INTO OUTFILE",
                            },
                        })
                        return findings
        return findings

    def _check_xss_reflection(self, base_url: str) -> List[dict]:
        """Detect reflected XSS by checking if a unique canary is reflected unescaped.

        Uses a fresh canary per scan (generated at class init) to avoid
        cached responses matching. Also checks that the reflection isn't
        inside a WAF/block page (which would be a false positive).
        """
        findings = []
        canary = f"gs{secrets.token_hex(4)}test"
        test_params = self._get_test_params(["q", "search", "query", "s", "name", "input"])

        for param in test_params[:5]:
            if shutdown_requested():
                break
            payload = f"<{canary}>"
            test_url = f"{base_url}?{param}={quote(payload)}"
            resp = self._session.get(test_url, allow_wayback=False)
            if resp and resp.text:
                # Reject WAF/block pages — canary might appear in error text
                if resp.status_code in (403, 429, 503):
                    continue
                text_lower = resp.text[:5000].lower()
                if any(kw in text_lower for kw in ("blocked", "forbidden", "access denied", "waf")):
                    if len(resp.text) < 2000:
                        continue

                if f"<{canary}>" in resp.text:
                    # Verify it's reflected in a context that would execute JS
                    # (not inside a <pre>, <textarea>, or HTML comment)
                    reflected_idx = resp.text.index(f"<{canary}>")
                    context = resp.text[max(0, reflected_idx - 100):reflected_idx + 100]
                    in_safe_context = any(tag in context.lower() for tag in
                                         ["<pre>", "<textarea", "<code>", "<!--"])
                    if in_safe_context:
                        confidence_penalty = 0.2
                    else:
                        confidence_penalty = 0

                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"Reflected XSS via '{param}' parameter",
                        "detail": "HTML input reflected unescaped in response. "
                                  "Attacker can inject arbitrary JavaScript.",
                        "evidence": f"Parameter: {param}, canary <{canary}> reflected as HTML",
                        "exploitable": True,
                        "test_url": test_url,
                        "exploit_info": {
                            "type": "xss",
                            "parameter": param,
                            "method": f"Inject JavaScript via '{param}' parameter. "
                                      "Payload: <script>alert(document.cookie)</script>. "
                                      "Use for session hijacking, keylogging, phishing.",
                            "risk": "Session theft, credential capture, client-side attacks",
                        },
                    })
                    if confidence_penalty:
                        findings[-1]["confidence"] = 0.7
                    return findings
        return findings

    def _check_directory_traversal(self, base_url: str) -> List[dict]:
        """Detect directory/path traversal indicators."""
        findings = []
        traversal_payloads = [
            ("..%2F..%2F..%2Fetc%2Fpasswd", "/etc/passwd content"),
            ("....//....//....//etc/passwd", "/etc/passwd content"),
        ]
        # Indicators that traversal succeeded
        passwd_indicators = [
            re.compile(r"root:.*:0:0:", re.I),
            re.compile(r"daemon:.*:/usr/sbin", re.I),
        ]

        for payload, desc in traversal_payloads[:1]:
            if shutdown_requested():
                break
            test_url = f"{base_url}/{payload}"
            resp = self._session.get(test_url, allow_wayback=False)
            if resp and resp.text:
                for ind in passwd_indicators:
                    if ind.search(resp.text[:2000]):
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": "Directory traversal — /etc/passwd readable",
                            "detail": "Path traversal allows reading arbitrary system files. "
                                      "Full filesystem access likely possible.",
                            "evidence": f"Payload: {payload}, {desc} detected",
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "directory_traversal",
                                "parameter": "path",
                                "method": "Path traversal to read arbitrary files. "
                                          "Try: /etc/shadow, application configs, database files, "
                                          "source code, SSH keys (~/.ssh/id_rsa).",
                                "risk": "Full filesystem read, credential theft, source code exposure",
                            },
                        })
