#  Request Capture — records every request/response for replay & PoC export
# ══════════════════════════════════════════════════════════════════════════

class CapturedRequest:
    """Immutable record of an HTTP request/response pair."""
    __slots__ = ("method", "url", "headers", "body", "status_code",
                 "response_headers", "response_body_hash", "response_length",
                 "timestamp", "tor_circuit_id")

    def __init__(self, method: str, url: str, headers: dict, body: str,
                 status_code: int, resp_headers: dict, resp_body: str):
        self.method = method
        self.url = url
        self.headers = dict(headers)
        self.body = body or ""
        self.status_code = status_code
        self.response_headers = dict(resp_headers) if resp_headers else {}
        self.response_body_hash = hashlib.sha256(resp_body.encode()[:10000]).hexdigest()[:16] if resp_body else ""
        self.response_length = len(resp_body) if resp_body else 0
        self.timestamp = int(time.time()) // 600 * 600
        self.tor_circuit_id = secrets.token_hex(4)

    def to_curl(self, redact: bool = True) -> str:
        """Generate a curl command that reproduces this request.

        OPSEC: redacts cookies, auth headers, and API keys by default.
        Uses the operator's actual Tor port (not hardcoded 9050).
        """
        parts = ["curl"]
        if self.method != "GET":
            parts.append(f"-X {self.method}")
        parts.append(f"--socks5-hostname 127.0.0.1:{_ACTIVE_TOR_PORT}")
        for k, v in self.headers.items():
            if redact and k.lower() in ("cookie", "authorization", "hibp-api-key"):
                v = "[REDACTED]"
            parts.append(f'-H "{k}: {v}"')
        if self.body:
            safe_body = self.body if not redact else re.sub(
                r'(password|token|key|secret)(["\s:=]+)([^\s"&]+)',
                r'\1\2[REDACTED]', self.body, flags=re.I)
            parts.append(f"-d '{safe_body}'")
        parts.append(f'"{self.url}"')
        return " \\\n  ".join(parts)

    def to_raw_http(self, redact: bool = True) -> str:
        """Generate raw HTTP request format."""
        parsed = urlparse(self.url)
        path = parsed.path or "/"
        if parsed.query:
            path += f"?{parsed.query}"
        lines = [f"{self.method} {path} HTTP/1.1"]
        lines.append(f"Host: {parsed.netloc}")
        for k, v in self.headers.items():
            if k.lower() == "host":
                continue
            if redact and k.lower() in ("cookie", "authorization", "hibp-api-key"):
                v = "[REDACTED]"
            lines.append(f"{k}: {v}")
        if self.body:
            lines.append("")
            lines.append(self.body if not redact else "[body redacted]")
        return "\r\n".join(lines)

    def to_dict(self) -> dict:
        return {
            "method": self.method, "url": self.url,
            "status": self.status_code,
            "response_hash": self.response_body_hash,
            "response_length": self.response_length,
        }


class RequestLog:
    """Thread-safe log of captured requests for a scan session.

    The class advertises thread safety because consumers (ExploitVerifier,
    FindingChain, PoCExporter) reach into the list from different call
    sites and concurrency could grow later. A threading.Lock around every
    list mutation / iteration is cheap and makes the contract honest.
    """

    def __init__(self):
        self._requests: List[CapturedRequest] = []
        self._lock = threading.Lock()

    def capture(self, method: str, url: str, headers: dict, body: str,
                resp: Optional[requests.Response]) -> CapturedRequest:
        """Record a request/response pair."""
        cr = CapturedRequest(
            method=method, url=url, headers=headers, body=body or "",
            status_code=resp.status_code if resp else 0,
            resp_headers=dict(resp.headers) if resp else {},
            resp_body=resp.text[:50000] if resp else "",
        )
        with self._lock:
            self._requests.append(cr)
        return cr

    def get_for_url(self, url: str) -> List[CapturedRequest]:
        with self._lock:
            return [r for r in self._requests if r.url == url]

    def get_all(self) -> List[CapturedRequest]:
        with self._lock:
            return list(self._requests)

    def clear(self):
        with self._lock:
            self._requests.clear()


# ══════════════════════════════════════════════════════════════════════════
#  Exploit Verifier — replays requests, diffs responses, adjusts confidence
# ══════════════════════════════════════════════════════════════════════════

class ExploitVerifier:
    """Replay exploit requests and verify findings are real.

    For each exploitable finding:
    1. Replay the original request through a new Tor circuit
    2. Compare response to original (hash, length, key indicators)
    3. If response matches → confirmed (confidence stays/increases)
    4. If response differs significantly → lower confidence
    5. If request fails → mark as unverified
    """

    def __init__(self, session: TorSession, request_log: RequestLog):
        self._session = session
        self._log = request_log

    def verify_finding(self, finding: dict) -> dict:
        """Verify a single finding by replaying its request.

        Returns the finding with updated confidence and verification status.
        """
        ei = finding.get("exploit_info", {})
        if not ei:
            finding["verified"] = "no_exploit_info"
            return finding

        # Rotate circuit before replay for clean state
        newnym()
        time.sleep(2 + secrets.randbelow(3000) / 1000.0)

        exploit_type = ei.get("type", "")
        original_conf = finding.get("confidence", 0.5)

        # Find the original request for this finding
        evidence = finding.get("evidence", "")

        # Build replay URL from exploit info
        replay_url = self._build_replay_url(finding)
        if not replay_url:
            finding["verified"] = "cannot_build_replay"
            return finding

        # Execute replay
        try:
            if exploit_type == "graphql_introspection":
                resp = self._session._session.post(
                    replay_url,
                    json={"query": "{ __schema { types { name } } }"},
                    timeout=15, proxies=self._session._proxy,
                    headers=_pick_profile(),
                )
            else:
                resp = self._session.get(replay_url, allow_wayback=False)

            if resp is None:
                finding["verified"] = "replay_failed"
                finding["confidence"] = max(original_conf - 0.2, 0.1)
                return finding

            # Verify based on exploit type
            confirmed = self._check_replay_result(exploit_type, resp, finding)
            if confirmed:
                finding["verified"] = "confirmed"
                finding["confidence"] = min(original_conf + 0.05, 1.0)
            else:
                finding["verified"] = "not_reproduced"
                finding["confidence"] = max(original_conf - 0.3, 0.1)

        except Exception as e:
            finding["verified"] = f"error:{type(e).__name__}"
            finding["confidence"] = max(original_conf - 0.15, 0.1)
            integrity_log("intel", f"verify_error:{exploit_type}:{type(e).__name__}")

        return finding

    def _build_replay_url(self, finding: dict) -> Optional[str]:
        """Build the replay URL from finding metadata.

        Priority:
        1. test_url field (set by vuln scanner with the exact URL that triggered the finding)
        2. path in exploit_info (for file/endpoint findings)
        3. URL extracted from evidence text
        """
        # 1. Direct test URL from scanner (most reliable)
        test_url = finding.get("test_url")
        if test_url:
            return test_url

        ei = finding.get("exploit_info", {})

        # 2. Path-based (e.g., /graphql, /.git/HEAD)
        path = ei.get("path", "")
        if path:
            # Try to extract base URL from evidence or other fields
            evidence = finding.get("evidence", "")
            url_match = re.search(r"https?://[^/\s]+", evidence)
            if url_match:
                return url_match.group(0).rstrip("/") + path

        # 3. URL in evidence
        evidence = finding.get("evidence", "")
        url_match = re.search(r"https?://[^\s,)\"']+", evidence)
        if url_match:
            return url_match.group(0)

        return None

    def _check_replay_result(self, exploit_type: str, resp: requests.Response,
                              finding: dict) -> bool:
        """Check if replay response confirms the finding."""
        text = resp.text[:10000] if resp.text else ""

        if exploit_type == "sqli":
            for pat in VulnScanner.SQLI_INDICATORS:
                if pat.search(text):
                    return True

        elif exploit_type == "xss":
            canary = finding.get("evidence", "")
            canary_match = re.search(r"<(gs[a-f0-9]+test)>", canary)
            if canary_match and f"<{canary_match.group(1)}>" in text:
                return True

        elif exploit_type == "lfi":
            if re.search(r"root:.*:0:0:", text):
                return True

        elif exploit_type == "command_injection":
            # Check for any echo marker pattern
            if re.search(r"gs[a-f0-9]{8}(rce|verify)", text):
                return True

        elif exploit_type == "graphql_introspection":
            try:
                data = resp.json()
                if data.get("data", {}).get("__schema"):
                    return True
            except (ValueError, AttributeError):
                pass

        elif exploit_type == "ssrf":
            aws_indicators = ["ami-id", "instance-id", "instance-type"]
            matches = sum(1 for ind in aws_indicators if ind in text.lower())
            if matches >= 2:
                return True

        elif exploit_type == "subdomain_takeover":
            # Use the service fingerprint from the original finding for verification
            ei = finding.get("exploit_info", {})
            service = ei.get("service", "")
            takeover_fingerprints = {
                "GitHub Pages": "there isn't a github pages site here",
                "Heroku": "no-such-app",
                "AWS S3": "nosuchbucket",
                "Shopify": "sorry, this shop is currently unavailable",
                "Fastly": "fastly error: unknown domain",
            }
            fp = takeover_fingerprints.get(service, "")
            if fp and fp in text.lower():
                return True
            return False

        elif exploit_type == "directory_traversal":
            if re.search(r"root:.*:0:0:", text):
                return True

        elif exploit_type == "open_redirect":
            if resp.status_code in (301, 302, 303, 307, 308):
                location = resp.headers.get("Location", "")
                loc_host = urlparse(location).netloc
                return loc_host != "" and loc_host != urlparse(resp.url).netloc
            return False

        return False


