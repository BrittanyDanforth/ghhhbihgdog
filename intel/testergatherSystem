                        })
                    else:
                        processed['breached_accounts'].append({
                            'email': email,
                            'source': result['url']
                        })
                        
            # Crypto addresses
            for addr_type in ['BTC_ADDRESS', 'ETH_ADDRESS']:
                if data.get(addr_type):
                    for addr in data[addr_type]:
                        processed['crypto_addresses'].append({
                            'type': addr_type.replace('_ADDRESS', ''),
                            'address': addr,
                            'source': result['url']
                        })
                        
            # Potential credentials
            if data.get('SEED_PHRASE') or data.get('PRIVATE_KEY'):
                processed['credentials'].append({
