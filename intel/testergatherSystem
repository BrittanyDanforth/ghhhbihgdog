# ========== RAM-ONLY LOGGING ==========
class SecureRAMLogger:
    """Logging to RAM only with encryption"""
    
    def __init__(self, name):
        self.name = name
        self.logs = deque(maxlen=10000)  # Circular buffer
        self.key = Fernet.generate_key()
        self.cipher = Fernet(self.key)
        self.canary = secrets.token_hex(16)
        
    def _encrypt_log(self, msg):
        """Encrypt log entry"""
        if CONFIG['OPSEC']['FHE_LOGS']:
            # Placeholder for FHE - use Fernet for now
            return self.cipher.encrypt(msg.encode())
        return msg.encode()
    
    def _add_canary(self, msg):
        """Add canary token to detect tampering"""
        if CONFIG['OPSEC']['CANARY_TOKENS']:
            return f"{msg}|CANARY:{self.canary}"
        return msg
    
    def log(self, level, msg):
        """Add log entry to RAM buffer"""
        timestamp = datetime.now().isoformat()
        entry = f"[{timestamp}] [{level}] {msg}"
        entry = self._add_canary(entry)
        encrypted = self._encrypt_log(entry)
        self.logs.append(encrypted)
        
    def info(self, msg):
        self.log("INFO", msg)
        
    def error(self, msg):
        self.log("ERROR", msg)
        
    def warning(self, msg):
        self.log("WARNING", msg)
        
    def critical(self, msg):
        self.log("CRITICAL", msg)
        
    def dump_secure(self):
        """Dump logs with integrity verification"""
        return list(self.logs)
        
    def wipe(self):
        """Secure wipe of logs"""
        self.logs.clear()
        gc.collect()

# Global logger
logger = SecureRAMLogger(__name__)

