class IntelScraper:
    def __init__(self, session: TorSession):
        self._session = session
        self._extractor = DataExtractor()
        self._honeypot = HoneypotDetector()

    def scrape_url(self, url: str) -> Optional[dict]:
        t0 = time.time()
        resp = self._session.get(url)
        elapsed_ms = (time.time() - t0) * 1000
        if resp is None:
            return None
        content = resp.text
        headers = dict(resp.headers)
        # dict(resp.headers) merges duplicate Set-Cookie values with commas,
        # which breaks cookie-flag auditing when the server sets more than one
        # cookie. Capture the raw multi-valued list separately so
        # _check_cookies can audit each cookie independently.
        raw_set_cookies: List[str] = []
        try:
            raw_set_cookies = list(resp.raw.headers.getlist("Set-Cookie"))
        except (AttributeError, Exception):
            # Fallback: at least walk resp.cookies to rebuild one Set-Cookie
            # string per cookie with the flags that requests preserved.
            try:
                for ck in resp.cookies:
                    parts = [f"{ck.name}={ck.value or ''}"]
                    if ck.secure:
                        parts.append("Secure")
                    if ck.has_nonstandard_attr("HttpOnly"):
                        parts.append("HttpOnly")
                    ss = ck.get_nonstandard_attr("SameSite") if hasattr(ck, "get_nonstandard_attr") else None
                    if ss:
                        parts.append(f"SameSite={ss}")
                    raw_set_cookies.append("; ".join(parts))
            except Exception:
                pass
        hp = self._honeypot.check(content, headers, elapsed_ms, len(resp.history))
        if hp["is_honeypot"]:
            integrity_log(
                "intel",
                f"honeypot:host_tag={self._session._salt_tag(urlparse(url).netloc)}",
            )
            return {"url": url, "honeypot": True, "hp_reasons": hp["reasons"]}

        text = content
        title = ""
        meta_desc = ""
        if HAS_BS4:
            try:
                soup = BeautifulSoup(content, "html.parser")
                for tag in soup(["script", "style", "noscript"]):
                    tag.decompose()
                text = soup.get_text(separator=" ", strip=True)
                title = (soup.title.string.strip() if soup.title and soup.title.string else "")
                mt = soup.find("meta", attrs={"name": "description"})
                if mt:
                    meta_desc = mt.get("content", "")
            except Exception as e:
                integrity_log("intel", f"scrape_url_error:{type(e).__name__}")

        extracted = self._extractor.extract_all(text)
        urls = self._extractor.extract_urls(content, url)
        comments = self._extractor.extract_comments(content)
        secrets_in_comments = {}
        if comments:
            combined = " ".join(comments)
            secrets_in_comments = self._extractor.extract_all(combined)

        # ── Fetch first-party JS bundles and scan for secrets ───────
        # Front-end bundles routinely embed API keys, JWT fragments,
        # internal API paths, and debug URLs that never appear in the
        # HTML. We fetch up to _JS_MAX_FILES same-origin JS files
        # (capped at _JS_PER_FILE_CAP each, total budget
        # _JS_TOTAL_CAP) and extract the same patterns the HTML went
        # through. Caps are enforced so we don't spend 10 minutes
        # downloading 2 MB bundles on a big SPA.
        _JS_MAX_FILES = 6
        _JS_PER_FILE_CAP = 256 * 1024          # 256 KB per bundle
        _JS_TOTAL_CAP = 1_200_000              # ~1.2 MB session-wide
        js_secrets: Dict[str, List[str]] = {}
        js_urls_fetched: List[str] = []
        js_bytes_fetched = 0
        if HAS_BS4:
            try:
                base_host = urlparse(url).netloc.lower()
                soup2 = BeautifulSoup(content[:200000], "html.parser")
                js_candidates: List[str] = []
                for s in soup2.find_all("script", src=True):
                    src = s.get("src", "")
                    if not src or src.startswith(("data:", "#", "javascript:")):
                        continue
                    full = urljoin(url, src)
                    # Must look JS-like. Allow .js / .mjs / .cjs plus
                    # extensionless bundler outputs that carry a
                    # cache-busting query (/static/main.<hash>?v=...).
                    low_full = full.lower()
                    if not (low_full.endswith((".js", ".mjs", ".cjs"))
                            or ".js?" in low_full
                            or ".mjs?" in low_full):
                        continue
                    # Strict same-origin — netloc exact match OR a
                    # subdomain of base_host. Skips CDN-hosted libs.
                    jp_netloc = urlparse(full).netloc.lower()
                    if jp_netloc != base_host and not jp_netloc.endswith(
                        "." + base_host,
                    ):
                        continue
                    if full not in js_candidates:
                        js_candidates.append(full)
                # Cap + fetch
                for js_url in js_candidates[:_JS_MAX_FILES]:
                    if shutdown_requested():
                        break
                    if js_bytes_fetched >= _JS_TOTAL_CAP:
                        break
                    js_resp = self._session.get(js_url, allow_wayback=False)
                    if not js_resp or js_resp.status_code != 200:
                        continue
                    js_body = js_resp.text[:_JS_PER_FILE_CAP] if js_resp.text else ""
                    if not js_body:
                        continue
                    js_bytes_fetched += len(js_body)
                    js_urls_fetched.append(js_url)
                    hits = self._extractor.extract_all(js_body)
                    for k, v_list in hits.items():
                        if not v_list:
                            continue
                        bucket = js_secrets.setdefault(k, [])
                        for val in v_list:
                            if val not in bucket:
                                bucket.append(val)
                    # Source-map pointer in the tail of the bundle.
                    m = re.search(
                        r"[#@]\s*sourceMappingURL\s*=\s*(\S+)",
                        js_body[-4096:],
                    )
                    if m:
                        map_url = urljoin(js_url, m.group(1))
                        mp_netloc = urlparse(map_url).netloc.lower()
                        if (mp_netloc == base_host or
                                mp_netloc.endswith("." + base_host)):
                            try:
                                sm_resp = self._session.get(
                                    map_url, allow_wayback=False,
                                )
                                if sm_resp and sm_resp.status_code == 200 and sm_resp.text:
                                    js_secrets.setdefault(
                                        "sourcemap_exposed", [],
                                    ).append(map_url)
                            except Exception:
                                pass
            except Exception as e:
                integrity_log("intel", f"js_scrape_error:{type(e).__name__}")

        _coarsened = int(time.time()) // 600 * 600
        return {
            "url": url, "title": title[:200], "description": meta_desc[:500],
            "extracted": extracted, "urls_found": len(urls),
            "comments": len(comments),
            "secrets_in_comments": secrets_in_comments,
            "js_secrets": js_secrets,
            "js_urls_fetched": js_urls_fetched,
            "content_length": len(content), "timestamp": _coarsened,
            "raw_html": content, "raw_headers": headers,
            "raw_set_cookies": raw_set_cookies,
            "honeypot": False,
        }

    def search_ddg(self, query: str, max_results: int = 20) -> List[dict]:
        """DuckDuckGo HTML search — Tor-friendly, no JS needed.

        DDG's HTML frontend frequently routes result links through
        `/l/?uddg=<urlencoded-target>&...` instead of returning the
        destination URL directly. The old version rejected those as
        'duckduckgo' links and lost half the search results. Now we
        unwrap the uddg parameter when present.
        """
        results = []
        url = f"https://html.duckduckgo.com/html/?q={quote(query)}"
        resp = self._session.get(url)
        if not resp or not HAS_BS4:
            return results
        try:
            soup = BeautifulSoup(resp.text, "html.parser")
            # DDG HTML uses result__a class for links
            links = soup.find_all("a", class_="result__a")
            if not links:
                # Fallback: find any result links
                links = soup.find_all("a", href=re.compile(r"^https?://"))
            seen: Set[str] = set()
            for link in links:
                if len(results) >= max_results:
                    break
                href = link.get("href", "")
                title = link.get_text(strip=True)
                if not href:
                    continue

                # Unwrap DDG's /l/?uddg=<target> redirect
                if href.startswith("/l/?") or "duckduckgo.com/l/?" in href:
                    try:
                        qs = parse_qs(urlparse(href).query)
                        uddg = qs.get("uddg", [""])[0]
                        if uddg:
                            href = uddg
                    except Exception:
                        pass

                if not href.startswith(("http://", "https://")):
                    continue
                if "duckduckgo.com" in urlparse(href).netloc:
                    continue
                if href in seen:
                    continue
                seen.add(href)
                results.append({"url": href, "title": title, "source": "ddg"})
        except Exception as e:
            integrity_log("intel", f"ddg_parse_error:{str(e)[:40]}")
        return results


