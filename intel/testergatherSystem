def main():
    install_signal_handlers()

    ap = argparse.ArgumentParser(
        description="Intelligence Gathering & Vulnerability Scanner — via Tor",
    )
    ap.add_argument("--domain", "-d", help="Target domain for recon + vuln scan")
    ap.add_argument("--email", "-e", help="Email to check against breach DBs")
    ap.add_argument("--query", "-q", help="Search query for OSINT")
    ap.add_argument("--file", "-f", type=Path, help="File with targets (one per line)")
    ap.add_argument("--scan", choices=["quick", "full", "deep"], default="full",
                    help="Scan depth: quick (headers), full (+paths+vulns), deep (+subdomains+exploits)")
    ap.add_argument("--tor-proxy", default="socks5h://127.0.0.1:9050",
                    help="Tor SOCKS5 proxy (default: socks5h://127.0.0.1:9050)")
    ap.add_argument("--max-results", type=int, default=20,
                    help="Max search results per query (default: 20)")
    ap.add_argument("--cookie", action="append", default=[],
                    help="Session cookie (name=value). Repeat for multiple. "
                         "Enables scanning authenticated pages. "
                         "Example: --cookie PHPSESSID=abc123 --cookie security=low")
    ap.add_argument("--wipe", action="store_true", help="Wipe all intel data and exit")
    ap.add_argument("--read-report", type=Path, metavar="FILE",
                    help="Read and display an existing report (encrypted or plain)")
    ap.add_argument("--list-reports", action="store_true",
                    help="List available reports in RAM storage")
    args = ap.parse_args()

    if args.wipe:
        SecureStorage().wipe_all()
        print("  [+] Intel data wiped.")
        return

    if args.list_reports:
        _list_reports()
        return

    if args.read_report:
        _read_report(args.read_report)
        return

    if not args.domain and not args.email and not args.query and not args.file:
        ap.error("At least one of --domain, --email, --query, or --file is required")

    # ── Input validation ──
    if args.domain:
        # Normalize: strip protocol + path + fragment; drop optional
        # userinfo; preserve any explicit :port so non-standard-port
        # targets still scan. The previous hostname-only regex rejected
        # 'example.com:8080' outright, which made it impossible to scan
        # dev/staging/internal services that listen off 80/443.
        d = args.domain.strip().lower()
        if d.startswith("http://") or d.startswith("https://"):
            d = urlparse(d).netloc or d
        d = d.split("/")[0].split("?")[0].split("#")[0]
        if "@" in d:
            d = d.rsplit("@", 1)[1]
        host, port = d, None
        if ":" in d:
            host, _, port_str = d.rpartition(":")
            if port_str.isdigit() and 1 <= int(port_str) <= 65535:
                port = port_str
            else:
                host = d  # colon wasn't a port; let the regex reject it
                port = None
        if not re.match(
            r"^[a-z0-9]([a-z0-9\-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9\-]*[a-z0-9])?)+$",
            host,
        ):
            print(f"  [!] Invalid domain: {d[:40]}")
            sys.exit(1)
        args.domain = f"{host}:{port}" if port else host

    if args.email:
        e = args.email.strip()
        if "@" not in e or "." not in e.split("@")[-1]:
            print(f"  [!] Invalid email format")
            sys.exit(1)
        args.email = e

    if args.file and not args.file.exists():
        print(f"  [!] File not found: {scrub_path(args.file)}")
        sys.exit(1)

    proxy = require_tor_proxy(args.tor_proxy)

    global _ACTIVE_TOR_PORT
    _proxy_parsed = urlparse(args.tor_proxy)
    _ACTIVE_TOR_PORT = str(_proxy_parsed.port or 9050)

    integrity_log("intel", "session_start")

    orch = IntelOrchestrator(proxy, scan_depth=args.scan)

    # Set session cookies for authenticated scanning
    if args.cookie:
        cookies = {}
        for c in args.cookie:
            if "=" in c:
                k, v = c.split("=", 1)
                cookies[k.strip()] = v.strip()
        if cookies:
            orch._session.set_cookies(cookies)
            print(f"  [+] {len(cookies)} session cookie(s) set for authenticated scanning")

    try:
        if args.email:
            orch.run_email(args.email)
        if args.domain:
            orch.run_domain(args.domain)
        if args.query:
            orch.run_query(args.query, args.max_results)
        if args.file:
            orch.run_file(args.file)
        orch.save_report()
    except KeyboardInterrupt:
        print("\n  [!] Interrupted — saving partial results...")
        try:
            orch.save_report()
        except Exception:
            pass
    except Exception as e:
        print(f"\n  [!] Error: {str(e)[:80]}")
        integrity_log("intel", f"error:{str(e)[:40]}")
        try:
            orch.save_report()
        except Exception:
            pass
    finally:
        if shutdown_requested():
            print("  [*] Signal received — wiping in-memory data...")
            orch.emergency_wipe()
        orch.cleanup()
        integrity_log("intel", "session_end")

    print(f"\n  [*] Done. Data in RAM ({scrub_path(RAM_DIR)}).")
    print(f"  [*] Run with --wipe to securely erase.\n")


if __name__ == "__main__":
    main()
