class DataExtractor:
    """Extract structured data from text using validated regex patterns."""

    PATTERNS = {
        "email": re.compile(
            r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b"
        ),
        "btc_address": re.compile(
            r"\b(?:bc1[ac-hj-np-z02-9]{25,59}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})\b"
        ),
        "eth_address": re.compile(r"\b0x[a-fA-F0-9]{40}\b"),
        "xmr_address": re.compile(r"\b[48][0-9AB][1-9A-HJ-NP-Za-km-z]{93}\b"),
        "phone": re.compile(
            r"(?<!\d)[\+]?[(]?[0-9]{1,3}[)]?[-\s.]?[(]?[0-9]{1,4}[)]?"
            r"[-\s.]?[0-9]{3,4}[-\s.]?[0-9]{3,4}(?!\d)"
        ),
        "onion_v3": re.compile(r"\b[a-z2-7]{56}\.onion\b"),
        "ipv4": re.compile(
            r"\b(?:(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.){3}"
            r"(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\b"
        ),
        "tx_hash": re.compile(r"\b0x[a-fA-F0-9]{64}\b"),
    }

    @classmethod
    def extract_all(cls, text: str) -> Dict[str, List[str]]:
        """Extract all pattern matches from text, deduplicated and limited."""
        if not text:
            return {}
        results = {}
        for name, pattern in cls.PATTERNS.items():
            matches = pattern.findall(text)
            if matches:
                # Deduplicate, limit to 50, validate
                seen: Set[str] = set()
                validated = []
                for m in matches:
                    m = m.strip()
                    if m not in seen and cls._validate(name, m):
                        seen.add(m)
                        validated.append(m)
                        if len(validated) >= 50:
                            break
                if validated:
                    results[name] = validated
        return results

    @classmethod
    def _validate(cls, pattern_type: str, value: str) -> bool:
        """Basic validation to reject false positives."""
        if pattern_type == "email":
            parts = value.split("@")
            return len(parts) == 2 and "." in parts[1] and len(parts[1]) > 3
        elif pattern_type == "btc_address":
            return 26 <= len(value) <= 62
        elif pattern_type == "eth_address":
            return len(value) == 42
        elif pattern_type == "phone":
            digits = re.sub(r"\D", "", value)
            return 7 <= len(digits) <= 15
        return True


