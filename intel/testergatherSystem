def _list_reports():
    """List available reports in RAM storage."""
    ram_dir = RAM_DIR
    if not ram_dir.exists():
        print("  [*] No reports found (no intel directory).")
        return
    reports = sorted(ram_dir.glob("intel_*"), key=lambda f: f.stat().st_mtime, reverse=True)
    if not reports:
        print("  [*] No reports found.")
        return
    print(f"\n  {'═' * 50}")
    print(f"  Available reports ({len(reports)}):")
    print(f"  {'═' * 50}")
    for r in reports:
        size = r.stat().st_size
        age = (time.time() - r.stat().st_mtime) / 60
        enc = "[enc]" if r.suffix == ".enc" else "[txt]"
        print(f"  {enc} {r.name}  ({size} bytes, {age:.0f}m ago)")
    print(f"  {'═' * 50}")
    print(f"  Read with: --read-report <filename>")
    print()


def _read_report(path: Path):
    """Read and display a report — handles both encrypted and plaintext."""
    if not path.exists():
        # Try looking in RAM_DIR
        alt = RAM_DIR / path.name
        if alt.exists():
            path = alt
        else:
            print(f"  [!] Report not found: {scrub_path(path)}")
            # Show available reports
            _list_reports()
            return

    report_data = None

    if path.suffix == ".enc":
        if not HAS_FERNET:
            print("  [!] cryptography package needed for encrypted reports.")
            return
        key_input = input("  Enter decryption key: ").strip()
        if not key_input:
            print("  [!] No key provided.")
            return
        try:
            cipher = Fernet(key_input.encode() if isinstance(key_input, str) else key_input)
            decrypted = cipher.decrypt(path.read_bytes())
            report_data = json.loads(decrypted)
        except Exception as e:
            print(f"  [!] Decryption failed: {type(e).__name__}")
            return
    else:
        try:
            report_data = json.loads(path.read_text())
        except (json.JSONDecodeError, OSError) as e:
            print(f"  [!] Cannot read report: {type(e).__name__}")
            return

    # Display report
    _display_report(report_data)


