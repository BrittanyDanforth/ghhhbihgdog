# ══════════════════════════════════════════════════════════════════════════

class SecureStorage:
    """RAM-only encrypted storage with proper key management.

    Key is printed to terminal once at save time (for the operator to note)
    and held in memory only — NOT written to disk alongside the encrypted
    file, which would make encryption meaningless.
    """

    def __init__(self):
        self._dir = RAM_DIR
        self._dir.mkdir(parents=True, exist_ok=True)
        os.chmod(str(self._dir), 0o700)
        self._key = Fernet.generate_key() if HAS_FERNET else None
        self._cipher = Fernet(self._key) if self._key else None

    def save(self, data: dict, label: str = "intel") -> Tuple[Path, Optional[str]]:
        """Save data to RAM disk. Returns (path, key_hex_or_None).

        The key is returned so the caller can display it once. It is NOT
        written to disk — the operator must note it to decrypt later.
        """
        _ts = int(time.time()) // 600 * 600
        ts_str = datetime.fromtimestamp(_ts, tz=timezone.utc).strftime("%Y%m%d_%H%M")
        filename = f"{label}_{ts_str}_{secure_hex(4)}"
        serialized = json.dumps(data, indent=2, default=str).encode()

        if self._cipher:
            encrypted = self._cipher.encrypt(serialized)
            outpath = self._dir / f"{filename}.enc"
            outpath.write_bytes(encrypted)
            secure_file_perms(outpath, 0o600)
            # Key stays in memory — returned to caller for display, NOT written to disk
            key_hex = self._key.decode() if isinstance(self._key, bytes) else str(self._key)
            return outpath, key_hex
        else:
            outpath = self._dir / f"{filename}.json"
            outpath.write_text(serialized.decode())
            secure_file_perms(outpath, 0o600)
            return outpath, None

    def wipe_all(self):
        """Securely wipe all intel data — files, subdirectories, symlinks.

        SECURITY: Refuses to follow symlinks out of the RAM directory.
        A symlink pointing to /etc/passwd would be deleted (the link),
        NOT overwritten (the target file). os.walk followlinks=False
        prevents directory symlink traversal.
        """
        if not self._dir.exists():
            return
        # Resolve the real dir to detect if _dir itself is a symlink
        real_dir = self._dir.resolve()
        if self._dir.is_symlink():
            integrity_log("intel", "WIPE_ABORT:intel_dir_is_symlink")
            print("  [!] Intel directory is a symlink — refusing to wipe (safety).")
            return
        # Walk bottom-up, never follow symlinks
        for root, dirs, files in os.walk(str(real_dir), topdown=False, followlinks=False):
            root_path = Path(root)
            for fname in files:
                fpath = root_path / fname
                try:
                    if fpath.is_symlink():
                        # Remove symlink itself, don't overwrite target
                        fpath.unlink()
                        continue
                    size = fpath.stat().st_size
                    if size > 0:
                        with open(fpath, "r+b") as fh:
                            fh.write(os.urandom(size))
                            fh.flush()
                    fpath.unlink()
                except (OSError, PermissionError):
                    try:
                        fpath.unlink()
                    except OSError:
                        pass
            for dname in dirs:
                dpath = root_path / dname
                if dpath.is_symlink():
                    dpath.unlink()
                    continue
                try:
                    dpath.rmdir()
                except OSError:
                    pass
        try:
            self._dir.rmdir()
        except OSError:
            pass


