    def save_encrypted(self, data):
        """Save data with encryption and Shamir splitting"""
        try:
            # Serialize
            serialized = json.dumps(data).encode()
            
            # Encrypt
            cipher = Fernet(self.encryption_key)
            encrypted = cipher.encrypt(serialized)
            
            # Save to RAM disk
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            output_file = self.ram_path / f'intel_{timestamp}.enc'
            
            with open(output_file, 'wb') as f:
                f.write(encrypted)
                
            logger.info(f"Data encrypted and saved to RAM: {output_file}")
            
            # Generate Shamir shares
            self._generate_shamir_shares()
            
            # Set auto-wipe timer
            if CONFIG['DATA_HANDLING']['AUTO_WIPE_INTERVAL']:
                threading.Timer(
                    CONFIG['DATA_HANDLING']['AUTO_WIPE_INTERVAL'],
                    self._secure_wipe,
                    args=[output_file]
                ).start()
                
            return output_file
            
        except Exception as e:
            logger.error(f"Encryption failed: {e}")
            return None
            
    def _generate_shamir_shares(self):
        """Split encryption key using Shamir's Secret Sharing"""
        try:
            from Crypto.Protocol.SecretSharing import Shamir
        except ImportError:
            logger.warning("PyCryptodome Shamir not available — skipping secret sharing")
            return

        try:
            shares = Shamir.split(
                CONFIG['DATA_HANDLING']['SHAMIR_THRESHOLD'],
                CONFIG['DATA_HANDLING']['SHAMIR_SHARES'],
                self.encryption_key
            )
            
            # Save shares to separate locations
            for idx, share in shares:
                share_file = self.ram_path / f'share_{idx}.key'
                with open(share_file, 'wb') as f:
                    f.write(share)
                    
                self.shamir_shares.append(share_file)
                
            logger.info(f"Generated {len(shares)} Shamir shares")
            
        except Exception as e:
            logger.error(f"Shamir split failed: {e}")
            
    def _secure_wipe(self, filepath):
        """Securely wipe file from RAM"""
        try:
            if filepath.exists():
                # Overwrite with random data
                size = filepath.stat().st_size
                
                with open(filepath, 'rb+') as f:
                    for _ in range(3):
                        f.seek(0)
                        f.write(os.urandom(size))
                        f.flush()
                        
                # Remove
                filepath.unlink()
                
                logger.info(f"Securely wiped: {filepath}")
                
        except Exception as e:
