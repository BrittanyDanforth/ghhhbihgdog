            'help': ['support', 'assistance', 'urgent'],
            'account': ['wallet', 'funds', 'balance']
        }
        
        for word, syns in synonyms.items():
            if word in query.lower():
                query = query.replace(word, random.choice(syns))
                
        return query
        
