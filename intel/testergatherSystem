            poc["impact"] = "Full API enumeration. Query any data the schema exposes."
            poc["remediation"] = "Disable introspection in production."

        elif exploit_type == "open_redirect" and param:
            poc["curl"] = f'curl -v {sp} "{target}"'
            poc["steps"] = [
                f"# 1. Redirect to attacker site:",
                f"curl -v {sp} \"{target}\"",
                f"# 2. Chain with OAuth to steal tokens:",
                f"#    Replace redirect_uri with the vulnerable redirect",
                f"#    Victim clicks auth link -> gets redirected to attacker with token",
            ]
            poc["description"] = f"Open redirect via '{param}'. Usable for phishing and OAuth theft."
            poc["impact"] = "Phishing (trusted domain redirects to attacker). OAuth token theft."
            poc["remediation"] = "Whitelist allowed redirect URLs. Use relative paths only."

        else:
            poc["curl"] = f"# {finding.get('title', 'Finding')}"
            poc["description"] = finding.get("detail", "")
            poc["remediation"] = "See finding detail for manual verification steps."
            poc["steps"] = [f"# Refer to evidence: {finding.get('evidence', 'N/A')[:100]}"]

        return poc

    @staticmethod
    def export_all(findings: List[dict], redact: bool = True) -> List[dict]:
        """Export all exploitable findings."""
        pocs = []
        for f in findings:
            if f.get("exploitable"):
                pocs.append(PoCExporter.export_finding(f, redact))
        return pocs


