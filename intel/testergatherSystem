    def _check_host_header_injection(self, base_url: str) -> List[dict]:
        """Detect Host-header injection / absolute-URL override.

        Two signals:
        1. The target reflects an attacker-controlled Host value back
           into a Location header (password-reset URL poisoning class).
        2. The target reflects X-Forwarded-Host into a Location or
           into the body as an absolute URL.

        Both are exploitable for cache poisoning, password-reset link
        hijacking, and in some frameworks, auth bypass.
        """
        findings = []
        domain = urlparse(base_url).netloc
        if self._session.is_domain_blocked(domain):
            return findings

        marker = f"h{secrets.token_hex(4)}.example.test"
        probes = [
            ({"Host": marker}, "Host"),
            ({"X-Forwarded-Host": marker}, "X-Forwarded-Host"),
            ({"X-Forwarded-Server": marker}, "X-Forwarded-Server"),
            ({"X-Host": marker}, "X-Host"),
        ]
        for headers, hname in probes:
            if shutdown_requested() or self._session.is_domain_blocked(domain):
                break
            # allow_redirects=False so we can see what the server wrote
            # in Location.
            resp = self._session.request(
                "GET", base_url,
                allow_redirects=False,
                extra_headers=headers,
            )
            if resp is None:
                continue

            # Signal 1: Location reflects the marker host.
            loc = resp.headers.get("Location", "")
            if loc:
                loc_host = urlparse(loc).netloc.lower()
                if loc_host == marker.lower():
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"Host-header injection via {hname}",
                        "detail": (f"Server built the Location header using "
                                   f"the attacker-supplied {hname}: value. "
                                   f"Usable for password-reset link "
                                   f"poisoning, cache poisoning, and in "
                                   f"some frameworks auth-bypass."),
                        "evidence": f"{hname}: {marker} → Location: {loc[:120]}",
                        "exploitable": True,
                        "test_url": base_url,
                        "exploit_info": {
                            "type": "host_header_injection",
                            "header": hname,
                            "method": (f"Send the target's password-reset "
                                       f"flow with {hname}: attacker.com. "
                                       f"The reset link in the victim's "
                                       f"email will point at attacker.com."),
                            "risk": "Password reset link hijacking, cache poisoning, auth bypass",
                        },
                    })
                    return findings  # one reflected header is enough

            # Signal 2: the body renders the marker as a same-origin absolute URL.
            body = resp.text[:20000] if resp.text else ""
            if marker in body:
                # Make sure the marker appears in a URL-ish context
                # (href=, src=, action=, or a literal http(s)://marker).
                urlish = re.search(
                    r"""(?:href|src|action)\s*=\s*['"][^'"]*""" + re.escape(marker)
                    + r"""[^'"]*['"]""",
                    body, re.I,
                )
                if urlish or f"//{marker}" in body or f"://{marker}" in body:
                    findings.append({
                        "severity": SEV_MEDIUM,
                        "title": f"{hname} reflected as absolute URL in body",
                        "detail": (f"Server rendered {hname}: into an "
                                   f"absolute URL in the response body. "
                                   f"Any generated links (emails, OAuth "
                                   f"redirects) likely use this value — "
                                   f"usable for cache poisoning."),
                        "evidence": f"{hname}: {marker} appeared in HTML URL context",
                        "exploitable": True,
                        "test_url": base_url,
                        "exploit_info": {
                            "type": "host_header_injection",
                            "header": hname,
                            "method": (f"Poison cache by sending {hname}: "
                                       f"attacker.com — cached response "
                                       f"serves attacker URLs to everyone."),
                            "risk": "Cache poisoning, link injection, phishing",
                        },
                    })
                    return findings
        return findings

    def _check_http_verb_tampering(self, base_url: str) -> List[dict]:
        """Detect auth bypass via alternate HTTP verbs.

        Many WAFs + frameworks only protect the GET/POST path for a
        protected resource. Sending PUT, DELETE, HEAD, PATCH, or the
        override header 'X-HTTP-Method-Override: GET' can slip past
        the rule and return 200 for a path that normally returns 403.
        """
        findings = []
        domain = urlparse(base_url).netloc
        if self._session.is_domain_blocked(domain):
            return findings

        # Pick candidate paths: start with /admin and any 403 we know.
        candidates = ["/admin", "/admin/", "/admin/index", "/dashboard",
                      "/api/admin", "/api/users"]
        # If the scan has already crawled endpoints, include them.
        if self._crawled_urls:
            for ep in self._crawled_urls[:10]:
                try:
                    path = urlparse(ep["url"]).path
                    if path and path not in candidates:
                        candidates.append(path)
                except Exception:
                    continue

        # Cap the total probe budget. Each path triggers 1 baseline + 6
        # verbs + 1 override = 8 requests. 4 paths = 32 requests,
        # which is enough to catch the common cases without killing a
        # Tor circuit. Previous version allowed 8 paths = 64 requests,
        # which almost always tripped the target's rate limit.
        for path in candidates[:4]:
            if shutdown_requested() or self._session.is_domain_blocked(domain):
                break
            url = urljoin(base_url, path)

            # Baseline GET — only interesting when GET is walled.
            g_resp = self._session.request(
                "GET", url, allow_redirects=False,
            )
            if g_resp is None or g_resp.status_code not in (401, 403):
                continue

            found_this_path = False
            for verb in ("HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"):
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    break
                v_resp = self._session.request(
                    verb, url, allow_redirects=False,
                )
                if v_resp is None:
                    continue
                # Bypass signal: verb returns 200 / 2xx while GET returned 403/401.
                if 200 <= v_resp.status_code < 300:
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"HTTP verb tampering bypass at {path}",
                        "detail": (f"GET {path} returns {g_resp.status_code} "
                                   f"but {verb} {path} returns "
                                   f"{v_resp.status_code}. WAF or framework "
                                   f"auth check is verb-specific and can be "
                                   f"bypassed by switching methods."),
                        "evidence": f"GET→{g_resp.status_code}, {verb}→{v_resp.status_code}",
                        "exploitable": True,
                        "test_url": url,
                        "exploit_info": {
                            "type": "http_verb_tampering",
                            "path": path,
                            "method": (f"Send {verb} instead of GET — WAF's "
                                       f"verb-specific auth check is "
                                       f"bypassed. Works for admin panels "
                                       f"protected only on GET."),
                            "risk": "Auth bypass, admin access",
                        },
                    })
                    found_this_path = True
                    return findings
            if found_this_path:
                break
            # Method-override header
            o_resp = self._session.request(
                "GET", url, allow_redirects=False,
                extra_headers={"X-HTTP-Method-Override": "GET"},
            )
            if o_resp and 200 <= o_resp.status_code < 300:
                findings.append({
                    "severity": SEV_HIGH,
                    "title": f"X-HTTP-Method-Override bypass at {path}",
                    "detail": (f"GET {path} returns {g_resp.status_code} "
                               f"but X-HTTP-Method-Override: GET returns "
                               f"{o_resp.status_code}. Framework honors the "
                               f"override header AFTER the WAF rule fires."),
                    "evidence": f"GET→{g_resp.status_code}, override→{o_resp.status_code}",
                    "exploitable": True,
                    "test_url": url,
                    "exploit_info": {
                        "type": "http_verb_tampering",
                        "path": path,
                        "method": ("Send GET with header "
                                   "'X-HTTP-Method-Override: GET' — the "
                                   "framework treats it as the override "
                                   "verb while the WAF already saw GET."),
                        "risk": "Auth bypass, admin access",
                    },
                })
                return findings
        return findings

    # Common NoSQL error signatures that leak from unparameterised queries.
    NOSQL_INDICATORS = [
        re.compile(r"MongoError|MongoServerError", re.I),
        re.compile(r"E11000 duplicate key", re.I),
        re.compile(r"CastError:.*ObjectId", re.I),
        re.compile(r"\$where.*not allowed", re.I),
        re.compile(r"BSON.*parse", re.I),
        re.compile(r"Syntax error near.*\$ne", re.I),
        re.compile(r"CouchDB error", re.I),
        re.compile(r"Unable to parse.*Redis", re.I),
        re.compile(r"mongoose.*ValidationError", re.I),
        re.compile(r"unknown top level operator", re.I),
    ]

    def _check_nosql_injection(self, base_url: str) -> List[dict]:
        """Detect MongoDB-style NoSQL injection via error signatures
        plus a THREE-point boolean differential to kill false positives.

        We compare three responses:
          (a) baseline-bogus: ?p=<random> — the 'should-not-match' case
          (b) baseline-plain: ?p=1 — the 'might-match' case
          (c) ne-bogus: ?p[$ne]=<random> — the 'match-everything'
              case IF the app interprets $ne

        Real MongoDB injection makes (c) look like 'match everything',
        which differs from BOTH (a) and (b). If (c) only differs from
        (a) (but matches (b)), the framework is just coalescing
        'param[$ne]=...' back to the plain-param behavior — common in
        Node/Express with qs enabled — and is NOT injection.
        """
        findings = []
        test_params = self._get_test_params(["id", "user", "username", "email",
                                              "name", "search", "q"])
        for param in test_params[:5]:
            if shutdown_requested():
                break

            bogus = f"x{secrets.token_hex(3)}"
            base_url_no_q = base_url.split("?")[0]

            # (a) Bogus scalar — 'does not exist'
            url_a = f"{base_url_no_q}?{param}={bogus}"
            # (b) Real-ish scalar — 'does exist' most of the time
            url_b = f"{base_url_no_q}?{param}=1"
            # (c) [$ne] operator — MongoDB: match everything except bogus
            url_c = f"{base_url_no_q}?{param}[$ne]={bogus}"

            r_a = self._session.get(url_a, allow_wayback=False)
            if not r_a or not r_a.text:
                continue
            r_b = self._session.get(url_b, allow_wayback=False)
            r_c = self._session.get(url_c, allow_wayback=False)
            if not r_c or not r_c.text:
                continue

            body_a = r_a.text[:6000]
            body_c = r_c.text[:6000]
            len_a = len(r_a.text)
            len_b = len(r_b.text) if r_b and r_b.text else 0
            len_c = len(r_c.text)

            # Signal 1: MongoDB-class error ONLY in the [$ne] response
            # (not in the bogus baseline → rules out generic 500s that
            # a badly-written param handler always emits).
            for ind in self.NOSQL_INDICATORS:
                if ind.search(body_c) and not ind.search(body_a):
                    findings.append({
                        "severity": SEV_CRITICAL,
                        "title": f"NoSQL injection error via '{param}'",
                        "detail": ("MongoDB-class error appeared only in "
                                   "response to a [$ne] payload. Input "
                                   "reaches a NoSQL query without "
                                   "sanitization."),
                        "evidence": f"param: {param}, pattern: {ind.pattern[:60]}",
                        "exploitable": True,
                        "test_url": url_c,
                        "exploit_info": {
                            "type": "nosql_injection",
                            "parameter": param,
                            "method": ("Use operators that coerce to "
                                       "'true' for every document: "
                                       "?user[$ne]=0&pass[$ne]=0 to "
                                       "bypass auth. For data "
                                       "extraction: [$regex]=.*"),
                            "risk": "Auth bypass, data exfiltration, DB enumeration",
                        },
                    })
                    return findings

            # Signal 2: Three-point boolean differential.
            # Only flag if (c) is BOTH:
            #   - meaningfully larger than (a) AND
            #   - different enough from (b) to look like 'more than
            #     one match' (not just the same match rendered twice)
            if r_c.status_code == 200 and len_c > len_a + 1024:
                # If the baseline-plain is similar to (c), then the app
                # just treats [$ne] like the plain param; that's not
                # injection.
                plain_matches_ne = (
                    len_b > 0 and
                    abs(len_c - len_b) < max(512, len_b * 0.1)
                )
                # If (a) was a hard error (4xx) and (c) was 200, that's
                # a very strong signal regardless of length.
                a_was_error = r_a.status_code in (400, 404)
                if a_was_error and r_c.status_code == 200:
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"Possible NoSQL injection via '{param}' (404→200)",
                        "detail": (f"?{param}=<bogus> → HTTP {r_a.status_code} "
                                   f"but ?{param}[$ne]=<bogus> → HTTP 200. "
                                   f"Operator was interpreted by the DB."),
                        "evidence": f"baseline={r_a.status_code}, $ne={r_c.status_code}",
                        "exploitable": True,
                        "test_url": url_c,
                        "exploit_info": {
                            "type": "nosql_injection",
                            "parameter": param,
                            "method": ("Swap the parameter for "
                                       "[$ne]/[$gt]/[$regex] — most "
                                       "endpoints will leak everything."),
                            "risk": "Auth bypass, data extraction",
                        },
                    })
                    return findings
                if not plain_matches_ne:
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"Possible NoSQL injection via '{param}' (length diff)",
                        "detail": (f"[$ne] payload returned {len_c} bytes "
                                   f"vs {len_a}-byte bogus baseline "
                                   f"(and {len_b}-byte plain baseline) — "
                                   f"response differs from both, "
                                   f"consistent with match-everything."),
                        "evidence": (f"bogus={len_a}B, plain={len_b}B, "
                                     f"$ne={len_c}B"),
                        "exploitable": True,
                        "test_url": url_c,
                        "exploit_info": {
                            "type": "nosql_injection",
                            "parameter": param,
                            "method": ("Data extraction: "
                                       "?user=admin&pass[$regex]=^a.* "
                                       "leaks the password one character "
                                       "at a time."),
                            "risk": "Auth bypass, credential extraction",
                        },
                    })
                    return findings
        return findings

    # Common WAF/IPS fingerprints by response headers and body signatures.
    # Value is (Short name, detail).
    # Header-only WAF fingerprints. Every entry is an EXACT
    # response-header name that — on its own, regardless of value —
    # proves a specific WAF / CDN is in the path. Header names that
    # are generic (x-request-id, server, x-powered-by) are NOT here;
    # we match those by value via _WAF_SERVER_VALUE_FINGERPRINTS.
    # Name-only fingerprints: presence of the header alone uniquely
    # identifies the vendor. Do NOT put generic trace/CDN headers here.
    #
    # Headers that were previously listed here but are actually too
    # generic (and have been moved to value-match or removed):
    #   x-cdn              -> many CDNs use this; only flag when value
    #                         says 'incapsula'
    #   x-amzn-trace-id    -> stamped by every AWS ALB, not WAF-specific
    #                         (e.g. plain apps behind ALB w/o WAF)
    #   x-amz-cf-id        -> this ONE actually is CloudFront-unique, kept
    #   x-cloud-trace-context -> any GCP request; not WAF at all
    #   x-request-id       -> too generic; used by nginx, nodejs logs, …
    _WAF_HEADER_FINGERPRINTS = {
        "cf-ray":               "Cloudflare",
        "cf-cache-status":      "Cloudflare",
        "x-sucuri-id":          "Sucuri CloudProxy",
        "x-sucuri-cache":       "Sucuri CloudProxy",
        "x-iinfo":              "Imperva Incapsula",
        "x-amz-cf-id":          "AWS CloudFront",
        "x-amz-cf-pop":         "AWS CloudFront",
        "x-citrix-session-id":  "Citrix NetScaler",
        "x-waf-event-info":     "FortiGate",
        "x-dcid":               "Yundun / DDoS-GUARD",
        "x-bigip-selfip":       "F5 BIG-IP",
        "x-bigip-ltm":          "F5 BIG-IP",
        "x-fireeye":            "FireEye NX",
        "x-barracuda":          "Barracuda WAF",
        "x-varnish":            "Varnish cache",
        "x-azure-ref":          "Azure Front Door",
        "x-azure-clientip":     "Azure WAF",
    }

    # Value-match fingerprints: (header_name, (substring, vendor)...). A
    # header whose NAME alone is generic (could mean anything) only
    # counts when its VALUE contains a known WAF signature. Substring
    # matches are lowercased.
    _WAF_HEADER_VALUE_FINGERPRINTS: Dict[str, Tuple[Tuple[str, str], ...]] = {
        "x-cdn": (
            ("incapsula", "Imperva Incapsula"),
            ("imperva",   "Imperva Incapsula"),
            ("akamai",    "Akamai"),
            ("sucuri",    "Sucuri CloudProxy"),
            ("fastly",    "Fastly"),
            ("cloudfront", "AWS CloudFront"),
        ),
        "x-powered-by-plesk": (
            ("fortiweb", "FortiWeb WAF"),
        ),
        "x-waf-status": (
            # Only flag when the value actually names a vendor; bare
            # 'block'/'allow' shouldn't light up a fingerprint that
            # gets paraded on the report.
            ("fortiweb",  "FortiWeb WAF"),
            ("imperva",   "Imperva Incapsula"),
            ("barracuda", "Barracuda WAF"),
        ),
        "x-iinfo": (
            ("incap",     "Imperva Incapsula"),
        ),
    }

    # Server-header value matches — we look inside the 'server:' value
    # for a substring. server: cloudflare is a real fingerprint,
    # server: nginx is not (nginx is an http server, not a WAF).
    _WAF_SERVER_VALUE_FINGERPRINTS = [
        ("cloudflare",  "Cloudflare"),
        ("cloudfront",  "AWS CloudFront"),
        ("bigip",       "F5 BIG-IP"),
        ("big-ip",      "F5 BIG-IP"),
        ("awselb",      "AWS ELB/ALB"),
        ("awsalb",      "AWS ELB/ALB"),
        ("akamaighost", "Akamai"),
        ("akamai",      "Akamai"),
        ("sucuri",      "Sucuri CloudProxy"),
        ("barracuda",   "Barracuda WAF"),
        ("imperva",     "Imperva Incapsula"),
        ("incapsula",   "Imperva Incapsula"),
        ("fortiweb",    "FortiWeb WAF"),
    ]

    _WAF_BODY_SIGNATURES = [
        (re.compile(r"<title>Access denied.*Sucuri", re.I), "Sucuri CloudProxy"),
        (re.compile(r"Cloudflare Ray ID:", re.I),            "Cloudflare"),
        (re.compile(r"attention required!.*cloudflare", re.I), "Cloudflare"),
        (re.compile(r"Incapsula incident ID", re.I),         "Imperva Incapsula"),
        (re.compile(r"Request\s+unsuccessful\.\s*Incapsula"), "Imperva Incapsula"),
        (re.compile(r"Reference\s*#\d+\.\w+\."),              "Akamai"),
        (re.compile(r"AkamaiGHost", re.I),                    "Akamai"),
        (re.compile(r"blocked.*Barracuda", re.I),             "Barracuda WAF"),
        (re.compile(r"<TITLE>Web Page Blocked!</TITLE>", re.I), "Palo Alto"),
        (re.compile(r"FortiGate web filtering", re.I),        "FortiGate"),
        (re.compile(r"/waf_block\.html", re.I),               "SafeDog"),
        (re.compile(r"\bModSecurity\b", re.I),                "ModSecurity"),
    ]

    def _check_waf_fingerprint(self, base_url: str, html: str,
                               headers: dict) -> List[dict]:
        """Identify the WAF / CDN fronting the target.

        Not a vulnerability per se, but a massively useful INFO-class
        finding — every subsequent bypass technique depends on which
        WAF you're up against. Emitted early so the walkthrough can
        tailor its payload mutation.

        We deliberately do NOT flag 'WAF detected' based on generic
        headers like 'server: nginx' — nginx is an http server, not a
        WAF. Only signals that uniquely identify a WAF/CDN count.
        """
        findings = []
        h_lower = {k.lower(): v for k, v in headers.items()}
        seen_names: Set[str] = set()

        # Exact-header-name fingerprints (presence alone is uniquely a WAF)
        for hname, waf in self._WAF_HEADER_FINGERPRINTS.items():
            if hname in h_lower:
                seen_names.add(waf)

        # Value-match fingerprints: the header name alone is ambiguous,
        # only flag when the value contains a known vendor substring.
        for hname, vendor_patterns in self._WAF_HEADER_VALUE_FINGERPRINTS.items():
            if hname not in h_lower:
                continue
            h_val = str(h_lower[hname] or "").lower()
            if not h_val:
                continue
            for needle, vendor in vendor_patterns:
                if needle in h_val:
                    seen_names.add(vendor)

        # Server-header value fingerprints (substring match on the value)
        server_val = h_lower.get("server", "").lower()
        via_val = h_lower.get("via", "").lower()
        combined_id = f"{server_val} | {via_val}"
        for needle, waf in self._WAF_SERVER_VALUE_FINGERPRINTS:
            if needle in combined_id:
                seen_names.add(waf)

        # Body signatures — only bother scanning when the page looked
        # like a block page (low byte count AND/OR common block words)
        # so we don't flag 'ModSecurity' on a page that documents it.
        body_scan = html[:10000] if html else ""
        if body_scan:
            lower_head = body_scan[:2000].lower()
            block_like = (
                len(body_scan) < 8000 and
                any(w in lower_head for w in
                    ("blocked", "forbidden", "access denied",
                     "ray id", "incident id", "attention required",
                     "reference #", "request unsuccessful"))
            )
            if block_like:
                for pat, waf in self._WAF_BODY_SIGNATURES:
                    if pat.search(body_scan):
                        seen_names.add(waf)

        if seen_names:
            names_s = ", ".join(sorted(seen_names))
            findings.append({
                "severity": SEV_INFO,
                "title": f"WAF / CDN detected: {names_s}",
                "detail": (f"Target is fronted by {names_s}. Payload "
                           f"mutations (case-flip, inline comments, "
                           f"whitespace substitution) may be required."),
                "evidence": f"Detected via: {names_s}",
                "exploit_info": {
                    "type": "waf_fingerprint",
                    "waf": names_s,
                    "method": ("Use WAF-specific bypass catalogs. "
                               "Cloudflare: IP-direct origin, X-Originating-IP "
                               "trust. Imperva: HTTP/2 smuggling. "
                               "F5: oversized cookie/header tricks. "
                               "Akamai: cache-poisoning + pragma-cache."),
                    "risk": "Bypass depends on which WAF is in the path",
                },
            })
        return findings

    def _check_login_forms(self, base_url: str, html: str) -> List[dict]:
        """Detect authentication forms + test whether they rate-limit.

        Signals:
        1. Form exists with <input type="password"> — INFO finding,
           captures the field names / hidden-token fields so the
           walkthrough can build a hydra-friendly brute-force command.
        2. 4 consecutive wrong-password POSTs (with a clearly-fake
           throwaway username) all return the same status + near-
           identical body length and no 429 — MEDIUM
           'brute_force_viable' finding.

        The throwaway username is 'gsprobe<hex>notareal' so no real
        account can ever get locked by the probe. The probe loop
        stops early on 429.
        """
        findings = []
        if not HAS_BS4 or not html:
            return findings
        domain = urlparse(base_url).netloc
        if self._session.is_domain_blocked(domain):
            return findings

        try:
            soup = BeautifulSoup(html[:200000], "html.parser")
        except Exception:
            return findings

        # Find forms containing a password input.
        login_forms: List[dict] = []
        for form in soup.find_all("form"):
            pwd_inputs = form.find_all("input", attrs={"type": "password"})
            if not pwd_inputs:
                continue
            action = form.get("action", "") or ""
            method = (form.get("method", "POST") or "POST").upper()
            form_url = urljoin(base_url, action) if action else base_url
            if urlparse(form_url).netloc != domain:
                continue
            # Identify username / password field names
            uname_field = None
            pwd_field = None
            for inp in form.find_all("input"):
                name = inp.get("name", "")
                itype = (inp.get("type", "text") or "text").lower()
                if not name:
                    continue
                if itype == "password" and not pwd_field:
                    pwd_field = name
                elif (itype in ("text", "email") or
                      name.lower() in ("user", "username", "email", "login",
                                       "account", "userid")) and not uname_field:
                    uname_field = name
            if not pwd_field:
                continue
            login_forms.append({
                "url": form_url,
                "method": method,
                "username_field": uname_field or "username",
                "password_field": pwd_field,
                "hidden_fields": {
                    (inp.get("name") or ""): (inp.get("value") or "")
                    for inp in form.find_all("input", attrs={"type": "hidden"})
                    if inp.get("name")
                },
            })

        if not login_forms:
            return findings

        login_form = login_forms[0]
        path_disp = urlparse(login_form['url']).path or '/'
        findings.append({
            "severity": SEV_INFO,
            "title": f"Login form at {path_disp}",
            "detail": (f"Login form discovered — "
                       f"user={login_form['username_field']} / "
                       f"pass={login_form['password_field']}. "
                       f"Useful as a brute-force target if no rate limit."),
            "evidence": (f"{login_form['method']} "
                         f"{login_form['url']} with "
                         f"{len(login_form['hidden_fields'])} hidden field(s)"),
            "confidence": 0.95,
            "exploit_info": {
                "type": "login_form",
                "path": path_disp,
                "username_field": login_form["username_field"],
                "password_field": login_form["password_field"],
                "hidden_fields": list(login_form["hidden_fields"].keys()),
            },
        })

        # Probe rate limiting — 4 rapid-fire wrong-password POSTs with
        # a distinctive-looking throwaway username (clearly fake so no
        # human account gets locked). We compare status codes + body
        # lengths. If EVERY request returns the same code and a similar
        # length, and no 429 shows up, we flag brute-force-friendly.
        # Previously we did 6 probes + an "admin" enumeration probe;
        # the admin probe risked locking a real account on a
        # lockout-after-N-attempts policy, so it's gone.
        # If the username field is named "email" (or similar), use an
        # email-shaped throwaway so apps that reject non-email input
        # don't short-circuit the rate-limit probe on syntax validation
        # before the login logic even runs.
        _uname_field = login_form["username_field"].lower()
        if "email" in _uname_field or "mail" in _uname_field:
            throwaway_user = f"gsprobe{secrets.token_hex(4)}@notareal.test"
        else:
            throwaway_user = f"gsprobe{secrets.token_hex(4)}notareal"
        statuses: List[int] = []
        lengths: List[int] = []
        for _ in range(4):
            if shutdown_requested() or self._session.is_domain_blocked(domain):
                break
            data = {
                login_form["username_field"]: throwaway_user,
                login_form["password_field"]: secrets.token_hex(6),
            }
            data.update(login_form["hidden_fields"])
            # post_form already honors the block/delay machinery.
            resp = self._session.post_form(
                login_form["url"], data, allow_redirects=False,
            )
            if resp is None:
                break
            statuses.append(resp.status_code)
            lengths.append(len(resp.text or ""))
            # If the site just returned a Retry-After or 429 on any
            # request, rate limiting is present — stop probing.
            if resp.status_code == 429:
                break

        if len(statuses) >= 3 and 429 not in statuses:
            # Tight window on body-length jitter: 5% variance is normal
            # (CSRF token changes, random ad slots), more than that
            # means the server's responses aren't uniform.
            avg_len = sum(lengths) / len(lengths) if lengths else 0
            max_dev = (max(abs(l - avg_len) for l in lengths)
                       if lengths and avg_len else 0)
            uniform_len = avg_len > 0 and max_dev <= max(100, avg_len * 0.05)
            same_status = len(set(statuses)) == 1

            if same_status and uniform_len:
                findings.append({
                    "severity": SEV_MEDIUM,
                    "title": "Login form lacks rate limiting",
                    "detail": (f"{len(statuses)} failed-login attempts all "
                               f"returned HTTP {statuses[0]} with a near-"
                               f"identical body length (avg={avg_len:.0f}B, "
                               f"max dev={max_dev:.0f}B). No 429, no "
                               f"progressive slowdown. Brute-force is "
                               f"practical when you have a username list."),
                    "evidence": f"statuses: {statuses}, lengths: {lengths}",
                    "confidence": 0.85,
                    "exploitable": True,
                    "exploit_info": {
                        "type": "brute_force_viable",
                        "path": path_disp,
                        "username_field": login_form["username_field"],
                        "password_field": login_form["password_field"],
                        "method": (f"POST {login_form['url']} with "
                                   f"{login_form['username_field']}=<target> "
                                   f"and {login_form['password_field']}="
                                   f"<wordlist>. Use hydra / ffuf / "
                                   f"Turbo Intruder."),
                        "risk": "Account takeover via brute-force",
                    },
                })

        return findings

    def _check_ssl_cert(self, base_url: str) -> List[dict]:
        """Check SSL/TLS certificate issues."""
        findings = []
        parsed = urlparse(base_url)
        if parsed.scheme != "https":
            findings.append({"severity": SEV_HIGH, "title": "Site uses HTTP (no encryption)",
                             "detail": "All traffic sent in plaintext. Credentials, "
                                       "session tokens visible to network observers.",
                             "evidence": f"Scheme: {parsed.scheme}"})
            return findings

        # We can't do raw TLS checks through Tor SOCKS (the Tor exit does TLS),
        # but we can check what the server reports about its cert via headers
        # and check for common cert-related issues in response behavior
        resp = self._session.get(base_url, allow_wayback=False)
        if resp is None:
            return findings

        # Check if site accepts HTTP (downgrade possible)
        http_url = base_url.replace("https://", "http://", 1)
        http_resp = self._session.get(http_url, allow_wayback=False, method="HEAD")
        if http_resp and http_resp.status_code == 200:
            # Check if it redirects to HTTPS
            if not any(r.status_code in (301, 302) and "https" in r.headers.get("Location", "")
                       for r in http_resp.history):
                findings.append({
                    "severity": SEV_MEDIUM,
                    "title": "HTTP not redirected to HTTPS",
                    "detail": "HTTP version of site responds without redirect. "
                              "Users can be served unencrypted version via MITM.",
                    "evidence": f"HTTP {http_url} returns {http_resp.status_code} without HTTPS redirect"
                })

        return findings


# ══════════════════════════════════════════════════════════════════════════
#  Subdomain Enumerator (via crt.sh certificate transparency)
# ══════════════════════════════════════════════════════════════════════════

class SubdomainEnumerator:
    """Enumerate subdomains from multiple independent sources, validate
    each candidate is DNS-resolvable (to kill wildcard/stale CT noise),
    and fall back to a targeted DNS wordlist brute force when the
    passive sources return thin results.

    Why multiple sources: crt.sh by itself is fragile — it rate-limits
    aggressively from Tor exits, sometimes returns HTML instead of JSON
    (503 with a friendly error page), and has stale entries for hosts
    that were decomissioned years ago. A weak-list of 'what survived'
    gives operators false confidence that they mapped the attack surface.
    We query:

      1. crt.sh                — CT via postgres-backed JSON
      2. certspotter.com       — independent CT aggregator
      3. api.hackertarget.com  — host-search reverse DNS (only first
                                 50 rows; free tier is throttled).
      4. AlienVault OTX         — passive DNS history
      5. RapidDNS               — HTML-scrape fallback (last resort)

    Then every candidate gets a DoH A-record probe to confirm it's
    actually resolvable today. Dead entries get filtered out, ALIVE
    get marked — operators see a count of each. Finally we brute-force
    a small wordlist of high-value prefixes (admin/dev/staging/api/…)
    via DoH to catch subdomains that never appeared in a cert.

    Wildcard detection: if a random nonce-prefix resolves we mark the
    zone as wildcard-aware and require a CT hit to keep a host, so we
    don't dump 500 bogus 'abc123.target.com' rows.
    """

    # Free sources. Each returns a structured JSON payload we can
    # parse; when one blocks/errs we fall through to the next.
    CRTSH_URL = "https://crt.sh/?q={domain}&output=json"
    CERTSPOTTER_URL = ("https://api.certspotter.com/v1/issuances"
                       "?domain={domain}&include_subdomains=true&expand=dns_names")
    HACKERTARGET_URL = "https://api.hackertarget.com/hostsearch/?q={domain}"
    OTX_URL = ("https://otx.alienvault.com/api/v1/indicators/"
               "domain/{domain}/passive_dns")
    RAPIDDNS_URL = "https://rapiddns.io/subdomain/{domain}?full=1#result"

    DOH_URL = "https://cloudflare-dns.com/dns-query"

    # High-value DNS bruteforce prefixes. We keep this tight so that
    # even with per-domain delays we don't spend ten minutes enumerating
    # a single zone over Tor.
    BRUTE_WORDLIST = (
        "www", "api", "dev", "staging", "stage", "test", "qa", "uat",
        "admin", "administrator", "adminpanel", "cpanel", "portal",
        "console", "dashboard", "control", "panel", "manage",
        "auth", "login", "sso", "idp", "okta", "saml", "oauth",
        "mail", "smtp", "imap", "pop", "webmail", "owa", "exchange",
        "git", "gitlab", "gitea", "jira", "confluence", "wiki",
        "jenkins", "ci", "build", "drone", "circle", "teamcity",
        "mon", "monitor", "grafana", "prometheus", "kibana",
        "elastic", "es", "splunk", "logs",
        "vpn", "rdp", "ssh", "ftp", "sftp", "s3", "storage",
        "cdn", "static", "assets", "media", "img", "images",
        "files", "docs", "download", "uploads",
        "blog", "news", "shop", "store", "pay", "payments", "billing",
        "secure", "private", "internal", "intranet",
        "status", "health", "metrics",
        "db", "database", "mysql", "pg", "postgres", "mongo",
        "cache", "redis", "memcache",
        "beta", "alpha", "preview", "sandbox", "demo",
        "old", "legacy", "archive", "backup",
        "m", "mobile", "api-v1", "api-v2", "api-v3", "v1", "v2",
        "ws", "websocket",
    )

    def __init__(self, session: TorSession):
        self._session = session
        self._resolved: Dict[str, Optional[str]] = {}

    # ── DoH helpers ────────────────────────────────────────────────
    def _doh_resolve(self, name: str, rtype: str = "A") -> List[str]:
        """Single DoH lookup. Returns the list of answer data strings,
        or [] on any failure. Cached by (name, rtype) to avoid burning
        circuits on duplicate probes."""
        cache_key = f"{name}|{rtype}"
        if cache_key in self._resolved:
            cached = self._resolved[cache_key]
            return cached if isinstance(cached, list) else []
        url = f"{self.DOH_URL}?name={quote(name)}&type={rtype}"
        resp = self._session.get(
            url,
            headers={"Accept": "application/dns-json"},
            allow_wayback=False,
        )
        data: List[str] = []
        if resp is not None:
            try:
                payload = resp.json()
                if isinstance(payload, dict):
                    for ans in payload.get("Answer", []) or []:
                        d = (ans.get("data") or "").strip('"')
                        if d:
                            data.append(d)
            except (ValueError, KeyError):
                pass
        self._resolved[cache_key] = data
        return data

    def _is_resolvable(self, host: str) -> bool:
        """True if the name resolves to ANY A or AAAA record."""
        if self._doh_resolve(host, "A"):
            return True
        return bool(self._doh_resolve(host, "AAAA"))

    def _detect_wildcard(self, domain: str) -> bool:
        """Some zones answer every *.zone with the same IP. Probe a
        nonce-prefix to detect that, so we don't dump 500 garbage
        results from sources that honor wildcards."""
        nonce = secrets.token_hex(8)
        return bool(self._doh_resolve(f"{nonce}.{domain}", "A"))

    # ── Source-specific collectors ─────────────────────────────────
    def _parse_valid_subdomain(self, raw: str, domain: str) -> Optional[str]:
        line = (raw or "").strip().lower()
        if not line:
            return None
        if line.startswith("*."):
            line = line[2:]
        # Kill embedded whitespace / control chars. CT entries
        # occasionally contain email addresses in CN fields.
        if "@" in line or " " in line or "\t" in line:
            return None
        if not (line == domain or line.endswith("." + domain)):
            return None
        if not re.match(r"^[a-z0-9.\-]+$", line):
            return None
        if len(line) > 253:
            return None
        return line

    def _from_crtsh(self, domain: str) -> Set[str]:
        out: Set[str] = set()
        url = self.CRTSH_URL.format(domain=quote(f"%.{domain}"))
        # allow_wayback=False on EVERY aggregator call. The default
        # get() method falls back to https://web.archive.org/web/2/<url>
        # on timeout, which literally submits the target-bearing
        # URL (e.g. crt.sh/?q=%.target.example.com) to Internet
        # Archive's public logs — a permanent record that THIS target
        # was enumerated. Every subdomain source below gets the same
        # treatment.
        resp = self._session.get(url, allow_wayback=False)
        if not resp or resp.status_code != 200:
            return out
        try:
            entries = resp.json()
        except (ValueError, KeyError):
            return out
        if not isinstance(entries, list):
            return out
        for entry in entries[:5000]:
            name = entry.get("name_value") or ""
            for piece in name.split("\n"):
                cand = self._parse_valid_subdomain(piece, domain)
                if cand:
                    out.add(cand)
        return out

    def _from_certspotter(self, domain: str) -> Set[str]:
        out: Set[str] = set()
        url = self.CERTSPOTTER_URL.format(domain=quote(domain))
        resp = self._session.get(url, allow_wayback=False)
        if not resp or resp.status_code != 200:
            return out
        try:
            entries = resp.json()
        except (ValueError, KeyError):
            return out
        if not isinstance(entries, list):
            return out
        for entry in entries[:5000]:
            for n in entry.get("dns_names") or []:
                cand = self._parse_valid_subdomain(n, domain)
                if cand:
                    out.add(cand)
        return out

    def _from_hackertarget(self, domain: str) -> Set[str]:
        out: Set[str] = set()
        url = self.HACKERTARGET_URL.format(domain=quote(domain))
        resp = self._session.get(url, allow_wayback=False)
        if not resp or resp.status_code != 200:
            return out
        text = resp.text or ""
        if "API count exceeded" in text or "error" in text.lower()[:80]:
            return out
        for row in text.splitlines():
            host = row.split(",", 1)[0]
            cand = self._parse_valid_subdomain(host, domain)
            if cand:
                out.add(cand)
        return out

    def _from_otx(self, domain: str) -> Set[str]:
        out: Set[str] = set()
        url = self.OTX_URL.format(domain=quote(domain))
        resp = self._session.get(url, allow_wayback=False)
        if not resp or resp.status_code != 200:
            return out
        try:
            payload = resp.json()
        except (ValueError, KeyError):
            return out
        if not isinstance(payload, dict):
            return out
        for item in payload.get("passive_dns", []) or []:
            host = item.get("hostname") or ""
            cand = self._parse_valid_subdomain(host, domain)
            if cand:
                out.add(cand)
        return out

    def _from_rapiddns(self, domain: str) -> Set[str]:
        """HTML-scrape fallback. Only used when everything else
        returned <10 results — this service occasionally shadow-bans
        Tor exits."""
        out: Set[str] = set()
        url = self.RAPIDDNS_URL.format(domain=quote(domain))
        resp = self._session.get(url, allow_wayback=False)
        if not resp or resp.status_code != 200:
            return out
        # Names appear inside <td>host.example.com</td> cells. The
        # page body is case-preserving so we match case-insensitively
        # AND normalize to lowercase before _parse_valid_subdomain
        # (which requires lowercase). Old regex anchored on a lazy
        # quantifier with [a-z0-9.\-]+? which minimum-matched and
        # frequently captured just the TLD; widen to a reasonable
        # greedy bound and drop the bogus first-char class.
        body = resp.text or ""
        # Match <td>...>label.label...<target-domain></td>-style cells.
        # The host label set is case-insensitive; we lowercase via
        # _parse_valid_subdomain. Length cap (253) is enforced there.
        pat = (r">\s*([A-Za-z0-9][A-Za-z0-9.\-]{0,250}\."
               + re.escape(domain) + r")\s*<")
        for m in re.finditer(pat, body):
            cand = self._parse_valid_subdomain(m.group(1), domain)
            if cand:
                out.add(cand)
        return out

    def _brute_force(self, domain: str,
                     known: Set[str],
                     max_new: int = 60) -> Set[str]:
        """DoH-based prefix brute force. Keeps CALL counts tight so we
        don't keep Tor circuits open for an hour.

        Previously the wordlist was iterated in declared order
        (www → api → dev → staging → …). A defender tailing their
        own DNS logs sees the exact scanner signature. We shuffle the
        list per-session using secrets (cryptographic RNG, not
        seedable) so each scan has a unique probe order. Defenders
        still see 'someone probed 90 prefixes' but there's no
        stable sequence fingerprint between runs.
        """
        shuffled = list(self.BRUTE_WORDLIST)
        # Cryptographic shuffle: secrets.SystemRandom is CSPRNG-backed.
        secrets.SystemRandom().shuffle(shuffled)
        out: Set[str] = set()
        for prefix in shuffled:
            if shutdown_requested():
                break
            if len(out) >= max_new:
                break
            host = f"{prefix}.{domain}"
            if host in known:
                continue
            if self._is_resolvable(host):
                out.add(host)
        return out

    # ── Orchestration ──────────────────────────────────────────────
    def enumerate(self, domain: str,
                  brute_force: bool = True,
                  verify_resolvable: bool = True) -> List[str]:
        """Multi-source enumeration with optional DNS validation.

        Back-compat: returns the same List[str] the old enumerator did.
        Callers that want the full diagnostic (per-source counts,
        wildcard status, resolvable vs unresolved) should use
        enumerate_detailed().
        """
        return self.enumerate_detailed(
            domain,
            brute_force=brute_force,
            verify_resolvable=verify_resolvable,
        )["subdomains"]

    def enumerate_detailed(self, domain: str,
                           brute_force: bool = True,
                           verify_resolvable: bool = True) -> Dict[str, Any]:
        """Run every source, merge, deduplicate, optionally verify via
        DoH, optionally brute-force common prefixes, and return a
        diagnostic dict. Every step is guarded by shutdown_requested()
        so Ctrl-C returns partial results.

        OPSEC ordering:
          1. Wildcard-detect FIRST. If the zone is wildcarded, brute
             force is worthless (every random label resolves) — we'd
             just be broadcasting a long list of high-value prefixes
             to Cloudflare DoH and the zone's own authoritative DNS.
          2. Query passive sources (shuffled order).
          3. Between passive sources, let the role-boundary rotation
             do its thing — but don't call them back-to-back without
             a pause; the circuit rotation cadence handles that.
          4. Opt into rapiddns ONLY when we're starved and the
             operator didn't disable brute force (because rapiddns
             HTML-scraping is noisier than a JSON API).
          5. Verify via DoH and — if NOT wildcard — brute-force.

        Previous bugs fixed here:
          * Wildcard detection ran AFTER passive sources AND brute-
            force both completed, so on a wildcard zone we already
            burned the full brute-force circuit budget before
            discovering the hits were garbage.
          * Wildcard-branch rebuild used `h in s for s in sources`
            but brute_hits had already been unioned into `resolvable`,
            so a brute-force hit that wildcard-resolved got filtered
            correctly — but the source iteration also included
            `rapiddns` (containing brute-force false positives from
            the wildcard), which kept them in the final set.
          * Passive aggregators were called in a deterministic order,
            giving each defender a stable 'scanner signature'.
        """
        # ── Phase A: wildcard detection first ──
        wildcard = False
        if verify_resolvable and not shutdown_requested():
            wildcard = self._detect_wildcard(domain)

        # ── Phase B: passive sources, shuffled order ──
        sources: Dict[str, Set[str]] = {}
        # Cryptographic shuffle — every scan order is different so a
        # defender can't pattern-match "scanner hit crt.sh THEN
        # certspotter THEN OTX THEN hackertarget".
        ordered = [
            ("crt.sh",       self._from_crtsh),
            ("certspotter",  self._from_certspotter),
            ("hackertarget", self._from_hackertarget),
            ("alienvault",   self._from_otx),
        ]
        secrets.SystemRandom().shuffle(ordered)
        for src_idx, (name, fn) in enumerate(ordered):
            if shutdown_requested():
                break
            # Force a fresh Tor circuit between consecutive passive
            # sources. Without this, mutual observers (e.g. a CT
            # aggregator and Cloudflare) see the SAME exit IP hit
            # both services back-to-back — a trivial linkage
            # ('someone enumerated target.example.com via both').
            # Rotation failure is non-fatal; we continue on the
            # current circuit rather than aborting the scan.
            if src_idx > 0:
                try:
                    newnym()
                    time.sleep(0.5 + secrets.randbelow(2000) / 1000.0)
                    # Redraw browser fingerprints for the new circuit.
                    self._session._circuit_generation += 1
                except Exception:
                    integrity_log(
                        "intel",
                        "subdomain_inter_source_rotate_failed")
            try:
                sources[name] = fn(domain)
            except Exception as _src_err:
                integrity_log("intel",
                              f"subdomain_src_fail:{name}:{type(_src_err).__name__}")
                sources[name] = set()

        all_candidates: Set[str] = set()
        for s in sources.values():
            all_candidates |= s

        # ── Phase C: HTML-scrape fallback (rapiddns) ──
        # Only when passive aggregators came back thin. On wildcard
        # zones we STILL try it — it's a passive service, not a
        # brute force — but we later filter wildcard-bogus rows.
        if not shutdown_requested() and len(all_candidates) < 10:
            try:
                rapid = self._from_rapiddns(domain)
                sources["rapiddns"] = rapid
                all_candidates |= rapid
            except Exception as _rdn_err:
                integrity_log("intel",
                              f"subdomain_src_fail:rapiddns:{type(_rdn_err).__name__}")
                sources["rapiddns"] = set()

        # ── Phase D: DoH verify what we've got so far ──
        resolvable: Set[str] = set()
        unresolved: Set[str] = set()
        if verify_resolvable:
            # Cap verification so we don't do 5000 DoH lookups over Tor.
            to_verify = sorted(all_candidates)[:400]
            for host in to_verify:
                if shutdown_requested():
                    break
                if self._is_resolvable(host):
                    resolvable.add(host)
                else:
                    unresolved.add(host)
        else:
            resolvable = set(all_candidates)

        # ── Phase E: brute force, ONLY on non-wildcard zones ──
        brute_hits: Set[str] = set()
        skipped_brute_reason = ""
        if brute_force and not shutdown_requested():
            if wildcard and verify_resolvable:
                skipped_brute_reason = (
                    "wildcard zone — every brute-force probe would "
                    "false-positive resolve; skipping to save circuits"
                )
            else:
                brute_hits = self._brute_force(
                    domain, resolvable | all_candidates)
                resolvable |= brute_hits

        # ── Phase F: final filtering ──
        final_set: Set[str]
        if wildcard and verify_resolvable:
            # On wildcard zones ONLY keep hosts that appeared in at
            # least one passive source (CT / OTX / hackertarget /
            # rapiddns). Brute-force hits would all false-positive
            # but they were skipped above; this guards the other
            # code paths (unverified mode, corner cases).
            passive_union: Set[str] = set()
            for src_name, names in sources.items():
                passive_union |= names
            final_set = {h for h in resolvable if h in passive_union}
        else:
            final_set = resolvable if verify_resolvable else all_candidates

        subs_sorted = sorted(final_set)[:400]
        return {
            "subdomains": subs_sorted,
            "source_counts": {n: len(s) for n, s in sources.items()},
            "total_unique_candidates": len(all_candidates),
            "resolvable_count": len(resolvable),
            "unresolved_count": len(unresolved),
            "brute_hits": sorted(brute_hits),
            "brute_skipped": skipped_brute_reason,
            "wildcard_zone": wildcard,
            "verified": verify_resolvable,
        }


# ══════════════════════════════════════════════════════════════════════════
#  DNS Reconnaissance (via DNS-over-HTTPS through Tor)
# ══════════════════════════════════════════════════════════════════════════

class DNSRecon:
    """DNS record lookup via Cloudflare DNS-over-HTTPS.

    All queries go through Tor. Cloudflare DoH doesn't block Tor exits.
    """

    DOH_URL = "https://cloudflare-dns.com/dns-query"
    RECORD_TYPES = ["A", "AAAA", "MX", "TXT", "NS", "CNAME", "SOA", "CAA", "DNSKEY"]

    # ── Email-spoofing posture ──────────────────────────────────────
    # SPF / DMARC / DKIM aren't "vulnerabilities" in the scanner sense,
    # but a missing / weak SPF or DMARC is directly exploitable: it
    # lets an attacker send forged email from the target's domain. We
    # surface findings so they land in the same report as the web
    # vulns.

    def __init__(self, session: TorSession):
        self._session = session

    def lookup(self, domain: str) -> Dict[str, List[str]]:
        """Query multiple DNS record types for a domain + _dmarc subdomain."""
        results = {}
        for rtype in self.RECORD_TYPES:
            if shutdown_requested():
                break
            records = self._query(domain, rtype)
            if records:
                results[rtype] = records

        # DMARC lives at _dmarc.<domain> as a TXT record. Query
        # separately so the main results dict keeps its
        # by-record-type structure for the printer.
        if not shutdown_requested():
            dmarc_records = self._query(f"_dmarc.{domain}", "TXT")
            if dmarc_records:
                results["DMARC"] = dmarc_records
        return results

    def analyze_email_posture(self, records: Dict[str, List[str]],
                               domain: str = "") -> List[dict]:
        """Produce vuln-shaped findings for SPF / DMARC weaknesses.

        Maps the raw records to the exact same finding dict shape the
        VulnScanner emits so the orchestrator can render them alongside
        the web findings without special casing.
        """
        findings: List[dict] = []

        txt_records = records.get("TXT", []) or []
        dmarc_records = records.get("DMARC", []) or []
        mx_records = records.get("MX", []) or []

        # ── SPF ────────────────────────────────────────────────────
        spf = [t for t in txt_records if t.lower().lstrip().startswith("v=spf1")]
        if not spf:
            # Domains that accept mail (MX set) without SPF are particularly bad.
            sev = SEV_MEDIUM if mx_records else SEV_LOW
            findings.append({
                "severity": sev,
                "title": "Missing SPF record",
                "detail": ("No v=spf1 TXT record. Anyone on the public "
                           "internet can send email claiming to be from "
                           "this domain without tripping receiver checks."),
                "evidence": "No TXT record starting with 'v=spf1'",
                "exploit_info": {
                    "type": "email_spoof",
                    "method": ("Send forged email with the target's "
                               "domain in From:. No SPF means receivers "
                               "have no basis to reject it."),
                    "risk": "Phishing under the target's name",
                },
                "exploitable": True,
            })
        else:
            spf_val = spf[0].lower()
            # SPF terminator: -all = hardfail, ~all = softfail, ?all = neutral, +all = allow-any
            if " +all" in spf_val or spf_val.endswith("+all"):
                findings.append({
                    "severity": SEV_HIGH,
                    "title": "SPF record allows any sender (+all)",
                    "detail": ("The SPF record ends with +all, which "
                               "explicitly allows ANY IP to send email "
                               "as this domain. Equivalent to no SPF."),
                    "evidence": spf[0][:200],
                    "exploit_info": {
                        "type": "email_spoof",
                        "method": "Send forged email — SPF passes regardless of source IP.",
                        "risk": "Phishing under the target's name",
                    },
                    "exploitable": True,
                })
            elif " ?all" in spf_val or spf_val.endswith("?all"):
                findings.append({
                    "severity": SEV_MEDIUM,
                    "title": "SPF record ends with ?all (neutral)",
                    "detail": ("The SPF ends with ?all (neutral). "
                               "Receivers treat unlisted senders as "
                               "undefined, and most accept the mail."),
                    "evidence": spf[0][:200],
                    "exploitable": True,
                    "exploit_info": {
                        "type": "email_spoof",
                        "method": "Send forged email — SPF neutral is widely treated as pass.",
                        "risk": "Phishing under the target's name",
                    },
                })
            elif " ~all" in spf_val or spf_val.endswith("~all"):
                findings.append({
                    "severity": SEV_LOW,
                    "title": "SPF record uses ~all (softfail)",
                    "detail": ("The SPF ends with ~all (softfail). "
                               "Mail still gets delivered — usually to "
                               "spam, but delivered. Consider -all for "
                               "hardfail."),
                    "evidence": spf[0][:200],
                })
            # SPF lookup-explosion (RFC 7208 bans >10 DNS lookups)
            lookup_tokens = spf_val.count("include:") + spf_val.count("a:") + \
                spf_val.count("mx:") + spf_val.count("ptr:") + \
                spf_val.count("exists:") + spf_val.count("redirect=")
            if lookup_tokens > 10:
                findings.append({
                    "severity": SEV_MEDIUM,
                    "title": "SPF record exceeds 10-DNS-lookup limit",
                    "detail": (f"SPF uses {lookup_tokens} DNS-lookup "
                               f"mechanisms (include:, a:, mx:, ptr:, "
                               f"exists:, redirect=). RFC 7208 caps at "
                               f"10; receivers return PermError, which "
                               f"most treat as SPF fail ≡ no SPF."),
                    "evidence": f"{lookup_tokens} lookups in SPF",
                })

        # ── DMARC ─────────────────────────────────────────────────
        dmarc = [t for t in dmarc_records if t.lower().lstrip().startswith("v=dmarc1")]
        if not dmarc:
            sev = SEV_MEDIUM if mx_records or spf else SEV_LOW
            findings.append({
                "severity": sev,
                "title": "Missing DMARC record",
                "detail": ("No DMARC record at _dmarc.<domain>. Even if "
                           "SPF is configured, receivers have no "
                           "aligned policy to apply, so forged mail "
                           "often passes."),
                "evidence": f"No v=dmarc1 TXT at _dmarc.{domain or '<target>'}",
                "exploit_info": {
                    "type": "email_spoof",
                    "method": ("Mismatched From: / Return-Path: passes "
                               "SPF but fails DMARC alignment — with no "
                               "DMARC policy, receivers accept it."),
                    "risk": "Phishing with realistic From: line",
                },
                "exploitable": True,
            })
        else:
            dmarc_val = dmarc[0].lower()
            # DMARC policy: p=none (monitor only), p=quarantine, p=reject.
            if "p=none" in dmarc_val:
                findings.append({
                    "severity": SEV_LOW,
                    "title": "DMARC policy is p=none (monitor only)",
                    "detail": ("DMARC is configured but set to p=none, "
                               "which tells receivers to accept "
                               "failing mail and only report it. No "
                               "protection against spoofing."),
                    "evidence": dmarc[0][:200],
                    "exploitable": True,
                    "exploit_info": {
                        "type": "email_spoof",
                        "method": "Spoof freely — DMARC failures are reported, not rejected.",
                        "risk": "Phishing under the target's name",
                    },
                })
            if "pct=" in dmarc_val:
                m = re.search(r"pct=(\d+)", dmarc_val)
                if m:
                    pct = int(m.group(1))
                    if 0 < pct < 100:
                        findings.append({
                            "severity": SEV_LOW,
                            "title": f"DMARC pct={pct} (partial enforcement)",
                            "detail": (f"Only {pct}% of failing mail is "
                                       f"enforced. The other {100-pct}% "
                                       f"slips through regardless of "
                                       f"the p= policy."),
                            "evidence": dmarc[0][:200],
                        })

        # ── DNSSEC ────────────────────────────────────────────────
        if not records.get("DNSKEY"):
            # Informational only — most domains don't deploy DNSSEC.
            findings.append({
                "severity": SEV_INFO,
                "title": "DNSSEC not deployed",
                "detail": ("No DNSKEY records returned. Zone is "
                           "vulnerable to cache-poisoning / on-path DNS "
                           "attacks. Not a web vulnerability per se."),
                "evidence": "No DNSKEY records",
            })

        return findings

    def _query(self, domain: str, rtype: str) -> List[str]:
        """Single DNS-over-HTTPS query."""
        params = f"?name={quote(domain)}&type={rtype}"
        resp = self._session.get(
            self.DOH_URL + params,
            headers={"Accept": "application/dns-json"},
            allow_wayback=False,
        )
        if not resp:
            return []
        try:
            data = resp.json()
            answers = data.get("Answer", [])
            return [a.get("data", "").strip('"') for a in answers
                    if a.get("data")][:20]
        except (ValueError, KeyError):
            return []


