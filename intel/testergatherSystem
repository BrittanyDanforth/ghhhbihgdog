    def _check_subdomain_takeover(self, domain: str, cnames: List[str]) -> List[dict]:
        """Check for subdomain takeover via dangling CNAME records."""
        findings = []

        for cname in cnames:
            cname_lower = cname.lower().rstrip(".")
            for service_domain, (service_name, fingerprint) in self.TAKEOVER_FINGERPRINTS.items():
                if service_domain not in cname_lower:
                    continue
                # Verify: try to access the subdomain and check for takeover fingerprint
                for scheme in ["https", "http"]:
                    try:
                        resp = self._session.get(f"{scheme}://{domain}", allow_wayback=False)
                        if resp and fingerprint.lower() in resp.text.lower():
                            findings.append({
                                "severity": SEV_HIGH,
                                "title": f"Subdomain takeover possible via {service_name}",
                                "detail": f"CNAME points to {cname_lower} but the {service_name} "
                                          f"resource is unclaimed. An attacker can claim it and "
                                          f"serve arbitrary content on {domain}.",
                                "evidence": f"CNAME: {cname_lower}, fingerprint: '{fingerprint[:40]}'",
                                "exploitable": True,
                                "exploit_info": {
                                    "type": "subdomain_takeover",
                                    "service": service_name,
                                    "cname": cname_lower,
                                    "method": f"Register the unclaimed resource on {service_name} "
                                              f"to take control of {domain}. "
                                              f"Then serve phishing pages, steal cookies, or "
                                              f"bypass CSP/CORS restrictions.",
