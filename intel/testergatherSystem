# Content-encodings we can ACTUALLY decode. urllib3 decodes gzip
# and deflate unconditionally; brotli only works if the 'brotli' or
# 'brotlipy' package is importable; zstd only if the 'zstandard'
# package is importable. Advertising encodings we can't decode means
# the server returns opaque bytes that requests leaves as-is, so
# resp.text is garbage — every body-based check (sqli indicators,
# xss reflection, honeypot detection, path validators) silently
# false-negatives. Worse, advertising an encoding without the
# decoder is itself a bot fingerprint a WAF can trip on.
def _detect_supported_encodings() -> str:
    encs = ["gzip", "deflate"]
    try:
        import brotli  # noqa: F401
        encs.append("br")
    except ImportError:
        try:
            import brotlicffi  # noqa: F401
            encs.append("br")
        except ImportError:
            pass
    try:
        import zstandard  # noqa: F401
        encs.append("zstd")
    except ImportError:
        pass
    return ", ".join(encs)


_SUPPORTED_ENCODINGS = _detect_supported_encodings()


