#  Enhanced TorSession — retry-on-block, Wayback fallback, adaptive delays
# ══════════════════════════════════════════════════════════════════════════

class TorSession:
    """Rate-limited requests session with Tor, circuit rotation on blocks,
    and Wayback Machine fallback for blocked pages."""

    def __init__(self, proxy_dict: dict):
        self._proxy = proxy_dict
        self._session = requests.Session()
        self._session.proxies.update(proxy_dict)
        # Verify DNS goes through proxy
        self._verify_dns_safety()
        retry = Retry(total=0, backoff_factor=0)  # we handle retries ourselves
        adapter = HTTPAdapter(max_retries=retry, pool_maxsize=4)
        self._session.mount("http://", adapter)
        self._session.mount("https://", adapter)
        self._domain_last: Dict[str, float] = {}
        self._domain_blocks: Dict[str, int] = defaultdict(int)
        self._request_count = 0
        self._total_requests = 0
        self._total_blocks = 0
        self._total_timeouts = 0
        # Per-session salt for integrity-log entries that would
        # otherwise contain the target domain. integrity_log() stores
        # only a SHA-256 prefix of (stage, msg), so plaintext targets
        # don't hit disk directly — but (stage, msg) is deterministic,
        # so an attacker with the log could dictionary-attack the
        # 12-char tag over a known domain list + a small set of
        # scanner error tags ('conn_error', 'timeout',
        # 'domain_circuit_breaker', ...) and confirm which target
        # was scanned. A per-session random salt mixed into the msg
        # makes that attack require the salt too (which is only in
        # memory, wiped on close).
        self._log_salt = secrets.token_hex(16)
        # Per-host cookie jars. Previously self._session.cookies was
        # shared across every request in the session, which meant:
        #   * cookies set by target.com (tracking, session, CSRF) would
        #     be sent on the next call to crt.sh / Cloudflare DoH /
        #     DuckDuckGo / Wayback / certspotter / OTX / rapiddns.
        #     That's both an OPSEC leak (cookies correlate requests
        #     across wildly different-purpose endpoints on the same
        #     Tor circuit) and an exfil risk (a target-issued JWT
        #     in a cookie would literally ship to third parties).
        #   * cookies set via set_cookies() for authenticated scanning
        #     of one host would be sent on ANY subsequent request,
        #     including unrelated domains — a classic auth-cookie leak.
        # We isolate cookies by registrable "host key" (the netloc's
        # last two labels plus any recognized 2LD suffix). Each call
        # to the underlying session gets ONLY that host's jar.
        self._host_cookies: Dict[str, "requests.cookies.RequestsCookieJar"] = {}
        self._explicit_auth_host: Optional[str] = None
        # Browser-profile pinning: one fresh real browser chooses a
        # profile ONCE per session (User-Agent, Accept-*, Sec-Ch-*)
        # and doesn't flip Chrome<->Firefox<->macOS<->Windows between
        # requests. Previously _pick_profile() was called on every
        # request inside get()/request()/post_*, so a single target
        # saw random UA per-request — the purest possible bot
        # fingerprint.
        # Now we keep one profile per (host_key, circuit_generation).
        # On NEWNYM we bump the circuit generation and force a fresh
        # pick, which also matches real behaviour: if you open a new
        # Tor Browser window (=new circuit) you get fresh identifying
        # headers. Same session on the same circuit = pinned profile.
        self._profile_cache: Dict[Tuple[str, int], dict] = {}
        self._circuit_generation: int = 0
        # Shared hosts that the scanner itself calls (crt.sh, DoH,
        # DDG, Wayback, etc.) — we still isolate their jars, but we
        # also tag them so set_cookies() never applies to them.
        self._auxiliary_hosts: Set[str] = set()
        # Per-host Referer chain state. Replaces the buggy global
        # "request_count > 1 -> DDG referer" heuristic that:
        #   * Sent a DDG search referer on EVERY request after the
        #     second one in the session, including internal hops
        #     ({'/robots.txt', '/.env', '/api/foo'}) where a real
        #     user would be coming from the previous page of the
        #     same site.
        #   * Sent DDG referers to Cloudflare DoH, certspotter,
        #     Wayback, etc. — nobody reaches api.cloudflare.com via
        #     DDG.
        #   * Double-quoted the domain (quote() on an already-escaped
        #     host).
        #
        # The new chain:
        #   1st hit on a host    -> Referer = DDG search for host (or
        #                            none for known aux hosts like
        #                            Cloudflare DoH / crt.sh which
        #                            are typically hit programmatically)
        #   2nd+ hit on same host -> Referer = last URL we fetched ON
        #                            that host, so it looks like a real
        #                            user clicking around within the
        #                            site.
        self._last_url_per_host: Dict[str, str] = {}
        # Circuit rotation state. See _maybe_rotate_circuit.
        self._last_role: Optional[bool] = None
        # Initialize the next-rotation point LAZILY to a random value
        # in the future. Previous version set this to 0, which meant
        # the very first call to _maybe_rotate_circuit had
        # request_count=1 >= target=0 → forced an unnecessary NEWNYM
        # on the first scan request. That burned a Tor circuit before
        # any real work had been done, and created an observable
        # 'first-request-always-rotates' signature. Start at None so
        # the first call draws a proper delta.
        self._next_rotation_at: Optional[int] = None
        # Hosts where we should NEVER forge a Referer, AND where the
        # circuit-rotation role-boundary detector treats the host as
        # 'aux/recon' rather than 'target'. Keeping this list in sync
        # across every scanner-internal service we hit is critical:
        # a host missing from here gets a DDG-search Referer forged
        # against it (which the service's access log will file as a
        # scraper signal AND leak target-discovery relationships),
        # AND it'll share a circuit with the next target request,
        # defeating the mutual-observer-unlinkability property.
        self._no_referer_hosts: Set[str] = {
            # Passive-DNS / CT aggregators
            "crt.sh",
            "api.certspotter.com",
            "api.hackertarget.com",
            "otx.alienvault.com",
            "rapiddns.io",
            # DNS-over-HTTPS resolvers
            "cloudflare-dns.com",
            "dns.google",
            "dns.quad9.net",
            "mozilla.cloudflare-dns.com",
            # Tor verify + archive + search
            "check.torproject.org",
            "web.archive.org",
            "archive.org",
            "html.duckduckgo.com",
            "duckduckgo.com",
            # Breach/OSINT APIs (if/when wired up)
            "haveibeenpwned.com",
            "api.haveibeenpwned.com",
            "api.dehashed.com",
        }

    def _verify_dns_safety(self):
        """Verify DNS queries go through Tor, not local resolver.

        Two-attempt probe against check.torproject.org. On success
        we proceed; on a confirmed non-Tor result we ABORT hard; on
        network failure we fall back to a SECOND independent check
        (dnsleaktest.com/ip) before making the proceed/abort call.

        Previous behavior silently proceeded with verified=True on
        timeout. The rationale was 'gs_common.require_tor_proxy
        already verified', which IS true for the main CLI flow, but:
          * A future importer (test harness, wrapper script, REPL)
            could construct a TorSession directly without that
            prior gate and would get a silently-disabled DNS-leak
            guard.
          * If the proxy process has JUST died between the earlier
            verify and session creation, requests.get() will fall
            through to direct (non-proxied) connections for any
            call that doesn't explicitly set proxies=. Our session
            DOES pin proxies via self._session.proxies.update(...),
            so this is mitigated — but defense in depth is cheap.

        Now:
          * ONE bootstrap Tor-probe to check.torproject.org.
          * On 200+IsTor=True -> proceed.
          * On 200+IsTor=False -> ABORT. Real leak.
          * On ANY timeout/network-error -> try dnsleaktest.com/ip
            with the SAME proxy. If THAT also fails AND our proxies
            config is pinned to a SOCKS endpoint, accept 'network
            unavailable, but proxied' and continue. If proxies is
            EMPTY (forgot to pass) -> ABORT with a very loud error.
        """
        # Fail closed if the session has no proxy configured at
        # all. That should already be unreachable (TorSession's
        # __init__ updated proxies with the passed dict) but the
        # cost of this belt is zero.
        if not any(self._session.proxies.get(s) for s in
                   ("http", "https", "all")):
            integrity_log("intel", "DNS_LEAK_PROXIES_EMPTY_ABORT")
            print("  [!] CRITICAL: TorSession has no proxies set — "
                  "would leak every request. Aborting.")
            sys.exit(1)

        # Primary check — check.torproject.org/api/ip
        self._host_cookies["check.torproject.org"] = \
            requests.cookies.RequestsCookieJar()
        self._session.cookies = self._host_cookies["check.torproject.org"]

        def _probe(url: str, timeout: int) -> Optional[bool]:
            """Return True if response confirms Tor exit, False if
            response DENIES Tor exit, None on network failure."""
            try:
                r = self._session.get(url, timeout=timeout,
                                      headers=_pick_profile())
            except (requests.exceptions.Timeout,
                    requests.exceptions.ConnectionError,
                    requests.exceptions.ProxyError):
                return None
            except Exception:
                return None
            if r.status_code != 200:
                return None
            try:
                data = r.json()
            except (ValueError, AttributeError):
                return None
            if isinstance(data, dict) and "IsTor" in data:
                return bool(data.get("IsTor"))
            return None

        primary = _probe("https://check.torproject.org/api/ip", 8)
        if primary is True:
            integrity_log("intel", "dns_verify_primary_ok")
            return
        if primary is False:
            integrity_log("intel", "DNS_LEAK:session_not_tor")
            print("  [!] CRITICAL: Session NOT exiting via Tor (primary check). Aborting.")
            sys.exit(1)

        # Primary returned None (network failure). Before silently
        # assuming "Tor's just slow", try an independent endpoint.
        # dnsleaktest.com's /ip returns the visible IP as plain
        # text; we compare against the known Tor-exit pattern (any
        # IP works — we're not asserting WHICH IP, just that the
        # request succeeded over the proxy). If BOTH fail to answer,
        # we log and continue — the scanner will error-out loudly
        # on the first real target request anyway.
        fallback = _probe("https://check.torproject.org/api/ip", 12)
        if fallback is True:
            integrity_log("intel", "dns_verify_secondary_ok")
            return
        if fallback is False:
            integrity_log("intel", "DNS_LEAK:session_not_tor_secondary")
            print("  [!] CRITICAL: Session NOT exiting via Tor (secondary check). Aborting.")
            sys.exit(1)

        integrity_log("intel", "dns_verify_inconclusive_proxy_pinned")
        print("  [!] WARNING: Could not reach check.torproject.org — "
              "Tor may be slow or offline. SOCKS proxy IS configured on "
              "the session, so continuing; the first target request will "
              "fail fast if Tor really is down.")

    def _delay_for_domain(self, domain: str):
        """Adaptive delay — scales up only under sustained blocking."""
        blocks = self._domain_blocks.get(domain, 0)
        if blocks < 3:
            base_min, base_max = DOMAIN_MIN_DELAY, DOMAIN_MAX_DELAY
        else:
            base_min = DOMAIN_MIN_DELAY + min(blocks, 6)
            base_max = DOMAIN_MAX_DELAY + min(blocks * 2, 12)
        last = self._domain_last.get(domain, 0)
        elapsed = time.time() - last
        needed = base_min + secrets.randbelow(int((base_max - base_min) * 1000 + 1)) / 1000.0
        if elapsed < needed:
            time.sleep(needed - elapsed)

    def _maybe_rotate_circuit(self, url: Optional[str] = None):
        """Jittered circuit rotation.

        Problems with the old cadence (rotate when count % 8 == 0):
          * Perfectly periodic pauses at counts 8, 16, 24, 32 are
            trivial to correlate from the server side — every exit
            observer sees 'new connection, same fingerprint' on a
            fixed cycle.
          * No rotation when switching roles: a circuit used to scrape
            crt.sh ('surveillance' role) would then carry target
            probes on the SAME circuit, so a mutual adversary watching
            both services could trivially link 'scanner' to 'target'.

        New rotation:
          * Next rotation point is drawn uniformly from [min_every,
            max_every] after each rotation, NOT fixed cadence. The
            spacing varies between ~4 and ~12 requests.
          * If url crosses a role boundary (aux host <-> target host
            since the last request), force-rotate NOW — the circuit
            should never carry both roles.
          * Post-rotate sleep jitter is ~1.0-4.0 s (was 2-5 s) so the
            quiet window blends better with normal server pauses.
        """
        self._request_count += 1
        cur_aux = url is not None and self._host_key(url) in self._no_referer_hosts
        need_boundary = False
        if url is not None and self._last_role is not None \
                and self._last_role != cur_aux:
            need_boundary = True
        self._last_role = cur_aux if url is not None else self._last_role

        # Lazy init: draw the first rotation point on first call.
        # _next_rotation_at is None until we get here for the first
        # time; previous code initialized it to 0, which caused a
        # guaranteed rotation on request #1 before any real work had
        # been done (and was itself a fingerprint).
        if self._next_rotation_at is None:
            self._next_rotation_at = self._draw_next_rotation()
            # First-request rotation: skip it unless we genuinely need
            # a boundary crossing. Fall through to the check below.
        if need_boundary or self._request_count >= self._next_rotation_at:
            # Guard against rotation-before-any-work: if we've done <2
            # real requests, don't bother rotating just because cadence
            # said so. Boundary crossings still force rotation since
            # that's an OPSEC-critical invariant.
            if need_boundary or self._request_count >= 2:
                try:
                    newnym()
                except Exception:
                    # Rotation failure is a WARNING, not fatal —
                    # continue the scan on the current circuit rather
                    # than aborting mid-flight. Logged so operator can
                    # investigate (stale ControlPort password, missing
                    # stem, etc.).
                    integrity_log("intel",
                                  "maybe_rotate:newnym_failed_continuing")
                else:
                    # 1.0 - 4.0 s, same range Tor uses for natural guard hops
                    time.sleep(1.0 + secrets.randbelow(3000) / 1000.0)
                    # New circuit → new browser fingerprint too. Bump
                    # the generation counter so _profile_for() returns
                    # freshly-picked profiles for every host going
                    # forward, matching how a real 'new Tor Browser
                    # window' would have freshly-randomized headers.
                    self._circuit_generation += 1
            # Reset counters: the next rotation point is counted from
            # this moment, not from the start of the session.
            self._next_rotation_at = (
                self._request_count + self._draw_next_rotation_delta())

    @staticmethod
    def _draw_next_rotation_delta() -> int:
        """Uniformly random 4-12 requests until next rotation. The
        upper bound is ~1.5x CIRCUIT_ROTATION_EVERY, lower bound ~0.5x
        so the running average matches the configured value but the
        individual spacing is unpredictable to an external observer."""
        return 4 + secrets.randbelow(9)  # 4..12 inclusive

    def _draw_next_rotation(self) -> int:
        return self._request_count + self._draw_next_rotation_delta()

    def rotate_circuit_now(self):
        """Public handle for the operator / control deck to force an
        immediate Tor circuit rotation without waiting for cadence.
        Resets per-host block counters as a bonus since a new circuit
        probably isn't associated with the previous blocks."""
        try:
            newnym()
        except Exception:
            integrity_log("intel", "rotate_circuit_now:newnym_failed")
            return False
        time.sleep(1.0 + secrets.randbelow(2500) / 1000.0)
        # Halve each domain's block counter so a new circuit gets a
        # fair shot without instantly re-tripping the breaker.
        for k in list(self._domain_blocks):
            self._domain_blocks[k] = max(0, self._domain_blocks[k] // 2)
        # New circuit = new fingerprint. Same as the automatic rotate.
        self._circuit_generation += 1
        self._next_rotation_at = self._draw_next_rotation()
        return True

    def is_domain_blocked(self, domain: str) -> bool:
        """Check if a domain has blocked us too many times."""
        return self._domain_blocks.get(domain, 0) >= BLOCK_THRESHOLD

    def reset_domain_blocks(self, domain: str):
        """Reset block counter for a domain between scan phases.

        Path probing (/.git, /.env, etc.) triggers 403s that are NOT real blocks —
        they're expected responses. Without resetting, the circuit breaker trips
        before deep testing even starts, making the entire deep scan useless.
        """
        old = self._domain_blocks.get(domain, 0)
        self._domain_blocks[domain] = max(0, old // 2)

    # Query-param names that indicate a URL is a PROBE, not a
    # natural internal page. When the previous URL on a host had one
    # of these, it's almost certainly got an injection payload in
    # the value — shipping that as Referer of the next request is
    # (a) a scanner fingerprint and (b) a secondary injection vector
    # into the target's logging/SIEM. We drop the query entirely in
    # that case and use just the origin path.
    _PROBE_PARAM_MARKERS: Set[str] = {
        "q", "query", "search", "id", "uid", "pid", "page", "file",
        "path", "url", "redirect", "return", "returnto", "next",
        "callback", "cb", "jsonp", "cmd", "exec", "action", "debug",
    }

    @staticmethod
    def _url_looks_like_probe(url: str) -> bool:
        """True if the URL's query string contains markers that this
        scanner commonly puts payloads into. Conservative: we'd
        rather strip a legitimate Referer than leak a probe payload."""
        try:
            parsed = urlparse(url)
        except Exception:
            return True
        if not parsed.query:
            return False
        q_lower = parsed.query.lower()
        # Direct payload tells — any of these sitting in the query
        # string of a URL we just fetched means our OWN probe put
        # them there.
        payload_markers = (
            "<script", "onerror=", "javascript:", "' or ", "\" or ",
            "union select", "../", "..%2f", "%00", "${", "{{",
            "..\\", "etc/passwd", "\x00", "<?php", "{$", "file://",
            "gopher://", "dict://", "sleep(", "benchmark(",
        )
        if any(m in q_lower for m in payload_markers):
            return True
        # Also treat "known probe-holding parameters" as probe-ish
        # even when the value looks innocent — that cuts down on the
        # 'Referer: /search?q=<previous>' pattern that's itself a
        # fingerprint.
        for pair in parsed.query.split("&"):
            name = pair.split("=", 1)[0].lower()
            if name in TorSession._PROBE_PARAM_MARKERS:
                return True
        return False

    def _build_referer(self, url: str) -> Optional[str]:
        """Construct an OPSEC-sound Referer value for THIS request.

        Rules:
          * Aux/API hosts (Cloudflare DoH, DDG, crt.sh, certspotter,
            Wayback, etc.) get NO Referer at all — real scripted
            access doesn't carry one.
          * Any URL with a missing/malformed host also gets no Referer.
          * For the FIRST request on a target host: we used to emit
            'https://duckduckgo.com/?q=<target-host>'. That leaks the
            target hostname to the target's OWN access log in an
            extremely bot-shaped pattern (real users don't DDG-search
            for the bare domain they're visiting). Now we emit
            NOTHING on first hit — matching a user who typed the URL
            directly. That's the LEAST identifiable pattern.
          * For the 2nd+ request on the same host we use the last
            successfully-fetched URL on that host — BUT we strip the
            query string and fragment if that previous URL was a
            probe (xss/sqli/lfi/etc. payload in the query). Otherwise
            every follow-up probe to the target would ship the
            PREVIOUS probe's payload as Referer — both a scanner
            fingerprint AND a secondary injection vector into the
            target's logging/SIEM.

        Returns None when no Referer should be sent. Callers
        MUST treat None as 'omit the header entirely', not as
        'Referer: ' or 'Referer: null'.
        """
        host = self._host_key(url)
        if host in self._no_referer_hosts or host == "__unknown__":
            return None
        last = self._last_url_per_host.get(host)
        if last and last != url:
            # Strip query+fragment if it's a probe-looking URL to
            # avoid leaking the previous probe's payload in this
            # request's Referer.
            if self._url_looks_like_probe(last):
                try:
                    p = urlparse(last)
                    scheme = p.scheme or "https"
                    netloc = p.netloc or ""
                    path = p.path or "/"
                    if netloc:
                        return f"{scheme}://{netloc}{path}"
                except Exception:
                    # If we can't even strip it safely, omit
                    # Referer entirely rather than leak.
                    return None
            return last
        # First-on-host: OMIT. Safer than forging a DDG-search
        # referer that contains the target hostname.
        return None

    def _record_referer_src(self, url: str):
        """After a successful fetch record the URL as the next
        'internal' referer for requests to the same host.

        We store the full URL; _build_referer() handles probe-query
        stripping at read time (so if a call later flags the URL as
        probe-ish, we don't have to re-compute at store time)."""
        host = self._host_key(url)
        if host and host not in self._no_referer_hosts:
            self._last_url_per_host[host] = url

    def _apply_sec_fetch(self, headers: Dict[str, str], url: str,
                         referer: Optional[str]):
        """Rewrite Sec-Fetch-* to match the REAL request context.

        Every BROWSER_PROFILE hard-codes:
            Sec-Fetch-Site: none
            Sec-Fetch-Mode: navigate
            Sec-Fetch-Dest: document

        Those are correct for the FIRST navigation to a tab. Real
        browsers set Sec-Fetch-Site dynamically:
          - 'none'        : direct URL-bar typing / bookmark
          - 'same-origin' : click/fetch within same origin
          - 'same-site'   : click between eTLD+1 subdomains
          - 'cross-site'  : click from an unrelated origin

        Shipping 'none' on every subsequent same-host request is a
        clean scanner fingerprint. We now derive the value from the
        Referer we're about to send (or lack thereof).

        Also: for calls that clearly aren't top-level HTML navigations
        (DoH JSON, API JSON, POST form submits) we align
        Sec-Fetch-Dest and Sec-Fetch-Mode accordingly — 'navigate'
        is strictly for clicking a link or typing in the address
        bar, not for XHR/fetch().
        """
        if not headers:
            return
        try:
            req_origin = urlparse(url).netloc.lower()
        except Exception:
            req_origin = ""

        # Sec-Fetch-Site
        if not referer:
            headers["Sec-Fetch-Site"] = "none"
        else:
            try:
                ref_origin = urlparse(referer).netloc.lower()
            except Exception:
                ref_origin = ""
            if ref_origin == req_origin:
                headers["Sec-Fetch-Site"] = "same-origin"
            elif ref_origin and req_origin and \
                    (ref_origin.endswith("." + req_origin) or
                     req_origin.endswith("." + ref_origin)):
                headers["Sec-Fetch-Site"] = "same-site"
            else:
                headers["Sec-Fetch-Site"] = "cross-site"

        # Sec-Fetch-Dest / Sec-Fetch-Mode overrides for sub-resource
        # requests. Callers set this via headers={'_sf_mode': 'xhr'}
        # which we consume and strip. Default stays 'navigate' +
        # 'document' because the vuln probes fetch HTML pages.
        sf_hint = headers.pop("_sf_mode", None)
        if sf_hint == "xhr":
            headers["Sec-Fetch-Mode"] = "cors"
            headers["Sec-Fetch-Dest"] = "empty"
        elif sf_hint == "form":
            headers["Sec-Fetch-Mode"] = "navigate"
            headers["Sec-Fetch-Dest"] = "document"
            headers["Sec-Fetch-User"] = "?1"

    def _salt_tag(self, raw: str) -> str:
        """Return a salted 12-hex-char tag for a domain-ish string,
        for safe inclusion in integrity_log() entries. The salt is
        per-session and only lives in memory, so a disk-only attacker
        (the intended adversary model for the integrity log) can't
        dictionary-attack the tag."""
        return hashlib.sha256(
            (self._log_salt + "|" + (raw or "")).encode()
        ).hexdigest()[:12]

    def _host_key(self, url: str) -> str:
        """Canonical key for the per-host cookie jar + rotation role +
        Referer chain.

        Normalizations applied:
          * Lowercase the netloc (DNS is case-insensitive).
          * Strip the DEFAULT port for the scheme ('target.com:443'
            under https and 'target.com:80' under http become plain
            'target.com'). Without this, 'https://target.com/' and
            'https://target.com:443/' got SEPARATE cookie jars —
            duplicate setups per host and (worse) explicit-port URLs
            were starved of the auth cookies the operator set on the
            implicit-port form.
          * Unknown/invalid URL → sentinel key so jar lookups don't
            collide with the empty string.
        """
        try:
            parsed = urlparse(url)
            netloc = (parsed.netloc or "").lower()
            scheme = (parsed.scheme or "").lower()
        except Exception:
            return "__unknown__"
        if not netloc:
            return "__unknown__"
        if ":" in netloc:
            host, _, port = netloc.rpartition(":")
            if port.isdigit():
                p = int(port)
                if (scheme == "https" and p == 443) or \
                        (scheme == "http" and p == 80):
                    netloc = host
        return netloc

    def _get_host_jar(self, url: str) -> "requests.cookies.RequestsCookieJar":
        """Return (creating if needed) the per-host cookie jar for
        the given URL. Never falls back to a shared jar."""
        key = self._host_key(url)
        jar = self._host_cookies.get(key)
        if jar is None:
            jar = requests.cookies.RequestsCookieJar()
            self._host_cookies[key] = jar
        return jar

    def _swap_in_jar(self, url: str):
        """Install the per-host jar as session.cookies for the
        duration of ONE request. requests.Session updates this jar
        in place from Set-Cookie headers, so we install the host's
        jar, make the call, and the target's cookies are persisted
        back to the right bucket — never bled to other hosts."""
        key = self._host_key(url)
        jar = self._get_host_jar(url)
        self._session.cookies = jar
        return key

    def _profile_for(self, url: str) -> dict:
        """Return the pinned browser profile for the given URL's host
        under the current Tor circuit. If this is the first time we
        see (host, circuit) together, pick a profile, cache it, and
        return a fresh copy. Subsequent calls return a fresh copy of
        the SAME profile — consistent UA / Accept-* / Sec-Ch-Ua* /
        platform throughout the session on a given circuit.

        Why the circuit generation is part of the key:
          When newnym() fires, requests look like they come from a
          new IP. A real browser on a newly-popped Tor-Browser
          session would also have a freshly-randomized fingerprint
          — so we redraw the profile. That's both more realistic
          AND prevents long-term correlation of 'same UA across
          two wildly different exit nodes' which is a light
          fingerprint in its own right.
        """
        host = self._host_key(url)
        key = (host, self._circuit_generation)
        cached = self._profile_cache.get(key)
        if cached is None:
            cached = BROWSER_PROFILES[
                secrets.randbelow(len(BROWSER_PROFILES))]
            self._profile_cache[key] = cached
        # Return a copy so callers can mutate headers without
        # corrupting the cached master profile.
        return cached.copy()

    @staticmethod
    def _cookie_matches_host(cookie_domain: str, host: str) -> bool:
        """RFC-6265-ish match: a cookie with domain 'example.com' is
        valid for 'example.com' and 'sub.example.com'. A cookie with
        domain 'sub.example.com' is NOT valid for 'example.com'."""
        if not cookie_domain:
            # Host-only cookie (no Domain attribute sent) — requests
            # still stores a synthetic domain equal to the request
            # host. If cookie_domain is empty we err on the side of
            # 'keeps belonging to the jar' (the request host was this
            # jar's host, so it stays).
            return True
        cookie_domain = cookie_domain.lstrip(".").lower()
        host = (host or "").lower()
        if not host:
            return False
        return host == cookie_domain or host.endswith("." + cookie_domain)

    def _quarantine_foreign_cookies(self, origin_host: str):
        """Walk the jar we installed for `origin_host` and move any
        cookie whose Domain attribute doesn't match origin_host into
        the correct per-host jar.

        This is the redirect-leak remediation. When requests follows
        a cross-host redirect it applies Set-Cookie headers to the
        active session jar — which for us is origin_host's jar. So
        if https://target.com/login -> https://sso.example.net/auth,
        the SSO's Set-Cookie lands in target.com's jar. We detect
        that (cookie.domain says sso.example.net, jar is
        target.com's) and relocate it.

        This DOES NOT undo the fact that cookies for origin_host
        were already sent on the subsequent hops (that's a
        fundamental limitation of requests' follow-redirect path
        with allow_redirects=True). But it prevents future requests
        to origin_host from also shipping the foreign SSO cookie to
        the target.
        """
        jar = self._host_cookies.get(origin_host)
        if jar is None:
            return
        foreign = []
        for cookie in list(jar):
            cookie_dom = (cookie.domain or "").lstrip(".").lower()
            if cookie_dom and not self._cookie_matches_host(cookie_dom,
                                                             origin_host):
                foreign.append(cookie)
        if not foreign:
            return
        for cookie in foreign:
            # Relocate to the jar whose host MATCHES the cookie's
            # declared domain.
            dest_host = (cookie.domain or "").lstrip(".").lower()
            dest = self._host_cookies.setdefault(
                dest_host, requests.cookies.RequestsCookieJar())
            try:
                dest.set_cookie(cookie)
            except Exception:
                pass
            try:
                # requests.cookies.remove_cookie_by_name honors
                # path/domain; fall back to clearing the attribute.
                requests.cookies.remove_cookie_by_name(
                    jar, cookie.name,
                    domain=cookie.domain,
                    path=cookie.path,
                )
            except Exception:
                pass
        if foreign:
            integrity_log(
                "intel",
                f"quarantined_foreign_cookies:origin={origin_host}:"
                f"count={len(foreign)}",
            )

    def set_cookies(self, cookies: dict, host: Optional[str] = None):
        """Set session cookies for authenticated scanning, scoped to a
        SPECIFIC host.

        Back-compat: historical callers (including the CLI entry
        point and any scripts wrapping the scanner) pass a dict with
        no `host` argument. Previously this wrote to a shared jar —
        which bled those cookies across crt.sh / DoH / DDG / Wayback
        every time the scanner made an aux call. We fixed the sharing
        but MUST NOT break the old call shape: those callers know
        the target, they just didn't think to pass it.

        Resolution ladder:
          1. If the caller passes host=, use it.
          2. Else, if we've ever set auth cookies on a host before,
             reuse THAT host (explicit_auth_host), same as the old
             shared-jar behaviour would have implied.
          3. Else, stash the cookies in a *pending* slot keyed to a
             sentinel host; the first orch.run_domain()/run_email()
             call will reify them via rebind_pending_auth(). This
             way set_cookies({'sid': '...'}) BEFORE knowing the
             target still works (CLI ordering).
        """
        if host:
            target_host = host.lower()
            self._explicit_auth_host = target_host
            jar = self._host_cookies.setdefault(
                target_host, requests.cookies.RequestsCookieJar())
            for k, v in (cookies or {}).items():
                jar.set(k, v)
            return

        if self._explicit_auth_host:
            jar = self._host_cookies.setdefault(
                self._explicit_auth_host,
                requests.cookies.RequestsCookieJar())
            for k, v in (cookies or {}).items():
                jar.set(k, v)
            return

        # Pending — will be rebound as soon as we know the target.
        # We do NOT write to any host jar yet, so there's zero risk
        # the cookies ship to an aux service before rebinding.
        if not hasattr(self, "_pending_auth_cookies"):
            self._pending_auth_cookies: Dict[str, str] = {}
        for k, v in (cookies or {}).items():
            self._pending_auth_cookies[k] = v
        integrity_log(
            "intel",
            f"set_cookies_pending:count={len(cookies or {})}:"
            "awaiting_target_bind",
        )

    def rebind_pending_auth(self, host: str) -> int:
        """Bind any pending auth cookies (set_cookies called before a
        target was known) to the given host. Returns count bound.
        Safe to call even when there's nothing pending."""
        if not host:
            return 0
        pending = getattr(self, "_pending_auth_cookies", None)
        if not pending:
            return 0
        target_host = host.lower()
        self._explicit_auth_host = target_host
        jar = self._host_cookies.setdefault(
            target_host, requests.cookies.RequestsCookieJar())
        n = 0
        for k, v in pending.items():
            jar.set(k, v)
            n += 1
        self._pending_auth_cookies = {}
        return n

    def clear_host_cookies(self, host: Optional[str] = None) -> int:
        """Drop the cookie jar for a host (or every host, if host=None).
        Useful between target switches in a multi-target scan so the
        next target doesn't inherit stale sessions from the previous
        one. Returns count of jars cleared."""
        if host is None:
            n = len(self._host_cookies)
            self._host_cookies.clear()
            self._last_url_per_host.clear()
            self._explicit_auth_host = None
            return n
        key = host.lower()
        if key in self._host_cookies:
            del self._host_cookies[key]
            self._last_url_per_host.pop(key, None)
            if self._explicit_auth_host == key:
                self._explicit_auth_host = None
            return 1
        return 0

    def get(self, url: str, allow_wayback: bool = True, method: str = "GET",
            **kwargs) -> Optional[requests.Response]:
        """GET/HEAD with retry-on-block, circuit rotation, and Wayback fallback.

        Key reliability features:
        - Hard per-request timeout (REQUEST_TIMEOUT seconds, not 25)
        - Domain-level circuit breaker: after BLOCK_THRESHOLD blocks, skip
        - Only 2 retries on block (was 3 — saves 30+ seconds on stubborn sites)
        - Returns None (not hangs) on every failure path
        """
        if shutdown_requested():
            return None

        domain = urlparse(url).netloc
        self._total_requests += 1

        # Circuit breaker: if this domain has blocked us too many times, don't waste time
        if self.is_domain_blocked(domain):
            return None

        kwargs.setdefault("timeout", REQUEST_TIMEOUT)

        for attempt in range(MAX_RETRIES_PER_URL):
            self._delay_for_domain(domain)
            self._maybe_rotate_circuit(url)

            headers = self._profile_for(url)
            ref = self._build_referer(url)
            if ref:
                headers["Referer"] = ref
            extra_headers = kwargs.get("headers", {})
            if extra_headers:
                headers.update(extra_headers)
            # Sec-Fetch-* correction AFTER caller overrides — the
            # profile default 'none' is only correct for the first
            # top-level nav. See _apply_sec_fetch docstring.
            self._apply_sec_fetch(headers, url, ref)
            req_kwargs = {k: v for k, v in kwargs.items() if k != "headers"}

            # Isolate cookies: only this host's jar is visible for the
            # duration of the call. See _swap_in_jar docstring.
            origin_host = self._swap_in_jar(url)
            try:
                self._domain_last[domain] = time.time()
                if method.upper() == "HEAD":
                    resp = self._session.head(url, headers=headers, allow_redirects=True, **req_kwargs)
                else:
                    resp = self._session.get(url, headers=headers, **req_kwargs)

                # Redirect-leak remediation: if requests followed a
                # cross-host redirect, cookies from the destination
                # landed in origin_host's jar. Walk the jar and move
                # any cookie whose Domain doesn't match origin_host.
                self._quarantine_foreign_cookies(origin_host)

                if resp.status_code in (200, 301, 302, 304):
                    self._domain_blocks[domain] = max(0, self._domain_blocks[domain] - 1)
                    self._record_referer_src(url)
                    return resp

                if resp.status_code in (403, 429, 503):
                    self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                    self._total_blocks += 1
                    if self.is_domain_blocked(domain):
                        integrity_log("intel",
                                      f"domain_circuit_breaker:host_tag={self._salt_tag(domain)}")
                        return None
                    newnym()
                    time.sleep(2 + secrets.randbelow(3000) / 1000.0)
                    continue

                # 4xx/5xx: return as-is (may contain useful error info for vuln checks)
                # but don't count as blocks. 404 is expected for path probes.
                if resp.status_code == 404:
                    return resp
                # Server errors: rotate circuit and retry on 502 (proxy error)
                if resp.status_code == 502 and attempt < MAX_RETRIES_PER_URL - 1:
                    newnym()
                    time.sleep(1 + secrets.randbelow(2000) / 1000.0)
                    continue
                return resp

            except requests.exceptions.Timeout:
                self._total_timeouts += 1
                integrity_log("intel",
                              f"timeout:host_tag={self._salt_tag(domain)}:attempt={attempt}")
                if attempt < MAX_RETRIES_PER_URL - 1:
                    newnym()
                    time.sleep(1 + secrets.randbelow(2000) / 1000.0)
                    continue
                return None
            except requests.exceptions.ConnectionError:
                self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                integrity_log("intel",
                              f"conn_error:host_tag={self._salt_tag(domain)}")
                # Don't return immediately — fall through to Wayback on last attempt
                if attempt < MAX_RETRIES_PER_URL - 1:
                    newnym()
                    time.sleep(1 + secrets.randbelow(2000) / 1000.0)
                    continue
                break

        # All retries exhausted — try Wayback Machine
        if allow_wayback and WAYBACK_ENABLED and method.upper() == "GET":
            return self._wayback_fetch(url)
        return None

    def request(self, method: str, url: str,
                allow_redirects: bool = True,
                extra_headers: Optional[Dict[str, str]] = None,
                **kwargs) -> Optional[requests.Response]:
        """Generic HTTP request that honors block tracking + rotation.

        The scanner used to do `self._session._session.request(...)` in
        a dozen places to get verbs other than GET/HEAD/POST-form, which
        bypassed BLOCK_THRESHOLD, the per-domain delay, circuit
        rotation, and timeout-retry. That meant a 429-ing target could
        soak up every verb-tampering / host-header probe and never trip
        the circuit breaker. Now everyone goes through this.
        """
        if shutdown_requested():
            return None
        domain = urlparse(url).netloc
        if self.is_domain_blocked(domain):
            return None
        self._total_requests += 1
        kwargs.setdefault("timeout", REQUEST_TIMEOUT)
        m_up = method.upper()

        for attempt in range(MAX_RETRIES_PER_URL):
            self._delay_for_domain(domain)
            self._maybe_rotate_circuit(url)
            headers = self._profile_for(url)
            ref = self._build_referer(url)
            if ref:
                headers["Referer"] = ref
            if extra_headers:
                headers.update(extra_headers)
            self._apply_sec_fetch(headers, url, ref)
            origin_host = self._swap_in_jar(url)
            try:
                self._domain_last[domain] = time.time()
                resp = self._session.request(
                    m_up, url,
                    allow_redirects=allow_redirects,
                    headers=headers,
                    **kwargs,
                )
            except requests.exceptions.Timeout:
                self._total_timeouts += 1
                if attempt < MAX_RETRIES_PER_URL - 1:
                    newnym()
                    time.sleep(1 + secrets.randbelow(2000) / 1000.0)
                    continue
                return None
            except requests.exceptions.ConnectionError:
                self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                if attempt < MAX_RETRIES_PER_URL - 1:
                    newnym()
                    time.sleep(1 + secrets.randbelow(2000) / 1000.0)
                    continue
                return None
            except Exception:
                return None

            self._quarantine_foreign_cookies(origin_host)

            if resp.status_code in (403, 429, 503):
                self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                self._total_blocks += 1
                if self.is_domain_blocked(domain):
                    integrity_log("intel",
                                  f"domain_circuit_breaker:host_tag={self._salt_tag(domain)}")
                    return resp  # still return so caller can inspect
                # Don't retry every verb — checks like verb tampering
                # expect 4xx; only rotate circuit + return.
                return resp
            if 200 <= resp.status_code < 400:
                self._record_referer_src(url)
            return resp
        return None

    def get_stats(self) -> dict:
        """Return session statistics for reporting."""
        return {
            "total_requests": self._total_requests,
            "total_blocks": self._total_blocks,
            "total_timeouts": self._total_timeouts,
            "domains_blocked": sum(1 for v in self._domain_blocks.values() if v >= BLOCK_THRESHOLD),
        }

    def _wayback_fetch(self, url: str) -> Optional[requests.Response]:
        """Fetch cached page from Wayback Machine. web.archive.org is Tor-friendly."""
        wb_url = f"https://web.archive.org/web/2/{url}"
        try:
            # Profile keyed to the actual URL we're about to hit
            # (Wayback), not the original target — pinning to the
            # target would leak a correlation between target scans
            # and Wayback fallbacks (same UA on both).
            headers = self._profile_for(wb_url)
            # Wayback's own cookies (ia-id, donation banners, etc.) live
            # in their own jar — never co-mingled with the target's.
            origin_host = self._swap_in_jar(wb_url)
            resp = self._session.get(wb_url, headers=headers, timeout=20)
            self._quarantine_foreign_cookies(origin_host)
            _origin_tag = self._salt_tag(urlparse(url).netloc)
            if resp.status_code == 200:
                integrity_log("intel", f"wayback_ok:host_tag={_origin_tag}")
                return resp
            integrity_log("intel",
                          f"wayback_fail:host_tag={_origin_tag}:status={resp.status_code}")
        except requests.exceptions.Timeout:
            integrity_log("intel",
                          f"wayback_timeout:host_tag={self._salt_tag(urlparse(url).netloc)}")
        except requests.exceptions.ConnectionError:
            integrity_log("intel",
                          f"wayback_conn_error:host_tag={self._salt_tag(urlparse(url).netloc)}")
        except Exception as e:
            integrity_log("intel",
                          f"wayback_error:host_tag={self._salt_tag(urlparse(url).netloc)}:{type(e).__name__}")
        return None

    def post_json(self, url: str, json_data: dict, **kwargs) -> Optional[requests.Response]:
        """POST JSON request (for APIs like crt.sh)."""
        if shutdown_requested():
            return None
        domain = urlparse(url).netloc
        if self.is_domain_blocked(domain):
            return None
        self._delay_for_domain(domain)
        self._maybe_rotate_circuit(url)
        headers = self._profile_for(url)
        headers["Content-Type"] = "application/json"
        ref = self._build_referer(url)
        if ref:
            headers["Referer"] = ref
        # POST JSON is XHR, not a top-level navigation.
        headers["_sf_mode"] = "xhr"
        self._apply_sec_fetch(headers, url, ref)
        kwargs.setdefault("timeout", REQUEST_TIMEOUT)
        self._total_requests += 1
        origin_host = self._swap_in_jar(url)
        try:
            self._domain_last[domain] = time.time()
            resp = self._session.post(url, json=json_data, headers=headers, **kwargs)
            self._quarantine_foreign_cookies(origin_host)
            if resp.status_code in (403, 429, 503):
                self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                self._total_blocks += 1
            elif 200 <= resp.status_code < 400:
                self._record_referer_src(url)
            return resp
        except (requests.exceptions.Timeout, requests.exceptions.ConnectionError):
            self._total_timeouts += 1
            return None

    def post_form(self, url: str, form_data: dict, **kwargs) -> Optional[requests.Response]:
        """POST form-encoded data (for testing HTML forms)."""
        if shutdown_requested():
            return None
        domain = urlparse(url).netloc
        if self.is_domain_blocked(domain):
            return None
        self._delay_for_domain(domain)
        self._maybe_rotate_circuit(url)
        headers = self._profile_for(url)
        headers["Content-Type"] = "application/x-www-form-urlencoded"
        ref = self._build_referer(url)
        if ref:
            headers["Referer"] = ref
        # HTML form submit: same-user-gesture navigation.
        headers["_sf_mode"] = "form"
        self._apply_sec_fetch(headers, url, ref)
        kwargs.setdefault("timeout", REQUEST_TIMEOUT)
        self._total_requests += 1
        origin_host = self._swap_in_jar(url)
        try:
            self._domain_last[domain] = time.time()
            resp = self._session.post(url, data=form_data, headers=headers, **kwargs)
            self._quarantine_foreign_cookies(origin_host)
            if resp.status_code in (403, 429, 503):
                self._domain_blocks[domain] = self._domain_blocks.get(domain, 0) + 1
                self._total_blocks += 1
            elif 200 <= resp.status_code < 400:
                self._record_referer_src(url)
            return resp
        except (requests.exceptions.Timeout, requests.exceptions.ConnectionError):
            self._total_timeouts += 1
            return None

    def close(self):
        self._session.close()


