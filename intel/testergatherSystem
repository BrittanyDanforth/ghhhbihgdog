#  Honeypot Detection
# ══════════════════════════════════════════════════════════════════════════

class HoneypotDetector:
    TRAP_PATTERNS = [
        re.compile(r"(?:honeypot|bot.?trap|bot.?check)", re.I),
        re.compile(r"please\s+verify\s+you\s+are\s+human", re.I),
        re.compile(r"unusual\s+activity\s+detected", re.I),
        re.compile(r"access\s+denied.*cloudflare", re.I),
    ]
    SUSPICIOUS_HEADERS = {"x-honeypot", "x-trap", "x-security-scan", "cf-mitigated"}

    @classmethod
    def check(cls, content: str, headers: dict, elapsed_ms: float, redirects: int) -> dict:
        score = 0.0
        reasons = []
        for pat in cls.TRAP_PATTERNS:
            if pat.search(content[:5000]):
                score += 0.25
                reasons.append(f"pattern:{pat.pattern[:30]}")
        for h in cls.SUSPICIOUS_HEADERS:
            if h in {k.lower() for k in headers}:
                score += 0.2
                reasons.append(f"header:{h}")
        if elapsed_ms < 30:
            score += 0.15
            reasons.append("too_fast")
        if redirects > 4:
            score += 0.2
            reasons.append(f"redirects:{redirects}")
        if len(content) < 500 and re.search(r"blocked|denied|forbidden", content, re.I):
            score += 0.3
            reasons.append("block_page")
        return {"is_honeypot": score >= 0.5, "confidence": min(score, 1.0), "reasons": reasons}


