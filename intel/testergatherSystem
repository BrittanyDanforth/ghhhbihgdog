class IntelScraper:
    """Scrape web pages for OSINT data with anti-blocking measures."""

    def __init__(self, session: TorSession):
        self._session = session
        self._extractor = DataExtractor()
        self._honeypot = HoneypotDetector()

    def scrape_url(self, url: str) -> Optional[dict]:
        """Scrape a single URL with full pipeline: fetch → detect → extract."""
        t0 = time.time()
        resp = self._session.get(url)
        elapsed_ms = (time.time() - t0) * 1000

        if resp is None:
            return None

        content = resp.text
        headers = dict(resp.headers)

        # Honeypot check
        hp = self._honeypot.check(
            content, headers, elapsed_ms, len(resp.history)
        )
        if hp["is_honeypot"]:
            integrity_log("intel", f"honeypot_detected:{urlparse(url).netloc}")
            return {"url": url, "honeypot": True, "hp_reasons": hp["reasons"]}

        # Parse HTML
        text = content
        if HAS_BS4:
            try:
                soup = BeautifulSoup(content, "html.parser")
                # Remove script/style tags
                for tag in soup(["script", "style", "noscript"]):
                    tag.decompose()
                text = soup.get_text(separator=" ", strip=True)
                # Also get page title and meta description
                title = soup.title.string.strip() if soup.title and soup.title.string else ""
                meta_desc = ""
                meta_tag = soup.find("meta", attrs={"name": "description"})
                if meta_tag:
                    meta_desc = meta_tag.get("content", "")
            except Exception:
                title = ""
                meta_desc = ""
        else:
            title = ""
            meta_desc = ""

        # Extract data patterns
        extracted = self._extractor.extract_all(text)

        _coarsened = int(time.time()) // 600 * 600
        return {
            "url": url,
            "title": title[:200],
            "description": meta_desc[:500],
            "extracted": extracted,
            "content_length": len(content),
            "timestamp": _coarsened,
            "honeypot": False,
        }

    def scrape_search_results(self, query: str, max_results: int = 20) -> List[dict]:
        """Search via DuckDuckGo HTML (no API key needed, Tor-friendly).

        DuckDuckGo's HTML endpoint doesn't block Tor and doesn't require
        JavaScript. Google aggressively blocks automated queries and Tor
        exit nodes — DDG is the only reliable option for Tor-based search.
        """
        results = []
        encoded_q = quote(query)

        # DuckDuckGo HTML search
        url = f"https://html.duckduckgo.com/html/?q={encoded_q}"
        resp = self._session.get(url)
        if resp is None:
            return results

        if not HAS_BS4:
            integrity_log("intel", "bs4_missing:cannot_parse_search")
            return results

        try:
            soup = BeautifulSoup(resp.text, "html.parser")
            links = soup.find_all("a", class_="result__a")
            for link in links[:max_results]:
                href = link.get("href", "")
                title = link.get_text(strip=True)
                if href and href.startswith("http"):
                    results.append({"url": href, "title": title, "source": "ddg"})
        except Exception as e:
            integrity_log("intel", f"search_parse_error:{str(e)[:40]}")

        return results


