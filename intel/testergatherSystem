    def _check_csrf(self, html: str) -> List[dict]:
        """Check if forms lack CSRF protection."""
        findings = []
        if not HAS_BS4 or not html:
            return findings
        try:
            soup = BeautifulSoup(html[:100000], "html.parser")
            csrf_names = {"csrf", "token", "_token", "csrfmiddlewaretoken",
                          "csrf_token", "authenticity_token", "__requestverificationtoken",
                          "nonce", "_csrf", "xsrf"}
            for form in soup.find_all("form"):
                method = (form.get("method", "GET")).upper()
                if method != "POST":
                    continue
                action = form.get("action", "")
                inputs = {inp.get("name", "").lower() for inp in form.find_all("input")}
                has_csrf = bool(inputs & csrf_names)
                if not has_csrf:
                    form_desc = action[:40] if action else "(same page)"
                    findings.append({
                        "severity": SEV_MEDIUM,
                        "title": f"POST form without CSRF token: {form_desc}",
                        "detail": "Form submits via POST without an anti-CSRF token. "
                                  "Attacker can craft a page that auto-submits this form "
                                  "when the victim visits it.",
                        "evidence": f"POST form action={form_desc}, no CSRF token field found",
                        "exploitable": True,
                        "exploit_info": {
                            "type": "csrf",
                            "method": "Create attacker page with hidden form that auto-submits "
                                      "to the target action. Victim's session cookies are sent "
                                      "automatically by the browser.",
                            "risk": "Unauthorized actions, account modification, fund transfers",
                        },
                    })
                    if len(findings) >= 3:
                        break
        except Exception:
            pass
        return findings

    def _check_idor(self, base_url: str, html: str) -> List[dict]:
        """Check for Insecure Direct Object Reference indicators."""
        findings = []
        domain = urlparse(base_url).netloc
        if self._session.is_domain_blocked(domain):
            return findings

        # Look for sequential numeric IDs in URLs
        id_params = re.findall(r'[?&]((?:id|user_id|uid|account|order|item|doc|file_id|record)'
                               r')=(\d+)', html[:100000], re.I)
        if not id_params:
            return findings

        # Test: can we access id+1 and id-1? If responses differ meaningfully
        # and both return 200, IDOR is likely
        tested = set()
        for param_name, param_val in id_params[:3]:
            key = f"{param_name}:{param_val}"
            if key in tested:
                continue
            tested.add(key)
            try:
                val = int(param_val)
            except ValueError:
                continue

            # Fetch original
            orig_url = f"{base_url}?{param_name}={val}"
            orig_resp = self._session.get(orig_url, allow_wayback=False)
            if not orig_resp or orig_resp.status_code != 200:
                continue

            # Fetch id+1
            next_url = f"{base_url}?{param_name}={val + 1}"
            next_resp = self._session.get(next_url, allow_wayback=False)
            if next_resp and next_resp.status_code == 200 and next_resp.text:
                diff = self._response_diff(orig_resp.text, next_resp.text)
                if not diff["similar"] and diff["score"] > 0.3:
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"Possible IDOR via '{param_name}' parameter",
                        "detail": f"Sequential IDs ({val}, {val+1}) return different content. "
                                  "Access control may not be enforced — test with different sessions.",
                        "evidence": f"param: {param_name}, id={val} and id={val+1} both return 200 "
                                    f"with different content (similarity={diff['score']})",
                        "exploitable": True,
                        "exploit_info": {
                            "type": "idor",
                            "parameter": param_name,
                            "method": f"Enumerate '{param_name}' values (1, 2, 3...) to access "
                                      "other users' data. Test with unauthenticated session.",
                            "risk": "Unauthorized data access, privacy violation, data theft",
                        },
                    })
                    break
        return findings

    def _check_sensitive_paths(self, base_url: str) -> List[dict]:
        """Probe for exposed sensitive files and directories.

        Uses domain circuit breaker — if the site is actively blocking us,
        stops probing after BLOCK_THRESHOLD failures instead of trying all 26 paths.

        Soft-404 detection: many sites return HTTP 200 for nonexistent paths
        with a generic "not found" page. We first fetch a known-nonexistent path
        to get the baseline 404 page length, then compare against it.
        """
        findings = []
        domain = urlparse(base_url).netloc
        total = len(self.SENSITIVE_PATHS)
        skipped = 0

        # Soft-404 baseline: fetch a random path that definitely doesn't exist
        _baseline_url = urljoin(base_url, f"/gs_nonexistent_{secrets.token_hex(4)}")
        _baseline_resp = self._session.get(_baseline_url, allow_wayback=False, method="GET")
        _soft404_length = len(_baseline_resp.text) if _baseline_resp and _baseline_resp.status_code == 200 else -1
        _soft404_patterns = re.compile(
            r"not\s*found|404|page\s*(does\s*not|doesn.t)\s*exist|no\s*such\s*page|"
            r"this\s*page\s*could\s*not|we\s*couldn.t\s*find|error\s*404",
            re.I
        )

        for idx, (path, title, severity, detail) in enumerate(self.SENSITIVE_PATHS):
            if shutdown_requested():
                break
            if self._session.is_domain_blocked(domain):
                skipped = total - idx
                break

            url = urljoin(base_url, path)
            resp = self._session.get(url, allow_wayback=False, method="HEAD")
            if resp and resp.status_code == 200:
                if severity in (SEV_CRITICAL, SEV_HIGH):
                    resp_full = self._session.get(url, allow_wayback=False)
                    if resp_full and resp_full.status_code == 200 and len(resp_full.text) > 10:
                        body = resp_full.text
                        # Soft-404 check: skip if body matches baseline or has 404 patterns
                        if _soft404_length > 0 and abs(len(body) - _soft404_length) < 100:
                            continue
                        if _soft404_patterns.search(body[:1000]):
                            continue
                        # For git/env, verify content looks real
                        if path == "/.git/HEAD" and "ref:" not in body[:100]:
                            continue
                        if path == "/.env" and "=" not in body[:500]:
                            continue
                        findings.append({"severity": severity, "title": title,
                                         "detail": detail, "evidence": f"HTTP 200 at {path}",
                                         "path": path, "content_length": len(body)})
                else:
                    # For INFO/LOW/MEDIUM: check for soft-404 to avoid false positives
                    # on sites that return 200 with generic pages for every path
                    if severity in (SEV_INFO, SEV_LOW, SEV_MEDIUM) and _soft404_length > 0:
                        resp_check = self._session.get(url, allow_wayback=False)
                        if resp_check:
                            if abs(len(resp_check.text) - _soft404_length) < 100:
                                continue
                            if _soft404_patterns.search(resp_check.text[:1000]):
                                continue
                    findings.append({"severity": severity, "title": title,
                                     "detail": detail, "evidence": f"HTTP 200 at {path}",
                                     "path": path})

        if skipped:
            print(f"        (skipped {skipped} paths — site is blocking probes)")
        return findings

    def _check_http_methods(self, base_url: str) -> List[dict]:
        """Check for dangerous HTTP methods enabled."""
        findings = []
        domain = urlparse(base_url).netloc
        if self._session.is_domain_blocked(domain):
            return findings

        try:
            self._session._delay_for_domain(domain)
            self._session._maybe_rotate_circuit()
            opt_resp = self._session._session.options(base_url, timeout=REQUEST_TIMEOUT,
                                                       proxies=self._session._proxy,
