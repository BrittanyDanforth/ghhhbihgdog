# ========== DATA EXTRACTOR ==========
class DataExtractor:
    """Advanced pattern extraction with validation"""
    
    def __init__(self):
        self.patterns = {
            'EMAIL': r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b',
            'PHONE': r'[\+]?[(]?[0-9]{1,3}[)]?[-\s\.]?[(]?[0-9]{1,3}[)]?[-\s\.]?[0-9]{3,4}[-\s\.]?[0-9]{3,4}',
            'BTC_ADDRESS': r'\b(bc1|[13])[a-zA-HJ-NP-Z0-9]{25,62}\b',
            'ETH_ADDRESS': r'\b0x[a-fA-F0-9]{40}\b',
            'SEED_PHRASE': r'\b(?:seed|phrase|mnemonic|recovery|backup)\s*[:=]?\s*([a-z\s]{20,})\b',
            'PRIVATE_KEY': r'\b(?:0x)?[a-fA-F0-9]{64}\b',
            'API_KEY': r'\b[A-Za-z0-9\-_]{32,}\b',
            'NAME': r'\b([A-Z][a-z]+)\s+([A-Z][a-z]+)\b',
            'COMPLAINT': r'(?:locked|frozen|stuck|missing|lost|hacked|scammed|stolen)',
            'TRANSACTION_HASH': r'\b0x[a-fA-F0-9]{64}\b',
            'EXCHANGE_ACCOUNT': r'\b[A-Za-z0-9._%+-]+@(?:coinbase|binance|kraken)\.com\b'
        }
        
    def extract_all(self, text):
        """Extract all patterns with validation"""
        if not text:
            return {}
            
        results = {}
        
        for pattern_name, pattern in self.patterns.items():
            try:
                matches = re.findall(pattern, text, re.IGNORECASE | re.MULTILINE)
                
                if matches:
                    # Clean and validate
                    validated = []
                    
                    for match in matches:
                        if pattern_name == 'NAME' and isinstance(match, tuple):
                            match = ' '.join(match)
                            
                        if self._validate_match(pattern_name, match):
                            validated.append(match)
                            
                    if validated:
                        results[pattern_name] = list(set(validated))[:10]  # Limit and dedupe
                        
            except Exception as e:
                logger.error(f"Extraction error for {pattern_name}: {e}")
                
        return results
        
    def _validate_match(self, pattern_type, match):
        """Validate extracted match"""
        if pattern_type == 'EMAIL':
            return '@' in match and '.' in match.split('@')[1]
            
        elif pattern_type == 'BTC_ADDRESS':
            # Basic length check
            return 26 <= len(match) <= 62
            
        elif pattern_type == 'ETH_ADDRESS':
            # Check format
            return len(match) == 42 and match.startswith('0x')
            
        elif pattern_type == 'PHONE':
            # Remove non-digits and check length
            digits = re.sub(r'\D', '', match)
            return 7 <= len(digits) <= 15
            
        elif pattern_type == 'SEED_PHRASE':
            # Check word count
            words = match.split()
            return len(words) in [12, 15, 18, 21, 24]
            
        return True

