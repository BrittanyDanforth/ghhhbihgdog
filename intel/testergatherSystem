            self._print_dns(dns_records)
            if dns_records:
                self._results.append({"type": "dns", "domain": domain, "records": dns_records})

        # Phase 5: Subdomain enumeration (deep only)
        if self._scan_depth == "deep":
            print(f"\n  [*] Phase 5: Subdomain enumeration (crt.sh)...")
            subs = self._subdomains.enumerate(domain)
            if subs:
                print(f"  [+] Found {len(subs)} subdomains")
                for s in subs[:20]:
                    print(f"      {s}")
                if len(subs) > 20:
                    print(f"      ... and {len(subs) - 20} more")
                self._results.append({"type": "subdomains", "domain": domain,
                                      "subdomains": subs, "count": len(subs)})

                # Check for subdomain takeover on subdomains that have CNAME records
                print(f"\n  [*] Phase 5b: Checking subdomains for takeover...")
                for sub in subs[:10]:
                    if shutdown_requested():
                        break
                    sub_dns = self._dns.lookup(sub)
                    cnames = sub_dns.get("CNAME", [])
                    if cnames:
                        takeover = self._vulns._check_subdomain_takeover(sub, cnames)
                        if takeover:
                            self._vuln_findings.extend(takeover)
                            for t in takeover:
                                print(f"  [!] TAKEOVER: {t['title']}")

        # Phase 6: Search for additional intel
        print(f"\n  [*] Phase 6: Search engine OSINT...")
        dork_queries = [f'site:{domain}', f'"{domain}" filetype:pdf']
        for dq in dork_queries[:2]:
            if shutdown_requested():
                break
            self._run_search(dq, max_results=10)

    def run_email(self, email: str):
        """Breach database check for email."""
        print(f"  [*] Checking: {email[:3]}***@***")
        hibp = self._breach.check_hibp(email)
        if hibp:
            if hibp.get("breached"):
                print(f"  [!] HIBP: BREACHED ({hibp.get('breach_count', '?')} breaches)")
                for n in hibp.get("breach_names", [])[:5]:
                    print(f"      - {n}")
            elif hibp.get("status") == "error":
                print(f"  [!] HIBP: check failed")
            else:
                print(f"  [+] HIBP: not found")
            self._results.append({"type": "breach_check", "data": hibp})
        dehashed = self._breach.check_dehashed(email)
        if dehashed:
            if dehashed.get("breached"):
                print(f"  [!] Dehashed: BREACHED ({dehashed.get('entry_count', '?')} entries)")
            self._results.append({"type": "breach_check", "data": dehashed})
        if not hibp and not dehashed:
            print(f"  [*] No breach DB API keys configured (set HIBP_KEY / DEHASHED_KEY)")

    def run_query(self, query: str, max_pages: int = 20):
        """Search + scrape pipeline."""
        print(f"  [*] Searching: {query[:50]}...")
        self._run_search(query, max_pages)

    def _run_search(self, query: str, max_results: int = 20):
        search_results = self._scraper.search_ddg(query, max_results)
        print(f"  [+] {len(search_results)} results")
        for i, sr in enumerate(search_results):
            if shutdown_requested():
                break
            url = sr["url"]
            print(f"  [*] [{i+1}/{len(search_results)}] {urlparse(url).netloc}...")
            result = self._scraper.scrape_url(url)
            if result:
                self._results.append(result)
                ex = result.get("extracted", {})
                if ex:
                    for etype, evals in ex.items():
                        print(f"      {etype}: {len(evals)}")

    def run_file(self, filepath: Path):
        """Process targets from file."""
        if not filepath.exists():
            print(f"  [!] File not found")
            return
        lines = filepath.read_text().strip().splitlines()
        print(f"  [*] {len(lines)} targets from file")
        for i, line in enumerate(lines):
            if shutdown_requested():
                break
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            print(f"\n  ── Target {i+1}/{len(lines)} ──")
            if "@" in line and "." in line:
                self.run_email(line)
            elif "." in line and " " not in line:
                self.run_domain(line)
            else:
                self.run_query(line, 10)

    def _print_extraction(self, result: dict):
        ex = result.get("extracted", {})
        if ex:
            print(f"  [+] Data extracted:")
            for etype, evals in ex.items():
                print(f"      {etype}: {len(evals)} found")
        sc = result.get("secrets_in_comments", {})
        if sc:
            print(f"  [!] Secrets found in HTML comments:")
            for stype, svals in sc.items():
                print(f"      {stype}: {len(svals)}")

    def _print_tech(self, tech: dict):
        if tech.get("server"):
            print(f"  [+] Server: {tech['server']}")
        if tech.get("powered_by"):
            print(f"  [+] Powered by: {tech['powered_by']}")
        if tech.get("cdn"):
            print(f"  [+] CDN: {tech['cdn']}")
        for cms in tech.get("cms", []):
            print(f"  [+] CMS: {cms}")
        for fw in tech.get("frameworks", []):
            print(f"  [+] Framework: {fw}")
        if tech.get("language"):
            print(f"  [+] Language: {tech['language']}")
        if tech.get("meta_generator"):
            print(f"  [+] Generator: {tech['meta_generator']}")

    def _print_vulns(self, vulns: List[dict]):
        if not vulns:
            print(f"  [+] No vulnerabilities found at this scan depth")
            return
        # Sort by severity
        order = {SEV_CRITICAL: 0, SEV_HIGH: 1, SEV_MEDIUM: 2, SEV_LOW: 3, SEV_INFO: 4}
        vulns.sort(key=lambda v: order.get(v["severity"], 5))
        counts = defaultdict(int)
        for v in vulns:
            counts[v["severity"]] += 1
        print(f"  [!] {len(vulns)} findings: "
              f"{counts.get(SEV_CRITICAL,0)} critical, {counts.get(SEV_HIGH,0)} high, "
              f"{counts.get(SEV_MEDIUM,0)} medium, {counts.get(SEV_LOW,0)} low, "
              f"{counts.get(SEV_INFO,0)} info")
        exploitable_count = sum(1 for v in vulns if v.get("exploitable"))
        if exploitable_count:
            print(f"  [!] {exploitable_count} EXPLOITABLE vulnerabilities found!")

        for v in vulns:
            sev = v["severity"]
            color = {"CRITICAL": "\033[1;31m", "HIGH": "\033[0;31m",
                     "MEDIUM": "\033[1;33m", "LOW": "\033[0;36m",
                     "INFO": "\033[0;90m"}.get(sev, "")
            reset = "\033[0m"
            exploit_tag = " [EXPLOITABLE]" if v.get("exploitable") else ""
            conf = v.get("confidence", 0)
            conf_tag = f" ({conf*100:.0f}%)" if conf else ""
            print(f"  {color}[{sev}]{reset} {v['title']}{exploit_tag}{conf_tag}")
            if sev in (SEV_CRITICAL, SEV_HIGH):
                print(f"         {v['detail'][:120]}")
            if v.get("exploit_info"):
                ei = v["exploit_info"]
                print(f"         Exploit: {ei.get('method', '')[:100]}")
                print(f"         Risk: {ei.get('risk', '')[:80]}")

    def _print_dns(self, records: dict):
        if not records:
            print(f"  [*] No DNS records found (DoH may be blocked)")
            return
        for rtype, values in records.items():
            print(f"  [+] {rtype}: {', '.join(values[:5])}")

    def save_report(self) -> Optional[Path]:
        """Generate structured report and save encrypted."""
        if not self._results and not self._vuln_findings:
            print("\n  [*] No results collected.")
            return None

        # Aggregate extracted data
        all_data: Dict[str, Set[str]] = defaultdict(set)
        pages = 0
        honeypots = 0
        breaches = 0
        for r in self._results:
            if r.get("honeypot"):
                honeypots += 1
                continue
            if r.get("type") == "breach_check":
                if r.get("data", {}).get("breached"):
                    breaches += 1
                continue
            if r.get("type") in ("dns", "subdomains"):
                continue
            pages += 1
            for etype, evals in r.get("extracted", {}).items():
                all_data[etype].update(evals)
            for etype, evals in r.get("secrets_in_comments", {}).items():
                all_data[f"comment_{etype}"].update(evals)

        # Vulnerability severity counts
        vuln_counts = defaultdict(int)
        for v in self._vuln_findings:
            vuln_counts[v["severity"]] += 1

        _ts = int(time.time()) // 600 * 600
        report = {
            "schema": "intel_report_v2",
            "timestamp": _ts,
            "summary": {
                "pages_scraped": pages,
                "honeypots": honeypots,
                "breached_accounts": breaches,
                "vulnerabilities": dict(vuln_counts),
                "vuln_total": len(self._vuln_findings),
                "data_extracted": {k: len(v) for k, v in all_data.items()},
            },
            "vulnerabilities": self._vuln_findings,
            "results": [
                {k: v for k, v in r.items() if k not in ("raw_html", "raw_headers")}
                for r in self._results
            ],
        }

        outpath, enc_key = self._storage.save(report)

        # Summary
        print(f"\n  {'═' * 55}")
        print(f"  REPORT SUMMARY")
        print(f"  {'═' * 55}")
        print(f"  Pages scraped:      {pages}")
        print(f"  Honeypots:          {honeypots}")
        print(f"  Breached accounts:  {breaches}")
        print(f"  Vulnerabilities:    {len(self._vuln_findings)}")
        if vuln_counts:
            for sev in [SEV_CRITICAL, SEV_HIGH, SEV_MEDIUM, SEV_LOW, SEV_INFO]:
                if vuln_counts.get(sev):
                    print(f"    {sev}: {vuln_counts[sev]}")
        if all_data:
            print(f"  Data extracted:")
            for k, v in sorted(all_data.items()):
                if v:
                    print(f"    {k}: {len(v)}")
        print(f"  {'═' * 55}")
        if enc_key:
            print(f"  [+] Report saved (encrypted): {scrub_path(outpath)}")
            print(f"  [+] Decryption key (note this — NOT saved to disk):")
            print(f"      {enc_key}")
        else:
            print(f"  [+] Report saved (plaintext): {scrub_path(outpath)}")
        return outpath

    def cleanup(self):
        self._session.close()
        gc.collect()

    def emergency_wipe(self):
        self._storage.wipe_all()
        self._results.clear()
        self._vuln_findings.clear()
        gc.collect()
        print("  [+] Emergency wipe complete")


