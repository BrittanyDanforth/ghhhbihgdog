    def _init_local_db(self):
        """Initialize local breach database in RAM"""
        try:
            import sqlite3
            self.local_db = sqlite3.connect(':memory:')
            cursor = self.local_db.cursor()
            
            # Create tables
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS breaches (
                    email TEXT,
                    password_hash TEXT,
                    source TEXT,
                    date TEXT,
                    PRIMARY KEY (email, source)
                )
            ''')
            
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS validations (
                    email_hash TEXT PRIMARY KEY,
                    valid INTEGER,
                    last_checked TEXT
                )
            ''')
            
            self.local_db.commit()
            logger.info("Local breach DB initialized in RAM")
            
        except Exception as e:
            logger.error(f"Local DB init failed: {e}")
            
    async def check_hibp(self, email):
        """Check Have I Been Pwned"""
        if not self.hibp_key:
            return None
            
        headers = {
            'hibp-api-key': self.hibp_key,
            'user-agent': 'SecurityResearch/1.0'
        }
        
        # Hash for k-anonymity
        sha1 = hashlib.sha1(email.encode()).hexdigest().upper()
        prefix = sha1[:5]
        
        try:
            from aiohttp_socks import ProxyConnector
            connector = ProxyConnector.from_url('socks5h://127.0.0.1:9050')
            # Use k-anonymity API
            async with aiohttp.ClientSession(connector=connector) as session:
                url = f"https://api.pwnedpasswords.com/range/{prefix}"
                async with session.get(url, headers=headers) as resp:
                    if resp.status == 200:
                        text = await resp.text()
                        
                        # Check if hash suffix exists
                        suffix = sha1[5:]
                        for line in text.split('\n'):
                            if line.startswith(suffix):
                                count = int(line.split(':')[1])
                                return {
                                    'email': email,
                                    'breached': True,
                                    'breach_count': count,
                                    'source': 'HIBP'
                                }
                                
        except Exception as e:
            logger.error(f"HIBP check failed: {e}")
            
        return {'email': email, 'breached': False}
        
    async def check_dehashed(self, email):
        """Check Dehashed database"""
        if not self.dehashed_key:
            return None
            
        headers = {
            'Accept': 'application/json',
            'Authorization': f'Bearer {self.dehashed_key}'
        }
        
        try:
            from aiohttp_socks import ProxyConnector
            connector = ProxyConnector.from_url('socks5h://127.0.0.1:9050')
            async with aiohttp.ClientSession(connector=connector) as session:
                url = f"https://api.dehashed.com/search?query=email:{email}"
                async with session.get(url, headers=headers) as resp:
                    if resp.status == 200:
                        data = await resp.json()
                        
                        if data.get('entries'):
                            return {
                                'email': email,
                                'breached': True,
                                'entries': data['entries'][:5],  # Limit
                                'source': 'Dehashed'
                            }
                            
        except Exception as e:
            logger.error(f"Dehashed check failed: {e}")
            
        return None
        
    def save_to_local(self, breach_data):
        """Save breach data to local RAM DB"""
