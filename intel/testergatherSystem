class SecureStorage:
    """RAM-only encrypted output with auto-wipe."""

    def __init__(self):
        self._dir = RAM_DIR
        self._dir.mkdir(parents=True, exist_ok=True)
        os.chmod(str(self._dir), 0o700)
        self._key = Fernet.generate_key() if HAS_FERNET else None
        self._cipher = Fernet(self._key) if self._key else None

    def save(self, data: dict, label: str = "intel") -> Path:
        """Save data to RAM disk, optionally encrypted."""
        _ts = int(time.time()) // 600 * 600
        ts_str = datetime.fromtimestamp(_ts, tz=timezone.utc).strftime("%Y%m%d_%H%M")
        filename = f"{label}_{ts_str}_{secure_hex(4)}"

        serialized = json.dumps(data, indent=2, default=str).encode()

        if self._cipher:
            encrypted = self._cipher.encrypt(serialized)
            outpath = self._dir / f"{filename}.enc"
            outpath.write_bytes(encrypted)
            secure_file_perms(outpath, 0o600)
            # Save key separately
            keypath = self._dir / f"{filename}.key"
            keypath.write_bytes(self._key)
            secure_file_perms(keypath, 0o600)
        else:
            outpath = self._dir / f"{filename}.json"
            outpath.write_text(serialized.decode())
            secure_file_perms(outpath, 0o600)

        return outpath

    def wipe_all(self):
        """Securely wipe all intel data from RAM disk."""
        if not self._dir.exists():
            return
        for f in self._dir.iterdir():
            try:
                size = f.stat().st_size
                with open(f, "r+b") as fh:
                    fh.write(os.urandom(size))
                    fh.flush()
                f.unlink()
            except (OSError, PermissionError):
                try:
                    f.unlink()
                except OSError:
                    pass
        try:
            self._dir.rmdir()
        except OSError:
            pass


# ═══════════════════════════════════════════════════════════════════════════
#  Main Orchestrator
# ═══════════════════════════════════════════════════════════════════════════

class IntelOrchestrator:
    """Main orchestration: search → scrape → extract → check → store."""

    def __init__(self, proxy: dict):
        self._session = TorSession(proxy)
        self._scraper = IntelScraper(self._session)
        self._breach = BreachChecker(self._session)
        self._storage = SecureStorage()
        self._results: List[dict] = []

    def run_query(self, query: str, max_pages: int = 20):
        """Search + scrape pipeline for a text query."""
        print(f"  [*] Searching: {query[:40]}...")
        search_results = self._scraper.scrape_search_results(query, max_pages)
        print(f"  [+] Found {len(search_results)} results")

        for i, sr in enumerate(search_results):
            if shutdown_requested():
                print("  [!] Shutdown requested, stopping.")
                break
            url = sr["url"]
            print(f"  [*] Scraping [{i+1}/{len(search_results)}] {urlparse(url).netloc}...")
            result = self._scraper.scrape_url(url)
            if result:
                self._results.append(result)
                # Print extracted data summary
                extracted = result.get("extracted", {})
                if extracted:
                    for etype, evals in extracted.items():
                        print(f"      {etype}: {len(evals)} found")

    def run_email_check(self, email: str):
        """Check a single email against breach databases."""
        print(f"  [*] Checking breaches for: {email[:3]}***@***")

        hibp = self._breach.check_hibp(email)
        if hibp:
            if hibp.get("breached"):
                print(f"  [!] HIBP: BREACHED ({hibp.get('breach_count', '?')} breaches)")
                for name in hibp.get("breach_names", [])[:5]:
                    print(f"      - {name}")
            elif hibp.get("status") == "error":
                print(f"  [!] HIBP: check failed (rate limit or network issue)")
            else:
                print(f"  [+] HIBP: not found in breaches")
            self._results.append({"type": "breach_check", "data": hibp})

        dehashed = self._breach.check_dehashed(email)
        if dehashed:
            if dehashed.get("breached"):
                print(f"  [!] Dehashed: BREACHED ({dehashed.get('entry_count', '?')} entries)")
            self._results.append({"type": "breach_check", "data": dehashed})

        if not hibp and not dehashed:
            print(f"  [*] No breach DB API keys configured (set HIBP_KEY / DEHASHED_KEY)")

    def run_domain_recon(self, domain: str):
        """Basic domain reconnaissance via public sources."""
        print(f"  [*] Domain recon: {domain}")

        # Scrape the main page
        for scheme in ["https", "http"]:
            url = f"{scheme}://{domain}"
            result = self._scraper.scrape_url(url)
            if result and not result.get("honeypot"):
                self._results.append(result)
                print(f"  [+] Main page scraped ({result.get('content_length', 0)} bytes)")
                extracted = result.get("extracted", {})
                for etype, evals in extracted.items():
                    print(f"      {etype}: {len(evals)} found")
                break

        # Search for domain mentions
        dork_queries = [
            f'site:{domain}',
            f'"{domain}" email contact',
            f'"{domain}" leak breach',
        ]
        for dq in dork_queries:
            if shutdown_requested():
                break
            self.run_query(dq, max_pages=10)

    def run_file(self, filepath: Path):
        """Process targets from a file (one per line: email, domain, or query)."""
        if not filepath.exists():
            print(f"  [!] File not found: {scrub_path(filepath)}")
            return

        lines = filepath.read_text().strip().splitlines()
        print(f"  [*] Processing {len(lines)} targets from file")

        for i, line in enumerate(lines):
            if shutdown_requested():
                break
            line = line.strip()
            if not line or line.startswith("#"):
                continue

            print(f"\n  ── Target {i+1}/{len(lines)} ──")
            if "@" in line and "." in line:
                self.run_email_check(line)
            elif "." in line and " " not in line:
                self.run_domain_recon(line)
            else:
                self.run_query(line, max_pages=10)

    def save_and_report(self) -> Optional[Path]:
        """Process results, save encrypted, print summary."""
        if not self._results:
            print("\n  [*] No results collected.")
            return None

        # Aggregate
        all_emails: Set[str] = set()
        all_btc: Set[str] = set()
        all_eth: Set[str] = set()
        all_xmr: Set[str] = set()
        all_phones: Set[str] = set()
        all_onions: Set[str] = set()
        breach_count = 0
        honeypot_count = 0
        pages_scraped = 0

        for r in self._results:
            if r.get("honeypot"):
                honeypot_count += 1
                continue
            if r.get("type") == "breach_check":
                if r.get("data", {}).get("breached"):
                    breach_count += 1
                continue

            pages_scraped += 1
            ex = r.get("extracted", {})
            all_emails.update(ex.get("email", []))
            all_btc.update(ex.get("btc_address", []))
            all_eth.update(ex.get("eth_address", []))
            all_xmr.update(ex.get("xmr_address", []))
            all_phones.update(ex.get("phone", []))
            all_onions.update(ex.get("onion_v3", []))

        _coarsened = int(time.time()) // 600 * 600
        report = {
            "schema": "intel_report_v1",
            "timestamp": _coarsened,
            "summary": {
                "pages_scraped": pages_scraped,
                "honeypots_detected": honeypot_count,
                "breached_accounts": breach_count,
                "unique_emails": len(all_emails),
                "unique_btc_addresses": len(all_btc),
                "unique_eth_addresses": len(all_eth),
                "unique_xmr_addresses": len(all_xmr),
                "unique_phones": len(all_phones),
                "unique_onion_services": len(all_onions),
            },
            "results": self._results,
        }

        outpath = self._storage.save(report)

        # Print summary
        print(f"\n  {'═' * 50}")
        print(f"  COLLECTION SUMMARY")
        print(f"  {'═' * 50}")
        print(f"  Pages scraped:      {pages_scraped}")
        print(f"  Honeypots detected: {honeypot_count}")
        print(f"  Breached accounts:  {breach_count}")
        print(f"  Emails found:       {len(all_emails)}")
        print(f"  BTC addresses:      {len(all_btc)}")
        print(f"  ETH addresses:      {len(all_eth)}")
        print(f"  XMR addresses:      {len(all_xmr)}")
        print(f"  Phone numbers:      {len(all_phones)}")
        print(f"  Onion services:     {len(all_onions)}")
        print(f"  {'═' * 50}")
        encrypted = "encrypted" if HAS_FERNET else "plaintext"
        print(f"  [+] Report saved ({encrypted}): {scrub_path(outpath)}")

        return outpath

    def cleanup(self):
        """Close session and clean up."""
        self._session.close()
        gc.collect()

    def emergency_wipe(self):
        """Wipe all data from RAM disk."""
        self._storage.wipe_all()
        self._results.clear()
        gc.collect()
        print("  [+] Emergency wipe complete")


# ═══════════════════════════════════════════════════════════════════════════
#  CLI
# ═══════════════════════════════════════════════════════════════════════════

def main():
    install_signal_handlers()

    ap = argparse.ArgumentParser(
        description="Intelligence Gathering System — OSINT via Tor with anti-blocking",
    )
    ap.add_argument("--query", "-q", help="Search query to investigate")
    ap.add_argument("--email", "-e", help="Email to check against breach databases")
    ap.add_argument("--domain", "-d", help="Domain to perform reconnaissance on")
    ap.add_argument("--file", "-f", type=Path,
                    help="File with targets (one per line: email, domain, or query)")
    ap.add_argument("--tor-proxy", default="socks5h://127.0.0.1:9050",
                    help="Tor SOCKS5 proxy (default: socks5h://127.0.0.1:9050)")
    ap.add_argument("--max-results", type=int, default=20,
                    help="Max search results to scrape per query (default: 20)")
    ap.add_argument("--wipe", action="store_true",
                    help="Wipe all intel data from RAM and exit")
    args = ap.parse_args()

    if args.wipe:
        storage = SecureStorage()
        storage.wipe_all()
        print("  [+] Intel data wiped from RAM.")
        return

    if not args.query and not args.email and not args.domain and not args.file:
        ap.error("At least one of --query, --email, --domain, or --file is required")

    # Enforce Tor
    proxy = require_tor_proxy(args.tor_proxy)
    integrity_log("intel", "session_start")

    orchestrator = IntelOrchestrator(proxy)

    try:
        if args.email:
            orchestrator.run_email_check(args.email)

        if args.domain:
            orchestrator.run_domain_recon(args.domain)

        if args.query:
            orchestrator.run_query(args.query, args.max_results)

        if args.file:
            orchestrator.run_file(args.file)

        orchestrator.save_and_report()

    except KeyboardInterrupt:
        print("\n  [!] Interrupted — saving partial results...")
        orchestrator.save_and_report()
    except Exception as e:
        print(f"\n  [!] Error: {str(e)[:60]}")
        integrity_log("intel", f"error:{str(e)[:40]}")
    finally:
        orchestrator.cleanup()
        integrity_log("intel", "session_end")

    print()
    print("  [*] Done. Data is in RAM (/dev/shm/intel/).")
    print("  [*] Run with --wipe to securely erase when finished.")


if __name__ == "__main__":
    main()
