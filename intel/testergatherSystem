class BreachChecker:
    def __init__(self, session: TorSession):
        self._session = session

    def check_hibp(self, email: str) -> Optional[dict]:
        if not HIBP_API_KEY:
            return None
        url = f"https://haveibeenpwned.com/api/v3/breachedaccount/{quote(email)}?truncateResponse=true"
        resp = self._session.get(url, allow_wayback=False,
                                 headers={"hibp-api-key": HIBP_API_KEY})
        if resp is None:
            return {"email_hash": hashlib.sha256(email.encode()).hexdigest()[:16],
                    "status": "error", "source": "hibp"}
        if resp.status_code == 200:
            try:
                breaches = resp.json()
                return {"email_hash": hashlib.sha256(email.encode()).hexdigest()[:16],
                        "breached": True,
                        "breach_count": len(breaches) if isinstance(breaches, list) else 1,
                        "breach_names": [b.get("Name", "?") for b in (breaches if isinstance(breaches, list) else [])[:10]],
                        "source": "hibp"}
            except (ValueError, KeyError):
                pass
        elif resp.status_code == 404:
            return {"email_hash": hashlib.sha256(email.encode()).hexdigest()[:16],
                    "breached": False, "source": "hibp"}
        return None

    def check_dehashed(self, email: str) -> Optional[dict]:
        if not DEHASHED_API_KEY or not DEHASHED_EMAIL:
