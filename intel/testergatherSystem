class TechFingerprinter:
    """Detect server software, CMS, frameworks from headers and HTML."""

    # Server header patterns
    SERVER_PATTERNS = {
        "Apache": re.compile(r"Apache/?(\S*)", re.I),
        "Nginx": re.compile(r"nginx/?(\S*)", re.I),
        "IIS": re.compile(r"Microsoft-IIS/?(\S*)", re.I),
        "LiteSpeed": re.compile(r"LiteSpeed", re.I),
        "Cloudflare": re.compile(r"cloudflare", re.I),
        "Caddy": re.compile(r"Caddy", re.I),
    }

    # CMS detection via HTML patterns
    CMS_PATTERNS = {
        "WordPress": [
            re.compile(r"/wp-content/", re.I),
            re.compile(r"/wp-includes/", re.I),
            re.compile(r'<meta name="generator" content="WordPress[^"]*"', re.I),
        ],
        "Drupal": [
            re.compile(r'<meta name="generator" content="Drupal', re.I),
            re.compile(r"/sites/default/files/", re.I),
            re.compile(r"Drupal\.settings", re.I),
        ],
        "Joomla": [
            re.compile(r'<meta name="generator" content="Joomla', re.I),
            re.compile(r"/media/jui/", re.I),
        ],
        "Shopify": [
            re.compile(r"cdn\.shopify\.com", re.I),
            re.compile(r"Shopify\.theme", re.I),
        ],
        "Wix": [re.compile(r"static\.wixstatic\.com", re.I)],
        "Squarespace": [re.compile(r"squarespace\.com", re.I)],
    }

    # Framework detection
    FRAMEWORK_PATTERNS = {
        "React": re.compile(r"react(?:\.production|\.development|DOM)", re.I),
        "Vue.js": re.compile(r"vue(?:\.runtime|\.global|\.esm)", re.I),
        "Angular": re.compile(r"ng-version|angular(?:\.min)?\.js", re.I),
        "jQuery": re.compile(r"jquery[.\-](\d+\.\d+)", re.I),
        "Bootstrap": re.compile(r"bootstrap[.\-](\d+\.\d+)", re.I),
        "Laravel": re.compile(r"laravel|csrf-token", re.I),
        "Django": re.compile(r"csrfmiddlewaretoken|__admin__", re.I),
        "Rails": re.compile(r"rails|turbolinks", re.I),
        "Next.js": re.compile(r"_next/static|__NEXT_DATA__", re.I),
        "Express": re.compile(r"X-Powered-By:\s*Express", re.I),
    }

    @classmethod
    def fingerprint(cls, headers: dict, html: str) -> dict:
        tech = {"server": None, "cms": [], "frameworks": [], "powered_by": None,
                "language": None, "cdn": None}

        # Server header
        server = headers.get("Server", headers.get("server", ""))
        if server:
            tech["server"] = server
            for name, pat in cls.SERVER_PATTERNS.items():
                m = pat.search(server)
                if m:
                    tech["server"] = f"{name} {m.group(1) if m.group(1) else ''}".strip()
                    break

        # X-Powered-By
        powered = headers.get("X-Powered-By", headers.get("x-powered-by", ""))
        if powered:
            tech["powered_by"] = powered
            if "PHP" in powered.upper():
                tech["language"] = f"PHP ({powered})"
            elif "ASP.NET" in powered.upper():
                tech["language"] = f"ASP.NET ({powered})"
            elif "Express" in powered:
                tech["language"] = "Node.js (Express)"

        # CDN detection
        for cdn_header in ["cf-ray", "x-cache", "x-cdn", "x-amz-cf-id"]:
            if cdn_header in {k.lower() for k in headers}:
                if "cf-ray" in {k.lower() for k in headers}:
                    tech["cdn"] = "Cloudflare"
                elif "x-amz-cf-id" in {k.lower() for k in headers}:
                    tech["cdn"] = "AWS CloudFront"
                else:
                    tech["cdn"] = "CDN detected"
                break

        # CMS detection from HTML
        for cms_name, patterns in cls.CMS_PATTERNS.items():
            for pat in patterns:
                if pat.search(html[:50000]):
                    if cms_name not in tech["cms"]:
                        tech["cms"].append(cms_name)
                    break

        # Framework detection from HTML
        for fw_name, pat in cls.FRAMEWORK_PATTERNS.items():
            if pat.search(html[:50000]):
                tech["frameworks"].append(fw_name)

        # Meta generator
        if HAS_BS4:
            try:
                soup = BeautifulSoup(html[:10000], "html.parser")
                gen = soup.find("meta", attrs={"name": "generator"})
                if gen and gen.get("content"):
                    tech["meta_generator"] = gen["content"][:100]
            except Exception as e:
                integrity_log("intel", f"tech_meta_error:{type(e).__name__}")

        return tech


