#  Honeypot Detection
# ═══════════════════════════════════════════════════════════════════════════

class HoneypotDetector:
    """Detect honeypot/bot-trap pages using content and behavior heuristics."""

    TRAP_PATTERNS = [
        re.compile(r"(?:honeypot|bot.?trap|bot.?check)", re.I),
        re.compile(r"please\s+verify\s+you\s+are\s+human", re.I),
        re.compile(r"unusual\s+activity\s+detected", re.I),
        re.compile(r"access\s+denied.*cloudflare", re.I),
        re.compile(r"captcha", re.I),
    ]

    SUSPICIOUS_HEADERS = {
        "x-honeypot", "x-trap", "x-security-scan",
        "x-abuse-info", "cf-mitigated",
    }

    @classmethod
    def check(cls, content: str, headers: dict, response_time_ms: float,
              redirects: int) -> dict:
        """Returns {is_honeypot: bool, confidence: float, reasons: []}."""
        score = 0.0
        reasons = []

        # Content patterns
        for pat in cls.TRAP_PATTERNS:
            if pat.search(content[:5000]):
                score += 0.25
                reasons.append(f"trap_pattern:{pat.pattern[:30]}")

        # Suspicious headers
        lower_headers = {k.lower(): v for k, v in headers.items()}
        for h in cls.SUSPICIOUS_HEADERS:
            if h in lower_headers:
                score += 0.2
                reasons.append(f"suspicious_header:{h}")

        # Too-fast response (bot-served page)
        if response_time_ms < 30:
            score += 0.15
            reasons.append("response_too_fast")

        # Excessive redirects
        if redirects > 4:
            score += 0.2
            reasons.append(f"excessive_redirects:{redirects}")

        # Very small page (likely a block/challenge page)
        if len(content) < 500 and ("blocked" in content.lower() or "denied" in content.lower()):
            score += 0.3
            reasons.append("tiny_block_page")

        return {
            "is_honeypot": score >= 0.5,
            "confidence": min(score, 1.0),
            "reasons": reasons,
        }


# ═══════════════════════════════════════════════════════════════════════════
#  Rate-Limited Tor Session
# ═══════════════════════════════════════════════════════════════════════════

class TorSession:
    """Requests session with Tor proxy, rate limiting, and anti-fingerprinting.

    Features:
    - All requests through socks5h (DNS at proxy)
    - Per-domain rate tracking with adaptive delays
    - Automatic circuit rotation every N requests
    - Browser profile rotation per request
    - Exponential backoff on 429/503
    - Cookie persistence within session
    """

    def __init__(self, proxy_dict: dict):
        self._proxy = proxy_dict
        self._session = requests.Session()
        self._session.proxies.update(proxy_dict)

        # Retry adapter for transient errors (NOT for rate limits)
        retry = Retry(total=2, backoff_factor=1, status_forcelist=[500, 502, 504])
        adapter = HTTPAdapter(max_retries=retry)
        self._session.mount("http://", adapter)
        self._session.mount("https://", adapter)

        # Rate tracking
        self._domain_last_request: Dict[str, float] = {}
        self._request_count = 0
        self._backoff_domains: Dict[str, float] = {}  # domain → backoff_until

    def get(self, url: str, **kwargs) -> Optional[requests.Response]:
        """GET with rate limiting, anti-fingerprinting, and error handling."""
        if shutdown_requested():
            return None

        domain = urlparse(url).netloc

        # Check domain backoff
        backoff_until = self._backoff_domains.get(domain, 0)
        if time.time() < backoff_until:
            wait = backoff_until - time.time()
            if wait > 0:
                time.sleep(wait)

        # Per-domain rate limit
        last = self._domain_last_request.get(domain, 0)
        elapsed = time.time() - last
        min_delay = DOMAIN_MIN_DELAY + secrets.randbelow(
            int((DOMAIN_MAX_DELAY - DOMAIN_MIN_DELAY) * 1000)
        ) / 1000.0
        if elapsed < min_delay:
            time.sleep(min_delay - elapsed)

        # Rotate circuit periodically
        self._request_count += 1
        if self._request_count % CIRCUIT_ROTATION_EVERY == 0:
            newnym()
            time.sleep(2 + secrets.randbelow(3000) / 1000.0)

        # Pick browser profile
        headers = _pick_profile()
        if "headers" in kwargs:
            headers.update(kwargs.pop("headers"))

        # Set timeout
        kwargs.setdefault("timeout", 20)

        try:
            self._domain_last_request[domain] = time.time()
            resp = self._session.get(url, headers=headers, **kwargs)

            # Handle rate limiting
            if resp.status_code == 429:
                retry_after = int(resp.headers.get("Retry-After", "60"))
                retry_after = min(retry_after, 300)  # cap at 5 min
                self._backoff_domains[domain] = time.time() + retry_after
                integrity_log("intel", f"rate_limited:{domain}:wait={retry_after}s")
                return None

            if resp.status_code == 503:
                # Service unavailable — likely WAF challenge
                self._backoff_domains[domain] = time.time() + 30
                return None

            if resp.status_code == 403:
                # Forbidden — likely blocked
                integrity_log("intel", f"blocked:{domain}")
                self._backoff_domains[domain] = time.time() + 120
                newnym()  # Rotate circuit on block
                return None

            resp.raise_for_status()
            return resp

        except requests.exceptions.Timeout:
            integrity_log("intel", f"timeout:{domain}")
            return None
        except requests.exceptions.ConnectionError:
            integrity_log("intel", f"conn_error:{domain}")
            return None
        except requests.exceptions.HTTPError as e:
            integrity_log("intel", f"http_error:{domain}:{e.response.status_code if e.response else '?'}")
            return None

    def close(self):
        """Close the session."""
        self._session.close()


