#!/usr/bin/env python3
"""
exit_strategy_simulator v10.0 - Off-Ramp Planner (heuristic liquidity guidance)
==============================================================================
Part of the GhostSpiral v10 tool-chain. Generates a schema-tagged
exitplan_v1.json bundle.

Prices are LIVE (CoinGecko, Bisq oracle fallback) or the tool aborts -- it never
serves a made-up price. Fees/slippage per method are STATIC ESTIMATES, not live
quotes, and the "liquidity" output is a HEURISTIC based on trade size only, NOT
a real order-book/depth probe (Bisq/Haveno P2P markets have no queryable book).

OPSEC hardening:
  - Tor verified before any API access
  - Atomic fsync-rename output with 0600 perms
  - Integrity hash-chain logging (amounts are NOT written to the chain)
  - KYC risk flagging
  - Heuristic liquidity guidance by trade size (clearly labelled; not a probe)
  - --redact masks the figures on screen for shoulder-surfing / screen-sharing

TERMINAL OUTPUT IS NOT REDACTED BY DEFAULT, and this header used to claim it
was ("No sensitive amounts or addresses leaked to terminal (redacted)") while
printing the exact holding and its exact fiat value. That claim was false: the
figures ARE the output of an off-ramp planner and the operator needs to read
them. Use --redact when someone may be looking, which masks the magnitudes on
screen while the full plan still goes to the 0600 JSON file.
"""
from __future__ import annotations
import argparse, sys, time
from decimal import Decimal
from pathlib import Path
from typing import Dict

from gs_common import (
    integrity_log, verify_tor, validate_proxy, safe_get,
    atomic_write_json, install_signal_handlers,
)

CG_URL = "https://api.coingecko.com/api/v3/simple/price?ids=monero,bitcoin&vs_currencies=usd,eur"
# Bisq and Haveno are P2P DEXs without centralized market APIs.
# The Bisq price oracle is the closest to an official data source.
BISQ_PRICE_URL = "https://price.bisq.wiz.biz/getAllMarketPrices"

METHODS: Dict[str, Dict] = {
    "bisq":   {"fee_pct": Decimal("0.003"), "slippage": Decimal("0.01"),  "kyc": False},
    "haveno": {"fee_pct": Decimal("0.003"), "slippage": Decimal("0.008"), "kyc": False},
    "azteco": {"fee_pct": Decimal("0.05"),  "slippage": Decimal("0.00"),  "kyc": True},
    "p2p":    {"fee_pct": Decimal("0.00"),  "slippage": Decimal("0.03"),  "kyc": False},
}


def fetch_prices(proxy):
    """Fetch XMR and BTC prices. Falls back to Bisq price oracle if CoinGecko fails."""
    try:
        j = safe_get(CG_URL, proxy)
        return {
            "xmr_usd": Decimal(str(j["monero"]["usd"])),
            "xmr_eur": Decimal(str(j["monero"]["eur"])),
            "btc_usd": Decimal(str(j["bitcoin"]["usd"])),
            "btc_eur": Decimal(str(j["bitcoin"]["eur"])),
            "source": "coingecko",
        }
    except Exception as e:
        integrity_log("exit", f"coingecko_fail:{str(e)[:40]}")

    # Fallback: Bisq price oracle (returns all market prices)
    try:
        j = safe_get(BISQ_PRICE_URL, proxy)
        prices = {}
        for entry in j.get("data", []):
            code = entry.get("currencyCode", "")
            price = entry.get("price", 0)
            if code == "XMR" and price > 0:
                # Bisq quotes altcoin markets as BTC-per-unit (BTC per XMR).
                prices["xmr_btc"] = Decimal(str(price))
            elif code == "USD" and price > 0:
                # Bisq quotes fiat as fiat-per-BTC (USD per BTC). Do NOT invert:
                # xmr_usd = xmr_btc[BTC/XMR] * btc_usd[USD/BTC] = USD/XMR. The
                # old 1.0/price made btc_usd = BTC/USD, so the product came out
                # ~9 orders of magnitude too small and quantized to 0.00.
                prices["btc_usd"] = Decimal(str(price))
            elif code == "EUR" and price > 0:
                prices["btc_eur"] = Decimal(str(price))

        if "xmr_btc" in prices and "btc_usd" in prices:
            xmr_usd = prices["xmr_btc"] * prices["btc_usd"]
            out = {
                "xmr_usd": xmr_usd.quantize(Decimal("0.01")),
                "btc_usd": prices["btc_usd"].quantize(Decimal("0.01")),
                "source": "bisq_oracle",
            }
            # Only emit EUR fields if Bisq actually returned a EUR/BTC price.
            # The old code fell back to btc_usd for a missing EUR rate, which
            # silently reported USD figures under a EUR label. If EUR wasn't
            # quoted, leave it out — main() will refuse a --currency it lacks.
            if "btc_eur" in prices:
                out["xmr_eur"] = (prices["xmr_btc"] * prices["btc_eur"]).quantize(Decimal("0.01"))
                out["btc_eur"] = prices["btc_eur"].quantize(Decimal("0.01"))
            integrity_log("exit", "bisq_price_oracle_ok")
            return out
    except Exception as e:
        integrity_log("exit", f"bisq_oracle_fail:{str(e)[:40]}")

    sys.exit(
        "[!] All price oracles failed (CoinGecko + Bisq).\n"
        "    Cannot generate exit plan without prices.\n"
        "    Check Tor connectivity and retry."
    )


def liquidity_estimate(method: str, amount_xmr: Decimal) -> str:
    """Provide liquidity guidance based on method and amount.
    P2P DEXs like Bisq/Haveno don't have queryable order books,
    so we give heuristic guidance instead of fake API calls."""
    if method in ("bisq", "haveno"):
        if amount_xmr > Decimal("50"):
            return "LOW — consider splitting across multiple trades over days"
        elif amount_xmr > Decimal("10"):
            return "MEDIUM — may take multiple trades to fill"
        else:
            return "OK — typical volume for P2P markets"
    elif method == "p2p":
        return "UNKNOWN — depends on your counterparty"
    elif method == "azteco":
        return "HIGH — voucher-based, no order book"
    return "UNKNOWN"


def main():
    install_signal_handlers()

    ap = argparse.ArgumentParser(
        "exit_strategy_simulator v10.0",
        description="Plan XMR off-ramp with liquidity analysis",
    )
    ap.add_argument("amount", type=Decimal, help="XMR amount to off-ramp")
    ap.add_argument("--method", choices=list(METHODS.keys()), default="bisq")
    ap.add_argument("--currency", choices=["usd", "eur"], default="usd")
    ap.add_argument("--tor-proxy")
    ap.add_argument("--suppress-kyc", action="store_true")
    ap.add_argument("--redact", action="store_true",
                    help="mask amounts and values on the terminal (the full plan "
                         "is still written to the 0600 JSON file). Use when "
                         "screen-sharing or in a shoulder-surfing risk.")
    ap.add_argument("--outfile", default="exitplan_v1.json")
    args = ap.parse_args()

    if args.amount <= 0:
        sys.exit("[!] Amount must be positive")

    if not args.tor_proxy:
        sys.exit(
            "[!] --tor-proxy is REQUIRED. Clearnet queries to CoinGecko/Bisq/Haveno\n"
            "    leak your IP and reveal interest in XMR off-ramp methods. Aborting."
        )
    proxy = validate_proxy(args.tor_proxy)
    verify_tor(proxy)

    prices = fetch_prices(proxy)

    cfg = METHODS[args.method]
    gross = args.amount
    fee = gross * cfg["fee_pct"]
    slip = gross * cfg["slippage"]
    net = gross - fee - slip

    if net <= 0:
        sys.exit(f"[!] Net amount after fees+slippage is non-positive: {net}")

    rate_key = f"xmr_{args.currency}"
    if rate_key not in prices:
        sys.exit(
            f"[!] The active price oracle ({prices.get('source', '?')}) did not "
            f"provide an {args.currency.upper()} rate for XMR.\n"
            f"    Re-run with --currency usd, or use a source that quotes "
            f"{args.currency.upper()}. Refusing to fabricate the rate."
        )
    fiat_rate = prices[rate_key]
    fiat_val = (net * fiat_rate).quantize(Decimal("0.01"))

    liq_guidance = liquidity_estimate(args.method, gross)

    plan = {
        "schema": "exitplan_v1",
        "timestamp": int(time.time()) // 600 * 600,
        "method": args.method,
        "kyc_required": cfg["kyc"],
        "amount_in_xmr": str(gross),
        "fee_pct": str(cfg["fee_pct"]),
        "slippage_pct": str(cfg["slippage"]),
        "net_xmr": str(net.quantize(Decimal("0.0001"))),
        "currency": args.currency,
        "amount_out_fiat": str(fiat_val),
        "oracle_prices": {k: str(v) for k, v in prices.items()
                          if k != "source"},
        "price_source": prices.get("source", "unknown"),
        "liquidity_guidance": liq_guidance,
    }

    atomic_write_json(plan, Path(args.outfile))

    kyc_tag = "KYC" if cfg["kyc"] else "NoKYC"
    integrity_log("exit", f"{args.method}|{kyc_tag}")

    def _m(v, unit=""):
        """Mask a magnitude when --redact is on. Order of magnitude is kept so
        the operator can still sanity-check the plan; the digits are not."""
        if not args.redact:
            return f"{v}{unit}"
        d = len(str(int(Decimal(str(v)).copy_abs())))
        return f"{'#' * d}.{'#' * 4}{unit} (redacted, {d}-digit)"

    kyc_label = "KYC" if cfg["kyc"] and not args.suppress_kyc else "No-KYC"
    print(f"  Method      : {args.method} ({kyc_label})")
    print(f"  Gross       : {_m(gross, ' XMR')}")
    print(f"  Fees        : {_m(round(fee, 4), ' XMR')} ({cfg['fee_pct'] * 100:.1f}%)")
    print(f"  Slippage    : {_m(round(slip, 4), ' XMR')}")
    print(f"  ----------------------------------------")
    print(f"  Net         : {_m(round(net, 4), ' XMR')}")
    print(f"  Value       : {_m(fiat_val, ' ' + args.currency.upper())}")
    print(f"  Prices from : {prices.get('source', 'unknown')}")
    print(f"  Liquidity   : {liq_guidance} (heuristic)")
    if cfg["kyc"] and not args.suppress_kyc:
        print(f"  [!] WARNING: {args.method} requires KYC verification")
    print(f"  [+] Plan saved -> {args.outfile}")


if __name__ == "__main__":
    main()
