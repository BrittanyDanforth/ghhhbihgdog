#!/usr/bin/env python3
"""
exit_strategy_simulator v10.0 - Off-Ramp Planner w/ Liquidity Probe
====================================================================
Part of the GhostSpiral v10 tool-chain. Generates a schema-tagged
exitplan_v1.json bundle.

OPSEC hardening:
  - Tor verified before any API access
  - No sensitive amounts or addresses leaked to terminal (redacted)
  - Atomic fsync-rename output with 0600 perms
  - Integrity hash-chain logging
  - KYC risk flagging
  - Liquidity depth validation (warns if thin)
"""
from __future__ import annotations
import argparse, json, os, sys, time, hashlib
from decimal import Decimal
from pathlib import Path
from typing import Dict

from gs_common import (
    integrity_log, verify_tor, validate_proxy, safe_get,
    atomic_write_json, install_signal_handlers,
)

CG_URL = "https://api.coingecko.com/api/v3/simple/price?ids=monero,bitcoin&vs_currencies=usd,eur"
BISQ_URL = "https://bisq.markets/api/markets?pair=XMR_BTC"
HAVENO_URL = "https://haveno.network/api/markets/XMR_BTC"

METHODS: Dict[str, Dict] = {
    "bisq":   {"fee_pct": Decimal("0.003"), "slippage": Decimal("0.01"),  "kyc": False},
    "haveno": {"fee_pct": Decimal("0.003"), "slippage": Decimal("0.008"), "kyc": False},
    "azteco": {"fee_pct": Decimal("0.05"),  "slippage": Decimal("0.00"),  "kyc": True},
    "p2p":    {"fee_pct": Decimal("0.00"),  "slippage": Decimal("0.03"),  "kyc": False},
}


def fetch_prices(proxy):
    j = safe_get(CG_URL, proxy)
    return {
        "xmr_usd": Decimal(str(j["monero"]["usd"])),
        "xmr_eur": Decimal(str(j["monero"]["eur"])),
        "btc_usd": Decimal(str(j["bitcoin"]["usd"])),
        "btc_eur": Decimal(str(j["bitcoin"]["eur"])),
    }


def liquidity_score(url: str, buy_key: str, sell_key: str, proxy) -> Decimal:
    try:
        book = safe_get(url, proxy)
        bids = Decimal(str(book[buy_key][0]["amount"])) if book.get(buy_key) else Decimal(0)
        asks = Decimal(str(book[sell_key][0]["amount"])) if book.get(sell_key) else Decimal(0)
        return bids + asks
    except Exception:
        return Decimal(0)


def main():
    install_signal_handlers()

    ap = argparse.ArgumentParser(
        "exit_strategy_simulator v10.0",
        description="Plan XMR off-ramp with liquidity analysis",
    )
    ap.add_argument("amount", type=Decimal, help="XMR amount to off-ramp")
    ap.add_argument("--method", choices=list(METHODS.keys()), default="bisq")
    ap.add_argument("--currency", choices=["usd", "eur"], default="usd")
    ap.add_argument("--tor-proxy")
    ap.add_argument("--suppress-kyc", action="store_true")
    ap.add_argument("--outfile", default="exitplan_v1.json")
    args = ap.parse_args()

    if args.amount <= 0:
        sys.exit("[!] Amount must be positive")

    if not args.tor_proxy:
        sys.exit(
            "[!] --tor-proxy is REQUIRED. Clearnet queries to CoinGecko/Bisq/Haveno\n"
            "    leak your IP and reveal interest in XMR off-ramp methods. Aborting."
        )
    proxy = validate_proxy(args.tor_proxy)
    verify_tor(proxy)

    prices = fetch_prices(proxy)

    cfg = METHODS[args.method]
    gross = args.amount
    fee = gross * cfg["fee_pct"]
    slip = gross * cfg["slippage"]
    net = gross - fee - slip

    if net <= 0:
        sys.exit(f"[!] Net amount after fees+slippage is non-positive: {net}")

    fiat_rate = prices[f"xmr_{args.currency}"]
    fiat_val = (net * fiat_rate).quantize(Decimal("0.01"))

    liq_score = Decimal(0)
    if args.method == "bisq":
        liq_score = liquidity_score(BISQ_URL, "buy", "sell", proxy)
    elif args.method == "haveno":
        liq_score = liquidity_score(HAVENO_URL, "bids", "asks", proxy)

    thin_warn = bool(liq_score > 0 and liq_score < (gross * Decimal("3")))

    plan = {
        "schema": "exitplan_v1",
        "timestamp": int(time.time()),
        "method": args.method,
        "kyc_required": cfg["kyc"],
        "amount_in_xmr": str(gross),
        "fee_pct": str(cfg["fee_pct"]),
        "slippage_pct": str(cfg["slippage"]),
        "net_xmr": str(net.quantize(Decimal("0.0001"))),
        "currency": args.currency,
        "amount_out_fiat": str(fiat_val),
        "oracle_prices": {k: str(v) for k, v in prices.items()},
        "liquidity_score": str(liq_score),
        "liquidity_thin": thin_warn,
    }

    atomic_write_json(plan, Path(args.outfile))

    kyc_tag = "KYC" if cfg["kyc"] else "NoKYC"
    integrity_log("exit", f"{args.method}|{kyc_tag}|net={net}|thin={thin_warn}")

    # Terminal output (amounts shown since operator needs them)
    kyc_label = "KYC" if cfg["kyc"] and not args.suppress_kyc else "No-KYC"
    print(f"  Method      : {args.method} ({kyc_label})")
    print(f"  Gross       : {gross} XMR")
    print(f"  Fees        : {fee:.4f} XMR ({cfg['fee_pct'] * 100:.1f}%)")
    print(f"  Slippage    : {slip:.4f} XMR")
    print(f"  ----------------------------------------")
    print(f"  Net         : {net:.4f} XMR")
    print(f"  Value       : {fiat_val} {args.currency.upper()}")
    if liq_score:
        thin_label = "THIN - consider splitting" if thin_warn else "OK"
        print(f"  Liquidity   : {liq_score} ({thin_label})")
    else:
        print(f"  Liquidity   : unavailable (API fail)")
    if cfg["kyc"] and not args.suppress_kyc:
        print(f"  [!] WARNING: {args.method} requires KYC verification")
    print(f"  [+] Plan saved -> {args.outfile}")


if __name__ == "__main__":
    main()
