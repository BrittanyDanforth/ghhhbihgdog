    write_meta_files(meta)
    gpg_encrypt()
    if not GPG_RECIP:
        shutil.rmtree(RAM_DIR, ignore_errors=True)
    run_grabber(usb)

    # cleanup event loop
    loop.run_until_complete(loop.shutdown_asyncgens())
    loop.close()
    wipe_exit(0) " 


