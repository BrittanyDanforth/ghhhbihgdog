from typing import Dict, List
from stem.control import Controller
from selenium import webdriver
from selenium.webdriver.firefox.options import Options as FirefoxOptions
from selenium.webdriver.common.by import By

#── Config ─────────────────────────────────────────────────────────────────
TOR_SOCKS   = os.getenv("TOR_SOCKS_PROXY", "socks5://127.0.0.1:9050")
TOR_CTRL    = os.getenv("TOR_CTRL", "127.0.0.1:9051")
TOR_CTRL_PW = os.getenv("TOR_CTRL_PW", "")
GPG_RECIP   = os.getenv("GPG_RECIPIENT", "")
MAX_LOOKUPS = 15
CAPTCHA_STR = ("captcha", "verify you", "cloudflare")
logging.basicConfig(level=logging.INFO, format="[%(asctime)s] %(levelname)s %(message)s", datefmt="%H:%M:%S")
slow_factor: float = 1.0
RAM_DIR: Path

#── Helpers ────────────────────────────────────────────────────────────────
randf   = lambda a,b: random.uniform(a*slow_factor, b*slow_factor)
nap     = lambda a=2,b=4: time.sleep(randf(a,b))
long_nap= lambda: time.sleep(randf(90,120))

def tor_newnym():
    try:
        host, port = TOR_CTRL.split(":")
        with Controller.from_port(address=host, port=int(port)) as c:
            if TOR_CTRL_PW:
                c.authenticate(password=TOR_CTRL_PW)
            else:
                c.authenticate()
            c.signal(c.NEWNYM)
    except Exception as e:
        logging.debug("NEWNYM error: %s", e)

def tor_check():
    for i in range(3):
        out = subprocess.run(["torsocks","curl","-s","https://check.torproject.org/api/ip"], capture_output=True).stdout
        if b'"IsTor":true' in out:
            return
        logging.warning("Tor check %d/3 failed", i+1); time.sleep(5)
    sys.exit("[!] Tor unreachable")
tor_check()

#── Browser profile in RAM ─────────────────────────────────────────────────
def make_driver() -> webdriver.Firefox:
    ua_list = [
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:119.0) Gecko/20100101 Firefox/119.0",
        "Mozilla/5.0 (X11; Linux x86_64; rv:118.0) Gecko/20100101 Firefox/118.0"
    ]
    profile_dir = Path("/dev/shm")/f"ff_prof_{secrets.token_hex(4)}"
    profile_dir.mkdir(exist_ok=True)
    opts = FirefoxOptions(); opts.add_argument("--headless")
    opts.set_preference("general.useragent.override", random.choice(ua_list))
    opts.set_preference("network.proxy.type",1)
    opts.set_preference("network.proxy.socks","127.0.0.1")
    opts.set_preference("network.proxy.socks_port",9050)
    opts.set_preference("network.proxy.socks_remote_dns",True)
    opts.set_preference("permissions.default.image",2)
    opts.set_preference("media.peerconnection.enabled", False)
    opts.set_preference("dom.battery.enabled", False)
    opts.set_preference("profile", str(profile_dir))
    drv = webdriver.Firefox(options=opts, service_log_path=os.devnull)
    drv.set_window_size(random.randint(1200,1600), random.randint(800,1050))
    drv.profile_path = profile_dir
    return drv

#── Cleanup ─────────────────────────────────────────────────────────────────
def wipe_exit(code=0):
    try: shutil.rmtree(RAM_DIR, ignore_errors=True)
    except: pass
    logging.info("RAM wiped. Exiting.")
    sys.exit(code)
for s in (signal.SIGINT, signal.SIGTERM): signal.signal(s, lambda *_: wipe_exit(1))

#── CAPTCHA‑aware fetch ──────────────────────────────────────────────────────
async def safe_page(drv, url):
    tor_newnym(); drv.get(url); nap(4,6)
    src = drv.page_source.lower()
    if any(c in src for c in CAPTCHA_STR):
        logging.warning("Captcha at %s", url)
        long_nap(); tor_newnym(); drv.get(url); nap(8,12)
        if any(c in drv.page_source.lower() for c in CAPTCHA_STR):
            logging.error("Persistent captcha, skip %s", url); return None
    return drv.page_source

#── Collectors ──────────────────────────────────────────────────────────────
async def collect_tps(domain, kw):
    drv = make_driver(); hits={}
    try:
        for k in kw:
            if len(hits)>=MAX_LOOKUPS: break
            page = await safe_page(drv, f"https://www.truepeoplesearch.com/resultname?name={k}")
            if not page: continue
            elems = drv.find_elements(By.CSS_SELECTOR, ".card.card-body")[:MAX_LOOKUPS]
            for e in elems:
                email = next((l for l in e.text.splitlines() if "@" in l and domain in l.lower()), None)
                if not email: continue
                tid = hashlib.sha1(email.encode()).hexdigest()[:12]
                if tid in hits: logging.warning("Collision %s", email)
                hits[tid] = {"target_id":tid,"email":email.lower(),"phone":None,"tags":["tps",k],"src":"TPS","ts":datetime.utcnow().isoformat()+"Z"}
            nap(3,5)
    finally:
        shutil.rmtree(drv.profile_path, ignore_errors=True)
        drv.quit()
    return hits

async def collect_pff(domain):
    drv = make_driver(); hits={}
    try:
        page = await safe_page(drv, "https://www.peoplefinderfree.com/email-search")
        if page:
            pat = re.compile(rf"[A-Za-z0-9._%+-]+@{re.escape(domain)}")
            for email in list(set(pat.findall(page)))[:MAX_LOOKUPS]:
                tid=hashlib.sha1(email.encode()).hexdigest()[:12]
                hits[tid]={"target_id":tid,"email":email.lower(),"phone":None,"tags":["pff"],"src":"PFF","ts":datetime.utcnow().isoformat()+"Z"}
    finally:
        shutil.rmtree(drv.profile_path, ignore_errors=True)
        drv.quit()
    return hits

async def collect_ddg(domain, kw):
    hits={}
    for k in kw:
        tor_newnym(); nap(1,2)
        res = subprocess.run(["torsocks","curl","-sL",f"https://duckduckgo.com/html/?q={k}+@{domain}"], capture_output=True)
        html = res.stdout.decode(errors="ignore")
        for email in list(set(re.findall(rf"[A-Za-z0-9._%+-]+@{re.escape(domain)}", html)))[:MAX_LOOKUPS]:
            tid=hashlib.sha1(email.encode()).hexdigest()[:12]
            hits[tid]={"target_id":tid,"email":email.lower(),"phone":None,"tags":["ddg",k],"src":"DDG","ts":datetime.utcnow().isoformat()+"Z"}
        nap()
    return hits

async def collect_github(domain):
    tor_newnym(); nap(1,2)
    res = subprocess.run(["torsocks","curl","-sL",f"https://github.com/search?q=%40{domain}&type=code"], capture_output=True)
    html = res.stdout.decode(errors="ignore")
    hits={}
    for email in list(set(re.findall(rf"[A-Za-z0-9._%+-]+@{re.escape(domain)}", html)))[:MAX_LOOKUPS]:
        tid=hashlib.sha1(email.encode()).hexdigest()[:12]
        hits[tid]={"target_id":tid,"email":email.lower(),"phone":None,"tags":["gh"],"src":"GitHub","ts":datetime.utcnow().isoformat()+"Z"}
    return hits

#── Gather + Decoys ─────────────────────────────────────────────────────────
async def gather(domain: str, kw: List[str]) -> Dict[str, Dict]:
    merged={}
    for coro in asyncio.as_completed([collect_tps(domain, kw), collect_pff(domain), collect_ddg(domain, kw), collect_github(domain)]):
        merged.update(await coro)
    for i in range(1,4):
        dec=f"decoy-{i}@{domain}"; tid=hashlib.sha1(dec.encode()).hexdigest()[:12]
        merged[tid]={"target_id":tid,"email":dec,"phone":None,"tags":["decoy"],"src":"DEC","leak_marker":True,"ts":datetime.utcnow().isoformat()+"Z"}
    return merged

#── Write Meta + Audit ───────────────────────────────────────────────────────
def write_meta_files(meta: Dict[str, Dict]) -> None:
    for rec in meta.values(): (RAM_DIR/f"{rec['target_id']}.json").write_text(json.dumps(rec, indent=2))
    with (RAM_DIR/"meta.jsonl").open("w") as f:
        for rec in meta.values(): f.write(json.dumps(rec)+"\n")
    sha=hashlib.sha256((RAM_DIR/"meta.jsonl").read_bytes()).hexdigest()
    audit={"meta_sha256":sha,"count":len(meta),"ts":datetime.utcnow().isoformat()+"Z"}
    (RAM_DIR/"audit.json").write_text(json.dumps(audit, indent=2))

#── GPG Encrypt/Cleanup ──────────────────────────────────────────────────────
def gpg_encrypt():
    if not GPG_RECIP: return
    logging.info("Encrypting meta bundle with GPG...")
    tar=RAM_DIR.with_suffix(".tar.gz")
    subprocess.run(["tar","-czf",str(tar),"-C",str(RAM_DIR),"."], check=True)
    out=tar.with_suffix(".tar.gz.gpg")
    subprocess.run(["gpg","--encrypt","--recipient",GPG_RECIP,"-o",str(out),str(tar)], check=True)
    tar.unlink()
    shutil.rmtree(RAM_DIR, ignore_errors=True)

#── Invoke Grabber ──────────────────────────────────────────────────────────
def run_grabber(usb:Path) -> None:
    logging.info("Launching targ_graber_v13 under Tor...")
    try:
        subprocess.run([
            "torsocks","python3","targ_graber_v13.py",
            "--meta",str(RAM_DIR),"--usb",str(usb),"--double-hop","--threads","6"
        ], check=True)
    except subprocess.CalledProcessError as e:
        logging.error("Grabber failed: %s", e); wipe_exit(1)

