        seed_bundle, seed_sha = load_json_secure(args.seed)
    except Exception as e:
        print(f"[!] Failed to load configuration: {e}", file=sys.stderr)
        sys.exit(1)
    
    # Initialize deterministic RNG
    combined_hash = hashlib.sha256(
        (seed_sha + dag_sha + lbl_sha + VERSION + args.intensity).encode()
    ).hexdigest()
    rng_seed = int(combined_hash[:32], 16)
    rng = random.Random(rng_seed)
    
    # Generate noise
    try:
        generator = AdvancedNoiseGenerator(args.tor_proxy, rng, args.intensity)
        events = generator.generate_noise(args.duration)
        
        success_count = sum(1 for e in events if e.success)
        print(f"[+] Generated {len(events)} events ({success_count} successful)")
        
        # Save log if requested
        if args.out:
            event_data = [event.to_dict() for event in events]
            
            log_payload = {
                "version": VERSION,
                "created_utc": datetime.now(tz=timezone.utc).isoformat(timespec="milliseconds"),
                "intensity": args.intensity,
                "duration": args.duration,
                "total_events": len(events),
                "successful_events": success_count,
                "events": event_data,
            }
            
            # Secure atomic write
            tmp_path = args.out.with_suffix(".tmp")
            try:
                with tmp_path.open("w", encoding="utf-8") as f:
                    json.dump(log_payload, f, indent=2, sort_keys=True)
                    f.flush()
                    os.fsync(f.fileno())
                
                tmp_path.replace(args.out)
                print(f"[+] Log saved to {args.out}")
                
            except Exception as e:
                print(f"[!] Failed to save log: {e}", file=sys.stderr)
                if tmp_path.exists():
                    tmp_path.unlink()
        
        generator.session.close()
        
    except KeyboardInterrupt:
        print("\n[!] Interrupted by user")
        sys.exit(1)
    except Exception as e:
        print(f"[!] Error during noise generation: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
