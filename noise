class NoiseEvent:
    def __init__(self, timestamp: str, event_type: str, url: str, 
                 status_code: Optional[int] = None, success: bool = False,
                 response_size: int = 0, duration_ms: int = 0):
        self.timestamp = timestamp
        self.event_type = event_type
        self.url = url
        self.status_code = status_code
        self.success = success
        self.response_size = response_size
        self.duration_ms = duration_ms
    
    def to_dict(self) -> Dict[str, Any]:
        return {
            "timestamp": self.timestamp,
            "type": self.event_type,
            "url": self.url,
            "status": self.status_code,
            "success": self.success,
            "size": self.response_size,
            "duration_ms": self.duration_ms,
        }


class AdvancedNoiseGenerator:
    def __init__(self, proxy_url: str, rng: random.Random, intensity: str = "medium"):
        self.proxy_url = proxy_url
        self.rng = rng
        self.intensity_config = INTENSITY_CONFIGS[intensity]
        self.events: List[NoiseEvent] = []
        self.session = create_session(proxy_url, rng)
        self.circuit_refresh_count = 0
        
    def _make_request(self, url: str, method: str = "GET", data: Optional[Dict] = None) -> NoiseEvent:
        """Make a single request with timing and error handling"""
        start_time = time.time()
        timestamp = datetime.now(tz=timezone.utc).isoformat(timespec="milliseconds")
        
        try:
            if method == "GET":
                response = self.session.get(url, timeout=20)
            elif method == "POST":
                response = self.session.post(url, json=data, timeout=25)
            else:
                raise ValueError(f"Unsupported method: {method}")
            
            duration_ms = int((time.time() - start_time) * 1000)
            response_size = len(response.content) if response.content else 0
            
            return NoiseEvent(
                timestamp=timestamp,
                event_type=f"{method.lower()}_request",
                url=url,
                status_code=response.status_code,
                success=200 <= response.status_code < 400,
                response_size=response_size,
                duration_ms=duration_ms
            )
            
        except Exception as e:
            duration_ms = int((time.time() - start_time) * 1000)
            return NoiseEvent(
                timestamp=timestamp,
                event_type=f"{method.lower()}_request",
                url=url,
                status_code=None,
                success=False,
                duration_ms=duration_ms
            )
    
    def _dummy_crypto_query(self) -> NoiseEvent:
        """Generate cryptocurrency-related queries"""
        url = self.rng.choice(CRYPTO_ENDPOINTS)
        return self._make_request(url)
    
    def _dummy_clearnet_browse(self) -> NoiseEvent:
        """Simulate normal web browsing"""
        url = self.rng.choice(CLEARNET_ENDPOINTS)
        return self._make_request(url)
    
    def _dummy_onion_access(self) -> NoiseEvent:
        """Access onion services"""
        url = self.rng.choice(ONION_ENDPOINTS)
        return self._make_request(url)
    
    def _dummy_api_call(self) -> NoiseEvent:
        """Make fake API calls with POST data"""
        base_urls = [
            "https://httpbin.org/post",
            "https://postman-echo.com/post",
            "https://jsonplaceholder.typicode.com/posts",
        ]
        
        url = self.rng.choice(base_urls)
        fake_data = {
            "id": self.rng.randint(1, 1000),
            "data": secrets.token_hex(self.rng.randint(8, 32)),
            "timestamp": int(time.time()),
        }
        
        return self._make_request(url, method="POST", data=fake_data)
    
    def _refresh_session(self):
        """Refresh session and potentially TOR circuit"""
        self.session.close()
        self.session = create_session(self.proxy_url, self.rng)
        
        # Refresh TOR circuit occasionally
        if self.circuit_refresh_count % 10 == 0:
            if new_tor_circuit():
                time.sleep(2)  # Wait for circuit establishment
        
        self.circuit_refresh_count += 1
    
    def generate_burst(self, num_events: int) -> List[NoiseEvent]:
        """Generate a burst of concurrent requests"""
        actions = [
            self._dummy_crypto_query,
            self._dummy_clearnet_browse,
            self._dummy_onion_access,
            self._dummy_api_call,
        ]
        
        events = []
        threads = []
        results_queue = queue.Queue()
        
        def worker(action_func):
            try:
                event = action_func()
                results_queue.put(event)
            except Exception as e:
                # Create error event
                event = NoiseEvent(
                    timestamp=datetime.now(tz=timezone.utc).isoformat(timespec="milliseconds"),
                    event_type="error",
                    url="unknown",
                    success=False
                )
                results_queue.put(event)
        
        # Start threads
        for _ in range(min(num_events, self.intensity_config["max_concurrent"])):
            action = self.rng.choice(actions)
            thread = threading.Thread(target=worker, args=(action,))
            thread.start()
            threads.append(thread)
        
        # Wait for completion
        for thread in threads:
            thread.join(timeout=30)
        
        # Collect results
        while not results_queue.empty():
            events.append(results_queue.get())
        
        return events
    
    def generate_noise(self, duration_seconds: int) -> List[NoiseEvent]:
        """Generate noise for specified duration"""
        end_time = time.time() + duration_seconds
        events_per_minute = self.intensity_config["events_per_minute"]
        burst_chance = self.intensity_config["burst_chance"]
        
        print(f"[+] Generating noise for {duration_seconds}s at {events_per_minute} events/min")
        
        while time.time() < end_time:
            # Determine if this should be a burst
            if self.rng.random() < burst_chance:
                burst_size = self.rng.randint(3, 6)
                print(f"[*] Generating burst of {burst_size} events")
                burst_events = self.generate_burst(burst_size)
                self.events.extend(burst_events)
                
                # Longer pause after burst
                pause = self.rng.uniform(30, 90)
            else:
                # Single event
                actions = [
                    self._dummy_crypto_query,
                    self._dummy_clearnet_browse,
                    self._dummy_onion_access,
                    self._dummy_api_call,
                ]
                
                action = self.rng.choice(actions)
                event = action()
                self.events.append(event)
                
                # Regular pause
                pause = 60.0 / events_per_minute + self.rng.uniform(-10, 10)
            
            # Refresh session occasionally
            if len(self.events) % 20 == 0:
                self._refresh_session()
            
            # Sleep with jitter
            if time.time() + pause < end_time:
                time.sleep(max(1, pause))
        
        return self.events


