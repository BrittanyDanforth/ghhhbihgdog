def sha256_hex(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def secure_wipe(data: bytearray) -> None:
    """Securely overwrite memory"""
    if data:
        for i in range(len(data)):
            data[i] = secrets.randbits(8)


def load_json_secure(path: Path) -> Tuple[dict, str]:
    """Load JSON with secure error handling"""
    if not path.exists():
        print(f"[!] File not found → {path}", file=sys.stderr)
        sys.exit(1)
    
    try:
        raw = path.read_bytes()
        data = json.loads(raw)
        file_hash = sha256_hex(raw)
        
        # Secure wipe of raw data
        raw_array = bytearray(raw)
        secure_wipe(raw_array)
        
        return data, file_hash
    except json.JSONDecodeError as e:
        print(f"[!] Invalid JSON in {path}: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"[!] Error reading {path}: {e}", file=sys.stderr)
        sys.exit(1)


def validate_proxy(proxy_url: str) -> bool:
    """Validate proxy connectivity and type. Only socks5h:// is safe."""
    if proxy_url.lower().startswith("socks5://") and not proxy_url.lower().startswith("socks5h://"):
        print("[!] CRITICAL: socks5:// leaks DNS. Use socks5h:// instead.", file=sys.stderr)
        return False
    if not proxy_url.startswith(("socks5h://", "http://", "https://")):
        return False
    
    try:
        proxies = {"http": proxy_url, "https": proxy_url}
        response = requests.get("https://check.torproject.org/api/ip",
                                proxies=proxies, timeout=10)
        return response.status_code == 200
    except Exception:
        return False


def create_session(proxy_url: str, rng: random.Random) -> requests.Session:
    """Create configured session with proper retry logic"""
    session = requests.Session()
    
    # Configure retries
    retry_strategy = Retry(
        total=2,
        backoff_factor=1,
        status_forcelist=[429, 500, 502, 503, 504],
    )
    adapter = HTTPAdapter(max_retries=retry_strategy)
    session.mount("http://", adapter)
    session.mount("https://", adapter)
    
    # Set proxy
    session.proxies = {"http": proxy_url, "https": proxy_url}
    
    # Randomize headers
    session.headers.update({
        "User-Agent": rng.choice(USER_AGENTS),
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": rng.choice(["en-US,en;q=0.5", "en-GB,en;q=0.5", "en-CA,en;q=0.5"]),
        "Accept-Encoding": "gzip, deflate",
        "Connection": "keep-alive",
        "Upgrade-Insecure-Requests": "1",
    })
    
    return session


