# ---------------------------------------------------------------------------
#  THE CONFIRMATION NUMBER
# ---------------------------------------------------------------------------
#: A HANDLE IS A BEARER TOKEN AND A RESTART USED TO HAND IT OUT.
#:
#: The vault answers /check and /wait for ANY handle in its file, because it
#: has no idea which chat asked -- chat_id appears nowhere in gs_wake_agent,
#: gs_wake_proto or gs_doorbell, deliberately. So the binding has to live on
#: this box, and it lived in `handle_owner`: a dict in PROCESS MEMORY.
#:
#: gs-telegram-pager.service sets Restart=on-failure. So a crash -- one dropped
#: Tor circuit at the wrong second, one full SD card -- emptied that dict and
#: turned every label in flight back into a bearer token that any allowlisted
#: chat could redeem. The old comment called this "the honest bound: this
#: closes the live case, not the whole namespace", which was true and is not
#: good enough now: with plain_slip on, redeeming somebody else's label returns
#: the deposit address, the amount, and a memo that names the destination
#: Monero address in full.
#:
#: The fix is not to persist the map. A file on the Pi mapping labels to chats
#: is "a record of who asked for what" on the one card this design is built
#: around losing. Instead the binding is CARRIED BY THE LABEL: the chat is
#: shown the handle plus a short MAC over (chat id, handle), and a label only
#: verifies in the chat it was issued to. No state, survives a restart, and a
#: different chat cannot construct one.
#:
#: THE WIRE IS UNCHANGED. The vault still receives four hex characters; the
#: tag is stripped here, after it verifies. Nothing on the vault knows this
#: exists, which is the point -- the Pi holds the chat identity and the vault
#: holds the money, and neither learns the other's half.
CONFIRM_TAG_BYTES = 3

#: `A3F1-9C2B7E`, and the dash is optional so a phone keyboard's autocorrect
#: cannot break it. Case-insensitive on input, upper on output.
CONFIRM_RE = re.compile(r"([0-9A-Fa-f]{4})-?([0-9A-Fa-f]{6})\Z")


def _confirm_key(key: dict) -> bytes:
    """The MAC key for confirmation numbers. Raises if this box cannot make one.

    DOMAIN-SEPARATED FROM THE PAIRING SECRET IT IS DERIVED FROM. The Pi's
    X25519 secret opens M2 and seals M3; using its raw bytes as an HMAC key as
    well would be one secret doing two unrelated jobs, which is how a weakness
    in one becomes a weakness in the other. Hashed with a purpose string, so
    what this holds is a key that is only good for labelling.

    RAISES RATHER THAN DEGRADING. A pager with no usable secret cannot bind a
    label to a chat, and the failure mode of "carry on without the tag" is
    silently reissuing bearer tokens -- the exact defect this exists for.
    main() checks at startup so this can never be the first thing an operator
    hears about it.
    """
    sec = (key or {}).get("secret") or ""
    raw = bytes.fromhex(sec)          # ValueError on anything not hex
    if len(raw) != 32:
        raise ValueError("pairing secret is not 32 bytes")
    return hashlib.sha256(b"gs-pager-confirmation-v1\x00" + raw).digest()


def confirmation_number(key: dict, chat_id: int, handle: str) -> str:
    """The label THIS chat is shown for `handle`. Raises on a bad handle/key."""
    h = (handle or "").strip().upper()
    if not HANDLE_RE.match(h):
        raise ValueError("not a handle")
    tag = hmac.new(_confirm_key(key), f"{int(chat_id)}:{h}".encode(),
                   hashlib.sha256).digest()[:CONFIRM_TAG_BYTES]
    return f"{h}-{tag.hex().upper()}"


def handle_from_confirmation(key: dict, chat_id: int, text: str) -> str:
    """The handle inside a confirmation number, or "". NEVER raises.

    Constant-time on the tag: the comparison is between a value the sender
    chose and one derived from a secret, which is the textbook shape for a
    timing oracle even though the rate limit makes exploiting one absurd here.
    """
    try:
        m = CONFIRM_RE.match((text or "").strip().replace(" ", ""))
        if not m:
            return ""
        h = m.group(1).upper()
        want = confirmation_number(key, chat_id, h).split("-")[1]
        return h if hmac.compare_digest(m.group(2).upper(), want) else ""
    except BaseException:                                    # noqa: BLE001
        return ""

