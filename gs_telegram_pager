def _bucket(t: float, size: int) -> float:
    """Round a wall-clock stamp DOWN to a bucket. 0 stays 0.

    Down rather than nearest, so a stamp never moves into the future -- a
    future last_poke would make the interval gate refuse for longer than it
    should, and a refusal the operator cannot explain is worse than a
    permissive rounding on a limit that is explicitly a courtesy.
    """
    if not t or size <= 1:
        return float(t or 0)
    return float(int(t) // int(size) * int(size))


