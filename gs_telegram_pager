def _menu_button(data: str) -> tuple:
    """One button off the menu, by its callback. Raises on an unknown one.

    SO A LABEL IS SPELT ONCE. Anywhere else that wants to offer "withdraw"
    used to write the words again, and two spellings of one button is how one
    of them stops matching what it does -- this bot has already shipped a
    button reading "What this does" that opened a settings table.

    Deliberately NOT falling back to a made-up label: a KeyError here is a
    typo in this file, caught by the suite, and a plausible-looking wrong
    button is not.
    """
    for _row in MENU_BUTTONS:
        for _b in _row:
            if _b[1] == data:
                return _b
    raise KeyError(data)


def parse_callback(data: str) -> tuple:
    """(text, error) for one tapped button. Never raises.

    Returns the text the typed path would have received, so a tap and a typed
    command reach the identical handler. Refuses anything not in the table.
    """
    d = (data or "").strip()
    if d in CALLBACK_TEXT:
        return CALLBACK_TEXT[d], ""
    # THE DEPTH MENU. The value is checked against the PROTOCOL's own table
    # rather than a range written here, exactly as _depth_from does -- a
    # button offering a depth the vault refuses would spend a wake on a
    # rejection.
    if d.startswith("d:"):
        _n = d[2:]
        # ASCII DIGITS ONLY, THE SAME PREDICATE _depth_from USES.
        # This gate was written with str.isdecimal(), which is True for all
        # 455 Unicode decimal digits, and _depth_from -- the step this text is
        # handed to -- accepts only "0123456789". So "d:１" passed here and
        # was returned VERBATIM as the text the typed path would have got,
        # where _depth_from then read it as None: the tap did nothing and the
        # question came back, with no way for the operator to see why the
        # button they were offered was not accepted. Two gates on one value
        # and the outer one looser than the inner is the shape that produced
        # the fullwidth-BTC-amount bug; this is the same shape, and now the
        # same predicate. int() below cannot raise on an ASCII-digit string.
        if _n and all(c in "0123456789" for c in _n) \
                and int(_n) in proto.WITHDRAW_HOPS:
            return _n, ""
        return "", "that depth is not one this service offers"
    # A HANDLE, and it goes through HANDLE_RE here as well as in
    # parse_command. The button was built from a handle this process minted,
    # so this can only fail on a mangled callback -- which is the case worth
    # refusing rather than passing on to a wake.
    if d[:2] in ("c:", "w:"):
        _h = d[2:].upper()
        # EITHER FORM, AND NEITHER IS TRUSTED HERE. This only checks the
        # SHAPE; whether a confirmation number belongs to the chat that tapped
        # it is decided in handle(), against that chat's own MAC, exactly as
        # it is for a typed one. The button is a convenience, never a bypass.
        if not (CONFIRM_RE.match(_h) or HANDLE_RE.match(_h)):
            return "", "that is not a confirmation number"
        return f"{'/check' if d[0] == 'c' else '/wait'} {_h}", ""
    return "", "I do not know that button"


