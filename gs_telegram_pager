POLL_HOLD_S = 10

#: FAIL-CLOSED IS NOT ONLY A STARTUP PROPERTY.
#:
#: §4 says "If Tor is down, the bot does not start" -- and the first version
#: enforced that at startup and then, if Tor died an hour later, sat in a
#: 5-second retry loop forever. That is fail-OPEN in the only way that
#: matters: the operator believes a poke will work, and the bot has quietly
#: been unable to reach anything since. Consecutive failures are counted and
#: the process exits, so systemd's Restart= re-runs the startup verify_tor and
#: the bot stays down until Tor is genuinely back.
#:
#: Not 1: a single blip on a Tor circuit is ordinary and must not stop a
#: pager. At 5 s a retry this is about a minute of sustained failure.
MAX_POLL_FAILURES = 12

#: Seconds before the ONE retry of a sealed slip that did not send. Long enough
#: for a Tor circuit to be rebuilt, short enough that it does not hold `busy`
#: -- and therefore the next poke -- for anything an operator would notice.
SLIP_RETRY_S = 20

# ---------------------------------------------------------------------------
#  THE /depo WIZARD
#
#  `/depo 2` works and always will. This exists because "2" is a number an
#  operator has to remember the meaning of, and the one command in this bot
#  that spends the wake budget and quotes real money should not be a single
#  unconfirmed keystroke away.
#
#  WHAT IT CANNOT DO, BY CONSTRUCTION RATHER THAN BY DISCIPLINE.
#
#  The wizard asks for a ladder SLOT and never for an amount, and it could not
#  offer amounts if it wanted to: the ladder lives in the ThinkPad's keyfile
#  and the Pi's holds secret, peer_public, target_mac, wol_broadcast, wol_port,
#  listen_host and listen_port -- no ladder, no amounts. So this box can say
#  "slot 2" and is structurally incapable of saying "0.05". That is the
#  property, not a rule someone has to keep following.
#
#  What reaches the wire after all the conversation is byte-identical to what
#  `/depo 2` produces today: ("receive_and_quote", {"amount_slot": N}). No new
#  job, no new schema field, no new keyfile field, so no re-pairing and no
#  half-upgraded pair.
#
#  IN MEMORY, NEVER ON THE CARD. The --state file holds Limits and lives on the
#  same SD card as the sealed keyfile; a half-finished /depo does not belong
#  there. A restart drops every conversation, which is the correct loss: the
#  operator retypes two characters.
# ---------------------------------------------------------------------------

