#: gs_doorbell, loaded ONCE, BY PATH.
#:
#: Python cannot `import gs_doorbell`: the shipped tools are extensionless on
#: purpose -- they are commands, not modules -- so the import system will not
#: find one by name. Driving this end to end is how that turned up; tests/ load
#: them the same way. Cached because two loads would mean two module objects
#: with two copies of its state.
_DOORBELL = [None]


def doorbell():
    import importlib.machinery
    import importlib.util
    if _DOORBELL[0] is None:
        path = str(Path(__file__).resolve().parent / "gs_doorbell")
        ld = importlib.machinery.SourceFileLoader("gs_doorbell", path)
        spec = importlib.util.spec_from_loader(ld.name, ld)
        mod = importlib.util.module_from_spec(spec)
        sys.modules.setdefault("gs_doorbell", mod)
        ld.exec_module(mod)
        _DOORBELL[0] = mod
    return _DOORBELL[0]


#: Every character a terminal treats as an instruction rather than as text.
#: C0, DEL and C1 -- the last of these matters because a lone 0x9b IS a CSI
#: introducer on a terminal in 8-bit mode, so stripping only ESC would leave a
#: working escape sequence behind.
_CTRL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def _no_ctrl(text: str) -> str:
    """Remove control characters. NOT what terminal_safe does.

    terminal_safe redacts IDENTIFIERS -- addresses, MACs, bech32, paths -- and
    passes control characters through untouched, which is correct for its job
    and not enough for this one. A Telegram username is a string its owner
    chose, and anyone can message a bot they find; --whoami prints one to a
    terminal and, under systemd, to a journal. Measured before this existed:
    terminal_safe("a\\x1b[31mb\\x07c") returns it unchanged, escape and bell
    intact. gs_unseal hit the same gap from the other direction and uses
    instruction_field_safe to REFUSE; here the value is cosmetic, so it is
    stripped and the chat id still gets printed.
    """
    return _CTRL_RE.sub("", str(text))


def _redact(text: str) -> str:
    """Strip anything token-shaped out of a string before it is printed.

    Telegram puts the bot token in the URL PATH -- there is no header form --
    so the token is inside every request URL and therefore inside the text of
    any exception requests raises about one. This runs over everything that
    reaches a terminal or the journal.
    """
    out = re.sub(r"\bbot\d{6,}:[A-Za-z0-9_-]{20,}", "bot<token>", str(text))
    out = re.sub(r"\b\d{6,}:[A-Za-z0-9_-]{20,}", "<token>", out)
    # AND THE LAN ADDRESSES, because this runs over text that reaches the CHAT
    # and not only the journal. gs_doorbell refuses a bind with
    # f"cannot listen on {listen_host}:{listen_port} ({e.strerror})", and poke()
    # forwards that exception straight to Telegram -- so a Pi whose port was
    # already in use published its own listen address into the transcript.
    #
    # A host:port is the shape, whatever the host looks like: an IPv4 literal,
    # "0.0.0.0", a hostname. Replaced rather than dropped so the operator
    # reading the journal still sees that a bind was the problem.
    out = re.sub(r"\b(?:\d{1,3}(?:\.\d{1,3}){3}|[A-Za-z0-9](?:[A-Za-z0-9-]"
                 r"*[A-Za-z0-9])?(?:\.[A-Za-z0-9-]+)*):\d{1,5}\b",
                 "<host:port>", out)
    # An exception's text is not always this program's words: a server can
    # shape a chunk of it, and requests puts response detail into some of
    # them. Same one-line rule as the username, for the same reason.
    return _no_ctrl(terminal_safe(out))


def load_token(token_file: str = "") -> str:
    """The bot token, from the environment or a 0400 file. NEVER from argv."""
    v = os.environ.get(TOKEN_ENV, "")
    if v:
        return v.strip()
    if token_file:
        p = Path(token_file)
        try:
            st = p.stat()
        except OSError as e:
            sys.exit(f"[!] --token-file {p}: {e.strerror}")
        if st.st_mode & 0o077:
            sys.exit(
                f"[!] {p} is mode {oct(st.st_mode & 0o777)}. A bot token that "
                f"other local accounts can read is a token they can use to "
                f"wake your vault. chmod 400 it.")
        return p.read_text(encoding="utf-8").strip()
    sys.exit(
        f"[!] No bot token. Set {TOKEN_ENV} in this process's environment, or "
        f"pass --token-file pointing at a 0400 file.\n"
        f"    NOT on the command line: /proc/<pid>/cmdline is world-readable, "
        f"so a token there is readable by every local account.")


class Limits:
    """Rate state that survives a restart, so a crash loop is not a bypass."""

    def __init__(self, path: Path, min_interval: int, daily_cap: int):
        self.path = path
        self.min_interval = min_interval
        self.daily_cap = daily_cap
        self.offset = 0            # Telegram update_id cursor
        self.last_poke = 0.0
        self.pokes = []            # wall-clock stamps, pruned to 24 h
        self._load()

    def _load(self) -> None:
        try:
            d = json.loads(self.path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return
        if not isinstance(d, dict):
            return
        self.offset = int(d.get("offset") or 0)
        self.last_poke = float(d.get("last_poke") or 0)
        self.pokes = [float(x) for x in (d.get("pokes") or [])
                      if isinstance(x, (int, float))]

    #: Stamps are rounded to this before they touch the card.
    #:
    #: This file is the ONE thing the pager persists, and it sat on the SD card
    #: holding a float per poke: the exact second the operator asked for a
    #: quote, for every quote in the last 24 hours. Anyone who images the card
    #: reads a timetable of when its owner was awake and moving money -- and
    #: they read it to the microsecond.
    #:
    #: Five minutes is coarser than anything the file is FOR: the interval gate
    #: defaults to 300 s and the cap counts a 24-hour window, so a stamp good
    #: to five minutes answers both. It cannot be zero-cost -- rounding can let
    #: a poke through up to one bucket early -- and that is a courtesy limit
    #: whose own docstring says the real bound is the vault's keyfile.
    STAMP_BUCKET_S = 300

    def save(self) -> None:
        atomic_write_json(
            {"offset": self.offset,
             "last_poke": _bucket(self.last_poke, self.STAMP_BUCKET_S),
             "pokes": [_bucket(t, self.STAMP_BUCKET_S)
                       for t in self.pokes[-200:]]},
            self.path, perms=0o600)

    def recent(self) -> list:
        now = time.time()
        self.pokes = [t for t in self.pokes if now - t < 86400]
        return self.pokes

    def why_not(self) -> str:
        """'' if a poke is allowed, else the reason to send back."""
        now = time.time()
        gap = now - self.last_poke
        # THESE ARE CHAT TEXT. why_not()'s return value is sent verbatim --
        # `self.send(cid, f"no: {why}")` -- so it belongs to the transcript,
        # and it did not look like it: a source scan for literals at send()
        # call sites cannot see a string that arrives through a variable. This
        # one named the operator's machine AND described the wake budget that
        # protects it ("the vault's own 24h budget is the real one"), which is
        # a sentence about the architecture in the readable surface, on the
        # message an operator sees most often after a mistyped command.
        #
        # "wait Ns" is the whole of what they can act on.
        if gap < self.min_interval:
            return f"wait {int(self.min_interval - gap)}s"
        if len(self.recent()) >= self.daily_cap:
            return "daily limit reached"
        return ""

    def record(self) -> None:
        now = time.time()
        self.last_poke = now
        self.pokes.append(now)
        self.save()


def parse_command(text: str) -> tuple:
    """(job, params, error). Digits only -- never a destination, never a flag.

    Telegram message text is attacker-controlled the moment the phone or the
    token is: this reads a fixed vocabulary and a bounded integer and refuses
    everything else, rather than passing anything through to a command line.
    Nothing here can name an XMR address, because no job accepts one.
    """
    raw = (text or "").strip()
    # A command may arrive as "/depo@mybot 2" in a group.
    parts = raw.split()
    if not parts:
        return "", {}, "empty"
    cmd = parts[0].split("@", 1)[0].lower()
    arg = parts[1] if len(parts) > 1 else ""
    if len(parts) > 2:
        return "", {}, "too many arguments"

    # /start IS NOT /help, AND ON TELEGRAM IT IS THE ONE MESSAGE EVERY USER
    # SENDS. It is what the blue Start button sends, it is the first thing
    # anybody ever sends a bot, and it was answered with a bare list of eleven
    # slash-commands -- the reply of a command line, to somebody who has not
    # been told what the thing IS yet.
    #
    # A DEEP-LINK PAYLOAD IS IGNORED, NOT REFUSED. Telegram sends
    # "/start <payload>" when a user arrives through a t.me link, so `arg` can
    # be non-empty on the one command that must never fail. It is dropped:
    # nothing here takes a parameter from a link, and refusing would turn the
    # first message of every deep-linked session into an error.
    if cmd == "/start":
        return "", {}, "welcome"
    if cmd == "/help":
        return "", {}, "help"
    if cmd == "/status":
        return "", {}, "status"
    # /address IS GONE, AND THE OLD SPELLINGS WITH IT.
    #
    # It minted a Monero subaddress to be paid into directly -- an entry point
    # for somebody who already holds XMR. Nothing here swaps XMR to BTC, so it
    # was half a feature: it could take money in and had no way to say where.
    # Both slip builders returned empty on it by construction, so the command
    # whose whole purpose was to hand over an address delivered none, on every
    # configuration; and both watching jobs refused its handle, so /check and
    # /wait on one spent a wake to be told no.
    #
    # ANSWERED, NOT IGNORED. An operator with the word in their fingers gets a
    # sentence rather than "unknown command", which reads as a broken bot.
    if cmd in ("/address", "/addr", "/receive", "/recv"):
        # SILENCE, LIKE ANY OTHER COMMAND THIS BOT DOES NOT HAVE.
        #
        # This used to answer "/address is gone -- nothing here swaps Monero
        # to Bitcoin, so it could take money in and never say where." Two
        # things wrong with that. It puts an explanation of the toolchain's
        # SHAPE into the readable surface, which is the thing every other
        # reply is scrubbed of; and it is a reply, which is a POST from the Pi
        # over Tor for a command that does not exist. Retired spellings are
        # not a special case worth either cost.
        return "", {}, IGNORE
    # ONE COMMAND, SEVERAL SPELLINGS. "depo" was the only name and it is not a
    # word: nobody who had not read the source knew what it did. The long form
    # is what the menu advertises; the short ones keep working because they are
    # already in an operator's muscle memory and a bot that answers "unknown
    # command" to its own old name is a bot that looks broken.
    if cmd in ("/deposit", "/depo", "/dep"):
        # THE WIZARD IS THE ONLY FORM NOW.
        #
        # `/depo 2` used to work in one shot, on the reasoning that the wizard
        # exists for the operator's convenience and not because the short form
        # is wrong. It IS wrong, for two reasons that only show up in a
        # transcript and under a thumb:
        #
        #   * "/depo 2" is one keystroke away from a wake and a real quote. The
        #     confirm step is the whole reason the wizard was written, and a
        #     second door beside it that skips the confirm makes the confirm
        #     optional -- which is the same as not having one.
        #   * It puts the digit in the transcript ATTACHED to the word, on one
        #     line, permanently. The wizard's answer is a bare "2" on its own,
        #     which says nothing by itself.
        #
        # Any argument at all is refused rather than ignored: silently
        # dropping it would run a DIFFERENT slot from the one typed.
        if arg:
            return "", {}, "just /depo — it asks"
        return "", {}, "depo_wizard"
    # /withdraw IS THE PUBLISHED SPELLING NOW, and /send is the alias rather
    # than the other way round. "Send" does not say which direction the money
    # goes; on a tool whose other two commands both bring money IN, it read to
    # at least one operator as another way to pay in.
    if cmd in ("/withdraw", "/send"):
        # SAME RULE AS /depo, and here it matters more: an argument would be
        # the destination address typed on the same line as the word, which
        # puts it in the transcript attached to the command and skips the
        # confirm before a job that SPENDS.
        if arg:
            return "", {}, "just /withdraw — it asks"
        return "", {}, "withdraw_wizard"
    if cmd in ("/cancel", "/stop"):
        return "", {}, "cancel"
    # THE THREE QUESTIONS THAT ARE NOT KNOBS. Each answers where the thing is
    # really decided, rather than offering a control wired to nothing. See
    # FEE_ANSWER / SPEED_ANSWER / EXIT_ANSWER for why each is not settable.
    if cmd == "/settings":
        return "", {}, "settings"
    if cmd == "/fee":
        return "", {}, "fee"
    if cmd == "/speed":
        return "", {}, "speed"
    if cmd == "/exit":
        return "", {}, "exit"
    if cmd in ("/wait", "/watch", "/check"):
        _job = "swap_status" if cmd == "/check" else "watch"
        # NO ARGUMENT IS A QUESTION, NOT A MISTAKE.
        #
        # This answered "handle must be 4 hex characters" -- which uses a word
        # the chat says nowhere else, about a thing it never showed them how
        # to find, in reply to somebody who almost certainly meant "is
        # anything happening?". handle() answers that from what this process
        # knows, and says plainly when the answer is nothing.
        if not arg:
            return "", {}, "whats_running"
        # THE TEXT, NOT A HANDLE. Which four hex characters this names cannot
        # be decided here: a confirmation number only means something in the
        # chat it was issued to, and parse_command is module-level and has
        # neither the chat nor the key. handle() resolves it and puts the bare
        # handle on the wire.
        if not (CONFIRM_RE.match(arg) or HANDLE_RE.match(arg)):
            return "", {}, ("that is not a confirmation number. It looks like "
                            "A3F1-9C2B7E and it is in the message that "
                            "started the deposit — or just /check on its own "
                            "and I will say what is running.")
        return _job, {"confirmation": arg.strip()}, ""
    # A BARE MESSAGE IS NOT A COMMAND THIS BOT DOES NOT KNOW -- it is an
    # ANSWER WITH NO QUESTION, and telling somebody their answer is an unknown
    # command is how this reads as broken.
    #
    # handle() routes text to the live conversation FIRST, so anything
    # reaching here has no conversation waiting for it. The commonest way to
    # get here is the sequence driven in _convo_step: a command dropped the
    # wizard, and the operator then typed the amount or pasted the address the
    # wizard had asked for. "unknown command" describes neither.
    #
    # NO ECHO. Whatever they typed may be an amount or an address; naming it
    # back would put it in the transcript for something that is not going to
    # happen, which is the same rule the amount parser's own refusal follows.
    if not cmd.startswith("/"):
        return "", {}, ("nothing here is waiting for an answer. /deposit to "
                        "pay in, /withdraw to be paid out.")
    # AN UNKNOWN COMMAND GETS NOTHING.
    #
    # It used to get "no: unknown command". Every reply is a POST from the Pi,
    # over Tor, on a box whose whole job is to be reachable -- and the menu is
    # published, so a "/" in Telegram autocompletes the real ones. What
    # answering buys is telling somebody who typed a command this bot does not
    # have that it is alive and listening, which is the same disclosure an
    # unallowlisted chat is already refused for.
    #
    # THE BARE-MESSAGE BRANCH ABOVE STAYS. That is an ANSWER WITH NO QUESTION
    # -- somebody typing the amount a dropped wizard asked for -- and telling
    # them their answer is an unknown command is how this reads as broken.
    # They are asking for something; this branch is a typo.
    return "", {}, IGNORE


class Convo:
    """One chat's half-finished /depo. Process memory only, never a file.

    ONE TEXT FIELD, AND IT IS NAMED, and that is a weakening of what this
    used to say. The rule was "not one string among them" -- a struct that
    cannot hold an address however the prompts around it are later edited.
    /withdraw needs to hold destinations, because the operator types them into
    the chat and they have to survive until the confirm.

    So the rule becomes the narrower thing it was always FOR: one named field,
    `exit_to`, holding ONLY values the protocol's address gate has already
    accepted, and NOTHING here reaches disk -- Limits.save writes the cursor
    and the counters and this object is not in it. Both halves are asserted in
    tests/test_depo_wizard.py; the second was always the real invariant and the
    first was the cheap way to enforce it.

    IT IS A LIST OF ADDRESSES NOW, not one, and the count is the point rather
    than a convenience. The exit relays one transaction per mixed output, so a
    single destination collects every arrival the run spent hours separating --
    see _exit_question. proto's field returns a list of 1..MAX_WAKE_EXIT_DESTS
    and that list is what is stored, so the "already checked" half is unchanged:
    every element came back from the same gate, and a list of strings the gate
    accepted is no more free text than one was.

    What it still cannot hold: a memo, a slip, an amount, or free text of any
    other shape. `exit_to` is set in exactly one place, from a value
    proto's address field has already accepted.

    `step` is DERIVED, not stored, per kind: a depo awaits its amount iff
    amount is None; a withdraw awaits its address iff exit_to is None and then
    its depth iff depth is None. That is not brevity -- it makes "at the
    confirm step with nothing to confirm" unrepresentable rather than merely
    untested.

    THE TWO NUMBERS ARE INTS, deliberately, and that is what lets the one-
    string rule survive them. `amount` is a count of SATOSHIS and `depth` is a
    key of proto.WITHDRAW_DEPTHS; neither is a decimal string, so neither can
    carry "1e9", a locale comma, or free text wearing a number's clothes. The
    parsing happens once, at the step that reads it, and what survives into
    this struct is already an integer or the conversation is already dead.
    """

    __slots__ = ("kind", "amount", "depth", "handle", "exit_to", "expect",
                 "deadline", "tries")

    def __init__(self, clock, kind="depo"):
        self.kind = kind
        self.amount = None
        self.depth = None
        self.handle = None
        self.exit_to = None
        self.expect = None
        #: Unrecognised answers spent at the ONE step that re-asks instead of
        #: cancelling. Counted rather than unbounded because every re-ask
        #: writes another line into a transcript this tool cannot delete, so
        #: "how many lines can one confused minute add" should be a number
        #: somebody chose rather than a function of how fast the phone types.
        self.tries = 0
        #: ABSOLUTE, from creation, and never refreshed by an answer. A
        #: per-step refresh puts no upper bound on total lifetime -- a chat
        #: answering every 179 s keeps an entry alive for ever, which is
        #: precisely the "half-finished command sitting for ever" this exists
        #: to prevent. The cost of being slow is retyping two characters.
        self.deadline = clock() + CONVO_TTL_S

    def alive(self, clock) -> bool:
        return clock() < self.deadline

    def awaiting_amount(self) -> bool:
        return self.kind == "depo" and self.amount is None

    def awaiting_address(self) -> bool:
        return self.kind == "withdraw" and self.exit_to is None

    def awaiting_depth(self) -> bool:
        # ORDERED, and the address gate comes first: both are None at the
        # start of a /send, so asking these in the wrong order would ask for a
        # depth before there is anywhere to send it.
        return (self.kind == "withdraw" and self.exit_to is not None
                and self.depth is None)


def _confirm_question(rng):
    """A small sum. Returns (text, expected_int).

    FREE-FORM, NOT MULTIPLE CHOICE. Offering three options made a wrong answer
    a one-in-three guess, which is the only sense in which the number of
    choices meant anything -- and it is no easier for the operator to pick from
    a list than to type a sum they can already do. Typing the answer costs the
    same and is not guessable.

    SystemRandom for the same reason everything else here uses it: this is a
    one-shot value and there is no reason to draw it from a predictable stream,
    even for something explicitly not load-bearing.
    """
    a, b = rng.randrange(2, 10), rng.randrange(2, 10)
    return f"{a} + {b} = ?   reply with the answer", a + b


class Pager:
    def __init__(self, args, token: str, key: dict, proxies: dict):
        self.args = args
        self.token = token
        self.key = key
        self.proxies = proxies
        self.limits = Limits(Path(args.state), args.min_interval,
                             args.daily_cap)
        self.allow = set(int(c) for c in args.chat_id)
        #: Allowlisted SENDERS, or empty for "whoever is in an allowlisted
        #: chat". Empty is only reachable when every allowlisted chat is
        #: private, because main() refuses a group without one -- see the
        #: --user-id help and the refusal in main().
        self.allow_users = set(int(u) for u in (getattr(args, "user_id", None)
                                                or ()))
        #: handle -> the chat that created it. IN MEMORY, like convos and burn:
        #: see the note where it is written for why the vault cannot hold this
        #: and why the SD card must not.
        self.handle_owner = {}
        #: WHICH JOB MINTED EACH LABEL, for the one question the vault answers
        #: with a certainty this box could have had for free.
        #:
        #: /check and /wait are refused on the vault for any handle whose
        #: record carries no swap quote ("Only a receive_and_quote handle can
        #: be watched"), and receive_new records slip=None ALWAYS -- it mints
        #: an address and quotes nothing. So every /address label is
        #: permanently unwatchable, and asking costs a magic packet, a boot, a
        #: 5-20 minute jitter and one of twelve daily wake slots to be told so.
        #:
        #: Process memory, like handle_owner and convos and for the same
        #: reason: the SD card is the leak this box is designed around. A
        #: restart empties it and the refusal simply stops firing, which is the
        #: same honest bound handle_owner already documents.
        self.handle_job = {}
        #: When /status last answered, or None for never. Process memory,
        #: like everything else here: a restart clears it, which costs one
        #: extra reply and nothing else.
        #: WHEN EACH CHAT WAS LAST ANSWERED, or absent. A dict rather than
        #: one float: see the /status branch. Absent is NOT the same as zero --
        #: self.clock is time.monotonic, which counts from an arbitrary point,
        #: so on a freshly booted Pi a zero default puts the FIRST /status
        #: inside its own cooldown and swallows it.
        self._status_at = {}
        #: WHICH CHAT HOLDS THE JOB, or None. Not a second copy of `busy`:
        #: busy is a lock and answers "is anything running", which is not a
        #: question one chat may ask about another. This answers "is MINE
        #: running", and is compared against a cid before anything is said.
        self._running = None
        #: (chat_id, params, leg) for the next leg of a chained withdrawal, or
        #: None. Set by poke() when the vault says another arrival is here;
        #: acted on by _worker AFTER it releases `busy`, because start_job
        #: takes that lock and poke() is still holding it.
        self._chain = None
        #: Which leg of a chained withdrawal is running. Set by start_job, so
        #: it is in place before the worker thread reads it and cannot be
        #: cleared by the slot handover. A fresh /withdraw passes leg=0.
        self._chain_leg = 0
        #: HOW MANY PEOPLE CAN SPEND. Senders where there are senders, chats
        #: otherwise -- a private chat id is a Telegram ACCOUNT, and Telegram
        #: gives one account one chat with a given bot however many devices it
        #: is signed in on, so a second one is a second person.
        #:
        #: main() refuses to start above 1. This exists so start_job can
        #: refuse too: that is the only path to a wake, it is the code closest
        #: to the money, and it cannot be reached by constructing a Pager some
        #: other way. One wallet, one person -- checked where it is spent as
        #: well as where it is configured.
        self.spenders = len(self.allow_users) or len(self.allow)
        self.busy = threading.Lock()
        self.ignored = 0
        self.poll_failures = 0
        #: chat_id -> Convo. IN MEMORY. Never written to args.state: that file
        #: is Limits and sits on the SD card next to the sealed keyfile.
        self.convos = {}
        self.clock = time.monotonic
        self.rng = random.SystemRandom()
        #: (chat_id, message_id, wall_clock_sent) for every message this
        #: process has put in a chat -- ITS OWN REPLIES AND THE OPERATOR'S
        #: COMMANDS -- that it may still be able to delete.
        #:
        #: IN MEMORY, like convos and for the same reason: the SD card is the
        #: leak this whole box is designed around, and a list of message ids
        #: with timestamps is a log of exactly when the operator was active.
        #: A restart drops it, which loses the ability to burn what was already
        #: sent -- the correct direction to lose in, since the alternative is
        #: writing that log down.
        #:
        #: WALL CLOCK, not self.clock. self.clock is time.monotonic, which is
        #: the right thing for conversation deadlines and the wrong thing here:
        #: Telegram's 48-hour deletion window is measured against real time, so
        #: a monotonic reading cannot be compared to it.
        self.burn = []
        #: Seconds a message may stay in the chat before this deletes it.
        #: 0 disables, which is the default: a bot that silently removes the
        #: operator's own messages would be a surprise, and the surprise lands
        #: on the one channel they use when they cannot reach the machine.
        self.burn_after = int(getattr(args, "burn_after", 0) or 0)
        #: Set by SIGUSR1; cleared by the poll loop when it has acted. See
        #: arm_burn for why the trigger is a signal and not a chat command.
        self.burn_now = False

    # -- the /depo wizard -----------------------------------------------
    def _reap(self) -> None:
        """Drop expired conversations. Called before any use of the dict.

        Cheap and unconditional rather than on a timer, because the dict is
        touched only on an allowlisted message and is capped at MAX_CONVOS.
        """
        dead = [c for c, v in self.convos.items() if not v.alive(self.clock)]
        for c in dead:
            del self.convos[c]

    def begin_convo(self, chat_id: int, kind: str = "depo") -> None:
        self._reap()
        # DO NOT START ONE THAT CANNOT FINISH.
        #
        # A wake holds `busy` for up to result_budget_s + the doorbell's
        # pre-WOL ceiling -- 60300 s for a withdrawal, nearly seventeen hours
        # -- and a conversation lives CONVO_TTL_S, 180 s. So a conversation
        # begun while a job runs is GUARANTEED to expire before the lock frees.
        # Without this the operator walks the whole wizard over Tor -- two
        # round trips on a phone -- to be told "a wake is already running" at
        # the end, having achieved nothing.
        #
        # THE NUMBER USED TO BE WRITTEN HERE AS 9900 s, which was the longest
        # NON-spending job and stopped being the ceiling the moment `withdraw`
        # existed. It is left out of the sentence now rather than restated,
        # because a hand-copied duration in a comment is a thing that goes
        # stale silently; start_job computes the real one and tells the
        # operator, which is where the figure belongs.
        #
        # Advisory only: it creates nothing, charges nothing and reserves
        # nothing, and start_job re-checks both authoritatively at the poke.
        # The strings are the same ones `/depo 2` already answers with, so the
        # two paths cannot drift into describing the same refusal differently.
        if self.busy.locked():
            self.send(chat_id, BUSY_ANSWER)
            return
        why = self.limits.why_not()
        if why:
            self.send(chat_id, f"no: {why}")
            return
        # BOUNDED. The dict is keyed by chat_id and only an allowlisted chat
        # ever reaches here, so len(convos) <= len(allow) is already
        # structural. MAX_CONVOS is the second bound, and it is a BUG DETECTOR
        # rather than a policy: if it ever fires, something is creating
        # conversations that nothing is clearing.
        if (chat_id not in self.convos) and len(self.convos) >= MAX_CONVOS:
            integrity_log("pager", "convo_cap_hit")
            self.send(chat_id, "no: too many conversations in flight. Try "
                               "again in a few minutes.")
            return
        self.convos[chat_id] = Convo(self.clock, kind=kind)
        if kind == "withdraw":
            # STRAIGHT TO THE ADDRESS. This used to ask for a 4-character
            # handle first -- the label of a bundle a /depo had minted -- so a
            # withdrawal was only possible for money that arrived through this
            # tool's own deposit flow, and the operator had to remember which
            # label named which pile. The vault finds its own funded output
            # now; the only thing the operator actually has to decide is where
            # it goes.
            # A CANCEL BUTTON AND NOTHING ELSE. The answer to this question is
            # a Monero address, which no button can carry -- and one that
            # could would be this bot offering to spend to an address it chose,
            # which is the thing the whole design refuses. So the tappable part
            # is the way OUT, which is the part an operator standing in a
            # street with a half-typed address actually needs.
            self.send(chat_id, self._exit_question(),
                      buttons=[[("Cancel", "m:cancel")]])
            return
        self.send(chat_id, self._amount_question(),
                  buttons=[[("Cancel", "m:cancel")]])

    def _exit_question(self) -> str:
        """Where the withdrawal goes -- and that it may go to more than one place.

        THIS USED TO SAY "Reply with the address", SINGULAR, AND THAT WAS THE
        WHOLE PROBLEM. GhostSpiral's exit relays ONE TRANSACTION PER OUTPUT. A
        withdrawal funds `wallets + randint(DECOY_MIN, DECOY_MAX)` of them, so
        at the three depths this service offers the floor is 5, 12 and 22
        separate arrivals -- and with one destination every one of them lands
        on the same address, minutes apart, from a wallet that just spent hours
        making sure they could not be grouped.

        resolve_exit_destinations says exactly that, and says it is a warning
        rather than a refusal because "one destination is a legitimate choice:
        an exchange deposit address is one address and cannot be spread. The
        operator has to be told what it costs, not overruled." It prints that
        onto the vault's stdout -- which the unit diverts to a 0600 file on a
        machine that powers off. On the phone path it has never been read by
        anyone, and the wire could not have carried a second address anyway.

        So the choice is offered HERE, where the operator is, with the cost
        attached. The count is the protocol's own floor for the shallowest
        depth, so the sentence is true whichever depth they pick next.

        THE SEPARATOR IS THE ONE THE REST OF THE TOOLKIT USES: whitespace or
        commas, the same split resolve_exit_destinations applies to GS_EXIT_TO.
        One message, not one per address -- every message is a line in a
        server-side transcript this tool cannot delete, and asking N times
        would write N of them.
        """
        # NO ARRIVAL COUNT IS COMPUTED HERE ANY MORE, and the line that did
        # was left behind by the edit that stopped printing it -- a value
        # derived, held, and used by nothing, which is the shape a reader
        # mistakes for a fact the message still states.
        # SHOW THE SHAPE, THEN SAY THE ONE THING THEY CANNOT WORK OUT.
        #
        # This was three sentences of reasoning and no example. The reader has
        # to produce a Monero address -- so the fastest thing this can do is
        # show one, name it, and stop. WHY several is better is a real fact
        # they cannot guess and it stays, in one clause instead of a sentence.
        return (f"Where do you want it? Send a Monero address:\n"
                f"  4AdX...9kPq\n\n"
                f"Several is better — up to {proto.MAX_WAKE_EXIT_DESTS}, "
                f"separated by spaces. It arrives as many separate payments, "
                f"and one address collects them all where anyone can group "
                f"them.\n"
                f"/cancel to stop.")

    def _settings_text(self) -> str:
        """What a run does, and who decides each part.

        THE MISSING HALF OF THE CONSOLE. The web console exposes two dozen
        settings; the chat exposed none of them and said nothing about them
        either -- so an operator on a phone had no way to know what a run
        would be, only that one had started.

        IT SHOWS, IT DOES NOT SET, and that is a design rather than an
        omission. Every value here lives in the vault's keyfile because a chat
        message that could change the mixing depth is a chat message that
        could WEAKEN it, and the one thing a stolen phone must not be able to
        do is turn the mixing down. Naming where each one lives is what makes
        the difference: the operator sees what will happen and knows which box
        to go to.

        NOTHING IS FETCHED. The budget and the cap are already on this box;
        the ladder, the depth and the destination are not, and a /settings
        that woke the vault would spend a wake to answer a question.
        """
        lines = ["What a run does, and who decides it.", ""]
        lines.append("You choose, per job:")
        # NO FIGURES, and the bounds are deliberately not printed here even
        # though they are a constant of the software rather than anything
        # about this operator. tests/test_depo_wizard.py asserts that no
        # decimal appears in this reply, and the honest way past a check like
        # that is not to loosen it: /deposit states the range at the moment it
        # asks, which is when the operator needs it, and /settings is read at
        # times when a number in the transcript buys nothing.
        lines.append("  deposit amount  in BTC, typed at /deposit")
        # DRAWN FROM THE TABLE, not listed here. A second hand-written copy of
        # the depth menu is a second thing to forget to update, and this one
        # would be wrong in the direction that reads as authoritative.
        #
        # HOPS, AND IT SAID KEYS. This printed "1 (...), 2 (...), 3 (...)" --
        # the wire's keys -- while the step that reads the answer takes hop
        # counts, so /settings told the operator the depths were 1, 2 and 3
        # and /withdraw refused all three. The 3 was the bad one: it is a
        # valid answer meaning TWENTY hops, so the reader most likely to be
        # helped by this line was the one most likely to pick the slowest
        # option believing it was the shallowest. proto.WITHDRAW_HOPS' own
        # comment records that collision being taken out of the menu; this
        # copy of it survived one file away, which is the reason the wire's
        # keys are not supposed to reach a chat at all.
        lines.append("  mixing depth    "
                     + ", ".join(str(_h)
                                 for _h in sorted(proto.WITHDRAW_HOPS))
                     + " hops, asked at /withdraw")
        lines.append("  destination     the address you reply with at /withdraw")
        lines.append("")
        # THE COURTESY BOUND, SAID TO BE THE COURTESY BOUND. This box's
        # --daily-cap help calls itself exactly that: "courtesy pokes per 24h.
        # The vault's own keyfile budget is the real bound." Printing this
        # number under a bare heading told the operator it was THE limit, and
        # the vault can refuse sooner with a different one -- so a run that
        # stops has an explanation this reply had ruled out.
        # "the machine", NOT "the vault". Every other line in this reply says
        # "the machine" for exactly one reason -- naming the box is naming the
        # shape of the operation on the surface this design assumes is read --
        # and the first draft of this line said "the vault" twice. The repo's
        # own test caught it, which is what that check is for.
        # THE CUT BELONGS IN "WHAT A RUN DOES". This listed what the operator
        # chooses and what is counted, and said nothing about the one thing a
        # run takes from them -- on the command whose whole purpose is to
        # answer "what will this do".
        lines.append("Taken by the service:")
        lines.append("  usage fee       taken once from each withdrawal "
                     "— the rate is on /fee")
        lines.append("  network fee     the network's own, per transaction "
                     "— not ours, and larger")
        lines.append("")
        lines.append("Counted here (the machine keeps its own, and its is the "
                     "real one):")
        # THE CAP, NOT THE RUNNING TOTAL. This printed "N a day, M used", and
        # the /status branch was deliberately rewritten to stop doing exactly
        # that, with the reason recorded there: "The count is how many deposits
        # were started today ... Both sat permanently in the transcript, on a
        # command that exists to answer 'can I send one'."
        #
        # It is worse here. /settings is one tap from almost every message this
        # bot sends -- it is the "What a run does" button, attached to the
        # welcome, /help, /status and every job outcome -- and it is not rate
        # limited. Read off successive messages the count is a timeline of
        # activity, and with --burn-after on it reconstructs what was deleted.
        #
        # Nothing is lost: why_not() already tells the operator whether they
        # are blocked, at the moment they are blocked, without a total.
        lines.append(f"  daily allowance {self.limits.daily_cap} a day")
        lines.append("")
        # ONLY WHAT IS ACTUALLY THERE. This block used to read "Set on the
        # machine, not here: hop delay, and the depth ceiling" and two thirds
        # of that was false. There is no hop-delay field in the vault's
        # keyfile and gs_wake_agent never composes --hop-delay, so the delay
        # is GhostSpiral's DEFAULT_HOP_DELAY and is not settable ANYWHERE;
        # the depth options are a table in gs_wake_proto, identical on every
        # install of a public repository. Naming them as machine settings
        # invited a trip to the vault to change something that is not there.
        lines.append("Set on the machine, with physical access:")
        lines.append("  whether sending out is allowed at all")
        lines.append("  the real allowance, and the ceiling on new addresses")
        # "IF ANYWHERE FIXED" WAS TRUE OF A DIFFERENT ARRANGEMENT. It read as
        # an optional refinement -- name a destination or one is minted for
        # you. On this path there is no minting: the destinations paired on the
        # machine are what decides whether a fee is taken at all.
        lines.append("  whether a usage fee is taken, and where it goes")
        lines.append("")
        lines.append("Fixed in the software, the same for everyone:")
        lines.append("  the delay between hops")
        lines.append("  which depths are on the menu")
        lines.append("  the usage fee — see /fee")
        lines.append("")
        lines.append("Nothing in the last two groups changes from this chat. "
                     "A message that could turn the mixing down is a message "
                     "worth stealing the phone for.")
        return "\n".join(lines)

    def _amount_question(self) -> str:
        """What to ask for a deposit: the amount, in the operator's own figures.

        THIS USED TO OFFER A LIST OF NICKNAMES -- "0 small, 1 medium, 2 large"
        -- because the wire carried an index into a ladder of amounts held in
        the vault's keyfile. Two things were wrong with it and only one was
        cosmetic. The cosmetic one: nobody can answer "which slot?" without
        having read the source. The real one: the operator is quoting a swap
        for the amount they are ABOUT TO SEND, and a rung is that amount only
        if it happened to be foreseen and written into a keyfile with physical
        access. Every other time, it quoted a number that was not the number.

        The bounds are named because a refusal that only says "out of range"
        makes the operator guess at the range. They are stated as BTC because
        that is the unit being sent; the satoshi count is an implementation
        detail of the wire and never appears in the chat.

        "ANYTHING FROM 0.0001 TO 100" READ AS AN OPERATING RANGE AND IS NOT
        ONE. gs_wake_proto says so at the constants themselves: "THESE ARE
        TYPO GUARDS AND NOT PROTOCOL MINIMUMS ... The real lower bound is
        whatever ThorChain's outbound fee makes uneconomic that day", and the
        bounds are "wide enough never to obstruct a real deposit".

        The trap is the first-time path, and it is the CAUTIOUS operator who
        walks into it: /start, the deposit button, and a deliberate test with
        the smallest number the bot named. The BTC swaps, the XMR lands, and
        then every /withdraw at every depth fails at GhostSpiral's stage 4
        against mix_minimum_xmr -- on the order of a third of an XMR, two
        orders of magnitude away. What the chat says about that failure is
        "It may be too deep for the balance -- the deeper options need more to
        work with", which cannot be acted on, because depth 1 is out of reach
        too. The money is in and it cannot be mixed out.

        This box CANNOT compute the real floor: it needs a live fee estimate
        and a swap rate, and it has never been told either. So it says the
        floor exists and which way to err, which is the whole of what it
        honestly knows.
        """
        return (f"How much? Reply with the BTC amount — for example 0.05.\n"
                f"Too little and the mix cannot run at all. If in doubt, "
                f"send more.\n"
                f"/cancel to stop.")

    def _depth_question(self) -> str:
        """The mixing-depth menu, drawn from the protocol's own table.

        BUILT FROM proto.WITHDRAW_DEPTHS RATHER THAN TYPED HERE. The vault
        sizes its budget from that same table and refuses any depth outside
        it, so a menu written by hand here could offer a fourth option that
        every withdrawal then died on.

        NO XMR MINIMUM IS SHOWN, and it is not an oversight -- see
        WITHDRAW_DEPTH_NOTE. The real floor is GhostSpiral.mix_minimum_xmr at
        that hop count, it moves with the network fee, and this box may not
        have GhostSpiral on disk. Saying "lowest minimum" is true whatever the
        fee is doing; printing "0.1784 XMR" would be a quote this box cannot
        stand behind.
        """
        # EVERY ROW LEADS WITH THE NUMBER THAT IS TYPED, and the row is built
        # by proto.depth_choice rather than here, so that rule holds in one
        # place for every box that draws this menu. It has been broken twice
        # -- once with the wire's key first, once with the runtime first --
        # and depth_choice carries both post-mortems.
        return ("How deep? Reply with the number of hops:\n"
                + "\n".join(f"  {proto.depth_choice(d)}"
                            for d in sorted(proto.WITHDRAW_DEPTHS))
                + "\n\nDeeper mixes better and needs a bigger balance to do "
                  "it — the fees come out of the same pile.\n"
                  "/cancel to stop.")

    #: The jobs whose labels the vault will never watch. receive_new mints an
    #: address and quotes nothing, so its handle record carries slip=None and
    #: both watching jobs refuse it with "Only a receive_and_quote handle can
    #: be watched". There is no configuration in which this changes.
    #: Jobs whose labels the vault will never watch. Empty since /address
    #: was removed -- the only job that minted an unwatchable handle. Kept
    #: as the seam rather than deleted: the check it feeds is what stops a
    #: button spending a wake to be refused, and a future job that quotes
    #: nothing would need it again.
    UNWATCHABLE_JOBS = ()

    #: How often /status will answer. It is a cooldown rather than a budget
    #: because the answer cannot change faster than this: `busy` flips when a
    #: job starts or ends, and the rate limiter's own window is minutes.
    STATUS_COOLDOWN_S = 15

    #: How many legs one /withdraw may chain through before it stops on its
    #: own. The daily wake budget (12 by default) bounds this anyway; the cap
    #: is here so that a wallet reporting "more left" forever -- a stuck scan,
    #: a dust output that never clears the mix minimum -- cannot turn one
    #: command into an unbounded run of spends.
    MAX_CHAIN_LEGS = 6

    #: How many unrecognised answers the depth step absorbs before it gives
    #: up. Two, because the second re-ask has already shown the menu twice and
    #: a third is no longer somebody misreading a row.
    #:
    #: THIS IS NOT THE ONLY BOUND ON THAT LOOP and it is not the important
    #: one. Convo.deadline is absolute from creation and never refreshed by an
    #: answer, so the conversation dies CONVO_TTL_S after it started whatever
    #: is typed into it. This bounds the TRANSCRIPT -- how many copies of the
    #: menu one confused minute can leave behind on a surface with no eraser.
    DEPTH_RETRIES = 2

    def _label(self, chat_id: int, h: str) -> str:
        """The confirmation number THIS chat sees for handle `h`.

        STRICT ON PURPOSE. If this cannot build a label the pager cannot bind
        one to a chat, and the tempting fallback -- show the bare handle --
        reissues exactly the bearer token the confirmation number retired.
        main() refuses to start without a usable pairing secret, so the only
        way to reach the raise is a Pager built some other way.
        """
        return confirmation_number(self.key, chat_id, h)

    def _handle_buttons(self, h: str, job: str = "", chat_id: int = 0) -> list:
        """Ask-again, bound to the label this reply is about, or None.

        ONE BUTTON. It offered check AND wait, side by side; the argument for
        dropping the second is at the return.

        NONE FOR A LABEL NOTHING CAN WATCH, and this used to offer both
        buttons unconditionally. An /address label is refused by the vault
        every time -- see UNWATCHABLE_JOBS -- and the refusal happens after
        the magic packet, the boot and the 5-20 minute jitter, having spent one
        of twelve daily wake slots. The reason is deliberately not on the wire,
        so what came back was a generic refusal, and the obvious next move is
        to tap it again.

        parse_callback's own comment states the rule this broke: "a button
        offering a depth the vault refuses would spend a wake on a rejection."

        THE COMMAND AN OPERATOR RUNS NEXT, and it used to require retyping a
        four-character hex label off the screen above -- on a phone, into a
        chat, correctly, or the wake was spent on unknown_handle. The label is
        right there; the button carries it.

        Built ONLY from a handle this process just minted and recorded in
        handle_owner, so a button can never carry somebody else's label into
        this chat. parse_callback re-checks the shape and handle() applies the
        ownership rule to the synthesised command exactly as it does to a typed
        one -- the button is a convenience, never a bypass.
        """
        if not (isinstance(h, str) and proto.HANDLE_RE.match(h)):
            return None
        if job in self.UNWATCHABLE_JOBS:
            return MENU_BUTTONS
        # THE BUTTON CARRIES THE CONFIRMATION NUMBER, not the bare handle, so
        # a tap still works after this process has restarted and forgotten who
        # owned what. Telegram keyboards do not expire; a button that stops
        # working the moment the unit restarts is a button that mostly does
        # not work.
        try:
            _c = self._label(chat_id, h) if chat_id else h
        except BaseException:                                # noqa: BLE001
            return MENU_BUTTONS
        # ONE BUTTON. "Wait for it" sat beside "Has it arrived?" and asked
        # the reader to choose between them, which is a choice nobody holding
        # a phone can make: waiting is what you do either way, and the label
        # said nothing about the only thing that actually differs -- how long
        # the machine stays up looking (three minutes against a hundred and
        # ten, and the long one holds every other command for the duration).
        #
        # /wait still exists and is on the published command list, so an
        # operator who knows they want the long look can ask for it. What is
        # gone is a keyboard offering a decision without the information to
        # make it.
        return [[("Has it arrived?", f"c:{_c}")]]

    def _phase_buttons(self, phase: str, h: str, job: str = "",
                       chat_id: int = 0) -> list:
        """What to offer under a status answer. Never raises.

        THE ONE REPLY THAT OFFERED NOTHING. Every other message this bot sends
        carries the next step; the status answer -- the message an operator
        sees more often than any other, because it is what waiting looks like
        -- ended with a full stop and an empty keyboard. The "landed" line (it
        read "landed and spendable" then) left somebody who had just been told
        their money was there with no way to be paid except knowing the word
        /withdraw and typing it, and "nothing on the address yet" left them
        retyping a four-character hex label off the screen above to ask a
        second time. Both are the exact defect _handle_buttons was written
        for, on the surface it did not cover.

        LABELS ARE READ OUT OF THE MENU, not written again here: two spellings
        of the same button is how one of them stops matching what it does.
        """
        try:
            if phase in ("not_yet", "arriving"):
                # Still waiting: the command that asks again. ONE of them --
                # _handle_buttons dropped "Wait for it", and this comment said
                # "the two commands" for a turn after it did.
                return self._handle_buttons(h, job, chat_id)
            if phase == "landed":
                # The money is there. There is exactly one thing to do next
                # and it is the reason any of this ran.
                return [[_menu_button("m:send")]]
        except BaseException:                                # noqa: BLE001
            pass
        # "short", "stuck", and anything a newer vault invents: something needs
        # a decision, and the full menu is where /help lives.
        return MENU_BUTTONS

    def _depth_buttons(self) -> list:
        """The same menu as _depth_question, tappable.

        ONE ROW PER DEPTH, from proto.WITHDRAW_DEPTHS -- the same table the
        text is built from, so a depth can never appear as a button and not as
        a line, or the reverse. The label carries the hop count because that is
        the thing being chosen and because it is the answer the typed path
        reads; the runtime and what the depth buys stay on the line above,
        where proto.depth_choice has room for them.

        Cancel is here because the message it sits under ends with "/cancel to
        stop", and an operator who has just decided not to do this should not
        have to type a word to say so.

        THE CALLBACK CARRIES THE HOP COUNT, not the key, because
        parse_callback hands back "the text the typed path would have
        received" and the typed path reads hops. A button carrying the key
        would tap to a number the step then refuses -- the same two
        vocabularies that made "3" mean twenty hops, one layer over.
        """
        _rows = [[(f"{_h} hops", f"d:{_h}")]
                 for _h in sorted(proto.WITHDRAW_HOPS)]
        return _rows + [[("Cancel", "m:cancel")]]

    def _depth_from(self, word: str):
        """A depth from what was typed, or None. Never raises.

        ASCII DIGITS ONLY, and not str.isdecimal(), which is what this was
        written with first. isdecimal() is True for all 455 Unicode decimal
        digits and int() converts every one of them, so "１" -- FULLWIDTH
        DIGIT ONE, which a CJK phone keyboard emits without being asked --
        selected a depth through a pattern that was supposed to accept only
        the ASCII digit it looks like.
        Harmless at this particular gate and not at the one next to it: the
        same shape let a fullwidth digit through as a BTC amount, which is
        driven and recorded at gs_wake_proto._BTC_RE.

        The membership test is against the protocol's table rather than a
        range literal, so this cannot accept a depth the vault will refuse.

        HOPS IN, KEY OUT. This took the KEY, and the question listed the key
        and the hop count side by side -- "3  20 hops" -- so "3" meant twenty
        hops here and three hops on the line above it. Somebody who read the
        menu and typed what they wanted got the slowest option of the three,
        with the highest minimum balance, having confirmed something else.
        Hops are what the buttons say and what is actually being chosen, so
        hops are what this reads; WITHDRAW_HOPS is derived from the same table
        so the two cannot drift.
        """
        w = (word or "").strip()
        if not w or not all(c in "0123456789" for c in w):
            return None
        return proto.WITHDRAW_HOPS.get(int(w))

    def step_convo(self, chat_id: int, text: str) -> bool:
        """Advance a live conversation. True if this message was consumed.

        NEVER RAISES, and that is not defensive habit -- it is the fix for a
        reproduced bug. `"²".isdigit()` is True and `int("²")` raises, so a
        slot step guarded by isdigit() let a ValueError escape: no reply was
        sent AND the conversation stayed live, so the operator's next
        unrelated message was silently eaten as a slot answer. Any escape from
        here has that shape, so the conversation is dropped on any of them.
        """
        try:
            return self._step_convo(chat_id, text)
        except Exception as e:                               # noqa: BLE001
            self.convos.pop(chat_id, None)
            integrity_log("pager", "convo_error")
            self.send(chat_id, f"no: that went wrong — cancelled, nothing was "
                               f"started ({_redact(e)[:60]}).")
            return True

    def _step_convo(self, chat_id: int, text: str) -> bool:
        self._reap()
        c = self.convos.get(chat_id)
        if c is None:
            return False
        word = text.strip().lower()
        # ANY COMMAND ABANDONS THE CONVERSATION rather than being eaten by it,
        # and /cancel is simply the command that does nothing else. There is
        # deliberately NO second cancel vocabulary here: the first version
        # matched "/cancel" and "/stop" literally, so the group form this file
        # explicitly supports -- "/cancel@mybot" -- fell through to this
        # branch, and the one command whose whole job is to confirm nothing is
        # armed replied "nothing to cancel" having just cancelled something.
        # One vocabulary, in parse_command, where every other command's lives.
        if word.startswith("/"):
            # ...AND IT SAYS SO, WHICH IT DID NOT. The rule is right and the
            # silence around it was the whole problem. Driven, end to end:
            #
            #     /deposit  -> "How much? Reply with the BTC amount..."
            #     /status   -> "ready"          (the wizard is now gone)
            #     0.05      -> "no: unknown command"
            #
            # The operator answered the question they were asked and was told
            # their answer is not a command. Nothing in that sequence tells
            # them a command cancelled the thing asking -- so the tool reads as
            # broken at the exact moment it was working as designed.
            #
            # NOT FOR /cancel, which has its own reply and would otherwise say
            # it twice. Asked of parse_command rather than matched here: this
            # branch has already been the place a second cancel vocabulary got
            # written and then disagreed with the first one.
            _kind = c.kind
            del self.convos[chat_id]
            _route = parse_command(text)[2]
            # THE SAME COMMAND AGAIN IS A RESTART, NOT AN INTERRUPTION, and
            # saying "that dropped the /deposit you were part-way through"
            # immediately before re-asking "How much?" reads as an error
            # report about the thing the operator just deliberately did. They
            # typed it again because they wanted to start over. Say that.
            if _route == f"{'depo' if _kind == 'depo' else 'withdraw'}_wizard":
                self.send(chat_id, "(starting that over.)")
            elif _route != "cancel":
                self.send(chat_id,
                          f"(that dropped the "
                          f"{'/deposit' if _kind == 'depo' else '/withdraw'} "
                          f"you were part-way through — any command does. "
                          f"Nothing was sent.)")
            return False
        if c.awaiting_amount():
            # THE AMOUNT THEY ARE ACTUALLY SENDING, parsed by the PROTOCOL's
            # own function -- the same one the vault's schema bounds against,
            # so this box cannot accept a figure the wire will refuse and
            # leave the operator having spent a wake on a rejection.
            #
            # NOT lower-cased: the parser takes ASCII digits and one dot, and
            # case cannot occur in a value it accepts. Passed as typed, minus
            # the ends, so the refusal is about what they wrote.
            try:
                _amt = proto.btc_to_sat(text.strip())
            except Exception as _e:                          # noqa: BLE001
                del self.convos[chat_id]
                # THE REASON, AND NOT WHAT THEY TYPED. Echoing the figure back
                # on a failure would put an amount in the transcript for a
                # deposit that is not going to happen.
                self.send(chat_id, f"no: {_e}. Cancelled — start again with "
                                   f"/deposit.")
                return True
            c.amount = _amt
            # DEADLINE UNTOUCHED. See Convo: it is absolute from creation, so
            # answering slowly does not buy another full window.
            q, c.expect = _confirm_question(self.rng)
            # THE AMOUNT BACK, NORMALISED, and this is the point of the whole
            # change: the operator confirms the number they are about to send
            # rather than a rung's nickname. Rendered through btc_display so
            # what they confirm is what the vault will quote -- if those two
            # ever disagreed, this is the line that would show it.
            self.send(chat_id,
                      f"Deposit {proto.btc_display(c.amount)} BTC. "
                      f"Confirm and it starts.\n\n{q}")
            return True
        if c.awaiting_address():
            # CHECKED HERE AND AGAIN AT THE VAULT. This gate is the protocol's
            # own -- the same function validate_job applies on the other side,
            # so the pager cannot accept something the wire will reject and
            # leave the operator with a wake spent on a refusal. It is a SHAPE
            # check: the vault does the real checksum before a coin moves.
            #
            # NOT lower-cased and NOT stripped beyond the ends: base58 is
            # case-significant, and an address that only differs by case is a
            # different address.
            # SPLIT ON WHITESPACE OR COMMAS, the same separator
            # resolve_exit_destinations applies to GS_EXIT_TO -- so the phone,
            # the console and the command line all take a destination list the
            # same way, and an operator who has read one has read all three.
            #
            # ONE MESSAGE, NOT ONE PER ADDRESS. Every message is a line in a
            # server-side transcript this tool cannot delete; asking N times
            # would write N of them for no gain.
            _a = [t for t in re.split(r"[\s,]+", text.strip()) if t]
            try:
                _a = proto.JOBS["withdraw"]["schema"]["exit_to"](_a)
            except Exception:                                # noqa: BLE001
                del self.convos[chat_id]
                # THE REASON, NOT THE VALUE. Echoing what they typed would put
                # a near-miss of their own destination in the transcript, on
                # the one surface with no masker.
                # THE REASON, NOT THE CURRENCY. "not a Monero address" named
                # what this chat is about, in the chat, on a reply an operator
                # triggers by fat-fingering one character.
                self.send(chat_id, "no: bad address. Cancelled.")
                return True
            c.exit_to = _a
            # NOT THE CONFIRM YET. The depth is the second thing that is
            # genuinely the operator's to decide, and it used to be a constant
            # in gs_wake_agent -- which meant every withdrawal mixed through
            # ten hops whether the pile could afford it or not. The mix floor
            # rises with the hop count, so that one constant was a floor on
            # what could be withdrawn AT ALL.
            self.send(chat_id, self._depth_question(),
                      buttons=self._depth_buttons())
            return True
        if c.awaiting_depth():
            _d = self._depth_from(word)
            if _d is None:
                # RE-ASKS, AND EVERY OTHER STEP HERE CANCELS. That is not an
                # inconsistency to tidy up later; it is the one step where a
                # cancel throws away work, and the work it throws away is the
                # worst kind to make somebody redo.
                #
                # The destinations are already in. They were typed into a
                # transcript this tool cannot delete, and cancelling means
                # typing them again -- so the SAME addresses appear twice in
                # the readable surface, and the second copy buys nothing.
                # /deposit's amount step and /withdraw's address step have no
                # such asymmetry: what a cancel costs there is exactly the one
                # value that was just refused.
                #
                # AND THE MENU IS WHY THIS IS REACHED AT ALL. It prints 6, 9
                # and 13 as runtimes beside the answers 3, 10 and 20; those
                # are numbers a reader can plausibly type. Refusing them is
                # right -- guessing which one was meant is how "3" came to
                # mean twenty hops -- but refusing them by discarding the
                # addresses turns a misread into a re-disclosure.
                #
                # NOTHING HAS BEEN SPENT AT THIS POINT. The confirm sum is
                # still ahead, and it is where a wrong answer still cancels
                # outright: that gate exists to stop a pocket-dial, and a gate
                # you may retry is not one.
                c.tries += 1
                if c.tries > self.DEPTH_RETRIES:
                    del self.convos[chat_id]
                    integrity_log("pager", "convo_depth_exhausted")
                    self.send(chat_id, "no: cancelled — start again with "
                                       "/withdraw.")
                    return True
                # THE MENU AGAIN, NOT A HAND-WRITTEN LIST OF THE ANSWERS. A
                # second copy of the valid numbers written here is a second
                # thing to forget, and it would be wrong in the direction that
                # reads as authoritative -- see the same argument at
                # _depth_question. Re-sending the question also re-sends the
                # buttons, so the way out of a misread is one tap.
                #
                # WHAT THEY TYPED IS NOT ECHOED, for the reason every other
                # refusal here gives: the reply is about the mistake, and a
                # transcript line quoting the operator's own near-miss is a
                # line somebody else can read later.
                self.send(chat_id,
                          "no: reply with one of the numbers below.\n\n"
                          + self._depth_question(),
                          buttons=self._depth_buttons())
                return True
            c.depth = _d
            q, c.expect = _confirm_question(self.rng)
            # NEITHER THE ADDRESS NOR AN AMOUNT. The address is already in the
            # transcript once and repeating it would make it twice, on the one
            # surface with no masker. There is no amount to state: the vault
            # decides what it is spending when it looks, and this box has never
            # been told a balance.
            #
            # THE DEPTH IS SAID BACK, because it is the one thing here the
            # operator chose from a list and could have mistyped, and unlike
            # the address it reveals nothing -- it is a property of the
            # service, not of the money.
            #
            # AND HOW MANY ARRIVALS LAND ON HOW MANY ADDRESSES, because the
            # depth is what decides the first number and this is the last
            # moment either can be changed. A COUNT is not an address: it says
            # nothing about where the money goes and everything about whether
            # the operator has just undone the run's whole purpose. The
            # single-destination case gets a sentence rather than a number,
            # since that is the case where the count is the bad news.
            _n = len(c.exit_to)
            _spread = (f"across {_n} addresses" if _n > 1 else
                       "onto the ONE address you gave — anyone watching it "
                       "sees them all and can group them")
            # NO "WHOSE MONEY IS THIS" LINE HERE, AND THAT IS THE POINT.
            #
            # An earlier version added one, for the install where more than
            # one person could spend from one wallet. There is no such install
            # any more: main() refuses to start, unconditionally, and
            # start_job refuses the wake. A sentence explaining a risk the
            # operator is not allowed to be exposed to would be a sentence
            # about a state that cannot exist -- and worse, it would read as
            # the warning that MAKES it acceptable.
            # THE FEE IS NAMED WHERE IT IS CHARGED. /fee and the welcome both
            # say it, and neither is on the screen at the moment the operator
            # is about to agree to a spend. A cost disclosed only somewhere
            # else is a cost the person paying it can miss.
            #
            # NO AMOUNT AND NO ARITHMETIC. This box has never been told a
            # balance -- see /settings, which refuses to fetch one -- so it can
            # state the RATE and must not state a figure. A number invented
            # here would be a quote the vault never made.
            # THE ARRIVAL COUNT IS NOT NAMED, and it used to be: "At least 12
            # separate transactions".
            #
            # STATED HONESTLY, because this is not a Kerckhoffs defence and
            # must not be written as one: exit_arrivals_floor is a public
            # function of a depth this same message names, so anyone holding
            # this repository recomputes the figure in one line. What removing
            # it changes is the READABLE surface -- a transcript that states
            # "at least 12" hands a directly usable count to somebody who has
            # the chat and has never seen the source, which is exactly the
            # reader this design assumes. It lowers what a casual reader gets
            # and does not pretend to lower what an informed one gets.
            #
            # The FACT survives, because it is the one that decides whether
            # giving a single address throws the run away.
            self.send(chat_id,
                      f"Send to the {'addresses' if _n > 1 else 'address'} you "
                      f"just sent, {proto.depth_said_back(_d)} — this "
                      f"SPENDS.\n\n"
                      f"It arrives as many separate payments, {_spread}.\n"
                      f"{USAGE_FEE_LABEL} usage fee comes out of it — this "
                      f"service's cut. The network fee is separate, charged "
                      f"on every transaction, and is not ours."
                      f"\n\n{q}")
            return True
        # ONE ATTEMPT PER QUESTION, and the comment says per QUESTION because
        # that is all it is: a wrong answer cancels, and nothing stops the
        # operator -- or whoever holds the phone -- typing /depo again for a
        # fresh sum. Questions are unlimited and free. The number bounds a
        # pocket-dial, which is what CONFIRM_NOTE claims and all it claims.
        # Logged so a burst of failures is at least visible in the chain.
        kind, amount, expect = c.kind, c.amount, c.expect
        exit_to, depth = c.exit_to, c.depth
        del self.convos[chat_id]
        if not word.isdecimal() or int(word) != expect:
            integrity_log("pager", "convo_confirm_failed")
            self.send(chat_id, "no: wrong answer. Cancelled — nothing was "
                               "started. Start again.")
            return True
        if kind == "withdraw":
            self.commit_withdraw(chat_id, exit_to, depth)
            return True
        self.commit_convo(chat_id, amount)
        return True

    def commit_withdraw(self, chat_id: int, exit_to, depth) -> None:
        """Turn a finished withdraw conversation into a job.

        Same shape as commit_convo and for the same reason: what reaches the
        wire is validated against the PROTOCOL's schema, not against a literal
        typed here, because the vault applies that same schema and agreeing
        with a local copy of it is not the property.

        RE-CHECKED HERE, though it was checked at its own step. This is the
        last line before a spend, the object it reads lived in a dict for up
        to three minutes, and re-running one cheap predicate costs nothing
        next to what it guards.
        """
        job = "withdraw"
        params = {"exit_to": exit_to, "depth": depth}
        _schema = (proto.JOBS.get(job) or {}).get("schema") or {}
        if set(params) != set(_schema):
            integrity_log("pager", "convo_commit_mismatch")
            self.send(chat_id, "no: internal check failed, nothing was started.")
            return
        try:
            for _k, _check in _schema.items():
                _check(params[_k])
        except Exception:                                    # noqa: BLE001
            integrity_log("pager", "convo_commit_mismatch")
            self.send(chat_id, "no: internal check failed, nothing was started.")
            return
        self.start_job(chat_id, job, params)

    def commit_convo(self, chat_id: int, amount: int) -> None:
        """Turn a finished conversation into a job. THE ONLY WAY IT BECOMES ONE.

        THIS USED TO ROUND-TRIP THROUGH parse_command, composing the text an
        operator would have typed -- `/depo 2` -- so that the wizard and the
        one-shot form could not drift apart. That was the right shape while
        both existed. The one-shot form is gone (it skipped the confirm the
        wizard was written for, and it put the digit in the transcript
        attached to the word), so the round trip now asks the parser for a
        form the parser deliberately refuses, and the wizard could never
        commit at all. Caught by this repo's own tests, immediately, which is
        what they are for.

        The invariant it was protecting still matters and is checked directly:
        what reaches the wire is ONE key holding an in-range int, and it is
        validated against the PROTOCOL's schema rather than against a literal
        typed here -- the vault applies that same schema, so agreeing with it
        is the property, and agreeing with a copy of it is not.

        THE BOUNDS ARE NO LONGER RESTATED HERE. This used to end with
        `0 <= params["amount_slot"] <= 7`, a copy of the schema's range in the
        file that also holds the schema -- so the two could disagree only by
        someone editing one, which is exactly what happened when the ladder
        became an amount. Calling the schema's own check is the version that
        cannot drift, and it is the thing the paragraph above already claimed
        was happening.

        An explicit comparison and not `assert`, because python -O removes
        asserts and this is the last thing standing between a conversation and
        a wake.
        """
        job, params = "receive_and_quote", {"amount_sat": amount}
        _schema = (proto.JOBS.get(job) or {}).get("schema") or {}
        try:
            if set(params) != set(_schema):
                raise ValueError("key set")
            for _k, _check in _schema.items():
                _check(params[_k])
        except Exception:                                    # noqa: BLE001
            integrity_log("pager", "convo_commit_mismatch")
            self.send(chat_id, "no: internal check failed, nothing was started.")
            return
        self.start_job(chat_id, job, params)

    # -- telegram -------------------------------------------------------
    def _url(self, method: str) -> str:
        return f"https://api.telegram.org/bot{self.token}/{method}"

    def send(self, chat_id: int, text: str, buttons=None) -> bool:
        """One reply. What it may carry is CONFIGURATION, not a law.

        This said "Never carries a plaintext address, memo or amount", and
        that is the sentence most likely to talk the next reader out of
        noticing a new leak. It is false three ways, all deliberate:

          * the /deposit confirm echoes the BTC figure the operator typed, in
            every configuration -- that trade is argued at _amount_question;
          * with `plain_slip` set on the vault's keyfile, plain_lines puts the
            deposit address, the amount and the ThorChain memo (which names
            the destination XMR address in full) into two messages;
          * /withdraw carries the destinations the operator replies with, and
            the confirm names the depth and the arrival count.

        What is true BY DEFAULT is narrower and is the actual property: with
        no delivery key and no plain_slip, the most this says about a finished
        deposit is "depo ready · slip A3F1".

        `buttons` is rows of (label, callback_data) and is OPTIONAL EVERYWHERE.
        A tap is a second way to send text this bot already accepts -- see
        _callback_text -- so a chat with no keyboard support, an old client, or
        a burned message all still work by typing. Nothing is reachable only by
        tapping.

        RETURNS WHETHER IT LANDED, and that is not decoration. This used to
        return None and swallow the failure into a print() -- which under the
        shipped unit goes to StandardOutput=null, i.e. nowhere. That was
        survivable while every reply was a status line the operator could
        infer from the next one. It stopped being survivable when a reply
        started carrying the sealed slip: a dropped send left the operator
        looking at "Sealed slip below" with nothing below it, on a box they
        cannot walk to, for a quote that expires while they wait.
        """
        try:
            _payload = {"chat_id": chat_id, "text": text,
                        "disable_web_page_preview": True}
            if buttons:
                _payload["reply_markup"] = json.dumps(
                    {"inline_keyboard":
                        [[{"text": _t, "callback_data": _d} for _t, _d in _row]
                         for _row in buttons]})
            _r = safe_post(self._url("sendMessage"), _payload,
                           proxies=self.proxies)
            # REMEMBER IT SO IT CAN BE BURNED. Failing to record an id is not
            # an error the operator can act on -- the reply DID land, which is
            # what this returns -- so a malformed answer costs the ability to
            # delete that one message and nothing else.
            self._remember(chat_id, _r)
            return True
        except Exception as e:                               # noqa: BLE001
            print(f"  [!] reply failed: {_redact(e)}")
            return False

    def arm_burn(self, *_a) -> None:
        """SIGUSR1: burn every tracked message on the next tick.

        THE TRIGGER IS ON THE HOST, NOT IN THE CHAT, and that is the whole
        design of it. A /wipe command would put the word "wipe" in the very
        transcript it is meant to empty -- a message that says, permanently and
        in the operator's own hand, that there was something here worth
        deleting. It would also hand a stolen phone the power to destroy the
        operator's own record of what that phone had been used for.

        So it is a signal to the process on the box:

            kill -USR1 $(pidof -x gs_telegram_pager)
            systemctl kill -s USR1 gs-telegram-pager

        Nothing is typed into Telegram, nothing new is written to the SD card,
        and the ability to do it is exactly the ability to run a command on the
        host -- which is a level of access that already implies far more than
        this.

        A FLAG, NOT THE WORK. Signal handlers run between bytecodes and can
        arrive inside safe_post; doing network I/O here would re-enter requests
        from a handler. The poll loop does it, one tick later at worst.
        """
        self.burn_now = True

    def _remember(self, chat_id: int, res) -> None:
        """Record a message this process can later delete. Never raises.

        Tolerant of every shape a proxied or older Bot API can answer with,
        because the only cost of not recording one is that it does not get
        burned -- and raising here would turn a successful reply into a failed
        one, which is the more expensive direction by far.
        """
        try:
            mid = ((res or {}).get("result") or {}).get("message_id")
            if isinstance(mid, int) and not isinstance(mid, bool):
                self.burn.append((int(chat_id), mid, time.time()))
        except Exception:                                    # noqa: BLE001
            pass

    def delete_message(self, chat_id: int, message_id: int) -> bool:
        """Ask Telegram to remove one message. False if it would not.

        WHAT THIS IS AND IS NOT. It removes the message from the chat for both
        sides. It does NOT reach a copy someone already forwarded, a screenshot,
        a device that cached it, or whatever Telegram keeps server-side that an
        operator cannot see. This whole channel is built on the assumption that
        the transcript is read by somebody else; burning it afterwards is
        defence in depth on top of that assumption, never a replacement for it.
        That is why the reply vocabulary was made boring FIRST -- a message
        that says nothing is safe whether or not this call succeeds.
        """
        try:
            safe_post(self._url("deleteMessage"),
                      {"chat_id": chat_id, "message_id": int(message_id)},
                      proxies=self.proxies)
            return True
        except Exception as e:                               # noqa: BLE001
            # EXPECTED, ROUTINELY. Telegram refuses a delete for reasons that
            # are not failures of this program: the message is over 48 hours
            # old, it was already deleted, or the chat no longer exists. Quiet
            # by default; the caller counts and reports the total.
            print(f"  [!] delete refused: {_redact(e)[:120]}")
            return False

    def burn_expired(self, older_than: float) -> int:
        """Delete every tracked message older than `older_than` seconds.

        Called from the poll loop, so a chat left alone still empties itself.

        DROPPED FROM THE LIST WHATEVER TELEGRAM SAYS. A refused delete is
        almost always permanent -- past the 48-hour window, or already gone --
        and retrying it every ten seconds for the life of the process would
        turn one refusal into a permanent stream of requests over Tor. The
        count is returned so a caller can say what happened.
        """
        if older_than <= 0 or not self.burn:
            return 0
        now = time.time()
        keep, gone = [], 0
        for cid, mid, sent in self.burn:
            if now - sent < older_than:
                keep.append((cid, mid, sent))
                continue
            if self.delete_message(cid, mid):
                gone += 1
        self.burn = keep
        return gone

    def burn_all(self, chat_id: int = None) -> tuple:
        """Delete everything tracked (optionally for one chat). (gone, tried).

        Returns both numbers because they differ for a reason the operator
        needs: anything Telegram has held for more than 48 hours cannot be
        deleted by a bot at all, so "3 of 7" is the honest answer and "wiped"
        would not be.
        """
        keep, gone, tried = [], 0, 0
        for cid, mid, sent in self.burn:
            if chat_id is not None and cid != int(chat_id):
                keep.append((cid, mid, sent))
                continue
            tried += 1
            if not self.delete_message(cid, mid):
                # NOT KEPT. See burn_expired: a refusal here is not transient.
                pass
            else:
                gone += 1
        self.burn = keep
        return gone, tried

    def updates(self) -> list:
        url = (f"{self._url('getUpdates')}?timeout={POLL_HOLD_S}"
               f"&offset={self.limits.offset}"
               # BOTH KINDS. A tapped button arrives as a
               # callback_query, and a getUpdates that does not ask for
               # them never receives one -- so every button this bot
               # draws would spin for thirty seconds and then do
               # nothing, which is worse than having no buttons.
               f"&allowed_updates=%5B%22message%22,%22callback_query%22%5D")
        try:
            d = safe_get(url, proxies=self.proxies)
        except Exception as e:                               # noqa: BLE001
            self.poll_failures += 1
            print(f"  [!] poll failed ({self.poll_failures}/"
                  f"{MAX_POLL_FAILURES}): {_redact(e)}")
            if self.poll_failures >= MAX_POLL_FAILURES:
                # NEVER WHILE A WAKE IS IN FLIGHT, and this exit used to fire
                # regardless. It is the most expensive bug in this file.
                #
                # DRIVEN. safe_get times out at 20 s and this sleeps 5, so
                # MAX_POLL_FAILURES is reached after about five minutes of Tor
                # being unreachable -- an ordinary event on a link whose whole
                # design is Tor over WireGuard. The worker thread that runs a
                # wake is `daemon=True`, so SystemExit on THIS thread tears the
                # interpreter down without joining it: the in-process doorbell
                # server dies mid-window with its socket closed.
                #
                # What that costs, end to end: a withdrawal collected by the
                # vault runs on the VAULT, for up to 16.75 h, spending real
                # money, and reports back over the LAN when it finishes. It
                # POSTs to a port nothing is bound to any more. report_back
                # catches the failure, writes `result_undeliverable`, and the
                # vault powers off. The mix happened. The money moved. The
                # operator's last message was "working. This takes a while."
                # and nothing ever follows it.
                #
                # THE ORIGINAL REASONING SURVIVES, NARROWED. "A pager that
                # cannot reach Telegram but keeps running is one you believe is
                # listening when it is not" is right -- about TELEGRAM. It says
                # nothing about the LAN, which is a different network, is not
                # down, and is where the only irreversible thing in this system
                # is happening. So the exit waits for the wake instead of
                # killing it: the counter stays at the ceiling, every later
                # poll re-checks, and the process stops the moment `busy` is
                # free.
                if self.busy.locked():
                    # ONCE PER OUTAGE, NOT ONCE PER POLL. Each failed poll
                    # costs about 25 s (a 20 s timeout plus the sleep below),
                    # so a wake that rides out a long outage passes here
                    # thousands of times -- and integrity_log APPENDS TO A HASH
                    # CHAIN ON THE SD CARD. Logging every pass would turn one
                    # network problem into thousands of writes to the card this
                    # design is otherwise careful not to touch, and would bury
                    # the entry that matters in its own repetitions. The
                    # equality is the crossing; every later poll is the same
                    # outage still going on.
                    if self.poll_failures == MAX_POLL_FAILURES:
                        integrity_log("pager", "poll_failed_wake_in_flight")
                        print(f"  [!] Telegram unreachable, but a wake is in "
                              f"flight on the LAN. NOT stopping: the vault "
                              f"will report back to this process and there is "
                              f"nowhere else for that result to go. Stopping "
                              f"when it finishes.")
                    time.sleep(5)
                    return []
                integrity_log("pager", "poll_failed_giving_up")
                sys.exit(
                    f"[!] {MAX_POLL_FAILURES} consecutive poll failures. "
                    f"Tor or the network is down.\n"
                    f"    Stopping rather than looping: a pager that cannot "
                    f"reach Telegram but keeps\n"
                    f"    running is one you believe is listening when it is "
                    f"not. It does not start\n"
                    f"    without Tor (section 4); it should not keep running "
                    f"without it either.")
            time.sleep(5)
            return []
        self.poll_failures = 0
        if not isinstance(d, dict) or not d.get("ok"):
            return []
        out = d.get("result")
        if not isinstance(out, list):
            return []
        # EVERY ELEMENT MUST BE A DICT, checked HERE and not by the caller.
        #
        # The loop reads upd.get("update_id") on each element. A result list
        # carrying a bare string or a null -- from a proxied or misbehaving
        # API, or a future Bot API shape -- raises AttributeError in the FOR
        # HEADER of run(), which is outside the per-update try, so it kills the
        # process. systemd restarts it, the offset was never advanced past that
        # batch, the same element comes back, and the pager crash-loops until
        # somebody looks. Filtered rather than raised: a batch of ten updates
        # with one malformed element must still deliver the other nine.
        return [u for u in out if isinstance(u, dict)]

    # -- the poke -------------------------------------------------------
    #: A JOB LONG ENOUGH THAT SILENCE STOPS MEANING "BE PATIENT".
    #:
    #: Below this the operator was told a number they can wait out -- a status
    #: probe is 25 minutes -- and an extra line in the transcript buys nothing.
    #: Above it, the wait is long enough that "it is working" and "it is dead"
    #: look identical for hours, which is the state a withdrawal spends two
    #: thirds of a day in.
    #:
    #: Compared against result_budget_s, the same figure start_job already
    #: quotes, so the message that says "up to 17h" and the decision to report
    #: progress during those 17h cannot disagree.
    MILESTONE_FLOOR_S = 3600

    def _milestone(self, chat_id: int, job: str):
        """A callback for run_wake's milestones, or None for a short job.

        ONE MESSAGE, AT COLLECTION, AND NOT AT THE MAGIC PACKET. Both are real
        events and only one is worth a permanent line: "the packet went out"
        is a restatement of the "working" reply the operator already has, and
        it lands within the pre-WOL ceiling they were told about. "It picked
        the job up" is the one that changes what they should believe -- before
        it, nothing has run and nothing is spent; after it, something is
        running that this box cannot stop.

        A FAILED SEND IS NOT RETRIED. The result has its own retry because a
        lost slip costs money; a lost progress line costs a sentence, and a
        retry storm here would hold `busy` against a dead circuit for the rate
        limit's whole window -- which is the reasoning the slip path already
        records for capping itself at one.
        """
        if proto.result_budget_s(job) < self.MILESTONE_FLOOR_S:
            return None

        def _say(word):
            if word != "collected":
                return
            integrity_log("pager", f"collected:{job}")
            self.send(chat_id,
                      f"{chat_name(job)}: picked up — it is running now. "
                      f"Nothing else to do; I will say when it is finished.")
        return _say

    def poke(self, chat_id: int, job: str, params: dict) -> None:
        """Run one wake, in this process, and report only its OUTCOME.

        gs_doorbell is imported rather than shelled out to: its human-facing
        stdout is not an interface (this repo says so about JoinMarket's, and
        about parsing a tool's output to identify a bundle), and going through
        the module means the outcome and handle are read as values instead of
        scraped out of prose.
        """
        db = doorbell()
        try:
            pending = db.run_wake(self.args, self.key, job, params,
                                  on_event=self._milestone(chat_id, job))
        except BaseException as e:                           # noqa: BLE001
            integrity_log("pager", f"wake_failed:{job}")
            self.send(chat_id, f"{chat_name(job)}: failed to start — {_redact(e)[:160]}")
            return
        out = pending.outcome()
        # WHAT HAPPENED ON THE SWITCH, WHICH THIS SURFACE NEVER SAW.
        #
        # gs_doorbell collects `events` and _report_events prints the two that
        # change what the operator should believe -- under a docstring saying
        # `events` "was collected and never read by anything ... and worse
        # here, because the one event that means 'your job did not go where
        # you think' was among the ones being thrown away."
        #
        # That was fixed for the CLI and left unfixed for the surface the whole
        # feature exists for. Driven: a replayed M1 collects, the real vault's
        # M1 is refused, events are ['job_collected', 'm1_second_ephemeral'] --
        # the CLI prints "the job went to a boot that cannot read it, and
        # nothing ran", and the chat gets "I do NOT know whether the funds
        # moved", forbidding the retry that is in fact the right move.
        #
        # A CLOSED VOCABULARY, in PHASE_LINES' style: this box renders words
        # the doorbell chose from a fixed set, so the vault gains no free-text
        # channel into a chat. Sent BEFORE the outcome branch, because it
        # changes how that outcome should be read.
        _ev = getattr(pending, "events", None) or []
        _notes = [EVENT_LINES[_e] for _e in EVENT_VOCAB if _e in _ev]
        if _notes:
            integrity_log("pager", "event_reported")
            self.send(chat_id, "\n".join(_notes))
        # BOOKKEEPING MUST NOT PRE-EMPT THE REPORT. integrity_log re-raises an
        # OSError, and this line sits above every reply branch -- so a full or
        # read-only SD card turned "your withdrawal finished" into silence.
        # _worker now catches that and says something, but the right answer
        # here is that a chain write failing must not cost the message at all:
        # the chain records what happened, the message IS what happened as far
        # as the operator is concerned.
        try:
            integrity_log("pager", f"outcome:{job}:{out}")
        except Exception:                                    # noqa: BLE001
            print("  [!] could not write the integrity chain for this "
                  "outcome; reporting it anyway.")
        # A PHASE OUTRANKS THE OUTCOME, and it is checked before the branch
        # that reads `out`.
        #
        # The phase branch used to live INSIDE `if out == "done"`, so a watch
        # that ran its full window and reported what it saw -- money still
        # confirming -- fell through to the failure branch and said
        # "watch: failed." The phase is the honest answer and the outcome is
        # the return code; when they disagree, the honest answer wins.
        #
        # It is safe to trust here because it is not this box's word: the
        # doorbell refuses any phase outside the protocol's closed table
        # before this line can see it, which is also what stops the vault
        # gaining a free-text channel into a chat.
        #
        # ...AND IT IS SCOPED TO THE JOBS THAT ARGUMENT IS ABOUT, which are
        # the two that WATCH. For those, "your money has not arrived yet" is
        # the honest answer and the non-zero return code is the noise. For a
        # WITHDRAW the same rule inverts and lies about a spend.
        #
        # A withdrawal carries a phase now ("more_left"), and every phase word
        # presupposes a run that FINISHED: unscoped, a failed withdrawal whose
        # record carried one answered
        #
        #     B7C2: that one is done and there is more here. Run /withdraw
        #           again for the next.
        #
        # about a run that moved nothing -- a false success on the one job
        # that spends, plus an instruction to spend again, after a failure
        # ("too deep for the balance") that would fail identically. The
        # failure branch below already says that in the operator's words.
        #
        # gs_wake_agent._phase_of will not produce this today: its withdraw
        # branch returns "" unless the status is "done", and the comment there
        # says why. That is the first defence and this is the second, which is
        # the shape this repo uses everywhere the doorbell re-checks what the
        # vault sends -- the doorbell validates the phase WORD against a
        # closed table and does not tie it to the status, so a version skew or
        # a compromised vault is exactly the case that reaches here.
        _early = (pending.result or {}).get("phase") or ""
        if _early and out != "done" and job in ("watch", "swap_status"):
            # THE LABEL, NOT THE HANDLE. This one branch still printed the
            # raw four hex characters, so the one reply an operator gets while
            # a probe is still in flight named a string the bot would then
            # refuse from them.
            _eh = (pending.result or {}).get("handle") or ""
            try:
                _ecn = self._label(chat_id, _eh) if _eh else "----"
            except BaseException:                            # noqa: BLE001
                _ecn = "----"
            self.send(chat_id,
                      f"{_ecn}: {proto.PHASE_LINES.get(_early, _early)}")
            return
        if out == "done":
            res = pending.result or {}
            h = res.get("handle") or "----"
            # WHOSE HANDLE THIS IS. The vault has no notion of a chat at all --
            # `chat_id` appears nowhere in gs_wake_agent, gs_wake_proto or
            # gs_doorbell, deliberately, because the Pi is supposed to learn a
            # four-character label and nothing else. That is right for the
            # wire, and it means the handle NAMESPACE IS FLAT: a handle is a
            # bearer token, and /check or /wait on somebody else's returns
            # their deposit instructions.
            #
            # Driven against the real functions: seal_slip_for_delivery and
            # plain_slip_for_chat both take (key, artifact_dir, status, handle)
            # -- there is no chat argument to check an owner against -- and
            # with `plain_slip` on, a handle its owner never shared came back
            # as the deposit address, the amount and the memo, in the clear.
            # The memo names the destination XMR address in full.
            #
            # So the ownership lives HERE, on the box that knows which chat
            # asked. Process memory only, like convos and burn and for the same
            # reason: the SD card is the leak this box is designed around, and
            # a handle-to-chat map on it is a record of who asked for what.
            if proto.HANDLE_RE.match(h):
                self.handle_owner[h] = chat_id
                self.handle_job[h] = job
            # THE LABEL THIS CHAT SEES. Built once, here, so every branch
            # below prints the same string the buttons carry and the operator
            # can type back. "----" is what a reply with no usable handle got
            # before this existed and it still does; there is nothing to bind.
            try:
                _cn = self._label(chat_id, h)
            except BaseException:                            # noqa: BLE001
                _cn = h
            slip = res.get("slip") or ""
            plain = res.get("plain") or {}
            phase = res.get("phase") or ""
            # SCOPED TO THE WATCHING JOBS, and it used to catch everything.
            #
            # This branch renders the phase and RETURNS, which is right for a
            # status probe: the phase IS the whole answer. A finished
            # withdrawal now carries one too ("more_left"), and it is not the
            # answer -- the answer is that the money went, and the phase only
            # decides whether another leg follows. Unscoped, this swallowed the
            # completion message for every chained withdrawal and reported a
            # spend as if it were a probe.
            if phase and job in ("watch", "swap_status"):
                # A STATUS PROBE ANSWERS IN ONE SENTENCE and says nothing else.
                # The sentence comes from the protocol's own table so this box
                # cannot invent a reassurance, and the word it renders was
                # checked against a closed set by the doorbell before it got
                # here.
                self.send(chat_id,
                          f"{_cn}: {proto.PHASE_LINES.get(phase, phase)}",
                          buttons=self._phase_buttons(phase, h, job, chat_id))
                return
            # A FINISHED SPEND IS NOT A READY DEPOSIT, and it used to be
            # reported as one. With no slip and no plain, a completed
            # withdrawal fell through to the generic line below and said
            # "withdraw ready · slip A3F1" -- after sixteen hours, about money
            # that has already left the wallet.
            #
            # Both halves of that were wrong. "ready" is deposit vocabulary for
            # something that has not happened yet, on the one job where the
            # irreversible thing HAS happened; this repo already caught the
            # same error once, in PHASE_LINES, where shortening "The swap is
            # done" to "Done." "changed which noun it was about". And the
            # handle is a phantom: _dispatch writes handles[] only for
            # receive_and_quote and receive_new, so no withdrawal label is ever
            # registered, and /check or /wait on the one printed here answers
            # unknown_handle. It named a slip that does not exist and invited
            # an action that fails.
            #
            # THE SECOND SENTENCE IS THE ONE THAT SAVES MONEY. _funded_entry
            # deliberately takes the LARGEST SINGLE unlocked output rather than
            # summing -- summing would spend inputs from several subaddresses
            # in one transaction, which is permanent public proof they share an
            # owner. That is the right call and it means a withdrawal moves ONE
            # pile. Nothing said so, so an operator with money in three places
            # had two-thirds of it left behind with no indication.
            #
            # No balance and no count: this box has never been told either, and
            # the sentence is true whichever case they are in.
            if job == "withdraw":
                # "ONE ADDRESS AT A TIME" NAMED THE WRONG END OF THE JOB.
                #
                # /withdraw takes up to MAX_WAKE_EXIT_DESTS DESTINATIONS by
                # reply, and the confirm before it says "Send to the addresses
                # you just sent". Then the completion said "This moves ONE
                # address at a time", which reads as one of those destinations
                # -- so an operator who gave five is told four were skipped.
                # The next thing they do is run it again, and the second run
                # is a real spend of whatever else is on the wallet.
                #
                # The "one" is at the SOURCE end: _funded_entry takes the
                # largest single unlocked output rather than summing, because
                # summing spends inputs from several subaddresses in one
                # transaction and that is permanent public proof they share an
                # owner. Both ends are named now, in the words the operator
                # used for each: what they GAVE, and what money ARRIVED on.
                # THE CHAIN, AND WHY IT IS A CHAIN AND NOT ONE BIG SPEND.
                #
                # _funded_entry takes the LARGEST SINGLE unlocked output and
                # never sums: spending inputs from two subaddresses in one
                # transaction is permanent public proof they share an owner.
                # So one run empties one arrival, and that is not negotiable.
                #
                # What WAS wrong is that the operator was then left to notice,
                # and to drive the rest by hand, with no idea how many were
                # left -- so being paid a third of what they put in read as
                # the tool shortchanging them. The vault answers that question
                # now (phase "more_left"), and the pager just keeps going.
                # FROM start_job, NOT FROM THE SLOT. The first version read
                # the leg out of self._chain -- which _worker has already
                # cleared by the time this runs, so it was 0 on every leg: the
                # message said "2 of at most 6" forever and the cap never
                # fired. Driven with nine arrivals: nine mixes ran.
                _more = (res.get("phase") or "") == "more_left"
                _leg = self._chain_leg
                # SAID FROM NOWHERE, so it cannot lean on a conversation the
                # reader may not have in front of them.
                #
                # "sent -- all of it, to the addresses you gave" was written
                # as a reply to a question. This lands up to sixteen hours
                # after the confirm, on a phone, possibly after a reboot, and
                # "the addresses you gave" then reads as the bot assuming a
                # context the reader has to scroll for. It says what happened.
                # SHORT, AND THE REASON IS ONE CLAUSE.
                #
                # This was three lines of explanation on the message that
                # lands after a spend. What the reader needs is where they are
                # in the run and that more is coming; WHY it is split is one
                # clause, not a paragraph, and it is the clause that stops
                # "send it all at once" sounding like an improvement.
                # AND THE DENOMINATOR CAME BACK OUT. This read
                # "withdraw 1/6: sent", and 6 is MAX_CHAIN_LEGS -- a CAP, not
                # a total. Nothing knows the total: the run ends when the
                # wallet has no funded entry left, which is usually two or
                # three legs, so "1/6" promised six spends to somebody who was
                # going to get three and then read the third as the run having
                # stopped early. The cap has its own message when it actually
                # fires. A leg number alone is true at every leg.
                # THREE ENDINGS, AND THERE USED TO BE TWO FOR THREE STATES.
                #
                # The second condition was `_more` alone, so on the LAST leg
                # the cap allows -- more money on the wallet, no leg left to
                # spend it -- the operator was told "Starting the next one
                # now" and then, from the branch below, "Stopping after 6 in
                # a row". Two messages, seconds apart, contradicting each
                # other, at the end of a run that had moved real money six
                # times. Whether a next leg RUNS is `_more AND under the cap`,
                # which is exactly what the branch below already computed and
                # this line did not, so the two could disagree.
                #
                # Computed ONCE, here, and read by both.
                _next_leg = _more and _leg + 1 < self.MAX_CHAIN_LEGS
                _msg = (f"withdraw {_leg + 1} sent.\n"
                        + ("Next one starting — sending them together would "
                           "prove they are all yours."
                           if _next_leg else
                           f"More is here, but {self.MAX_CHAIN_LEGS} in a row "
                           f"is enough for one run — /withdraw again when you "
                           f"are ready."
                           if _more else
                           "That was the last. Wallet empty."))
                # ONE RETRY, like the slip path, and for a sharper reason.
                # This is the ONLY notification that a spend completed, at the
                # end of a job that ran for up to sixteen hours and moved real
                # money. send() does not retry on its own -- it returns whether
                # it landed -- so a single Tor circuit failing at the wrong
                # second leaves the operator with "working" as the last thing
                # they ever heard, which is the exact outcome the poll-failure
                # fix in updates() exists to prevent. Losing it to a dropped
                # POST after saving it from a closed socket would be absurd.
                #
                # One, not a loop: this still holds `busy`, and a retry storm
                # against a dead circuit would hold it for the rate limit's
                # whole window. The journal keeps the record either way.
                if not self.send(chat_id, _msg):
                    time.sleep(SLIP_RETRY_S)
                    if not self.send(chat_id, _msg):
                        integrity_log("pager", "withdraw_result_undelivered")
                # ARMED AFTER THE REPORT, NOT INSTEAD OF IT. If the send above
                # failed twice the operator has no idea a leg finished, and
                # starting another one silently is the worst thing this could
                # do -- so the chain is set here, below the report, and the
                # thread that acts on it is the one that just told them.
                #
                # NOT STARTED HERE. start_job takes `busy`, and this is
                # running inside the worker that holds it. _worker acts on
                # this slot after its finally releases the lock.
                if _next_leg:
                    self._chain = (chat_id, dict(params), _leg + 1)
                elif _more:
                    # THE CAP IS LOGGED HERE AND SAID ABOVE. A second send
                    # was what contradicted the first one; the sentence it
                    # carried now lives in _msg, chosen by the same _next_leg
                    # that decides whether a leg is actually armed.
                    integrity_log("pager", "chain_capped")
                return
            if plain and chat_id < 0:
                # A GROUP IS A BROADCAST SURFACE, AND A PAYLOAD IS NOT FOR ONE.
                #
                # main() allows a negative --chat-id when --user-id is given,
                # and the refusal text offers --user-id as the fix. --user-id
                # is consulted INBOUND ONLY -- handle() and handle_callback()
                # check who is driving. Every send() posts to chat_id, so with
                # plain_slip set in the vault's keyfile the whole deposit slip
                # went to the room. Driven with --chat-id -1001999999999
                # --user-id 555:
                #
                #   -> the room: "Send exactly: 0.05000000 BTC / To address:
                #      bc1q... / Expected out: ~1.2345 XMR"
                #   -> the room: "=:XMR.XMR:8ddd...ddd:0/1/0"
                #
                # -- the amount, the deposit address, and a memo naming the
                # destination XMR address in full, to everyone in the room.
                #
                # THE OPERATOR MADE THE plain_slip DECISION AT THE VAULT, and
                # it is a real one: this file's own argument is that the
                # transcript is assumed readable, so plaintext costs what it
                # costs. A group changes that bargain without asking them
                # again -- from "whoever ends up with my phone" to "these
                # twenty people, right now, by design". That is not a decision
                # the keyfile was making.
                #
                # The SEALED slip is still sent to a group: it is sealed to a
                # key nobody in the room holds, which is the whole argument
                # for putting one in a chat at all.
                integrity_log("pager", "plain_slip_withheld_group")
                self.send(chat_id,
                          f"{chat_name(job)}: quoted. Confirmation number: {_cn}\n"
                          f"The deposit details are NOT posted here — this is "
                          f"a group, and they would go to everyone in it. "
                          f"Read them at the machine, or set up a delivery "
                          f"key and use a one-to-one chat.",
                          buttons=self._handle_buttons(h, job, chat_id))
                return
            if plain:
                # THE DEPOSIT INSTRUCTIONS, IN THE CLEAR, because the operator's
                # own vault keyfile asked for it. gs_wake_proto's "THE PLAINTEXT
                # SLIP" is where that trade is argued; this branch only renders
                # it. Two messages: the memo must be copied alone (see below).
                # ONE MESSAGE, BECAUSE THERE IS NO LONGER A SECOND.
                #
                # This used to send the body and then the MEMO on its own,
                # with a retry and a "do NOT send without it" fallback,
                # because the memo had to reach a wallet character for
                # character. The memo does not travel any more -- see
                # gs_wake_proto.PLAIN_FIELDS -- so all of that goes with it:
                # the second send, the retry, the failure warning, and the one
                # field in this record that named the operator's destination.
                self.send(chat_id,
                          f"{chat_name(job)}: pay this. Confirmation "
                          f"number: {_cn}\n\n"
                          + "\n".join(proto.plain_lines(
                              plain, label=_cn)).rstrip(),
                          buttons=self._handle_buttons(h, job, chat_id))
                return
            if not slip:
                # A MINTED ADDRESS IS NOT A READY DEPOSIT, AND THIS SAID IT
                # WAS. receive_new produces a Monero subaddress and NOTHING
                # ELSE: no quote, so no thor_pairs file, so nothing for
                # seal_slip_for_delivery or plain_slip_for_chat to send --
                # both return empty on it by design ("receive_new quotes
                # nothing"). Driven with plain_slip ON and a delivery key
                # configured: the chat got "address ready · slip B7C2" and the
                # address reached it in neither form.
                #
                # So the command whose entire purpose is to hand the operator
                # an address to be paid at delivered no address, and said
                # "ready" about it. That is the same defect this file already
                # fixed once for a finished withdrawal: "'ready' is deposit
                # vocabulary for something that has not happened yet", used on
                # a job where the thing the operator wanted did not arrive.
                #
                # WHAT IS TRUE INSTEAD: the address exists on the machine, the
                # label works with /check, and this chat is not carrying it.
                # Saying so is worth more than a reassuring word -- an
                # operator who believes an address is on its way waits for a
                # message that is never coming.
                # "READY" WAS THE WORD, AND NOTHING SAID READY FOR WHAT.
                #
                # No delivery key is configured, so the address and the memo
                # are on the machine and nothing here can carry them. That is
                # the NORMAL case -- and on the topology this is actually
                # deployed on, one laptop and one Pi, it is the only case:
                # a delivery key wants a THIRD machine, the one you send the
                # BTC from, and sealing to a key held on the machine that
                # sealed it buys nothing.
                #
                # It does not need to travel. The memo goes in an OP_RETURN,
                # which a phone wallet cannot compose, so the operator has to
                # be at a desktop wallet to pay at all -- and that is the same
                # machine the address is already sitting on.
                #
                # So the reply stops implying a slip arrived and says the two
                # things the operator does next: where it is, and that paying
                # needs the desktop wallet. "depo ready · slip A3F1" said
                # neither, and read as "your deposit is set up" to somebody who
                # then had nothing to pay to.
                self.send(chat_id,
                          f"{chat_name(job)}: quoted. Confirmation number: {_cn}\n"
                          f"The address and memo are ON THE MACHINE — read "
                          f"them there. Paying needs a desktop wallet: the "
                          f"memo goes in an OP_RETURN and no phone wallet can "
                          f"do that.\n"
                          f"/check {_cn} once you have paid.",
                          buttons=self._handle_buttons(h, job, chat_id))
                return
            # A SEALED SLIP CAME BACK. This process cannot read it: it is
            # sealed to the delivery key, which exists on neither this box nor
            # this SD card. See gs_wake_proto's "THE SEALED SLIP" for why that
            # is not the thing §8 forbids.
            #
            # THE BLOB GOES FIRST, AND THE CAPTION DESCRIBES WHAT ACTUALLY
            # HAPPENED. Sending the caption first meant promising a slip
            # before knowing one could be delivered: a dropped second send
            # left "Sealed slip below" with nothing below it, and the only
            # record of the failure was a print() that the shipped unit sends
            # to StandardOutput=null. Now the caption is written after the
            # fact and tells the truth either way.
            #
            # The blob is sent ALONE, with nothing else in the message, and
            # that is a usability decision with a security consequence:
            # tap-and-hold on a Telegram message copies the WHOLE message, so
            # a caption sharing the message would be pasted into gs_unseal
            # along with the slip. open_slip's length check would catch it,
            # but being caught is worse than not happening.
            # ONE RETRY BEFORE GIVING UP. The blob is already in hand and a
            # Tor circuit failing for one request is ordinary; telling the
            # operator to go to the vault because a single POST lost a race is
            # advice this whole feature exists to avoid having to give. One,
            # not a loop: a wake holds `busy` while this runs, and a retry
            # storm against a dead circuit would hold it for the rate limit's
            # entire window.
            ok = self.send(chat_id, slip)
            if not ok:
                time.sleep(SLIP_RETRY_S)
                ok = self.send(chat_id, slip)
            if ok:
                # THE CAPTION CARRIES THE BUTTONS, NOT THE BLOB. The blob is
                # sent alone on purpose -- tap-and-hold copies a whole Telegram
                # message -- and a keyboard under it would be one more thing
                # attached to the message the operator is about to long-press.
                self.send(chat_id,
                          f"{chat_name(job)}: pay the message above. "
                          f"Confirmation number: {_cn}",
                          buttons=self._handle_buttons(h, job, chat_id))
            else:
                integrity_log("pager", "slip_undelivered")
                # NOT "/watch {h}". That was the first version of this line and
                # it is wrong: watch waits for a payment to LAND on a bundle,
                # so it cannot hand back a deposit address the operator never
                # received -- it would sit for two hours waiting for money that
                # was never sent. The quote is unpayable from here, and a
                # ThorChain quote expires anyway, so the honest instruction is
                # to ask for a new one.
                self.send(chat_id,
                          f"{chat_name(job)} {_cn}\n"
                          f"Did not get through, twice — and it expires. "
                          f"/depo again for a fresh one.")
        elif out == "refused":
            # A REFUSAL IS THE ONE ENDING WHERE "NOTHING RAN" IS CERTAIN, and
            # for a spend that is the fact the operator most needs. Refused is
            # raised in preflight and in the dispatcher's own checks, always
            # BEFORE the first child process starts -- a failure inside a
            # child reports "failed", not "refused" -- so this can say it
            # without guessing.
            # "TRY /status, THEN AGAIN" WAS ADVICE THAT IS WRONG HALF THE
            # TIME, and wrong in the direction that costs the operator the
            # thing it is telling them to spend.
            #
            # Refusals come from two kinds of cause and this end cannot tell
            # them apart, because the reason is deliberately not on the wire:
            #
            #   * TRANSIENT -- the daily wake budget is used up, the network
            #     was not reachable. Waiting fixes it.
            #   * PERMANENT UNTIL SOMEBODY IS AT THE MACHINE -- the wallet has
            #     hit its account ceiling so no address can be minted at all,
            #     the keyfile does not allow spending, the wallet cannot be
            #     counted. Retrying refuses identically, forever, and every
            #     attempt spends part of the same daily budget.
            #
            # The account ceiling is the one that turns this into a trap: it
            # makes /deposit and /address refuse every single time, and the
            # old message told the operator to keep going.
            #
            # SO IT SAYS THE SHAPE OF BOTH AND PICKS NEITHER. "Refused twice
            # the same way, stop" is the rule that is right for both kinds,
            # and it needs no reason from the wire to be true.
            self.send(chat_id,
                      f"{chat_name(job)}: refused before it started"
                      + (" — nothing was spent and nothing moved."
                         if job == "withdraw" else ".")
                      + " It does not say why.\n"
                        "If a second try is refused the same way, stop — some "
                        "refusals need somebody at the machine, and each try "
                        "costs part of the daily allowance.",
                      buttons=MENU_BUTTONS)
        elif out == "failed":
            # A FAILED WITHDRAWAL GETS THE ONE THING THE OPERATOR CAN ACT ON.
            #
            # "withdraw: failed." is the whole message they get after waiting
            # out a boot and 5-20 minutes of mandatory jitter, and it leaves
            # them with no next move. The commonest cause is the one the depth
            # menu exists for: the mix minimum rises with the hop count, so a
            # balance that cannot fund 20 hops can often fund 3, and
            # GhostSpiral refuses at stage 4 with nothing spent. Its own
            # message says exactly that -- and it says it on the vault's
            # console, which is the machine nobody is standing at.
            #
            # A STATIC HINT, NOT A DIAGNOSIS, and the difference is deliberate.
            # This box does not know why the run failed and must not guess: it
            # has never been told a balance, and reading one back into the chat
            # is the thing /settings refuses to do. So it names the cause the
            # operator can do something about and says nothing about which
            # actually occurred. "may be" is doing real work in that sentence.
            #
            # Withdrawals only. The deposit jobs mint and quote; a depth is not
            # a thing they have, and offering this advice there would be a
            # confident answer to a question nobody asked.
            # AND IT MUST NOT IMPLY THE MONEY IS SAFE. "failed" means the run
            # started and did not finish, and a run can stop at any point --
            # planning, which spends nothing, or mid-round, which does not.
            # This box has never been told a balance and cannot tell those
            # apart, so it says both are possible rather than picking the
            # comfortable one. The depth hint stays because it is the cause
            # the operator can act on; "may be" is doing real work in it.
            _tail = (" It may be too deep for the balance — the deeper "
                     "options need more to work with.\n"
                     "Some of it may already have moved: a run can stop "
                     "before it spends anything or part-way through, and "
                     "this end cannot tell which. CHECK THE BALANCE before "
                     "running it again."
                     if job == "withdraw" else "")
            self.send(chat_id, f"{chat_name(job)}: failed.{_tail}",
                      buttons=MENU_BUTTONS)
        elif out == "expired_uncollected":
            # ONE TRUE THING, NOT TWO. This job was never handed over, so THIS
            # attempt cannot have started anything. That is what the pager
            # knows.
            #
            # "your funds are exactly where they were" is a claim about the
            # WALLET, and there is nothing behind it. This box has never been
            # told a balance, and it keeps no record that a wake is in flight:
            # `busy` is process memory, and the shipped unit has
            # Restart=on-failure. So the reachable false case is ordinary --
            # the pager dies during a withdrawal and comes back, the vault is
            # still mixing, the next magic packet lands on a machine that is
            # already up and nothing collects it -- and the operator is told
            # their funds are exactly where they were, and invited to retry.
            #
            # The `refused` branch above gets this right and defends itself as
            # "THE ONE ENDING WHERE 'NOTHING RAN' IS CERTAIN". It is certain
            # there because the vault said so. Here nobody said anything.
            self.send(chat_id,
                      f"{chat_name(job)}: never picked up, so nothing ran"
                      + (" — THIS attempt spent nothing. I keep no record "
                         "of an earlier one, so check the balance before "
                         "starting another."
                         if job == "withdraw" else ". Try again."),
                      buttons=MENU_BUTTONS)
        else:
            # collected_no_result: THE ONE ENDING THAT MUST NOT INVITE A
            # RETRY. The job WAS handed over and then nothing came back for
            # the whole window -- up to 16.5 h on a withdrawal. It may have
            # completed and lost its answer; it may have died half-way. Both
            # readings are live, and the difference between them is whether
            # running it again spends the same money twice.
            #
            # "Check before trying again" was the whole of this message, which
            # is true and does not say what to check or what the risk of not
            # checking is.
            if job == "withdraw":
                integrity_log("pager", "withdraw_unresolved")
                self.send(chat_id,
                          "withdraw: it was picked up and never reported "
                          "back.\n"
                          "I do NOT know whether the funds moved. Both are "
                          "possible: it may have finished and lost the reply, "
                          "or stopped part-way.\n"
                          "Do not run /withdraw again until you have checked "
                          "the balance yourself — a second run could spend "
                          "what the first one already sent.",
                          buttons=MENU_BUTTONS)
            else:
                self.send(chat_id,
                          f"{chat_name(job)}: picked up, then no answer came "
                          f"back. Check before trying again.",
                          buttons=MENU_BUTTONS)

    def _worker(self, chat_id: int, job: str, params: dict) -> None:
        """The wake, on its own thread. THE REPORT MUST SURVIVE EVERYTHING.

        This was try/finally with no except, so anything poke() raised killed
        the thread silently: `busy` was released by the finally, the pager
        went on answering /status with "ready", and the operator got nothing.
        Under the shipped unit's StandardOutput=null the traceback went
        nowhere either.

        Driven with a full SD card at the moment a withdrawal reported back --
        integrity_log re-raises OSError, and poke() writes the chain BEFORE
        every reply branch:

            messages the operator received: []
            busy released (pager looks healthy): True
            worker thread alive: False

        -- after 16.5 hours, on the job that spends everything. One screen
        below, the slip and withdraw paths retry their sends specifically so
        that this message cannot be lost to one bad circuit; losing it to one
        bad bookkeeping write instead would be absurd.

        SO THE OPERATOR IS TOLD SOMETHING, ALWAYS. This box does not know what
        happened -- the exception could have come before or after the wake --
        so it says exactly that rather than guessing a comfortable answer, and
        it is careful not to imply the money is safe.
        """
        try:
            self.poke(chat_id, job, params)
        except BaseException as e:                           # noqa: BLE001
            # send() itself may be what failed. It never raises (it returns
            # whether it landed), but this is the last line of defence and it
            # must not become the thing that eats the exception silently.
            try:
                self.send(chat_id,
                          f"{chat_name(job)}: it ran and this end then "
                          f"failed to report it cleanly "
                          f"({_redact(e)[:80]}).\n"
                          f"I cannot tell you whether it finished. Check "
                          f"before starting another one.",
                          buttons=MENU_BUTTONS)
            except BaseException:                            # noqa: BLE001
                pass
            try:
                integrity_log("pager", "worker_crashed")
            except BaseException:                            # noqa: BLE001
                pass
            raise
        finally:
            self._running = None
            self.busy.release()
            # THE NEXT LEG, AFTER THE LOCK IS FREE. poke() cannot start it: it
            # runs inside this thread, which holds `busy`, and start_job takes
            # `busy`. So the slot is set there and acted on here, one line
            # after the release.
            #
            # THROUGH start_job LIKE EVERYTHING ELSE -- not a direct _worker
            # call. That is where the rate limit is charged, where the
            # one-spender rule is re-checked and where the busy lock is taken,
            # and a chain that went round it would be a second path to a wake
            # with none of those. If the limit refuses, the operator is told
            # in start_job's own words and the chain simply stops.
            _next, self._chain = self._chain, None
            if _next:
                _cid, _params, _leg = _next
                # NO ANNOUNCEMENT HERE ANY MORE, AND IT IS NOT A LOST
                # MESSAGE. This sent "withdraw: starting the next one (2 of
                # at most 6)" moments after the completion message had
                # already said "Next one starting" -- two messages for one
                # event, on the surface this design spends its effort keeping
                # short, and the parenthesis named the CAP as though it were
                # a total. The completion message is the one with the retry
                # and the one that says a spend finished, so it is the one
                # that keeps the job.
                try:
                    self.start_job(_cid, "withdraw", _params, leg=_leg)
                except BaseException:                        # noqa: BLE001
                    # A chain that cannot continue is not a failure of the leg
                    # that just succeeded, and must never be reported as one.
                    #
                    # BUT IT IS SAID. The operator has just been told "Next
                    # one starting"; a chain that then dies in here used to
                    # leave that sentence as the last thing they ever heard,
                    # with money still on the wallet and nothing running --
                    # the silent zero, on the one surface they can see. A
                    # refusal from start_job's own rate limit is NOT this
                    # path: that is spoken there and returns normally.
                    try:
                        integrity_log("pager", "chain_start_failed")
                    except BaseException:                    # noqa: BLE001
                        pass
                    try:
                        self.send(_cid, "the next one did not start. Nothing "
                                        "else was sent — /withdraw again "
                                        "when you are ready.")
                    except BaseException:                    # noqa: BLE001
                        pass

    # -- loop -----------------------------------------------------------
    def answer_callback(self, cb_id, text: str = "") -> None:
        """Close a tapped button's spinner. Never raises.

        REQUIRED, not cosmetic: the Bot API holds the client's spinner for
        about thirty seconds on an unanswered callback_query, so a button that
        works but is not acknowledged reads as a button that hung. Failing to
        acknowledge costs only the spinner -- the work has already been done by
        the time this is called -- so this never turns a completed action into
        a reported failure.

        `text` becomes a toast on the tapper's own screen and is NOT a message
        in the chat: nothing here reaches the transcript, so it is the one
        place this bot can say something to a person without writing it down.
        Used for refusals, which is exactly what should not be permanent.
        """
        try:
            safe_post(self._url("answerCallbackQuery"),
                      {"callback_query_id": str(cb_id), "text": text[:190]},
                      proxies=self.proxies)
        except Exception as e:                               # noqa: BLE001
            print(f"  [!] callback ack failed: {_redact(e)}")

    def handle(self, upd: dict) -> None:
        cb = upd.get("callback_query")
        if isinstance(cb, dict):
            self.handle_callback(cb)
            return
        msg = upd.get("message")
        if not isinstance(msg, dict):
            return
        chat = msg.get("chat") or {}
        cid = chat.get("id")
        if not isinstance(cid, int) or cid not in self.allow:
            # NOT replied to. Answering an unknown chat confirms the bot is
            # alive to whoever found it, and the token is the only thing
            # standing between a stranger and this loop.
            self.ignored += 1
            integrity_log("pager", "chat_not_allowlisted")
            return
        # AND WHO SENT IT, which the chat id does not answer in a group.
        #
        # chat.id is the ROOM. In a private chat it equals the sender's user id,
        # so the check above already gates the person; in a group every
        # member's message carries the same chat.id and the check above gates
        # nobody. Driven before this existed: three different `from` ids in one
        # allowlisted group were all answered, and a non-operator walked the
        # /send wizard through to a job on the wire.
        #
        # SILENT, like the chat refusal above and for the same reason -- a
        # reply tells whoever tried that the bot is alive and that they found a
        # live allowlist entry. The counter is what the operator reads.
        #
        # Empty allow_users means every allowlisted chat is private (main()
        # refuses a group without --user-id), so this costs those installs
        # nothing.
        if self.allow_users:
            _from = (msg.get("from") or {}).get("id")
            if not isinstance(_from, int) or isinstance(_from, bool) \
                    or _from not in self.allow_users:
                self.ignored += 1
                integrity_log("pager", "sender_not_allowlisted")
                return
        # A PHOTO IS NOT A COMMAND. Without this, every sticker, image or
        # voice note in an allowlisted chat drew the whole help text back --
        # noise in the one channel that is supposed to be almost silent, and
        # a reply to something nobody typed.
        if not isinstance(msg.get("text"), str):
            return
        # THE OPERATOR'S OWN MESSAGE IS TRACKED TOO, and it is the half that
        # matters more. The bot's replies are deliberately boring; the COMMANDS
        # are what say a swap was quoted at 03:12 and again at 03:40. Recorded
        # here rather than in send(), because nothing this program sends
        # produced it.
        #
        # AFTER the allowlist and the is-it-text gates, so a stranger's traffic
        # never enters this list -- deleting a message in a chat that is not
        # allowlisted is an action taken on behalf of somebody who was refused.
        _mid = msg.get("message_id")
        if isinstance(_mid, int) and not isinstance(_mid, bool):
            self.burn.append((cid, _mid, time.time()))
        # A LIVE CONVERSATION GETS FIRST REFUSAL on the message, because a bare
        # "2" is an answer and not a command. It hands back anything starting
        # with "/" (and drops itself when it does), so a real command is never
        # eaten by a half-finished /depo.
        # WHETHER ONE WAS LIVE, READ BEFORE step_convo TOUCHES IT. /cancel is
        # the one command whose entire job is to confirm nothing is armed, so
        # it must report on the pop that ACTUALLY happened. The first version
        # matched "/cancel" literally inside step_convo, which meant the group
        # form this file supports -- "/cancel@mybot" -- was cancelled by the
        # "/" branch and then answered "nothing to cancel".
        self._reap()
        had_convo = cid in self.convos
        if self.step_convo(cid, msg["text"]):
            return
        job, params, err = parse_command(msg["text"])
        if err == "depo_wizard":
            self.begin_convo(cid)
            return
        if err == "withdraw_wizard":
            self.begin_convo(cid, kind="withdraw")
            return
        if err == "cancel":
            self.convos.pop(cid, None)
            # THREE ANSWERS, BECAUSE THERE ARE THREE STATES. This had two, and
            # the missing one is the state an operator is most likely to be in
            # when they type /cancel: a wake already running.
            #
            # A conversation is cancellable and a WAKE IS NOT -- the vault has
            # collected the job and is executing it on a machine nothing here
            # can reach. But answering "nothing to cancel" while a withdrawal
            # holds `busy` for the better part of a day is the bot flatly
            # contradicting itself: the very next command answers "a wake is
            # already running". The operator is told nothing is happening and
            # then refused because something is.
            #
            # So the third answer says what is true -- something IS running,
            # it cannot be stopped from here, and this is why everything else
            # is being refused. `busy` is checked AFTER the conversation pop,
            # because cancelling a half-typed wizard is still possible and
            # still worth confirming while a job runs.
            if had_convo:
                self.send(cid, "cancelled. Nothing was started.")
            elif self.busy.locked():
                self.send(cid,
                          "nothing half-typed to cancel — but something IS "
                          "running, and it cannot be stopped from here. The "
                          "machine has the job and is working through it; "
                          "that is also why other commands are being "
                          "refused. It will report back when it finishes.")
            else:
                self.send(cid, "nothing to cancel.")
            return
        if err == "settings":
            self.send(cid, self._settings_text())
            return
        if err == "fee":
            self.send(cid, FEE_ANSWER)
            return
        if err == "speed":
            self.send(cid, SPEED_ANSWER)
            return
        if err == "exit":
            self.send(cid, EXIT_ANSWER)
            return
        if err == "welcome":
            # THE ONE MESSAGE EVERY OPERATOR GETS FIRST. See WELCOME_LINES for
            # what it says and, more importantly, what it deliberately does
            # not. Rendered against THIS pager's --burn-after, so the line
            # about deletion appears only on an install that deletes.
            self.send(cid, welcome_text(self.burn_after, self.key),
                      buttons=MENU_BUTTONS)
            return
        if err == "help":
            # THE MENU RIDES ON /help TOO, because somebody who typed it is
            # deciding what to do next. Every button is a command in the list
            # above it, so the list is still the manual and the buttons are
            # just the short way to say the same four things.
            self.send(cid, HELP, buttons=MENU_BUTTONS)
            return
        if err == "whats_running":
            # "IS ANYTHING HAPPENING?" -- ANSWERED, RATHER THAN CORRECTED.
            #
            # /check and /wait with no argument used to answer "handle must be
            # 4 hex characters": a word this chat says nowhere else, about a
            # thing it never showed anyone how to find. Somebody typing /check
            # on its own is asking whether anything is going on, and this box
            # knows -- it holds the job lock and it minted every label in this
            # chat. Answered from memory: no wake, no boot, no daily slot.
            #
            # NOTHING ABOUT ANY OTHER CHAT. handle_owner is filtered by cid
            # before it is counted, so this cannot leak that somebody else has
            # something running -- and `busy` is deliberately not consulted for
            # that reason: it is process-wide, so reporting it here would tell
            # one chat that another one is mid-job.
            _mine = [_k for _k, _v in self.handle_owner.items() if _v == cid]
            if self._running == cid:
                self.send(cid, "one is running now. Nothing else can start "
                               "until it reports, and it will report here.",
                          buttons=MENU_BUTTONS)
                return
            if _mine:
                _last = _mine[-1]
                self.send(cid,
                          f"nothing is running. The last one in this chat is "
                          f"{self._label(cid, _last)} — tap below to ask "
                          f"about it.",
                          buttons=self._handle_buttons(
                              _last, self.handle_job.get(_last, ""), cid))
                return
            self.send(cid, "no mixes are running and none have been started "
                           "in this chat. /deposit is the way in.",
                      buttons=MENU_BUTTONS)
            return
        if err == "status":
            # WHETHER A COMMAND WILL BE ACCEPTED, and nothing else.
            #
            # This printed the poke count for the last 24 hours and
            # "busy: True/False". The count is how many deposits were started
            # today; busy is whether the machine is powered on AT THIS MOMENT,
            # which is the single most useful fact to anyone deciding when to
            # knock on a door. Both sat permanently in the transcript, on a
            # command that exists to answer "can I send one".
            #
            # "ready" or "wait Ns" answers that and discloses no history and no
            # power state -- a busy pager and a rate-limited one both say wait,
            # which is also true.
            # ...AND IT IS THE ONE COMMAND WITH NO COST TO SEND.
            #
            # start_job charges the rate limit, and /status never reaches it --
            # so this was free and unlimited. It wakes nothing, so it cannot
            # spend the vault's budget; what it DOES spend is one Telegram POST
            # over Tor per tap, on a Pi with 1 GB of RAM, from a button that
            # sits under almost every message this bot sends. A thumb resting
            # on it is a Tor circuit per second.
            #
            # A COOLDOWN, NOT A BUDGET. The honest answer to "can I start one"
            # cannot change faster than this, so repeating inside the window
            # would return the same word anyway. Answered from memory, with no
            # reply at all on the second tap: a "slow down" line is itself a
            # message, which is the thing being rationed.
            # None, NOT 0.0, AND THAT IS NOT A STYLE CHOICE. The first
            # version initialised this to 0.0 and compared `clock() - 0.0`.
            # self.clock is time.monotonic, which counts from an arbitrary
            # point -- on a freshly booted Pi it is a small number, so the
            # FIRST /status after start was inside its own cooldown and was
            # silently swallowed. "Never answered" is a different state from
            # "answered at time zero", and it has to be spelled differently.
            # PER CHAT, NOT PER PROCESS. One slot meant chat A tapping
            # Status silenced chat B for the next fifteen seconds -- with NO
            # reply, because the whole point of the cooldown is that a "slow
            # down" line is itself a message. So one device's thumb made
            # another device look broken, which is the cross-chat interference
            # this box is supposed not to have.
            #
            # The dict is bounded by the allowlist, which main() bounds, so
            # this cannot grow: it is at most one float per allowed chat.
            _now = self.clock()
            _last = self._status_at.get(cid)
            if _last is not None and _now - _last < self.STATUS_COOLDOWN_S:
                integrity_log("pager", "status_throttled")
                return
            self._status_at[cid] = _now
            # THE GATE THIS ANSWER DID NOT KNOW ABOUT.
            #
            # start_job refuses on THREE things and this read two of them. The
            # third -- more than one person allowlisted against one wallet --
            # refuses EVERY job unconditionally, so on a bot configured that
            # way "can I start one right now" answered "ready" and then every
            # single command came back refused. That is the worst shape a
            # status answer can have: confidently wrong about the one gate
            # that never clears on its own.
            #
            # Short, because this is a status answer. The reason in full is on
            # the refusal itself, where somebody has actually tried to do
            # something.
            if self.spenders > 1:
                self.send(cid, "not ready: more than one person is "
                               "allowlisted and there is one wallet behind "
                               "this. Nothing will run.",
                          buttons=MENU_BUTTONS)
                return
            _why = self.limits.why_not()
            # THE ANSWER IS STILL ONE WORD. The buttons are what the operator
            # asked "can I start one right now" in order to do next, and
            # attaching them adds nothing to the transcript: a label on a
            # button is not a line in the chat.
            self.send(cid, _why if _why
                      else ("wait" if self.busy.locked() else "ready"),
                      buttons=MENU_BUTTONS)
            return
        if err == IGNORE:
            # NOTHING GOES BACK. Counted, so a burst of them is visible in the
            # chain and in /status's own bookkeeping rather than vanishing --
            # silence is the reply, not the absence of one.
            self.ignored += 1
            integrity_log("pager", "unknown_command")
            return
        if err:
            # A BARE NUMBER WITH NO LIVE CONVERSATION is the commonest way to
            # get here, and "unknown command" plus the whole help text is the
            # wrong answer to it. It means the operator walked away, came back
            # past the TTL, and typed the slot they had already decided on.
            # Tell them that, rather than making them work it out.
            # isdecimal here too. This one only decides WHICH refusal is
            # printed, so the old predicate could not raise -- but a
            # superscript would have been told "unknown command" plus the whole
            # help text instead of "your /depo expired", which is the answer
            # this branch exists to give.
            if msg["text"].strip().isdecimal():
                # AND NOT "/depo <slot>". The one-shot form was removed --
                # see parse_command -- so this told an operator who had
                # just mistyped to use a form that answers
                # "just /depo — it asks".
                self.send(cid, "no live /deposit — it expired or was "
                               "cancelled. Start again with /deposit.")
                return
            # THE ERROR, NOT THE MANUAL. Appending HELP to every typo put the
            # full command list -- including the memo line -- into the chat
            # again on each mistake, which is the same paragraph repeated into
            # the readable surface for no new information. /help still exists
            # and still prints it once, on request.
            self.send(cid, f"no: {err}")
            return
        # A HANDLE IS A BEARER TOKEN ON THE WIRE, so it is bound to a chat
        # here. See the note beside handle_owner: the vault answers /check and
        # /wait for ANY handle in its file, because it has no idea which chat
        # asked -- and with `plain_slip` on, the answer is the deposit address
        # and the memo, and the memo names the destination XMR address in full.
        #
        # ONLY A HANDLE THIS PROCESS HAS SEEN GO TO SOMEBODY ELSE. An unknown
        # one is allowed: the map is process memory, so a restart empties it,
        # and refusing there would lock an operator out of their own swap on
        # the one box whose whole job is to be reachable. That is the honest
        # bound -- this closes the live case, not the whole namespace.
        # THE LABEL BECOMES A HANDLE HERE, OR IT DOES NOT TRAVEL.
        #
        # parse_command hands over the TEXT because only this box knows which
        # chat is asking, and a confirmation number means nothing outside the
        # chat it was issued to. Two forms are accepted and they are not
        # equally trusted:
        #
        #   * A CONFIRMATION NUMBER verifies against a MAC over (chat, handle),
        #     so it works after a restart and only here. This is the one the
        #     chat is shown and the buttons carry.
        #   * A BARE HANDLE is accepted only while THIS PROCESS still
        #     remembers minting it FOR THIS CHAT. It is what the vault's own
        #     terminal prints, so an operator standing at the machine can use
        #     it; once the process forgets, it is refused rather than sent,
        #     because an unremembered bare handle is exactly the bearer token
        #     the confirmation number exists to retire.
        if isinstance(params, dict) and params.get("confirmation") is not None:
            _text = str(params.pop("confirmation"))
            _h = handle_from_confirmation(self.key, cid, _text)
            if not _h:
                _bare = _text.strip().upper()
                if HANDLE_RE.match(_bare) and self.handle_owner.get(_bare) == cid:
                    _h = _bare
            if not _h:
                integrity_log("pager", "handle_not_yours")
                # NEVER "that is somebody else's", and never "the tag is
                # wrong": both confirm the handle exists. One answer for
                # every way of not being entitled to it.
                self.send(cid,
                          "no: I have no record of that confirmation number "
                          "in this chat. It is in the message that started "
                          "the deposit — or /check on its own and I will say "
                          "what is running.",
                          buttons=MENU_BUTTONS)
                return
            params["handle"] = _h
        _h = params.get("handle") if isinstance(params, dict) else None
        if _h:
            # REFUSED HERE, NOT AFTER A BOOT. This box recorded which job
            # minted the label; the vault refuses every watching job on an
            # /address one, always, for a structural reason that no setting
            # changes. Sending the wake anyway costs a magic packet, a boot, a
            # 5-20 minute jitter and one of twelve daily slots, and returns a
            # refusal with no reason on it -- which reads as "try again".
            if self.handle_job.get(_h) in self.UNWATCHABLE_JOBS:
                integrity_log("pager", "unwatchable_handle")
                self.send(cid,
                          f"no: that one is an address, not a deposit, and "
                          f"nothing here can watch an address — there is no "
                          f"expected amount to watch for. Check it at the "
                          f"machine.",
                          buttons=MENU_BUTTONS)
                return
            _owner = self.handle_owner.get(_h)
            if _owner is not None and _owner != cid:
                integrity_log("pager", "handle_not_yours")
                # NEVER "that is somebody else's": confirming a handle exists
                # is the disclosure. Same answer an unknown one gets.
                self.send(cid, "no: I have no record of that confirmation "
                               "number in this chat.")
                return
        self.start_job(cid, job, params)

    def handle_callback(self, cb: dict) -> None:
        """One tapped button. Turns into the text the typed path already takes.

        THE SENDER CHECK IS NOT OPTIONAL HERE, and this is where it earns its
        keep. A message in a group carries the group's chat id, which is why
        --user-id exists; a callback_query carries the same chat id AND a
        `from` that is the person whose thumb it was. In a room, a button this
        bot drew for the operator sits in front of every member -- including
        the one on the /send wizard. So the same two gates run, in the same
        order, before the data is even looked at.

        THE REFUSALS ARE TOASTS, NOT MESSAGES. answerCallbackQuery puts text on
        the tapper's own screen and writes nothing to the transcript, so a
        wrong tap leaves no line in the one surface this file cannot delete.
        The exception is a chat that is not allowlisted at all: that gets no
        answer whatsoever, because acknowledging it confirms the bot is alive
        to whoever found it -- the same rule the message path follows.
        """
        _id = cb.get("id")
        _msg = cb.get("message") or {}
        cid = (_msg.get("chat") or {}).get("id")
        if not isinstance(cid, int) or isinstance(cid, bool) \
                or cid not in self.allow:
            self.ignored += 1
            integrity_log("pager", "chat_not_allowlisted")
            return
        if self.allow_users:
            _from = (cb.get("from") or {}).get("id")
            if not isinstance(_from, int) or isinstance(_from, bool) \
                    or _from not in self.allow_users:
                self.ignored += 1
                integrity_log("pager", "sender_not_allowlisted")
                # ANSWERED, unlike the message path, and the difference is
                # deliberate: this person is already in an allowlisted room and
                # already knows the bot is there -- they can see the button.
                # Nothing is disclosed by saying no, and a silent tap that
                # spins for thirty seconds reads as a broken bot rather than as
                # a refusal.
                if _id is not None:
                    self.answer_callback(_id, "Not for you.")
                return
        _text, _err = parse_callback(cb.get("data"))
        if _err:
            integrity_log("pager", "callback_unknown")
            if _id is not None:
                self.answer_callback(_id, f"no: {_err}")
            return
        # A DEPTH BUTTON IS ONLY A DEPTH WHILE SOMETHING IS ASKING FOR ONE.
        #
        # parse_callback turns a tap into "the text the typed path would have
        # received", which is what makes a tap and a typed command identical
        # everywhere else. For the depth menu that text is a BARE DIGIT, and a
        # bare digit means whatever the live conversation is currently reading
        # digits as.
        #
        # Telegram keyboards do not expire. The depth menu stays under its
        # message for as long as the message exists, so:
        #
        #     /withdraw -> address -> (depth menu drawn)
        #     ...abandoned, /deposit typed instead
        #     the operator scrolls up and taps "20 hops"
        #     -> the wizard reads "3" as THREE BITCOIN and asks them to
        #        confirm a deposit two orders of magnitude out
        #
        # Driven before this existed: the tap produced "Deposit 3 BTC" and a
        # confirm sum, which the operator is primed to answer because they had
        # just tapped a button and a question appeared.
        #
        # THE MEANING IS CHECKED, NOT THE VALUE. parse_callback already refuses
        # a depth the protocol does not offer; that is a check on the number
        # and this is a check on whether a number was asked for at all. A tap
        # that no live question is waiting for changes nothing and says so on
        # the tapper's own screen.
        if str(cb.get("data") or "").startswith("d:"):
            _c = self.convos.get(cid)
            if not (_c and _c.alive(self.clock) and _c.awaiting_depth()):
                integrity_log("pager", "callback_depth_stale")
                if _id is not None:
                    self.answer_callback(
                        _id, "no: that button is from an earlier question. "
                             "Nothing changed.")
                return
        # ACKNOWLEDGED FIRST, then the work. start_job can hold this thread
        # long enough for the spinner to time out on its own -- it takes the
        # busy lock and posts to the doorbell over Tor -- and a spinner that
        # expires while the job is being started tells the operator the
        # opposite of what happened.
        if _id is not None:
            self.answer_callback(_id)
        # THE SAME BODY THE TYPED PATH RUNS. Not a copy of it: a synthesised
        # message carrying the equivalent text, so the rate limit, the one-job
        # lock, the live-conversation first refusal and the handle ownership
        # check are the ones that already exist rather than a second set that
        # can drift from them.
        #
        # NO message_id, so nothing is added to the burn list for it -- there
        # is no new message in the chat to delete. The message holding the
        # button was recorded by send() when it was sent.
        self.handle({"message": {"chat": {"id": cid},
                                 "from": cb.get("from") or {},
                                 "text": _text}})

    def start_job(self, cid: int, job: str, params: dict, leg: int = 0) -> None:
        """Every path to a wake goes through here. THE ONLY ONE.

        Factored out so the wizard and `/depo 2` cannot drift: the rate limit,
        the one-job lock and the argument that reaches the wire are the same
        code for both. A second copy of this in the wizard is how a wizard ends
        up not being rate limited.

        The rate limit is charged HERE, at the poke, and not when a
        conversation starts -- otherwise abandoning a half-typed /depo would
        spend a poke, and starting conversations would be a way to exhaust the
        day's budget without ever waking anything.
        """
        # ONE WALLET, ONE PERSON, CHECKED WHERE IT IS SPENT.
        #
        # main() refuses this configuration at startup, which is where the
        # operator is standing and where the message can be long. This is the
        # same rule at the other end: start_job is the ONLY path to a wake,
        # and a wake is what moves money. A Pager built some other way -- a
        # future caller, a test harness promoted into production, an edit that
        # skips main() -- would otherwise reach the wire with an allowlist
        # main() would have rejected.
        #
        # Defence in depth is worth it HERE specifically because the harm is
        # not the operator's: with two people on one wallet, the withdrawal
        # that succeeds takes the other one's money, and nothing downstream
        # can notice. So this is checked at the last line before the wake,
        # not only at the first line of the process.
        if self.spenders > 1:
            integrity_log("pager", "refused_multi_spender")
            self.send(cid,
                      "no: this bot is allowlisted for more than one person "
                      "and there is one wallet behind it. A withdrawal would "
                      "spend whoever's balance is largest. Refusing every "
                      "job until that is fixed — one person per bot.")
            return
        # WHICH LEG THIS IS, recorded before the thread starts so poke() reads
        # it rather than a slot that has already been cleared. A fresh
        # /withdraw takes the default and resets the count.
        self._chain_leg = int(leg)
        why = self.limits.why_not()
        if why:
            self.send(cid, f"no: {why}")
            return
        # ONE AT A TIME. gs_doorbell binds a fixed LAN port for the window, so
        # a second concurrent wake cannot bind and would fail confusingly --
        # and two vaults woken at once is not a thing this design has.
        if not self.busy.acquire(blocking=False):
            self.send(cid, BUSY_ANSWER)
            return
        # RELEASE IT IF ANYTHING BETWEEN HERE AND THE THREAD RAISES.
        #
        # The guard used to start at Thread.start(), on the reasoning that a
        # start() which raises leaves the lock held by nobody -- true, and it
        # is the same for the three statements ABOVE it, which were outside the
        # try. limits.record() writes the state file, so a full or read-only SD
        # card raises there; integrity_log appends to a hash chain on the same
        # card. Either one leaves `busy` acquired and never released, and every
        # later poke answers "a wake is already running" for the life of the
        # process -- on a headless box, with the operator unable to wake
        # anything and no clue why.
        #
        # The try ENDS at start(). Once the thread is running the worker's own
        # finally owns the lock, and a release here would free a lock the
        # worker still thinks it holds.
        try:
            self._running = cid
            self.limits.record()
            integrity_log("pager", f"poke:{job}")
            # SAY HOW LONG, BECAUSE "A WHILE" IS NOT A NUMBER ANYONE CAN WAIT
            # OUT. This said "working. This takes a while." for every job, and
            # the jobs are not alike: a status probe is minutes and a
            # withdrawal holds this pager -- every command, not just another
            # wake -- for up to 16.75 h. An operator told "a while" and then
            # answered "no: a wake is already running" for two thirds of a day
            # concludes the bot is broken, which is the report this whole
            # channel exists to avoid producing.
            #
            # FROM result_budget_s AND THE DOORBELL'S OWN PRE-WOL CEILING, not
            # a literal, so it cannot drift from the window actually held. The
            # jitter is included because the operator waits it too, and skipped
            # when --no-jitter says it will not happen. Rounded up to whole
            # hours past an hour: they need the order of magnitude, and
            # "16.75h" reads like a precision this cannot honour.
            # THREE TERMS, AND IT COUNTED TWO. The comment above says the
            # figure cannot drift from the window actually held; the window
            # actually held is PRE_WOL_MAX_S, then the doorbell's FETCH_WINDOW_S
            # while it waits to be collected, and only THEN result_budget_s
            # from collected_at. Pending.finished() is false while fetch_open()
            # holds, so the three are strictly sequential.
            #
            # The fetch window is unconditional -- arm() runs on the
            # magic-packet path whether or not the jitter does -- so it is
            # added outside the --no-jitter test. Hour-rounding hid it on the
            # three long jobs and not on the short ones: /deposit was quoted 50
            # minutes against a real 60, /check 40 against 50. What the
            # operator does in that gap is send another command, and get "no:
            # something is already running" -- the exact experience this
            # message was added to prevent.
            _hold = (proto.result_budget_s(job)
                     + getattr(doorbell(), "FETCH_WINDOW_S", 0))
            if not getattr(self.args, "no_jitter", False):
                _hold += getattr(doorbell(), "PRE_WOL_MAX_S", 0)
            _how = (f"{_hold // 3600 + 1}h" if _hold >= 3600
                    else f"{max(1, _hold // 60)} min")
            # THE NUMBER IS A LOCK WINDOW, AND IT READ AS AN ESTIMATE.
            #
            # "working — up to 17h" landed minutes after the depth menu had
            # said "about 6h" for the depth the operator picked, and the two
            # are different quantities: the menu's figure is how long THAT
            # depth runs, and this one is how long this pager may refuse every
            # other command. They are both right and they looked like the same
            # number disagreeing with itself by a factor of three, on
            # consecutive screens, which is the shape that makes a tool read
            # as broken.
            #
            # THE FIGURE ITSELF STAYS THE WORST CASE, and that is deliberate.
            # It comes from result_budget_s, which is the wire's ONE budget for
            # a withdrawal at any depth -- the vault will let a three-hop run
            # take the full window if the network is slow -- so a depth-derived
            # bound here would be a bound this box cannot keep. An "up to" that
            # is sometimes exceeded is worse than one that is loose: the whole
            # point of the sentence is that the operator is not surprised by
            # "no: something is already running".
            #
            # NOT ON A CHAINED LEG. The completion message that just landed
            # already says "Next one starting", and this arrived seconds later
            # saying the same thing with a number attached -- two messages per
            # leg, six times over, on the surface this design spends its whole
            # effort keeping short. The window has not changed since leg one
            # and the operator has already been told it.
            if not self._chain_leg:
                self.send(cid,
                          f"{chat_name(job)}: working. Nothing else can run "
                          f"for up to {_how}.")
            threading.Thread(target=self._worker, args=(cid, job, params),
                             daemon=True).start()
        except BaseException as e:                           # noqa: BLE001
            self._running = None
            self.busy.release()
            integrity_log("pager", "worker_start_failed")
            self.send(cid, f"{chat_name(job)}: could not start — {_redact(e)[:120]}")

    def publish_commands(self) -> bool:
        """Register the command list with Telegram. Returns whether it landed.

        WITHOUT THIS THE BOT LOOKS DEAD. Telegram builds the "/" autocomplete
        menu, the blue Menu button and the command descriptions from
        setMyCommands -- and this never called it. So a correctly working
        pager, over Tor, with a valid token, presented as an empty chat with no
        menu and no hint that typing anything would do something. The operator
        had to already know every command and its exact spelling.
        That is indistinguishable from a bot that does not work.

        NOT FATAL. A pager that could not publish its menu still answers every
        command it always did, and refusing to start over cosmetics would be
        the wrong trade on the box whose whole job is to be reachable. It says
        so instead, once, on the terminal.

        SCOPE default (every chat this bot is in), because the allowlist is
        what decides who is answered -- and it is checked on every message, so
        a menu visible to a stranger buys them nothing but the word "no".
        """
        cmds = [{"command": c, "description": d} for c, d in BOT_COMMANDS]
        try:
            r = safe_post(self._url("setMyCommands"),
                          {"commands": json.dumps(cmds)},
                          proxies=self.proxies)
            ok = bool(isinstance(r, dict) and r.get("ok"))
        except Exception:                                    # noqa: BLE001
            ok = False
        if not ok:
            print("  [!] Could not publish the command menu to Telegram. The "
                  "bot still answers every\n"
                  "      command; the phone just will not offer them. Usually "
                  "Tor being slow on the\n"
                  "      first poll — it is retried on the next start.")
        return ok

    def run(self) -> int:
        self.publish_commands()
        print(f"  [+] Pager up. {len(self.allow)} allowlisted chat(s)"
              + (f", {len(self.allow_users)} allowlisted sender(s)"
                 if self.allow_users else "")
              + ", Tor only, one wake at a time.")
        # NOTHING HERE ABOUT SHARING, BECAUSE NOTHING IS SHARED ANY MORE.
        #
        # This block used to print a warning: one wake budget, one job lock,
        # one handle namespace, later one pot of money. Every line of it was a
        # description of a configuration that main() now refuses outright --
        # one wallet means one person, and there is no flag to say otherwise.
        # A banner explaining the consequences of a state the program will not
        # enter is decoration, and this file removes guards that cannot fire
        # rather than keeping them for reassurance.
        while not shutdown_requested():
            for upd in self.updates():
                uid = upd.get("update_id")
                if isinstance(uid, int) and not isinstance(uid, bool):
                    # Advance the cursor BEFORE acting: a message that crashes
                    # the handler must not be replayed on every restart.
                    self.limits.offset = max(self.limits.offset, uid + 1)
                    # AND A CARD THAT WILL NOT TAKE IT MUST NOT KILL THE
                    # PROCESS. save() writes the state file through
                    # atomic_write_json, which re-raises -- and this call sits
                    # OUTSIDE the per-update try below, with nothing above it
                    # to catch anything either.
                    #
                    # What that costs: a withdrawal holds `busy` for up to
                    # 16.75 h, and the doorbell's HTTP server runs IN THIS
                    # PROCESS. A full or read-only SD card, plus any incoming
                    # update -- including one from a stranger the allowlist
                    # would have ignored a line later -- tore the interpreter
                    # down mid-wake and took the socket with it. updates()
                    # carries a long note about exactly that outcome ("it
                    # POSTs to a port nothing is bound to any more"), and this
                    # line walked around it. The offset was never persisted
                    # either, so the same update came back and did it again.
                    #
                    # start_job guards the identical call for the identical
                    # reason. THE IN-MEMORY OFFSET IS KEPT either way, so this
                    # batch is not reprocessed inside this process; what is
                    # lost is the cursor surviving a restart, which is a
                    # smaller loss than the restart.
                    try:
                        self.limits.save()
                    except Exception as e:                   # noqa: BLE001
                        print(f"  [!] could not persist the update cursor "
                              f"({_redact(e)[:80]}). Continuing: dropping a "
                              f"wake in flight would cost more than replaying "
                              f"a message after a restart.")
                else:
                    # NOT SILENTLY HANDLED ANYWAY. An update whose update_id is
                    # not an int can never be confirmed to Telegram, because
                    # the offset is what confirms it -- so it is redelivered on
                    # every single poll, and handling it each time means one
                    # message acted on forever. Skipped instead, and counted,
                    # so a real change in the Bot API shows up as a rising
                    # counter rather than as a pager that has quietly become a
                    # loop. `bool` is excluded because True == 1 and would
                    # advance the cursor to 2.
                    self.ignored += 1
                    integrity_log("pager", "update_without_id")
                    continue
                try:
                    self.handle(upd)
                except Exception as e:                       # noqa: BLE001
                    print(f"  [!] update dropped: {_redact(e)[:200]}")
            # EVERY TICK, INCLUDING THE QUIET ONES, and that is the point:
            # updates() long-polls for POLL_HOLD_S and returns an empty list
            # when nothing was said, so a chat nobody touches still empties
            # itself on schedule. Hooking this to message arrival instead would
            # leave the last conversation of the night sitting there until the
            # next one.
            #
            # OUTSIDE the per-update try: a delete that fails is already
            # swallowed by delete_message, and a bug here must not be reported
            # as "update dropped" about a message that was handled fine.
            if self.burn_now:
                # CLEARED FIRST. If burn_all raises, a flag left set would
                # retry the whole list on every tick for the life of the
                # process -- a permanent stream of delete requests over Tor
                # from one signal.
                self.burn_now = False
                _g, _t = self.burn_all()
                integrity_log("pager", "burn_signal")
                print(f"  [*] burn: {_g}/{_t} message(s) deleted"
                      + ("" if _g == _t
                         else "; the rest are past Telegram's 48h window"))
            _burned = self.burn_expired(self.burn_after)
            if _burned:
                integrity_log("pager", "messages_burned")
        # SAY WHAT IS BEING ABANDONED. The other way this process can end is a
        # signal -- `systemctl restart`, or an operator with a terminal -- and
        # it reaches here with the same consequence the poll-failure exit was
        # just taught to avoid: the worker is a daemon thread, so returning
        # from run() tears down the in-process doorbell server, and a vault
        # that is mid-withdrawal reports back to a closed port hours later.
        #
        # This one is NOT overridden. A signal is a person saying stop, and a
        # pager that ignored SIGTERM for sixteen hours would be worse than the
        # thing it was avoiding -- systemd would SIGKILL it anyway, with no
        # message at all. What was missing is that the operator was never told:
        # the process exited "cleanly", said "Shutdown requested.", and the
        # money it was in the middle of moving went unreported.
        if self.busy.locked():
            integrity_log("pager", "shutdown_with_wake_in_flight")
            print("  [!] Shutdown requested WHILE A WAKE IS IN FLIGHT.")
            print("      The vault keeps running its job -- it is a different "
                  "machine and nothing here can stop it -- but its result "
                  "comes back to THIS process, which is going away. That "
                  "result is lost.")
            print("      The job itself is not: it completes on the vault and "
                  "its artifacts are in the vault's artifact directory. Check "
                  "there before starting another one.")
            # ...AND TO THE CHAT, WHICH IS WHERE THE OPERATOR IS.
            #
            # The comment above says the defect being fixed is that "the
            # operator was never told", and then told them on a stdout the
            # shipped unit sets to null. `systemctl restart`, a package
            # upgrade, a Pi reboot or Restart=on-failure during the up-to-16 h
            # window a withdrawal holds `busy` all land here, and the operator
            # is left with "working" as the last thing they ever heard about a
            # spend.
            #
            # This process is still alive and Tor is still up: send() needs
            # neither `busy` nor the worker thread, and _worker already uses
            # it for the analogous case. Every allowlisted chat, because there
            # is no record here of which one started the job -- normally there
            # is exactly one, since main() refuses more than one spender.
            #
            # A BARE EXCEPT, and it wraps the whole loop: a dead circuit at
            # shutdown must not turn "stopping" into a traceback, and there is
            # nothing useful left to do about a failure here anyway.
            try:
                for _cid in sorted(self.allow):
                    self.send(_cid,
                              "STOPPING while something is still running.\n\n"
                              "The job itself keeps going — it is not on this "
                              "end and nothing here can stop it — but its "
                              "result comes back to this process, which is "
                              "going away, so you will not be told how it "
                              "ended.\n"
                              "CHECK AT THE MACHINE before starting another.")
            except Exception:                                # noqa: BLE001
                pass
            return 1
        print("  [*] Shutdown requested.")
        return 0


def whoami(token: str, proxies: dict, waits: int = 30) -> int:
    """Print the chat id of the next message, then stop. Arms nothing.

    Long-polls the same way the pager does, over the same Tor proxy, and
    reports the id and nothing that could be mistaken for a command having
    been run.
    """
    print("  [*] Waiting for a message. Open Telegram, find your bot, and "
          "send it anything.")
    print("      Ctrl-C to stop. This does not wake anything.")
    seen = set()
    for _ in range(waits):
        if shutdown_requested():
            break
        url = (f"https://api.telegram.org/bot{token}/getUpdates"
               f"?timeout={POLL_HOLD_S}&allowed_updates=%5B%22message%22%5D")
        try:
            d = safe_get(url, proxies=proxies)
        except Exception as e:                               # noqa: BLE001
            print(f"  [!] poll failed: {_redact(e)}")
            time.sleep(5)
            continue
        if not isinstance(d, dict) or not isinstance(d.get("result"), list):
            time.sleep(2)
            continue
        for upd in d["result"]:
            msg = (upd or {}).get("message") or {}
            cid = (msg.get("chat") or {}).get("id")
            if not isinstance(cid, int) or cid in seen:
                continue
            seen.add(cid)
            # Every one of these is a string the sender chose, and this line
            # goes to a terminal and, under systemd, a journal. _no_ctrl as
            # well as terminal_safe: see _no_ctrl for what the second one does
            # that the first does not.
            who = _no_ctrl(terminal_safe(
                str((msg.get("from") or {}).get("username")
                    or (msg.get("chat") or {}).get("title") or "?")))[:40]
            # THE SENDER'S ID TOO, because a negative chat id is a ROOM and
            # the pager now refuses one without --user-id. This printed only
            # the chat id and then "Start the pager with --chat-id {cid}",
            # which in a group is an instruction to allowlist everybody in it.
            _uid = (msg.get("from") or {}).get("id")
            _uid = _uid if isinstance(_uid, int) and not isinstance(_uid, bool) else None
            _room = isinstance(cid, int) and cid < 0
            print(f"\n  [+] chat id: {cid}   (from: {who})")
            if _uid is not None:
                print(f"      your user id: {_uid}")
            if _room:
                print(f"      This is a GROUP: that id is the ROOM, and every "
                      f"member of it can drive")
                print(f"      the bot unless the SENDER is checked too. Start "
                      f"the pager with:")
                print(f"          --chat-id {cid} --user-id "
                      f"{_uid if _uid is not None else '<your user id>'}")
                print(f"      (repeat --user-id for each person who may use "
                      f"it)")
            else:
                print(f"      Start the pager with --chat-id {cid}")
                print(f"      This is a PRIVATE chat, so that id IS you -- no "
                      f"--user-id is needed.")
            print(f"      A chat id and a user id are NOT a secret -- "
                  f"both are allowlist entries, so they are fine on a "
                  f"command line. The token is not.")
        if seen:
            return 0
    print("  [!] No message arrived. The bot token may belong to a different "
          "bot than the one you are messaging.")
    return 1


def build_cli():
    ap = argparse.ArgumentParser(
        description="GhostSpiral Telegram pager (Pi side). Triggers a wake; "
                    "never carries an address, a memo or an amount.")
    # NOT required=True, because --whoami exists to be run BEFORE you have
    # either of them. Enforced after parsing instead, where the rule can say
    # which mode it is talking about.
    ap.add_argument("--key", default="",
                    help="this Pi's keyfile, as gs_doorbell wake takes it")
    ap.add_argument("--chat-id", action="append", default=None, type=int,
                    help="allowlisted Telegram chat id. Repeatable. Anything "
                         "from another chat is ignored without a reply. A "
                         "PRIVATE chat id is a person; a GROUP id (negative) "
                         "is a room, and every member of that room can drive "
                         "this bot unless --user-id is also given.")
    # WHO, NOT WHERE. --chat-id gates the ROOM, and in a private chat that is
    # the same thing because chat.id == the user's id. In a group it is not:
    # every member's message carries the group's chat.id, so allowlisting a
    # group allowlists everyone in it -- including /send, which spends.
    #
    # Driven before this existed, against the real handle(): three different
    # `from` ids in one allowlisted group were all answered, and a non-operator
    # walked the whole /send wizard to a job on the wire.
    #
    # The bot's own code anticipates groups in three places -- parse_command
    # handles "/depo@mybot", _step_convo names "/cancel@mybot", and
    # publish_commands registers at default scope "every chat this bot is in,
    # because the allowlist is what decides who is answered" -- so this is a
    # supported configuration whose access rule was simply never written.
    # ONE WALLET, AND THE ALLOWLIST DOES NOT DIVIDE IT.
    #
    # Driven against the shipped _funded_entry with two piles on one wallet:
    # it returns the LARGEST single unlocked output and has no chat argument
    # to filter by -- gs_wake_agent, gs_wake_proto and gs_doorbell contain no
    # chat_id at all, deliberately. So on an install with two allowlisted
    # people, the second one taps Withdraw and the vault hands them the first
    # one's money, correctly, by its own rules.
    #
    # THERE IS NO FLAG FOR THIS AND THERE MUST NOT BE. The first version of
    # this added --shared-funds: an acknowledgement the operator passes to say
    # they understand. That is the wrong shape for a consent gate, and the
    # reason is worth writing down. The person who types the flag is the
    # operator. The person who loses money is the OTHER user, who never saw
    # it, was never asked, and has no way to find out it was passed. Consent
    # given by one party to a harm that lands on a second party is not
    # consent; it is a switch for turning off a safety notice.
    #
    # So the allowlist takes ONE person and the refusal is unconditional. See
    # main().
    ap.add_argument("--user-id", action="append", default=None, type=int,
                    help="allowlisted Telegram USER id, checked against the "
                         "sender of every message. Repeatable. REQUIRED when "
                         "any --chat-id is a group (negative): without it the "
                         "room is the allowlist. --whoami prints both ids.")
    ap.add_argument("--whoami", action="store_true",
                    help="print the chat id of the next message this bot "
                         "receives, then exit. Arms nothing, wakes nothing, "
                         "needs no --key and no --chat-id. This is how you "
                         "find the number --chat-id wants.")
    ap.add_argument("--token-file", default="",
                    help=f"0400 file holding the bot token. Or set "
                         f"{TOKEN_ENV} in this process's environment. NEVER "
                         f"on the command line.")
    ap.add_argument("--tor-proxy", default="socks5h://127.0.0.1:9050",
                    help="this Pi's own Tor. OPSEC_SETUP.md section 4: the "
                         "bot talks to Telegram ONLY through this, and does "
                         "not start if it is down.")
    ap.add_argument("--state", default="/var/lib/ghostspiral/pager_state.json",
                    help="0600 file holding the update cursor and rate "
                         "counters, so a restart is not a bypass")
    ap.add_argument("--min-interval", type=int,
                    default=DEFAULT_MIN_INTERVAL_S,
                    help="courtesy seconds between pokes")
    ap.add_argument("--daily-cap", type=int, default=DEFAULT_DAILY_CAP,
                    help="courtesy pokes per 24h. The vault's own keyfile "
                         "budget is the real bound.")
    ap.add_argument("--burn-after", type=int, default=0, metavar="SECONDS",
                    help="Delete every message in an allowlisted chat -- this "
                         "bot's replies AND the operator's commands -- this "
                         "many seconds after it was sent. 0 (default) keeps "
                         "them. Telegram only lets a bot delete for 48h, so a "
                         "value above 172800 cannot work and is refused. This "
                         "does not reach a forward, a screenshot or a cached "
                         "copy: it is defence in depth on a channel already "
                         "written to say nothing.")
    ap.add_argument("--no-jitter", action="store_true",
                    help="passed through to the wake: skip the pre-WOL delay")
    return ap


#: Telegram refuses deleteMessage for anything older than 48 hours. A
#: --burn-after above it is a setting that silently never fires, which reads as
#: "messages are being burned" while nothing is.
TG_DELETE_WINDOW_S = 172800


def main(argv=None) -> int:
    install_signal_handlers()
    args = build_cli().parse_args(argv)
    # REFUSED, NOT CLAMPED. A --burn-after past Telegram's 48-hour deletion
    # window is a setting that never fires: every message reaches the deadline
    # already too old to delete, so the operator is told nothing and believes
    # the chat is being emptied. Silently clamping it would be a second lie --
    # the value they typed is not the value that ran.
    if args.burn_after < 0:
        sys.exit("[!] --burn-after cannot be negative. 0 disables it.")
    if args.burn_after > TG_DELETE_WINDOW_S:
        sys.exit(f"[!] --burn-after {args.burn_after}s is past Telegram's "
                 f"{TG_DELETE_WINDOW_S}s deletion window, so nothing would "
                 f"ever be deleted and the chat would look like it was being "
                 f"emptied. Pick something under that, or 0 to keep messages.")
    try:
        proto.require_nacl()
    except proto.WakeError as e:
        sys.exit(f"[!] {e}")

    # FAIL CLOSED ON TOR, BEFORE ANYTHING ELSE. OPSEC_SETUP.md section 4: "If
    # Tor is down, the bot does not start."
    proxy = validate_proxy(args.tor_proxy)
    verify_tor(proxy)
    proxies = isolated_proxy(args.tor_proxy, "pager")

    token = load_token(args.token_file)

    # THE BOOTSTRAP, AND THE REASON IT HAD TO EXIST.
    #
    # --chat-id wants a number the operator has no way to know. The bot ignores
    # every chat that is not already on the allowlist -- deliberately, in
    # silence, because a reply confirms the bot is alive to whoever found it --
    # so pressing Start in Telegram produces nothing at all, and there is no
    # path from "I have a bot token" to "I have my chat id". The tool was
    # unusable from a standing start and only somebody who already knew to go
    # read getUpdates by hand could get past it.
    #
    # This arms nothing: no keyfile is read, no doorbell is built, no magic
    # packet can be sent from this branch. It prints a number and exits.
    if args.whoami:
        return whoami(token, proxies)

    if not args.key or not args.chat_id:
        sys.exit("[!] --key and --chat-id are both required to run the pager.\n"
                 "    Run with --whoami first (it needs neither) to find the "
                 "chat id.")
    # A GROUP ID IS A ROOM, NOT A PERSON, AND THE ALLOWLIST HAS TO SAY WHICH.
    #
    # Telegram gives private chats a POSITIVE id equal to the user's own, and
    # groups, supergroups and channels a NEGATIVE one shared by every member.
    # So `--chat-id <negative>` alone allowlists everybody in that room --
    # including for /send, which spends -- and nothing said so: the id parsed,
    # the banner reported "1 allowlisted chat(s)", and --whoami printed
    # "A chat id is NOT a secret -- it is an allowlist entry", which is true of
    # a person and not of a room.
    #
    # REFUSED AT STARTUP rather than warned about, because the failure is
    # silent in the direction that costs the most: nothing in the chat ever
    # looks wrong. --user-id turns the room back into an allowlist of people.
    _rooms = sorted(c for c in args.chat_id if int(c) < 0)
    if _rooms and not args.user_id:
        sys.exit(
            f"[!] {len(_rooms)} of the --chat-id value(s) given are GROUPS "
            f"(a negative id is a room,\n"
            f"    not a person), and no --user-id was given.\n"
            f"    Every member of that room could then drive this bot -- "
            f"including /send, which\n"
            f"    SPENDS -- because a group message carries the group's chat "
            f"id, not the sender's.\n"
            f"    Add --user-id <your own id> (repeatable) so the sender is "
            f"checked too. Run\n"
            f"    --whoami and send a message from that room: it prints the "
            f"chat id AND your\n"
            f"    user id.\n"
            f"\n"
            f"    NOTE THAT --user-id GATES WHO MAY DRIVE IT, NOT WHO MAY "
            f"READ IT. Every reply\n"
            f"    still goes to the room, so plaintext deposit details are "
            f"withheld in a group\n"
            f"    even with plain_slip set. A one-to-one chat is the only "
            f"place they are sent.\n"
            f"    For a one-to-one chat with the bot this does not arise -- "
            f"there the chat id IS\n"
            f"    the person, and it is positive.")
    # HOW MANY PEOPLE CAN SPEND, which is not how many chat ids there are.
    #
    # With --user-id, the senders ARE the people and the chat ids are just
    # rooms they might be standing in. Without it, every allowlisted chat is a
    # private one -- main() refuses a group above -- and a private chat id IS
    # a person, because Telegram makes it equal to their user id.
    # ONE PERSON. NOT ONE PERSON UNLESS THEY SAY OTHERWISE.
    #
    # There is one wallet behind this bot and a withdrawal spends the largest
    # unlocked balance on it, whoever put it there -- driven, and there is no
    # gate downstream that could think otherwise, because the vault is never
    # told who asked.
    #
    # HOW MANY PEOPLE IS NOT HOW MANY CHAT IDS, and it is also not larger than
    # it looks. With --user-id the senders ARE the people. Without it every
    # allowlisted chat is private (a group is refused above), and a PRIVATE
    # CHAT ID IS A TELEGRAM ACCOUNT: Telegram gives one account exactly one
    # chat with a given bot, on every device it is signed in to. So the "one
    # operator with a phone and a desktop" this used to be justified by does
    # not exist -- that operator has one account, one chat id, one entry. A
    # second --chat-id is a second ACCOUNT, which is a second person.
    _spenders = len(set(args.user_id or ())) or len(set(args.chat_id))
    if _spenders > 1:
        sys.exit(
            f"[!] {_spenders} different people would be able to spend from "
            f"ONE wallet. Refusing.\n"
            f"    There is a single wallet behind this bot. A withdrawal does "
            f"not ask who is\n"
            f"    asking: the vault takes the LARGEST unlocked balance it can "
            f"see and sends it to\n"
            f"    whatever addresses that person gave. Driven against the "
            f"shipped code -- with\n"
            f"    1000 XMR from one person and 300 from another on one "
            f"wallet, the second\n"
            f"    person's withdrawal picks up the first person's 1000.\n"
            f"\n"
            f"    THERE IS NO FLAG TO OVERRIDE THIS. An override would be the "
            f"operator agreeing,\n"
            f"    on somebody else's behalf, to a loss that falls on somebody "
            f"else. The person\n"
            f"    who would be robbed is not the person who would be asked.\n"
            f"\n"
            f"    ONE PERSON PER BOT, because it is one wallet per bot. To "
            f"serve several people,\n"
            f"    give each of them their own vault, their own wallet and "
            f"their own bot; they\n"
            f"    share nothing and cannot reach each other's funds.\n"
            f"    (If you meant one person on several devices: Telegram gives "
            f"one account one\n"
            f"     chat with this bot, whatever it is signed in on. That is "
            f"one --chat-id.)")
    key = doorbell().load_key(Path(args.key))
    # A PAGER THAT CANNOT BIND A LABEL TO A CHAT MUST NOT START.
    #
    # Every confirmation number is a MAC over (chat id, handle) keyed from
    # this card's pairing secret. Without a usable one there are two ways to
    # carry on and both are worse than refusing: show the bare handle, which
    # reissues the bearer token the confirmation number exists to retire, or
    # raise mid-reply, which loses the message that names a deposit. Checked
    # once, here, where the operator is standing and the message can be long.
    try:
        _confirm_key(key)
    except Exception as e:                                   # noqa: BLE001
        sys.exit(f"[!] {args.key} carries no usable pairing secret "
                 f"({type(e).__name__}), so this cannot issue a confirmation "
                 f"number that belongs to one chat. Re-pair with "
                 f"gs_wake_keys.")

    st = Path(args.state)
    try:
        st.parent.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        sys.exit(f"[!] cannot create {st.parent}: {e.strerror}")

    # BOOKKEEPING MUST NOT BE WHAT STOPS THE BOT FROM STARTING.
    #
    # This was outside every try. gs_common's chain is
    # Path("integrity_chain.log") -- relative, resolved against cwd at open
    # time -- and the shipped unit sets ProtectSystem=strict with no
    # WorkingDirectory, so systemd's cwd=/ made it /integrity_chain.log on a
    # read-only filesystem. integrity_log downgrades a failure on its LOCK
    # file to "stage!nolock" and re-raises a failure on the log itself, so the
    # first line the pager ever writes raised an unhandled OSError -- into
    # StandardError=null, with Restart=on-failure retrying every 30 seconds,
    # forever, silently, on the box whose entire purpose is being reachable.
    #
    # The unit gained a WorkingDirectory. This is the other half: the example
    # unit says in its own header "read every line, then write your own", so
    # an operator's unit may not have one, and a full or read-only card would
    # do it anyway on a unit that does. A pager that answers is worth more
    # than a chain line about a pager that did not start.
    try:
        integrity_log("pager", "start")
    except Exception as e:                                   # noqa: BLE001
        print(f"  [!] integrity chain unavailable ({type(e).__name__}); "
              f"starting anyway. Check the working directory in the unit.")
    _pager = Pager(args, token, key, proxies)
    # SIGUSR1 BURNS THE CHAT. Registered here rather than in __init__ because
    # a Pager built by a test must not install a process-wide handler -- the
    # same rule _report_surviving_plans follows in GhostSpiral.
    #
    # Best-effort: a platform without SIGUSR1 loses the trigger and keeps the
    # pager, which is the right way round. --burn-after still works there.
    try:
        import signal as _sig
        _sig.signal(_sig.SIGUSR1, _pager.arm_burn)
        print("  [*] SIGUSR1 burns this chat's tracked messages "
              "(kill -USR1). No chat command does it: the word would sit in "
              "the transcript it was meant to empty.")
    except (AttributeError, ValueError, OSError):
        pass
    return _pager.run()


if __name__ == "__main__":
    sys.exit(main())
