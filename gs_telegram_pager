POLL_HOLD_S = 10

#: FAIL-CLOSED IS NOT ONLY A STARTUP PROPERTY.
#:
#: §4 says "If Tor is down, the bot does not start" -- and the first version
#: enforced that at startup and then, if Tor died an hour later, sat in a
#: 5-second retry loop forever. That is fail-OPEN in the only way that
#: matters: the operator believes a poke will work, and the bot has quietly
#: been unable to reach anything since. Consecutive failures are counted and
#: the process exits, so systemd's Restart= re-runs the startup verify_tor and
#: the bot stays down until Tor is genuinely back.
#:
#: Not 1: a single blip on a Tor circuit is ordinary and must not stop a
#: pager. At 5 s a retry this is about a minute of sustained failure.
MAX_POLL_FAILURES = 12

#: Seconds before the ONE retry of a sealed slip that did not send. Long enough
