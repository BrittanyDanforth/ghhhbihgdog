#!/usr/bin/env python3
"""
Toolkit — Interactive Launcher
"""
from __future__ import annotations
import os, sys
from pathlib import Path

# ── Auto-activate venv if available ─────────────────────────────────────────
# The toolkit can be launched three ways:
#   1. ./gs           → bash wrapper, uses .venv/bin/python3
#   2. python3 run    → whatever python3 is on PATH (system or venv)
#   3. .venv/bin/python3 run → directly inside venv
#
# Problem: if the user runs "python3 run" with system Python but packages
# are only in .venv, every import fails. Fix: detect venv, re-exec if needed.
_ROOT = Path(__file__).resolve().parent
_VENV_PY = _ROOT / ".venv" / "bin" / "python3"

def _venv_works() -> bool:
    """Check if the venv Python can import ALL critical deps.
    
    A partial venv (e.g. only requests installed) would pass a single-import
    check but crash later when stem/monero/socks are needed. Check everything.
    """
    if not _VENV_PY.exists():
        return False
    try:
        import subprocess as _sp
        r = _sp.run(
            [str(_VENV_PY), "-c",
             "import requests, socks, tenacity, stem, monero, psutil"],
            capture_output=True, timeout=10,
        )
        return r.returncode == 0
    except Exception:
        return False

def _system_has_deps() -> bool:
    """Check if current Python has ALL critical deps.
    
    Must match the same set checked by _venv_works() and the gs launcher.
    If any is missing, the toolkit will crash at runtime.
    """
    try:
        import requests, socks, tenacity, stem, monero, psutil
        return True
    except ImportError:
        return False

# If we're NOT in the venv and venv works, re-exec under venv Python
if _VENV_PY.exists() and str(_VENV_PY) != sys.executable:
    if _venv_works():
        os.execv(str(_VENV_PY), [str(_VENV_PY), __file__] + sys.argv[1:])
    elif not _system_has_deps():
        print("\n  [!] Required packages are missing or incomplete.")
        print(f"  [!] Run: bash install.sh")
        sys.exit(1)

# If venv doesn't exist at all and system has no deps, guide the user
if not _VENV_PY.exists() and not _system_has_deps():
    print("\n  [!] Required packages are not installed.")
    print(f"  [!] Run: bash install.sh")
    sys.exit(1)

import json, subprocess, shutil, secrets
from decimal import Decimal, InvalidOperation
from urllib.parse import urlparse

ROOT = _ROOT
CORE = ROOT / "core"
MODS = ROOT / "modules"
OPSEC = ROOT / "opsec"
INTEL = ROOT / "intel"


def _find_wallet_files() -> list:
    """Search for wallet_*.json under toolkit root, CWD, and home.
    Returns deduplicated list sorted by modification time (newest first)."""
    seen = set()
    found = {}
    for d in [ROOT, Path(".").resolve(), Path.home(), Path.home() / "Downloads"]:
        try:
            rd = d.resolve()
        except OSError:
            continue
        if rd in seen or not rd.is_dir():
            continue
        seen.add(rd)
        for f in rd.glob("wallet_*.json"):
            rp = f.resolve()
            if rp not in found:
                found[rp] = f
    return sorted(found.values(), key=lambda f: f.stat().st_mtime, reverse=True)


def _find_plan_files() -> list:
    """Search for unsigned plan files under toolkit root and CWD."""
    seen = set()
    found = {}
    for d in [ROOT / "unsigned", Path(".").resolve() / "unsigned",
              ROOT, Path(".").resolve()]:
        try:
            rd = d.resolve()
        except OSError:
            continue
        if rd in seen or not rd.is_dir():
            continue
        seen.add(rd)
        for f in rd.glob("unsigned_*.json"):
            rp = f.resolve()
            if rp not in found:
                found[rp] = f
    return sorted(found.values(), key=lambda f: f.stat().st_mtime, reverse=True)

# ── Colors ──────────────────────────────────────────────────────────────────
R = "\033[0;31m"    # red
G = "\033[0;32m"    # green
Y = "\033[1;33m"    # yellow
C = "\033[0;36m"    # cyan
B = "\033[1;37m"    # bold white
M = "\033[0;35m"    # magenta
D = "\033[0;90m"    # dim
N = "\033[0m"       # reset


def clear():
    print("\033[2J\033[H", end="", flush=True)


def banner():
    print(f"""
{M}  ===================================================={N}
  {B}                Operations Menu{N}
{M}  ===================================================={N}
""")


def prompt(text: str, default: str = "") -> str:
    if default:
        r = input(f"  {C}>{N} {text} {D}[{default}]{N}: ").strip()
        return r if r else default
    return input(f"  {C}>{N} {text}: ").strip()


def confirm(text: str) -> bool:
    r = input(f"  {Y}?{N} {text} {D}(y/n){N}: ").strip().lower()
    return r in ("y", "yes")


def heading(text: str):
    w = max(len(text) + 4, 40)
    print(f"\n  {C}{'─' * w}{N}")
    print(f"  {B}  {text}{N}")
    print(f"  {C}{'─' * w}{N}\n")


def ok(text: str):
    print(f"  {G}[+]{N} {text}")


def warn(text: str):
    print(f"  {Y}[!]{N} {text}")


def err(text: str):
    print(f"  {R}[!]{N} {text}")


def info(text: str):
    print(f"  {D}[*]{N} {text}")


def run_script(path: Path, args: list, label: str = ""):
    if label:
        info(f"Running {label}...")
    python = sys.executable
    # Build a sanitized env: drop secrets that child scripts don't need.
    # Each child that *does* need a secret should read it from its own
    # env var (e.g. GS_WALLET_PASSWORD for the signer).
    child_env = os.environ.copy()
    for _k in ("GS_WALLET_PASSWORD", "GS_WALLET_FILE"):
        child_env.pop(_k, None)
    try:
        result = subprocess.run(
            [python, str(path)] + args,
            timeout=7200,
            env=child_env,
        )
        return result.returncode == 0
    except subprocess.TimeoutExpired:
        err(f"{label or path.name} timed out")
        return False
    except KeyboardInterrupt:
        warn("Interrupted")
        return False


# ── Check prerequisites ────────────────────────────────────────────────────

def check_prereqs() -> dict:
    """Check what's available on this system."""
    status = {}

    # Python deps
    for mod, name in [("requests","requests"),("socks","PySocks"),("stem","stem"),
                      ("monero","monero"),("psutil","psutil"),("tenacity","tenacity")]:
        try:
            __import__(mod)
            status[name] = True
        except ImportError:
            status[name] = False

    # Tor (system tor SOCKS 9050; Tor Browser embedded tor 9150)
    status["tor"] = False
    status["tor_port"] = None
    try:
        import requests as _r
        for _tor_port in (9050, 9150):
            try:
                _px = {
                    "http": f"socks5h://127.0.0.1:{_tor_port}",
                    "https": f"socks5h://127.0.0.1:{_tor_port}",
                }
                resp = _r.get("https://check.torproject.org/api/ip", proxies=_px, timeout=10)
                if resp.json().get("IsTor"):
                    status["tor"] = True
                    status["tor_port"] = _tor_port
                    break
            except Exception:
                continue
    except ImportError:
        pass

    # Monero
    for tool in ["monerod", "monero-wallet-cli", "monero-wallet-rpc"]:
        status[tool] = shutil.which(tool) is not None

    # Wallet RPC running?
    try:
        import requests as _r2
        resp = _r2.post("http://127.0.0.1:18083/json_rpc",
                        json={"jsonrpc":"2.0","id":"0","method":"get_height"},
                        timeout=3)
        status["wallet_rpc"] = resp.status_code == 200
    except Exception:
        status["wallet_rpc"] = False

    return status


def show_status(st: dict):
    heading("System Status")
    for name, ok_val in [
        ("Python: requests", st.get("requests")),
        ("Python: PySocks", st.get("PySocks")),
        ("Python: stem", st.get("stem")),
        ("Python: monero", st.get("monero")),
        ("Python: psutil", st.get("psutil")),
        ("Python: tenacity", st.get("tenacity")),
    ]:
        (ok if ok_val else err)(name)

    print()
    _tp = st.get("tor_port")
    _tor_line = (
        f"Tor SOCKS proxy (127.0.0.1:{_tp})"
        if _tp
        else "Tor SOCKS proxy (127.0.0.1:9050 or :9150)"
    )
    (ok if st.get("tor") else err)(_tor_line)
    for tool in ["monerod", "monero-wallet-cli", "monero-wallet-rpc"]:
        (ok if st.get(tool) else warn)(f"{tool}")
    (ok if st.get("wallet_rpc") else warn)("wallet-rpc responding (127.0.0.1:18083)")

    missing = [n for n in ["requests","PySocks","stem","monero","psutil","tenacity"] if not st.get(n)]
    if missing:
        print(f"\n  {R}Missing packages detected.{N} Run: bash install.sh")
    if not st.get("tor"):
        print()
        print(f"  {R}Tor is NOT running.{N} The toolkit cannot work without Tor.")
        print()
        print(f"  How to fix:")
        print(f"    {B}sudo systemctl start tor{N}     <- start system Tor (port 9050)")
        print(f"    {B}sudo systemctl status tor{N}    <- check if it's running")
        print(f"    {B}sudo journalctl -u tor{N}       <- check for errors")
        print()
        print(f"  Or: open Tor Browser (uses port 9150 instead of 9050)")
        print()
        print(f"  If Tor keeps failing:")
        print(f"    sudo apt purge tor && sudo apt install tor")
        print(f"    sudo systemctl enable tor && sudo systemctl start tor"
        )

    return len(missing) == 0 and st.get("tor", False)


# ── Main Menu ──────────────────────────────────────────────────────────────

