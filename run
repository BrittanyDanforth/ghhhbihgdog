             "note": "Follow the exploit method described above"},
        ]

    return steps


def _extract_base_url_from_vulns(vulns: list) -> str:
    """Extract the base URL from vulnerability findings."""
    for v in vulns:
        ev = v.get("evidence", "")
        if "http" in ev:
            import re as _re
            m = _re.search(r"https?://[^\s,)]+", ev)
            if m:
                parsed = urlparse(m.group(0))
                return f"{parsed.scheme}://{parsed.netloc}"
    return ""


def flow_intel(detected_port=None):
    heading("Intelligence Gathering & Vulnerability Scanner")
    print(f"  This tool performs OSINT collection and vulnerability scanning")
    print(f"  through Tor. All data is stored in RAM (/dev/shm).")
    if not Path("/dev/shm").exists():
        print(f"  {R}WARNING: /dev/shm not available — data will be stored on disk.{N}")
        print(f"  {R}Use a system with tmpfs/ramfs for OPSEC-safe operation.{N}")
    print()
    print(f"  {B}Modes:{N}")
    print(f"    {G}1{N}  Domain Recon + Vuln Scan    (enter a domain)")
    print(f"    {G}2{N}  Email Breach Check           (check breach databases)")
    print(f"    {G}3{N}  Search Query OSINT           (search + scrape)")
    print(f"    {G}4{N}  Batch Targets from File      (one target per line)")
    print(f"    {G}5{N}  Exploit Walkthrough          (interactive + presets)")
    print(f"    {G}5a{N} Smart Exploit                (pre-gen files + serve + chain output)")
    print(f"    {G}6{N}  View Reports                 (read saved scan results)")
    print(f"    {G}7{N}  Wipe Intel Data              (secure erase from RAM)")
    print(f"    {G}8{N}  Manage Exploit Files         (view/wipe ephemeral files)")
    print()
    mode = prompt("Choose mode (1-8, 5a)")

    if mode == "8":
        heading("Exploit File Management")
        fm = ExploitFileManager(ttl_seconds=300)
        files = fm.list_files()
        ram_dir = fm.base_dir
        all_exploit_files = list(ram_dir.glob("*.html")) + list(ram_dir.glob("*.txt")) + list(ram_dir.glob("*.json"))
        exploit_files = [f for f in all_exploit_files if not f.name.startswith("intel_")]

        if not exploit_files:
            info("No exploit files found in ephemeral storage.")
            return

        print(f"  {B}Ephemeral Exploit Files:{N}")
        print(f"  {'─' * 55}")
        for f in exploit_files:
            size_kb = f.stat().st_size / 1024
            age_min = (_time_mod.time() - f.stat().st_mtime) / 60
            age_str = f"{age_min:.0f}m ago" if age_min < 60 else f"{age_min/60:.1f}h ago"
            print(f"    {f.name:35s}  {size_kb:.1f}KB  {age_str}")
        print()
        print(f"  {B}Actions:{N}")
        print(f"    {G}1{N}  View a file")
        print(f"    {G}2{N}  Wipe all exploit files")
        print(f"    {G}3{N}  Wipe by type (clickjack/csrf/cors/xss/...)")
        print()
        action = prompt("Choose action (1-3, or Enter to go back)")
        if action == "1":
            idx_str = prompt("File number (from list above)")
            if idx_str.isdigit():
                idx = int(idx_str) - 1
                if 0 <= idx < len(exploit_files):
                    content = exploit_files[idx].read_text()
                    print()
                    for line in content.split("\n")[:50]:
                        print(f"    {line}")
                    if content.count("\n") > 50:
                        info(f"... ({content.count(chr(10)) - 50} more lines)")
        elif action == "2":
            if confirm(f"Securely wipe {len(exploit_files)} exploit file(s)?"):
                for f in exploit_files:
                    try:
                        size = f.stat().st_size
                        with open(f, "wb") as fh:
                            fh.write(os.urandom(max(size, 64)))
                            fh.flush()
                            os.fsync(fh.fileno())
                        f.unlink()
                    except OSError:
                        pass
                ok(f"Wiped {len(exploit_files)} exploit file(s)")
        elif action == "3":
            etype = prompt("Exploit type prefix (e.g. clickjack, csrf, cors, xss, sqli, lfi, cmdi)")
            matched = [f for f in exploit_files if f.name.startswith(etype)]
            if not matched:
                info(f"No files matching '{etype}*'")
            elif confirm(f"Wipe {len(matched)} file(s) matching '{etype}*'?"):
                for f in matched:
                    try:
                        size = f.stat().st_size
                        with open(f, "wb") as fh:
                            fh.write(os.urandom(max(size, 64)))
                            fh.flush()
                            os.fsync(fh.fileno())
                        f.unlink()
                    except OSError:
                        pass
                ok(f"Wiped {len(matched)} file(s)")
        return

    if mode == "7":
        ram_dir = Path("/dev/shm/intel") if Path("/dev/shm/intel").exists() else ROOT / ".intel_tmp"
        if not ram_dir.exists():
            info("No intel data to wipe.")
            return
        files = list(ram_dir.glob("*"))
        if not files:
            info("Intel directory is empty.")
            return
        total_kb = sum(f.stat().st_size for f in files if f.is_file()) / 1024
        warn(f"Will securely erase {len(files)} file(s) ({total_kb:.1f}KB) from {ram_dir.name}/")
        for f in files[:10]:
            print(f"    {D}{f.name}{N}")
        if len(files) > 10:
            print(f"    {D}... and {len(files) - 10} more{N}")
        print()
        if confirm("Proceed with secure wipe? (files overwritten with random data)"):
            run_script(INTEL / "testergatherSystem", ["--wipe"], "Intel wipe")
            ok("Intel data wiped.")
        else:
            info("Wipe cancelled.")
        return

    if mode == "6":
        # Interactive report browser — list, select by number, view inline
        ram_dir = Path("/dev/shm/intel") if Path("/dev/shm/intel").exists() else ROOT / ".intel_tmp"
        if not ram_dir.exists() or not any(ram_dir.glob("intel_*")):
            info("No reports found. Run a scan first (mode 1).")
            return
        reports = sorted(ram_dir.glob("intel_*"), key=lambda f: f.stat().st_mtime, reverse=True)
        if not reports:
            info("No reports found.")
            return
        heading("Saved Reports")
        import time as _t
        for idx, rp in enumerate(reports):
            age_min = (_t.time() - rp.stat().st_mtime) / 60
            size_kb = rp.stat().st_size / 1024
            enc_icon = "encrypted" if rp.suffix == ".enc" else "plain"
            if age_min < 60:
                age_str = f"{age_min:.0f}m ago"
            elif age_min < 1440:
                age_str = f"{age_min/60:.1f}h ago"
            else:
                age_str = f"{age_min/1440:.0f}d ago"
            print(f"    {G}{idx+1}{N}  {rp.name}  ({size_kb:.1f}KB, {age_str}, {enc_icon})")
        print()
        choice_str = prompt("Enter number to view (or Enter to skip)")
        if choice_str and choice_str.isdigit():
            idx = int(choice_str) - 1
            if 0 <= idx < len(reports):
                run_script(INTEL / "testergatherSystem", ["--read-report", str(reports[idx])], "View report")
            else:
                err(f"Invalid choice: {choice_str}")
        return

    if mode in ("5", "5a"):
        tor = get_tor_proxy(detected_port)
        if not tor:
            return
        _intel_exploit_walkthrough(tor, auto_mode=(mode == "5a"))
        return

    tor = get_tor_proxy(detected_port)
    if not tor:
        return

    if mode == "1":
        domain = prompt("Target domain (e.g. example.com)")
        if not domain:
            err("Domain is required.")
            return
        # Clean domain input
        domain = domain.strip().lower()
        if domain.startswith("http://") or domain.startswith("https://"):
            from urllib.parse import urlparse as _up
            domain = _up(domain).netloc or domain
        if "/" in domain:
            domain = domain.split("/")[0]

        print()
        print(f"  {B}Scan depth:{N}")
        print(f"    {G}quick{N}  — headers + data extraction + tech fingerprint")
        print(f"    {G}full{N}   — + sensitive paths + vuln checks + DNS recon")
        print(f"    {G}deep{N}   — + subdomain enum + exploit detection (SQLi/XSS/traversal)")
        print()
        depth = prompt("Scan depth", "full").lower()
        if depth not in ("quick", "full", "deep"):
            depth = "full"

        args = ["--domain", domain, "--scan", depth, "--tor-proxy", tor]

        # Cookie support for authenticated scanning
        cookie_input = prompt("Session cookies (name=value, comma-separated, or Enter to skip)", "")
        if cookie_input.strip():
            for ck in cookie_input.split(","):
                ck = ck.strip()
                if "=" in ck:
                    args.extend(["--cookie", ck])
        if run_script(INTEL / "testergatherSystem", args, "Intel scan"):
            if depth == "deep":
                print()
                print(f"  {B}Post-scan options:{N}")
                print(f"    {G}1{N}  Interactive walkthrough  (step-by-step with presets)")
                print(f"    {G}2{N}  Smart exploit            (pre-gen files + serve + chain)")
                print(f"    {G}3{N}  Skip")
                print()
                post = prompt("Choose", "1")
                if post == "1":
                    _intel_exploit_walkthrough(tor, auto_mode=False)
                elif post == "2":
                    _intel_exploit_walkthrough(tor, auto_mode=True)

    elif mode == "2":
        email = prompt("Email address to check")
        if not email or "@" not in email:
            err("Valid email address required.")
            return
        args = ["--email", email, "--tor-proxy", tor]
        run_script(INTEL / "testergatherSystem", args, "Breach check")

    elif mode == "3":
        query = prompt("Search query")
        if not query:
            err("Query is required.")
            return
        max_r = prompt("Max results to scrape", "20")
        args = ["--query", query, "--max-results", max_r, "--tor-proxy", tor]
        run_script(INTEL / "testergatherSystem", args, "OSINT search")

    elif mode == "4":
        filepath = prompt("Path to targets file")
        if not filepath:
            err("File path is required.")
            return
        if not Path(filepath).exists():
            err(f"File not found: {Path(filepath).name}")
            return
        depth = prompt("Scan depth (quick/full/deep)", "full").lower()
        if depth not in ("quick", "full", "deep"):
            depth = "full"
        args = ["--file", filepath, "--scan", depth, "--tor-proxy", tor]
        cookie_input = prompt("Session cookies (name=value, comma-separated, or Enter to skip)", "")
        if cookie_input.strip():
            for ck in cookie_input.split(","):
                ck = ck.strip()
                if "=" in ck:
                    args.extend(["--cookie", ck])
        run_script(INTEL / "testergatherSystem", args, "Batch intel")

    else:
        warn(f"Unknown mode: {mode}")


def flow_system_check():
    heading("System Check")
    st = check_prereqs()
    ready = show_status(st)
    print()
    if ready:
        ok("System is ready!")
    else:
        warn("Some components are missing — see above")
        if confirm("Run installer to fix missing deps?"):
            subprocess.run(["bash", str(ROOT / "install.sh")], timeout=600,
                           env=_sanitized_env())
    return st


# ── CLI passthrough ────────────────────────────────────────────────────────

TOOLS = {
    "mixer": CORE/"mixer_core", "gs": CORE/"mixer_core",
    "signer": CORE/"airgap_tx_signer", "broadcast": CORE/"broadcast_signed_xmr",
    "wallet": CORE/"create_receive_wallet", "swap": CORE/"thor_swap_preparer",
    "exit": CORE/"exit_strategy_planner", "exitplan": CORE/"exit_strategy_planner",
    "dag": MODS/"PAG", "labels": MODS/"labelmask", "poison": MODS/"label_poisoner",
    "leaves": MODS/"fake_leaf_inserter", "noise": MODS/"noise",
    "mutate": MODS/"ghostmutator", "wdna": MODS/"wdna", "seed": MODS/"en_seeder",
    "unify": MODS/"ghost_unifier", "retry": MODS/"swap_retry_guard",
    "juggler": MODS/"tor_endpoint_juggler", "timing": MODS/"vm_runtime",
    "paranoia": OPSEC/"paranoia_mode", "logpoison": OPSEC/"error_log_poisoner",
    "mirror": OPSEC/"mirrormask", "deadman": OPSEC/"dmswitch",
    "memseed": OPSEC/"SML", "intfake": OPSEC/"integrity_faker", "verify": OPSEC/"entropy_verifier",
    "collect": INTEL/"collectgrab", "gather": INTEL/"testergatherSystem",
    "intel": INTEL/"testergatherSystem", "vulnscan": INTEL/"testergatherSystem",
}


def cli_passthrough():
    """Direct CLI mode: python3 run <tool> [args...]"""
    tool_name = sys.argv[1].lower()
    if tool_name not in TOOLS:
        print(f"  {R}[!]{N} Unknown tool: {tool_name}")
        print(f"  Available: {', '.join(sorted(set(TOOLS.keys())))}")
        sys.exit(1)
    tool_path = TOOLS[tool_name]
    if not tool_path.exists():
        print(f"  {R}[!]{N} Tool not found: {tool_name}")
        sys.exit(1)
    _exec_env = _sanitized_env()
    os.environ.clear()
    os.environ.update(_exec_env)
    os.execvp(sys.executable, [sys.executable, str(tool_path)] + sys.argv[2:])


# ── Entry point ────────────────────────────────────────────────────────────

def main():
    # If args given, use direct CLI mode
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("list", "--list"):
            print(f"\n  {B}Core pipeline tools:{N}")
            _core_tools = {k: v for k, v in TOOLS.items()
                           if str(v).startswith(str(CORE))}
            for name in sorted(_core_tools):
                print(f"    {name:14s} → {_core_tools[name].relative_to(ROOT)}")
            print(f"\n  {B}Modules (standalone / expert):{N}")
            _mod_tools = {k: v for k, v in TOOLS.items()
                          if str(v).startswith(str(MODS))}
            for name in sorted(_mod_tools):
                print(f"    {name:14s} → {_mod_tools[name].relative_to(ROOT)}")
            print(f"\n  {B}OPSEC utilities:{N}")
            _opsec_tools = {k: v for k, v in TOOLS.items()
                            if str(v).startswith(str(OPSEC))}
            for name in sorted(_opsec_tools):
                print(f"    {name:14s} → {_opsec_tools[name].relative_to(ROOT)}")
            print(f"\n  {B}Intel (standalone):{N}")
            _intel_tools = {k: v for k, v in TOOLS.items()
                            if str(v).startswith(str(INTEL))}
            for name in sorted(_intel_tools):
                print(f"    {name:14s} → {_intel_tools[name].relative_to(ROOT)}")
            print(f"\n  Usage: python3 run <tool> [args...]\n")
            return
        if arg in ("help", "--help", "-h"):
            banner()
            print(f"  {B}Interactive mode:{N}  python3 run")
            print(f"  {B}Direct mode:{N}       python3 run <tool> [args...]")
            print(f"  {B}List tools:{N}        python3 run list\n")
            return
        cli_passthrough()
        return

    # Detect Tor port once at startup so get_tor_proxy() can default to it
    _startup_status = check_prereqs()
    _detected_tor_port = _startup_status.get("tor_port")
    if _detected_tor_port:
        ok(f"Tor working on port {_detected_tor_port}")
    else:
        print()
        err("Tor is NOT running. Most features will not work.")
        print()
        info("How to fix:")
        info(f"  {B}sudo systemctl start tor{N}     start system Tor (port 9050)")
        info(f"  {B}sudo systemctl status tor{N}    check if it's running")
        info(f"  Or open Tor Browser (uses port 9150)")
        print()
        info("After starting Tor, choose option 0 (System Check) to verify.")

    _tor_ok = bool(_detected_tor_port)

    # Interactive mode
    while True:
        try:
            choice = menu_main(tor_ok=_tor_ok)
        except (EOFError, KeyboardInterrupt):
            print()
            break

        _network_ops = {"1", "2", "3", "4", "5", "6", "7", "8", "t", "i"}
        if choice in _network_ops and not _tor_ok:
            err("This operation requires Tor. Start Tor first, then choose 0 to re-check.")
            info("  sudo systemctl start tor")
            info("  Or open Tor Browser (port 9150)")
            choice = "_blocked"

        try:
            if choice == "1":
                flow_full_pipeline(_detected_tor_port)
            elif choice == "2":
                flow_receive(_detected_tor_port)
            elif choice == "3":
                flow_cold(_detected_tor_port)
            elif choice == "4":
                flow_broadcast(_detected_tor_port)
            elif choice == "5":
                flow_resume(_detected_tor_port)
            elif choice == "6":
                flow_create_wallet(_detected_tor_port)
            elif choice == "7":
                flow_swap_preparer(_detected_tor_port)
            elif choice == "8":
                flow_exit_planner(_detected_tor_port)
            elif choice == "9":
                flow_paranoia()
            elif choice == "0":
                _startup_status = check_prereqs()
                _detected_tor_port = _startup_status.get("tor_port")
                _tor_ok = bool(_detected_tor_port)
                show_status(_startup_status)
                if _tor_ok:
                    ok("Tor is working — all options are now available.")
            elif choice == "t":
                flow_testnet(_detected_tor_port)
            elif choice == "i":
                flow_intel(_detected_tor_port)
            elif choice in ("q", "quit", "exit"):
                break
            elif choice == "_blocked":
                pass
            else:
                warn(f"Unknown option: {choice}")
                continue
        except (EOFError, KeyboardInterrupt):
            print()
            continue
        except SystemExit as _se:
            if _se.code and str(_se.code).startswith("[!]"):
                print(f"\n  {R}{_se.code}{N}")
            pass
        except Exception as _menu_err:
            print()
            err(f"Operation failed: {_menu_err}")
            info("Returning to menu. Check the error above.")

        if choice not in ("q", "quit", "exit"):
            print()
            input(f"  {D}Press Enter to return to menu...{N}")


if __name__ == "__main__":
    main()
