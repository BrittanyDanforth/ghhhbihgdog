            return

    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()
    args = ["--rpc", rpc, "--tor-proxy", tor]
    if run_script(CORE / "create_receive_wallet", args, "Wallet creator"):
        print()
        ok("Wallet created.")
        info("Next steps:")
        info("  Option 2 (Receive) — full guided receive flow")
        info("  Option 7 (Swap Preparer) — generate deposit address for sender")


def flow_swap_preparer(detected_port=None):
    heading("ThorChain Swap Preparer (standalone)")
    print(f"  This generates a BTC deposit address + memo for ThorChain swaps.")
    print(f"  For the full guided receive flow, use option 2 instead.")
    print()
    tor = get_tor_proxy(detected_port)
    if not tor:
        return

    wallet_files = _find_wallet_files()
    dest = ""
    if wallet_files:
        info(f"Found {len(wallet_files)} wallet(s)")
        use_wf = prompt("Load XMR address from wallet JSON? (y/n)", "y").lower()
        if use_wf in ("y", "yes", ""):
            wf_path = prompt("Wallet JSON file", str(wallet_files[0]))
            try:
                with open(wf_path) as _f:
                    dest = json.load(_f).get("address", "")
                if dest:
                    ok(f"Address loaded from {Path(wf_path).name}")
            except (json.JSONDecodeError, KeyError, OSError) as e:
                err(f"Cannot read wallet file: {Path(wf_path).name}")
                return

    if not dest:
        dest = prompt("XMR destination address")
    if not dest:
        err("XMR address is required.")
        return

    amt = prompt("BTC amount to swap (e.g. 0.1)")
    try:
        if Decimal(amt) <= 0:
            raise ValueError
    except (ValueError, TypeError, InvalidOperation):
        err(f"Invalid BTC amount: '{amt}'")
        return

    _outfile = str(ROOT / f"thor_pairs_{os.urandom(4).hex()}.json")
    args = ["--amounts", amt, "--dests", dest, "--tor-proxy", tor,
            "--outfile", _outfile, "--force"]
    if not run_script(CORE / "thor_swap_preparer", args, "Swap preparer"):
        err("Swap preparation failed.")
    else:
        ok("Deposit instructions generated — see output above.")


