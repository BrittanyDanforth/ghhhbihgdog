        print()
        ok("Unsigned plan created.")
        info("Next steps:")
        info("  1. Copy the 'unsigned/' folder to USB")
        info("  2. On your offline machine, sign the plan using the air-gap signer")
        info("  3. Copy the 'signed/' folder back to this machine")
        info("  4. Choose option 4 (Broadcast) from this menu")


def flow_broadcast(detected_port=None):
    heading("Broadcast Signed TXs")
    tor = get_tor_proxy(detected_port)
    if not tor:
        return

    signed_dir = ROOT / "tx_staging" / "signed"
    if signed_dir.is_dir():
        _blob_count = len(list(signed_dir.glob("*.signed")))
        if _blob_count > 0:
            ok(f"Found {_blob_count} signed blob(s) in default location")
        path = prompt("Signed blobs directory", str(signed_dir))
    else:
        print()
        info("No signed blobs found in the default location.")
        info("If you used air-gap signing, enter the path to your signed/ folder.")
        info("If you ran the full pipeline (option 1), blobs are created automatically.")
        print()
        path = prompt("Path to signed blobs (directory or manifest JSON)")

    rpc = prompt("Monero daemon RPC", "http://127.0.0.1:18081")
    wrpc = prompt("Wallet RPC (for submit_transfer)", "http://127.0.0.1:18083")

    args = [
        path,
        "--tor-proxy", tor,
        "--rpc", rpc,
        "--wallet-rpc", wrpc,
    ]
    if run_script(CORE / "broadcast_signed_xmr", args, "Broadcaster"):
        print()
        ok("Broadcast completed.")
        info("Next: Run option 9 (Paranoia Cleanup) to wipe all traces.")
    else:
        err("Broadcast had errors. Check the output above.")
        info("You may re-run option 4 to retry failed broadcasts.")


def flow_resume(detected_port=None):
    heading("Resume From Crash")
    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()

    plans = _find_plan_files()
    if plans:
        info(f"Found {len(plans)} plan(s)")
        plan = prompt("Plan file to resume", str(plans[0]))
    else:
        plan = prompt("Path to unsigned plan JSON")

    if not plan:
        err("Plan file path is required.")
        return
    if not Path(plan).exists():
        err(f"Plan file not found: {Path(plan).name}")
        info("Run option 1 or 3 first to generate a plan, then resume.")
        return

    wallet_files = _find_wallet_files()
    if wallet_files:
        wf = prompt("Wallet JSON file", str(wallet_files[0]))
    else:
        wf = prompt("Path to wallet JSON file")

    if not wf:
        err("Wallet JSON file is required for resume.")
        info("Create one first with option 6 (Create Wallet), or provide a path to an existing wallet_*.json")
        return

    # Detect resume mode: check if the plan has btc_entry (sender) or
    # receive_wallet (receiver) to pass the right CLI flag.
    resume_flag = "--receive-wallet"
    try:
        with open(plan) as _pf:
            _plan_data = json.load(_pf)

        _meta = _plan_data.get("meta")
        _txs = _plan_data.get("txs")
        if not isinstance(_meta, dict):
            err("Plan file is missing 'meta' key — not a valid plan.")
            info("This should be an unsigned_*.json file from the 'unsigned/' directory.")
            return
        if not isinstance(_txs, list) or len(_txs) == 0:
            err("Plan file has no 'txs' list (empty or missing) — nothing to resume.")
            info("Re-run the pipeline (option 1 or 3) to generate a fresh plan.")
            return
        _schema = _meta.get("schema", "")
        if _schema not in ("plan_v1", "unsigned_v1"):
            err(f"Unrecognized plan schema: '{_schema}'. Expected 'plan_v1' or 'unsigned_v1'.")
            info("This file may be from an incompatible version. Re-generate with this toolkit version.")
            return
        for i, _tx in enumerate(_txs):
            if not isinstance(_tx, dict) or "dst" not in _tx or "amt" not in _tx:
                err(f"TX {i} in plan is malformed (missing 'dst' or 'amt').")
                info("The plan file may be corrupt. Re-generate it with option 1 or 3.")
                return

        # Check for stale plans (old ThorChain quotes may have expired)
        _plan_created = _meta.get("created", 0)
        if _plan_created > 0:
            import time as _time
            _age_hours = (_time.time() - _plan_created) / 3600
            if _age_hours > 24:
                warn(f"This plan is {_age_hours:.0f} hours old.")
                warn("ThorChain quotes and fee estimates may be stale.")
                if not confirm("Continue with this plan?"):
                    info("Re-generate the plan with option 1 or 3.")
                    return
            elif _age_hours > 1:
                info(f"Plan age: {_age_hours:.1f} hours. Check quote expiry before sending BTC.")

        if _meta.get("mock"):
            warn("This is a MOCK plan (dry-run) — it cannot be broadcast with real funds.")
            return

        if _meta.get("btc_entry"):
            resume_flag = "--btc-entry"
            wf_arg = _meta["btc_entry"]
            info("Sender resume detected.")
        else:
            wf_arg = wf
    except json.JSONDecodeError as e:
        err("Plan file is not valid JSON (may be corrupt).")
        return
    except OSError as e:
        err("Cannot read plan file.")
        return
    except KeyError as e:
        warn("Could not read plan metadata, defaulting to receive-wallet mode.")
        wf_arg = wf

    args = [
        resume_flag, wf_arg,
        "--resume-plan", plan,
        "--tor-proxy", tor,
        "--rpc-primary", rpc,
    ]
    if run_script(CORE / "mixer_core", args, "Resume"):
        print()
        ok("Resume completed.")
        info("Next: Run option 9 (Paranoia Cleanup) to wipe all traces.")
    else:
        err("Resume failed. Check the output above.")


