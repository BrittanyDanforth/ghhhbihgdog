#!/usr/bin/env python3
"""
Toolkit — Interactive Launcher
"""
from __future__ import annotations
import os, sys
from pathlib import Path
from typing import Optional

# ── Auto-activate venv if available ─────────────────────────────────────────
# The toolkit can be launched three ways:
#   1. ./gs           → bash wrapper, uses .venv/bin/python3
#   2. python3 run    → whatever python3 is on PATH (system or venv)
#   3. .venv/bin/python3 run → directly inside venv
#
# Problem: if the user runs "python3 run" with system Python but packages
# are only in .venv, every import fails. Fix: detect venv, re-exec if needed.
_ROOT = Path(__file__).resolve().parent
_VENV_PY = _ROOT / ".venv" / "bin" / "python3"

def _venv_works() -> bool:
    """Check if the venv Python can import ALL critical deps.
    
    A partial venv (e.g. only requests installed) would pass a single-import
    check but crash later when stem/monero/socks are needed. Check everything.
    """
    if not _VENV_PY.exists():
        return False
    try:
        import subprocess as _sp
        _venv_env = os.environ.copy()
        for _sk in ("GS_WALLET_PASSWORD", "GS_WALLET_FILE", "HIBP_KEY",
                     "DEHASHED_KEY", "AWS_SECRET_ACCESS_KEY", "GITHUB_TOKEN",
                     "GH_TOKEN", "SSH_AUTH_SOCK"):
            _venv_env.pop(_sk, None)
        _venv_env["HISTFILE"] = "/dev/null"
        r = _sp.run(
            [str(_VENV_PY), "-c",
             "import requests, socks, tenacity, stem, monero, psutil"],
            capture_output=True, timeout=10,
            env=_venv_env,
        )
        return r.returncode == 0
    except Exception:
        return False

def _system_has_deps() -> bool:
    """Check if current Python has ALL critical deps.
    
    Must match the same set checked by _venv_works() and the gs launcher.
    If any is missing, the toolkit will crash at runtime.
    """
    try:
        import requests, socks, tenacity, stem, monero, psutil
        return True
    except ImportError:
        return False

# If we're NOT in the venv and venv works, re-exec under venv Python
if _VENV_PY.exists() and str(_VENV_PY) != sys.executable:
    if _venv_works():
        os.execv(str(_VENV_PY), [str(_VENV_PY), __file__] + sys.argv[1:])
    elif not _system_has_deps():
        print("\n  [!] Required packages are missing or incomplete.")
        print(f"  [!] Run: bash install.sh")
        sys.exit(1)

# If venv doesn't exist at all and system has no deps, guide the user
if not _VENV_PY.exists() and not _system_has_deps():
    print("\n  [!] Required packages are not installed.")
    print(f"  [!] Run: bash install.sh")
    sys.exit(1)

import json, subprocess, shutil, secrets, signal, threading, time as _time_mod
from decimal import Decimal, InvalidOperation
from urllib.parse import urlparse, quote

# ── Shutdown signal handling ───────────────────────────────────────────────
_shutdown_event = threading.Event()

def _handle_signal(signum, frame):
    _shutdown_event.set()

def shutdown_requested() -> bool:
    return _shutdown_event.is_set()

signal.signal(signal.SIGINT, _handle_signal)
signal.signal(signal.SIGTERM, _handle_signal)

ROOT = _ROOT
CORE = ROOT / "core"
MODS = ROOT / "modules"
OPSEC = ROOT / "opsec"
INTEL = ROOT / "intel"


def _find_wallet_files() -> list:
    """Search for wallet_*.json under toolkit root, CWD, and home.
    Returns deduplicated list sorted by modification time (newest first)."""
    seen = set()
    found = {}
    for d in [ROOT, Path(".").resolve(), Path.home(), Path.home() / "Downloads"]:
        try:
            rd = d.resolve()
        except OSError:
            continue
        if rd in seen or not rd.is_dir():
            continue
        seen.add(rd)
        for f in rd.glob("wallet_*.json"):
            rp = f.resolve()
            if rp not in found:
                found[rp] = f
    return sorted(found.values(), key=lambda f: f.stat().st_mtime, reverse=True)


def _find_plan_files() -> list:
    """Search for unsigned plan files under toolkit root and CWD."""
    seen = set()
    found = {}
    for d in [ROOT / "unsigned", Path(".").resolve() / "unsigned",
              ROOT, Path(".").resolve()]:
        try:
            rd = d.resolve()
        except OSError:
            continue
        if rd in seen or not rd.is_dir():
            continue
        seen.add(rd)
        for f in rd.glob("unsigned_*.json"):
            rp = f.resolve()
            if rp not in found:
                found[rp] = f
    return sorted(found.values(), key=lambda f: f.stat().st_mtime, reverse=True)

# ── Colors ──────────────────────────────────────────────────────────────────
R = "\033[0;31m"    # red
G = "\033[0;32m"    # green
Y = "\033[1;33m"    # yellow
C = "\033[0;36m"    # cyan
B = "\033[1;37m"    # bold white
M = "\033[0;35m"    # magenta
D = "\033[0;90m"    # dim
N = "\033[0m"       # reset


def clear():
    print("\033[2J\033[H", end="", flush=True)


def banner():
    print(f"""
{M}  ===================================================={N}
  {B}                Operations Menu{N}
{M}  ===================================================={N}
""")


def prompt(text: str, default: str = "") -> str:
    if default:
        r = input(f"  {C}>{N} {text} {D}[{default}]{N}: ").strip()
        return r if r else default
    return input(f"  {C}>{N} {text}: ").strip()


def confirm(text: str) -> bool:
    r = input(f"  {Y}?{N} {text} {D}(y/n){N}: ").strip().lower()
    return r in ("y", "yes")


def heading(text: str):
    w = max(len(text) + 4, 40)
    print(f"\n  {C}{'─' * w}{N}")
    print(f"  {B}  {text}{N}")
    print(f"  {C}{'─' * w}{N}\n")


def ok(text: str):
    print(f"  {G}[+]{N} {text}")


def warn(text: str):
    print(f"  {Y}[!]{N} {text}")


def err(text: str):
    print(f"  {R}[!]{N} {text}")


def info(text: str):
    print(f"  {D}[*]{N} {text}")


_SECRETS_TO_STRIP = (
    "GS_WALLET_PASSWORD", "GS_WALLET_FILE",
    "HIBP_KEY", "DEHASHED_KEY", "DEHASHED_EMAIL",
    "COINGECKO_API_KEY", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
    "GITHUB_TOKEN", "GH_TOKEN", "GITLAB_TOKEN", "SSH_AUTH_SOCK",
    "GPG_AGENT_INFO", "OPENAI_API_KEY", "ANTHROPIC_API_KEY",
)


def _sanitized_env(extra_strip: tuple = ()) -> dict:
    """Build a sanitized environment with secrets stripped."""
    env = os.environ.copy()
    for _k in _SECRETS_TO_STRIP + extra_strip:
        env.pop(_k, None)
    env["HISTFILE"] = "/dev/null"
    return env


def _subst_attacker(content: str, attacker_url: str) -> str:
    """Replace [ATTACKER] placeholders without corrupting existing URLs.

    Replaces [ATTACKER] with the actual URL, then replaces bare ATTACKER
    only when it appears as a standalone token (not inside the already-
    substituted URL). Avoids turning https://[ATTACKER] into
    https://http://127.0.0.1:XXXX.
    """
    if not attacker_url:
        return content
    # First pass: replace the bracketed placeholder
    content = content.replace("[ATTACKER]", attacker_url)
    # Second pass: replace https://ATTACKER only if it wasn't already
    # substituted (i.e. [ATTACKER] didn't occur at that position)
    if f"https://{attacker_url}" not in content:
        content = content.replace("https://ATTACKER", attacker_url)
    if f"http://{attacker_url}" not in content:
        content = content.replace("http://ATTACKER", attacker_url)
    return content


def _jittered_delay(lo: float = 1.0, hi: float = 4.0) -> None:
    """Sleep a jittered duration with wide enough range to avoid fingerprinting."""
    if hi <= lo:
        _time_mod.sleep(max(lo, 0.1))
        return
    ms_range = int((hi - lo) * 1000)
    if ms_range <= 0:
        ms_range = 1
    _time_mod.sleep(lo + secrets.randbelow(ms_range) / 1000.0)


def run_script(path: Path, args: list, label: str = ""):
    if label:
        info(f"Running {label}...")
    python = sys.executable
    child_env = _sanitized_env()
    try:
        result = subprocess.run(
            [python, str(path)] + args,
            timeout=7200,
            env=child_env,
            cwd=str(ROOT),
        )
        return result.returncode == 0
    except subprocess.TimeoutExpired:
        err(f"{label or path.name} timed out")
        return False
    except KeyboardInterrupt:
        warn("Interrupted")
        return False


# ── Ephemeral File Manager ──────────────────────────────────────────────────

class ExploitFileManager:
    """RAM-only ephemeral file management with auto-cleanup and tracking.

    All generated exploit files (clickjacking, CSRF, CORS, XSS, etc.) live
    exclusively in /dev/shm when available, falling back to a tmpdir under
    the toolkit root. Files are tracked for lifecycle management and wiped
    on session close or after a configurable TTL.
    """

    def __init__(self, ttl_seconds: int = 300):
        self._ttl = ttl_seconds
        self._files: dict = {}  # path -> {created, type, ttl}
        self._lock = threading.Lock()
        if Path("/dev/shm").exists():
            self._base = Path("/dev/shm/intel")
        else:
            self._base = ROOT / ".intel_tmp"
        self._base.mkdir(parents=True, exist_ok=True)
        self._disk_warning = not Path("/dev/shm").exists()

    @property
    def disk_warning(self) -> bool:
        return self._disk_warning

    @property
    def base_dir(self) -> Path:
        return self._base

    def generate(self, exploit_type: str, content: str,
                 extension: str = ".html", custom_name: str = "",
                 ttl: int = None) -> Path:
        """Generate an ephemeral exploit file in RAM.

        Returns the Path to the generated file. The file is tracked for
        auto-cleanup and its full path is never printed — only the filename.
        """
        if custom_name:
            fname = custom_name
        else:
            tag = secrets.token_hex(4)
            fname = f"{exploit_type}_{tag}{extension}"

        out_path = self._base / fname
        out_path.write_text(content)
        os.chmod(str(out_path), 0o600)

        file_ttl = ttl if ttl is not None else self._ttl
        with self._lock:
            self._files[str(out_path)] = {
                "created": _time_mod.time(),
                "type": exploit_type,
                "ttl": file_ttl,
                "filename": fname,
                "size": len(content),
            }
        return out_path

    def list_files(self) -> list:
        """Return list of tracked file info dicts (no full paths exposed)."""
        with self._lock:
            result = []
            for path_str, meta in self._files.items():
                p = Path(path_str)
                age = _time_mod.time() - meta["created"]
                remaining = max(0, meta["ttl"] - age) if meta["ttl"] > 0 else -1
                result.append({
                    "filename": meta["filename"],
                    "type": meta["type"],
                    "size_bytes": meta["size"],
                    "age_seconds": int(age),
                    "ttl_remaining": int(remaining) if remaining >= 0 else "persistent",
                    "exists": p.exists(),
                })
            return result

    def cleanup_expired(self) -> int:
        """Wipe files that have exceeded their TTL. Returns count wiped."""
        now = _time_mod.time()
        to_remove = []
        with self._lock:
            for path_str, meta in self._files.items():
                if meta["ttl"] > 0 and (now - meta["created"]) > meta["ttl"]:
                    to_remove.append(path_str)

        count = 0
        for path_str in to_remove:
            count += self._secure_wipe(path_str)
        return count

    def wipe_all(self) -> int:
        """Securely wipe ALL tracked files. Returns count wiped."""
        with self._lock:
            paths = list(self._files.keys())
        count = 0
        for path_str in paths:
            count += self._secure_wipe(path_str)
        return count

    def wipe_by_type(self, exploit_type: str) -> int:
        """Wipe all files of a given exploit type."""
        with self._lock:
            paths = [p for p, m in self._files.items() if m["type"] == exploit_type]
        count = 0
        for path_str in paths:
            count += self._secure_wipe(path_str)
        return count

    def _secure_wipe(self, path_str: str) -> int:
        """Overwrite file with random data, fsync, then unlink."""
        p = Path(path_str)
        try:
            if p.exists():
                size = p.stat().st_size
                with open(p, "wb") as f:
                    f.write(os.urandom(max(size, 64)))
                    f.flush()
                    os.fsync(f.fileno())
                p.unlink()
        except OSError:
            pass
        with self._lock:
            self._files.pop(path_str, None)
        return 1

    def get_download_info(self, path: Path) -> str:
        """Return display-safe info for a generated file (filename only)."""
        return path.name

    def get_path(self, filename: str) -> Optional[Path]:
        """Return the full Path for a tracked file by filename."""
        with self._lock:
            for path_str, meta in self._files.items():
                if meta["filename"] == filename:
                    p = Path(path_str)
                    if p.exists():
                        return p
        return None

    def session_destroy(self):
        """Full session teardown: wipe all files and clear tracking."""
        self.wipe_all()
        with self._lock:
            self._files.clear()


# ── Ephemeral Exploit HTTP Server ──────────────────────────────────────────

class ExploitServer:
    """RAM-only HTTP server for serving generated exploit files.

    Serves files exclusively from the ephemeral dir (path-traversal safe).
    Runs in a background daemon thread with health monitoring.

    OPSEC:
    - Binds 127.0.0.1 only — not reachable from other hosts
    - Zero access logs written anywhere
    - No directory listing — 404 for everything not a regular file
    - Path traversal hardened: resolved path must be under serve_dir
    - Server stops and socket closes on session destroy
    - All served content from RAM-backed /dev/shm when available
    """

    def __init__(self, file_mgr: ExploitFileManager):
        self._file_mgr = file_mgr
        self._port = None
        self._server = None
        self._thread = None
        self._lock = threading.Lock()
        self._running = False
        self._started = threading.Event()

    def start(self) -> int:
        """Start the ephemeral HTTP server. Returns the port number.

        Thread-safe: uses lock to prevent double-start races.
        Blocks until the server is actually listening.
        """
        with self._lock:
            if self._running and self._port:
                return self._port

            import socket
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                s.bind(("127.0.0.1", 0))
                port = s.getsockname()[1]

            self._port = port
            serve_root = self._file_mgr.base_dir.resolve()

            import http.server
            from http.server import HTTPServer

            _root = str(serve_root)
            _started_event = self._started

            class _Handler(http.server.BaseHTTPRequestHandler):
                def log_message(hself, fmt, *args):
                    pass

                def do_GET(hself):
                    from urllib.parse import unquote
                    raw_path = unquote(hself.path.split("?")[0].split("#")[0])
                    fname = raw_path.lstrip("/")
                    if not fname or "/" in fname or "\\" in fname or ".." in fname:
                        hself.send_error(404)
                        return
                    candidate = (Path(_root) / fname).resolve()
                    if not str(candidate).startswith(_root + os.sep) and \
                       str(candidate) != _root:
                        hself.send_error(403)
                        return
                    if not candidate.is_file():
                        hself.send_error(404)
                        return
                    try:
                        data = candidate.read_bytes()
                        hself.send_response(200)
                        ext = candidate.suffix.lower()
                        ct = {".html": "text/html; charset=utf-8",
                              ".js": "application/javascript",
                              ".json": "application/json",
                              ".txt": "text/plain"}.get(ext, "application/octet-stream")
                        hself.send_header("Content-Type", ct)
                        hself.send_header("Content-Length", str(len(data)))
                        hself.send_header("Cache-Control", "no-store, no-cache")
                        hself.send_header("X-Content-Type-Options", "nosniff")
                        hself.end_headers()
                        hself.wfile.write(data)
                    except OSError:
                        hself.send_error(404)

                def do_HEAD(hself):
                    hself.send_error(405)

                def do_POST(hself):
                    hself.send_error(405)

            self._server = HTTPServer(("127.0.0.1", self._port), _Handler)
            self._started.clear()

            def _serve():
                _started_event.set()
                self._server.serve_forever()

            self._thread = threading.Thread(target=_serve, daemon=True)
            self._thread.start()
            self._started.wait(timeout=5)
            self._running = True
            return self._port

    def get_url(self, filename: str) -> str:
        """Get the local serve URL for a generated file."""
        if not self._running:
            self.start()
        return f"http://127.0.0.1:{self._port}/{filename}"

    @property
    def is_running(self) -> bool:
        with self._lock:
            if self._running and self._thread and not self._thread.is_alive():
                self._running = False
            return self._running

    @property
    def port(self) -> Optional[int]:
        return self._port

    def stop(self):
        """Stop the server and close the socket. Thread-safe."""
        with self._lock:
            if self._server:
                try:
                    self._server.shutdown()
                except Exception:
                    pass
                try:
                    self._server.server_close()
                except Exception:
                    pass
            self._running = False
            self._server = None
            self._thread = None
            self._port = None


# ── SOC-style Audit Trail ──────────────────────────────────────────────────

class AuditTrail:
    """In-memory audit trail for exploit walkthrough sessions.

    Tracks every action (executions, skips, edits, file generations) with
    timestamps, provides live feed capability, and supports export to
    JSON/text reports. All data is held in memory only and wiped on
    session close.
    """

    RISK_LOW = "LOW"
    RISK_MEDIUM = "MEDIUM"
    RISK_HIGH = "HIGH"
    RISK_CRITICAL = "CRITICAL"

    def __init__(self, session_id: str = ""):
        self._session_id = session_id or secrets.token_hex(6)
        self._entries: list = []
        self._lock = threading.Lock()
        self._start_time = _time_mod.time()
        self._alerts: list = []

    @property
    def session_id(self) -> str:
        return self._session_id

    def log(self, action: str, detail: str = "", risk: str = "",
            vuln_type: str = "", target: str = "", success: bool = None):
        """Record an action in the audit trail."""
        entry = {
            "timestamp": _time_mod.time(),
            "ts_iso": _time_mod.strftime("%Y-%m-%dT%H:%M:%S", _time_mod.gmtime()),
            "action": action,
            "detail": detail[:200] if detail else "",
            "risk": risk,
            "vuln_type": vuln_type,
            "target": target[:80] if target else "",
            "success": success,
        }
        with self._lock:
            self._entries.append(entry)
            if risk in (self.RISK_HIGH, self.RISK_CRITICAL):
                self._alerts.append(entry)

    def log_execution(self, command_preview: str, vuln_type: str,
                      exit_code: int = None, risk: str = ""):
        """Log a command execution event."""
        self.log(
            action="execute",
            detail=f"cmd_preview: {command_preview[:60]}",
            risk=risk or self.RISK_MEDIUM,
            vuln_type=vuln_type,
            success=exit_code == 0 if exit_code is not None else None,
        )

    def log_file_generated(self, filename: str, exploit_type: str):
        """Log a file generation event."""
        self.log(
            action="file_generated",
            detail=f"file: {filename}",
            vuln_type=exploit_type,
            success=True,
        )

    def log_skip(self, step_title: str, vuln_type: str = ""):
        """Log a step skip."""
        self.log(action="skip", detail=step_title, vuln_type=vuln_type)

    def log_edit_run(self, custom_cmd_preview: str, vuln_type: str = ""):
        """Log an edit+run action."""
        self.log(
            action="edit_run",
            detail=f"custom: {custom_cmd_preview[:60]}",
            risk=self.RISK_HIGH,
            vuln_type=vuln_type,
        )

    def get_live_feed(self, last_n: int = 10) -> list:
        """Return the most recent N entries for live display."""
        with self._lock:
            return list(self._entries[-last_n:])

    def get_alerts(self) -> list:
        """Return all high-risk alerts."""
        with self._lock:
            return list(self._alerts)

    def get_stats(self) -> dict:
        """Return summary statistics for the session."""
        with self._lock:
            total = len(self._entries)
            executions = sum(1 for e in self._entries if e["action"] == "execute")
            skips = sum(1 for e in self._entries if e["action"] == "skip")
            files = sum(1 for e in self._entries if e["action"] == "file_generated")
            edits = sum(1 for e in self._entries if e["action"] == "edit_run")
            successes = sum(1 for e in self._entries
                           if e["action"] == "execute" and e.get("success") is True)
            failures = sum(1 for e in self._entries
                           if e["action"] == "execute" and e.get("success") is False)
            vuln_types = set(e["vuln_type"] for e in self._entries if e["vuln_type"])
            alert_count = len(self._alerts)

        return {
            "session_id": self._session_id,
            "duration_seconds": int(_time_mod.time() - self._start_time),
            "total_actions": total,
            "executions": executions,
            "successes": successes,
            "failures": failures,
            "skips": skips,
            "files_generated": files,
            "edits": edits,
            "alerts": alert_count,
            "vuln_types_tested": sorted(vuln_types),
        }

    def export_report(self, fmt: str = "json") -> str:
        """Export the audit trail as a report string.

        Formats: 'json' or 'text'. The report is generated in memory
        and never written to disk automatically.
        """
        stats = self.get_stats()
        with self._lock:
            entries_copy = list(self._entries)
            alerts_copy = list(self._alerts)

        if fmt == "json":
            report = {
                "report_type": "exploit_walkthrough_audit",
                "session": stats,
                "entries": entries_copy,
                "alerts": alerts_copy,
            }
            return json.dumps(report, indent=2)

        lines = []
        lines.append("=" * 60)
        lines.append("EXPLOIT WALKTHROUGH AUDIT REPORT")
        lines.append("=" * 60)
        lines.append(f"Session ID: {stats['session_id']}")
        lines.append(f"Duration:   {stats['duration_seconds']}s")
        lines.append(f"Actions:    {stats['total_actions']}")
        lines.append(f"Executions: {stats['executions']} "
                      f"(success: {stats['successes']}, fail: {stats['failures']})")
        lines.append(f"Skips:      {stats['skips']}")
        lines.append(f"Files:      {stats['files_generated']}")
        lines.append(f"Edit+Runs:  {stats['edits']}")
        lines.append(f"Alerts:     {stats['alerts']}")
        lines.append(f"Vuln Types: {', '.join(stats['vuln_types_tested'])}")
        lines.append("-" * 60)
        lines.append("")
        lines.append("ACTION LOG")
        lines.append("-" * 60)
        for i, e in enumerate(entries_copy, 1):
            risk_tag = f" [{e['risk']}]" if e.get("risk") else ""
            status = ""
            if e.get("success") is True:
                status = " -> OK"
            elif e.get("success") is False:
                status = " -> FAIL"
            lines.append(
                f"  {i:>3}. [{e['ts_iso']}] {e['action']:16s}"
                f"{risk_tag} {e.get('detail', '')}{status}"
            )
        if alerts_copy:
            lines.append("")
            lines.append("HIGH-RISK ALERTS")
            lines.append("-" * 60)
            for a in alerts_copy:
                lines.append(f"  [{a['ts_iso']}] {a['action']}: {a.get('detail', '')}")
        lines.append("")
        lines.append("=" * 60)
        return "\n".join(lines)

    def session_destroy(self):
        """Wipe all audit data from memory."""
        with self._lock:
            self._entries.clear()
            self._alerts.clear()
        self._session_id = ""
        self._start_time = 0


# ── Safe Executor ──────────────────────────────────────────────────────────

class SafeExecutor:
    """Command execution with safety confirmations, risk assessment,
    rate limiting, and automatic timeout enforcement.

    Risk levels determine the confirmation flow:
    - LOW: single confirmation
    - MEDIUM: single confirmation + warning
    - HIGH: double confirmation + warning + delay
    - CRITICAL: double confirmation + explicit warning + extended delay
    """

    RISK_COMMANDS = {
        "reverse_shell": "CRITICAL",
        "credential_dump": "CRITICAL",
        "file_write": "HIGH",
        "data_exfil": "HIGH",
        "rce": "CRITICAL",
        "sqli_extract": "HIGH",
        "default": "MEDIUM",
    }

    def __init__(self, audit: AuditTrail):
        self._audit = audit
        self._exec_count = 0
        self._exec_times: list = []
        self._rate_limit_window = 60
        self._rate_limit_max = 20
        self._lock = threading.Lock()

    def _assess_risk(self, command: str, step: dict) -> str:
        """Assess the risk level of a command based on content analysis."""
        cmd_lower = command.lower()
        if any(k in cmd_lower for k in ("/dev/tcp", "reverse", "nc -", "ncat", "bash -i")):
            return "CRITICAL"
        if any(k in cmd_lower for k in ("password", "credential", "shadow", "id_rsa",
                                         "security-credentials")):
            return "HIGH"
        if step.get("warning"):
            return "HIGH"
        if any(k in cmd_lower for k in ("union select", "group_concat", "information_schema")):
            return "HIGH"
        return step.get("risk", "MEDIUM")

    def _check_rate_limit(self) -> bool:
        """Enforce rate limiting on command executions."""
        now = _time_mod.time()
        with self._lock:
            self._exec_times = [t for t in self._exec_times
                                if now - t < self._rate_limit_window]
            if len(self._exec_times) >= self._rate_limit_max:
                return False
            self._exec_times.append(now)
            self._exec_count += 1
        return True

    def execute(self, command: str, step: dict, vuln_type: str = "",
                timeout: int = 30) -> Optional[subprocess.CompletedProcess]:
        """Execute a command with full safety pipeline.

        Returns the CompletedProcess result or None if aborted/failed.
        """
        risk = self._assess_risk(command, step)

        if not self._check_rate_limit():
            warn(f"Rate limit reached ({self._rate_limit_max} commands/"
                 f"{self._rate_limit_window}s). Wait before executing more.")
            return None

        if risk == "CRITICAL":
            print(f"  {R}{'=' * 50}{N}")
            print(f"  {R}CRITICAL RISK: This action could be dangerous{N}")
            print(f"  {R}{'=' * 50}{N}")
            if step.get("warning"):
                print(f"  {R}Detail: {step['warning']}{N}")
            print()
            if not confirm("FIRST CONFIRMATION: Understand the risks?"):
                info("Aborted.")
                self._audit.log("abort", f"critical_risk_rejected: {command[:40]}", risk=risk)
                return None
            _jittered_delay(1.0, 4.0)
            if not confirm("SECOND CONFIRMATION: Execute this critical command?"):
                info("Aborted.")
                self._audit.log("abort", f"critical_risk_rejected_2nd: {command[:40]}", risk=risk)
                return None
        elif risk == "HIGH":
            if step.get("warning"):
                print(f"  {Y}WARNING: {step['warning']}{N}")
            if not confirm(f"Execute this HIGH-risk command?"):
                info("Aborted.")
                self._audit.log("abort", f"high_risk_rejected: {command[:40]}", risk=risk)
                return None
            _jittered_delay(0.5, 3.0)
        else:
            if not confirm("CONFIRM: Execute this command through Tor?"):
                info("Aborted.")
                return None

        _jittered_delay(1.0, 5.0)

        try:
            result = subprocess.run(
                ["bash", "--norc", "--noprofile", "-c", command],
                capture_output=True, text=True, timeout=timeout,
                env=_sanitized_env(),
            )
            if result.stdout:
                print(f"\n  {G}Output:{N}")
                for line in result.stdout.strip().split("\n")[:20]:
                    print(f"    {line}")
            if result.stderr:
                print(f"\n  {Y}Stderr:{N}")
                for line in result.stderr.strip().split("\n")[:5]:
                    print(f"    {line}")

            self._audit.log_execution(
                command[:60], vuln_type,
                exit_code=result.returncode, risk=risk,
            )
            ok(f"Executed (exit code: {result.returncode})")
            return result

        except subprocess.TimeoutExpired:
            warn(f"Command timed out ({timeout}s)")
            self._audit.log_execution(command[:60], vuln_type, exit_code=-1, risk=risk)
            return None
        except Exception as e:
            err(f"Execution failed: {type(e).__name__}")
            self._audit.log_execution(command[:60], vuln_type, exit_code=-1, risk=risk)
            return None

    @property
    def execution_count(self) -> int:
        return self._exec_count


# ── Report Generator ───────────────────────────────────────────────────────

class ReportGenerator:
    """Generate exportable audit reports from walkthrough sessions.

    Supports JSON and text formats. Reports are generated in memory
    and can be saved to the ephemeral file manager for secure handling.
    """

    @staticmethod
    def generate(audit: AuditTrail, file_mgr: ExploitFileManager,
                 fmt: str = "text",
                 findings_summary: list = None) -> str:
        """Generate a full session report."""
        stats = audit.get_stats()
        report_lines = []

        if fmt == "json":
            report_data = {
                "report_type": "exploit_walkthrough_session",
                "session": stats,
                "findings_tested": findings_summary or [],
                "files_generated": file_mgr.list_files(),
                "audit_entries": audit.get_live_feed(last_n=9999),
                "alerts": audit.get_alerts(),
            }
            return json.dumps(report_data, indent=2)

        report_lines.append("=" * 65)
        report_lines.append("  EXPLOIT WALKTHROUGH SESSION REPORT")
        report_lines.append("=" * 65)
        report_lines.append(f"  Session:   {stats['session_id']}")
        report_lines.append(f"  Duration:  {stats['duration_seconds']}s")
        report_lines.append(f"  Generated: {_time_mod.strftime('%Y-%m-%d %H:%M UTC', _time_mod.gmtime())}")
        report_lines.append("")
        report_lines.append("  SUMMARY")
        report_lines.append("  " + "-" * 40)
        report_lines.append(f"  Total actions:    {stats['total_actions']}")
        report_lines.append(f"  Executions:       {stats['executions']}")
        report_lines.append(f"    Successful:     {stats['successes']}")
        report_lines.append(f"    Failed:         {stats['failures']}")
        report_lines.append(f"  Steps skipped:    {stats['skips']}")
        report_lines.append(f"  Files generated:  {stats['files_generated']}")
        report_lines.append(f"  Custom commands:  {stats['edits']}")
        report_lines.append(f"  High-risk alerts: {stats['alerts']}")
        report_lines.append(f"  Vuln types:       {', '.join(stats['vuln_types_tested'])}")
        report_lines.append("")

        tracked = file_mgr.list_files()
        if tracked:
            report_lines.append("  GENERATED FILES")
            report_lines.append("  " + "-" * 40)
            for fi in tracked:
                status = "active" if fi["exists"] else "wiped"
                report_lines.append(
                    f"  {fi['filename']:30s}  {fi['type']:15s}  "
                    f"{fi['size_bytes']:>6d}B  [{status}]"
                )
            report_lines.append("")

        if findings_summary:
            report_lines.append("  FINDINGS TESTED")
            report_lines.append("  " + "-" * 40)
            for f in findings_summary:
                report_lines.append(
                    f"  [{f.get('severity', '?'):8s}] {f.get('type', '?'):15s}  "
                    f"{f.get('title', '?')[:40]}"
                )
            report_lines.append("")

        alerts = audit.get_alerts()
        if alerts:
            report_lines.append("  HIGH-RISK ALERTS")
            report_lines.append("  " + "-" * 40)
            for a in alerts:
                report_lines.append(f"  [{a['ts_iso']}] {a['action']}: {a.get('detail', '')}")
            report_lines.append("")

        report_lines.append("  DETAILED ACTION LOG")
        report_lines.append("  " + "-" * 40)
        for i, e in enumerate(audit.get_live_feed(last_n=9999), 1):
            risk_tag = f" [{e['risk']}]" if e.get("risk") else ""
            status = ""
            if e.get("success") is True:
                status = " OK"
            elif e.get("success") is False:
                status = " FAIL"
            report_lines.append(
                f"  {i:>3}. [{e['ts_iso']}] {e['action']:16s}"
                f"{risk_tag} {e.get('detail', '')}{status}"
            )

        report_lines.append("")
        report_lines.append("=" * 65)
        return "\n".join(report_lines)

    @staticmethod
    def save_report(report_content: str, file_mgr: ExploitFileManager,
                    fmt: str = "text") -> Path:
        """Save a report using the file manager (ephemeral, RAM-only)."""
        ext = ".json" if fmt == "json" else ".txt"
        return file_mgr.generate(
            exploit_type="audit_report",
            content=report_content,
            extension=ext,
            ttl=600,
        )


# ── Check prerequisites ────────────────────────────────────────────────────

def check_prereqs() -> dict:
    """Check what's available on this system."""
    status = {}

    # Python deps
    for mod, name in [("requests","requests"),("socks","PySocks"),("stem","stem"),
                      ("monero","monero"),("psutil","psutil"),("tenacity","tenacity")]:
        try:
            __import__(mod)
            status[name] = True
        except ImportError:
            status[name] = False

    # Tor (system tor SOCKS 9050; Tor Browser embedded tor 9150)
    status["tor"] = False
    status["tor_port"] = None
    try:
        import requests as _r
        for _tor_port in (9050, 9150):
            try:
                _px = {
                    "http": f"socks5h://127.0.0.1:{_tor_port}",
                    "https": f"socks5h://127.0.0.1:{_tor_port}",
                }
                resp = _r.get("https://check.torproject.org/api/ip", proxies=_px, timeout=10)
                if resp.json().get("IsTor"):
                    status["tor"] = True
                    status["tor_port"] = _tor_port
                    break
            except Exception:
                continue
    except ImportError:
        pass

    # Monero
    for tool in ["monerod", "monero-wallet-cli", "monero-wallet-rpc"]:
        status[tool] = shutil.which(tool) is not None

    # Wallet RPC running?
    try:
        import requests as _r2
        resp = _r2.post("http://127.0.0.1:18083/json_rpc",
                        json={"jsonrpc":"2.0","id":"0","method":"get_height"},
                        timeout=3)
        status["wallet_rpc"] = resp.status_code == 200
    except Exception:
        status["wallet_rpc"] = False

    return status


def show_status(st: dict):
    heading("System Status")
    for name, ok_val in [
        ("Python: requests", st.get("requests")),
        ("Python: PySocks", st.get("PySocks")),
        ("Python: stem", st.get("stem")),
        ("Python: monero", st.get("monero")),
        ("Python: psutil", st.get("psutil")),
        ("Python: tenacity", st.get("tenacity")),
    ]:
        (ok if ok_val else err)(name)

    print()
    _tp = st.get("tor_port")
    _tor_line = (
        f"Tor SOCKS proxy (127.0.0.1:{_tp})"
        if _tp
        else "Tor SOCKS proxy (127.0.0.1:9050 or :9150)"
    )
    (ok if st.get("tor") else err)(_tor_line)
    for tool in ["monerod", "monero-wallet-cli", "monero-wallet-rpc"]:
        (ok if st.get(tool) else warn)(f"{tool}")
    (ok if st.get("wallet_rpc") else warn)("wallet-rpc responding (127.0.0.1:18083)")

    missing = [n for n in ["requests","PySocks","stem","monero","psutil","tenacity"] if not st.get(n)]
    if missing:
        print(f"\n  {R}Missing packages detected.{N} Run: bash install.sh")
    if not st.get("tor"):
        print()
        print(f"  {R}Tor is NOT running.{N} The toolkit cannot work without Tor.")
        print()
        print(f"  How to fix:")
        print(f"    {B}sudo systemctl start tor{N}     <- start system Tor (port 9050)")
        print(f"    {B}sudo systemctl status tor{N}    <- check if it's running")
        print(f"    {B}sudo journalctl -u tor{N}       <- check for errors")
        print()
        print(f"  Or: open Tor Browser (uses port 9150 instead of 9050)")
        print()
        print(f"  If Tor keeps failing:")
        print(f"    sudo apt purge tor && sudo apt install tor")
        print(f"    sudo systemctl enable tor && sudo systemctl start tor"
        )

    return len(missing) == 0 and st.get("tor", False)


# ── Main Menu ──────────────────────────────────────────────────────────────

def menu_main(tor_ok: bool = False):
    clear()
    banner()
    _net = "" if tor_ok else f" {R}(Tor required){N}"
    print(f"  {G}── Send / Receive ─────────────────────────────────{N}")
    print(f"  {B}1{N}  Full Pipeline          BTC → mixed XMR (guided){_net}")
    print(f"  {B}2{N}  Receive (guided)       Create wallet → swap → mix{_net}")
    print(f"  {B}6{N}  Create Wallet          Generate new XMR receive address{_net}")
    print()
    print(f"  {C}── Advanced ───────────────────────────────────────{N}")
    print(f"  {B}3{N}  Cold / Air-Gap         Unsigned plan for offline signing{_net}")
    print(f"  {B}4{N}  Broadcast              Send signed TXs to the network{_net}")
    print(f"  {B}5{N}  Resume                 Continue after a crash{_net}")
    print(f"  {B}7{N}  Swap Preparer          ThorChain quote (standalone){_net}")
    print(f"  {B}8{N}  Exit Planner           Plan XMR off-ramp (live prices){_net}")
    print()
    print(f"  {Y}── Intel / Recon ──────────────────────────────────{N}")
    print(f"  {B}i{N}  Intel Gather           OSINT + vulnerability scan{_net}")
    print()
    print(f"  {M}── System ─────────────────────────────────────────{N}")
    print(f"  {B}0{N}  System Check           Verify Tor, Monero, deps")
    print(f"  {B}9{N}  Paranoia Cleanup       Wipe ALL traces from this machine")
    print(f"  {B}t{N}  Dry Run                Test the full pipeline (no real funds){_net}")
    print()
    print(f"  {D}q  quit{N}")
    if not tor_ok:
        print(f"\n  {R}Tor is not running. Network options are disabled.{N}")
        print(f"  {D}Start Tor, then choose 0 (System Check) to re-check.{N}")
    print()
    return prompt("Choose").strip().lower()


# ── Guided flows ───────────────────────────────────────────────────────────

def get_tor_proxy(detected_port: int = None) -> str:
    default_port = detected_port if detected_port else 9050
    p = prompt("Tor SOCKS proxy", f"socks5h://127.0.0.1:{default_port}")
    if p.startswith("socks5://") and not p.startswith("socks5h://"):
        warn("socks5:// leaks DNS — auto-correcting to socks5h://")
        p = p.replace("socks5://", "socks5h://", 1)
    if not p.startswith("socks5h://"):
        err(f"Proxy must be socks5h:// (got: {p[:20]}...)")
        info("Only socks5h:// is safe — it routes DNS through Tor.")
        info("Default: socks5h://127.0.0.1:9050 (system Tor) or :9150 (Tor Browser)")
        return ""
    return p


def get_rpc() -> str:
    return prompt("Wallet RPC endpoint", "http://127.0.0.1:18083")


def _opsec_preflight():
    """Display OPSEC pre-flight checklist before sensitive operations."""
    print(f"  {Y}{'=' * 60}{N}")
    print(f"  {R}OPSEC PRE-FLIGHT CHECKLIST{N}")
    print(f"  {Y}{'=' * 60}{N}")
    print(f"  {B}[ ]{N} Tor is running and verified")
    print(f"  {B}[ ]{N} BTC wallet uses Tor for transactions")
    print(f"  {B}[ ]{N} BTC was NOT purchased on a KYC exchange")
    print(f"      (or was moved through intermediate wallets first)")
    print(f"  {B}[ ]{N} You are not on a monitored network")
    print(f"      (employer/school/public WiFi)")
    print(f"  {B}[ ]{N} Screen recording/sharing is disabled")
    print(f"  {Y}{'=' * 60}{N}")
    print()
    print(f"  {R}CRITICAL:{N} Do NOT send BTC to ThorChain deposit addresses")
    print(f"  from a KYC exchange (Coinbase, Kraken, etc.).")
    print(f"  KYC exchanges record your identity with every transaction.")
    print(f"  Use an intermediate non-KYC wallet (e.g., Sparrow, Electrum")
    print(f"  with Tor) to break the direct link between your identity")
    print(f"  and the ThorChain deposit.")
    print()
    if not confirm("I have reviewed the checklist and understand the risks"):
        warn("Aborted by operator.")
        return False
    return True


def flow_full_pipeline(detected_port=None):
    heading("Full Pipeline: BTC → Mixed XMR")

    # Pre-check: warn if prior state exists
    _lock = ROOT / ".mixer.lock"
    if _lock.exists():
        warn("A mixer lock file exists from a prior run.")
        warn("Another instance may be running, or a prior run crashed.")
        if not confirm("Continue anyway? (the lock will be checked again by the pipeline)"):
            return

    if not _opsec_preflight():
        return
    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()
    btc = prompt("Your BTC address (bc1..., 1..., or 3...)")
    if not btc:
        err("BTC address is required.")
        info("Expected formats: bc1... (Bech32), 1... (legacy), or 3... (P2SH)")
        return
    if not (btc.startswith("bc1") or btc.startswith("1") or btc.startswith("3")):
        err(f"Invalid BTC address format.")
        info("Must start with bc1 (Bech32), 1 (legacy), or 3 (P2SH).")
        return

    amt = prompt("BTC amount to swap (e.g. 0.1)")
    try:
        amt_d = Decimal(amt)
        if amt_d <= 0:
            raise ValueError
        if amt_d < Decimal("0.0001"):
            warn(f"Very small amount ({amt} BTC) — fees may consume most of it")
        if amt_d > Decimal("10"):
            warn(f"Large amount ({amt} BTC) — consider splitting into smaller swaps")
    except (ValueError, TypeError, InvalidOperation):
        err(f"Invalid BTC amount: '{amt}'. Must be a positive number like 0.1 or 0.005")
        return

    splits = prompt("Split into how many chunks?", "2")
    wallets = prompt("Number of mix wallets", "10")
    depth = prompt("Mix depth", "2")

    for label, val, min_val in [("Split", splits, 1), ("Wallets", wallets, 3), ("Depth", depth, 1)]:
        try:
            v = int(val)
            if v < min_val:
                err(f"{label} must be at least {min_val} (got {val})")
                return
        except ValueError:
            err(f"{label} must be a number (got '{val}')")
            return

    print()
    info("Starting full pipeline...")
    info("This will: fetch quotes → build mixing DAG → sign → broadcast → clean up")
    print()

    args = [
        "--btc-entry", btc,
        "--btc-amount", amt,
        "--split", splits,
        "--wallets", wallets,
        "--deep", depth,
        "--tor-proxy", tor,
        "--rpc-primary", rpc,
    ]

    if run_script(CORE / "mixer_core", args, "Full pipeline"):
        print()
        ok("Pipeline completed.")
        info("Next: Run option 9 (Paranoia Cleanup) to wipe all traces.")
    else:
        err("Pipeline failed. Check the output above for details.")
        info("If the pipeline crashed mid-run, use option 5 (Resume) to continue.")


def flow_receive(detected_port=None):
    heading("Receive Funds (Guided)")
    print(f"  This guides you through the full receive flow:")
    print(f"  1. Create or select a receive wallet")
    print(f"  2. Get a ThorChain BTC deposit address for the sender")
    print(f"  3. Wait for BTC → XMR conversion")
    print(f"  4. Mix the received XMR")
    print()

    if not _opsec_preflight():
        return

    tor = get_tor_proxy(detected_port)
    if not tor:
        return
    rpc = get_rpc()

    # Step 1: Wallet
    wallet_files = _find_wallet_files()
    if wallet_files:
        info(f"Found {len(wallet_files)} wallet(s)")
        choice = prompt("Use existing wallet? (y) or create new? (n)", "y").lower()
        if choice in ("y", "yes", ""):
            wf = prompt("Wallet JSON file", str(wallet_files[0]))
        else:
            info("Creating new receive wallet...")
            run_script(CORE / "create_receive_wallet", ["--rpc", rpc, "--tor-proxy", tor],
                       "Wallet creator")
            wallet_files = _find_wallet_files()
            if not wallet_files:
                err("Wallet creation failed.")
                return
            wf = str(wallet_files[0])
            ok("New wallet ready")
    else:
        info("No wallet found — creating one...")
        run_script(CORE / "create_receive_wallet", ["--rpc", rpc, "--tor-proxy", tor],
                   "Wallet creator")
        wallet_files = _find_wallet_files()
        if not wallet_files:
            err("Wallet creation failed.")
            return
        wf = str(wallet_files[0])
        ok("Wallet ready")

    # Load address from wallet JSON
    try:
        with open(wf) as _wf:
            _wdata = json.load(_wf)
        _addr = _wdata.get("address", "")

        # Warn if wallet is old (subaddresses don't expire, but stale wallets
        # from prior sessions may indicate the user forgot to clean up)
        import time as _time
        _wallet_created = _wdata.get("created", 0)
        if _wallet_created > 0:
            _wallet_age_hours = (_time.time() - _wallet_created) / 3600
            if _wallet_age_hours > 72:
                warn(f"This wallet is {_wallet_age_hours:.0f} hours old.")
                info("If this is from a prior session, consider creating a fresh wallet.")
    except (json.JSONDecodeError, OSError, KeyError):
        err(f"Cannot read wallet file: {Path(wf).name}")
        return

    # Step 2: ThorChain swap preparation
    print()
    heading("Step 2: Generate BTC Deposit Address")
    print(f"  The sender needs a BTC deposit address + memo to send BTC.")
    print(f"  ThorChain will convert BTC → XMR to your wallet address.")
    print()
    if confirm("Generate a ThorChain deposit address now?"):
        btc_amt = prompt("How much BTC will the sender send? (e.g. 0.1)")
        try:
            if Decimal(btc_amt) <= 0:
                raise ValueError
        except (ValueError, TypeError, InvalidOperation):
            err(f"Invalid BTC amount: '{btc_amt}'")
            return

        _swap_outfile = str(ROOT / f"thor_pairs_{os.urandom(4).hex()}.json")
        swap_args = ["--amounts", btc_amt, "--dests", _addr, "--tor-proxy", tor,
                     "--outfile", _swap_outfile, "--force"]
        if not run_script(CORE / "thor_swap_preparer", swap_args, "Swap preparer"):
            err("Swap preparation failed.")
            return
    else:
        info("Skipping swap prep. When the sender has already sent BTC,")
        info("or you already have XMR on the wallet address, continue below.")

    # Step 3: Wait
    print()
    heading("Step 3: Wait for XMR")
    print(f"  Give the BTC deposit address + memo to the sender.")
    print(f"  Wait for the BTC → XMR conversion to complete on ThorChain.")
    print(f"  You can check your balance with monero-wallet-rpc or the wallet CLI.")
    print()
    if not confirm("XMR has arrived and is ready to mix?"):
        info("Come back when XMR has arrived. Choose option 2 again and select")
        info(f"the same wallet ({Path(wf).name}).")
        return

    # Step 4: Mix
    print()
    heading("Step 4: Mix XMR")
    wallets = prompt("Number of mix wallets", "10")
    depth = prompt("Mix depth", "2")

    args = [
        "--receive-wallet", wf,
        "--tor-proxy", tor,
        "--rpc-primary", rpc,
        "--wallets", wallets,
        "--deep", depth,
    ]
    if run_script(CORE / "mixer_core", args, "Mixing"):
        print()
        ok("Mixing completed.")
        info("Next: Run option 9 (Paranoia Cleanup) to wipe all traces.")
    else:
        err("Mixing failed. Check the output above for details.")
        info("If the pipeline crashed mid-run, use option 5 (Resume) to continue.")


def flow_cold(detected_port=None):
    heading("Cold / Air-Gap Mode")
