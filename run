    clear()
    banner()
    _net = "" if tor_ok else f" {R}(Tor required){N}"
    print(f"  {G}── Send / Receive ─────────────────────────────────{N}")
    print(f"  {B}1{N}  Full Pipeline          BTC → mixed XMR (guided){_net}")
    print(f"  {B}2{N}  Receive (guided)       Create wallet → swap → mix{_net}")
    print(f"  {B}6{N}  Create Wallet          Generate new XMR receive address{_net}")
    print()
    print(f"  {C}── Advanced ───────────────────────────────────────{N}")
    print(f"  {B}3{N}  Cold / Air-Gap         Unsigned plan for offline signing{_net}")
    print(f"  {B}4{N}  Broadcast              Send signed TXs to the network{_net}")
    print(f"  {B}5{N}  Resume                 Continue after a crash{_net}")
    print(f"  {B}7{N}  Swap Preparer          ThorChain quote (standalone){_net}")
    print(f"  {B}8{N}  Exit Planner           Plan XMR off-ramp (live prices){_net}")
    print()
    print(f"  {Y}── Intel / Recon ──────────────────────────────────{N}")
    print(f"  {B}i{N}  Intel Gather           OSINT + vulnerability scan{_net}")
    print()
    print(f"  {M}── System ─────────────────────────────────────────{N}")
    print(f"  {B}0{N}  System Check           Verify Tor, Monero, deps")
    print(f"  {B}9{N}  Paranoia Cleanup       Wipe ALL traces from this machine")
    print(f"  {B}t{N}  Dry Run                Test the full pipeline (no real funds){_net}")
    print()
    print(f"  {D}q  quit{N}")
